// The PINNACLE assembly: MatcherSpec(raw, str, Normalize(FFullMatch(raw, str)))
// for StarFragmentRaw && Latin1Wf. Builds on FindMatchSimRE (the complete
// simulation) plus Linden's own PikeTree correctness tail; the remaining
// bricks are pipeline plumbing and the leaf-closedness extraction.
include "PikeSimRE.dfy"
include "WalkOkEntry.dfy"
include "LookCapture.dfy"
include "OracleEntry.dfy"

/** The top-level equivalence theorem: `MainTheorem` proves RegElk's compiled,
    executable engine (`FFullMatch`) agrees with the Linden/Warblre tree
    semantics (`MatcherSpec`) on the star fragment. Everything else in this
    module is either a small bridging fact or a piece of the final extraction
    (`MainExtraction`) that reads the engine's answer off the winning thread. */
module LindenElkMain {
  import opened Std.Wrappers
  import R = RegElkRegex
  import RB = Bytecode
  import CP = Compiler
  import NR = LindenElkNfaRep
  import AI = ArrayInterp
  import AReg = Array_Regs
  import LG = Groups
  import LT = Tree
  import LC = Chars
  import PT = PikeTree
  import CR = Correctness
  import PIV = LindenElkPikeInv
  import PSM = LindenElkPikeSim
  import LOr = Oracle
  import LAnc = Anchors
  import LCdn = Cdn
  import RC = Charclasses
  import AR = LindenElkActionsRep
  import EL = LindenElkEntryLk
  import RL = LindenElkRegsLaws
  import LKC = LindenElkLookCapture
  import LTB = LindenElkLookTables
  import SD = LindenSpanDuality
  import TM = LindenTreeMirror        // L3b: spec-tree backward<->forward mirror
  import TRM = LindenTreeResMirror    // L3b: leaf-groupmap mirror (TreeResMirror)
  import CDE = LindenCloseDisc        // L3b: CloseDisc + NoDupG + CloseDiscBody
  import LL = LindenElkLookLeaves
  import OE = LindenElkOracleEntry
  import OS = LindenElkOracleSpec
  import T = LindenElkTranslate
  import RD = LindenElkReduce
  import CM = LindenElkClockMono
  import NI = LindenElkNestInv
  import LES = LindenElkSpec
  import LFU = FunctionalUtils
  import PS = PikeSubset
  import ATR = LindenElkActionsTreeRep
  import LW = WarblreRegExpRecord
  import LS = Semantics
  import BS = BooleanSemantics
  import L = Regex
  import WP = WarblrePrimitives
  import LN = WarblreNumeric
  import LFS = FunctionalSemantics
  import FU = FunctionalUtils
  import TR = LindenElkTreeRep
  import TT = LindenElkTreeThread
  import CE = LindenElkCheckErase
  import WO = LindenElkWalkOk
  import WOE = LindenElkWalkOkEntry
  import SS = StrictSuffix

  // ==========================================================================
  // Bridge: our local closure IS Linden's (identical definitions over the
  // same step relation).
  // ==========================================================================
  /** Bridges the two "many VM steps" closures: RegElk's local `PSM.TrcRE`
      transitive closure agrees with Linden's own `CR.TrcPikeTree`, since both
      close the same `PikeTreeStep` relation. */
  least lemma TrcREToLinden(x: PT.PikeTreeState, y: PT.PikeTreeState)
    requires PSM.TrcRE(x, y)
    ensures CR.TrcPikeTree(x, y)
  {
    if x == y {
    } else {
      var z :| PT.PikeTreeStep(x, z) && PSM.TrcRE(z, y);
      TrcREToLinden(z, y);
    }
  }

  // ==========================================================================
  // The lazy prefix is filter-transparent: its quant (id 0) is always in the
  // present branch (a stored clock is >= -1 == the top threshold) and its
  // body (Dot) contains no captures.
  // ==========================================================================
  /** The synthetic lazy-star prefix `R.lazy_prefix` that wraps every compiled
      fragment is filter-transparent: since its body is capture-free and its
      quant clock is always "in the present branch", `filter_reset` sees
      straight through it to the underlying `ast`. */
  lemma FilterResetLazyPrefix(ast: R.regex, caps: AReg.Regs, look: AReg.Regs, quant: AReg.Regs)
    requires AI.get_idx(AReg.as_arrays(quant).1, 0) >= -1   // quant 0's stored clock (init -1, stamps >= 0)
    ensures AI.filter_reset(R.lazy_prefix(ast), caps, look, quant, -1)
         == AI.filter_reset(ast, caps, look, quant, -1)
  {
    var (cr, cc) := AReg.as_arrays(caps);
    var (_, lc) := AReg.as_arrays(look);
    var (_, qc) := AReg.as_arrays(quant);
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false), R.Re_character(R.Dot));
    assert R.lazy_prefix(ast) == R.Re_con(pre, ast);
    var qv := AI.get_idx(qc, 0);
    assert qv >= -1;
    // present branch: filter_capture(Dot-body, ..., qv) == cap_regs (no captures).
    assert AI.filter_capture(pre, cr, cc, lc, qc, -1)
        == AI.filter_capture(R.Re_character(R.Dot), cr, cc, lc, qc, qv);
    assert AI.filter_capture(R.Re_character(R.Dot), cr, cc, lc, qc, qv) == cr;
  }

  // ==========================================================================
  // Quant-register finality: in fragment code every SetQuantToClock has
  // bq == false, so quant VALUES stay negative (get_cp None -- makes
  // FNulledPlus/FReconstructPlus the identity) and quant CLOCKS stay >= -1
  // (init -1, stamps are nonnegative clock values -- discharges
  // FilterResetLazyPrefix's hypothesis).
  // ==========================================================================
  /** A single thread's quant registers are in their terminal shape for
      fragment code: every quant slot's stored capture-point is unset
      (negative) and every quant clock is at least the initial `-1`. */
  ghost predicate QuantRegsFinal(t: AI.Thread) {
    (forall k :: AI.get_idx(t.quant_regs.a_cp, k) < 0)
    && (forall k :: AI.get_idx(t.quant_regs.a_clk, k) >= -1)
  }

  /** `QuantRegsFinal` lifted to a whole VM state: holds of every active
      thread, every blocked thread, and `bestmatch` if present. */
  ghost predicate VmQuantFinal(s: AI.VmState) {
    (forall t | t in s.active :: QuantRegsFinal(t))
    && (forall tb | tb in s.blocked :: QuantRegsFinal(tb.0))
    && (s.bestmatch.Some? ==> QuantRegsFinal(s.bestmatch.value))
  }

  /** `SetQuantToClock` (with `bq == false`, the only case fragment code
      emits) preserves `QuantRegsFinal` on the written thread. */
  lemma QuantRegsFinalSet(t: AI.Thread, q: int, clk: int)
    requires QuantRegsFinal(t)
    requires clk >= -1
    ensures QuantRegsFinal(t.(quant_regs := AReg.set_reg(t.quant_regs, q, None, clk)))
  {
    var r := t.quant_regs;
    var r2 := AReg.set_reg(r, q, None, clk);
    if 0 <= q < |r.a_cp| && 0 <= q < |r.a_clk| {
      assert r2.a_cp == r.a_cp[q := -1] && r2.a_clk == r.a_clk[q := clk];
      forall k ensures AI.get_idx(r2.a_cp, k) < 0 {
        if 0 <= k < |r.a_cp| && k != q {
          assert r2.a_cp[k] == r.a_cp[k];
          assert AI.get_idx(r.a_cp, k) == r.a_cp[k];
        }
      }
      forall k ensures AI.get_idx(r2.a_clk, k) >= -1 {
        if 0 <= k < |r.a_clk| && k != q {
          assert r2.a_clk[k] == r.a_clk[k];
          assert AI.get_idx(r.a_clk, k) == r.a_clk[k];
        }
      }
    } else {
      assert r2 == r;
    }
  }

  /** `FAdvanceEpsilon` preserves `VmQuantFinal`, given that fragment code's
      every `SetQuantToClock` has its `bq` flag `false`. Structural induction
      over the epsilon-closure fuel, one case per bytecode instruction. */
  lemma FAdvanceEpsilonQuantFinal(
    c: RB.code, s: AI.VmState, ov: LOr.OracleView, dir: LAnc.direction)
    requires |s.processed.true_set| == RB.size(c) && |s.processed.false_set| == RB.size(c)
    requires forall pc: nat, q: int, b: bool ::
               NR.GetPcRE(c, pc) == Some(RB.SetQuantToClock(q, b)) ==> !b
    requires s.clock >= -1
    requires VmQuantFinal(s)
    ensures VmQuantFinal(AI.FAdvanceEpsilon(c, s, ov, dir).0)
    decreases AI.unprocessed(s.processed), |s.active|
  {
    if |s.active| == 0 { return; }
    var t := s.active[0];
    var ac := s.active[1..];
    assert t in s.active;
    assert forall x | x in ac :: x in s.active;
    if AI.bpc_mem(s.processed, t.pc, t.exit_allowed) {
      FAdvanceEpsilonQuantFinal(c, s.(active := ac), ov, dir);
      return;
    }
    var b0 := s.processed;
    var s1 := s.(clock := s.clock + 1, processed := AI.bpc_add(b0, t.pc, t.exit_allowed));
    assert AI.unprocessed(s1.processed) <= AI.unprocessed(b0)
           && (0 <= t.pc < RB.size(c) ==> AI.unprocessed(s1.processed) < AI.unprocessed(b0))
    by { AI.UnprocessedAdd(b0, t.pc, t.exit_allowed); }
    match RB.get_instr(c, t.pc) {
      case Consume(ce) =>
        var (nb, ni) := AI.add_thread(t, ce, s1.blocked, s1.isblocked);
        var s2 := s1.(blocked := nb, isblocked := ni, active := ac);
        assert VmQuantFinal(s2) by {
          forall tb | tb in s2.blocked ensures QuantRegsFinal(tb.0) {
            assert tb == (t, ce) || tb in s.blocked;
          }
        }
        FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
      case Accept =>
        assert QuantRegsFinal(t);
      case Jmp(x) =>
        var s2 := s1.(active := [t.(pc := x)] + ac);
        assert VmQuantFinal(s2) by {
          forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
            if t2 != t.(pc := x) { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
      case Fork(x, y) =>
        var newt := AI.Thread(x, t.capture_regs, t.look_regs, t.quant_regs, t.exit_allowed);
        var s2 := s1.(active := [newt, t.(pc := y)] + ac);
        assert VmQuantFinal(s2) by {
          forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
            if t2 != newt && t2 != t.(pc := y) { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
      case SetRegisterToCP(reg) =>
        var t2h := t.(capture_regs := AReg.set_reg(t.capture_regs, reg, Some(s1.cp), s1.clock), pc := t.pc + 1);
        var s2 := s1.(active := [t2h] + ac);
        assert VmQuantFinal(s2) by {
          forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
            if t2 != t2h { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
      case SetQuantToClock(q, bq) =>
        assert 0 <= t.pc < |c|;
        assert NR.GetPcRE(c, t.pc as nat) == Some(RB.SetQuantToClock(q, bq));
        assert !bq;
        var ocp := if bq then Some(s1.cp) else None;
        assert ocp == None;
        var t2h := t.(quant_regs := AReg.set_reg(t.quant_regs, q, ocp, s1.clock), pc := t.pc + 1);
        QuantRegsFinalSet(t, q, s1.clock);
        var s2 := s1.(active := [t2h] + ac);
        assert VmQuantFinal(s2) by {
          forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
            if t2 != t2h { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
      case CheckOracle(l) =>
        if LOr.view_get_oracle(ov, s1.cp, l) {
          var t2h := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(s1.cp), s1.clock));
          var s2 := s1.(active := [t2h] + ac);
          assert VmQuantFinal(s2) by {
            forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
              if t2 != t2h { assert t2 in s.active; }
            }
          }
          FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
        } else {
          FAdvanceEpsilonQuantFinal(c, s1.(active := ac), ov, dir);
        }
      case NegCheckOracle(l) =>
        if LOr.view_get_oracle(ov, s1.cp, l) {
          FAdvanceEpsilonQuantFinal(c, s1.(active := ac), ov, dir);
        } else {
          var s2 := s1.(active := [t.(pc := t.pc + 1)] + ac);
          assert VmQuantFinal(s2) by {
            forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
              if t2 != t.(pc := t.pc + 1) { assert t2 in s.active; }
            }
          }
          FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
        }
      case WriteOracle(l) =>
        FAdvanceEpsilonQuantFinal(c, s1.(active := ac), LOr.view_set_oracle(ov, s1.cp, l), dir);
      case BeginLoop =>
        var s2 := s1.(active := [t.(exit_allowed := false, pc := t.pc + 1)] + ac);
        assert VmQuantFinal(s2) by {
          forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
            if t2 != t.(exit_allowed := false, pc := t.pc + 1) { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
      case EndLoop =>
        if t.exit_allowed {
          var s2 := s1.(active := [t.(pc := t.pc + 1)] + ac);
          assert VmQuantFinal(s2) by {
            forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
              if t2 != t.(pc := t.pc + 1) { assert t2 in s.active; }
            }
          }
          FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
        } else {
          FAdvanceEpsilonQuantFinal(c, s1.(active := ac), ov, dir);
        }
      case CheckNullable(qid) =>
        if LCdn.cdn_get(s1.cdn, qid) {
          var s2 := s1.(active := [t.(pc := t.pc + 1)] + ac);
          assert VmQuantFinal(s2) by {
            forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
              if t2 != t.(pc := t.pc + 1) { assert t2 in s.active; }
            }
          }
          FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
        } else {
          FAdvanceEpsilonQuantFinal(c, s1.(active := ac), ov, dir);
        }
      case AnchorAssertion(a) =>
        if LAnc.is_satisfied(a, s1.context, dir) {
          var s2 := s1.(active := [t.(pc := t.pc + 1)] + ac);
          assert VmQuantFinal(s2) by {
            forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
              if t2 != t.(pc := t.pc + 1) { assert t2 in s.active; }
            }
          }
          FAdvanceEpsilonQuantFinal(c, s2, ov, dir);
        } else {
          FAdvanceEpsilonQuantFinal(c, s1.(active := ac), ov, dir);
        }
      case Fail =>
        FAdvanceEpsilonQuantFinal(c, s1.(active := ac), ov, dir);
    }
  }

  // With every quant VALUE negative, FNulledPlus (hence FReconstructPlus) is
  // the identity: the Some(start_cp) branch is unreachable.
  /** With every quant value negative (`VmQuantFinal`), `AI.FNulledPlus` (hence
      `FReconstructPlus`) is the identity: the "restore the started capture"
      branch is never taken because no quant was ever entered with a stamped
      start. */
  lemma FNulledPlusIdentity(reg: R.regex, cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs,
                            plus_bcv: seq<RB.code>, str: string, ov: LOr.OracleView,
                            dir: LAnc.direction)
    requires forall k :: AI.get_idx(qt.a_cp, k) < 0
    ensures AI.FNulledPlus(reg, cap, lk, qt, plus_bcv, str, ov, dir) == (cap, lk, qt, ov)
    decreases reg
  {
    match reg
    case Re_empty => case Re_character(_) => case Re_anchor(_) => case Re_lookaround(_, _, _) =>
    case Re_capture(_, r1) =>
      FNulledPlusIdentity(r1, cap, lk, qt, plus_bcv, str, ov, dir);
    case Re_alt(r1, r2) =>
      FNulledPlusIdentity(r1, cap, lk, qt, plus_bcv, str, ov, dir);
      FNulledPlusIdentity(r2, cap, lk, qt, plus_bcv, str, ov, dir);
    case Re_con(r1, r2) =>
      FNulledPlusIdentity(r1, cap, lk, qt, plus_bcv, str, ov, dir);
      FNulledPlusIdentity(r2, cap, lk, qt, plus_bcv, str, ov, dir);
    case Re_quant(nul, qid, quanttype, body) =>
      assert AReg.get_cp(qt, qid).None? by {
        if 0 <= qid < |qt.a_cp| {
          assert AI.get_idx(qt.a_cp, qid) == qt.a_cp[qid];
          assert qt.a_cp[qid] < 0;
        }
      }
      FNulledPlusIdentity(body, cap, lk, qt, plus_bcv, str, ov, dir);
  }

  // ==========================================================================
  // Top-level loop-flag irrelevance: with no Acheck anywhere in the action
  // list, the initial LoopBool is never consulted -- every Acheck the
  // semantics pushes comes with an explicit CannotExit reset, and Character
  // reads reset to CanExit. Bridges BooleanCorrect's CanExit tree to the
  // CannotExit form InitialPikeInvFullRE seeds (RegElk's ea == false).
  // ==========================================================================
  /** When an action stack contains no `Acheck`, `BooleanSemantics.BoolTree`'s
      initial loop-flag is irrelevant to the resulting tree — bridges the
      `CanExit`-seeded tree `BooleanCorrect` produces to the `CannotExit` form
      `InitialPikeInvFullRE` expects (RegElk always starts a match attempt
      with `exit_allowed == false`). */
  least lemma BoolTreeLbIrrel(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                              b1: BS.LoopBool, b2: BS.LoopBool, t: LT.Tree)
    requires EL.BoolTreeLk(rer, acts, inp, b1, t)
    requires forall i :: 0 <= i < |acts| ==> !acts[i].Acheck?
    ensures EL.BoolTreeLk(rer, acts, inp, b2, t)
  {
    if |acts| == 0 {
      assert t == LT.Match;
    } else {
      var cont := acts[1..];
      assert forall i :: 0 <= i < |cont| ==> !cont[i].Acheck?;
      match acts[0]
      case Acheck(strcheck) =>
        assert false;
      case Aclose(gid) =>
        BoolTreeLbIrrel(rer, cont, inp, b1, b2, t.t);
      case Areg(r) =>
        match r
        case Epsilon =>
          BoolTreeLbIrrel(rer, cont, inp, b1, b2, t);
        case Character(cd) =>
          // both sides reset to CanExit: the continuation fact is shared.
          if LC.ReadChar(rer, cd, inp, WP.Forward).None? {
            assert t == LT.Mismatch;
          } else {
            var pair := LC.ReadChar(rer, cd, inp, WP.Forward).value;
            assert t.Read? && t.c == pair.0;
            assert EL.BoolTreeLk(rer, cont, pair.1, BS.CanExit, t.t);
          }
        case Disjunction(r1, r2) =>
          assert t.Choice?;
          assert forall i :: 0 <= i < |[LS.Areg(r1)] + cont| ==> !([LS.Areg(r1)] + cont)[i].Acheck?;
          assert forall i :: 0 <= i < |[LS.Areg(r2)] + cont| ==> !([LS.Areg(r2)] + cont)[i].Acheck?;
          BoolTreeLbIrrel(rer, [LS.Areg(r1)] + cont, inp, b1, b2, t.t1);
          BoolTreeLbIrrel(rer, [LS.Areg(r2)] + cont, inp, b1, b2, t.t2);
        case Sequence(r1, r2) =>
          assert forall i :: (0 <= i < |[LS.Areg(r1), LS.Areg(r2)] + cont|
                              ==> !([LS.Areg(r1), LS.Areg(r2)] + cont)[i].Acheck?);
          BoolTreeLbIrrel(rer, [LS.Areg(r1), LS.Areg(r2)] + cont, inp, b1, b2, t);
        case Quantified(greedy, min, delta, r1) =>
          var gidl := L.DefGroups(r1);
          if min > 0 {
            assert t.GroupActionT?;
            var acts1 := [LS.Areg(r1), LS.Areg(L.Quantified(greedy, min - 1, delta, r1))] + cont;
            assert forall i :: 0 <= i < |acts1| ==> !acts1[i].Acheck?;
            BoolTreeLbIrrel(rer, acts1, inp, b1, b2, t.t);
          } else if delta == LN.NN(0) {
            BoolTreeLbIrrel(rer, cont, inp, b1, b2, t);
          } else {
            assert t.Choice?;
            var itert := if greedy then t.t1 else t.t2;
            var skipt := if greedy then t.t2 else t.t1;
            assert itert.GroupActionT?;
            // the iteration branch is at an explicit CannotExit: shared fact.
            assert EL.BoolTreeLk(rer, [LS.Areg(r1), LS.Acheck(inp), LS.Areg(L.Quantified(greedy, 0, LFS.NoiPred(delta), r1))] + cont,
                                 inp, BS.CannotExit, itert.t);
            // the skip branch threads the flag: induct.
            BoolTreeLbIrrel(rer, cont, inp, b1, b2, skipt);
          }
        case Group(gid, r1) =>
          assert t.GroupActionT?;
          var acts1 := [LS.Areg(r1), LS.Aclose(gid)] + cont;
          assert forall i :: 0 <= i < |acts1| ==> !acts1[i].Acheck?;
          BoolTreeLbIrrel(rer, acts1, inp, b1, b2, t.t);
        case AnchorR(a) =>
          if LS.AnchorSatisfied(rer, a, inp) {
            assert t.AnchorPass?;
            BoolTreeLbIrrel(rer, cont, inp, b1, b2, t.t);
          } else {
            assert t == LT.Mismatch;
          }
        case LookaroundR(lk, r1) =>
          // the gate does not read the loop flag; recurse under it
          match t {
            case LK(lk2, tlk, tc) => BoolTreeLbIrrel(rer, cont, inp, b1, b2, tc);
            case _ =>
          }
        case Backreference(_) =>
          assert false;
    }
  }

  // ==========================================================================
  // Leaf gms are CLOSED: the open groups of the threaded gm are always
  // covered by the pending Aclose actions, and a Match leaf requires the
  // action list exhausted. This single fact delivers, pointwise, both
  // GmOfLiveEqGmOf's and GmOfCapArrayBridge's hypotheses at the final thread.
  // ==========================================================================
  /** The set of group ids that are open (started but not yet closed) in `gm`. */
  ghost function OpenOf(gm: LG.GroupMap): set<LG.GroupId> {
    set g | g in gm && gm[g].endIdx.None?
  }

  /** The set of group ids that some pending `Aclose` action in `acts` will
      still close. */
  ghost function PendingCloses(acts: LS.Actions): set<LG.GroupId> {
    set i | 0 <= i < |acts| && acts[i].Aclose? :: acts[i].gid
  }

  /** Every group recorded in `gm` has been closed — no group is left open. */
  ghost predicate ClosedGm(gm: LG.GroupMap) {
    forall g :: g in gm ==> gm[g].endIdx.Some?
  }

  // ==========================================================================
  // Item 0 support: every CLOSED range in a spec leaf is ORDERED (start <= end).
  // `GMClose` always normalizes min/max, `GMOpen` records an OPEN range, `GMReset`
  // removes — so ordering is a LOCAL per-range property preserved compositionally
  // by every `TreeRes` step (including the LK-node merge, which just continues at
  // the sub-run's ordered result). Used at `MainExtraction` to discharge the
  // widened `NormalizeArr`'s "no reversed pairs" side condition for the FORWARD
  // fragment (a lookbehind-owned group's engine spans are reversed; the spec leaf
  // stays ordered because `GMClose` orders regardless of scan direction).
  // ==========================================================================

  /** Every closed range in `gm` is ordered (`startIdx <= endIdx.value`). */
  ghost predicate OrderedGm(gm: LG.GroupMap) {
    forall g :: g in gm && gm[g].endIdx.Some? ==> gm[g].startIdx <= gm[g].endIdx.value
  }

  /** `GMUpdate` preserves `OrderedGm`: `GMOpen` records an open range, `GMClose`
      normalizes to `min <= max`, `GMReset` removes. */
  lemma GMUpdateOrdered(a: LG.GroupAction, idx: nat, gm: LG.GroupMap)
    requires OrderedGm(gm)
    ensures OrderedGm(LG.GMUpdate(a, idx, gm))
  {
    match a
    case Open(g) =>
    case Close(g) =>
      forall g' | g' in LG.GMClose(idx, g, gm) && LG.GMClose(idx, g, gm)[g'].endIdx.Some?
        ensures LG.GMClose(idx, g, gm)[g'].startIdx <= LG.GMClose(idx, g, gm)[g'].endIdx.value
      {
        if g' == g {
          match LG.Find(g, gm) case Some(rg) => case None => {}
        }
      }
    case Reset(gs) =>
  }

  /** A spec `TreeRes` from an ordered gm lands (on a match) at an ordered leaf gm.
      Structural induction; the LK node just continues at the (recursively ordered)
      sub-run result. */
  lemma TreeResOrdered(t: LT.Tree, gm: LG.GroupMap, inp: LC.Input, dir: WP.Direction)
    requires OrderedGm(gm)
    ensures LT.TreeRes(t, gm, inp, dir).Some? ==> OrderedGm(LT.TreeRes(t, gm, inp, dir).value.1)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) =>
      TreeResOrdered(t1, gm, inp, dir);
      TreeResOrdered(t2, gm, inp, dir);
    case Read(c, t1) =>
      TreeResOrdered(t1, gm, LC.AdvanceInputP(inp, dir), dir);
    case ReadBackRef(brStr, t1) =>
      TreeResOrdered(t1, gm, LC.AdvanceInputN(inp, |brStr|, dir), dir);
    case Progress(t1) =>
      TreeResOrdered(t1, gm, inp, dir);
    case AnchorPass(a, t1) =>
      TreeResOrdered(t1, gm, inp, dir);
    case GroupActionT(a, t1) =>
      GMUpdateOrdered(a, LC.Idx(inp), gm);
      TreeResOrdered(t1, LG.GMUpdate(a, LC.Idx(inp), gm), inp, dir);
    case LK(lk, tlk, t1) =>
      if L.Positivity(lk) {
        TreeResOrdered(tlk, gm, inp, L.LkDir(lk));
        match LT.TreeRes(tlk, gm, inp, L.LkDir(lk))
        case None =>
        case Some(pair) => TreeResOrdered(t1, pair.1, inp, dir);
      } else {
        match LT.TreeRes(tlk, gm, inp, L.LkDir(lk))
        case None => TreeResOrdered(t1, gm, inp, dir);
        case Some(_) =>
      }
    case LKFail(_, _) =>
  }

  /** The spec first leaf has all ordered ranges (folded from `LG.Empty`). */
  lemma FirstLeafOrdered(t: LT.Tree, inp: LC.Input, leaf: LT.Leaf)
    requires LT.FirstLeaf(t, inp) == Some(leaf)
    ensures OrderedGm(leaf.1)
  {
    assert OrderedGm(LG.Empty);
    TreeResOrdered(t, LG.Empty, inp, WP.Forward);
  }

  // ==========================================================================
  // L3a: inside-look-group bookkeeping for FirstLeafClosed. A capturing lookahead
  // body records CLOSED captures into the continuation's map; the disjointness
  // invariant `DomLkDisjoint` (dom(gm) misses the still-pending inside-look
  // groups) lets the LK case relate the body-from-gm computation to a
  // body-from-Empty computation on the body's own groups.
  // ==========================================================================

  /** The inside-look groups of every regex still pending in `acts`. */
  ghost function LkBodyGroupsActs(acts: LS.Actions): set<LG.GroupId>
    decreases |acts|
  {
    if |acts| == 0 then {}
    else (if acts[0].Areg? then LL.LkBodyGroups(acts[0].r) else {}) + LkBodyGroupsActs(acts[1..])
  }

  /** All group ids DEFINED across `acts`, in order — for the uniqueness invariant. */
  ghost function AllDefsActs(acts: LS.Actions): seq<LG.GroupId>
    decreases |acts|
  {
    if |acts| == 0 then []
    else (if acts[0].Areg? then L.DefGroups(acts[0].r) else []) + AllDefsActs(acts[1..])
  }

  ghost predicate NoDupSeq(s: seq<LG.GroupId>) { forall i, j :: 0 <= i < j < |s| ==> s[i] != s[j] }

  /** dom(gm) is disjoint from the inside-look groups still pending in `acts`. */
  ghost predicate DomLkDisjoint(gm: LG.GroupMap, acts: LS.Actions) {
    forall g :: g in gm ==> g !in LkBodyGroupsActs(acts)
  }

  /** L3a (quantifier-stable): every pending inside-look group already present in
      `gm` is CLOSED. (A quantified capturing look re-enters its own body groups;
      each iteration records them CLOSED, so this holds where plain disjointness
      would fail.) */
  ghost predicate LkClosedInGm(gm: LG.GroupMap, acts: LS.Actions) {
    forall g :: g in gm && g in LkBodyGroupsActs(acts) ==> gm[g].endIdx.Some?
  }

  /** Groups defined OUTSIDE lookaround bodies of `r` (a `Group` at this level, not
      the body of a look). Disjoint from `LkBodyGroups` for a unique-id regex. */
  ghost function DefGroupsOutsideLooksL(r: L.Regex): set<LG.GroupId>
    decreases r
  {
    match r
    case Disjunction(r1, r2) => DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2)
    case Sequence(r1, r2) => DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2)
    case Quantified(_, _, _, r1) => DefGroupsOutsideLooksL(r1)
    case Group(id, r1) => {id} + DefGroupsOutsideLooksL(r1)
    case LookaroundR(_, _) => {}
    case _ => {}
  }

  ghost function OuterDefsActs(acts: LS.Actions): set<LG.GroupId>
    decreases |acts|
  {
    if |acts| == 0 then {}
    else (if acts[0].Areg? then DefGroupsOutsideLooksL(acts[0].r) else (if acts[0].Aclose? then {acts[0].gid} else {}))
         + OuterDefsActs(acts[1..])
  }

  /** The openable (outer) groups are disjoint from the inside-look groups — the
      quantifier-stable replacement for `NoDupSeq(AllDefsActs)`. */
  ghost predicate OuterLkDisjoint(acts: LS.Actions) {
    OuterDefsActs(acts) * LkBodyGroupsActs(acts) == {}
  }

  lemma OuterDefsActsCons(x: LS.Action, cont: LS.Actions)
    ensures OuterDefsActs([x] + cont) == (if x.Areg? then DefGroupsOutsideLooksL(x.r) else (if x.Aclose? then {x.gid} else {})) + OuterDefsActs(cont)
  { assert ([x] + cont)[0] == x && ([x] + cont)[1..] == cont; }

  /** `DefGroups` no-dup ⇒ a group is not both outside a look and inside one. */
  lemma OuterLkFromNoDup(r: L.Regex)
    requires NoDupSeq(L.DefGroups(r))
    ensures DefGroupsOutsideLooksL(r) * LL.LkBodyGroups(r) == {}
    decreases r
  {
    match r
    case Disjunction(r1, r2) =>
      NoDupConcat(L.DefGroups(r1), L.DefGroups(r2)); OuterLkFromNoDup(r1); OuterLkFromNoDup(r2);
      LkBodyGroupsSubDefs(r1); LkBodyGroupsSubDefs(r2); DefGroupsOutsideSubDefs(r1); DefGroupsOutsideSubDefs(r2);
    case Sequence(r1, r2) =>
      NoDupConcat(L.DefGroups(r1), L.DefGroups(r2)); OuterLkFromNoDup(r1); OuterLkFromNoDup(r2);
      LkBodyGroupsSubDefs(r1); LkBodyGroupsSubDefs(r2); DefGroupsOutsideSubDefs(r1); DefGroupsOutsideSubDefs(r2);
    case Quantified(_, _, _, r1) => OuterLkFromNoDup(r1);
    case Group(id, r1) =>
      assert L.DefGroups(r) == [id] + L.DefGroups(r1);
      NoDupConcat([id], L.DefGroups(r1)); OuterLkFromNoDup(r1); LkBodyGroupsSubDefs(r1);
    case LookaroundR(_, r1) =>
    case _ =>
  }

  /** Reverse of `NoDupConcat`: two individually dup-free, elementwise-disjoint
      sequences concatenate to a dup-free sequence. Disjointness is phrased on
      indices (`a[i] != b[j]`) so the quantifier has a syntactic trigger. */
  lemma NoDupFromDisjoint(a: seq<LG.GroupId>, b: seq<LG.GroupId>)
    requires NoDupSeq(a) && NoDupSeq(b)
    requires forall i, j :: 0 <= i < |a| && 0 <= j < |b| ==> a[i] != b[j]
    ensures NoDupSeq(a + b)
  {
    forall i, j | 0 <= i < j < |a + b| ensures (a + b)[i] != (a + b)[j] {
      if j < |a| {
        assert (a + b)[i] == a[i] && (a + b)[j] == a[j];
      } else if i >= |a| {
        assert (a + b)[i] == b[i - |a|] && (a + b)[j] == b[j - |a|];
      } else {
        assert (a + b)[i] == a[i] && (a + b)[j] == b[j - |a|];
      }
    }
  }

  /** Prepending a fresh id `x` (not in `b`) to a dup-free `b` stays dup-free. */
  lemma NoDupPrepend(x: LG.GroupId, b: seq<LG.GroupId>)
    requires NoDupSeq(b)
    requires forall j :: 0 <= j < |b| ==> b[j] != x
    ensures NoDupSeq([x] + b)
  {
    forall i, j | 0 <= i < j < |[x] + b| ensures ([x] + b)[i] != ([x] + b)[j] {
      if i == 0 {
        assert ([x] + b)[i] == x && ([x] + b)[j] == b[j - 1];
      } else {
        assert ([x] + b)[i] == b[i - 1] && ([x] + b)[j] == b[j - 1];
      }
    }
  }

  /** The annotate/translate output has NO DUPLICATE group ids: each syntactic
      capture gets a fresh id from the monotone counter `c`. Proven by mirroring
      `RD.TA`'s structure; disjointness of sibling group ranges comes from
      `TA_DefGroups` (range) + `TA_Counters` (counter advance). */
  lemma TA_NoDup(ra: R.raw_regex, c: int, l: int, q: int)
    requires T.Latin1Wf(ra) && c >= 0
    ensures NoDupSeq(L.DefGroups(RD.TA(ra, c, l, q).0))
    decreases ra
  {
    match ra
    case Raw_empty => RD.TA_Empty(c, l, q);
    case Raw_character(ch) => RD.TA_Char(ch, c, l, q);
    case Raw_anchor(a) => RD.TA_Anchor(a, c, l, q);
    case Raw_alt(r1, r2) =>
      RD.TA_Alt(r1, r2, c, l, q);
      var (e1, c1, l1, q1) := RD.TA(r1, c, l, q);
      var (e2, c2, l2, q2) := RD.TA(r2, c1, l1, q1);
      assert L.DefGroups(RD.TA(ra, c, l, q).0) == L.DefGroups(e1) + L.DefGroups(e2);
      TA_NoDup(r1, c, l, q); TA_NoDup(r2, c1, l1, q1);
      RD.TA_Counters(r1, c, l, q);
      forall i, j | 0 <= i < |L.DefGroups(e1)| && 0 <= j < |L.DefGroups(e2)|
        ensures L.DefGroups(e1)[i] != L.DefGroups(e2)[j] {
        RD.TA_DefGroups(r1, c, l, q, L.DefGroups(e1)[i]);
        RD.TA_DefGroups(r2, c1, l1, q1, L.DefGroups(e2)[j]);
      }
      NoDupFromDisjoint(L.DefGroups(e1), L.DefGroups(e2));
    case Raw_con(r1, r2) =>
      RD.TA_Con(r1, r2, c, l, q);
      var (e1, c1, l1, q1) := RD.TA(r1, c, l, q);
      var (e2, c2, l2, q2) := RD.TA(r2, c1, l1, q1);
      assert L.DefGroups(RD.TA(ra, c, l, q).0) == L.DefGroups(e1) + L.DefGroups(e2);
      TA_NoDup(r1, c, l, q); TA_NoDup(r2, c1, l1, q1);
      RD.TA_Counters(r1, c, l, q);
      forall i, j | 0 <= i < |L.DefGroups(e1)| && 0 <= j < |L.DefGroups(e2)|
        ensures L.DefGroups(e1)[i] != L.DefGroups(e2)[j] {
        RD.TA_DefGroups(r1, c, l, q, L.DefGroups(e1)[i]);
        RD.TA_DefGroups(r2, c1, l1, q1, L.DefGroups(e2)[j]);
      }
      NoDupFromDisjoint(L.DefGroups(e1), L.DefGroups(e2));
    case Raw_quant(qk, r1) =>
      RD.TA_Quant(qk, r1, c, l, q);
      var (e1, c1, l1, q1) := RD.TA(r1, c, l, q + 1);
      assert L.DefGroups(RD.TA(ra, c, l, q).0) == L.DefGroups(e1);
      TA_NoDup(r1, c, l, q + 1);
    case Raw_count(cq, r1) =>
      RD.TA_Count(cq, r1, c, l, q);
      var (e1, c1, l1, q1) := RD.TA(r1, c, l, q + 1);
      assert L.DefGroups(RD.TA(ra, c, l, q).0) == L.DefGroups(e1);
      TA_NoDup(r1, c, l, q + 1);
    case Raw_capture(r1) =>
      RD.TA_Cap(r1, c, l, q);
      var (e1, c1, l1, q1) := RD.TA(r1, c + 1, l, q);
      assert L.DefGroups(RD.TA(ra, c, l, q).0) == [c as nat] + L.DefGroups(e1);
      TA_NoDup(r1, c + 1, l, q);
      forall j | 0 <= j < |L.DefGroups(e1)| ensures L.DefGroups(e1)[j] != c as nat {
        RD.TA_DefGroups(r1, c + 1, l, q, L.DefGroups(e1)[j]);   // e1[j] >= c+1 > c
      }
      NoDupPrepend(c as nat, L.DefGroups(e1));
    case Raw_lookaround(lk, r1) =>
      RD.TA_Look(lk, r1, c, l, q);
      var (e1, c1, l1, q1) := RD.TA(r1, c, l + 1, q);
      assert L.DefGroups(RD.TA(ra, c, l, q).0) == L.DefGroups(e1);
      TA_NoDup(r1, c, l + 1, q);
  }

  /** The top-level discharge: the whole translated regex satisfies the
      `OuterLkDisjoint` action invariant, because its group ids are unique. */
  lemma SpecRegexOuterLkDisjoint(raw: R.raw_regex)
    requires T.Latin1Wf(raw)
    ensures OuterLkDisjoint([LS.Areg(LES.SpecRegex(raw))])
    ensures NoDupSeq(L.DefGroups(LES.SpecRegex(raw)))
  {
    var body := RD.TA(raw, 1, 1, 1).0;
    RD.SpecRegexE(raw, body);
    var spec := LES.SpecRegex(raw);
    // spec == .*? ++ Group(0, body); the prefix defines no groups.
    assert L.DefGroups(spec) == [0] + L.DefGroups(body);
    TA_NoDup(raw, 1, 1, 1);
    forall j | 0 <= j < |L.DefGroups(body)| ensures L.DefGroups(body)[j] != 0 {
      RD.TA_DefGroups(raw, 1, 1, 1, L.DefGroups(body)[j]);   // body groups >= 1 > 0
    }
    NoDupPrepend(0, L.DefGroups(body));
    OuterLkFromNoDup(spec);
    LkBodyGroupsActsCons(LS.Areg(spec), []);
    OuterDefsActsCons(LS.Areg(spec), []);
    assert LkBodyGroupsActs([LS.Areg(spec)]) == LL.LkBodyGroups(spec);
    assert OuterDefsActs([LS.Areg(spec)]) == DefGroupsOutsideLooksL(spec);
  }

  /** `NoLkBrL` (look-/backref-free) ⇒ `PikeLkRegex` (the fragment is trivially met). */
  lemma NoLkBrImpliesPikeLk(r: L.Regex)
    requires EL.NoLkBrL(r)
    ensures EL.PikeLkRegex(r)
    decreases r
  {
    match r
    case Disjunction(r1, r2) => NoLkBrImpliesPikeLk(r1); NoLkBrImpliesPikeLk(r2);
    case Sequence(r1, r2) => NoLkBrImpliesPikeLk(r1); NoLkBrImpliesPikeLk(r2);
    case Quantified(_, _, _, r1) => NoLkBrImpliesPikeLk(r1);
    case Group(_, r1) => NoLkBrImpliesPikeLk(r1);
    case _ =>
  }

  /** `GroupFreeL` (no groups/looks/backrefs) ⇒ `NoLkBrL`. */
  lemma GroupFreeImpliesNoLkBr(r: L.Regex)
    requires SD.GroupFreeL(r)
    ensures EL.NoLkBrL(r)
    decreases r
  {
    match r
    case Disjunction(r1, r2) => GroupFreeImpliesNoLkBr(r1); GroupFreeImpliesNoLkBr(r2);
    case Sequence(r1, r2) => GroupFreeImpliesNoLkBr(r1); GroupFreeImpliesNoLkBr(r2);
    case Quantified(_, _, _, r1) => GroupFreeImpliesNoLkBr(r1);
    case _ =>
  }

  /** `DefGroupsOutsideLooksL ⊆ DefGroups`. */
  lemma DefGroupsOutsideSubDefs(r: L.Regex)
    ensures DefGroupsOutsideLooksL(r) <= (set g | g in L.DefGroups(r))
    decreases r
  {
    match r
    case Disjunction(r1, r2) => DefGroupsOutsideSubDefs(r1); DefGroupsOutsideSubDefs(r2);
    case Sequence(r1, r2) => DefGroupsOutsideSubDefs(r1); DefGroupsOutsideSubDefs(r2);
    case Quantified(_, _, _, r1) => DefGroupsOutsideSubDefs(r1);
    case Group(_, r1) => DefGroupsOutsideSubDefs(r1);
    case _ =>
  }

  /** Every defined group is EITHER outside every look OR inside some look body —
      the `DefGroups` split (`OuterLkFromNoDup` gives disjointness; this gives
      cover). Needed by the S-ii quant reset case. */
  lemma DefGroupsInLkOrOutside(r: L.Regex)
    ensures forall g :: g in L.DefGroups(r) ==> g in DefGroupsOutsideLooksL(r) || g in LL.LkBodyGroups(r)
    decreases r
  {
    match r
    case Disjunction(r1, r2) => DefGroupsInLkOrOutside(r1); DefGroupsInLkOrOutside(r2);
    case Sequence(r1, r2) => DefGroupsInLkOrOutside(r1); DefGroupsInLkOrOutside(r2);
    case Quantified(_, _, _, r1) => DefGroupsInLkOrOutside(r1);
    case Group(id, r1) => DefGroupsInLkOrOutside(r1);
    case LookaroundR(lk, r1) =>
    // DefGroups(LookaroundR) == DefGroups(r1) <= set(DefGroups(r1)) <= LkBodyGroups(LookaroundR)
    case _ =>
  }

  /** S-ii: a SETTLED inside-look `S`-group (present-worthy, look no longer pending)
      is NOT in a pending quantifier body's `DefGroups` — else it would be an inside-
      look group of that body, hence still pending. So the `GMReset` never touches it. */
  lemma QuantSettledNotReset(r: L.Regex, r1: L.Regex, cont: LS.Actions, acts: LS.Actions,
                             S: set<LG.GroupId>, g: LG.GroupId)
    requires r.Quantified? && r.r1 == r1 && acts == [LS.Areg(r)] + cont
    requires forall g': LG.GroupId :: g' in S ==> g' !in OuterDefsActs(acts)
    requires g in S && g !in LkBodyGroupsActs(acts)
    ensures g !in L.DefGroups(r1)
  {
    if g in L.DefGroups(r1) {
      DefGroupsInLkOrOutside(r1);
      LkBodyGroupsActsCons(LS.Areg(r), cont);
      OuterDefsActsCons(LS.Areg(r), cont);
      assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1);   // r == Quantified(..,r1)
      assert LL.LkBodyGroups(r) == LL.LkBodyGroups(r1);
      // g in DefGroupsOutsideLooksL(r1) <= OuterDefsActs(acts): contradicts g in S;
      // g in LkBodyGroups(r1) <= LkBodyGroupsActs(acts): contradicts g !in LkBodyGroupsActs(acts).
    }
  }

  lemma LkBodyGroupsActsCons(x: LS.Action, cont: LS.Actions)
    ensures LkBodyGroupsActs([x] + cont) == (if x.Areg? then LL.LkBodyGroups(x.r) else {}) + LkBodyGroupsActs(cont)
  { assert ([x] + cont)[0] == x && ([x] + cont)[1..] == cont; }

  /** `NoDupSeq` is preserved on any suffix / removing a prefix. */
  lemma NoDupTailSeq(a: seq<LG.GroupId>, b: seq<LG.GroupId>)
    requires NoDupSeq(a + b)
    ensures NoDupSeq(b)
  { forall i, j | 0 <= i < j < |b| ensures b[i] != b[j] { assert (a + b)[|a| + i] == b[i] && (a + b)[|a| + j] == b[j]; } }

  /** Dropping a middle chunk `b` preserves `NoDupSeq` (a+c ⊆ a+b+c, order kept). */
  lemma NoDupMid(a: seq<LG.GroupId>, b: seq<LG.GroupId>, c: seq<LG.GroupId>)
    requires NoDupSeq(a + b + c)
    ensures NoDupSeq(a + c)
  {
    forall i, j | 0 <= i < j < |a + c| ensures (a + c)[i] != (a + c)[j] {
      var s := a + b + c;
      var i' := if i < |a| then i else i + |b|;
      var j' := if j < |a| then j else j + |b|;
      assert (a + c)[i] == s[i'] && (a + c)[j] == s[j'] && i' < j';
    }
  }

  /** The invariant threads to the tail `cont` (with `gm` unchanged or domain-
      shrunk): the head action contributes ⊇{} to `LkBodyGroupsActs` and a prefix
      to `AllDefsActs`, both of which only shrink the constraint. */
  lemma TailInv(gm: LG.GroupMap, gm2: LG.GroupMap, acts: LS.Actions)
    requires |acts| > 0
    requires LkClosedInGm(gm, acts) && OuterLkDisjoint(acts)
    requires forall g :: g in gm2 ==> g in gm && (gm2[g].endIdx.Some? || gm2[g] == gm[g])
    ensures LkClosedInGm(gm2, acts[1..]) && OuterLkDisjoint(acts[1..])
  {
    var cont := acts[1..];
    assert acts == [acts[0]] + cont;
    LkBodyGroupsActsCons(acts[0], cont);
    OuterDefsActsCons(acts[0], cont);
  }

  /** The invariant threads to a rewritten action list `sub` whose look groups and
      outer defs are contained in `acts`' (the Disjunction/Sequence/Quantified
      rewrites). `gm2` groups are in `gm`, closed or unchanged. */
  lemma SubInv(gm: LG.GroupMap, gm2: LG.GroupMap, sub: LS.Actions, acts: LS.Actions)
    requires LkClosedInGm(gm, acts) && OuterLkDisjoint(acts)
    requires LkBodyGroupsActs(sub) <= LkBodyGroupsActs(acts)
    requires OuterDefsActs(sub) <= OuterDefsActs(acts)
    requires forall g :: g in gm2 ==> g in gm && (gm2[g].endIdx.Some? || gm2[g] == gm[g])
    ensures LkClosedInGm(gm2, sub) && OuterLkDisjoint(sub)
  {}

  /** Threading for the quantifier rewrite `[Areg(q)]+cont ⤳ [Areg(r1),Areg(q')]+
      cont`, where `q`,`q'` are quantifiers over `r1` (same look/outer groups). */
  lemma QuantSubInv(gm: LG.GroupMap, gm2: LG.GroupMap, r: L.Regex, r1: L.Regex, q': L.Regex,
                    cont: LS.Actions, acts: LS.Actions, acts1: LS.Actions)
    requires acts == [LS.Areg(r)] + cont && acts1 == [LS.Areg(r1), LS.Areg(q')] + cont
    requires LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) && LL.LkBodyGroups(q') == LL.LkBodyGroups(r1)
    requires DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) && DefGroupsOutsideLooksL(q') == DefGroupsOutsideLooksL(r1)
    requires LkClosedInGm(gm, acts) && OuterLkDisjoint(acts)
    requires forall g :: g in gm2 ==> g in gm && (gm2[g].endIdx.Some? || gm2[g] == gm[g])
    ensures LkClosedInGm(gm2, acts1) && OuterLkDisjoint(acts1)
  {
    assert acts1 == [LS.Areg(r1)] + ([LS.Areg(q')] + cont);
    LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), [LS.Areg(q')] + cont); LkBodyGroupsActsCons(LS.Areg(q'), cont);
    OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Areg(q')] + cont); OuterDefsActsCons(LS.Areg(q'), cont);
    SubInv(gm, gm2, acts1, acts);
  }

  /** Threading for the delta-else quantifier rewrite `[Areg(q)]+cont ⤳
      [Areg(r1),Acheck,Areg(q'')]+cont`. `Acheck` carries no groups. */
  lemma QuantSubInvCheck(gm: LG.GroupMap, gm2: LG.GroupMap, r: L.Regex, r1: L.Regex, q'': L.Regex,
                         inp: LC.Input, cont: LS.Actions, acts: LS.Actions, acts1: LS.Actions)
    requires acts == [LS.Areg(r)] + cont && acts1 == [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q'')] + cont
    requires LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) && LL.LkBodyGroups(q'') == LL.LkBodyGroups(r1)
    requires DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) && DefGroupsOutsideLooksL(q'') == DefGroupsOutsideLooksL(r1)
    requires LkClosedInGm(gm, acts) && OuterLkDisjoint(acts)
    requires forall g :: g in gm2 ==> g in gm && (gm2[g].endIdx.Some? || gm2[g] == gm[g])
    ensures LkClosedInGm(gm2, acts1) && OuterLkDisjoint(acts1)
  {
    assert acts1 == [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q'')] + cont));
    LkBodyGroupsActsCons(LS.Areg(r), cont);
    LkBodyGroupsActsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q'')] + cont));
    LkBodyGroupsActsCons(LS.Acheck(inp), [LS.Areg(q'')] + cont);
    LkBodyGroupsActsCons(LS.Areg(q''), cont);
    OuterDefsActsCons(LS.Areg(r), cont);
    OuterDefsActsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q'')] + cont));
    OuterDefsActsCons(LS.Acheck(inp), [LS.Areg(q'')] + cont);
    OuterDefsActsCons(LS.Areg(q''), cont);
    SubInv(gm, gm2, acts1, acts);
  }

  lemma AllDefsActsCons(x: LS.Action, cont: LS.Actions)
    ensures AllDefsActs([x] + cont) == (if x.Areg? then L.DefGroups(x.r) else []) + AllDefsActs(cont)
  { assert ([x] + cont)[0] == x && ([x] + cont)[1..] == cont; }

  /** Inside-look groups of `r` are a subset of ALL its defined groups. */
  lemma LkBodyGroupsSubDefs(r: L.Regex)
    ensures LL.LkBodyGroups(r) <= (set g | g in L.DefGroups(r))
    decreases r
  {
    match r
    case Disjunction(r1, r2) => LkBodyGroupsSubDefs(r1); LkBodyGroupsSubDefs(r2);
    case Sequence(r1, r2) => LkBodyGroupsSubDefs(r1); LkBodyGroupsSubDefs(r2);
    case Quantified(_, _, _, r1) => LkBodyGroupsSubDefs(r1);
    case Group(_, r1) => LkBodyGroupsSubDefs(r1);
    case LookaroundR(_, r1) => LkBodyGroupsSubDefs(r1);
    case _ =>
  }

  /** The action-level lift: pending inside-look groups ⊆ all defined groups. */
  lemma LkBodyGroupsActsSubAllDefs(acts: LS.Actions)
    ensures LkBodyGroupsActs(acts) <= (set g | g in AllDefsActs(acts))
    decreases |acts|
  {
    if |acts| == 0 { return; }
    LkBodyGroupsActsSubAllDefs(acts[1..]);
    if acts[0].Areg? { LkBodyGroupsSubDefs(acts[0].r); }
  }

  /** `NoDupSeq` splits over concatenation: the two halves are individually
      duplicate-free AND element-disjoint. */
  lemma NoDupConcat(a: seq<LG.GroupId>, b: seq<LG.GroupId>)
    requires NoDupSeq(a + b)
    ensures NoDupSeq(a) && NoDupSeq(b) && (set g | g in a) * (set g | g in b) == {}
  {
    forall i, j | 0 <= i < j < |a| ensures a[i] != a[j] { assert (a + b)[i] == a[i] && (a + b)[j] == a[j]; }
    forall i, j | 0 <= i < j < |b| ensures b[i] != b[j] { assert (a + b)[|a| + i] == b[i] && (a + b)[|a| + j] == b[j]; }
    if (set g | g in a) * (set g | g in b) != {} {
      var g :| g in (set g | g in a) && g in (set g | g in b);
      var i :| 0 <= i < |a| && a[i] == g;
      var j :| 0 <= j < |b| && b[j] == g;
      assert (a + b)[i] == g && (a + b)[|a| + j] == g && i < |a| + j;   // contradicts NoDupSeq(a + b)
    }
  }

  /** The `GroupMap` of a `Match` leaf is always fully closed: whenever a
      tree's open groups are all covered by pending `Aclose` actions, its
      highest-priority leaf (`TreeRes`) leaves no group open. Grounds both
      `GmOfLiveEqGmOf`'s and `GmOfCapArrayBridge`'s hypotheses at the winning
      thread. */
  /** All `Areg` regexes in `acts` are look-free (and backref-free). */
  ghost predicate NoLkActs(acts: LS.Actions) {
    forall i :: 0 <= i < |acts| ==> (acts[i].Areg? ==> EL.NoLkBrL(acts[i].r))
  }

  /** Every `Areg` regex in `acts` has DUPLICATE-FREE defined groups. This is the
      per-regex (quantifier-STABLE) form of no-dup: a quantifier unfold
      `[Areg(r1),Areg(q')]` repeats `DefGroups(r1)`, so `NoDupSeq(AllDefsActs)`
      would be FALSE, but the per-regex property survives (both copies have the
      same, dup-free, `DefGroups(r1)`). Feeds `NoDupG(DefGroups(r1))` at each
      look body via `NoDupSeqIsNoDupG`. Same shape/threading as `NoLkActs`. */
  ghost predicate NoDupRegsActs(acts: LS.Actions) {
    forall i :: 0 <= i < |acts| ==> (acts[i].Areg? ==> NoDupSeq(L.DefGroups(acts[i].r)))
  }

  /** `FirstLeafClosed` restricted to LOOK-FREE actions: the LK case is
      unreachable, so this is a self-contained least lemma with no inside-look
      bookkeeping. `LookBodyLeafOpenSub` uses it on the (look-free) look body,
      which is why the main `FirstLeafClosed` LK case can reuse the balance
      without a least-lemma cycle. */
  least lemma FirstLeafClosedNoLk(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                                  b: BS.LoopBool, t: LT.Tree, gm: LG.GroupMap, leaf: LT.Leaf)
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    requires EL.PikeLkActions(acts)
    requires NoLkActs(acts)
    requires OpenOf(gm) <= PendingCloses(acts)
    requires LT.TreeRes(t, gm, inp, WP.Forward) == Some(leaf)
    ensures ClosedGm(leaf.1)
  {
    if |acts| == 0 {
      assert t == LT.Match;
      assert leaf.1 == gm;
      forall g | g in gm ensures gm[g].endIdx.Some? { if gm[g].endIdx.None? { assert g in OpenOf(gm); } }
    } else {
      var cont := acts[1..];
      assert NoLkActs(cont) by { forall i | 0 <= i < |cont| ensures cont[i].Areg? ==> EL.NoLkBrL(cont[i].r) { assert cont[i] == acts[i + 1]; } }
      assert PendingCloses(cont) <= PendingCloses(acts);
      match acts[0]
      case Acheck(strcheck) =>
        if b == BS.CanExit { assert PendingCloses(acts) == PendingCloses(cont); FirstLeafClosedNoLk(rer, cont, inp, BS.CanExit, t.t, gm, leaf); }
        else { assert t == LT.Mismatch; assert false; }
      case Aclose(gid) =>
        var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
        assert gm2 == LG.GMClose(LC.Idx(inp), gid, gm);
        assert OpenOf(gm2) <= PendingCloses(cont) by {
          forall g | g in OpenOf(gm2) ensures g in PendingCloses(cont) {
            assert g != gid; assert g in OpenOf(gm); assert g in PendingCloses(acts);
            var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == g;
            assert i != 0; assert cont[i - 1] == acts[i];
          }
        }
        FirstLeafClosedNoLk(rer, cont, inp, b, t.t, gm2, leaf);
      case Areg(r) =>
        assert EL.NoLkBrL(r);
        match r
        case Epsilon => assert PendingCloses(acts) == PendingCloses(cont); FirstLeafClosedNoLk(rer, cont, inp, b, t, gm, leaf);
        case Character(cd) =>
          if LC.ReadChar(rer, cd, inp, WP.Forward).None? { assert t == LT.Mismatch; assert false; }
          else {
            var pair := LC.ReadChar(rer, cd, inp, WP.Forward).value;
            assert PendingCloses(acts) == PendingCloses(cont);
            FirstLeafClosedNoLk(rer, cont, pair.1, BS.CanExit, t.t, gm, leaf);
          }
        case Disjunction(r1, r2) =>
          var acts1 := [LS.Areg(r1)] + cont; var acts2 := [LS.Areg(r2)] + cont;
          assert PendingCloses(acts1) == PendingCloses(cont) == PendingCloses(acts2) by { assert forall i :: 0 <= i < |cont| ==> acts1[i + 1] == cont[i] && acts2[i + 1] == cont[i]; }
          assert NoLkActs(acts1) && NoLkActs(acts2) by {
            forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> EL.NoLkBrL(acts1[i].r) { if i == 0 {} else { assert acts1[i] == cont[i - 1]; } }
            forall i | 0 <= i < |acts2| ensures acts2[i].Areg? ==> EL.NoLkBrL(acts2[i].r) { if i == 0 {} else { assert acts2[i] == cont[i - 1]; } }
          }
          if LT.TreeRes(t.t1, gm, inp, WP.Forward).Some? { FirstLeafClosedNoLk(rer, acts1, inp, b, t.t1, gm, leaf); }
          else { FirstLeafClosedNoLk(rer, acts2, inp, b, t.t2, gm, leaf); }
        case Sequence(r1, r2) =>
          var acts1 := [LS.Areg(r1), LS.Areg(r2)] + cont;
          assert PendingCloses(acts1) == PendingCloses(cont) by { assert forall i :: 0 <= i < |cont| ==> acts1[i + 2] == cont[i]; }
          assert NoLkActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> EL.NoLkBrL(acts1[i].r) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
          FirstLeafClosedNoLk(rer, acts1, inp, b, t, gm, leaf);
        case Quantified(greedy, min, delta, r1) =>
          var gidl := L.DefGroups(r1);
          if min > 0 {
            var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
            assert gm2 == LG.GMReset(gidl, gm); assert OpenOf(gm2) <= OpenOf(gm);
            var acts1 := [LS.Areg(r1), LS.Areg(L.Quantified(greedy, min - 1, delta, r1))] + cont;
            assert PendingCloses(acts1) == PendingCloses(cont) by { assert forall i :: 0 <= i < |cont| ==> acts1[i + 2] == cont[i]; }
            assert NoLkActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> EL.NoLkBrL(acts1[i].r) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
            FirstLeafClosedNoLk(rer, acts1, inp, b, t.t, gm2, leaf);
          } else if delta == LN.NN(0) { assert PendingCloses(acts) == PendingCloses(cont); FirstLeafClosedNoLk(rer, cont, inp, b, t, gm, leaf); }
          else {
            var itert := if greedy then t.t1 else t.t2; var skipt := if greedy then t.t2 else t.t1;
            var acts1 := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(L.Quantified(greedy, 0, LFS.NoiPred(delta), r1))] + cont;
            assert PendingCloses(acts1) == PendingCloses(cont) by { assert forall i :: 0 <= i < |cont| ==> acts1[i + 3] == cont[i]; }
            assert NoLkActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> EL.NoLkBrL(acts1[i].r) { if i < 3 {} else { assert acts1[i] == cont[i - 3]; } } }
            assert PendingCloses(acts) == PendingCloses(cont);
            if LT.TreeRes(t.t1, gm, inp, WP.Forward).Some? {
              if greedy { var gm2 := LG.GMUpdate(itert.g, LC.Idx(inp), gm); assert gm2 == LG.GMReset(gidl, gm); assert OpenOf(gm2) <= OpenOf(gm); FirstLeafClosedNoLk(rer, acts1, inp, BS.CannotExit, itert.t, gm2, leaf); }
              else { FirstLeafClosedNoLk(rer, cont, inp, b, skipt, gm, leaf); }
            } else {
              if greedy { FirstLeafClosedNoLk(rer, cont, inp, b, skipt, gm, leaf); }
              else { var gm2 := LG.GMUpdate(itert.g, LC.Idx(inp), gm); assert gm2 == LG.GMReset(gidl, gm); assert OpenOf(gm2) <= OpenOf(gm); FirstLeafClosedNoLk(rer, acts1, inp, BS.CannotExit, itert.t, gm2, leaf); }
            }
          }
        case Group(gid, r1) =>
          var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
          assert gm2 == LG.GMOpen(LC.Idx(inp), gid, gm);
          var acts1 := [LS.Areg(r1), LS.Aclose(gid)] + cont;
          assert gid in PendingCloses(acts1) by { assert acts1[1].Aclose? && acts1[1].gid == gid; }
          assert NoLkActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> EL.NoLkBrL(acts1[i].r) { if i == 0 {} else if i == 1 {} else { assert acts1[i] == cont[i - 2]; } } }
          assert OpenOf(gm2) <= PendingCloses(acts1) by {
            forall g | g in OpenOf(gm2) ensures g in PendingCloses(acts1) {
              if g != gid { assert g in OpenOf(gm); assert g in PendingCloses(acts); var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == g; assert i != 0; assert acts1[i + 1] == cont[i - 1] == acts[i]; }
            }
          }
          FirstLeafClosedNoLk(rer, acts1, inp, b, t.t, gm2, leaf);
        case AnchorR(a) =>
          if LS.AnchorSatisfied(rer, a, inp) { assert PendingCloses(acts) == PendingCloses(cont); FirstLeafClosedNoLk(rer, cont, inp, b, t.t, gm, leaf); }
          else { assert t == LT.Mismatch; assert false; }
        case LookaroundR(lk, r1) => assert false;   // NoLkBrL(r) excludes lookarounds
        case Backreference(_) => assert false;
    }
  }

  /** THE L3a payoff for the LK case: a positive look body's first leaf (evaluated
      from the OUTER map `gm`) leaves NO group open beyond those already open in
      `gm`, and adds only the body's own groups `S`. The body groups are fresh
      (`dom(gm) ∩ S == {}`), so the from-`gm` leaf agrees with a from-`Empty` leaf
      on `S` (`TreeLeavesFrameInside`); the from-`Empty` leaf is fully closed
      (`FirstLeafClosedNoLk` — valid since the body is look-free); and outside `S`
      the leaf equals `gm` (`GmConfinedLeaves`). */
  /** L3b: `EL.NoLkBrL` and `SD.GroupOkL` have IDENTICAL definitions (both forbid
      `LookaroundR` + `Backreference`, allow `Group`), so one implies the other.
      Bridges the linden-equiv fragment predicate to the linden-reasoning one the
      mirror machinery (`CloseDiscBody`, `RevLGroupOk`) is stated over. */
  lemma NoLkBrGroupOkL(r: L.Regex)
    requires EL.NoLkBrL(r)
    ensures SD.GroupOkL(r)
    decreases r
  {
    match r
    case Disjunction(r1, r2) => NoLkBrGroupOkL(r1); NoLkBrGroupOkL(r2);
    case Sequence(r1, r2) => NoLkBrGroupOkL(r1); NoLkBrGroupOkL(r2);
    case Quantified(_, _, _, r1) => NoLkBrGroupOkL(r1);
    case Group(_, r1) => NoLkBrGroupOkL(r1);
    case _ =>
  }

  // ---- L3b backward-closedness helpers (identical-def bridge + mirror closedness) ----
  /** Reverse of `NoLkBrGroupOkL`: `SD.GroupOkL` and `EL.NoLkBrL` have IDENTICAL
      definitions (both recurse through Disjunction/Sequence/Quantified/Group and
      reject LookaroundR/Backreference), so group-OK implies look-/backref-free. */
  lemma GroupOkLNoLkBr(r: L.Regex)
    requires SD.GroupOkL(r)
    ensures EL.NoLkBrL(r)
    decreases r
  {
    match r
    case Disjunction(r1, r2) => GroupOkLNoLkBr(r1); GroupOkLNoLkBr(r2);
    case Sequence(r1, r2) => GroupOkLNoLkBr(r1); GroupOkLNoLkBr(r2);
    case Quantified(_, _, _, r1) => GroupOkLNoLkBr(r1);
    case Group(_, r1) => GroupOkLNoLkBr(r1);
    case _ =>
  }

  /** The mirror preserves closedness both ways: `MirrorRange` maps a closed range
      (endIdx.Some) to a closed range and an open range (None) to open, and
      `MirrorGm` keeps the domain, so `ClosedGm` transfers across the mirror. */
  lemma MirrorGmClosedGm(gm: LG.GroupMap, n: nat)
    requires TRM.GmInBounds(gm, n)
    ensures ClosedGm(gm) <==> ClosedGm(TRM.MirrorGm(gm, n))
  {
    forall g
      ensures g in TRM.MirrorGm(gm, n) <==> g in gm
      ensures g in gm ==> (TRM.MirrorGm(gm, n)[g].endIdx.None? <==> gm[g].endIdx.None?)
    {
      TRM.MirrorGmOpen(gm, n, g);
    }
  }

  /** Having no open groups transfers across the mirror (open<->open, domain kept):
      `OpenOf(gm) == {}` is `ClosedGm(gm)`, which `MirrorGmClosedGm` carries over. */
  lemma MirrorGmOpenEmpty(gm: LG.GroupMap, n: nat)
    requires TRM.GmInBounds(gm, n) && OpenOf(gm) == {}
    ensures OpenOf(TRM.MirrorGm(gm, n)) == {}
  {
    assert ClosedGm(gm) by {
      forall g | g in gm ensures gm[g].endIdx.Some? {
        if gm[g].endIdx.None? { assert g in OpenOf(gm); }
      }
    }
    MirrorGmClosedGm(gm, n);
    forall g | g in OpenOf(TRM.MirrorGm(gm, n)) ensures false {
      assert g in TRM.MirrorGm(gm, n) && TRM.MirrorGm(gm, n)[g].endIdx.None?;
    }
  }

  /** `NoDupSeq` (local) and `CDE.NoDupG` are the SAME predicate (identical
      `forall i,j` definitions) — bridge for `CloseDiscBody`'s `NoDupG` requirement. */
  lemma NoDupSeqIsNoDupG(s: seq<LG.GroupId>)
    requires NoDupSeq(s)
    ensures CDE.NoDupG(s)
  {}

  /** L3b CRUX: a capturing lookBEHIND body's first leaf CLOSES its groups. The
      spec-side closedness machinery (`FirstLeafClosedNoLk`) is forward-only, so we
      go via the spec-tree MIRROR: the backward body tree `tlk` mirrors the FORWARD
      tree `tm` of `RevL(body)` over the swapped input (`TM.ComputeTrReverse`); `tm`'s
      first leaf is closed by the EXISTING forward `FirstLeafClosedNoLk`; and
      `TRM.TreeResMirror` + `MirrorGm` (which maps closed<->closed) transfer the
      closedness back to the backward leaf. The backward leaf's bound comes free from
      `TreeResMirror`'s `GmInBounds(rb.value.1, n)` ensures. */
  lemma BackBodyLeafClosed(rer: LW.RegExpRecord, r1: L.Regex, inp: LC.Input,
                           gm: LG.GroupMap, leaf: LT.Leaf)
    requires EL.NoLkBrL(r1)
    requires CDE.NoDupG(L.DefGroups(r1))
    requires TRM.GmInBounds(gm, |inp.pref| + |inp.next|)
    requires ClosedGm(gm)
    requires LT.TreeRes(FU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, WP.Backward),
                        gm, inp, WP.Backward) == Some(leaf)
    ensures ClosedGm(leaf.1)
  {
    var n := |inp.pref| + |inp.next|;
    var tlk := FU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, WP.Backward);
    var rr := SD.RevL(r1);
    var sinp := SD.SwapInput(inp);
    var gm2 := TRM.MirrorGm(gm, n);
    // fragment facts for the reversed body
    NoLkBrGroupOkL(r1);                                  // SD.GroupOkL(r1)
    assert SD.GroupOkActs([LS.Areg(r1)]);                // == GroupOkL(r1)
    SD.RevLGroupOk(r1);                                  // SD.GroupOkL(rr)
    GroupOkLNoLkBr(rr);                                  // EL.NoLkBrL(rr)
    NoLkBrImpliesPikeLk(rr);                             // EL.PikeLkRegex(rr)
    assert SD.RevActs([LS.Areg(r1)]) == [LS.Areg(rr)];
    var tm := FU.ComputeTr(rer, [LS.Areg(rr)], sinp, gm2, WP.Forward);
    // the backward body tree mirrors the forward tree of the reversed body
    TM.ComputeTrReverse(rer, [LS.Areg(r1)], inp, LG.Empty, gm2);
    assert TM.TreeMirrorRel(tlk, tm);
    CDE.CloseDiscBody(rer, r1, inp, LG.Empty, WP.Backward);   // CDE.CloseDisc(tlk, {})
    // the leaf-groupmap mirror: rf's leaf == MirrorGm(rb's leaf)
    TRM.TreeResMirror(tlk, tm, gm, inp, n, {});
    var rb := LT.TreeRes(tlk, gm, inp, WP.Backward);
    var rf := LT.TreeRes(tm, gm2, sinp, WP.Forward);
    assert rb == Some(leaf);
    assert rf.Some? && rf.value.1 == TRM.MirrorGm(rb.value.1, n)
           && TRM.GmInBounds(rb.value.1, n);
    // forward closedness on the mirror tree tm (existing forward machinery)
    MirrorGmOpenEmpty(gm, n);                            // OpenOf(gm2) == {}
    var fuel := LFS.ActionsFuel([LS.Areg(rr)], sinp, WP.Forward) + 1;
    LFS.FunctionalTerminates(rer, [LS.Areg(rr)], sinp, gm2, WP.Forward, fuel);
    assert LFS.ComputeTree(rer, [LS.Areg(rr)], sinp, gm2, WP.Forward, fuel) == Some(tm);
    var b0 := BS.CannotExit;
    assert BS.BoolEncoding(b0, sinp, [LS.Areg(rr)]);
    assert EL.PikeLkActions([LS.Areg(rr)]);
    assert NoLkActs([LS.Areg(rr)]);
    EL.ComputeBoolTreeLk(rer, [LS.Areg(rr)], sinp, gm2, b0, fuel, tm);
    assert OpenOf(gm2) <= PendingCloses([LS.Areg(rr)]);
    FirstLeafClosedNoLk(rer, [LS.Areg(rr)], sinp, b0, tm, gm2, rf.value);
    assert ClosedGm(rf.value.1);
    // transfer closedness back through the mirror
    MirrorGmClosedGm(rb.value.1, n);                     // ClosedGm(rb.leaf) <==> ClosedGm(rf.leaf)
    assert ClosedGm(rb.value.1);
    assert leaf == rb.value;
  }

  // ===================== L3b: GmInBounds threading helpers =====================
  /** `AdvanceInputP` preserves the input length `|pref|+|next|` (both directions),
      and `Idx(inp) = |inp.pref|` is within that length. */
  lemma AdvancePreservesSum(inp: LC.Input, dir: WP.Direction)
    ensures |LC.AdvanceInputP(inp, dir).pref| + |LC.AdvanceInputP(inp, dir).next|
         == |inp.pref| + |inp.next|
    ensures LC.Idx(inp) <= |inp.pref| + |inp.next|
  {}

  /** `AdvanceInputN` preserves the input length `|pref|+|next|` (both directions).
      Reused for the (fragment-absent) backreference tree case. */
  lemma AdvanceNPreservesSum(inp: LC.Input, k: nat, dir: WP.Direction)
    ensures |LC.AdvanceInputN(inp, k, dir).pref| + |LC.AdvanceInputN(inp, k, dir).next|
         == |inp.pref| + |inp.next|
  {
    match dir
    case Forward => LS.ReverseLength(LC.Take(inp.next, k));
    case Backward => LS.ReverseLength(LC.Take(inp.pref, k));
  }

  /** GM-op bound preservation: `GMOpen`/`GMClose` at an index `<= n` keep every
      group's endpoints `<= n`; `GMReset` only removes keys; `GMUpdate` dispatches. */
  lemma GMOpenBounds(currIdx: nat, gid: LG.GroupId, gm: LG.GroupMap, n: nat)
    requires TRM.GmInBounds(gm, n)
    requires currIdx <= n
    ensures TRM.GmInBounds(LG.GMOpen(currIdx, gid, gm), n)
  {}

  lemma GMCloseBounds(currIdx: nat, gid: LG.GroupId, gm: LG.GroupMap, n: nat)
    requires TRM.GmInBounds(gm, n)
    requires currIdx <= n
    ensures TRM.GmInBounds(LG.GMClose(currIdx, gid, gm), n)
  {}

  lemma GMResetBounds(gl: LG.GroupSet, gm: LG.GroupMap, n: nat)
    requires TRM.GmInBounds(gm, n)
    ensures TRM.GmInBounds(LG.GMReset(gl, gm), n)
  {}

  lemma GMUpdateBounds(op: LG.GroupAction, currIdx: nat, gm: LG.GroupMap, n: nat)
    requires TRM.GmInBounds(gm, n)
    requires currIdx <= n
    ensures TRM.GmInBounds(LG.GMUpdate(op, currIdx, gm), n)
  {}

  /** GENERAL leaf bound: every leaf of `TreeLeaves(t, gm, inp, dir)` has all group
      endpoints `<= n == |inp.pref|+|inp.next|`, provided the starting `gm` does.
      Structural on `t`: `Read`/`ReadBackRef` advance the input (length preserved),
      `GroupActionT` updates at `Idx(inp) <= n`, and a nested `LK` recurses on the
      body (in `LkDir(lk)`, same `n`) then the continuation. `dir`-parametric, so it
      also covers backward (lookbehind) bodies. */
  lemma TreeLeavesInBounds(t: LT.Tree, gm: LG.GroupMap, inp: LC.Input, dir: WP.Direction, n: nat)
    requires |inp.pref| + |inp.next| == n
    requires TRM.GmInBounds(gm, n)
    ensures forall i :: 0 <= i < |LT.TreeLeaves(t, gm, inp, dir)| ==>
                          TRM.GmInBounds(LT.TreeLeaves(t, gm, inp, dir)[i].1, n)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) =>
      TreeLeavesInBounds(t1, gm, inp, dir, n);
      TreeLeavesInBounds(t2, gm, inp, dir, n);
    case Read(c, t1) =>
      AdvancePreservesSum(inp, dir);
      TreeLeavesInBounds(t1, gm, LC.AdvanceInputP(inp, dir), dir, n);
    case Progress(t1) =>
      TreeLeavesInBounds(t1, gm, inp, dir, n);
    case GroupActionT(a, t1) =>
      GMUpdateBounds(a, LC.Idx(inp), gm, n);
      TreeLeavesInBounds(t1, LG.GMUpdate(a, LC.Idx(inp), gm), inp, dir, n);
    case LK(lk, tlk, t1) =>
      TreeLeavesInBounds(tlk, gm, inp, L.LkDir(lk), n);
      var sub := LT.TreeLeaves(tlk, gm, inp, L.LkDir(lk));
      if L.Positivity(lk) {
        if |sub| == 0 {} else {
          TreeLeavesInBounds(t1, sub[0].1, inp, dir, n);
        }
      } else {
        if |sub| == 0 { TreeLeavesInBounds(t1, gm, inp, dir, n); } else {}
      }
    case LKFail(_, _) =>
    case AnchorPass(_, t0) =>
      TreeLeavesInBounds(t0, gm, inp, dir, n);
    case ReadBackRef(brStr, t0) =>
      AdvanceNPreservesSum(inp, |brStr|, dir);
      TreeLeavesInBounds(t0, gm, LC.AdvanceInputN(inp, |brStr|, dir), dir, n);
  }
  // =============================================================================

  lemma LookBodyLeafOpenSub(rer: LW.RegExpRecord, lk: L.Lookaround, r1: L.Regex, tlk: LT.Tree,
                            gm: LG.GroupMap, inp: LC.Input, sub: seq<LT.Leaf>, S: set<LG.GroupId>)
    requires tlk == FU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk))
    requires EL.NoLkBrL(r1) && EL.PikeLkRegex(r1)
    requires S == (set g | g in L.DefGroups(r1))
    requires forall g :: g in gm && g in S ==> gm[g].endIdx.Some?   // reused body groups are CLOSED
    requires sub == LT.TreeLeaves(tlk, gm, inp, L.LkDir(lk))
    requires |sub| > 0
    requires L.Positivity(lk)
    // L3b: the body's captures close in EITHER direction (backward via the spec-tree
    // mirror, `BackBodyLeafClosed`). NoDupG + GmInBounds feed that mirror.
    requires CDE.NoDupG(L.DefGroups(r1))
    requires TRM.GmInBounds(gm, |inp.pref| + |inp.next|)
    ensures OpenOf(sub[0].1) <= OpenOf(gm)
    ensures forall g :: g in sub[0].1 ==> g in gm || g in S
    ensures forall g :: g in sub[0].1 && g in S ==> sub[0].1[g].endIdx.Some?   // look closed its captures
    ensures TRM.GmInBounds(sub[0].1, |inp.pref| + |inp.next|)   // L3b: leaf bound (for the caller's threading)
  {
    var dir := L.LkDir(lk);
    TreeLeavesInBounds(tlk, gm, inp, dir, |inp.pref| + |inp.next|);   // GmInBounds(sub[i].1)
    assert LL.DefGroupsIn(r1, S);
    LL.ComputeTrConfined(rer, r1, inp, LG.Empty, dir, S);       // GmConfinedTree(tlk, S)
    LL.GmConfinedLeaves(tlk, gm, inp, dir, S);                  // sub[i].1 ~outside-S~ gm
    // gmR = gm restricted to its own S-groups (all CLOSED), so OpenOf(gmR) == {}.
    var gmR := map g | g in gm && g in S :: gm[g];
    var subR := LT.TreeLeaves(tlk, gmR, inp, dir);
    assert OpenOf(gmR) == {} by { forall g | g in gmR ensures gmR[g].endIdx.Some? { assert g in gm && g in S; } }
    assert LL.GmAgreeInside(gm, gmR, S) by {
      forall g | g in S ensures (g in gm <==> g in gmR) && (g in gm ==> gm[g] == gmR[g]) {}
    }
    LL.TreeLeavesFrameInside(tlk, gm, gmR, inp, dir, S);        // sub[i].1 ~inside-S~ subR[i].1
    assert |sub| == |subR|;
    if dir == WP.Forward {
      // The from-gmR body leaf is fully closed (look-free body ⇒ FirstLeafClosedNoLk).
      LT.FirstTreeLeaf(tlk, gmR, inp, dir);
      assert LT.TreeRes(tlk, gmR, inp, WP.Forward) == Some(subR[0]);
      var fuel := LFS.ActionsFuel([LS.Areg(r1)], inp, WP.Forward) + 1;
      LFS.FunctionalTerminates(rer, [LS.Areg(r1)], inp, LG.Empty, WP.Forward, fuel);
      assert LFS.ComputeTree(rer, [LS.Areg(r1)], inp, LG.Empty, WP.Forward, fuel) == Some(tlk);
      var b0 := BS.CannotExit;
      assert BS.BoolEncoding(b0, inp, [LS.Areg(r1)]);   // single Areg ⇒ reduces to true
      EL.ComputeBoolTreeLk(rer, [LS.Areg(r1)], inp, LG.Empty, b0, fuel, tlk);   // BoolTreeLk is eval-map independent
      assert EL.PikeLkActions([LS.Areg(r1)]);
      assert NoLkActs([LS.Areg(r1)]);
      assert OpenOf(gmR) <= PendingCloses([LS.Areg(r1)]);
      FirstLeafClosedNoLk(rer, [LS.Areg(r1)], inp, b0, tlk, gmR, subR[0]);
      assert ClosedGm(subR[0].1);
      forall g | g in OpenOf(sub[0].1) ensures g in OpenOf(gm) {
        if g in S {
          assert sub[0].1[g] == subR[0].1[g];    // FrameInside on S
          assert g in subR[0].1 && subR[0].1[g].endIdx.Some?;   // ClosedGm
          assert false;
        }
      }
    } else {
      // L3b: dir == Backward, capturing lookbehind. Prove ClosedGm(subR[0].1) via
      // the spec-tree mirror (BackBodyLeafClosed), then the SAME OpenOf reasoning.
      assert dir == WP.Backward;
      var nn := |inp.pref| + |inp.next|;
      LT.FirstTreeLeaf(tlk, gmR, inp, dir);
      assert LT.TreeRes(tlk, gmR, inp, WP.Backward) == Some(subR[0]);
      assert TRM.GmInBounds(gmR, nn) by {
        assert forall g :: g in gmR ==> g in gm && gmR[g] == gm[g];
      }
      assert ClosedGm(gmR) by {
        forall g | g in gmR ensures gmR[g].endIdx.Some? { assert g !in OpenOf(gmR); }
      }
      BackBodyLeafClosed(rer, r1, inp, gmR, subR[0]);   // ClosedGm(subR[0].1)
      forall g | g in OpenOf(sub[0].1) ensures g in OpenOf(gm) {
        if g in S {
          assert sub[0].1[g] == subR[0].1[g];    // FrameInside on S
          assert g in subR[0].1 && subR[0].1[g].endIdx.Some?;   // ClosedGm
          assert false;
        }
      }
    }
    forall g | g in sub[0].1 ensures g in gm || g in S {}
    // S groups are never open in sub[0].1 (OpenOf(sub[0].1) <= OpenOf(gm), and gm's S
    // groups are closed), so a present S group is closed.
    forall g | g in sub[0].1 && g in S ensures sub[0].1[g].endIdx.Some? {
      assert g !in OpenOf(gm);
      assert g !in OpenOf(sub[0].1);
    }
  }

  /** The translated regex's DEFINED group ids are exactly the engine's capture
      ids: `Translate` maps `Re_capture(cid,_)` to `Group(cid,_)` and copies every
      other constructor, so both collect the same cids. */
  lemma TranslateDefGroupsEqCapIds(r: R.regex)
    requires T.TransWf(r)
    ensures (set g | g in L.DefGroups(T.Translate(r))) == PIV.CapIds(r)
    decreases r
  {
    match r
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
    case Re_alt(r1, r2) =>
      TranslateDefGroupsEqCapIds(r1); TranslateDefGroupsEqCapIds(r2);
      assert L.DefGroups(T.Translate(r)) == L.DefGroups(T.Translate(r1)) + L.DefGroups(T.Translate(r2));
      assert forall g :: g in L.DefGroups(T.Translate(r)) <==>
                         g in L.DefGroups(T.Translate(r1)) || g in L.DefGroups(T.Translate(r2));
    case Re_con(r1, r2) =>
      TranslateDefGroupsEqCapIds(r1); TranslateDefGroupsEqCapIds(r2);
      assert L.DefGroups(T.Translate(r)) == L.DefGroups(T.Translate(r1)) + L.DefGroups(T.Translate(r2));
      assert forall g :: g in L.DefGroups(T.Translate(r)) <==>
                         g in L.DefGroups(T.Translate(r1)) || g in L.DefGroups(T.Translate(r2));
    case Re_quant(_, _, q, r1) => TranslateDefGroupsEqCapIds(r1);
    case Re_capture(cid, r1) =>
      TranslateDefGroupsEqCapIds(r1);
      assert L.DefGroups(T.Translate(r)) == [cid as nat] + L.DefGroups(T.Translate(r1));
      assert forall g :: g in L.DefGroups(T.Translate(r)) <==> g == cid as nat || g in L.DefGroups(T.Translate(r1));
    case Re_lookaround(_, lk, r1) => TranslateDefGroupsEqCapIds(r1);
  }

  /** The translated regex's inside-lookaround group ids equal the engine's
      `CapIdsInLooks`. A `LookaroundR` contributes its whole body's `DefGroups`
      (which subsumes the body's own nested look groups, `LkBodyGroupsSubDefs`),
      matching `CapIdsInLooks(Re_lookaround) == CapIds(body)`. */
  lemma LkBodyGroupsEqCapIdsInLooks(r: R.regex)
    requires T.TransWf(r)
    ensures LL.LkBodyGroups(T.Translate(r)) == PIV.CapIdsInLooks(r)
    decreases r
  {
    match r
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
    case Re_alt(r1, r2) => LkBodyGroupsEqCapIdsInLooks(r1); LkBodyGroupsEqCapIdsInLooks(r2);
    case Re_con(r1, r2) => LkBodyGroupsEqCapIdsInLooks(r1); LkBodyGroupsEqCapIdsInLooks(r2);
    case Re_quant(_, _, q, r1) => LkBodyGroupsEqCapIdsInLooks(r1);
    case Re_capture(cid, r1) => LkBodyGroupsEqCapIdsInLooks(r1);
    case Re_lookaround(_, lk, r1) =>
      // LkBodyGroups(LookaroundR(_,T(r1))) == set(DefGroups(T(r1))) + LkBodyGroups(T(r1))
      //                                    == set(DefGroups(T(r1)))         (subsumed)
      //                                    == CapIds(r1) == CapIdsInLooks(r)
      TranslateDefGroupsEqCapIds(r1);
      LkBodyGroupsSubDefs(T.Translate(r1));
      assert LL.LkBodyGroups(T.Translate(r)) == (set g | g in L.DefGroups(T.Translate(r1))) + LL.LkBodyGroups(T.Translate(r1));
  }

  // ==========================================================================
  // B'' deliverable #1: the R<->L "innermost owner body" correspondence. The
  // B'' descent (`ComputeTrOwnerNamed`) records `rr` as the L-look-body of
  // `Translate(body)` that DIRECTLY captures `g`. This block identifies that
  // `rr` with `Translate(LookBodyOfRE(body, InnermostOwnerDirect(body, g)))`.
  // ==========================================================================

  /** `w` is the body of SOME `LookaroundR` node inside `r` — the L-side "is a
      look body of" relation. The B'' descent records its `rr` as such a body of
      `Translate(body)`; this pins it structurally so it can be identified with
      a `Translate(LookBodyOfRE(...))`. */
  ghost predicate SubLkBody(r: L.Regex, w: L.Regex)
    decreases r
  {
    match r
    case Disjunction(r1, r2) => SubLkBody(r1, w) || SubLkBody(r2, w)
    case Sequence(r1, r2) => SubLkBody(r1, w) || SubLkBody(r2, w)
    case Quantified(_, _, _, r1) => SubLkBody(r1, w)
    case Group(_, r1) => SubLkBody(r1, w)
    case LookaroundR(_, r1) => (w == r1) || SubLkBody(r1, w)
    case _ => false
  }

  /** Action-list lift of `SubLkBody`: `w` is a look body of some pending `Areg`
      regex. The invariant the B'' descent threads to expose `rr`'s origin. */
  ghost predicate SubLkBodyActs(acts: LS.Actions, w: L.Regex)
    decreases |acts|
  {
    if |acts| == 0 then false
    else (acts[0].Areg? && SubLkBody(acts[0].r, w)) || SubLkBodyActs(acts[1..], w)
  }

  lemma SubLkBodyActsCons(x: LS.Action, cont: LS.Actions, w: L.Regex)
    ensures SubLkBodyActs([x] + cont, w) <==> ((x.Areg? && SubLkBody(x.r, w)) || SubLkBodyActs(cont, w))
  { assert ([x] + cont)[0] == x && ([x] + cont)[1..] == cont; }

  /** SubLk lift for the free-iteration quantifier unfold
      `na = [Areg(r1), Acheck(inp), Areg(quant)] + cont` with `quant`/`head`
      quantifiers over `r1`: a look body of `na` is one of `acts = [head] + cont`,
      since `r1`, `quant`, and `head` share the same look bodies. */
  lemma SubLkFreeQuantNaLift(r1: L.Regex, quant: L.Regex, inp: LC.Input, cont: LS.Actions,
                             head: LS.Action, acts: LS.Actions, rr: L.Regex)
    requires head.Areg? && SubLkBody(head.r, rr) == SubLkBody(r1, rr)
    requires SubLkBody(quant, rr) == SubLkBody(r1, rr)
    requires acts == [head] + cont
    requires SubLkBodyActs([LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont, rr)
    ensures SubLkBodyActs(acts, rr)
  {
    assert [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont
        == [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
    SubLkBodyActsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont), rr);
    SubLkBodyActsCons(LS.Acheck(inp), [LS.Areg(quant)] + cont, rr);
    SubLkBodyActsCons(LS.Areg(quant), cont, rr);
    SubLkBodyActsCons(head, cont, rr);
  }

  /** Translate structural bridge: the OUTSIDE-look defined groups of the
      translated regex equal the engine's OUTSIDE-look capture ids. Mirrors
      `TranslateDefGroupsEqCapIds`; the `Re_lookaround` case is `{}` on both
      sides. */
  lemma TranslateDefGroupsOutsideEqCapIdsOutside(re: R.regex)
    requires T.TransWf(re)
    ensures DefGroupsOutsideLooksL(T.Translate(re)) == PIV.CapIdsOutsideLooks(re)
    decreases re
  {
    match re
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
    case Re_alt(r1, r2) =>
      TranslateDefGroupsOutsideEqCapIdsOutside(r1); TranslateDefGroupsOutsideEqCapIdsOutside(r2);
    case Re_con(r1, r2) =>
      TranslateDefGroupsOutsideEqCapIdsOutside(r1); TranslateDefGroupsOutsideEqCapIdsOutside(r2);
    case Re_quant(_, _, q, r1) => TranslateDefGroupsOutsideEqCapIdsOutside(r1);
    case Re_capture(cid, r1) =>
      assert cid >= 0;                                       // TransWf(Re_capture)
      TranslateDefGroupsOutsideEqCapIdsOutside(r1);
    case Re_lookaround(_, lk, r1) =>
  }

  /** `LookBodyOfRE` preserves `TransWf` (its result is a subterm of `r`). Makes
      the `T.Translate(LookBodyOfRE(...))` terms in the specs below well-formed. */
  lemma TransWfLookBodyOfRE(r: R.regex, lid: nat)
    requires T.TransWf(r) && lid in LTB.LookIds(r)
    ensures T.TransWf(NI.LookBodyOfRE(r, lid))
    decreases r
  {
    match r
    case Re_alt(r1, r2) => if lid in LTB.LookIds(r1) { TransWfLookBodyOfRE(r1, lid); } else { TransWfLookBodyOfRE(r2, lid); }
    case Re_con(r1, r2) => if lid in LTB.LookIds(r1) { TransWfLookBodyOfRE(r1, lid); } else { TransWfLookBodyOfRE(r2, lid); }
    case Re_quant(_, _, _, r1) => TransWfLookBodyOfRE(r1, lid);
    case Re_capture(_, r1) => TransWfLookBodyOfRE(r1, lid);
    case Re_lookaround(lid0, _, r1) => if lid0 >= 0 && (lid0 as nat) == lid { } else { TransWfLookBodyOfRE(r1, lid); }
    case _ =>
  }

  /** `LookBodyOfRE` preserves `CapUnique` (its result is a subterm of `r`). */
  lemma CapUniqueLookBodyOfRE(r: R.regex, lid: nat)
    requires PIV.CapUnique(r) && lid in LTB.LookIds(r)
    ensures PIV.CapUnique(NI.LookBodyOfRE(r, lid))
    decreases r
  {
    match r
    case Re_alt(r1, r2) => if lid in LTB.LookIds(r1) { CapUniqueLookBodyOfRE(r1, lid); } else { CapUniqueLookBodyOfRE(r2, lid); }
    case Re_con(r1, r2) => if lid in LTB.LookIds(r1) { CapUniqueLookBodyOfRE(r1, lid); } else { CapUniqueLookBodyOfRE(r2, lid); }
    case Re_quant(_, _, _, r1) => CapUniqueLookBodyOfRE(r1, lid);
    case Re_capture(_, r1) => CapUniqueLookBodyOfRE(r1, lid);
    case Re_lookaround(lid0, _, r1) => if lid0 >= 0 && (lid0 as nat) == lid { } else { CapUniqueLookBodyOfRE(r1, lid); }
    case _ =>
  }

  /** Translate structural bridge: every L-look-body of `Translate(body)` is the
      translation of an R-look-body of `body`. `Translate` maps `Re_lookaround`
      to `LookaroundR` and nothing else creates a `LookaroundR`, so the L-look
      nodes of `Translate(body)` correspond exactly to the lookaround nodes of
      `body`. The `TransWf` conjunct keeps the `Translate` in the witness
      well-formed. */
  lemma TranslateSubLkBodyIsLookBody(body: R.regex, w: L.Regex)
    requires T.TransWf(body) && LTB.LookUnique(body)
    requires SubLkBody(T.Translate(body), w)
    ensures exists lid: nat :: lid in LTB.LookIds(body)
                               && T.TransWf(NI.LookBodyOfRE(body, lid)) && w == T.Translate(NI.LookBodyOfRE(body, lid))
    decreases body
  {
    match body
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
    case Re_alt(r1, r2) =>
      assert T.Translate(body) == L.Disjunction(T.Translate(r1), T.Translate(r2));
      if SubLkBody(T.Translate(r1), w) {
        TranslateSubLkBodyIsLookBody(r1, w);
        var lid: nat :| lid in LTB.LookIds(r1) && T.TransWf(NI.LookBodyOfRE(r1, lid)) && w == T.Translate(NI.LookBodyOfRE(r1, lid));
        assert lid in LTB.LookIds(body);
        assert NI.LookBodyOfRE(body, lid) == NI.LookBodyOfRE(r1, lid);
      } else {
        TranslateSubLkBodyIsLookBody(r2, w);
        var lid: nat :| lid in LTB.LookIds(r2) && T.TransWf(NI.LookBodyOfRE(r2, lid)) && w == T.Translate(NI.LookBodyOfRE(r2, lid));
        assert lid !in LTB.LookIds(r1);                      // LookUnique disjoint
        assert lid in LTB.LookIds(body);
        assert NI.LookBodyOfRE(body, lid) == NI.LookBodyOfRE(r2, lid);
      }
    case Re_con(r1, r2) =>
      assert T.Translate(body) == L.Sequence(T.Translate(r1), T.Translate(r2));
      if SubLkBody(T.Translate(r1), w) {
        TranslateSubLkBodyIsLookBody(r1, w);
        var lid: nat :| lid in LTB.LookIds(r1) && T.TransWf(NI.LookBodyOfRE(r1, lid)) && w == T.Translate(NI.LookBodyOfRE(r1, lid));
        assert lid in LTB.LookIds(body);
        assert NI.LookBodyOfRE(body, lid) == NI.LookBodyOfRE(r1, lid);
      } else {
        TranslateSubLkBodyIsLookBody(r2, w);
        var lid: nat :| lid in LTB.LookIds(r2) && T.TransWf(NI.LookBodyOfRE(r2, lid)) && w == T.Translate(NI.LookBodyOfRE(r2, lid));
        assert lid !in LTB.LookIds(r1);                      // LookUnique disjoint
        assert lid in LTB.LookIds(body);
        assert NI.LookBodyOfRE(body, lid) == NI.LookBodyOfRE(r2, lid);
      }
    case Re_quant(_, _, q, r1) =>
      assert T.Translate(body) == L.Quantified(q.greedy, q.min as nat, T.TrDelta(q), T.Translate(r1));
      TranslateSubLkBodyIsLookBody(r1, w);
      var lid: nat :| lid in LTB.LookIds(r1) && T.TransWf(NI.LookBodyOfRE(r1, lid)) && w == T.Translate(NI.LookBodyOfRE(r1, lid));
      assert lid in LTB.LookIds(body);
      assert NI.LookBodyOfRE(body, lid) == NI.LookBodyOfRE(r1, lid);
    case Re_capture(cid, r1) =>
      assert T.Translate(body) == L.Group(cid as nat, T.Translate(r1));
      TranslateSubLkBodyIsLookBody(r1, w);
      var lid: nat :| lid in LTB.LookIds(r1) && T.TransWf(NI.LookBodyOfRE(r1, lid)) && w == T.Translate(NI.LookBodyOfRE(r1, lid));
      assert lid in LTB.LookIds(body);
      assert NI.LookBodyOfRE(body, lid) == NI.LookBodyOfRE(r1, lid);
    case Re_lookaround(lid0, lk, r1) =>
      assert lid0 >= 0;                                       // LookUnique
      assert T.Translate(body) == L.LookaroundR(T.TrLookaround(lk), T.Translate(r1));
      if w == T.Translate(r1) {
        assert (lid0 as nat) in LTB.LookIds(body);
        assert NI.LookBodyOfRE(body, lid0 as nat) == r1;      // direct hit
        assert T.TransWf(NI.LookBodyOfRE(body, lid0 as nat));
      } else {
        assert SubLkBody(T.Translate(r1), w);
        TranslateSubLkBodyIsLookBody(r1, w);
        var lid: nat :| lid in LTB.LookIds(r1) && T.TransWf(NI.LookBodyOfRE(r1, lid)) && w == T.Translate(NI.LookBodyOfRE(r1, lid));
        assert (lid0 as nat) != lid;                          // LookUnique: lid0 !in LookIds(r1)
        assert lid in LTB.LookIds(body);
        assert NI.LookBodyOfRE(body, lid) == NI.LookBodyOfRE(r1, lid);
      }
  }

  /** B'' deliverable #1 — the R<->L innermost-owner-body correspondence. Given a
      look body `rr` of `Translate(body)` that DIRECTLY captures `g` (`g` outside
      `rr`'s own looks), `rr` is exactly the translation of the R-side innermost
      DIRECT owner's body. Both are "the unique look body directly capturing g";
      capture/look uniqueness forces them to coincide. Proven from the two
      Translate structural bridges plus the innermost-owner uniqueness
      (`NestedGWriteFrame` + `LookBodyCompose` + `LookBodyCapsIn`). */
  lemma TranslateOwnerBodyIsRR(body: R.regex, g: nat, rr: L.Regex, owner: nat)
    requires T.TransWf(body) && PIV.CapUnique(body) && LTB.LookUnique(body)
    requires g in LL.LkBodyGroups(T.Translate(body))
    requires owner in LTB.LookIds(body)
    requires T.TransWf(NI.LookBodyOfRE(body, owner))
    requires g in PIV.CapIds(NI.LookBodyOfRE(body, owner))
    requires g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(body, owner))
    requires SubLkBody(T.Translate(body), rr)
    requires g in DefGroupsOutsideLooksL(rr)
    ensures rr == T.Translate(NI.LookBodyOfRE(body, owner))
  {
    // 1. rr is Translate of SOME R-look-body `lb == LookBodyOfRE(body, lid)`.
    TranslateSubLkBodyIsLookBody(body, rr);
    var lid: nat :| lid in LTB.LookIds(body)
                    && T.TransWf(NI.LookBodyOfRE(body, lid)) && rr == T.Translate(NI.LookBodyOfRE(body, lid));
    var lb := NI.LookBodyOfRE(body, lid);
    CapUniqueLookBodyOfRE(body, lid);                         // CapUnique(lb)
    // 2. g is directly captured in lb (outside its own looks).
    TranslateDefGroupsOutsideEqCapIdsOutside(lb);
    assert g in PIV.CapIdsOutsideLooks(lb);                   // == DefGroupsOutsideLooksL(rr)
    PIV.CapIdsSplit(lb);
    assert g in PIV.CapIds(lb);
    PIV.CapIdsLooksDisjoint(lb);                              // Outside * InLooks == {}
    assert g !in PIV.CapIdsInLooks(lb);
    // 3. uniqueness of the innermost direct owner: lid == owner.
    LkBodyGroupsEqCapIdsInLooks(body);                        // g in CapIdsInLooks(body)
    assert g in PIV.CapIdsInLooks(body);
    if lid != owner {
      NI.NestedGWriteFrame(body, g, owner, lid);              // owner in LookIds(lb)
      NI.LookBodyCompose(body, lid, owner);                   // LookBodyOfRE(body,owner)==LookBodyOfRE(lb,owner)
      NI.LookBodyCapsIn(lb, owner);                           // CapIds(LookBodyOfRE(lb,owner)) <= CapIdsInLooks(lb)
      assert g in PIV.CapIds(NI.LookBodyOfRE(lb, owner));     // req + compose
      assert g in PIV.CapIdsInLooks(lb);                      // contradicts step 2
    }
    assert lid == owner;
  }

  /** L3a OUTSIDE-look value bridge: the spec first leaf `ft` (which agrees with
      the main thread's denotation `gmBest` OUTSIDE the tree inside-look set) agrees
      with `GmOfLive(re, capR, look, quantR)` (the FLookLoop-reconstructed answer) on
      every OUTSIDE-look group. Composes `GmOfLiveFrameOutside` (capR/quantR agree
      capT/quantT outside the inside-look registers/quants) with the tree/engine
      inside-look set identity (`LkBodyGroupsEqCapIdsInLooks`). */
  lemma OutsideLookValueBridge(re: R.regex, capT: AReg.Regs, capR: AReg.Regs, look: AReg.Regs,
                               quantT: AReg.Regs, quantR: AReg.Regs, gmBest: LG.GroupMap, ft: LG.GroupMap)
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re) && PIV.CapUnique(re)
    requires gmBest == PIV.GmOfLive(re, capT, look, quantT)
    requires forall g: nat :: g !in LL.LkBodyGroups(T.Translate(re)) ==>
                                (g in ft <==> g in gmBest) && (g in ft ==> ft[g] == gmBest[g])
    requires forall k: int :: k !in PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)) ==>
                                AI.get_idx(AReg.as_arrays(capR).0, k) == AI.get_idx(AReg.as_arrays(capT).0, k)
                                && AI.get_idx(AReg.as_arrays(capR).1, k) == AI.get_idx(AReg.as_arrays(capT).1, k)
    requires forall q: nat :: q in PIV.QuantIdsOutsideLooks(re) ==>
                                AI.get_idx(AReg.as_arrays(quantR).1, q) == AI.get_idx(AReg.as_arrays(quantT).1, q)
    ensures forall g: nat :: g !in PIV.CapIdsInLooks(re) ==>
                               (g in ft <==> g in PIV.GmOfLive(re, capR, look, quantR))
                               && (g in ft ==> ft[g] == PIV.GmOfLive(re, capR, look, quantR)[g])
  {
    LkBodyGroupsEqCapIdsInLooks(re);                 // LkBodyGroups(Translate(re)) == CapIdsInLooks(re)
    PIV.GmOfLiveFrameOutside(re, capR, capT, look, quantR, quantT);   // GmOfLive(capR) ~ GmOfLive(capT) outside CapIdsInLooks
    forall g: nat | g !in PIV.CapIdsInLooks(re)
      ensures (g in ft <==> g in PIV.GmOfLive(re, capR, look, quantR))
              && (g in ft ==> ft[g] == PIV.GmOfLive(re, capR, look, quantR)[g])
    {
      assert g !in LL.LkBodyGroups(T.Translate(re));       // set identity
      // ft ~ gmBest (spec/main outside S), gmBest = GmOfLive(capT) ~ GmOfLive(capR) (frame)
    }
  }

  // ==========================================================================
  // (E) The INSIDE-look ENGINE value bridge. For a group `g` owned by a matched
  // lookahead body, the whole-regex live denotation of the RECONSTRUCTED bank
  // `cap0` (= `FLookLoop`'s `res.0`) at `g` equals the body's own live
  // denotation of the FRESH body match `cap1`. Both reduce to the same raw
  // `LiveRange` (they agree on `g`'s registers, `RegsAgreeInside` on
  // `CaptureRegs(body)`); the only work is that `filter_capture` KEEPS the value
  // on both sides. Absent case: `filter_capture` can only make a group MORE
  // absent, so an unset `g` is absent both sides (no path facts). Present case:
  // `GmOfLiveKeepsPresentLk` on each side, taking the path-presence conditions as
  // hypotheses (these are discharged at final wiring, alongside the position
  // correspondence — the outer path to the matched look is a winning-thread fact).
  // ==========================================================================

  /** (E) ABSENT half: if `g`'s start value is unset in `cap0` (hence in `cap1`,
      by agreement), then `g` is absent from BOTH live denotations. Fully
      self-contained — `filter_capture` never resurrects an unset group. */
  lemma GmOfLiveInsideLookAbsentEq(re: R.regex, body: R.regex,
                                   cap0: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
                                   cap1: AReg.Regs, look1: AReg.Regs, quant1: AReg.Regs, g: nat)
    requires g in PIV.CapIds(body)
    requires CM.RegsAgreeInside(cap0, cap1, PIV.CaptureRegs(body))
    requires AI.get_idx(AReg.as_arrays(cap0).0, CP.start_reg(g)) < 0
    ensures g !in PIV.GmOfLive(re, cap0, look, quant)
    ensures g !in PIV.GmOfLive(body, cap1, look1, quant1)
  {
    assert CP.start_reg(g) in PIV.CaptureRegs(body);
    var cr0 := AReg.as_arrays(cap0).0; var cc0 := AReg.as_arrays(cap0).1;
    var lc := AReg.as_arrays(look).1;  var qc := AReg.as_arrays(quant).1;
    var f0 := AI.filter_reset(re, cap0, look, quant, -1);
    assert f0 == AI.filter_capture(re, cr0, cc0, lc, qc, -1);
    PIV.FilterCaptureNeg(re, cr0, cc0, lc, qc, -1, CP.start_reg(g));
    assert AI.get_idx(f0, CP.start_reg(g)) < 0;

    var cr1 := AReg.as_arrays(cap1).0; var cc1 := AReg.as_arrays(cap1).1;
    var lc1 := AReg.as_arrays(look1).1; var qc1 := AReg.as_arrays(quant1).1;
    assert AI.get_idx(cr1, CP.start_reg(g)) == AI.get_idx(cr0, CP.start_reg(g));   // RegsAgreeInside
    var f1 := AI.filter_reset(body, cap1, look1, quant1, -1);
    assert f1 == AI.filter_capture(body, cr1, cc1, lc1, qc1, -1);
    PIV.FilterCaptureNeg(body, cr1, cc1, lc1, qc1, -1, CP.start_reg(g));
    assert AI.get_idx(f1, CP.start_reg(g)) < 0;
  }

  /** (E) PRESENT half: when `g`'s start is set in the fresh body match `cap1`
      and BOTH descents are path-present (the outer look matched + the inner body
      captured `g`), each side's live denotation is the raw `LiveRange` of its own
      bank, and the banks agree on `g`'s registers — so the two denotations are
      equal and `g` is present both sides. The path-presence hypotheses are the
      wiring's job (the outer `PathPresentLk(re, cap0)` is a winning-thread fact,
      coupled to the position correspondence). */
  lemma GmOfLiveInsideLookPresentEq(re: R.regex, body: R.regex,
                                    cap0: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
                                    cap1: AReg.Regs, look1: AReg.Regs, quant1: AReg.Regs, g: nat)
    requires NR.LookBehindFragmentRE(re) && PIV.CapUnique(re)
    requires NR.LookBehindFragmentRE(body) && PIV.CapUnique(body)
    requires g in PIV.CapIds(re) && g in PIV.CapIds(body)
    requires CM.RegsAgreeInside(cap0, cap1, PIV.CaptureRegs(body))
    requires AI.get_idx(AReg.as_arrays(cap1).1, CP.start_reg(g)) >= 0        // fresh clock set
    requires AI.get_idx(AReg.as_arrays(cap1).0, CP.start_reg(g)) >= 0        // fresh value set
    requires PIV.PathPresentLk(re, AReg.as_arrays(cap0).1, AReg.as_arrays(look).1, AReg.as_arrays(quant).1, -1, g)
    requires AI.get_idx(AReg.as_arrays(cap0).1, CP.start_reg(g))
          >= PIV.MxAtGidLk(re, AReg.as_arrays(cap0).1, AReg.as_arrays(look).1, AReg.as_arrays(quant).1, -1, g)
    requires PIV.PathPresentLk(body, AReg.as_arrays(cap1).1, AReg.as_arrays(look1).1, AReg.as_arrays(quant1).1, -1, g)
    requires AI.get_idx(AReg.as_arrays(cap1).1, CP.start_reg(g))
          >= PIV.MxAtGidLk(body, AReg.as_arrays(cap1).1, AReg.as_arrays(look1).1, AReg.as_arrays(quant1).1, -1, g)
    ensures g in PIV.GmOfLive(re, cap0, look, quant) && g in PIV.GmOfLive(body, cap1, look1, quant1)
    ensures PIV.GmOfLive(re, cap0, look, quant)[g] == PIV.GmOfLive(body, cap1, look1, quant1)[g]
  {
    assert CP.start_reg(g) in PIV.CaptureRegs(body) && CP.end_reg(g) in PIV.CaptureRegs(body);
    // cap0's start is set too (agreement with cap1 on CaptureRegs(body))
    assert AI.get_idx(AReg.as_arrays(cap0).1, CP.start_reg(g)) == AI.get_idx(AReg.as_arrays(cap1).1, CP.start_reg(g));
    assert AI.get_idx(AReg.as_arrays(cap0).0, CP.start_reg(g)) == AI.get_idx(AReg.as_arrays(cap1).0, CP.start_reg(g));
    PIV.GmOfLiveKeepsPresentLk(re, cap0, look, quant, g);
    PIV.GmOfLiveKeepsPresentLk(body, cap1, look1, quant1, g);
    // both values are the raw LiveRange; cap0 == cap1 on {start_reg(g), end_reg(g)}
    assert AI.get_idx(AReg.as_arrays(cap0).0, CP.end_reg(g)) == AI.get_idx(AReg.as_arrays(cap1).0, CP.end_reg(g));
    assert AI.get_idx(AReg.as_arrays(cap0).1, CP.end_reg(g)) == AI.get_idx(AReg.as_arrays(cap1).1, CP.end_reg(g));
    assert PIV.LiveRange(AReg.as_arrays(cap0).0, AReg.as_arrays(cap0).1, g)
        == PIV.LiveRange(AReg.as_arrays(cap1).0, AReg.as_arrays(cap1).1, g);
  }

  /** L3a value companion of `LookBodyLeafOpenSub`: when the look's body groups
      are UNSET in the incoming `gm` (the reset condition — a fresh or just-reset
      entry), the body's first leaf from `gm` agrees, on `S == DefGroups(r1)`, with
      the body's first leaf from `LG.Empty`. Direct `TreeLeavesFrameInside`: `gm`
      and `Empty` agree on `S` (both lack those groups), so all leaves agree on `S`. */
  lemma LookBodyLeafValue(rer: LW.RegExpRecord, lk: L.Lookaround, r1: L.Regex, tlk: LT.Tree,
                          gm: LG.GroupMap, inp: LC.Input, S: set<LG.GroupId>)
    requires tlk == FU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk))
    requires S == (set g | g in L.DefGroups(r1))
    requires GmAgreeOn(gm, LG.Empty, S)      // body groups unset in gm (reset / fresh)
    ensures var dir := L.LkDir(lk);
            var sub := LT.TreeLeaves(tlk, gm, inp, dir);
            var subE := LT.TreeLeaves(tlk, LG.Empty, inp, dir);
            |sub| == |subE|
            && forall i :: 0 <= i < |sub| ==> sub[i].0 == subE[i].0 && GmAgreeOn(sub[i].1, subE[i].1, S)
  {
    var dir := L.LkDir(lk);
    assert LL.GmAgreeInside(gm, LG.Empty, S);      // GmAgreeOn ≡ GmAgreeInside
    LL.TreeLeavesFrameInside(tlk, gm, LG.Empty, inp, dir, S);
    forall i | 0 <= i < |LT.TreeLeaves(tlk, gm, inp, dir)|
      ensures LT.TreeLeaves(tlk, gm, inp, dir)[i].0 == LT.TreeLeaves(tlk, LG.Empty, inp, dir)[i].0
              && GmAgreeOn(LT.TreeLeaves(tlk, gm, inp, dir)[i].1, LT.TreeLeaves(tlk, LG.Empty, inp, dir)[i].1, S)
    {
      assert LL.GmAgreeInside(LT.TreeLeaves(tlk, gm, inp, dir)[i].1, LT.TreeLeaves(tlk, LG.Empty, inp, dir)[i].1, S);
    }
  }

  least lemma FirstLeafClosed(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                              b: BS.LoopBool, t: LT.Tree, gm: LG.GroupMap, leaf: LT.Leaf)
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    requires EL.PikeLkActions(acts)
    requires OpenOf(gm) <= PendingCloses(acts)
    requires LT.TreeRes(t, gm, inp, WP.Forward) == Some(leaf)
    requires LkClosedInGm(gm, acts)             // L3a: reused pending inside-look groups are closed
    requires OuterLkDisjoint(acts)              // L3a: outer defs disjoint from inside-look groups
    requires NoDupRegsActs(acts)                // L3b: each pending regex has dup-free groups (for NoDupG)
    requires TRM.GmInBounds(gm, |inp.pref| + |inp.next|)   // L3b: gm ranges within input (for the mirror)
    ensures ClosedGm(leaf.1)
  {
    var n := |inp.pref| + |inp.next|;
    if |acts| == 0 {
      assert t == LT.Match;
      assert leaf.1 == gm;
      assert PendingCloses(acts) == {};
      forall g | g in gm ensures gm[g].endIdx.Some? {
        if gm[g].endIdx.None? { assert g in OpenOf(gm); }
      }
    } else {
      var cont := acts[1..];
      assert forall i :: 0 <= i < |cont| ==> cont[i] == acts[i + 1];
      assert PendingCloses(cont) <= PendingCloses(acts);
      assert NoDupRegsActs(cont) by { forall i | 0 <= i < |cont| ensures cont[i].Areg? ==> NoDupSeq(L.DefGroups(cont[i].r)) { assert cont[i] == acts[i + 1]; } }
      match acts[0]
      case Acheck(strcheck) =>
        if b == BS.CanExit {
          assert t.Progress?;
          assert PendingCloses(acts) == PendingCloses(cont);
          TailInv(gm, gm, acts);
          FirstLeafClosed(rer, cont, inp, BS.CanExit, t.t, gm, leaf);
        } else {
          assert t == LT.Mismatch;
          assert false;
        }
      case Aclose(gid) =>
        assert t.GroupActionT? && t.g == LG.Close(gid);
        var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
        assert gm2 == LG.GMClose(LC.Idx(inp), gid, gm);
        assert OpenOf(gm2) <= PendingCloses(cont) by {
          forall g | g in OpenOf(gm2) ensures g in PendingCloses(cont) {
            assert g != gid;
            assert g in OpenOf(gm);
            assert g in PendingCloses(acts);
            var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == g;
            assert i != 0;
            assert cont[i - 1] == acts[i];
          }
        }
        // GMClose keeps the domain, closes gid, and leaves every other group as-is.
        assert forall g :: g in gm2 ==> g in gm && (gm2[g].endIdx.Some? || gm2[g] == gm[g]);
        assert TRM.GmInBounds(gm2, n) by { assert LC.Idx(inp) <= n; }
        TailInv(gm, gm2, acts);
        FirstLeafClosed(rer, cont, inp, b, t.t, gm2, leaf);
      case Areg(r) =>
        match r
        case Epsilon =>
          assert PendingCloses(acts) == PendingCloses(cont);
          TailInv(gm, gm, acts);
          FirstLeafClosed(rer, cont, inp, b, t, gm, leaf);
        case Character(cd) =>
          if LC.ReadChar(rer, cd, inp, WP.Forward).None? {
            assert t == LT.Mismatch;
            assert false;
          } else {
            var pair := LC.ReadChar(rer, cd, inp, WP.Forward).value;
            assert t.Read?;
            assert pair.1 == LC.AdvanceInputP(inp, WP.Forward);
            assert |pair.1.pref| + |pair.1.next| == n;   // advance preserves total length
            assert PendingCloses(acts) == PendingCloses(cont);
            TailInv(gm, gm, acts);
            FirstLeafClosed(rer, cont, pair.1, BS.CanExit, t.t, gm, leaf);
          }
        case Disjunction(r1, r2) =>
          assert t.Choice?;
          var acts1 := [LS.Areg(r1)] + cont;
          var acts2 := [LS.Areg(r2)] + cont;
          assert PendingCloses(acts1) == PendingCloses(cont) == PendingCloses(acts2) by {
            assert forall i :: 0 <= i < |cont| ==> acts1[i + 1] == cont[i] && acts2[i + 1] == cont[i];
          }
          assert PendingCloses(acts) == PendingCloses(cont);
          LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), cont); LkBodyGroupsActsCons(LS.Areg(r2), cont);
          OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), cont); OuterDefsActsCons(LS.Areg(r2), cont);
          assert LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) + LL.LkBodyGroups(r2);
          assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2);
          assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
          NoDupConcat(L.DefGroups(r1), L.DefGroups(r2));
          assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i == 0 {} else { assert acts1[i] == cont[i - 1]; } } }
          assert NoDupRegsActs(acts2) by { forall i | 0 <= i < |acts2| ensures acts2[i].Areg? ==> NoDupSeq(L.DefGroups(acts2[i].r)) { if i == 0 {} else { assert acts2[i] == cont[i - 1]; } } }
          if LT.TreeRes(t.t1, gm, inp, WP.Forward).Some? {
            SubInv(gm, gm, acts1, acts);
            FirstLeafClosed(rer, acts1, inp, b, t.t1, gm, leaf);
          } else {
            SubInv(gm, gm, acts2, acts);
            FirstLeafClosed(rer, acts2, inp, b, t.t2, gm, leaf);
          }
        case Sequence(r1, r2) =>
          var acts1 := [LS.Areg(r1), LS.Areg(r2)] + cont;
          assert PendingCloses(acts1) == PendingCloses(cont) by {
            assert forall i :: 0 <= i < |cont| ==> acts1[i + 2] == cont[i];
          }
          assert PendingCloses(acts) == PendingCloses(cont);
          assert acts1 == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
          LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont); LkBodyGroupsActsCons(LS.Areg(r2), cont);
          OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont); OuterDefsActsCons(LS.Areg(r2), cont);
          assert LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) + LL.LkBodyGroups(r2);
          assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2);
          assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
          NoDupConcat(L.DefGroups(r1), L.DefGroups(r2));
          assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
          SubInv(gm, gm, acts1, acts);
          FirstLeafClosed(rer, acts1, inp, b, t, gm, leaf);
        case Quantified(greedy, min, delta, r1) =>
          var gidl := L.DefGroups(r1);
          if min > 0 {
            assert t.GroupActionT? && t.g == LG.Reset(gidl);
            var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
            assert gm2 == LG.GMReset(gidl, gm);
            assert OpenOf(gm2) <= OpenOf(gm);
            assert forall g :: g in gm2 ==> g in gm && gm2[g] == gm[g];
            var q' := L.Quantified(greedy, min - 1, delta, r1);
            var acts1 := [LS.Areg(r1), LS.Areg(q')] + cont;
            assert PendingCloses(acts1) == PendingCloses(cont) by {
              assert forall i :: 0 <= i < |cont| ==> acts1[i + 2] == cont[i];
            }
            assert PendingCloses(acts) == PendingCloses(cont);
            assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) && L.DefGroups(q') == L.DefGroups(r1);
            assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
            assert TRM.GmInBounds(gm2, n);   // GMReset only shrinks the domain
            QuantSubInv(gm, gm2, r, r1, q', cont, acts, acts1);
            FirstLeafClosed(rer, acts1, inp, b, t.t, gm2, leaf);
          } else if delta == LN.NN(0) {
            assert PendingCloses(acts) == PendingCloses(cont);
            TailInv(gm, gm, acts);
            FirstLeafClosed(rer, cont, inp, b, t, gm, leaf);
          } else {
            assert t.Choice?;
            var itert := if greedy then t.t1 else t.t2;
            var skipt := if greedy then t.t2 else t.t1;
            assert itert.GroupActionT? && itert.g == LG.Reset(gidl);
            assert PendingCloses(acts) == PendingCloses(cont);
            // Seqop picks t.t1 first: split on which branch the leaf came from.
            if LT.TreeRes(t.t1, gm, inp, WP.Forward).Some? {
              if greedy {
                var gm2 := LG.GMUpdate(itert.g, LC.Idx(inp), gm);
                assert gm2 == LG.GMReset(gidl, gm);
                assert OpenOf(gm2) <= OpenOf(gm);
                assert forall g :: g in gm2 ==> g in gm && gm2[g] == gm[g];
                var q'' := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
                var acts1 := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q'')] + cont;
                assert PendingCloses(acts1) == PendingCloses(cont) by {
                  assert forall i :: 0 <= i < |cont| ==> acts1[i + 3] == cont[i];
                }
                assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) && L.DefGroups(q'') == L.DefGroups(r1);
                assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 3 {} else { assert acts1[i] == cont[i - 3]; } } }
                assert TRM.GmInBounds(gm2, n);
                QuantSubInvCheck(gm, gm2, r, r1, q'', inp, cont, acts, acts1);
                FirstLeafClosed(rer, acts1, inp, BS.CannotExit, itert.t, gm2, leaf);
              } else {
                TailInv(gm, gm, acts);
                FirstLeafClosed(rer, cont, inp, b, skipt, gm, leaf);
              }
            } else {
              if greedy {
                TailInv(gm, gm, acts);
                FirstLeafClosed(rer, cont, inp, b, skipt, gm, leaf);
              } else {
                var gm2 := LG.GMUpdate(itert.g, LC.Idx(inp), gm);
                assert gm2 == LG.GMReset(gidl, gm);
                assert OpenOf(gm2) <= OpenOf(gm);
                assert forall g :: g in gm2 ==> g in gm && gm2[g] == gm[g];
                var q'' := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
                var acts1 := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q'')] + cont;
                assert PendingCloses(acts1) == PendingCloses(cont) by {
                  assert forall i :: 0 <= i < |cont| ==> acts1[i + 3] == cont[i];
                }
                assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) && L.DefGroups(q'') == L.DefGroups(r1);
                assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 3 {} else { assert acts1[i] == cont[i - 3]; } } }
                assert TRM.GmInBounds(gm2, n);
                QuantSubInvCheck(gm, gm2, r, r1, q'', inp, cont, acts, acts1);
                FirstLeafClosed(rer, acts1, inp, BS.CannotExit, itert.t, gm2, leaf);
              }
            }
          }
        case Group(gid, r1) =>
          assert t.GroupActionT? && t.g == LG.Open(gid);
          var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
          assert gm2 == LG.GMOpen(LC.Idx(inp), gid, gm);
          var acts1 := [LS.Areg(r1), LS.Aclose(gid)] + cont;
          assert gid in PendingCloses(acts1) by { assert acts1[1].Aclose? && acts1[1].gid == gid; }
          assert OpenOf(gm2) <= PendingCloses(acts1) by {
            forall g | g in OpenOf(gm2) ensures g in PendingCloses(acts1) {
              if g != gid {
                assert g in OpenOf(gm);
                assert g in PendingCloses(acts);
                var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == g;
                assert i != 0;
                assert acts1[i + 1] == cont[i - 1] == acts[i];
              }
            }
          }
          // gid is an OUTER group ⇒ gid ∉ LkBodyGroupsActs; the Group rewrite keeps
          // the same look groups and shrinks outer defs, so both invariants thread.
          assert acts1 == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
          LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont); LkBodyGroupsActsCons(LS.Aclose(gid), cont);
          OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont); OuterDefsActsCons(LS.Aclose(gid), cont);
          assert L.DefGroups(r) == [gid] + L.DefGroups(r1);
          assert gid in OuterDefsActs(acts) && gid !in LkBodyGroupsActs(acts);   // OuterLkDisjoint
          assert LkBodyGroupsActs(acts1) == LkBodyGroupsActs(acts);
          assert LkClosedInGm(gm2, acts1) by {
            forall g | g in gm2 && g in LkBodyGroupsActs(acts1) ensures gm2[g].endIdx.Some? {
              assert g != gid; assert g in gm && g in LkBodyGroupsActs(acts);
            }
          }
          assert OuterLkDisjoint(acts1);
          assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == [gid] + L.DefGroups(r1);
          NoDupTailSeq([gid], L.DefGroups(r1));   // drop the leading [gid] ⇒ NoDupSeq(DefGroups(r1))
          assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
          assert TRM.GmInBounds(gm2, n) by { assert LC.Idx(inp) <= n; }
          FirstLeafClosed(rer, acts1, inp, b, t.t, gm2, leaf);
        case AnchorR(a) =>
          if LS.AnchorSatisfied(rer, a, inp) {
            assert t.AnchorPass?;
            assert PendingCloses(acts) == PendingCloses(cont);
            TailInv(gm, gm, acts);
            FirstLeafClosed(rer, cont, inp, b, t.t, gm, leaf);
          } else {
            assert t == LT.Mismatch;
            assert false;
          }
        case LookaroundR(lk, r1) =>
          // L3a: a positive-forward lookahead body may CAPTURE. A positive look
          // hands the continuation the body's first-leaf map (captures merged, all
          // CLOSED); a negative look the entry map. OpenOf carries through via
          // LookBodyLeafOpenSub; the invariants thread because the look closes its
          // own groups and outer groups stay disjoint from look groups.
          var S := (set g | g in L.DefGroups(r1));
          match t {
            case LK(lk2, tlk, tc) =>
              assert PendingCloses(acts) == PendingCloses(cont);
              assert EL.LkGateOk(rer, lk, r1, inp, tlk, true) && EL.BoolTreeLk(rer, cont, inp, b, tc);
              assert tlk == FU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
              assert EL.PikeLkRegex(r);
              var dir := L.LkDir(lk);
              LkBodyGroupsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r), cont);
              assert L.DefGroups(r) == L.DefGroups(r1);
              assert LL.LkBodyGroups(r) == S + LL.LkBodyGroups(r1);
              assert S <= LkBodyGroupsActs(acts);
              assert LkBodyGroupsActs(cont) <= LkBodyGroupsActs(acts);
              assert OuterDefsActs(cont) <= OuterDefsActs(acts);
              // L3a/L3b: a POSITIVE look (fwd/bwd) may capture -> NoLkBrL body from
              // the widened PikeLkRegex; a NEGATIVE look is group-free. (The old
              // `DefGroups(r1) != [] ==> dir == Forward` "only lookaheads capture"
              // conjunct is retired for L3b -- lookbehinds capture too.)
              assert EL.NoLkBrL(r1) && EL.PikeLkRegex(r1) by {
                if L.Positivity(lk) { NoLkBrImpliesPikeLk(r1); }
                else { assert SD.GroupFreeL(r1); LL.GroupFreeLkBodyEmpty(r1); GroupFreeImpliesNoLkBr(r1); NoLkBrImpliesPikeLk(r1); }
              }
              assert OuterLkDisjoint(cont);
              if L.Positivity(lk) {
                assert forall g :: g in gm && g in S ==> gm[g].endIdx.Some? by {
                  forall g | g in gm && g in S ensures gm[g].endIdx.Some? { assert g in LkBodyGroupsActs(acts); }
                }
                var sub := LT.TreeLeaves(tlk, gm, inp, dir);
                LT.FirstTreeLeaf(tlk, gm, inp, dir);
                assert |sub| > 0;                            // else TreeRes(t, ..) would be None
                // L3b NoDupG: acts[0]=Areg(r), r=LookaroundR(lk,r1), DefGroups(r)==DefGroups(r1);
                // NoDupRegsActs(acts) ⇒ NoDupSeq(DefGroups(r1)) ⇒ CDE.NoDupG(DefGroups(r1)).
                assert NoDupSeq(L.DefGroups(r1)) by { assert NoDupSeq(L.DefGroups(r)); assert L.DefGroups(r) == L.DefGroups(r1); }
                NoDupSeqIsNoDupG(L.DefGroups(r1));
                LookBodyLeafOpenSub(rer, lk, r1, tlk, gm, inp, sub, S);
                assert LT.TreeRes(tc, sub[0].1, inp, WP.Forward) == Some(leaf);  // LK positive unfold
                assert LkClosedInGm(sub[0].1, cont) by {
                  forall g | g in sub[0].1 && g in LkBodyGroupsActs(cont) ensures sub[0].1[g].endIdx.Some? {
                    if g in S {} else { assert g in gm; assert g in LkBodyGroupsActs(acts); assert g !in OpenOf(gm); assert g !in OpenOf(sub[0].1); }
                  }
                }
                FirstLeafClosed(rer, cont, inp, b, tc, sub[0].1, leaf);
              } else {
                assert LT.TreeRes(tc, gm, inp, WP.Forward) == Some(leaf);        // LK negative unfold
                assert LkClosedInGm(gm, cont) by {
                  forall g | g in gm && g in LkBodyGroupsActs(cont) ensures gm[g].endIdx.Some? { assert g in LkBodyGroupsActs(acts); }
                }
                FirstLeafClosed(rer, cont, inp, b, tc, gm, leaf);
              }
            case LKFail(lk2, tlk) =>
              assert false;                    // LKFail has no leaves
            case _ =>
          }
        case Backreference(_) =>
          assert false;
    }
  }

  // ==========================================================================
  // (L4 FINAL EXTRACTION) FIRST-LEAF CLOSEDNESS for the RECURSIVE (depth-k)
  // fragment. The depth-1 `FirstLeafClosed` is `PikeLkActions`-gated: its
  // positive-look case needs a LOOK-FREE body (`LookBodyLeafOpenSub` bottoms out
  // on `FirstLeafClosedNoLk`). The nested twin stratifies on LOOK-NESTING DEPTH:
  // the ∀-hypothesis `ClosedBelow(rer, D)` (closedness for every instance whose
  // pending regexes nest strictly below `D`) discharges the look-BODY leaf at a
  // gate (its depth drops by one), and the walk recursion stays a `least lemma`
  // over `BoolTreeLk` exactly as at depth 1. `ClosedBelowAll` closes the ladder.
  // Positive looks are FORWARD-only (`FwdPosLooksL` — the L4 `NoPosLookbehind`
  // scope); negative bodies are group-free as before.
  // ==========================================================================

  /** L-side look-nesting depth. */
  ghost function NestDepthL(r: L.Regex): nat
    decreases r
  {
    match r
    case Disjunction(r1, r2) => if NestDepthL(r1) >= NestDepthL(r2) then NestDepthL(r1) else NestDepthL(r2)
    case Sequence(r1, r2) => if NestDepthL(r1) >= NestDepthL(r2) then NestDepthL(r1) else NestDepthL(r2)
    case Quantified(_, _, _, r1) => NestDepthL(r1)
    case Group(_, r1) => NestDepthL(r1)
    case LookaroundR(_, r1) => NestDepthL(r1) + 1
    case _ => 0
  }

  /** Every pending regex nests at most `D` deep. */
  ghost predicate NestDepthActsLe(acts: LS.Actions, D: nat) {
    forall i :: 0 <= i < |acts| ==> (acts[i].Areg? ==> NestDepthL(acts[i].r) <= D)
  }

  /** Positive looks are FORWARD (the L4 `NoPosLookbehind` scope, L-side). */
  ghost predicate FwdPosLooksL(r: L.Regex)
    decreases r
  {
    match r
    case Disjunction(r1, r2) => FwdPosLooksL(r1) && FwdPosLooksL(r2)
    case Sequence(r1, r2) => FwdPosLooksL(r1) && FwdPosLooksL(r2)
    case Quantified(_, _, _, r1) => FwdPosLooksL(r1)
    case Group(_, r1) => FwdPosLooksL(r1)
    case LookaroundR(lk, r1) => (L.Positivity(lk) ==> L.LkDir(lk) == WP.Forward) && FwdPosLooksL(r1)
    case _ => true
  }

  ghost predicate FwdPosActsL(acts: LS.Actions) {
    forall i :: 0 <= i < |acts| ==> (acts[i].Areg? ==> FwdPosLooksL(acts[i].r))
  }

  /** The depth-stratification hypothesis: every closedness instance whose
      pending regexes nest STRICTLY below `D` lands at a closed leaf. */
  ghost predicate ClosedBelow(rer: LW.RegExpRecord, D: nat) {
    forall acts: LS.Actions, inp: LC.Input, b: BS.LoopBool, t: LT.Tree, gm: LG.GroupMap, leaf: LT.Leaf ::
      (D > 0 && NestDepthActsLe(acts, D - 1)
       && EL.BoolTreeLk(rer, acts, inp, b, t)
       && EL.PikeLkActionsRec(acts) && FwdPosActsL(acts)
       && OpenOf(gm) <= PendingCloses(acts)
       && LT.TreeRes(t, gm, inp, WP.Forward) == Some(leaf)
       && LkClosedInGm(gm, acts)
       && OuterLkDisjoint(acts)
       && NoDupRegsActs(acts)
       && TRM.GmInBounds(gm, |inp.pref| + |inp.next|))
      ==> ClosedGm(leaf.1)
  }


  /** (helper, REGULAR lemma — outside the least context) The from-`gmR` body
      leaf of a positive FORWARD gate is CLOSED, by the depth-stratification
      hypothesis `ClosedBelow` (the body instance nests strictly below `D`). The
      full `BoolTreeLk` for the body tree is derived here via the fuel route, so
      the least lemma's prefix semantics never see it. */
  lemma BodyLeafClosedFromBelow(rer: LW.RegExpRecord, lk: L.Lookaround, r1: L.Regex,
                                tlk: LT.Tree, inp: LC.Input, gmR: LG.GroupMap,
                                subR0: LT.Leaf, D: nat)
    requires L.Positivity(lk) && L.LkDir(lk) == WP.Forward
    requires EL.PikeLkRegexRec(r1) && FwdPosLooksL(r1)
    requires tlk == FU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, WP.Forward)
    requires LT.TreeRes(tlk, gmR, inp, WP.Forward) == Some(subR0)
    requires forall g :: g in gmR ==> gmR[g].endIdx.Some?
    requires NoDupSeq(L.DefGroups(r1))
    requires TRM.GmInBounds(gmR, |inp.pref| + |inp.next|)
    requires D > 0 && NestDepthL(r1) <= D - 1
    requires ClosedBelow(rer, D)
    ensures ClosedGm(subR0.1)
  {
    assert EL.PikeLkActionsRec([LS.Areg(r1)]) by {
      assert [LS.Areg(r1)] == [LS.Areg(r1)] + [];
      assert EL.PikeLkActionsRec([]);
      EL.PikeLkActionsRecConsIff(LS.Areg(r1), []);
    }
    var fuel := LFS.ActionsFuel([LS.Areg(r1)], inp, WP.Forward) + 1;
    LFS.FunctionalTerminates(rer, [LS.Areg(r1)], inp, LG.Empty, WP.Forward, fuel);
    assert LFS.ComputeTree(rer, [LS.Areg(r1)], inp, LG.Empty, WP.Forward, fuel) == Some(tlk);
    var b0 := BS.CannotExit;
    assert BS.BoolEncoding(b0, inp, [LS.Areg(r1)]);
    EL.ComputeBoolTreeLkRec(rer, [LS.Areg(r1)], inp, LG.Empty, b0, fuel, tlk);
    assert EL.BoolTreeLk(rer, [LS.Areg(r1)], inp, b0, tlk);
    assert NestDepthActsLe([LS.Areg(r1)], D - 1);
    assert FwdPosActsL([LS.Areg(r1)]);
    assert OpenOf(gmR) == {} by {
      forall g | g in OpenOf(gmR) ensures false { assert gmR[g].endIdx.Some?; }
    }
    assert OpenOf(gmR) <= PendingCloses([LS.Areg(r1)]);
    assert LkClosedInGm(gmR, [LS.Areg(r1)]) by {
      forall g | g in gmR && g in LkBodyGroupsActs([LS.Areg(r1)]) ensures gmR[g].endIdx.Some? { }
    }
    assert OuterLkDisjoint([LS.Areg(r1)]) by {
      OuterDefsActsCons(LS.Areg(r1), []); LkBodyGroupsActsCons(LS.Areg(r1), []);
      OuterLkFromNoDup(r1);
    }
    assert NoDupRegsActs([LS.Areg(r1)]);
  }

  least lemma FirstLeafClosedRecAux(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                                    b: BS.LoopBool, t: LT.Tree, gm: LG.GroupMap, leaf: LT.Leaf, D: nat)
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    requires EL.PikeLkActionsRec(acts) && FwdPosActsL(acts)
    requires NestDepthActsLe(acts, D)
    requires ClosedBelow(rer, D)
    requires OpenOf(gm) <= PendingCloses(acts)
    requires LT.TreeRes(t, gm, inp, WP.Forward) == Some(leaf)
    requires LkClosedInGm(gm, acts)
    requires OuterLkDisjoint(acts)
    requires NoDupRegsActs(acts)
    requires TRM.GmInBounds(gm, |inp.pref| + |inp.next|)
    ensures ClosedGm(leaf.1)
  {
    var n := |inp.pref| + |inp.next|;
    if |acts| == 0 {
      assert t == LT.Match;
      assert leaf.1 == gm;
      assert PendingCloses(acts) == {};
      forall g | g in gm ensures gm[g].endIdx.Some? {
        if gm[g].endIdx.None? { assert g in OpenOf(gm); }
      }
    } else {
      var cont := acts[1..];
      assert forall i :: 0 <= i < |cont| ==> cont[i] == acts[i + 1];
      assert PendingCloses(cont) <= PendingCloses(acts);
      assert NoDupRegsActs(cont) by { forall i | 0 <= i < |cont| ensures cont[i].Areg? ==> NoDupSeq(L.DefGroups(cont[i].r)) { assert cont[i] == acts[i + 1]; } }
      match acts[0]
      case Acheck(strcheck) =>
        if b == BS.CanExit {
          assert t.Progress?;
          assert PendingCloses(acts) == PendingCloses(cont);
          TailInv(gm, gm, acts);
          FirstLeafClosedRecAux(rer, cont, inp, BS.CanExit, t.t, gm, leaf, D);
        } else {
          assert t == LT.Mismatch;
          assert false;
        }
      case Aclose(gid) =>
        assert t.GroupActionT? && t.g == LG.Close(gid);
        var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
        assert gm2 == LG.GMClose(LC.Idx(inp), gid, gm);
        assert OpenOf(gm2) <= PendingCloses(cont) by {
          forall g | g in OpenOf(gm2) ensures g in PendingCloses(cont) {
            assert g != gid;
            assert g in OpenOf(gm);
            assert g in PendingCloses(acts);
            var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == g;
            assert i != 0;
            assert cont[i - 1] == acts[i];
          }
        }
        // GMClose keeps the domain, closes gid, and leaves every other group as-is.
        assert forall g :: g in gm2 ==> g in gm && (gm2[g].endIdx.Some? || gm2[g] == gm[g]);
        assert TRM.GmInBounds(gm2, n) by { assert LC.Idx(inp) <= n; }
        TailInv(gm, gm2, acts);
        FirstLeafClosedRecAux(rer, cont, inp, b, t.t, gm2, leaf, D);
      case Areg(r) =>
        match r
        case Epsilon =>
          assert PendingCloses(acts) == PendingCloses(cont);
          TailInv(gm, gm, acts);
          FirstLeafClosedRecAux(rer, cont, inp, b, t, gm, leaf, D);
        case Character(cd) =>
          if LC.ReadChar(rer, cd, inp, WP.Forward).None? {
            assert t == LT.Mismatch;
            assert false;
          } else {
            var pair := LC.ReadChar(rer, cd, inp, WP.Forward).value;
            assert t.Read?;
            assert pair.1 == LC.AdvanceInputP(inp, WP.Forward);
            assert |pair.1.pref| + |pair.1.next| == n;   // advance preserves total length
            assert PendingCloses(acts) == PendingCloses(cont);
            TailInv(gm, gm, acts);
            FirstLeafClosedRecAux(rer, cont, pair.1, BS.CanExit, t.t, gm, leaf, D);
          }
        case Disjunction(r1, r2) =>
          assert t.Choice?;
          var acts1 := [LS.Areg(r1)] + cont;
          var acts2 := [LS.Areg(r2)] + cont;
          assert PendingCloses(acts1) == PendingCloses(cont) == PendingCloses(acts2) by {
            assert forall i :: 0 <= i < |cont| ==> acts1[i + 1] == cont[i] && acts2[i + 1] == cont[i];
          }
          assert PendingCloses(acts) == PendingCloses(cont);
          LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), cont); LkBodyGroupsActsCons(LS.Areg(r2), cont);
          OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), cont); OuterDefsActsCons(LS.Areg(r2), cont);
          assert LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) + LL.LkBodyGroups(r2);
          assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2);
          assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
          NoDupConcat(L.DefGroups(r1), L.DefGroups(r2));
          assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i == 0 {} else { assert acts1[i] == cont[i - 1]; } } }
          assert NoDupRegsActs(acts2) by { forall i | 0 <= i < |acts2| ensures acts2[i].Areg? ==> NoDupSeq(L.DefGroups(acts2[i].r)) { if i == 0 {} else { assert acts2[i] == cont[i - 1]; } } }
          if LT.TreeRes(t.t1, gm, inp, WP.Forward).Some? {
            SubInv(gm, gm, acts1, acts);
            FirstLeafClosedRecAux(rer, acts1, inp, b, t.t1, gm, leaf, D);
          } else {
            SubInv(gm, gm, acts2, acts);
            FirstLeafClosedRecAux(rer, acts2, inp, b, t.t2, gm, leaf, D);
          }
        case Sequence(r1, r2) =>
          var acts1 := [LS.Areg(r1), LS.Areg(r2)] + cont;
          assert PendingCloses(acts1) == PendingCloses(cont) by {
            assert forall i :: 0 <= i < |cont| ==> acts1[i + 2] == cont[i];
          }
          assert PendingCloses(acts) == PendingCloses(cont);
          assert acts1 == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
          LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont); LkBodyGroupsActsCons(LS.Areg(r2), cont);
          OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont); OuterDefsActsCons(LS.Areg(r2), cont);
          assert LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) + LL.LkBodyGroups(r2);
          assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2);
          assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
          NoDupConcat(L.DefGroups(r1), L.DefGroups(r2));
          assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
          SubInv(gm, gm, acts1, acts);
          FirstLeafClosedRecAux(rer, acts1, inp, b, t, gm, leaf, D);
        case Quantified(greedy, min, delta, r1) =>
          var gidl := L.DefGroups(r1);
          if min > 0 {
            assert t.GroupActionT? && t.g == LG.Reset(gidl);
            var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
            assert gm2 == LG.GMReset(gidl, gm);
            assert OpenOf(gm2) <= OpenOf(gm);
            assert forall g :: g in gm2 ==> g in gm && gm2[g] == gm[g];
            var q' := L.Quantified(greedy, min - 1, delta, r1);
            var acts1 := [LS.Areg(r1), LS.Areg(q')] + cont;
            assert PendingCloses(acts1) == PendingCloses(cont) by {
              assert forall i :: 0 <= i < |cont| ==> acts1[i + 2] == cont[i];
            }
            assert PendingCloses(acts) == PendingCloses(cont);
            assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) && L.DefGroups(q') == L.DefGroups(r1);
            assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
            assert TRM.GmInBounds(gm2, n);   // GMReset only shrinks the domain
            QuantSubInv(gm, gm2, r, r1, q', cont, acts, acts1);
            FirstLeafClosedRecAux(rer, acts1, inp, b, t.t, gm2, leaf, D);
          } else if delta == LN.NN(0) {
            assert PendingCloses(acts) == PendingCloses(cont);
            TailInv(gm, gm, acts);
            FirstLeafClosedRecAux(rer, cont, inp, b, t, gm, leaf, D);
          } else {
            assert t.Choice?;
            var itert := if greedy then t.t1 else t.t2;
            var skipt := if greedy then t.t2 else t.t1;
            assert itert.GroupActionT? && itert.g == LG.Reset(gidl);
            assert PendingCloses(acts) == PendingCloses(cont);
            // Seqop picks t.t1 first: split on which branch the leaf came from.
            if LT.TreeRes(t.t1, gm, inp, WP.Forward).Some? {
              if greedy {
                var gm2 := LG.GMUpdate(itert.g, LC.Idx(inp), gm);
                assert gm2 == LG.GMReset(gidl, gm);
                assert OpenOf(gm2) <= OpenOf(gm);
                assert forall g :: g in gm2 ==> g in gm && gm2[g] == gm[g];
                var q'' := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
                var acts1 := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q'')] + cont;
                assert PendingCloses(acts1) == PendingCloses(cont) by {
                  assert forall i :: 0 <= i < |cont| ==> acts1[i + 3] == cont[i];
                }
                assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) && L.DefGroups(q'') == L.DefGroups(r1);
                assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 3 {} else { assert acts1[i] == cont[i - 3]; } } }
                assert TRM.GmInBounds(gm2, n);
                QuantSubInvCheck(gm, gm2, r, r1, q'', inp, cont, acts, acts1);
                FirstLeafClosedRecAux(rer, acts1, inp, BS.CannotExit, itert.t, gm2, leaf, D);
              } else {
                TailInv(gm, gm, acts);
                FirstLeafClosedRecAux(rer, cont, inp, b, skipt, gm, leaf, D);
              }
            } else {
              if greedy {
                TailInv(gm, gm, acts);
                FirstLeafClosedRecAux(rer, cont, inp, b, skipt, gm, leaf, D);
              } else {
                var gm2 := LG.GMUpdate(itert.g, LC.Idx(inp), gm);
                assert gm2 == LG.GMReset(gidl, gm);
                assert OpenOf(gm2) <= OpenOf(gm);
                assert forall g :: g in gm2 ==> g in gm && gm2[g] == gm[g];
                var q'' := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
                var acts1 := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q'')] + cont;
                assert PendingCloses(acts1) == PendingCloses(cont) by {
                  assert forall i :: 0 <= i < |cont| ==> acts1[i + 3] == cont[i];
                }
                assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) && L.DefGroups(q'') == L.DefGroups(r1);
                assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 3 {} else { assert acts1[i] == cont[i - 3]; } } }
                assert TRM.GmInBounds(gm2, n);
                QuantSubInvCheck(gm, gm2, r, r1, q'', inp, cont, acts, acts1);
                FirstLeafClosedRecAux(rer, acts1, inp, BS.CannotExit, itert.t, gm2, leaf, D);
              }
            }
          }
        case Group(gid, r1) =>
          assert t.GroupActionT? && t.g == LG.Open(gid);
          var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
          assert gm2 == LG.GMOpen(LC.Idx(inp), gid, gm);
          var acts1 := [LS.Areg(r1), LS.Aclose(gid)] + cont;
          assert gid in PendingCloses(acts1) by { assert acts1[1].Aclose? && acts1[1].gid == gid; }
          assert OpenOf(gm2) <= PendingCloses(acts1) by {
            forall g | g in OpenOf(gm2) ensures g in PendingCloses(acts1) {
              if g != gid {
                assert g in OpenOf(gm);
                assert g in PendingCloses(acts);
                var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == g;
                assert i != 0;
                assert acts1[i + 1] == cont[i - 1] == acts[i];
              }
            }
          }
          // gid is an OUTER group ⇒ gid ∉ LkBodyGroupsActs; the Group rewrite keeps
          // the same look groups and shrinks outer defs, so both invariants thread.
          assert acts1 == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
          LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont); LkBodyGroupsActsCons(LS.Aclose(gid), cont);
          OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont); OuterDefsActsCons(LS.Aclose(gid), cont);
          assert L.DefGroups(r) == [gid] + L.DefGroups(r1);
          assert gid in OuterDefsActs(acts) && gid !in LkBodyGroupsActs(acts);   // OuterLkDisjoint
          assert LkBodyGroupsActs(acts1) == LkBodyGroupsActs(acts);
          assert LkClosedInGm(gm2, acts1) by {
            forall g | g in gm2 && g in LkBodyGroupsActs(acts1) ensures gm2[g].endIdx.Some? {
              assert g != gid; assert g in gm && g in LkBodyGroupsActs(acts);
            }
          }
          assert OuterLkDisjoint(acts1);
          assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == [gid] + L.DefGroups(r1);
          NoDupTailSeq([gid], L.DefGroups(r1));   // drop the leading [gid] ⇒ NoDupSeq(DefGroups(r1))
          assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
          assert TRM.GmInBounds(gm2, n) by { assert LC.Idx(inp) <= n; }
          FirstLeafClosedRecAux(rer, acts1, inp, b, t.t, gm2, leaf, D);
        case AnchorR(a) =>
          if LS.AnchorSatisfied(rer, a, inp) {
            assert t.AnchorPass?;
            assert PendingCloses(acts) == PendingCloses(cont);
            TailInv(gm, gm, acts);
            FirstLeafClosedRecAux(rer, cont, inp, b, t.t, gm, leaf, D);
          } else {
            assert t == LT.Mismatch;
            assert false;
          }
        case LookaroundR(lk, r1) =>
          // The gate: fold the body first-leaf in (positive) or thread gm (negative).
          var S := (set g | g in L.DefGroups(r1));
          match t {
            case LK(lk2, tlk, tc) =>
              assert PendingCloses(acts) == PendingCloses(cont);
              assert EL.LkGateOk(rer, lk, r1, inp, tlk, true) && EL.BoolTreeLk(rer, cont, inp, b, tc);
              assert tlk == FU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
              var dir := L.LkDir(lk);
              LkBodyGroupsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r), cont);
              assert L.DefGroups(r) == L.DefGroups(r1);
              assert LL.LkBodyGroups(r) == S + LL.LkBodyGroups(r1);
              assert S <= LkBodyGroupsActs(acts);
              assert LkBodyGroupsActs(cont) <= LkBodyGroupsActs(acts);
              assert OuterDefsActs(cont) <= OuterDefsActs(acts);
              assert OuterLkDisjoint(cont);
              if L.Positivity(lk) {
                assert dir == WP.Forward;                       // FwdPosLooksL(r)
                assert EL.PikeLkRegexRec(r1);                   // Rec: positive body recurses
                assert forall g :: g in gm && g in S ==> gm[g].endIdx.Some? by {
                  forall g | g in gm && g in S ensures gm[g].endIdx.Some? { assert g in LkBodyGroupsActs(acts); }
                }
                var sub := LT.TreeLeaves(tlk, gm, inp, dir);
                LT.FirstTreeLeaf(tlk, gm, inp, dir);
                assert |sub| > 0;                               // else TreeRes(t, ..) would be None
                assert NoDupSeq(L.DefGroups(r1)) by { assert NoDupSeq(L.DefGroups(r)); }
                // ---- the STRATIFIED body-leaf closedness at the S-restriction ----
                var gmR := map g | g in gm && g in S :: gm[g];
                assert OpenOf(gmR) == {} by {
                  forall g | g in gmR ensures gmR[g].endIdx.Some? { assert g in gm && g in S; }
                }
                var subR := LT.TreeLeaves(tlk, gmR, inp, dir);
                assert LL.GmAgreeInside(gm, gmR, S) by {
                  forall g | g in S ensures (g in gm <==> g in gmR) && (g in gm ==> gm[g] == gmR[g]) {}
                }
                LL.TreeLeavesFrameInside(tlk, gm, gmR, inp, dir, S);
                assert |sub| == |subR|;
                LT.FirstTreeLeaf(tlk, gmR, inp, dir);
                assert LT.TreeRes(tlk, gmR, inp, WP.Forward) == Some(subR[0]);
                // the body instance sits strictly below D
                assert acts[0].Areg? && acts[0].r == r;
                assert NestDepthL(r) <= D;                     // NestDepthActsLe at index 0
                assert NestDepthL(r1) < NestDepthL(r);
                assert FwdPosLooksL(r1);                       // FwdPosLooksL(r) at the look node
                // the body-walk confinement (hoisted: all following blocks read it)
                assert LL.DefGroupsIn(r1, S);
                LL.ComputeTrConfinedRec(rer, r1, inp, LG.Empty, dir, S);
                LL.GmConfinedLeavesRec(tlk, gm, inp, dir, S);
                assert LL.GmAgreeOutside(sub[0].1, gm, S);
                assert LL.GmAgreeInside(sub[0].1, subR[0].1, S);   // TreeLeavesFrameInside at 0
                assert TRM.GmInBounds(gmR, n) by {
                  assert forall g :: g in gmR ==> g in gm && gmR[g] == gm[g];
                }
                assert forall g :: g in gmR ==> gmR[g].endIdx.Some? by {
                  forall g | g in gmR ensures gmR[g].endIdx.Some? { assert g in gm && g in S; }
                }
                BodyLeafClosedFromBelow(rer, lk, r1, tlk, inp, gmR, subR[0], D);
                assert ClosedGm(subR[0].1);                     // ClosedBelow at the body instance
                // frames: S-agreement moves closedness; off-S the leaf equals gm
                assert forall g :: g in OpenOf(sub[0].1) ==> g in OpenOf(gm) by {
                  forall g | g in OpenOf(sub[0].1) ensures g in OpenOf(gm) {
                    if g in S {
                      assert g in subR[0].1 && subR[0].1[g].endIdx.Some?;
                      assert false;
                    }
                  }
                }
                assert forall g :: g in sub[0].1 ==> g in gm || g in S by {
                  forall g | g in sub[0].1 ensures g in gm || g in S {
                    if g !in S { }
                  }
                }
                assert TRM.GmInBounds(sub[0].1, n) by { TreeLeavesInBounds(tlk, gm, inp, dir, n); }
                assert OpenOf(sub[0].1) <= PendingCloses(cont) by {
                  forall g | g in OpenOf(sub[0].1) ensures g in PendingCloses(cont) {
                    assert g in OpenOf(gm);
                    assert g in PendingCloses(acts);
                    var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == g;
                    assert i != 0;
                    assert cont[i - 1] == acts[i];
                  }
                }
                assert LT.TreeRes(tc, sub[0].1, inp, WP.Forward) == Some(leaf);  // LK positive unfold
                assert LkClosedInGm(sub[0].1, cont) by {
                  forall g | g in sub[0].1 && g in LkBodyGroupsActs(cont) ensures sub[0].1[g].endIdx.Some? {
                    if g in S {
                      assert LL.GmAgreeInside(sub[0].1, subR[0].1, S);
                      assert g in subR[0].1 && subR[0].1[g].endIdx.Some?;
                    } else {
                      assert g in gm;
                      assert g in LkBodyGroupsActs(acts);
                    }
                  }
                }
                FirstLeafClosedRecAux(rer, cont, inp, b, tc, sub[0].1, leaf, D);
              } else {
                assert SD.GroupFreeL(r1);                       // Rec: negative body group-free
                assert LT.TreeRes(tc, gm, inp, WP.Forward) == Some(leaf);        // LK negative unfold
                assert LkClosedInGm(gm, cont) by {
                  forall g | g in gm && g in LkBodyGroupsActs(cont) ensures gm[g].endIdx.Some? { assert g in LkBodyGroupsActs(acts); }
                }
                assert PendingCloses(acts) == PendingCloses(cont);
                TailInv(gm, gm, acts);
                FirstLeafClosedRecAux(rer, cont, inp, b, tc, gm, leaf, D);
              }
            case LKFail(lk2, tlk) =>
              assert false;                    // LKFail has no leaves
            case _ =>
          }
        case Backreference(_) =>
          assert false;
    }
  }

  /** The stratification ladder: closedness holds below every depth bound. */
  lemma ClosedBelowAll(rer: LW.RegExpRecord, D: nat)
    ensures ClosedBelow(rer, D)
    decreases D
  {
    if D == 0 {
    } else {
      ClosedBelowAll(rer, D - 1);
      forall acts: LS.Actions, inp: LC.Input, b: BS.LoopBool, t: LT.Tree, gm: LG.GroupMap, leaf: LT.Leaf |
        NestDepthActsLe(acts, D - 1)
        && EL.BoolTreeLk(rer, acts, inp, b, t)
        && EL.PikeLkActionsRec(acts) && FwdPosActsL(acts)
        && OpenOf(gm) <= PendingCloses(acts)
        && LT.TreeRes(t, gm, inp, WP.Forward) == Some(leaf)
        && LkClosedInGm(gm, acts)
        && OuterLkDisjoint(acts)
        && NoDupRegsActs(acts)
        && TRM.GmInBounds(gm, |inp.pref| + |inp.next|)
        ensures ClosedGm(leaf.1)
      {
        FirstLeafClosedRecAux(rer, acts, inp, b, t, gm, leaf, D - 1);
      }
    }
  }

  /** THE depth-k first-leaf closedness (the L4 extraction feed). */
  lemma FirstLeafClosedRec(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                           b: BS.LoopBool, t: LT.Tree, gm: LG.GroupMap, leaf: LT.Leaf, D: nat)
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    requires EL.PikeLkActionsRec(acts) && FwdPosActsL(acts)
    requires NestDepthActsLe(acts, D)
    requires OpenOf(gm) <= PendingCloses(acts)
    requires LT.TreeRes(t, gm, inp, WP.Forward) == Some(leaf)
    requires LkClosedInGm(gm, acts)
    requires OuterLkDisjoint(acts)
    requires NoDupRegsActs(acts)
    requires TRM.GmInBounds(gm, |inp.pref| + |inp.next|)
    ensures ClosedGm(leaf.1)
  {
    ClosedBelowAll(rer, D);
    FirstLeafClosedRecAux(rer, acts, inp, b, t, gm, leaf, D);
  }


  /** The value-confinement predicate (S-ii core): every SETTLED inside-look
      group (`g in S`, `g` present in `gm`, `g`'s look no longer pending in
      `acts`) has its `gm` value preserved into the final leaf. */
  ghost predicate ValConf(gm: LG.GroupMap, acts: LS.Actions, leaf: LT.Leaf, S: set<LG.GroupId>) {
    forall g :: g in gm && g in S && g !in LkBodyGroupsActs(acts) ==>
                  g in leaf.1 && leaf.1[g] == gm[g]
  }

  /** One induction step of `ValConf`: given the child holds `ValConf` and each
      settled `S`-group agrees (`gm2[g]==gm[g]`, still settled in `sub`), the
      parent holds `ValConf`. Pure bookkeeping — isolates the per-case bridge. */
  lemma ConfineStep(gm: LG.GroupMap, gm2: LG.GroupMap, acts: LS.Actions, sub: LS.Actions,
                    leaf: LT.Leaf, S: set<LG.GroupId>)
    requires ValConf(gm2, sub, leaf, S)
    requires forall g :: g in gm && g in S && g !in LkBodyGroupsActs(acts) ==>
                           g in gm2 && gm2[g] == gm[g] && g !in LkBodyGroupsActs(sub)
    ensures ValConf(gm, acts, leaf, S)
  {}

  /** S-ii value-confinement least-lemma: the value analogue of
      `FirstLeafClosed`. Same recursion / same invariants (so `TailInv`/`SubInv`/
      `QuantSubInv`/`QuantSubInvCheck` are reused), but ALSO concludes `ValConf`:
      a settled inside-look group's value survives to the leaf. The LK case leans
      on `LL.GmConfinedLeaves` (the look writes only its OWN groups `S_look`, so a
      settled `g !in S_look` passes through); the Quant `GMReset` case uses the
      `DefGroups = DefGroupsOutside (+) LkBodyGroups` split (a settled `S`-group in
      `DefGroups(r1)` would be pending, contradiction). Vacuous at `gm==Empty`; an
      existential-extraction layer turns it into the per-look leaf-value equality
      the else-branch consumes. */
  least lemma FirstLeafValueConfined(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                                     b: BS.LoopBool, t: LT.Tree, gm: LG.GroupMap, leaf: LT.Leaf,
                                     S: set<LG.GroupId>)
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    requires EL.PikeLkActions(acts)
    requires OpenOf(gm) <= PendingCloses(acts)
    requires LT.TreeRes(t, gm, inp, WP.Forward) == Some(leaf)
    requires LkClosedInGm(gm, acts)
    requires OuterLkDisjoint(acts)
    requires forall g :: g in S ==> g !in OuterDefsActs(acts)   // S = inside-look groups
    requires NoDupRegsActs(acts)                // L3b: each pending regex has dup-free groups (for NoDupG)
    requires TRM.GmInBounds(gm, |inp.pref| + |inp.next|)   // L3b: gm ranges within input (for the mirror)
    ensures ClosedGm(leaf.1)
    ensures ValConf(gm, acts, leaf, S)
  {
    var n := |inp.pref| + |inp.next|;
    if |acts| == 0 {
      assert t == LT.Match;
      assert leaf.1 == gm;
      assert PendingCloses(acts) == {};
      forall g | g in gm ensures gm[g].endIdx.Some? {
        if gm[g].endIdx.None? { assert g in OpenOf(gm); }
      }
      assert LkBodyGroupsActs(acts) == {};
    } else {
      var cont := acts[1..];
      assert forall i :: 0 <= i < |cont| ==> cont[i] == acts[i + 1];
      assert PendingCloses(cont) <= PendingCloses(acts);
      assert NoDupRegsActs(cont) by { forall i | 0 <= i < |cont| ensures cont[i].Areg? ==> NoDupSeq(L.DefGroups(cont[i].r)) { assert cont[i] == acts[i + 1]; } }
      match acts[0]
      case Acheck(strcheck) =>
        if b == BS.CanExit {
          assert t.Progress?;
          assert PendingCloses(acts) == PendingCloses(cont);
          TailInv(gm, gm, acts);
          assert LkBodyGroupsActs(acts) == LkBodyGroupsActs(cont);   // Acheck contributes {}
          FirstLeafValueConfined(rer, cont, inp, BS.CanExit, t.t, gm, leaf, S);
          ConfineStep(gm, gm, acts, cont, leaf, S);
        } else {
          assert t == LT.Mismatch;
          assert false;
        }
      case Aclose(gid) =>
        assert t.GroupActionT? && t.g == LG.Close(gid);
        var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
        assert gm2 == LG.GMClose(LC.Idx(inp), gid, gm);
        assert OpenOf(gm2) <= PendingCloses(cont) by {
          forall g | g in OpenOf(gm2) ensures g in PendingCloses(cont) {
            assert g != gid;
            assert g in OpenOf(gm);
            assert g in PendingCloses(acts);
            var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == g;
            assert i != 0;
            assert cont[i - 1] == acts[i];
          }
        }
        assert forall g :: g in gm2 ==> g in gm && (gm2[g].endIdx.Some? || gm2[g] == gm[g]);
        TailInv(gm, gm2, acts);
        assert gid in OuterDefsActs(acts);
        assert LkBodyGroupsActs(acts) == LkBodyGroupsActs(cont);   // Aclose contributes {}
        assert TRM.GmInBounds(gm2, n) by { assert LC.Idx(inp) <= n; }
        FirstLeafValueConfined(rer, cont, inp, b, t.t, gm2, leaf, S);
        assert forall g :: g in gm && g in S && g !in LkBodyGroupsActs(acts) ==>
                             g in gm2 && gm2[g] == gm[g] && g !in LkBodyGroupsActs(cont)
        by { forall g | g in gm && g in S && g !in LkBodyGroupsActs(acts) ensures g != gid { } }
        ConfineStep(gm, gm2, acts, cont, leaf, S);
      case Areg(r) =>
        match r
        case Epsilon =>
          assert PendingCloses(acts) == PendingCloses(cont);
          TailInv(gm, gm, acts);
          assert LkBodyGroupsActs(acts) == LkBodyGroupsActs(cont);
          FirstLeafValueConfined(rer, cont, inp, b, t, gm, leaf, S);
          ConfineStep(gm, gm, acts, cont, leaf, S);
        case Character(cd) =>
          if LC.ReadChar(rer, cd, inp, WP.Forward).None? {
            assert t == LT.Mismatch;
            assert false;
          } else {
            var pair := LC.ReadChar(rer, cd, inp, WP.Forward).value;
            assert t.Read?;
            assert pair.1 == LC.AdvanceInputP(inp, WP.Forward);
            assert |pair.1.pref| + |pair.1.next| == n;   // advance preserves total length
            assert PendingCloses(acts) == PendingCloses(cont);
            TailInv(gm, gm, acts);
            assert LkBodyGroupsActs(acts) == LkBodyGroupsActs(cont);
            FirstLeafValueConfined(rer, cont, pair.1, BS.CanExit, t.t, gm, leaf, S);
            ConfineStep(gm, gm, acts, cont, leaf, S);
          }
        case Disjunction(r1, r2) =>
          assert t.Choice?;
          var acts1 := [LS.Areg(r1)] + cont;
          var acts2 := [LS.Areg(r2)] + cont;
          assert PendingCloses(acts1) == PendingCloses(cont) == PendingCloses(acts2) by {
            assert forall i :: 0 <= i < |cont| ==> acts1[i + 1] == cont[i] && acts2[i + 1] == cont[i];
          }
          assert PendingCloses(acts) == PendingCloses(cont);
          LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), cont); LkBodyGroupsActsCons(LS.Areg(r2), cont);
          OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), cont); OuterDefsActsCons(LS.Areg(r2), cont);
          assert LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) + LL.LkBodyGroups(r2);
          assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2);
          assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
          NoDupConcat(L.DefGroups(r1), L.DefGroups(r2));
          assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i == 0 {} else { assert acts1[i] == cont[i - 1]; } } }
          assert NoDupRegsActs(acts2) by { forall i | 0 <= i < |acts2| ensures acts2[i].Areg? ==> NoDupSeq(L.DefGroups(acts2[i].r)) { if i == 0 {} else { assert acts2[i] == cont[i - 1]; } } }
          if LT.TreeRes(t.t1, gm, inp, WP.Forward).Some? {
            SubInv(gm, gm, acts1, acts);
            FirstLeafValueConfined(rer, acts1, inp, b, t.t1, gm, leaf, S);
            ConfineStep(gm, gm, acts, acts1, leaf, S);
          } else {
            SubInv(gm, gm, acts2, acts);
            FirstLeafValueConfined(rer, acts2, inp, b, t.t2, gm, leaf, S);
            ConfineStep(gm, gm, acts, acts2, leaf, S);
          }
        case Sequence(r1, r2) =>
          var acts1 := [LS.Areg(r1), LS.Areg(r2)] + cont;
          assert PendingCloses(acts1) == PendingCloses(cont) by {
            assert forall i :: 0 <= i < |cont| ==> acts1[i + 2] == cont[i];
          }
          assert PendingCloses(acts) == PendingCloses(cont);
          assert acts1 == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
          LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont); LkBodyGroupsActsCons(LS.Areg(r2), cont);
          OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont); OuterDefsActsCons(LS.Areg(r2), cont);
          assert LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) + LL.LkBodyGroups(r2);
          assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2);
          assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
          NoDupConcat(L.DefGroups(r1), L.DefGroups(r2));
          assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
          SubInv(gm, gm, acts1, acts);
          FirstLeafValueConfined(rer, acts1, inp, b, t, gm, leaf, S);
          ConfineStep(gm, gm, acts, acts1, leaf, S);
        case Quantified(greedy, min, delta, r1) =>
          var gidl := L.DefGroups(r1);
          if min > 0 {
            assert t.GroupActionT? && t.g == LG.Reset(gidl);
            var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
            assert gm2 == LG.GMReset(gidl, gm);
            assert OpenOf(gm2) <= OpenOf(gm);
            assert forall g :: g in gm2 ==> g in gm && gm2[g] == gm[g];
            var q' := L.Quantified(greedy, min - 1, delta, r1);
            var acts1 := [LS.Areg(r1), LS.Areg(q')] + cont;
            assert PendingCloses(acts1) == PendingCloses(cont) by {
              assert forall i :: 0 <= i < |cont| ==> acts1[i + 2] == cont[i];
            }
            assert PendingCloses(acts) == PendingCloses(cont);
            assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) && L.DefGroups(q') == L.DefGroups(r1);
            assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
            assert TRM.GmInBounds(gm2, n);   // GMReset only shrinks the domain
            QuantSubInv(gm, gm2, r, r1, q', cont, acts, acts1);
            QuantConfBridge(r, r1, q', gm, cont, acts, acts1, S);
            FirstLeafValueConfined(rer, acts1, inp, b, t.t, gm2, leaf, S);
            assert forall g :: g in gm && g in S && g !in LkBodyGroupsActs(acts) ==>
                                 g in gm2 && gm2[g] == gm[g] && g !in LkBodyGroupsActs(acts1)
            by {
              forall g | g in gm && g in S && g !in LkBodyGroupsActs(acts) ensures g !in gidl {
                QuantSettledNotReset(r, r1, cont, acts, S, g);
              }
            }
            ConfineStep(gm, gm2, acts, acts1, leaf, S);
          } else if delta == LN.NN(0) {
            assert PendingCloses(acts) == PendingCloses(cont);
            TailInv(gm, gm, acts);
            LkBodyGroupsActsCons(LS.Areg(r), cont);
            FirstLeafValueConfined(rer, cont, inp, b, t, gm, leaf, S);
            ConfineStep(gm, gm, acts, cont, leaf, S);
          } else {
            assert t.Choice?;
            var itert := if greedy then t.t1 else t.t2;
            var skipt := if greedy then t.t2 else t.t1;
            assert itert.GroupActionT? && itert.g == LG.Reset(gidl);
            assert PendingCloses(acts) == PendingCloses(cont);
            if LT.TreeRes(t.t1, gm, inp, WP.Forward).Some? {
              if greedy {
                var gm2 := LG.GMUpdate(itert.g, LC.Idx(inp), gm);
                assert gm2 == LG.GMReset(gidl, gm);
                assert OpenOf(gm2) <= OpenOf(gm);
                assert forall g :: g in gm2 ==> g in gm && gm2[g] == gm[g];
                var q'' := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
                var acts1 := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q'')] + cont;
                assert PendingCloses(acts1) == PendingCloses(cont) by {
                  assert forall i :: 0 <= i < |cont| ==> acts1[i + 3] == cont[i];
                }
                assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) && L.DefGroups(q'') == L.DefGroups(r1);
                assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 3 {} else { assert acts1[i] == cont[i - 3]; } } }
                assert TRM.GmInBounds(gm2, n);
                QuantSubInvCheck(gm, gm2, r, r1, q'', inp, cont, acts, acts1);
                QuantCheckConfBridge(r, r1, q'', inp, gm, cont, acts, acts1, S);
                FirstLeafValueConfined(rer, acts1, inp, BS.CannotExit, itert.t, gm2, leaf, S);
                assert forall g :: g in gm && g in S && g !in LkBodyGroupsActs(acts) ==>
                                     g in gm2 && gm2[g] == gm[g] && g !in LkBodyGroupsActs(acts1)
                by {
                  forall g | g in gm && g in S && g !in LkBodyGroupsActs(acts) ensures g !in gidl {
                    QuantSettledNotReset(r, r1, cont, acts, S, g);
                  }
                }
                ConfineStep(gm, gm2, acts, acts1, leaf, S);
              } else {
                TailInv(gm, gm, acts);
                LkBodyGroupsActsCons(LS.Areg(r), cont);
                FirstLeafValueConfined(rer, cont, inp, b, skipt, gm, leaf, S);
                ConfineStep(gm, gm, acts, cont, leaf, S);
              }
            } else {
              if greedy {
                TailInv(gm, gm, acts);
                LkBodyGroupsActsCons(LS.Areg(r), cont);
                FirstLeafValueConfined(rer, cont, inp, b, skipt, gm, leaf, S);
                ConfineStep(gm, gm, acts, cont, leaf, S);
              } else {
                var gm2 := LG.GMUpdate(itert.g, LC.Idx(inp), gm);
                assert gm2 == LG.GMReset(gidl, gm);
                assert OpenOf(gm2) <= OpenOf(gm);
                assert forall g :: g in gm2 ==> g in gm && gm2[g] == gm[g];
                var q'' := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
                var acts1 := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q'')] + cont;
                assert PendingCloses(acts1) == PendingCloses(cont) by {
                  assert forall i :: 0 <= i < |cont| ==> acts1[i + 3] == cont[i];
                }
                assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == L.DefGroups(r1) && L.DefGroups(q'') == L.DefGroups(r1);
                assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 3 {} else { assert acts1[i] == cont[i - 3]; } } }
                assert TRM.GmInBounds(gm2, n);
                QuantSubInvCheck(gm, gm2, r, r1, q'', inp, cont, acts, acts1);
                QuantCheckConfBridge(r, r1, q'', inp, gm, cont, acts, acts1, S);
                FirstLeafValueConfined(rer, acts1, inp, BS.CannotExit, itert.t, gm2, leaf, S);
                assert forall g :: g in gm && g in S && g !in LkBodyGroupsActs(acts) ==>
                                     g in gm2 && gm2[g] == gm[g] && g !in LkBodyGroupsActs(acts1)
                by {
                  forall g | g in gm && g in S && g !in LkBodyGroupsActs(acts) ensures g !in gidl {
                    QuantSettledNotReset(r, r1, cont, acts, S, g);
                  }
                }
                ConfineStep(gm, gm2, acts, acts1, leaf, S);
              }
            }
          }
        case Group(gid, r1) =>
          assert t.GroupActionT? && t.g == LG.Open(gid);
          var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
          assert gm2 == LG.GMOpen(LC.Idx(inp), gid, gm);
          var acts1 := [LS.Areg(r1), LS.Aclose(gid)] + cont;
          assert gid in PendingCloses(acts1) by { assert acts1[1].Aclose? && acts1[1].gid == gid; }
          assert OpenOf(gm2) <= PendingCloses(acts1) by {
            forall g | g in OpenOf(gm2) ensures g in PendingCloses(acts1) {
              if g != gid {
                assert g in OpenOf(gm);
                assert g in PendingCloses(acts);
                var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == g;
                assert i != 0;
                assert acts1[i + 1] == cont[i - 1] == acts[i];
              }
            }
          }
          assert acts1 == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
          LkBodyGroupsActsCons(LS.Areg(r), cont); LkBodyGroupsActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont); LkBodyGroupsActsCons(LS.Aclose(gid), cont);
          OuterDefsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont); OuterDefsActsCons(LS.Aclose(gid), cont);
          assert L.DefGroups(r) == [gid] + L.DefGroups(r1);
          assert gid in OuterDefsActs(acts) && gid !in LkBodyGroupsActs(acts);
          assert LkBodyGroupsActs(acts1) == LkBodyGroupsActs(acts);
          assert LkClosedInGm(gm2, acts1) by {
            forall g | g in gm2 && g in LkBodyGroupsActs(acts1) ensures gm2[g].endIdx.Some? {
              assert g != gid; assert g in gm && g in LkBodyGroupsActs(acts);
            }
          }
          assert OuterLkDisjoint(acts1);
          assert forall g :: g in S ==> g !in OuterDefsActs(acts1);
          assert NoDupSeq(L.DefGroups(r)) && L.DefGroups(r) == [gid] + L.DefGroups(r1);
          NoDupTailSeq([gid], L.DefGroups(r1));   // drop the leading [gid] ⇒ NoDupSeq(DefGroups(r1))
          assert NoDupRegsActs(acts1) by { forall i | 0 <= i < |acts1| ensures acts1[i].Areg? ==> NoDupSeq(L.DefGroups(acts1[i].r)) { if i < 2 {} else { assert acts1[i] == cont[i - 2]; } } }
          assert TRM.GmInBounds(gm2, n) by { assert LC.Idx(inp) <= n; }
          FirstLeafValueConfined(rer, acts1, inp, b, t.t, gm2, leaf, S);
          assert forall g :: g in gm && g in S && g !in LkBodyGroupsActs(acts) ==>
                               g in gm2 && gm2[g] == gm[g] && g !in LkBodyGroupsActs(acts1)
          by { forall g | g in gm && g in S && g !in LkBodyGroupsActs(acts) ensures g != gid { } }
          ConfineStep(gm, gm2, acts, acts1, leaf, S);
        case AnchorR(a) =>
          if LS.AnchorSatisfied(rer, a, inp) {
            assert t.AnchorPass?;
            assert PendingCloses(acts) == PendingCloses(cont);
            TailInv(gm, gm, acts);
            LkBodyGroupsActsCons(LS.Areg(r), cont);
            FirstLeafValueConfined(rer, cont, inp, b, t.t, gm, leaf, S);
            ConfineStep(gm, gm, acts, cont, leaf, S);
          } else {
            assert t == LT.Mismatch;
            assert false;
          }
        case LookaroundR(lk, r1) =>
          var Slook := (set g | g in L.DefGroups(r1));
          match t {
            case LK(lk2, tlk, tc) =>
              assert PendingCloses(acts) == PendingCloses(cont);
              assert EL.LkGateOk(rer, lk, r1, inp, tlk, true) && EL.BoolTreeLk(rer, cont, inp, b, tc);
              assert tlk == FU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
              assert EL.PikeLkRegex(r);
              var dir := L.LkDir(lk);
              LkBodyGroupsActsCons(LS.Areg(r), cont); OuterDefsActsCons(LS.Areg(r), cont);
              assert L.DefGroups(r) == L.DefGroups(r1);
              assert LL.LkBodyGroups(r) == Slook + LL.LkBodyGroups(r1);
              assert Slook <= LkBodyGroupsActs(acts);
              assert LkBodyGroupsActs(cont) <= LkBodyGroupsActs(acts);
              assert OuterDefsActs(cont) <= OuterDefsActs(acts);
              // L3a/L3b: a POSITIVE look (fwd/bwd) may capture -> NoLkBrL body from
              // the widened PikeLkRegex; a NEGATIVE look is group-free. (The old
              // `DefGroups(r1) != [] ==> dir == Forward` "only lookaheads capture"
              // conjunct is retired for L3b -- lookbehinds capture too.)
              assert EL.NoLkBrL(r1) && EL.PikeLkRegex(r1) by {
                if L.Positivity(lk) { NoLkBrImpliesPikeLk(r1); }
                else { assert SD.GroupFreeL(r1); LL.GroupFreeLkBodyEmpty(r1); GroupFreeImpliesNoLkBr(r1); NoLkBrImpliesPikeLk(r1); }
              }
              assert OuterLkDisjoint(cont);
              assert forall g :: g in S ==> g !in OuterDefsActs(cont);
              if L.Positivity(lk) {
                assert forall g :: g in gm && g in Slook ==> gm[g].endIdx.Some? by {
                  forall g | g in gm && g in Slook ensures gm[g].endIdx.Some? { assert g in LkBodyGroupsActs(acts); }
                }
                var sub := LT.TreeLeaves(tlk, gm, inp, dir);
                LT.FirstTreeLeaf(tlk, gm, inp, dir);
                assert |sub| > 0;
                // L3b NoDupG: DefGroups(r)==DefGroups(r1); NoDupRegsActs(acts) ⇒ NoDupSeq(DefGroups(r1)).
                assert NoDupSeq(L.DefGroups(r1)) by { assert NoDupSeq(L.DefGroups(r)); assert L.DefGroups(r) == L.DefGroups(r1); }
                NoDupSeqIsNoDupG(L.DefGroups(r1));
                LookBodyLeafOpenSub(rer, lk, r1, tlk, gm, inp, sub, Slook);
                assert LT.TreeRes(tc, sub[0].1, inp, WP.Forward) == Some(leaf);
                assert LkClosedInGm(sub[0].1, cont) by {
                  forall g | g in sub[0].1 && g in LkBodyGroupsActs(cont) ensures sub[0].1[g].endIdx.Some? {
                    if g in Slook {} else { assert g in gm; assert g in LkBodyGroupsActs(acts); assert g !in OpenOf(gm); assert g !in OpenOf(sub[0].1); }
                  }
                }
                // gm2 = sub[0].1 agrees with gm OUTSIDE Slook (the look writes only its own groups)
                assert LL.DefGroupsIn(r1, Slook);
                LL.ComputeTrConfined(rer, r1, inp, LG.Empty, dir, Slook);
                LL.GmConfinedLeaves(tlk, gm, inp, dir, Slook);
                FirstLeafValueConfined(rer, cont, inp, b, tc, sub[0].1, leaf, S);
                assert forall g :: g in gm && g in S && g !in LkBodyGroupsActs(acts) ==>
                                     g in sub[0].1 && sub[0].1[g] == gm[g] && g !in LkBodyGroupsActs(cont)
                by {
                  forall g | g in gm && g in S && g !in LkBodyGroupsActs(acts)
                    ensures g in sub[0].1 && sub[0].1[g] == gm[g]
                  { assert g !in Slook; assert LL.GmAgreeOutside(sub[0].1, gm, Slook); }
                }
                ConfineStep(gm, sub[0].1, acts, cont, leaf, S);
              } else {
                assert LT.TreeRes(tc, gm, inp, WP.Forward) == Some(leaf);
                assert LkClosedInGm(gm, cont) by {
                  forall g | g in gm && g in LkBodyGroupsActs(cont) ensures gm[g].endIdx.Some? { assert g in LkBodyGroupsActs(acts); }
                }
                FirstLeafValueConfined(rer, cont, inp, b, tc, gm, leaf, S);
                ConfineStep(gm, gm, acts, cont, leaf, S);
              }
            case LKFail(lk2, tlk) =>
              assert false;
            case _ =>
          }
        case Backreference(_) =>
          assert false;
    }
  }

  /** Quant `min>0` reset bridge: `LkBodyGroupsActs(acts1) == LkBodyGroupsActs(acts)`
      when `acts = [Areg(Quant r1)] + cont` and `acts1 = [Areg(r1), Areg(q')] + cont`
      with `q' = Quant(...,r1)` (both contribute `LkBodyGroups(r1)`). */
  lemma QuantConfBridge(r: L.Regex, r1: L.Regex, q': L.Regex, gm: LG.GroupMap,
                        cont: LS.Actions, acts: LS.Actions, acts1: LS.Actions, S: set<LG.GroupId>)
    requires r.Quantified? && r.r1 == r1 && q'.Quantified? && q'.r1 == r1
    requires acts == [LS.Areg(r)] + cont && acts1 == [LS.Areg(r1), LS.Areg(q')] + cont
    requires forall g :: g in S ==> g !in OuterDefsActs(acts)
    ensures LkBodyGroupsActs(acts1) == LkBodyGroupsActs(acts)
    ensures forall g :: g in S ==> g !in OuterDefsActs(acts1)
  {
    assert acts1 == [LS.Areg(r1)] + ([LS.Areg(q')] + cont);
    LkBodyGroupsActsCons(LS.Areg(r), cont);
    LkBodyGroupsActsCons(LS.Areg(r1), [LS.Areg(q')] + cont);
    LkBodyGroupsActsCons(LS.Areg(q'), cont);
    OuterDefsActsCons(LS.Areg(r), cont);
    OuterDefsActsCons(LS.Areg(r1), [LS.Areg(q')] + cont);
    OuterDefsActsCons(LS.Areg(q'), cont);
    assert LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) && LL.LkBodyGroups(q') == LL.LkBodyGroups(r1);
    assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) && DefGroupsOutsideLooksL(q') == DefGroupsOutsideLooksL(r1);
    assert LkBodyGroupsActs(acts1) == LkBodyGroupsActs(acts);
    assert OuterDefsActs(acts1) == OuterDefsActs(acts);
  }

  /** Quant `min==0` Choice reset bridge (with the `Acheck`): same as
      `QuantConfBridge` but `acts1 = [Areg(r1), Acheck, Areg(q'')] + cont`. */
  lemma QuantCheckConfBridge(r: L.Regex, r1: L.Regex, q'': L.Regex, inp: LC.Input, gm: LG.GroupMap,
                             cont: LS.Actions, acts: LS.Actions, acts1: LS.Actions, S: set<LG.GroupId>)
    requires r.Quantified? && r.r1 == r1 && q''.Quantified? && q''.r1 == r1
    requires acts == [LS.Areg(r)] + cont && acts1 == [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q'')] + cont
    requires forall g :: g in S ==> g !in OuterDefsActs(acts)
    ensures LkBodyGroupsActs(acts1) == LkBodyGroupsActs(acts)
    ensures forall g :: g in S ==> g !in OuterDefsActs(acts1)
  {
    assert acts1 == [LS.Areg(r1)] + ([LS.Acheck(inp), LS.Areg(q'')] + cont);
    assert [LS.Acheck(inp), LS.Areg(q'')] + cont == [LS.Acheck(inp)] + ([LS.Areg(q'')] + cont);
    LkBodyGroupsActsCons(LS.Areg(r), cont);
    LkBodyGroupsActsCons(LS.Areg(r1), [LS.Acheck(inp), LS.Areg(q'')] + cont);
    LkBodyGroupsActsCons(LS.Acheck(inp), [LS.Areg(q'')] + cont);
    LkBodyGroupsActsCons(LS.Areg(q''), cont);
    OuterDefsActsCons(LS.Areg(r), cont);
    OuterDefsActsCons(LS.Areg(r1), [LS.Acheck(inp), LS.Areg(q'')] + cont);
    OuterDefsActsCons(LS.Acheck(inp), [LS.Areg(q'')] + cont);
    OuterDefsActsCons(LS.Areg(q''), cont);
    assert LL.LkBodyGroups(r) == LL.LkBodyGroups(r1) && LL.LkBodyGroups(q'') == LL.LkBodyGroups(r1);
    assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) && DefGroupsOutsideLooksL(q'') == DefGroupsOutsideLooksL(r1);
    assert LkBodyGroupsActs(acts1) == LkBodyGroupsActs(acts);
    assert OuterDefsActs(acts1) == OuterDefsActs(acts);
  }

  // ==========================================================================
  // Final-thread facts: the register wf and quant finality of the RESULT
  // thread, composed over FFindMatch's position loop from the per-phase
  // preservation lemmas. What the extraction reads off the winning thread.
  // ==========================================================================
  /** Threads register well-formedness (`ThreadRegsWf`), clock monotonicity
      (from `ClockMono`), and `QuantRegsFinal` through `FFindMatch`'s whole
      scan of the input, so the winning thread — if any — satisfies all three
      at the end. */
  lemma FFindMatchThreadFacts(c: RB.code, str: string, s: AI.VmState, ov: LOr.OracleView,
                              dir: LAnc.direction, cdn: LCdn.cdns,
                              ncap: int, nlook: int, nquant: int)
    requires |s.processed.true_set| == RB.size(c) && |s.processed.false_set| == RB.size(c)
    requires dir == LAnc.Forward
    requires s.context.nextchar == AI.get_char(str, s.cp)
    requires forall pc: nat, q: int, b: bool ::
               NR.GetPcRE(c, pc) == Some(RB.SetQuantToClock(q, b)) ==> !b
    requires s.clock >= 0 && s.cp >= 0
    requires CM.VmClocksLE(s)
    requires CM.VmRegsWf(s, ncap, nlook, nquant)
    requires VmQuantFinal(s)
    ensures var r := AI.FFindMatch(c, str, s, ov, dir, cdn).0;
            r.Some? ==> CM.ThreadRegsWf(r.value, ncap, nlook, nquant) && QuantRegsFinal(r.value)
    decreases |str| - s.cp
  {
    var s0 := s.(cdn := LCdn.build_cdn_v(cdn, s.cp, ov, s.context, dir));
    assert CM.VmClocksLE(s0) && CM.VmRegsWf(s0, ncap, nlook, nquant) && VmQuantFinal(s0);
    CM.FAdvanceEpsilonClocksLE(c, s0, ov, dir);
    CM.FAdvanceEpsilonRegsWf(c, s0, ov, dir, ncap, nlook, nquant);
    FAdvanceEpsilonQuantFinal(c, s0, ov, dir);
    var (s1, ov1) := AI.FAdvanceEpsilon(c, s0, ov, dir);
    assert s1.cp == s.cp && s1.context == s.context;
    assert s1.clock >= s0.clock >= 0;

    if |s1.blocked| == 0 {
      assert AI.FFindMatch(c, str, s, ov, dir, cdn).0 == s1.bestmatch;
    } else if s1.context.nextchar.None? {
      assert AI.FFindMatch(c, str, s, ov, dir, cdn).0 == s1.bestmatch;
    } else {
      assert AI.get_char(str, s.cp).Some?;
      assert 0 <= s.cp < |str|;
      CM.FConsumeClocksLE(s1);
      CM.FConsumeRegsWf(s1, ncap, nlook, nquant);
      FConsumeQuantFinal(s1);
      var s2 := AI.FConsume(s1);
      var s3 := s2.(processed := AI.init_bpcset(RB.size(c)), isblocked := AI.init_pcset(RB.size(c)),
      cdn := LCdn.init_cdn(), cp := AI.incr_cp(s2.cp, dir));
      var newchar := AI.get_char(str, s3.cp - AI.cp_offset(dir));
      var s4 := s3.(context := LAnc.update_context(s3.context, newchar));
      assert s4.cp == s.cp + 1;
      assert s4.context.nextchar == AI.get_char(str, s4.cp);
      assert CM.VmClocksLE(s4) by {
        assert s4.active == s2.active && s4.blocked == s2.blocked
               && s4.bestmatch == s2.bestmatch && s4.clock == s2.clock;
      }
      assert CM.VmRegsWf(s4, ncap, nlook, nquant) by {
        assert s4.active == s2.active && s4.blocked == s2.blocked && s4.bestmatch == s2.bestmatch;
      }
      assert VmQuantFinal(s4) by {
        assert s4.active == s2.active && s4.blocked == s2.blocked && s4.bestmatch == s2.bestmatch;
      }
      assert s4.clock == s2.clock == s1.clock >= 0;
      FFindMatchThreadFacts(c, str, s4, ov1, dir, cdn, ncap, nlook, nquant);
      assert AI.FFindMatch(c, str, s, ov, dir, cdn) == AI.FFindMatch(c, str, s4, ov1, dir, cdn);
    }
  }

  /** A whole search preserves register WELL-FORMEDNESS (`ThreadRegsWf` -- array
      lengths `ncap`/`nlook`/`nquant` and `CapRegWf`). Unlike `FFindMatchThreadFacts`
      this needs NO clock bound (`FAdvanceEpsilon/FConsumeRegsWf` want only
      `clock >= 0`), so it applies to the ACTUAL FLookLoop replay from a threaded
      `cap` whose clocks may exceed 0 -- pinning the fold's register lengths. */
  lemma FFindMatchRegsWf(c: RB.code, str: string, s: AI.VmState, ov: LOr.OracleView,
                         dir: LAnc.direction, cdn: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    requires |s.processed.true_set| == RB.size(c) && |s.processed.false_set| == RB.size(c)
    requires dir.Forward? ==> s.context.nextchar == AI.get_char(str, s.cp)
    requires dir.Backward? ==> s.context.nextchar == AI.get_char(str, s.cp - 1)
    requires s.clock >= 0 && s.cp >= 0
    requires CM.VmRegsWf(s, ncap, nlook, nquant)
    ensures var r := AI.FFindMatch(c, str, s, ov, dir, cdn).0;
            r.Some? ==> CM.ThreadRegsWf(r.value, ncap, nlook, nquant)
    decreases if dir.Forward? then |str| - s.cp else s.cp
  {
    var s0 := s.(cdn := LCdn.build_cdn_v(cdn, s.cp, ov, s.context, dir));
    assert CM.VmRegsWf(s0, ncap, nlook, nquant);
    CM.FAdvanceEpsilonClockGrows(c, s0, ov, dir);
    CM.FAdvanceEpsilonRegsWf(c, s0, ov, dir, ncap, nlook, nquant);
    var (s1, ov1) := AI.FAdvanceEpsilon(c, s0, ov, dir);
    assert s1.cp == s.cp && s1.context == s.context;
    assert s1.clock >= s0.clock >= 0;
    if |s1.blocked| == 0 {
      assert AI.FFindMatch(c, str, s, ov, dir, cdn).0 == s1.bestmatch;
    } else if s1.context.nextchar.None? {
      assert AI.FFindMatch(c, str, s, ov, dir, cdn).0 == s1.bestmatch;
    } else {
      CM.FConsumeRegsWf(s1, ncap, nlook, nquant);
      var s2 := AI.FConsume(s1);
      var s3 := s2.(processed := AI.init_bpcset(RB.size(c)), isblocked := AI.init_pcset(RB.size(c)),
      cdn := LCdn.init_cdn(), cp := AI.incr_cp(s2.cp, dir));
      var newchar := AI.get_char(str, s3.cp - AI.cp_offset(dir));
      var s4 := s3.(context := LAnc.update_context(s3.context, newchar));
      assert CM.VmRegsWf(s4, ncap, nlook, nquant) by {
        assert s4.active == s2.active && s4.blocked == s2.blocked && s4.bestmatch == s2.bestmatch;
      }
      assert s4.clock == s2.clock == s1.clock >= 0;
      FFindMatchRegsWf(c, str, s4, ov1, dir, cdn, ncap, nlook, nquant);
      assert AI.FFindMatch(c, str, s, ov, dir, cdn) == AI.FFindMatch(c, str, s4, ov1, dir, cdn);
    }
  }

  // ==========================================================================
  // The QMap builder: qid |-> DefGroups(Translate(body)), per quant node.
  // ==========================================================================
  /** Builds the quantifier half of the `AR.QMap` for `re`: maps each quant id
      to the capture groups defined by its body (`L.DefGroups` of the translated
      body), by walking `re`'s quant nodes. The lookaround half is built
      separately (`OE.LmOf`) and the two are paired at the assembly. */
  ghost function QmOfRE(re: R.regex): map<int, LG.GroupSet>
    requires T.TransWf(re)
    decreases re
  {
    match re
    case Re_empty => map[]
    case Re_character(_) => map[]
    case Re_anchor(_) => map[]
    case Re_alt(r1, r2) => QmOfRE(r1) + QmOfRE(r2)
    case Re_con(r1, r2) => QmOfRE(r1) + QmOfRE(r2)
    case Re_quant(nul, qid, q, r1) => QmOfRE(r1)[qid := L.DefGroups(T.Translate(r1))]
    case Re_capture(_, r1) => QmOfRE(r1)
    case Re_lookaround(_, _, r1) => QmOfRE(r1)
  }

  /** Builds the lookaround half of the `AR.QMap` for `re`: maps each
      lookaround id to its translated flavour and body — the link
      `CheckOracle(lid)` erases. (`LmapOk` for it needs lid uniqueness, the
      `LT.LookUnique` analogue of `PIV.QuantUnique`; the current top-level
      gate is lookaround-free, where `AR.PlusFragmentLmapOk` discharges
      `LmapOk` outright.) */
  /** `LmOf(lazy_prefix(ast))` is `LmOf(ast)`: the prefix is a quantified
      any-char, which registers no lookaround row. Lets the entry lemmas, which
      are stated about the compiled ast, apply to the table built for `re`. */
  lemma LmOfLazyPrefix(ast: R.regex)
    requires T.TransWf(R.lazy_prefix(ast)) && T.TransWf(ast)
    ensures OE.LmOf(R.lazy_prefix(ast)) == OE.LmOf(ast)
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert R.lazy_prefix(ast) == R.Re_con(pre, ast);
    OE.LookFreeLmOfEmpty(pre);
    assert map[] + OE.LmOf(ast) == OE.LmOf(ast);
  }


  /** `QmOfRE(re)`'s domain is exactly `re`'s quant ids (`PIV.QuantIds`). */
  lemma QmOfREDom(re: R.regex)
    requires T.TransWf(re) && PIV.QuantUnique(re)
    ensures forall k: int :: k in QmOfRE(re) <==> (k >= 0 && (k as nat) in PIV.QuantIds(re))
    decreases re
  {
    match re
    case Re_empty => case Re_character(_) => case Re_anchor(_) =>
    case Re_alt(r1, r2) => QmOfREDom(r1); QmOfREDom(r2);
    case Re_con(r1, r2) => QmOfREDom(r1); QmOfREDom(r2);
    case Re_quant(nul, qid, q, r1) => QmOfREDom(r1);
    case Re_capture(_, r1) => QmOfREDom(r1);
    case Re_lookaround(_, _, r1) => QmOfREDom(r1);
  }

  /** The body of any quant node inside a well-formed `re` (`T.TransWf`) is
      itself well-formed. */
  lemma TransWfQidBody(re: R.regex, qid: nat)
    requires T.TransWf(re)
    requires qid in PIV.QuantIds(re)
    ensures T.TransWf(PIV.QidBody(re, qid))
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if qid in PIV.QuantIds(r1) { TransWfQidBody(r1, qid); } else { TransWfQidBody(r2, qid); }
    case Re_con(r1, r2) =>
      if qid in PIV.QuantIds(r1) { TransWfQidBody(r1, qid); } else { TransWfQidBody(r2, qid); }
    case Re_quant(nul, qid0, q, r1) =>
      if qid0 >= 0 && (qid0 as nat) == qid {} else { TransWfQidBody(r1, qid); }
    case Re_capture(_, r1) => TransWfQidBody(r1, qid);
    case Re_lookaround(_, _, r1) => TransWfQidBody(r1, qid);
  }

  /** Each entry of `QmOfRE(re)` really is the def-groups of that quant id's
      body, provided quant ids are unique (`PIV.QuantUnique`). */
  lemma QmOfREEntries(re: R.regex)
    requires T.TransWf(re) && PIV.QuantUnique(re)
    ensures forall qid: nat :: qid in PIV.QuantIds(re) && T.TransWf(PIV.QidBody(re, qid)) ==>
                                 (qid as int) in QmOfRE(re)
                                 && QmOfRE(re)[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(re, qid)))
    decreases re
  {
    match re
    case Re_empty => case Re_character(_) => case Re_anchor(_) =>
    case Re_alt(r1, r2) =>
      QmOfREEntries(r1); QmOfREEntries(r2);
      QmOfREDom(r1); QmOfREDom(r2);
      forall qid: nat | qid in PIV.QuantIds(re) && T.TransWf(PIV.QidBody(re, qid))
        ensures (qid as int) in QmOfRE(re)
                && QmOfRE(re)[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(re, qid)))
      {
        if qid in PIV.QuantIds(r1) {
          assert qid !in PIV.QuantIds(r2) by {
            if qid in PIV.QuantIds(r2) { assert qid in PIV.QuantIds(r1) * PIV.QuantIds(r2); }
          }
          assert (qid as int) !in QmOfRE(r2);
        } else {
          assert qid in PIV.QuantIds(r2);
        }
      }
    case Re_con(r1, r2) =>
      QmOfREEntries(r1); QmOfREEntries(r2);
      QmOfREDom(r1); QmOfREDom(r2);
      forall qid: nat | qid in PIV.QuantIds(re) && T.TransWf(PIV.QidBody(re, qid))
        ensures (qid as int) in QmOfRE(re)
                && QmOfRE(re)[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(re, qid)))
      {
        if qid in PIV.QuantIds(r1) {
          assert qid !in PIV.QuantIds(r2) by {
            if qid in PIV.QuantIds(r2) { assert qid in PIV.QuantIds(r1) * PIV.QuantIds(r2); }
          }
          assert (qid as int) !in QmOfRE(r2);
        } else {
          assert qid in PIV.QuantIds(r2);
        }
      }
    case Re_quant(nul, qid0, q, r1) =>
      QmOfREEntries(r1);
      QmOfREDom(r1);
      assert qid0 >= 0;                                 // QuantUnique
      forall qid: nat | qid in PIV.QuantIds(re) && T.TransWf(PIV.QidBody(re, qid))
        ensures (qid as int) in QmOfRE(re)
                && QmOfRE(re)[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(re, qid)))
      {
        if (qid0 as nat) == qid {
          assert PIV.QidBody(re, qid) == r1;
        } else {
          assert qid in PIV.QuantIds(r1);
          assert (qid as int) != qid0;
        }
      }
    case Re_capture(_, r1) => QmOfREEntries(r1);
    case Re_lookaround(_, _, r1) => QmOfREEntries(r1);
  }

  /** Reconstructs `AR.QmapOk` for a candidate map `qm` from the pointwise
      entry facts `QmOfREEntries` establishes — the bridge from `QmOfRE`'s
      definition to the `QmapOk` precondition the simulation layer requires. */
  lemma QmapOkFromEntries(re: R.regex, qm: AR.QMap)
    requires T.TransWf(re) && PIV.QuantUnique(re)
    requires forall qid: nat :: qid in PIV.QuantIds(re) && T.TransWf(PIV.QidBody(re, qid)) ==>
                                  (qid as int) in qm.quants && qm.quants[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(re, qid)))
    ensures AR.QmapOk(re, qm)
    decreases re
  {
    match re
    case Re_empty => case Re_character(_) => case Re_anchor(_) =>
    case Re_alt(r1, r2) =>
      forall qid: nat | qid in PIV.QuantIds(r1) && T.TransWf(PIV.QidBody(r1, qid))
        ensures (qid as int) in qm.quants && qm.quants[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(r1, qid)))
      {
        assert qid in PIV.QuantIds(re);
        TransWfQidBody(re, qid);
        assert PIV.QidBody(re, qid) == PIV.QidBody(r1, qid);
      }
      QmapOkFromEntries(r1, qm);
      forall qid: nat | qid in PIV.QuantIds(r2) && T.TransWf(PIV.QidBody(r2, qid))
        ensures (qid as int) in qm.quants && qm.quants[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(r2, qid)))
      {
        assert qid in PIV.QuantIds(re);
        TransWfQidBody(re, qid);
        assert qid !in PIV.QuantIds(r1) by {
          if qid in PIV.QuantIds(r1) { assert qid in PIV.QuantIds(r1) * PIV.QuantIds(r2); }
        }
        assert PIV.QidBody(re, qid) == PIV.QidBody(r2, qid);
      }
      QmapOkFromEntries(r2, qm);
    case Re_con(r1, r2) =>
      forall qid: nat | qid in PIV.QuantIds(r1) && T.TransWf(PIV.QidBody(r1, qid))
        ensures (qid as int) in qm.quants && qm.quants[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(r1, qid)))
      {
        assert qid in PIV.QuantIds(re);
        TransWfQidBody(re, qid);
        assert PIV.QidBody(re, qid) == PIV.QidBody(r1, qid);
      }
      QmapOkFromEntries(r1, qm);
      forall qid: nat | qid in PIV.QuantIds(r2) && T.TransWf(PIV.QidBody(r2, qid))
        ensures (qid as int) in qm.quants && qm.quants[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(r2, qid)))
      {
        assert qid in PIV.QuantIds(re);
        TransWfQidBody(re, qid);
        assert qid !in PIV.QuantIds(r1) by {
          if qid in PIV.QuantIds(r1) { assert qid in PIV.QuantIds(r1) * PIV.QuantIds(r2); }
        }
        assert PIV.QidBody(re, qid) == PIV.QidBody(r2, qid);
      }
      QmapOkFromEntries(r2, qm);
    case Re_quant(nul, qid0, q, r1) =>
      assert qid0 >= 0;                                 // QuantUnique
      assert (qid0 as nat) in PIV.QuantIds(re);
      assert PIV.QidBody(re, qid0 as nat) == r1;
      assert qid0 in qm.quants && qm.quants[qid0] == L.DefGroups(T.Translate(r1));
      forall qid: nat | qid in PIV.QuantIds(r1) && T.TransWf(PIV.QidBody(r1, qid))
        ensures (qid as int) in qm.quants && qm.quants[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(r1, qid)))
      {
        assert qid in PIV.QuantIds(re);
        TransWfQidBody(re, qid);
        assert (qid0 as nat) != qid by { assert (qid0 as nat) !in PIV.QuantIds(r1); }
        assert PIV.QidBody(re, qid) == PIV.QidBody(r1, qid);
      }
      QmapOkFromEntries(r1, qm);
    case Re_capture(_, r1) =>
      forall qid: nat | qid in PIV.QuantIds(r1) && T.TransWf(PIV.QidBody(r1, qid))
        ensures (qid as int) in qm.quants && qm.quants[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(r1, qid)))
      {
        assert qid in PIV.QuantIds(re);
        TransWfQidBody(re, qid);
        assert PIV.QidBody(re, qid) == PIV.QidBody(r1, qid);
      }
      QmapOkFromEntries(r1, qm);
    case Re_lookaround(_, _, r1) =>
      forall qid: nat | qid in PIV.QuantIds(r1) && T.TransWf(PIV.QidBody(r1, qid))
        ensures (qid as int) in qm.quants && qm.quants[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(r1, qid)))
      {
        assert qid in PIV.QuantIds(re);
        TransWfQidBody(re, qid);
        assert PIV.QidBody(re, qid) == PIV.QidBody(r1, qid);
      }
      QmapOkFromEntries(r1, qm);
  }

  // ==========================================================================
  // Compile-pipeline frames for the fragment.
  // ==========================================================================
  /** `CP.FCompileExtra` (the lookaround-compilation pass) leaves the main
      ast/bytecode/cdns fields of an `FCompiled` untouched on fragment
      regexes (which contain no lookarounds). */
  lemma FCompileExtraFrame(r: R.regex, c: CP.FCompiled)
    requires NR.LookBehindFragmentRE(r)
    ensures CP.FCompileExtra(r, c).f_main_ast == c.f_main_ast
    ensures CP.FCompileExtra(r, c).f_main_bc == c.f_main_bc
    ensures CP.FCompileExtra(r, c).f_main_cdns == c.f_main_cdns
    decreases r
  {
    match r
    case Re_empty => case Re_character(_) => case Re_anchor(_) =>
    case Re_capture(_, r1) => FCompileExtraFrame(r1, c);
    case Re_alt(r1, r2) => FCompileExtraFrame(r1, c); FCompileExtraFrame(r2, CP.FCompileExtra(r1, c));
    case Re_con(r1, r2) => FCompileExtraFrame(r1, c); FCompileExtraFrame(r2, CP.FCompileExtra(r1, c));
    case Re_quant(nul, qid, quant, r1) =>
      var c1 := if quant.min > 0 && quant.max == None && nul != R.NonNullable && quant.greedy
      then c.(f_plus_bc := CP.upd(c.f_plus_bc, qid, CP.compile_reconstruct_nulled(r1)))
      else c;
      FCompileExtraFrame(r1, c1);
    case Re_lookaround(lid, la, body) =>
      // reachable under the widened gate: the five updates write only the LOOK
      // tables, and the recursion into `body` leaves the main fields alone too
      var c1 := c.(f_look_types := CP.upd(c.f_look_types, lid, la));
      var c2 := c1.(f_look_cdns := CP.upd(c1.f_look_cdns, lid, LCdn.compile_cdns(body)));
      var c3 := c2.(f_look_ast := CP.upd(c2.f_look_ast, lid, body));
      var c4 := c3.(f_look_build_bc :=
      CP.upd(c3.f_look_build_bc, lid,
             CP.compile_to_write(CP.oracle_regex(la, body), lid)));
      var c5 := c4.(f_look_capture_bc :=
      CP.upd(c4.f_look_capture_bc, lid,
             CP.compile_to_bytecode(CP.capture_regex(la, body))));
      NR.PlusIsLookBehindFragmentRE(body);
      FCompileExtraFrame(body, c5);
  }

  /** `CP.FCompileExtra` also leaves the plus-reconstruction bytecode table
      untouched on fragment regexes. */
  lemma FCompileExtraPlusFrame(r: R.regex, c: CP.FCompiled)
    requires NR.PlusFragmentRE(r)
    ensures CP.FCompileExtra(r, c).f_plus_bc == c.f_plus_bc
    decreases r
  {
    match r
    case Re_empty => case Re_character(_) => case Re_anchor(_) =>
    case Re_capture(_, r1) => FCompileExtraPlusFrame(r1, c);
    case Re_alt(r1, r2) => FCompileExtraPlusFrame(r1, c); FCompileExtraPlusFrame(r2, CP.FCompileExtra(r1, c));
    case Re_con(r1, r2) => FCompileExtraPlusFrame(r1, c); FCompileExtraPlusFrame(r2, CP.FCompileExtra(r1, c));
    case Re_quant(nul, qid, quant, r1) =>
      // plus fragment: an unbounded min > 0 quant carries the NonNullable
      // annotation, so the greedy-nullable-+ table update never fires
      assert quant.min > 0 && quant.max == None ==> nul == R.NonNullable;
      FCompileExtraPlusFrame(r1, c);
    case Re_lookaround(_, _, _) =>
  }

  /** A star-fragment regex (`NR.StarFragmentRE`) contains no lookarounds:
      `R.max_lookaround` is `0`. */
  lemma FragmentMaxLook(re: R.regex)
    requires NR.PlusFragmentRE(re)
    ensures R.max_lookaround(re) == 0
    decreases re
  {
    match re
    case Re_empty => case Re_character(_) => case Re_anchor(_) =>
    case Re_alt(r1, r2) => FragmentMaxLook(r1); FragmentMaxLook(r2);
    case Re_con(r1, r2) => FragmentMaxLook(r1); FragmentMaxLook(r2);
    case Re_quant(_, _, _, r1) => FragmentMaxLook(r1);
    case Re_capture(_, r1) => FragmentMaxLook(r1);
    case Re_lookaround(_, _, _) =>
  }

  // ==========================================================================
  // ======================  T H E   M A I N   T H E O R E M  ================
  // RegElk's functional engine meets the Linden/Warblre tree specification on
  // the star fragment. Every call below is a previously verified lemma.
  // ==========================================================================
  /** ==== THE PINNACLE CORRECTNESS THEOREM ====
      RegElk's compiled, executable matcher (`AI.FFullMatch`) agrees with the
      Linden/Warblre reference semantics (`LES.MatcherSpec`) on every
      star-fragment regex over Latin-1-well-formed input. Assembles the whole
      pipeline: compile the regex, run the simulation (`PSM.FindMatchSimRE`)
      to pin the winning VM thread to the spec's first leaf, then hand off to
      `MainExtraction` to show the two answers denote the same result. */
  // NO {:isolate_assertions}: with the `hide` bridges below (the ThreadRegsWf
  // restatement and the MainExtraction call), the monolithic VC verifies in
  // ~49s, against 6m35s for ~1200 isolated batches. The previous campaign left
  // this exact question open; measured, the bridges win.
  /** The static lookaround package: everything about the lookaround tables
      and the built oracle that `MainTheorem` consumes, derived in a MINIMAL
      context. `LmapOk`, `OracleOkSuffix` and `ActionsRepL` are large
      quantified predicates. Under the plus gate they were nearly free
      (`qm.looks == map[]` made the oracle hypothesis vacuous); once the gate
      admits real lookbehinds the main lemma has to DERIVE them, and doing that
      inline ran the VC past 900s. Established here, consumed as opaque facts
      there. */
  lemma LookStaticPackage(raw: R.raw_regex, str: string, qm: AR.QMap)
    requires NR.LookBehindFragmentRaw(raw) && T.Latin1Wf(raw)
    // listed first so the `qm` clause below is well-formed: QmOfRE / LmOf are
    // partial on TransWf, and a precondition cannot call AnnotateWf itself
    requires T.TransWf(R.annotate(raw)) && T.TransWf(R.lazy_prefix(R.annotate(raw)))
    requires qm == AR.QMap(QmOfRE(R.lazy_prefix(R.annotate(raw))),
                           OE.LmOf(R.lazy_prefix(R.annotate(raw))),
                           AI.FBuildOracle(CP.FFullCompilation(R.annotate(raw)), str))
    ensures var re := R.lazy_prefix(R.annotate(raw));
            AR.QmapOk(re, qm) && AR.LmapOk(re, qm)
            && LL.OracleOkSuffix(LES.TheRer(raw), qm, LC.InitInput(str))
            && AR.ActionsRepL(LES.TheRer(raw), qm, [LS.Areg(T.Translate(re))],
                              CP.compile_to_bytecode(re), 0)
  {
    var ast := R.annotate(raw);
    var re := R.lazy_prefix(ast);
    var rer := LES.TheRer(raw);
    T.AnnotateWf(raw);
    NR.SpecRegexLookBehindFragment(raw);
    LTB.SpecRegexLookUnique(raw);
    assert NR.LookBehindFragmentRE(ast);
    PIV.SpecRegexQuantUnique(raw);
    QmOfREEntries(re);
    QmapOkFromEntries(re, qm);
    OE.LmapOkOfLmOf(re, qm);
    LmOfLazyPrefix(ast);
    assert qm.looks == OE.LmOf(ast);
    OE.OracleOkFromColumns(rer, ast, str, qm);
    AR.CompileToBytecodeActionsRepLookBehind(rer, qm, re);
  }

  // ===========================================================================
  // §4b: run the simulation on a body from an ARBITRARY start position `cp`.
  // ===========================================================================
  //
  // `MainTheorem` runs `InitialPikeInvFullRE` + `FindMatchSimRE` from cp==0 to
  // pin the whole-regex answer to the spec first leaf. For a captured lookahead
  // (§4b) the *body* is matched from the lookaround's recorded position `cp`,
  // with FRESH registers, so we need the same pin at an arbitrary `cp`. This is
  // now bounded: `FindMatchSimRE` was always written cp-generically (it decreases
  // `|str| - vms.cp` and uses `vms.cp` abstractly), and the only piece hard-coded
  // to cp==0 was the entry invariant — now generalized as
  // `InitialPikeInvFullREAtCp`. The bridge from the search trace to the checked
  // tree's first leaf (`TrcREToLinden` -> `TreeRepPikeSubtree` -> `InitPiketreeInv`
  // -> `PikeTreeTrcCorrect`) needs only `PikeSubtree(tstar)`, so the checked tree
  // enters only through `TreeThreadRE`/`TreeRepRE` hypotheses.
  /** The cp-generalized simulation pin: from the entry state at `cp` (fresh
      registers), the best-match thread of `FFindMatch` corresponds to the
      body's checked-tree first leaf at `InpOfCp(str, cp)`. The `cp==0` special
      case is the core of `MainTheorem`'s extraction; this is the reusable form
      the captured-lookahead body match needs. */
  lemma FindMatchBodyAtCp(
    rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat,
    ngroups: nat, str: string, cp: nat, tstar: LT.Tree, ov: LOr.OracleView,
    cdns: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires TT.TreeThreadRE(rer, qm, bodycode, PIV.InpOfCp(str, cp), tstar, 0, false)
    requires TR.TreeRepRE(qm, tstar, bodycode, 0, PIV.InpOfCp(str, cp), false)
    ensures var inp := PIV.InpOfCp(str, cp);
            var inits := AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                       AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward));
            PIV.BestMatchRE(body, bestT, AI.FFindMatch(bodycode, str, inits, ov, LAnc.Forward, cdns).0)
            && bestT == LT.FirstLeaf(tstar, inp)
  {
    var inp := PIV.InpOfCp(str, cp);
    var ctx := AI.cp_context(cp, str, LAnc.Forward);
    var capture := AReg.init_regs(ncap);
    var look := AReg.init_regs(nlook);
    var quant := AReg.init_regs(nquant);
    var inits := AI.FInitState(bodycode, cp, capture, look, quant, 0, ctx);

    // Entry invariant at cp (fresh registers) -> the full simulation invariant.
    PSM.InitialPikeInvFullREAtCp(rer, qm, body, bodycode, endl, ngroups, str, cp, tstar,
                                 inits, ncap, nlook, nquant);
    var pts0 := PT.PikeTreeInitialState(tstar, inp);
    assert ctx.nextchar == AI.get_char(str, cp);        // cp_context definitional
    bestT := PSM.FindMatchSimRE(rer, qm, body, bodycode, endl, ngroups, str, pts0, inits,
                                ov, LAnc.Forward, cdns, ncap, nlook, nquant);
    assert PSM.TrcRE(pts0, PT.PTS_final(bestT));
    assert PIV.BestMatchRE(body, bestT, AI.FFindMatch(bodycode, str, inits, ov, LAnc.Forward, cdns).0);

    // Pin bestT to the checked tree's first leaf.
    TrcREToLinden(pts0, PT.PTS_final(bestT));
    TR.TreeRepPikeSubtree(qm, tstar, bodycode, 0, inp, false);
    PT.InitPiketreeInv(tstar, inp);
    CR.PikeTreeTrcCorrect(pts0, PT.PTS_final(bestT), LT.FirstLeaf(tstar, inp));
    assert bestT == LT.FirstLeaf(tstar, inp);
  }

  /** L4 depth-k (ADDITIVE): `FindMatchBodyAtCp` under the nested fragment.
      Verbatim `FindMatchBodyAtCp` with `StaticOkRE -> StaticOkNestedRE`, the
      entry establisher `InitialPikeInvFullREAtCp -> ...Nested`, and the
      simulation `FindMatchSimRE -> FindMatchSimRENested` (Phase 1). This runs a
      NESTED-fragment body's forward match from `cp` through the depth-k sim and
      pins the answer to the checked tree's first leaf — the engine half of the
      depth-k keystone STEP, now unblocked by Phase 1. The tree-correctness
      callees (`TrcREToLinden`/`TreeRepPikeSubtree`/`InitPiketreeInv`/
      `PikeTreeTrcCorrect`) are depth-blind. */
  lemma FindMatchBodyAtCpNested(
    rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat,
    ngroups: nat, str: string, cp: nat, tstar: LT.Tree, ov: LOr.OracleView,
    cdns: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkNestedRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires TT.TreeThreadRE(rer, qm, bodycode, PIV.InpOfCp(str, cp), tstar, 0, false)
    requires TR.TreeRepRE(qm, tstar, bodycode, 0, PIV.InpOfCp(str, cp), false)
    ensures var inp := PIV.InpOfCp(str, cp);
            var inits := AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                       AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward));
            PIV.BestMatchRE(body, bestT, AI.FFindMatch(bodycode, str, inits, ov, LAnc.Forward, cdns).0)
            && bestT == LT.FirstLeaf(tstar, inp)
  {
    var inp := PIV.InpOfCp(str, cp);
    var ctx := AI.cp_context(cp, str, LAnc.Forward);
    var capture := AReg.init_regs(ncap);
    var look := AReg.init_regs(nlook);
    var quant := AReg.init_regs(nquant);
    var inits := AI.FInitState(bodycode, cp, capture, look, quant, 0, ctx);

    // Entry invariant at cp (fresh registers) -> the full simulation invariant.
    PSM.InitialPikeInvFullREAtCpNested(rer, qm, body, bodycode, endl, ngroups, str, cp, tstar,
                                       inits, ncap, nlook, nquant);
    var pts0 := PT.PikeTreeInitialState(tstar, inp);
    assert ctx.nextchar == AI.get_char(str, cp);
    bestT := PSM.FindMatchSimRENested(rer, qm, body, bodycode, endl, ngroups, str, pts0, inits,
                                      ov, LAnc.Forward, cdns, ncap, nlook, nquant);
    assert PSM.TrcRE(pts0, PT.PTS_final(bestT));
    assert PIV.BestMatchRE(body, bestT, AI.FFindMatch(bodycode, str, inits, ov, LAnc.Forward, cdns).0);

    // Pin bestT to the checked tree's first leaf.
    TrcREToLinden(pts0, PT.PTS_final(bestT));
    TR.TreeRepPikeSubtree(qm, tstar, bodycode, 0, inp, false);
    PT.InitPiketreeInv(tstar, inp);
    CR.PikeTreeTrcCorrect(pts0, PT.PTS_final(bestT), LT.FirstLeaf(tstar, inp));
    assert bestT == LT.FirstLeaf(tstar, inp);
  }

  /** §4b, the tree-construction port: for a fragment `body` (a look-free
      capturing plus-fragment is in `LookBehindFragmentRE`, since its
      `Re_lookaround` case — which still bans captures — never fires), the body
      match from position `cp` corresponds to the body's SPEC first leaf at
      `InpOfCp(str, cp)`. This discharges `FindMatchBodyAtCp`'s `tstar`
      hypotheses by BUILDING the checked tree (mirroring `MainTheorem`'s
      1140-1166 entry construction at `body`/`cp` instead of the whole regex at
      0), so the caller need only supply the static package + the oracle
      correctness at `cp`. `TreeThreadRE` is definitionally `TreeRepRE`
      (TreeThreadRE.dfy:56), so the one tree built serves both hypotheses. */
  lemma BodyTreeAtCp(
    rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat,
    ngroups: nat, str: string, cp: nat, ov: LOr.OracleView,
    cdns: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires NR.LookFreeRE(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    ensures var inp := PIV.InpOfCp(str, cp);
            var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, LG.Empty, WP.Forward);
            var inits := AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                       AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward));
            PIV.BestMatchRE(body, bestT, AI.FFindMatch(bodycode, str, inits, ov, LAnc.Forward, cdns).0)
            && bestT == LT.FirstLeaf(t, inp)
  {
    var inp := PIV.InpOfCp(str, cp);
    var acts := [LS.Areg(T.Translate(body))];

    // ---- the spec tree ---------------------------------------------------
    LFU.ComputeTrIsTree(rer, acts, inp, LG.Empty, WP.Forward);
    var t := LFU.ComputeTr(rer, acts, inp, LG.Empty, WP.Forward);
    assert LS.IsTree(rer, acts, inp, LG.Empty, WP.Forward, t);
    EL.TranslateFragmentPikeLk(body);          // PikeLkRegex(Translate(body))
    EL.BooleanCorrectLk(rer, T.Translate(body), inp, t);
    assert forall i :: 0 <= i < |acts| ==> !acts[i].Acheck?;
    BoolTreeLbIrrel(rer, acts, inp, BS.CanExit, BS.CannotExit, t);

    // ---- the CHECKED tree the simulation runs on -------------------------
    WOE.WalkOkEntry(body);
    assert EL.PikeLkActions(acts) by {
      assert acts == acts + [];
      assert EL.PikeLkActions([]);
      EL.PikeLkActionsConsIff(LS.Areg(T.Translate(body)), []);
    }
    assert WO.WalkOk(acts, bodycode, 0, ATR.EaOf(BS.CannotExit));
    AR.CompileToBytecodeActionsRepLookBehind(rer, qm, body);   // ActionsRepL
    // The body is look-free, so its walk has no lookaround at all: the tree is
    // `LkConfinedTree(_, {})` for the trivial (empty) inside-look set.
    EL.TranslateNoLkBr(body);                                   // NoLkBrL(Translate(body))
    assert LL.LkActsInS(acts, {}) by { LL.NoLkBrLkBodiesInS(T.Translate(body), {}); }
    LL.ComputeTrLkConfined(rer, acts, inp, LG.Empty, WP.Forward, {});   // LkConfinedTree(t, {})
    var tstar := ATR.ActionsTreeRepRE(rer, qm, acts, bodycode, 0, inp, BS.CannotExit, t, {});
    assert TR.TreeRepRE(qm, tstar, bodycode, 0, inp, false);
    LL.LeavesAgreeAtOutsideEmpty(tstar, t, inp);               // Outside({}) -> full LeavesAgreeAt
    LL.LAAtFirstLeaf(tstar, t, inp);
    assert LT.FirstLeaf(tstar, inp) == LT.FirstLeaf(t, inp);

    // TreeThreadRE is definitionally TreeRepRE, so the checked tree discharges
    // both of FindMatchBodyAtCp's tree hypotheses.
    assert TT.TreeThreadRE(rer, qm, bodycode, inp, tstar, 0, false);

    // ---- run the simulation at cp ----------------------------------------
    bestT := FindMatchBodyAtCp(rer, qm, body, bodycode, endl, ngroups, str, cp, tstar,
                               ov, cdns, ncap, nlook, nquant);
    assert bestT == LT.FirstLeaf(tstar, inp) == LT.FirstLeaf(t, inp);
  }

  /** §4b, the tree-construction port GENERALIZED off `LookFreeRE(body)` to the
      CAPTURING-lookaround (depth-1) case — the confinement swap the L4 spec-half
      needs. `BodyTreeAtCp` bakes in `LookFreeRE(body)` and builds the checked
      tree at the EMPTY inside-look set `{}` (so its leaves agree with the spec
      tree EVERYWHERE, giving raw `FirstLeaf` equality). Here `body` may contain
      capturing lookarounds, so the checked tree's leaves agree with the spec tree
      only OUTSIDE `S := LkBodyGroups(Translate(body))` (the groups captured inside
      lookaround bodies): the `{}`-confinement chain (`TranslateNoLkBr` →
      `LkActsInS(_,{})` → `ComputeTrLkConfined(_,{})`) becomes the `S`-chain
      (`LkBodyGroupsConfines` → `LkActsInS(_,S)` → `ComputeTrLkConfined(_,S)`), and
      `LeavesAgreeAtOutsideEmpty` + raw `FirstLeaf` equality becomes
      `FirstLeafAgreeOutside` (`GmAgreeOutside(bestT.1, FirstLeaf(t).1, S)`).

      SCOPE (honest): the retained `PSM.StaticOkRE(qm, body, ...)` requirement
      DEFINITIONALLY contains `LookBehindFragmentRE(body)` (PikeSimRE.dfy:99),
      which caps `NestDepth(body) <= 1` (see `LookBehindFragmentDepth1`). So this
      lifts `BodyTreeAtCp` from look-free to depth-1 CAPTURING looks — exactly what
      the current confinement predicates support (`GmConfinedTree` bans nested LK
      nodes: `LK(_,_,_) => false`, CheckErase.dfy). Genuine (depth >= 2) nesting
      additionally needs the engine confinement/compilation stack — `StaticOkRE`,
      `NfaRepRE`, `PikeLkRegex`, `GmConfinedTree`/`LkConfinedTree`,
      `ComputeTrLkConfined`, `ActionsTreeRepRE` — generalized off the depth-1
      fragment, which is the ENGINE half, disjoint from this SPEC brick. */
  lemma BodyTreeAtCpLk(
    rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat,
    ngroups: nat, str: string, cp: nat, ov: LOr.OracleView,
    cdns: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    ensures var inp := PIV.InpOfCp(str, cp);
            var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, LG.Empty, WP.Forward);
            var S := LL.LkBodyGroups(T.Translate(body));
            var inits := AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                       AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward));
            PIV.BestMatchRE(body, bestT, AI.FFindMatch(bodycode, str, inits, ov, LAnc.Forward, cdns).0)
            && (bestT.None? <==> LT.FirstLeaf(t, inp).None?)
            && (bestT.Some? ==>
                  LT.FirstLeaf(t, inp).Some?
                  && bestT.value.0 == LT.FirstLeaf(t, inp).value.0
                  && LL.GmAgreeOutside(bestT.value.1, LT.FirstLeaf(t, inp).value.1, S))
  {
    var inp := PIV.InpOfCp(str, cp);
    var acts := [LS.Areg(T.Translate(body))];
    var S := LL.LkBodyGroups(T.Translate(body));

    // ---- the spec tree ---------------------------------------------------
    LFU.ComputeTrIsTree(rer, acts, inp, LG.Empty, WP.Forward);
    var t := LFU.ComputeTr(rer, acts, inp, LG.Empty, WP.Forward);
    assert LS.IsTree(rer, acts, inp, LG.Empty, WP.Forward, t);
    EL.TranslateFragmentPikeLk(body);          // PikeLkRegex(Translate(body))
    EL.BooleanCorrectLk(rer, T.Translate(body), inp, t);
    assert forall i :: 0 <= i < |acts| ==> !acts[i].Acheck?;
    BoolTreeLbIrrel(rer, acts, inp, BS.CanExit, BS.CannotExit, t);

    // ---- the CHECKED tree the simulation runs on -------------------------
    WOE.WalkOkEntry(body);
    assert EL.PikeLkActions(acts) by {
      assert acts == acts + [];
      assert EL.PikeLkActions([]);
      EL.PikeLkActionsConsIff(LS.Areg(T.Translate(body)), []);
    }
    assert WO.WalkOk(acts, bodycode, 0, ATR.EaOf(BS.CannotExit));
    AR.CompileToBytecodeActionsRepLookBehind(rer, qm, body);   // ActionsRepL
    // `body` may now hold CAPTURING lookarounds: the spec tree's LK bodies confine
    // to `S = LkBodyGroups(Translate(body))`, so the tree is `LkConfinedTree(_, S)`.
    LL.LkBodyGroupsConfines(T.Translate(body), S);             // LkBodiesInS(Translate(body), S)
    assert LL.LkActsInS(acts, S) by { LL.LkActsInSCons(LS.Areg(T.Translate(body)), [], S); }
    LL.ComputeTrLkConfined(rer, acts, inp, LG.Empty, WP.Forward, S);   // LkConfinedTree(t, S)
    var tstar := ATR.ActionsTreeRepRE(rer, qm, acts, bodycode, 0, inp, BS.CannotExit, t, S);
    assert TR.TreeRepRE(qm, tstar, bodycode, 0, inp, false);
    // ActionsTreeRepRE ensures LeavesAgreeAtOutside(tstar, t, inp, S); lift to FirstLeaf.
    LL.FirstLeafAgreeOutside(tstar, t, inp, S);

    // TreeThreadRE is definitionally TreeRepRE, so the checked tree discharges
    // both of FindMatchBodyAtCp's tree hypotheses.
    assert TT.TreeThreadRE(rer, qm, bodycode, inp, tstar, 0, false);

    // ---- run the simulation at cp ----------------------------------------
    bestT := FindMatchBodyAtCp(rer, qm, body, bodycode, endl, ngroups, str, cp, tstar,
                               ov, cdns, ncap, nlook, nquant);
    assert bestT == LT.FirstLeaf(tstar, inp);
    // FirstLeafAgreeOutside(tstar, t, S): same success/position, gms agree outside S.
  }

  /** L4 depth-k (ADDITIVE): the nested-fragment analogue of `BodyTreeAtCpLk`.
      A NESTED-fragment `body` (positive looks may nest to any depth; negative
      look bodies stay look-free, `NegLooksLookFreeRE`) has its forward body
      match from `cp` pinned to the spec first leaf OUTSIDE `S =
      LkBodyGroups(Translate(body))`. Builds the checked tree via the depth-k
      chain (`WalkOkEntryNested` / `CompileToBytecodeActionsRepNested` /
      `TranslateFragmentPikeLkRec` / `BooleanCorrectLkRec` / `ComputeTrLkConfinedK`
      / `ActionsTreeRepRENested`) and runs the depth-k simulation via
      `FindMatchBodyAtCpNested`. This is the SPEC/ENGINE-bridge half of the
      depth-k keystone STEP. */
  lemma BodyTreeAtCpNested(
    rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat,
    ngroups: nat, str: string, cp: nat, ov: LOr.OracleView,
    cdns: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkNestedRE(qm, body, bodycode, endl)
    requires NR.NegLooksLookFreeRE(body)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    ensures var inp := PIV.InpOfCp(str, cp);
            var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, LG.Empty, WP.Forward);
            var S := LL.LkBodyGroups(T.Translate(body));
            var inits := AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                       AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward));
            PIV.BestMatchRE(body, bestT, AI.FFindMatch(bodycode, str, inits, ov, LAnc.Forward, cdns).0)
            && (bestT.None? <==> LT.FirstLeaf(t, inp).None?)
            && (bestT.Some? ==>
                  LT.FirstLeaf(t, inp).Some?
                  && bestT.value.0 == LT.FirstLeaf(t, inp).value.0
                  && LL.GmAgreeOutside(bestT.value.1, LT.FirstLeaf(t, inp).value.1, S))
  {
    var inp := PIV.InpOfCp(str, cp);
    var acts := [LS.Areg(T.Translate(body))];
    var S := LL.LkBodyGroups(T.Translate(body));

    // ---- the spec tree ---------------------------------------------------
    LFU.ComputeTrIsTree(rer, acts, inp, LG.Empty, WP.Forward);
    var t := LFU.ComputeTr(rer, acts, inp, LG.Empty, WP.Forward);
    assert LS.IsTree(rer, acts, inp, LG.Empty, WP.Forward, t);
    EL.TranslateFragmentPikeLkRec(body);          // PikeLkRegex(Translate(body))
    EL.BooleanCorrectLkRec(rer, T.Translate(body), inp, t);
    assert forall i :: 0 <= i < |acts| ==> !acts[i].Acheck?;
    BoolTreeLbIrrel(rer, acts, inp, BS.CanExit, BS.CannotExit, t);

    // ---- the CHECKED tree the simulation runs on -------------------------
    WOE.WalkOkEntryNested(body);
    assert EL.PikeLkActionsRec(acts) by {
      assert acts == acts + [];
      assert EL.PikeLkActionsRec([]);
      EL.PikeLkActionsRecConsIff(LS.Areg(T.Translate(body)), []);
    }
    assert WO.WalkOk(acts, bodycode, 0, ATR.EaOf(BS.CannotExit));
    AR.CompileToBytecodeActionsRepNested(rer, qm, body);   // ActionsRepL
    // `body` may now hold CAPTURING lookarounds: the spec tree's LK bodies confine
    // to `S = LkBodyGroups(Translate(body))`, so the tree is `LkConfinedTree(_, S)`.
    LL.LkBodyGroupsConfines(T.Translate(body), S);             // LkBodiesInS(Translate(body), S)
    assert LL.LkActsInS(acts, S) by { LL.LkActsInSCons(LS.Areg(T.Translate(body)), [], S); }
    LL.ComputeTrLkConfinedK(rer, acts, inp, LG.Empty, WP.Forward, S);   // LkConfinedTree(t, S)
    var tstar := ATR.ActionsTreeRepRENested(rer, qm, acts, bodycode, 0, inp, BS.CannotExit, t, S);
    assert TR.TreeRepRE(qm, tstar, bodycode, 0, inp, false);
    // ActionsTreeRepRE ensures LeavesAgreeAtOutside(tstar, t, inp, S); lift to FirstLeaf.
    LL.FirstLeafAgreeOutside(tstar, t, inp, S);

    // TreeThreadRE is definitionally TreeRepRE, so the checked tree discharges
    // both of FindMatchBodyAtCpNested's tree hypotheses.
    assert TT.TreeThreadRE(rer, qm, bodycode, inp, tstar, 0, false);

    // ---- run the simulation at cp ----------------------------------------
    bestT := FindMatchBodyAtCpNested(rer, qm, body, bodycode, endl, ngroups, str, cp, tstar,
                                     ov, cdns, ncap, nlook, nquant);
    assert bestT == LT.FirstLeaf(tstar, inp);
    // FirstLeafAgreeOutside(tstar, t, S): same success/position, gms agree outside S.
  }


  // {:isolate_assertions} is REQUIRED here, not a tuning knob. Admitting
  // lookaheads adds a second column-spec path and a second capture-regex
  // shape, and the combined VC runs past 900s. Isolated, every one of its
  // 1566 obligations passes and the lemma completes in ~10m. (Checked first
  // that no obligation FAILS -- twice in this campaign a widening turned a
  // true assertion false and presented as a timeout.)
  // FFullCompilation's main fields, derived in a MINIMAL context (the huge
  // FCompiled base literal must not leak into the main lemma's VCs).
  /** Pins down `CP.FFullCompilation`'s three fields that `MainTheorem` needs,
      computed in a minimal context so the large `FCompiled` base record
      doesn't leak into the caller's verification conditions. */
  lemma FFullCompilationFacts(ast: R.regex)
    requires NR.LookBehindFragmentRE(ast)
    ensures CP.FFullCompilation(ast).f_main_ast == ast
    ensures CP.FFullCompilation(ast).f_main_bc == CP.compile_to_bytecode(R.lazy_prefix(ast))
    ensures CP.FFullCompilation(ast).f_main_cdns == LCdn.compile_cdns(ast)
  {
    var nlook0 := R.max_lookaround(ast) + 1;
    var nquant0 := R.max_quant(ast) + 1;
    var base := CP.FCompiled(ast, CP.compile_to_bytecode(R.lazy_prefix(ast)), LCdn.compile_cdns(ast),
                             seq(nlook0, i => R.Lookahead), seq(nlook0, i => R.Re_empty),
                             seq(nlook0, i => []), seq(nlook0, i => []),
                             seq(nlook0, i => []), seq(nquant0, i => []));
    assert CP.FFullCompilation(ast) == CP.FCompileExtra(ast, base);
    FCompileExtraFrame(ast, base);
  }

  /** (L4 NESTED) The main-field frame of `FCompileExtra`, with NO fragment
      hypothesis. `FCompileExtra` only ever writes `f_plus_bc` (quant case) and
      the five `f_look_*` tables (lookaround case) — it never touches the three
      main fields — so the invariance holds for ANY regex, nested looks
      included. The depth-1 `FCompileExtraFrame` needed `LookBehindFragmentRE`
      only to recurse into a look body via `PlusIsLookBehindFragmentRE`; the
      recursion here just descends structurally, so the premise is dropped. */
  lemma FCompileExtraFrameAny(r: R.regex, c: CP.FCompiled)
    ensures CP.FCompileExtra(r, c).f_main_ast == c.f_main_ast
    ensures CP.FCompileExtra(r, c).f_main_bc == c.f_main_bc
    ensures CP.FCompileExtra(r, c).f_main_cdns == c.f_main_cdns
    decreases r
  {
    match r
    case Re_empty => case Re_character(_) => case Re_anchor(_) =>
    case Re_capture(_, r1) => FCompileExtraFrameAny(r1, c);
    case Re_alt(r1, r2) => FCompileExtraFrameAny(r1, c); FCompileExtraFrameAny(r2, CP.FCompileExtra(r1, c));
    case Re_con(r1, r2) => FCompileExtraFrameAny(r1, c); FCompileExtraFrameAny(r2, CP.FCompileExtra(r1, c));
    case Re_quant(nul, qid, quant, r1) =>
      var c1 := if quant.min > 0 && quant.max == None && nul != R.NonNullable && quant.greedy
      then c.(f_plus_bc := CP.upd(c.f_plus_bc, qid, CP.compile_reconstruct_nulled(r1)))
      else c;
      FCompileExtraFrameAny(r1, c1);
    case Re_lookaround(lid, la, body) =>
      var c1 := c.(f_look_types := CP.upd(c.f_look_types, lid, la));
      var c2 := c1.(f_look_cdns := CP.upd(c1.f_look_cdns, lid, LCdn.compile_cdns(body)));
      var c3 := c2.(f_look_ast := CP.upd(c2.f_look_ast, lid, body));
      var c4 := c3.(f_look_build_bc :=
      CP.upd(c3.f_look_build_bc, lid,
             CP.compile_to_write(CP.oracle_regex(la, body), lid)));
      var c5 := c4.(f_look_capture_bc :=
      CP.upd(c4.f_look_capture_bc, lid,
             CP.compile_to_bytecode(CP.capture_regex(la, body))));
      FCompileExtraFrameAny(body, c5);
  }

  /** (L4 NESTED) `FFullCompilationFacts` for the NESTED fragment: the three
      main fields of `FFullCompilation(ast)` are the obvious compile outputs,
      for a nested-fragment `ast`. Same base literal as the depth-1 version,
      the frame discharged by `FCompileExtraFrameAny` (no fragment premise). */
  lemma FFullCompilationFactsNested(ast: R.regex)
    ensures CP.FFullCompilation(ast).f_main_ast == ast
    ensures CP.FFullCompilation(ast).f_main_bc == CP.compile_to_bytecode(R.lazy_prefix(ast))
    ensures CP.FFullCompilation(ast).f_main_cdns == LCdn.compile_cdns(ast)
  {
    var nlook0 := R.max_lookaround(ast) + 1;
    var nquant0 := R.max_quant(ast) + 1;
    var base := CP.FCompiled(ast, CP.compile_to_bytecode(R.lazy_prefix(ast)), LCdn.compile_cdns(ast),
                             seq(nlook0, i => R.Lookahead), seq(nlook0, i => R.Re_empty),
                             seq(nlook0, i => []), seq(nlook0, i => []),
                             seq(nlook0, i => []), seq(nquant0, i => []));
    assert CP.FFullCompilation(ast) == CP.FCompileExtra(ast, base);
    FCompileExtraFrameAny(ast, base);
  }

  // ==========================================================================
  // The lookaround CAPTURE pass leaves the answer alone (L1).
  //
  // `FLookLoop` replays each matched positive lookaround's capture bytecode and
  // keeps the replay's registers. For capture-free bodies that cannot move
  // `filter_reset` over the main ast: the replay writes no capture register and
  // no look register, and the quant ids it does write live inside a lookaround
  // body, where the filter never reads them.
  // ==========================================================================

  /** `FFindMatchThreadFacts`' quant half, in BOTH directions — the lookbehind
      capture pass runs backward, so the forward-only version does not apply. */
  lemma FFindMatchQuantFinalAny(c: RB.code, str: string, s: AI.VmState, ov: LOr.OracleView,
                                dir: LAnc.direction, cdn: LCdn.cdns)
    requires |s.processed.true_set| == RB.size(c) && |s.processed.false_set| == RB.size(c)
    requires dir.Forward? ==> s.context.nextchar == AI.get_char(str, s.cp)
    requires dir.Backward? ==> s.context.nextchar == AI.get_char(str, s.cp - 1)
    requires forall pc: nat, q: int, b: bool ::
               NR.GetPcRE(c, pc) == Some(RB.SetQuantToClock(q, b)) ==> !b
    requires s.clock >= -1
    requires VmQuantFinal(s)
    ensures var r := AI.FFindMatch(c, str, s, ov, dir, cdn).0;
            r.Some? ==> QuantRegsFinal(r.value)
    decreases if dir.Forward? then |str| - s.cp else s.cp
  {
    var s0 := s.(cdn := LCdn.build_cdn_v(cdn, s.cp, ov, s.context, dir));
    assert VmQuantFinal(s0);
    FAdvanceEpsilonQuantFinal(c, s0, ov, dir);
    var (s1, ov1) := AI.FAdvanceEpsilon(c, s0, ov, dir);
    assert VmQuantFinal(s1);
    CM.FAdvanceEpsilonClockGrows(c, s0, ov, dir);
    if |s1.blocked| == 0 { return; }
    match s1.context.nextchar {
      case None =>
      case Some(_) =>
        var s2 := AI.FConsume(s1);
        FConsumeQuantFinal(s1);
        var s3 := s2.(processed := AI.init_bpcset(RB.size(c)), isblocked := AI.init_pcset(RB.size(c)),
        cdn := LCdn.init_cdn(), cp := AI.incr_cp(s2.cp, dir));
        var newchar := AI.get_char(str, s3.cp - AI.cp_offset(dir));
        var s4 := s3.(context := LAnc.update_context(s3.context, newchar));
        assert VmQuantFinal(s4);
        FFindMatchQuantFinalAny(c, str, s4, ov1, dir, cdn);
    }
  }

  /** The L3a capture frame: `FLookLoop` writes only inside the matched
      bodies' capture registers (all within `S`); everything else passes
      through untouched. */
  lemma FLookLoopCaptureFrame(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                              cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                              mainast: R.regex, S: set<int>)
    requires NR.LookBehindFragmentRE(mainast) && PIV.QuantUnique(mainast)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex ::
                                  LTB.LookEntryOk(crv, l, la, body)
                                  && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
                                  && PIV.CapUnique(body) && PIV.QuantUnique(body)
                                  && PIV.CaptureRegs(body) <= S
                                  && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(mainast))
                                  && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body))
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            CM.RegsAgreeOutside(res.0, cap, S) && res.1 == lk
    decreases maxlook - lid
  {
    if lid > maxlook { return; }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      FLookLoopCaptureFrame(crv, str, next, maxlook, cap, lk, qt, ov, mainast, S);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        FLookLoopCaptureFrame(crv, str, next, maxlook, cap, lk, qt, ov, mainast, S);
      } else {
        var la: R.lookaround, body: R.regex :|
          LTB.LookEntryOk(crv, lid, la, body)
          && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
          && PIV.CapUnique(body) && PIV.QuantUnique(body)
          && PIV.CaptureRegs(body) <= S
          && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(mainast))
          && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
        assert looktype == la && (la.Lookbehind? || la.Lookahead?);
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        assert lookast == body;
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var ncap, nlk, nqt := if result.None? then cap else result.value.capture_regs,
                              if result.None? then lk else result.value.look_regs,
                              if result.None? then qt else result.value.quant_regs;
        if la.Lookahead? {
          assert dir == LAnc.Forward && CP.capture_regex(la, body) == body;
          NR.PlusIsLookBehindFragmentRE(body);
          ReplayPlusFrame(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
          if result.Some? {
            CM.RegsAgreeOutsideWeaken(ncap, cap, PIV.CaptureRegs(body), S);
            assert QuantRegsFinal(result.value);
          }
        } else {
          // CAPTURING positive LOOKBEHIND (L3b): the backward replay writes captures
          // only inside CaptureRegs(body); weaken to S (CaptureRegs(body) <= S).
          assert la.Lookbehind?;
          assert dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body);
          assert bytecode == CP.compile_to_bytecode(R.reverse_regex(body));
          assert AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1);
          ReplayPlusFrameLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body);
          if result.Some? {
            CM.RegsAgreeOutsideWeaken(ncap, cap, PIV.CaptureRegs(body), S);
          }
        }
        assert CM.RegsAgreeOutside(ncap, cap, S) && nlk == lk
               && (forall k :: AI.get_idx(nqt.a_cp, k) < 0)
               && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1);
        FLookLoopCaptureFrame(crv, str, next, maxlook, ncap, nlk, nqt, ov1, mainast, S);
        CM.RegsAgreeOutsideTrans(AI.FLookLoop(crv, str, next, maxlook, ncap, nlk, nqt, ov1).0, ncap, cap, S);
      }
  }

  /** L3a — the QUANT frame for the whole FLookLoop pass: the final quant bank
      agrees with the initial one OUTSIDE `Sq`, where `Sq` covers every matched
      body's own quant ids (`QIdsInt(body) <= Sq`, from `QuantIds(body) <=
      QuantIdsInLooks(mainast)`). Each replay writes quant only inside its body
      (`QuantWritesInsideBody` -> `FFindMatchQuantFrame` for lookaheads,
      `ReplayFrames` for capture-free lookbehinds). Instantiate `Sq` with the int
      image of `QuantIdsInLooks(mainast)`, disjoint from the outer quants the main
      filter reads. Feeds P1 (`GmOfLiveFrameOutside`'s quant hypothesis). */
  lemma FLookLoopQuantFrame(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                            cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                            mainast: R.regex, Sq: set<int>)
    requires NR.LookBehindFragmentRE(mainast) && PIV.QuantUnique(mainast)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex ::
                                  LTB.LookEntryOk(crv, l, la, body)
                                  && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
                                  && PIV.CapUnique(body) && PIV.QuantUnique(body)
                                  && LKC.QIdsInt(body) <= Sq
                                  && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body))
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            CM.RegsAgreeOutside(res.2, qt, Sq) && res.1 == lk
    decreases maxlook - lid
  {
    if lid > maxlook { return; }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      FLookLoopQuantFrame(crv, str, next, maxlook, cap, lk, qt, ov, mainast, Sq);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        FLookLoopQuantFrame(crv, str, next, maxlook, cap, lk, qt, ov, mainast, Sq);
      } else {
        var la: R.lookaround, body: R.regex :|
          LTB.LookEntryOk(crv, lid, la, body)
          && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
          && PIV.CapUnique(body) && PIV.QuantUnique(body)
          && LKC.QIdsInt(body) <= Sq
          && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
        assert looktype == la && (la.Lookbehind? || la.Lookahead?);
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        assert lookast == body;
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var ncap, nlk, nqt := if result.None? then cap else result.value.capture_regs,
                              if result.None? then lk else result.value.look_regs,
                              if result.None? then qt else result.value.quant_regs;
        var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
        assert CM.VmQuantsAgree(inits, qt, LKC.QIdsInt(body)) by {
          assert inits.active == [AI.init_thread(cap, lk, qt)];
          assert AI.init_thread(cap, lk, qt).quant_regs == qt;
          assert CM.RegsAgreeOutside(qt, qt, LKC.QIdsInt(body));
        }
        if la.Lookahead? {
          assert dir == LAnc.Forward && CP.capture_regex(la, body) == body;
          NR.PlusIsLookBehindFragmentRE(body);
          ReplayPlusFrame(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
          QuantWritesInsideBody(body);   // QuantWritesInside(bytecode, QIdsInt(body))
          CM.FFindMatchQuantFrame(bytecode, str, inits, ov, dir, lookcdn, qt, LKC.QIdsInt(body));
          NoTrueQuantStamp(body);
          assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
          FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);   // res0 quant-final
          var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
          if result.Some? {
            assert res0.Some? && QuantRegsFinal(res0.value);
            FNulledPlusIdentity(body, res0.value.capture_regs, res0.value.look_regs, res0.value.quant_regs,
                                crv.f_plus_bc, str, ovx, dir);
            assert nqt == res0.value.quant_regs;
            CM.RegsAgreeOutsideWeaken(nqt, qt, LKC.QIdsInt(body), Sq);
          }
        } else {
          // CAPTURING positive LOOKBEHIND (L3b): the backward replay writes quants
          // only inside QIdsInt(body); weaken to Sq.
          assert la.Lookbehind?;
          assert dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body);
          assert bytecode == CP.compile_to_bytecode(R.reverse_regex(body));
          assert AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1);
          ReplayPlusFrameLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body);   // QuantRegsFinal -> nqt unset
          ReplayQuantFrameLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body);   // quant write frame
          if result.Some? {
            assert nqt == result.value.quant_regs;
            assert CM.RegsAgreeOutside(nqt, qt, LKC.QIdsInt(body));   // ReplayQuantFrameLB
            CM.RegsAgreeOutsideWeaken(nqt, qt, LKC.QIdsInt(body), Sq);
          }
          assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1);
        }
        assert CM.RegsAgreeOutside(nqt, qt, Sq) && nlk == lk
               && (forall k :: AI.get_idx(nqt.a_cp, k) < 0)
               && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1);
        FLookLoopQuantFrame(crv, str, next, maxlook, ncap, nlk, nqt, ov1, mainast, Sq);
        CM.RegsAgreeOutsideTrans(AI.FLookLoop(crv, str, next, maxlook, ncap, nlk, nqt, ov1).2, nqt, qt, Sq);
      }
  }

  /** One replay's register facts, packaged: the capture and look banks come out
      untouched, the quant bank agrees outside the body's ids, and the result
      thread is still quant-final. */
  lemma ReplayFrames(bytecode: RB.code, str: string, inits: AI.VmState, ov: LOr.OracleView,
                     dir: LAnc.direction, lookcdn: LCdn.cdns,
                     cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs,
                     la: R.lookaround, body: R.regex)
    requires NR.CaptureFreeRE(body) && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body))
    requires inits.active == [AI.init_thread(cap, lk, qt)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires |inits.processed.true_set| == RB.size(bytecode)
             && |inits.processed.false_set| == RB.size(bytecode)
    requires dir.Forward? ==> inits.context.nextchar == AI.get_char(str, inits.cp)
    requires dir.Backward? ==> inits.context.nextchar == AI.get_char(str, inits.cp - 1)
    requires inits.clock >= -1
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn).0;
            r.Some? ==>
              r.value.capture_regs == cap
              && r.value.look_regs == lk
              && CM.RegsAgreeOutside(r.value.quant_regs, qt, LKC.QIdsInt(body))
              && QuantRegsFinal(r.value)
  {
    LKC.CaptureCodeClassified(la, body);
    assert CM.VmCapsAre(inits, cap);
    assert CM.VmLooksAre(inits, lk);
    assert CM.VmQuantsAgree(inits, qt, LKC.QIdsInt(body)) by {
      assert CM.RegsAgreeOutside(qt, qt, LKC.QIdsInt(body));
    }
    assert VmQuantFinal(inits);
    CM.FFindMatchCapFrame(bytecode, str, inits, ov, dir, lookcdn, cap);
    CM.FFindMatchLookEq(bytecode, str, inits, ov, dir, lookcdn, lk);
    CM.FFindMatchQuantFrame(bytecode, str, inits, ov, dir, lookcdn, qt, LKC.QIdsInt(body));
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
  }

  /** L3a — the CAPTURING replay's frame direction: for a lookAHEAD with a
      capturing body (`capture_regex(Lookahead)==body`, run Forward), the
      replay's `FFindMatch` changes the capture bank only within
      `CaptureRegs(body)` (the body's own groups). Contrast `ReplayFrames`,
      which for a capture-free body gets the bank UNTOUCHED. Built from the
      capture-write frame + the whole-bytecode classification. */
  lemma ReplayCaptureFrame(bytecode: RB.code, str: string, inits: AI.VmState, ov: LOr.OracleView,
                           dir: LAnc.direction, lookcdn: LCdn.cdns,
                           cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs,
                           la: R.lookaround, body: R.regex)
    requires NR.LookBehindFragmentRE(body) && PIV.CapUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires inits.active == [AI.init_thread(cap, lk, qt)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires |inits.processed.true_set| == RB.size(bytecode)
             && |inits.processed.false_set| == RB.size(bytecode)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    ensures var r := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.capture_regs, cap, PIV.CaptureRegs(body))
  {
    CM.CaptureBytecodeClassified(body);
    assert CM.VmCapturesAgree(inits, cap, PIV.CaptureRegs(body)) by {
      assert CM.RegsAgreeOutside(cap, cap, PIV.CaptureRegs(body));
    }
    CM.FFindMatchCapWriteFrame(bytecode, str, inits, ov, dir, lookcdn, cap, PIV.CaptureRegs(body));
  }

  /** L3b: the BACKWARD capture-write frame — the lookbehind twin of
      `ReplayCaptureFrame`. The engine compiles a capturing lookbehind's replay
      over `compile_to_bytecode(reverse_regex(body))` and runs it BACKWARD, so the
      capture bank agrees with the incoming `cap` OUTSIDE the body's own registers
      (`CaptureRegs(reverse_regex(body)) == CaptureRegs(body)`, via `ReverseCapIds`).
      Both engine cores (`CaptureBytecodeClassified`, `FFindMatchCapWriteFrame`) are
      direction-generic; the reversed-body statics come from `ReversePlusFragment` +
      `ReverseCapUnique`. */
  lemma ReplayCaptureFrameLB(bytecode: RB.code, str: string, inits: AI.VmState, ov: LOr.OracleView,
                             lookcdn: LCdn.cdns, cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.PlusFragmentRE(body) && PIV.CapUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires inits.active == [AI.init_thread(cap, lk, qt)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires |inits.processed.true_set| == RB.size(bytecode)
             && |inits.processed.false_set| == RB.size(bytecode)
    requires inits.context.nextchar == AI.get_char(str, inits.cp - 1)      // BACKWARD
    ensures var r := AI.FFindMatch(bytecode, str, inits, ov, LAnc.Backward, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.capture_regs, cap, PIV.CaptureRegs(body))
  {
    var rev := R.reverse_regex(body);
    PIV.ReversePlusFragment(body);                 // PlusFragmentRE(rev)
    NR.PlusIsLookBehindFragmentRE(rev);            // LookBehindFragmentRE(rev)
    PIV.ReverseCapUnique(body);                    // CapUnique(rev)
    PIV.ReverseCapIds(body);                       // CapIds(rev) == CapIds(body)
    assert PIV.CaptureRegs(rev) == PIV.CaptureRegs(body);
    CM.CaptureBytecodeClassified(rev);
    assert CM.VmCapturesAgree(inits, cap, PIV.CaptureRegs(rev)) by {
      assert CM.RegsAgreeOutside(cap, cap, PIV.CaptureRegs(rev));
    }
    CM.FFindMatchCapWriteFrame(bytecode, str, inits, ov, LAnc.Backward, lookcdn, cap, PIV.CaptureRegs(rev));
  }

  /** A plus-fragment body's compiled code never STAMPS a quantifier true
      (`SetQuantToClock(_, true)`) -- the `!bb` half of `CodeShapeAt`, lifted to
      the whole `compile_to_bytecode`. Capture-independent (the quant structure
      is the same whether or not the body captures). Feeds `FFindMatchQuantFinalAny`. */
  lemma NoTrueQuantStamp(body: R.regex)
    requires NR.LookBehindFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    ensures var code := CP.compile_to_bytecode(body);
            forall pc: nat, q: int, b: bool ::
              NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, b)) ==> !b
  {
    var code := CP.compile_to_bytecode(body);
    var next := CP.compile(body, 0, CP.Progress).1;
    NR.CompileToBytecodeRepLookBehind(body);
    var endl := next as nat;
    forall pc: nat, q: int, b: bool | NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, b))
      ensures !b
    {
      assert pc < |code|;
      if pc < endl {
        NI.CodeShapeAt(body, code, 0, endl, pc);
      } else {
        assert pc == endl;
        assert NR.GetPcRE(code, endl) == Some(RB.Accept);
      }
    }
  }

  /** L4 depth-k (ADDITIVE): nested-fragment twin of `NoTrueQuantStamp`. A
      NESTED-fragment body's compiled bytecode never emits a TRUE quant stamp.
      `NR.CompileToBytecodeRepNested` supplies the `NfaRepRE`, and `NI.CodeShapeAt`
      (whose `Re_lookaround` case is trivial — a look compiles to a single
      `CheckOracle` leaf, which is neither `SetQuantToClock` nor `SetRegisterToCP`)
      discharges every pc, exactly as in the depth-1 proof. This is the ONE
      depth-1-capped ingredient the per-lid replay bridge needs generalized off
      `LookBehindFragmentRE`. */
  lemma NoTrueQuantStampNested(body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    ensures var code := CP.compile_to_bytecode(body);
            forall pc: nat, q: int, b: bool ::
              NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, b)) ==> !b
  {
    var code := CP.compile_to_bytecode(body);
    var next := CP.compile(body, 0, CP.Progress).1;
    NR.CompileToBytecodeRepNested(body);
    var endl := next as nat;
    forall pc: nat, q: int, b: bool | NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, b))
      ensures !b
    {
      assert pc < |code|;
      if pc < endl {
        NI.CodeShapeAt(body, code, 0, endl, pc);
      } else {
        assert pc == endl;
        assert NR.GetPcRE(code, endl) == Some(RB.Accept);
      }
    }
  }

  /** A body's compiled bytecode writes quant clocks only inside its own quant ids
      -- capture-INDEPENDENT (the quant structure is the same whether or not the
      body captures), so unlike `LKC.CaptureCodeClassified` this needs no
      `CaptureFreeRE`. Via `NI.CodeShapeAt` (`sq >= 0 && sq in QuantIds(body)`).
      Feeds the per-replay `CM.FFindMatchQuantFrame`. */
  lemma QuantWritesInsideBody(body: R.regex)
    requires NR.LookBehindFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    ensures CM.QuantWritesInside(CP.compile_to_bytecode(body), LKC.QIdsInt(body))
  {
    var code := CP.compile_to_bytecode(body);
    var next := CP.compile(body, 0, CP.Progress).1;
    NR.CompileToBytecodeRepLookBehind(body);
    var endl := next as nat;
    forall pc: nat | pc < |code|
      ensures code[pc].SetQuantToClock? ==> code[pc].sq in LKC.QIdsInt(body)
    {
      assert NR.GetPcRE(code, pc) == Some(code[pc]);
      if pc < endl {
        NI.CodeShapeAt(body, code, 0, endl, pc);
      } else {
        assert pc == endl;
        assert NR.GetPcRE(code, endl) == Some(RB.Accept);
      }
    }
  }

  lemma ReplayPlusCaptureFrame(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                               lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                               cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    requires NR.LookBehindFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires AI.cp_context(cp, str, dir).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.capture_regs, cap, PIV.CaptureRegs(body))
  {
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    ReplayCaptureFrame(bytecode, str, inits, ov, dir, lookcdn, cap, lk, qt, la, body);
    NoTrueQuantStamp(body);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** The FULL per-replay frame the FLookLoop induction consumes: for a
      capturing lookAHEAD replay, the result's capture bank agrees with `cap`
      outside `CaptureRegs(body)`, the LOOK bank is unchanged (look-free body),
      and the QUANT bank is final (so it can seed the next replay). Extends
      `ReplayPlusCaptureFrame` with the look/quant facts, via the un-bundled
      look-write-free (`NoLookWriteBody`) and no-true-stamp classifications. */
  lemma ReplayPlusFrame(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                        lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                        cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    requires NR.LookBehindFragmentRE(body) && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires AI.cp_context(cp, str, dir).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==>
              CM.RegsAgreeOutside(r.value.capture_regs, cap, PIV.CaptureRegs(body))
              && r.value.look_regs == lk
              && QuantRegsFinal(r.value)
  {
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    ReplayCaptureFrame(bytecode, str, inits, ov, dir, lookcdn, cap, lk, qt, la, body);
    LKC.NoLookWriteBody(body);
    assert CM.VmLooksAre(inits, lk);
    CM.FFindMatchLookEq(bytecode, str, inits, ov, dir, lookcdn, lk);
    NoTrueQuantStamp(body);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** L3b: the BACKWARD plus-fragment replay frame — the lookbehind twin of
      `ReplayPlusFrame`. The engine runs a capturing lookbehind's replay over
      `compile_to_bytecode(reverse_regex(body))` BACKWARD; the capture bank agrees
      with `cap` outside `CaptureRegs(body)` (`ReplayCaptureFrameLB`), looks are
      unchanged (`NoLookWriteBody(rev)` + `FFindMatchLookEq`), quants stay final
      (`NoTrueQuantStamp(rev)` + `FFindMatchQuantFinalAny`), and the plus
      reconstruction is the identity (`FNulledPlusIdentity`). The `FFindMatchPlus`
      reconstruction regex is `body` (matching the FLookLoop call `bytecode ==
      compile_to_bytecode(capture_regex(la, body)) == compile(reverse_regex(body))`,
      2nd arg `lookast == body`). */
  lemma ReplayPlusFrameLB(bytecode: RB.code, str: string, ov: LOr.OracleView,
                          lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                          cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==>
              CM.RegsAgreeOutside(r.value.capture_regs, cap, PIV.CaptureRegs(body))
              && r.value.look_regs == lk
              && QuantRegsFinal(r.value)
  {
    var rev := R.reverse_regex(body);
    PIV.ReversePlusFragment(body);                 // PlusFragmentRE(rev)
    NR.PlusIsLookBehindFragmentRE(rev);            // LookBehindFragmentRE(rev)
    PIV.ReverseLookFree(body);                     // LookFreeRE(rev)
    PIV.ReverseCapUnique(body);                    // CapUnique(rev)
    PIV.ReverseQuantUnique(body);                  // QuantUnique(rev)
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, LAnc.Backward));
    ReplayCaptureFrameLB(bytecode, str, inits, ov, lookcdn, cap, lk, qt, body);
    LKC.NoLookWriteBody(rev);
    assert CM.VmLooksAre(inits, lk);
    CM.FFindMatchLookEq(bytecode, str, inits, ov, LAnc.Backward, lookcdn, lk);
    NoTrueQuantStamp(rev);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, LAnc.Backward, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, LAnc.Backward, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, LAnc.Backward);
    }
  }

  /** A compiled body's bytecode holds no `WriteOracle` -- `compile_to_bytecode`
      never emits one (only the oracle BUILD pass does). Lifts `NR.NoWriteInstrRE`
      over the whole block; the `Accept` at `endl` is not a `WriteOracle`. */
  lemma NoWriteOracleBodyCode(body: R.regex)
    requires NR.LookBehindFragmentRE(body)
    ensures CM.NoWriteOracleCode(CP.compile_to_bytecode(body))
  {
    var code := CP.compile_to_bytecode(body);
    var next := CP.compile(body, 0, CP.Progress).1;
    NR.CompileToBytecodeRepLookBehind(body);
    var endl := next as nat;
    forall pc: nat | pc < |code| ensures !code[pc].WriteOracle? {
      assert NR.GetPcRE(code, pc) == Some(code[pc]);
      if pc < endl {
        NR.NoWriteInstrRE(body, code, 0, endl, pc);
      } else {
        assert pc == endl;
        assert NR.GetPcRE(code, endl) == Some(RB.Accept);
      }
    }
  }

  /** §4b — ORACLE STABILITY of a look-free body's whole `FFindMatchPlus`. The
      `FFindMatch` half reads the oracle (`NoWriteOracleBodyCode` -> `FFindMatchOvStable`);
      the `FReconstructPlus` half is the identity on a `QuantRegsFinal` thread
      (`FNulledPlusIdentity`), so it returns the view untouched. Lets the FLookLoop
      value-lift keep the SAME `ov` across the whole fold (so `qm.ov == ov` survives
      into every per-lid `ReplayCapIsBodyLeaf`). */
  lemma FFindMatchPlusOvStable(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                               lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                               cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    requires NR.LookBehindFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires AI.cp_context(cp, str, dir).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).1 == ov
  {
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    NoWriteOracleBodyCode(body);
    CM.FFindMatchOvStable(bytecode, str, inits, ov, dir, lookcdn);   // FFindMatch(...).1 == ov
    NoTrueQuantStamp(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    assert ovx == ov;
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** Lookbehind companion of `FFindMatchPlusOvStable`: a capture-free lookbehind
      replay reads the oracle but never writes it, so it leaves `ov` unchanged.
      The bytecode is `compile_to_bytecode(reverse_regex(body))` (the backward
      capture regex); reversal preserves look-freedom / plus-fragment / quant
      uniqueness, so the same no-oracle-write + quant-final argument applies. The
      backward context fact (`nextchar == get_char(str, cp-1)`) is definitional. */
  lemma FFindMatchPlusOvStableLB(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                                 lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                 cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    // L3b: capturing lookbehind bodies allowed -- `CaptureFreeRE` was only used to
    // reach `CapUnique(reverse_regex(body))`, now supplied directly by
    // `ReverseCapUnique`. Oracle stability is capture-INDEPENDENT.
    requires NR.LookFreeRE(body) && NR.PlusFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookbehind? && dir == LAnc.Backward
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).1 == ov
  {
    var rbody := R.reverse_regex(body);
    NR.ReversePlusFragmentRE(body);          // PlusFragmentRE(rbody)
    NR.PlusIsLookBehindFragmentRE(rbody);    // LookBehindFragmentRE(rbody)
    PIV.ReverseQuantUnique(body);            // QuantUnique(rbody)
    PIV.ReverseCapUnique(body);              // CapUnique(rbody)
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    assert inits.context.nextchar == AI.get_char(str, cp - 1);   // cp_context Backward definitional
    NoWriteOracleBodyCode(rbody);
    CM.FFindMatchOvStable(bytecode, str, inits, ov, dir, lookcdn);   // FFindMatch(...).1 == ov
    NoTrueQuantStamp(rbody);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    assert ovx == ov;
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  // ==========================================================================
  // L3a §4 — the FLookLoop VALUE lift vocabulary. The §4a frame says what
  // FLookLoop leaves UNCHANGED (outside S); the value lift says what it WRITES:
  // each matched positive lookahead's body registers carry that body's FRESH
  // match.
  // ==========================================================================

  /** `l` names a matched, capturing, positive (forward) lookahead. */
  ghost predicate MatchedPosLA(crv: CP.FCompiled, lk: AReg.Regs, l: int) {
    AReg.get_cp(lk, l).Some?
    && AI.capture_type(if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead)
    // L3b: a matched POSITIVE look -- lookAHEAD or lookBEHIND -- reconstructs its
    // body's captures (the negatives record nothing; `capture_type` already excludes them).
    && ((if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead).Lookahead?
        || (if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead).Lookbehind?)
  }

  /** The `l`-th lookaround body (default `Re_empty` off the table). */
  ghost function VBody(crv: CP.FCompiled, l: int): R.regex {
    if 0 <= l < |crv.f_look_ast| then crv.f_look_ast[l] else R.Re_empty
  }

  /** The body-`l` match from FRESH registers at the recorded cp, under `ov`. */
  ghost function FreshBodyMatch(crv: CP.FCompiled, str: string, l: int, lk: AReg.Regs,
                                ov: LOr.OracleView, ncap: int, nlook: int, nquant: int): Option<AI.Thread> {
    var body := VBody(crv, l);
    var cp := if AReg.get_cp(lk, l).Some? then AReg.get_cp(lk, l).value else 0;
    // L3b: the fresh body match runs in the look's CAPTURE direction over its
    // compiled capture regex -- for a lookAHEAD that is `body` FORWARD (unchanged);
    // for a lookBEHIND, `reverse_regex(body)` BACKWARD (the keystone's fresh ref).
    var looktype := if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead;
    var dir := AI.capture_direction(looktype);
    var bc := CP.compile_to_bytecode(CP.capture_regex(looktype, body));
    var cdn := if 0 <= l < |crv.f_look_cdns| then crv.f_look_cdns[l] else [];
    AI.FFindMatch(bc, str, AI.FInitState(bc, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                         AReg.init_regs(nquant), 0, AI.cp_context(cp, str, dir)), ov, dir, cdn).0
  }

  /** The value-lift conclusion: on each matched positive lookahead's own capture
      registers, `res0` carries the fresh body match (or stays unset if the fresh
      body did not match). */
  ghost predicate FLookLoopValueOk(crv: CP.FCompiled, str: string, res0: AReg.Regs, lid: int, maxlook: int,
                                   lk: AReg.Regs, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int) {
    forall l: int :: lid <= l <= maxlook && MatchedPosLA(crv, lk, l) ==>
                       var rf := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
                       (rf.Some? ==> CM.RegsAgreeInside(res0, rf.value.capture_regs, PIV.CaptureRegs(VBody(crv, l))))
                       && (rf.None? ==> CM.RegsAgreeInside(res0, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l))))
  }

  /** `l == lid` is not a matched positive lookahead, so the value map for
      `[lid, maxlook]` is exactly the one for `[lid+1, maxlook]`. */
  lemma ValueOkSkipLid(crv: CP.FCompiled, str: string, res0: AReg.Regs, lid: int, maxlook: int,
                       lk: AReg.Regs, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int)
    requires FLookLoopValueOk(crv, str, res0, lid + 1, maxlook, lk, ov, ncap, nlook, nquant)
    requires !MatchedPosLA(crv, lk, lid)
    ensures FLookLoopValueOk(crv, str, res0, lid, maxlook, lk, ov, ncap, nlook, nquant)
  {
    forall l: int | lid <= l <= maxlook && MatchedPosLA(crv, lk, l)
      ensures var rf := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
              (rf.Some? ==> CM.RegsAgreeInside(res0, rf.value.capture_regs, PIV.CaptureRegs(VBody(crv, l))))
              && (rf.None? ==> CM.RegsAgreeInside(res0, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l))))
    { assert l != lid; }
  }

  /** §4 VALUE-LIFT ENGINE BRIDGE (per matched lid): the ACTUAL FFindMatchPlus
      replay from the fold's `cap` agrees, on `CaptureRegs(body)`, with a replay
      from FRESH registers, and matches iff-together. `FReconstructPlus` is the
      identity on the `QuantRegsFinal` result (`FNulledPlusIdentity`), so the
      FFindMatchPlus capture bank IS the FFindMatch one; then the register-value-
      blind bisimulation `ReplayCapAgreeFresh` ties it to the fresh replay. This
      is the one non-trivial engine step the FLookLoop value induction consumes. */
  lemma ReplayLidCapAgreeFresh(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                               qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                               body: R.regex, la: R.lookaround, ncap: int, nlook: int, nquant: int)
    requires NR.LookBehindFragmentRE(body) && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead?
    requires bytecode == CP.compile_to_bytecode(body)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Forward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                              ov, LAnc.Forward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==> CM.RegsAgreeInside(result.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body)))
  {
    var dir := LAnc.Forward;
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    // the FFindMatchPlus capture bank == the FFindMatch capture bank (reconstruct
    // is the identity for a QuantRegsFinal result).
    NoTrueQuantStamp(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    // the register-value-blind bisimulation: FFindMatch(from cap) ~ FFindMatch(from fresh).
    ReplayCapAgreeFresh(bytecode, str, cp, cap, lk, qt, ov, lookcdn, body, ncap, nlook, nquant);
  }

  /** L4 depth-k (ADDITIVE): the per-lid replay↔fresh capture bridge GENERALIZED off
      the depth-1 fragment to a NESTED-fragment `body` — the value-lift engine step
      for a positive lookAHEAD whose body may itself nest looks to any depth. Same
      conclusion as `ReplayLidCapAgreeFresh` (FFindMatchPlus replay caps == fresh
      FFindMatch caps on `CaptureRegs(body)`, matching iff-together). Every
      ingredient is already gate-agnostic: `FNulledPlusIdentity` and
      `FFindMatchQuantFinalAny` are structural, and the register-value-blind
      bisimulation `ReplayCapAgreeFresh` carries NO fragment hypothesis. The ONE
      depth-1-capped ingredient — the no-true-quant-stamp code-shape fact — is
      supplied by `NoTrueQuantStampNested`. So the bridge drops
      `LookFreeRE/PlusFragmentRE/LookBehindFragmentRE(body)` for `NestedFragmentRE`.
      NOTE: this reconstructs `body`'s OWN capture registers as the fresh body
      match writes them; `body`'s INNER-look captures (unset by that fresh match)
      are reconstructed by the SEPARATE top-level `FLookLoop` iterations over the
      inner lids (higher-numbered, so processed after `body`'s enclosing look). */
  lemma ReplayLidCapAgreeFreshNested(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                     qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                     body: R.regex, la: R.lookaround, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead?
    requires bytecode == CP.compile_to_bytecode(body)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Forward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                              ov, LAnc.Forward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==> CM.RegsAgreeInside(result.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body)))
  {
    var dir := LAnc.Forward;
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    // the FFindMatchPlus capture bank == the FFindMatch capture bank (reconstruct
    // is the identity for a QuantRegsFinal result).
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    // the register-value-blind bisimulation: FFindMatch(from cap) ~ FFindMatch(from fresh).
    ReplayCapAgreeFresh(bytecode, str, cp, cap, lk, qt, ov, lookcdn, body, ncap, nlook, nquant);
  }

  /** C4e: the per-lid FORWARD replay↔fresh QUANT agreement for a NESTED body —
      nested twin of `ReplayLidQuantAgreeFresh` (:5076) and quant analogue of
      `ReplayLidCapAgreeFreshNested`. The `FFindMatchPlus` lookahead replay's quant
      bank agrees, on `QIdsInt(body)`, with the fresh `FFindMatch`, with NO capture
      hypotheses (the register-value-blind bisimulation `CM.FFindMatchCapRel` runs
      at `Sc == {}`: control never reads register values, so it stays in lockstep
      regardless of the incoming capture bank). Entry: the body's quant slots are
      still INITIAL in the incoming bank. The ONE depth-1-capped ingredient is
      `NoTrueQuantStampNested` (nested twin of `NoTrueQuantStamp`); `FNulledPlus
      Identity` and `FFindMatchCapRel` are already fragment-generic. */
  lemma ReplayLidQuantAgreeFreshNested(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                       qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                       body: R.regex, la: R.lookaround, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead?
    requires bytecode == CP.compile_to_bytecode(body)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body))
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Forward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                              ov, LAnc.Forward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==>
            CM.RegsAgreeInside(result.value.quant_regs, rf.value.quant_regs, LKC.QIdsInt(body)))
  {
    var dir := LAnc.Forward;
    var ctxc := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctxc);
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    var sf := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    assert CM.VmRel(inits, sf, {}, LKC.QIdsInt(body)) by {
      assert CM.ThreadRel(AI.init_thread(cap, lk, qt),
                          AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
    {}, LKC.QIdsInt(body)) by {
        assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), {});
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body));
      }
    }
    CM.FFindMatchCapRel(bytecode, str, inits, sf, ov, dir, lookcdn, {}, LKC.QIdsInt(body));
  }
  // ===========================================================================
  // (L5 F7c-2) LOOKBEHIND twins of the nested replay helpers. `FLookLoop`
  // replays a positive LOOKBEHIND lid with `capture_regex(Lookbehind, body) ==
  // reverse_regex(body)` run BACKWARD (`capture_direction`), ast = `body`.
  // `rev := reverse_regex(body)` is itself a nested fragment with the SAME
  // capture / quant / look ids, so every code-shape fact of the forward helpers
  // applies to `compile(rev)`, and every engine lemma underneath already takes
  // `dir`. Conclusions are stated on `body`'s id sets (transferred by
  // `ReverseIdSets`).
  // ===========================================================================

  lemma ReverseCapIdsOutsideLooks(r: R.regex)
    ensures PIV.CapIdsOutsideLooks(R.reverse_regex(r)) == PIV.CapIdsOutsideLooks(r)
    decreases r
  {
    match r
    case Re_alt(r1, r2) => ReverseCapIdsOutsideLooks(r1); ReverseCapIdsOutsideLooks(r2);
    case Re_con(r1, r2) => ReverseCapIdsOutsideLooks(r1); ReverseCapIdsOutsideLooks(r2);
    case Re_quant(_, _, _, r1) => ReverseCapIdsOutsideLooks(r1);
    case Re_capture(_, r1) => ReverseCapIdsOutsideLooks(r1);
    case _ =>
  }

  lemma ReverseCapIdsInLooks(r: R.regex)
    ensures PIV.CapIdsInLooks(R.reverse_regex(r)) == PIV.CapIdsInLooks(r)
    decreases r
  {
    match r
    case Re_alt(r1, r2) => ReverseCapIdsInLooks(r1); ReverseCapIdsInLooks(r2);
    case Re_con(r1, r2) => ReverseCapIdsInLooks(r1); ReverseCapIdsInLooks(r2);
    case Re_quant(_, _, _, r1) => ReverseCapIdsInLooks(r1);
    case Re_capture(_, r1) => ReverseCapIdsInLooks(r1);
    case Re_lookaround(_, _, r1) => PIV.ReverseCapIds(r1);
    case _ =>
  }

  lemma ReverseDirectLookIds(r: R.regex)
    ensures DirectLookIds(R.reverse_regex(r)) == DirectLookIds(r)
    decreases r
  {
    match r
    case Re_alt(r1, r2) => ReverseDirectLookIds(r1); ReverseDirectLookIds(r2);
    case Re_con(r1, r2) => ReverseDirectLookIds(r1); ReverseDirectLookIds(r2);
    case Re_quant(_, _, _, r1) => ReverseDirectLookIds(r1);
    case Re_capture(_, r1) => ReverseDirectLookIds(r1);
    case _ =>
  }

  /** All the id sets the replay frames speak about are `reverse_regex`-invariant. */
  lemma ReverseIdSets(body: R.regex)
    ensures PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(R.reverse_regex(body)))
         == PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body))
    ensures LookIdSet(R.reverse_regex(body)) == LookIdSet(body)
    ensures DirectLidSet(R.reverse_regex(body)) == DirectLidSet(body)
    ensures LKC.QIdsInt(R.reverse_regex(body)) == LKC.QIdsInt(body)
    ensures PIV.CaptureRegs(R.reverse_regex(body)) == PIV.CaptureRegs(body)
  {
    ReverseCapIdsOutsideLooks(body);
    NR.LookIdsReverseRE(body);
    ReverseDirectLookIds(body);
    PIV.ReverseQuantIds(body);
    PIV.ReverseCapIds(body);
  }

  /** The reversed body's structural package. */
  lemma ReverseNestedPackage(body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    ensures NR.NestedFragmentRE(R.reverse_regex(body))
    ensures PIV.CapUnique(R.reverse_regex(body)) && PIV.QuantUnique(R.reverse_regex(body))
    ensures LTB.LookUnique(body) ==> LTB.LookUnique(R.reverse_regex(body))
  {
    NR.ReverseNestedFragmentRE(body);
    PIV.ReverseCapUnique(body);
    PIV.ReverseQuantUnique(body);
    if LTB.LookUnique(body) { NR.LookUniqueReverseRE(body); }
  }

  /** LB twin of `ReplayCaptureFrameNestedOuter`. */
  lemma ReplayCaptureFrameNestedOuterLB(bytecode: RB.code, str: string, inits: AI.VmState, ov: LOr.OracleView,
                                        lookcdn: LCdn.cdns, cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires inits.active == [AI.init_thread(cap, lk, qt)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires |inits.processed.true_set| == RB.size(bytecode)
             && |inits.processed.false_set| == RB.size(bytecode)
    requires inits.context.nextchar == AI.get_char(str, inits.cp - 1)
    ensures var r := AI.FFindMatch(bytecode, str, inits, ov, LAnc.Backward, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.capture_regs, cap,
                                            PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)))
  {
    var rev := R.reverse_regex(body);
    NR.ReverseNestedFragmentRE(body);
    PIV.ReverseCapUnique(body);
    var Sc := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));
    ReverseCapIdsOutsideLooks(body);
    CaptureBytecodeClassifiedNestedOuter(rev);
    assert CM.CaptureWritesInside(bytecode, Sc);
    assert CM.VmCapturesAgree(inits, cap, Sc) by {
      assert CM.RegsAgreeOutside(cap, cap, Sc);
    }
    CM.FFindMatchCapWriteFrame(bytecode, str, inits, ov, LAnc.Backward, lookcdn, cap, Sc);
  }

  /** LB twin of `ReplayPlusCaptureFrameNestedOuter`. */
  lemma ReplayPlusCaptureFrameNestedOuterLB(bytecode: RB.code, str: string, ov: LOr.OracleView,
                                            lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                            cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.capture_regs, cap,
                                            PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)))
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    ReplayCaptureFrameNestedOuterLB(bytecode, str, inits, ov, lookcdn, cap, lk, qt, body);
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** LB twin of `ReplayPlusLookFrameNested`. */
  lemma ReplayPlusLookFrameNestedLB(bytecode: RB.code, str: string, ov: LOr.OracleView,
                                    lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                    cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body) && LTB.LookUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.look_regs, lk, LookIdSet(body))
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    ReverseIdSets(body);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    LookBytecodeClassifiedNested(rev);
    assert CM.LookChecksInside(bytecode, LookIdSet(body));
    assert CM.VmLooksAgree(inits, lk, LookIdSet(body)) by {
      assert CM.RegsAgreeOutside(lk, lk, LookIdSet(body));
    }
    CM.FFindMatchLookFrame(bytecode, str, inits, ov, dir, lookcdn, lk, LookIdSet(body));
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** LB twin of `ReplayPlusLookFrameDirectNested`. */
  lemma ReplayPlusLookFrameDirectNestedLB(bytecode: RB.code, str: string, ov: LOr.OracleView,
                                          lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                          cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body) && LTB.LookUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.look_regs, lk, DirectLidSet(body))
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    ReverseIdSets(body);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    DirectLidClassified(rev);
    assert CM.LookChecksInside(bytecode, DirectLidSet(body));
    assert CM.VmLooksAgree(inits, lk, DirectLidSet(body)) by {
      assert CM.RegsAgreeOutside(lk, lk, DirectLidSet(body));
    }
    CM.FFindMatchLookFrame(bytecode, str, inits, ov, dir, lookcdn, lk, DirectLidSet(body));
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** LB twin of `ReplayPlusFrameNested`. */
  lemma ReplayPlusFrameNestedLB(bytecode: RB.code, str: string, ov: LOr.OracleView,
                                lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body) && LTB.LookUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==>
              CM.RegsAgreeOutside(r.value.capture_regs, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)))
              && CM.RegsAgreeOutside(r.value.look_regs, lk, LookIdSet(body))
              && QuantRegsFinal(r.value)
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    ReplayPlusCaptureFrameNestedOuterLB(bytecode, str, ov, lookcdn, plus_bcv, cp, cap, lk, qt, body);
    ReplayPlusLookFrameNestedLB(bytecode, str, ov, lookcdn, plus_bcv, cp, cap, lk, qt, body);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** LB twin of `FFindMatchPlusOvStableNested`. */
  lemma FFindMatchPlusOvStableNestedLB(bytecode: RB.code, str: string, ov: LOr.OracleView,
                                       lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                       cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).1 == ov
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    NoWriteOracleBodyCodeNested(rev);
    CM.FFindMatchOvStable(bytecode, str, inits, ov, dir, lookcdn);
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    assert ovx == ov;
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** LB twin of `ReplayThreadWfLANested`. */
  lemma ReplayThreadWfLBNested(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                               qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                               body: R.regex, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires PIV.CapRegWf(cap)
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
      result.Some? ==> CM.ThreadRegsWf(result.value, ncap, nlook, nquant)
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctx);
    assert CM.VmRegsWf(inits, ncap, nlook, nquant) by {
      assert CM.ThreadRegsWf(AI.init_thread(cap, lk, qt), ncap, nlook, nquant);
      assert inits.active == [AI.init_thread(cap, lk, qt)];
      forall t | t in inits.active ensures CM.ThreadRegsWf(t, ncap, nlook, nquant) {}
    }
    FFindMatchRegsWf(bytecode, str, inits, ov, dir, lookcdn, ncap, nlook, nquant);
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
  }

  /** LB twin of `ReplayLookCpOkNested`. */
  lemma ReplayLookCpOkNestedLB(bytecode: RB.code, str: string, ov: LOr.OracleView,
                               lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                               cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires 0 <= cp <= |str|
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires CM.LookCpsLE(lk, |str|)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.LookCpsLE(r.value.look_regs, |str|)
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctx);
    assert CM.VmLookCpOk(inits, |str|) by {
      assert AI.init_thread(cap, lk, qt).look_regs == lk;
      assert inits.active == [AI.init_thread(cap, lk, qt)];
    }
    assert ctx.nextchar == AI.get_char(str, cp - 1);
    CM.FFindMatchLookCpOkB(bytecode, str, inits, ov, dir, lookcdn);
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** LB twin of `ReplayCapAgreeFresh` (the register-value-blind bisimulation, Backward). */
  lemma ReplayCapAgreeFreshLBNested(bodycode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                    qt: AReg.Regs, ov: LOr.OracleView, cdns: LCdn.cdns, body: R.regex,
                                    ncap: int, nlook: int, nquant: int)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    ensures var ctxc := AI.cp_context(cp, str, LAnc.Backward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Backward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Backward, cdns).0;
            (ra.None? <==> rf.None?)
            && (ra.Some? ==> CM.RegsAgreeInside(ra.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body)))
  {
    var ctxc := AI.cp_context(cp, str, LAnc.Backward);
    var sa := AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc);
    var sf := AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    var Sc := PIV.CaptureRegs(body);
    assert CM.VmRel(sa, sf, Sc, {}) by {
      assert CM.ThreadRel(AI.init_thread(cap, lk, qt),
                          AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
                          Sc, {}) by {
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), {});
      }
    }
    CM.FFindMatchCapRel(bodycode, str, sa, sf, ov, LAnc.Backward, cdns, Sc, {});
  }

  /** LB twin of `ReplayLidCapAgreeFreshNested`. */
  lemma ReplayLidCapAgreeFreshNestedLB(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                       qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                       body: R.regex, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                              ov, LAnc.Backward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==> CM.RegsAgreeInside(result.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body)))
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    ReplayCapAgreeFreshLBNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, body, ncap, nlook, nquant);
  }

  /** LB twin of `ReplayLidLookAgreeFreshNested`. */
  lemma ReplayLidLookAgreeFreshNestedLB(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                        qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                        body: R.regex, SL: set<int>, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires CM.RegsAgreeInside(lk, AReg.init_regs(nlook), SL)
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                              ov, LAnc.Backward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==>
            CM.RegsAgreeInside(result.value.look_regs, rf.value.look_regs, SL))
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    var ctxc := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctxc);
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    var sf := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    assert CM.VmRelLk(inits, sf, {}, {}, SL) by {
      assert CM.ThreadRelLk(AI.init_thread(cap, lk, qt),
                            AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
    {}, {}, SL) by {
        assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), {});
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), {});
        assert CM.RegsAgreeInside(lk, AReg.init_regs(nlook), SL);
      }
    }
    CM.FFindMatchLookRel(bytecode, str, inits, sf, ov, dir, lookcdn, {}, {}, SL);
  }

  /** LB twin of `ReplayLidQuantAgreeFreshNested`. */
  lemma ReplayLidQuantAgreeFreshNestedLB(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                         qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                         body: R.regex, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body))
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                              ov, LAnc.Backward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==>
            CM.RegsAgreeInside(result.value.quant_regs, rf.value.quant_regs, LKC.QIdsInt(body)))
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    var ctxc := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctxc);
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    var sf := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    assert CM.VmRel(inits, sf, {}, LKC.QIdsInt(body)) by {
      assert CM.ThreadRel(AI.init_thread(cap, lk, qt),
                          AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
    {}, LKC.QIdsInt(body)) by {
        assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), {});
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body));
      }
    }
    CM.FFindMatchCapRel(bytecode, str, inits, sf, ov, dir, lookcdn, {}, LKC.QIdsInt(body));
  }
  lemma ReverseQuantIdsOutsideLooks(r: R.regex)
    ensures PIV.QuantIdsOutsideLooks(R.reverse_regex(r)) == PIV.QuantIdsOutsideLooks(r)
    decreases r
  {
    match r
    case Re_alt(r1, r2) => ReverseQuantIdsOutsideLooks(r1); ReverseQuantIdsOutsideLooks(r2);
    case Re_con(r1, r2) => ReverseQuantIdsOutsideLooks(r1); ReverseQuantIdsOutsideLooks(r2);
    case Re_quant(_, _, _, r1) => ReverseQuantIdsOutsideLooks(r1);
    case Re_capture(_, r1) => ReverseQuantIdsOutsideLooks(r1);
    case _ =>
  }

  /** LB twin of `ReplayPlusQuantFrameNestedOuter`. */
  lemma ReplayPlusQuantFrameNestedOuterLB(bytecode: RB.code, str: string, ov: LOr.OracleView,
                                          lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                          cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.quant_regs, qt, QIdsOuter(body))
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    ReverseQuantIdsOutsideLooks(body);
    var Sq := QIdsOuter(body);
    assert QIdsOuter(rev) == Sq;
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    QuantBytecodeClassifiedNestedOuter(rev);
    assert CM.QuantWritesInside(bytecode, Sq);
    assert CM.VmQuantsAgree(inits, qt, Sq) by {
      assert inits.active == [AI.init_thread(cap, lk, qt)];
      assert AI.init_thread(cap, lk, qt).quant_regs == qt;
      assert CM.RegsAgreeOutside(qt, qt, Sq);
    }
    CM.FFindMatchQuantFrame(bytecode, str, inits, ov, dir, lookcdn, qt, Sq);
    NoTrueQuantStampNested(rev);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }



  /** (DEEP reverse-recon LEVEL-LINK, engine half) the per-lid replay↔fresh LOOK
      agreement for a NESTED body — look twin of `ReplayLidQuantAgreeFreshNested`.
      The `FFindMatchPlus` lookahead replay's LOOK bank agrees, on any index set
      `SL` where the incoming bank is still INITIAL, with the fresh `FFindMatch`'s
      look bank, matching iff-together. Both runs are in register-blind lockstep
      (`CM.FFindMatchLookRel` at `Sc == Sq == {}`), and CheckOracle writes the same
      (l, cp, clock) at every crossing, so initial agreement inside `SL` persists.
      Instantiated at `SL := DirectLidSet(body)` (the only look ids the replay
      writes), this ties the FLookLoop iteration's recorded DIRECT-child positions
      to the FRESH body match's — the level-link of the deep landing recursion. */
  lemma ReplayLidLookAgreeFreshNested(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                      qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                      body: R.regex, la: R.lookaround, SL: set<int>, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead?
    requires bytecode == CP.compile_to_bytecode(body)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires CM.RegsAgreeInside(lk, AReg.init_regs(nlook), SL)
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Forward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                              ov, LAnc.Forward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==>
            CM.RegsAgreeInside(result.value.look_regs, rf.value.look_regs, SL))
  {
    var dir := LAnc.Forward;
    var ctxc := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctxc);
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    var sf := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    assert CM.VmRelLk(inits, sf, {}, {}, SL) by {
      assert CM.ThreadRelLk(AI.init_thread(cap, lk, qt),
                            AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
    {}, {}, SL) by {
        assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), {});
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), {});
        assert CM.RegsAgreeInside(lk, AReg.init_regs(nlook), SL);
      }
    }
    CM.FFindMatchLookRel(bytecode, str, inits, sf, ov, dir, lookcdn, {}, {}, SL);
  }

  /** L3b: the per-lid BACKWARD replay↔fresh capture agreement — lookbehind twin of
      `ReplayLidCapAgreeFresh`. The `FFindMatchPlus` backward replay from the main
      thread's `cap` (fresh on `CaptureRegs(body)`) agrees, on `CaptureRegs(body)`,
      with the fresh backward `FFindMatch`. `FFindMatchPlus` caps == `FFindMatch`
      caps (reconstruct is identity), then the dir-generic bisimulation
      `ReplayCapAgreeFreshLB`. The bytecode is `compile_to_bytecode(reverse_regex
      (body))`, the reconstruction reg is `body` (the FLookLoop call convention). */
  lemma ReplayLidCapAgreeFreshLB(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                 qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                 body: R.regex, ncap: int, nlook: int, nquant: int)
    requires NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                              ov, LAnc.Backward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==> CM.RegsAgreeInside(result.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body)))
  {
    var rev := R.reverse_regex(body);
    PIV.ReversePlusFragment(body);
    NR.PlusIsLookBehindFragmentRE(rev);
    PIV.ReverseCapUnique(body);
    PIV.ReverseQuantUnique(body);
    var dir := LAnc.Backward;
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    NoTrueQuantStamp(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    ReplayCapAgreeFreshLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, body, ncap, nlook, nquant);
  }

  /** A FRESH body match is well-formed (register arrays keep length `ncap`/etc.).
      The fresh run's clocks start at -1 <= 0, so the clock/reg backbone applies
      (`FInitState{ClocksLE,RegsWf}` + `FFindMatchThreadFacts`). This pins the
      length of the value-lift's fresh reference, which `RegsAgreeInside` needs. */
  lemma FreshMatchWf(bytecode: RB.code, str: string, cp: int, ov: LOr.OracleView, cdn: LCdn.cdns,
                     body: R.regex, ncap: int, nlook: int, nquant: int)
    requires NR.LookBehindFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(body)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    ensures var rf := AI.FFindMatch(bytecode, str,
                                    AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                                    ov, LAnc.Forward, cdn).0;
            rf.Some? ==> CM.ThreadRegsWf(rf.value, ncap, nlook, nquant)
  {
    var dir := LAnc.Forward;
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                               AReg.init_regs(nquant), 0, ctx);
    CM.RegsClocksLEInit(ncap, 0);
    CM.RegsClocksLEInit(nlook, 0);
    CM.RegsClocksLEInit(nquant, 0);
    CM.FInitStateClocksLE(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                          AReg.init_regs(nquant), 0, ctx);
    CM.FInitStateRegsWf(bytecode, cp, ncap, nlook, nquant, 0, ctx);
    NoTrueQuantStamp(body);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)));
    }
    FFindMatchThreadFacts(bytecode, str, inits, ov, dir, cdn, ncap, nlook, nquant);
  }

  /** L3b: register well-formedness of the FRESH BACKWARD lookbehind match -- the
      lookbehind twin of `FreshMatchWf`. `FFindMatchThreadFacts` is forward-only, but
      the dir-generic `FFindMatchRegsWf` gives `ThreadRegsWf` (which is all the quant
      value lift's assemble needs) from the fresh-init `VmRegsWf`. */
  lemma FreshMatchWfLB(bytecode: RB.code, str: string, cp: int, ov: LOr.OracleView, cdn: LCdn.cdns,
                       body: R.regex, ncap: int, nlook: int, nquant: int)
    requires NR.PlusFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    ensures var rf := AI.FFindMatch(bytecode, str,
                                    AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                                    ov, LAnc.Backward, cdn).0;
            rf.Some? ==> CM.ThreadRegsWf(rf.value, ncap, nlook, nquant)
  {
    var dir := LAnc.Backward;
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                               AReg.init_regs(nquant), 0, ctx);
    CM.FInitStateRegsWf(bytecode, cp, ncap, nlook, nquant, 0, ctx);
    FFindMatchRegsWf(bytecode, str, inits, ov, dir, cdn, ncap, nlook, nquant);
  }

  /** The lookahead replay preserves register well-formedness: from a `VmRegsWf`
      seed the FFindMatch result is `ThreadRegsWf` (`FFindMatchRegsWf`, no clock
      bound), and `FReconstructPlus` is the identity (`FNulledPlusIdentity`), so
      the FFindMatchPlus result is `ThreadRegsWf` too. Threads the fold's register
      lengths + `CapRegWf` past each replay. */
  lemma ReplayThreadWfLA(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                         qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                         body: R.regex, la: R.lookaround, ncap: int, nlook: int, nquant: int)
    requires NR.LookBehindFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead?
    requires bytecode == CP.compile_to_bytecode(body)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires PIV.CapRegWf(cap)
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Forward, cp, cap, lk, qt, 0, lookcdn).0;
      result.Some? ==> CM.ThreadRegsWf(result.value, ncap, nlook, nquant)
  {
    var dir := LAnc.Forward;
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctx);
    assert CM.VmRegsWf(inits, ncap, nlook, nquant) by {
      assert CM.ThreadRegsWf(AI.init_thread(cap, lk, qt), ncap, nlook, nquant);
      assert inits.active == [AI.init_thread(cap, lk, qt)];
      forall t | t in inits.active ensures CM.ThreadRegsWf(t, ncap, nlook, nquant) {}
    }
    FFindMatchRegsWf(bytecode, str, inits, ov, dir, lookcdn, ncap, nlook, nquant);   // ThreadRegsWf(fmres)
    NoTrueQuantStamp(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
  }

  /** L3b: register well-formedness of the BACKWARD capturing-lookbehind replay --
      the lookbehind twin of `ReplayThreadWfLA`. `FFindMatchRegsWf` is dir-generic;
      the reversed-body statics come from the `Reverse*` helpers. */
  lemma ReplayThreadWfLB(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                         qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                         body: R.regex, ncap: int, nlook: int, nquant: int)
    requires NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires PIV.CapRegWf(cap)
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
      result.Some? ==> CM.ThreadRegsWf(result.value, ncap, nlook, nquant)
  {
    var rev := R.reverse_regex(body);
    PIV.ReversePlusFragment(body);
    NR.PlusIsLookBehindFragmentRE(rev);
    PIV.ReverseCapUnique(body);
    PIV.ReverseQuantUnique(body);
    var dir := LAnc.Backward;
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    assert CM.VmRegsWf(inits, ncap, nlook, nquant) by {
      assert CM.ThreadRegsWf(AI.init_thread(cap, lk, qt), ncap, nlook, nquant);
      assert inits.active == [AI.init_thread(cap, lk, qt)];
      forall t | t in inits.active ensures CM.ThreadRegsWf(t, ncap, nlook, nquant) {}
    }
    FFindMatchRegsWf(bytecode, str, inits, ov, dir, lookcdn, ncap, nlook, nquant);
    NoTrueQuantStamp(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
  }

  /** The per-lid input-context health `ReplayCapAgreeFresh`/`FreshMatchWf` need. */
  ghost predicate cp_ctx_ok(crv: CP.FCompiled, str: string, lk: AReg.Regs, l: int)
    requires AReg.get_cp(lk, l).Some?
  {
    var cp := AReg.get_cp(lk, l).value;
    0 <= cp <= |str| && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
  }

  /** (S-i) cp_ctx_ok on the WINNING thread, from the cp-bound. A forward main
      match starting FRESH records only look cps in `[0, |str|]` (`CM.FFindMatch
      LookCpOk`), and `cp_context`'s forward `nextchar` is definitional -- so every
      recorded look cp satisfies `cp_ctx_ok`. This is the (S-i) piece the value
      lift's `cp_ctx_ok` hypothesis needs; it does NOT require the exact
      look-position <-> tree correspondence. */
  lemma MainMatchCpCtxOk(crv: CP.FCompiled, code: RB.code, str: string, inits: AI.VmState,
                         cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs, nlook: int,
                         ov: LOr.OracleView, cdn: LCdn.cdns, result: Option<AI.Thread>)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str|
    requires look == AReg.init_regs(nlook)
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              forall l: int :: AReg.get_cp(result.value.look_regs, l).Some? ==>
                                 cp_ctx_ok(crv, str, result.value.look_regs, l)
  {
    // fresh init threads have all look cps == -1 <= |str|
    assert CM.VmLookCpOk(inits, |str|) by {
      assert CM.LookCpsLE(look, |str|) by {
        forall l: int ensures AI.get_idx(look.a_cp, l) <= |str| {
          if 0 <= l < |look.a_cp| { assert look.a_cp[l] == -1; }
        }
      }
      assert AI.init_thread(cap, look, quant).look_regs == look;
    }
    CM.FFindMatchLookCpOk(code, str, inits, ov, LAnc.Forward, cdn);
    if result.Some? {
      var lk := result.value.look_regs;
      assert CM.LookCpsLE(lk, |str|);
      forall l: int | AReg.get_cp(lk, l).Some? ensures cp_ctx_ok(crv, str, lk, l) {
        var cp := AReg.get_cp(lk, l).value;
        assert 0 <= l < |lk.a_cp| && cp == AI.get_idx(lk.a_cp, l) && cp >= 0;   // get_cp Some => a_cp[l] >= 0
        assert cp <= |str|;                                                      // LookCpsLE
      }
    }
  }

  /** L3a (E): the `get_idx(lc, lid) >= 0` half of `PIV.PathPresentLk`'s
      matched-lookaround condition, on the WINNING thread. A look whose cp was
      recorded (its `CheckOracle` fired on this thread's path) also carries a
      non-negative clock stamp, because both slots land in one `set_reg`. The
      `>= mx` half is coupled to the enclosing quant clocks and is NOT proved
      here — it is part of the outstanding position/structure gate. Companion to
      `MainMatchCpCtxOk`, same fresh-entry shape. */
  lemma MainMatchLookClkSet(code: RB.code, str: string, inits: AI.VmState,
                            cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs, nlook: int,
                            ov: LOr.OracleView, cdn: LCdn.cdns, result: Option<AI.Thread>)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str|
    requires inits.clock >= 0
    requires look == AReg.init_regs(nlook)
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              forall l: int :: AReg.get_cp(result.value.look_regs, l).Some? ==>
                                 AI.get_idx(result.value.look_regs.a_clk, l) >= 0
  {
    // fresh init threads have every look cp == -1, so the implication is vacuous
    assert CM.VmLookClkSet(inits) by {
      assert CM.LookClkSetWithCp(look) by {
        forall l: int | AI.get_idx(look.a_cp, l) >= 0 ensures AI.get_idx(look.a_clk, l) >= 0 {
          if 0 <= l < |look.a_cp| { assert look.a_cp[l] == -1; }
        }
      }
      assert AI.init_thread(cap, look, quant).look_regs == look;
    }
    CM.FFindMatchLookClkSet(code, str, inits, ov, LAnc.Forward, cdn);
    if result.Some? {
      var lk := result.value.look_regs;
      assert CM.LookClkSetWithCp(lk);
      forall l: int | AReg.get_cp(lk, l).Some? ensures AI.get_idx(lk.a_clk, l) >= 0 {
        assert 0 <= l < |lk.a_cp| && AI.get_idx(lk.a_cp, l) >= 0;   // get_cp Some => a_cp[l] >= 0
      }
    }
  }

  /** L3a (E2): the MAIN pass never stamps an inside-look quant — every
      `SetQuantToClock` in the fragment code targets `QuantIdsOutsideLooks(re)`
      (`PIV.QuantWriteIdsRE`, L3a-sharpened) — so a genuine-start search
      returns a winning thread whose quant bank still agrees with the INITIAL
      bank outside that set. In particular every look body's quant slots are
      EXACTLY initial: the entry fact of the FLookLoop quant value lift
      (`ReplayLidCapQuantAgreeFresh`'s body-quants-INIT hypothesis). */
  lemma MainMatchBodyQuantsInit(re: R.regex, code: RB.code, endl: nat, str: string,
                                inits: AI.VmState, cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
                                ov: LOr.OracleView, cdn: LCdn.cdns, result: Option<AI.Thread>)
    requires NR.LookBehindFragmentRE(re) && PIV.QuantUnique(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures var S := set q: nat | q in PIV.QuantIdsOutsideLooks(re) :: q as int;
            result.Some? ==> CM.RegsAgreeOutside(result.value.quant_regs, quant, S)
  {
    var S := set q: nat | q in PIV.QuantIdsOutsideLooks(re) :: q as int;
    assert CM.QuantWritesInside(code, S) by {
      forall pc: nat | pc < |code| ensures code[pc].SetQuantToClock? ==> code[pc].sq in S {
        assert NR.GetPcRE(code, pc) == Some(code[pc]);
        if pc < endl {
          PIV.QuantWriteIdsRE(re, code, 0, endl, pc);
          if code[pc].SetQuantToClock? {
            var qn: nat := code[pc].sq as nat;
            assert qn in PIV.QuantIdsOutsideLooks(re);
            assert (qn as int) in S;
          }
        } else {
          assert pc == endl;                          // the Accept terminator
        }
      }
    }
    assert CM.VmQuantsAgree(inits, quant, S) by {
      assert AI.init_thread(cap, look, quant).quant_regs == quant;
      assert CM.RegsAgreeOutside(quant, quant, S);
    }
    CM.FFindMatchQuantFrame(code, str, inits, ov, LAnc.Forward, cdn, quant, S);
  }

  /** L3a (E4): the MAIN pass writes only OUTSIDE-look capture registers
      (`PIV.CaptureWriteIdsOutsideRE` per pc), so a genuine-start search
      returns a winning thread whose INSIDE-look capture slots are EXACTLY
      initial — value and clock both `-1`. The reverse tie's unmatched-owner
      case reads this: an untouched owner leaves `res0`'s slot unset. */
  lemma MainMatchInsideCapsInit(re: R.regex, code: RB.code, endl: nat, str: string,
                                inits: AI.VmState, cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
                                ov: LOr.OracleView, cdn: LCdn.cdns, result: Option<AI.Thread>)
    requires NR.LookBehindFragmentRE(re) && PIV.CapUnique(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures var Sc := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re));
            result.Some? ==> CM.RegsAgreeOutside(result.value.capture_regs, cap, Sc)
  {
    var Sc := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re));
    assert CM.CaptureWritesInside(code, Sc) by {
      forall pc: nat | pc < |code| ensures code[pc].SetRegisterToCP? ==> code[pc].reg in Sc {
        assert NR.GetPcRE(code, pc) == Some(code[pc]);
        if pc < endl {
          PIV.CaptureWriteIdsOutsideRE(re, code, 0, endl, pc);
        } else {
          assert pc == endl;                          // the Accept terminator
        }
      }
    }
    assert CM.VmCapturesAgree(inits, cap, Sc) by {
      assert AI.init_thread(cap, look, quant).capture_regs == cap;
      assert CM.RegsAgreeOutside(cap, cap, Sc);
    }
    CM.FFindMatchCapWriteFrame(code, str, inits, ov, LAnc.Forward, cdn, cap, Sc);
  }

  /** (L4 NESTED, D3) `MainMatchInsideCapsInit` for the NESTED fragment: the MAIN
      code of a nested body writes only OUTSIDE-look capture registers
      (`PIV.CaptureWriteIdsOutsideRENested` per pc — a lookaround is a single
      `CheckOracle` leaf, so inner-look captures are never touched by the body's
      main pass). So a genuine-start search leaves the INSIDE-look capture slots
      EXACTLY at `cap`. The gate-pass preserver's (E4) backward coverage reads
      this: the fresh body match leaves inner-look groups unset, so
      `GmOfLive(body, rf)` is confined to the body's OUTER groups
      (`GmOfLiveInsideLookAbsent`), which `LkReplayMatchesSpecNested` covers. */
  lemma MainMatchInsideCapsInitNested(re: R.regex, code: RB.code, endl: nat, str: string,
                                      inits: AI.VmState, cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
                                      ov: LOr.OracleView, cdn: LCdn.cdns, result: Option<AI.Thread>)
    requires NR.NestedFragmentRE(re) && PIV.CapUnique(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures var Sc := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re));
            result.Some? ==> CM.RegsAgreeOutside(result.value.capture_regs, cap, Sc)
  {
    var Sc := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re));
    assert CM.CaptureWritesInside(code, Sc) by {
      forall pc: nat | pc < |code| ensures code[pc].SetRegisterToCP? ==> code[pc].reg in Sc {
        assert NR.GetPcRE(code, pc) == Some(code[pc]);
        if pc < endl {
          PIV.CaptureWriteIdsOutsideRENested(re, code, 0, endl, pc);
        } else {
          assert pc == endl;                          // the Accept terminator
        }
      }
    }
    assert CM.VmCapturesAgree(inits, cap, Sc) by {
      assert AI.init_thread(cap, look, quant).capture_regs == cap;
      assert CM.RegsAgreeOutside(cap, cap, Sc);
    }
    CM.FFindMatchCapWriteFrame(code, str, inits, ov, LAnc.Forward, cdn, cap, Sc);
  }

  /** L3a (S-i): on the WINNING thread, every recorded look cp is a position
      where that look's ORACLE BIT IS SET — `CheckOracle` writes `a_cp[l]` only
      on the branch that just read the bit, and the main pass never writes the
      view. Same fresh-entry shape as `MainMatchCpCtxOk`. */
  lemma MainMatchLookOracleTrue(code: RB.code, str: string, inits: AI.VmState,
                                cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs, nlook: int,
                                ov: LOr.OracleView, cdn: LCdn.cdns, result: Option<AI.Thread>)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires CM.NoWriteOracleCode(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str|
    requires look == AReg.init_regs(nlook)
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==> CM.LookCpsOracleTrue(result.value.look_regs, ov)
  {
    // fresh init threads have every look cp == -1, so the guard is vacuous
    assert CM.VmLookOracleTrue(inits, ov) by {
      assert CM.LookCpsOracleTrue(look, ov) by {
        forall l: int | AI.get_idx(look.a_cp, l) >= 0
          ensures LOr.view_get_oracle(ov, AI.get_idx(look.a_cp, l), l)
        {
          if 0 <= l < |look.a_cp| { assert look.a_cp[l] == -1; }
        }
      }
      assert AI.init_thread(cap, look, quant).look_regs == look;
    }
    CM.FFindMatchLookOracleTrue(code, str, inits, ov, LAnc.Forward, cdn);
  }

  /** L3a (S-i) PAYOFF: the SPEC look `l` MATCHES at the engine's recorded
      `a_cp[l]`. The engine says the bit is set there (`LookCpsOracleTrue`);
      `OracleOkAt` says the bit at a position is exactly the spec body's verdict
      there. So the two candidate positions of the §2 gate — the engine's
      `a_cp[l]` and the spec LK node's `inp_l` — are BOTH positions at which look
      `l` matches. That is the engine-side half of the oracle-uniqueness
      argument; identifying them still needs the path-uniqueness half (that on
      the priority-first winning path the look is crossed at a UNIQUE position),
      which is NOT proved here. */
  lemma LookCpSpecMatch(rer: LW.RegExpRecord, qm: AR.QMap, str: string, lk: AReg.Regs,
                        l: int, lkr: L.Lookaround, r1: L.Regex)
    requires CM.LookCpsOracleTrue(lk, qm.ov)
    requires CM.LookCpsLE(lk, |str|)
    requires AI.get_idx(lk.a_cp, l) >= 0
    requires l in qm.looks && qm.looks[l] == (lkr, r1)
    requires LL.OracleOkAt(rer, qm, PIV.InpOfCp(str, AI.get_idx(lk.a_cp, l) as nat))
    ensures var inpl := PIV.InpOfCp(str, AI.get_idx(lk.a_cp, l) as nat);
            LT.TreeRes(FU.ComputeTr(rer, [LS.Areg(r1)], inpl, LG.Empty, L.LkDir(lkr)),
                       LG.Empty, inpl, L.LkDir(lkr)).Some?
  {
    var cp := AI.get_idx(lk.a_cp, l) as nat;          // 0 <= cp <= |str| (LookCpsLE)
    var inpl := PIV.InpOfCp(str, cp);
    assert TR.CpOf(inpl) == cp by { LS.ReverseLength(str[..cp]); }
    assert LOr.view_get_oracle(qm.ov, cp, l);         // LookCpsOracleTrue at l
  }

  /** L3a §2 SPEC-SIDE GATE POSITION. When the action walk's head is a
      lookaround, `BoolTreeLk` FORCES the spec tree at that point to be the
      lookaround's own node — `LK` on a pass, `LKFail` on a kill — and
      `LkGateOk` pins its body tree to `ComputeTr(.., inp, ..)` at THAT SAME
      `inp`. So the LK node's position is definitionally the walk's current
      input; there is no separate position theorem to prove on this side.
      Pure inversion of the `least predicate`, so it costs nothing.

      This is the half of §2's `GatePos(tstar,l) == inp_l` that lives on the
      spec: `ActionsTreeRepFRE`'s gate case pins `lid` from the `CheckOracle`
      instruction at `pc` while holding `t` at `inp`, and this says that `t`
      is then lid's LK node AT `inp`. It is stated here rather than in
      `EntryLk` to keep the change inside a file with a fresh baseline.

      What it does NOT give: the tie to the ENGINE's `a_cp[l]`. That needs the
      winning thread's PATH to be matched to the first-leaf path of `tstar`,
      and the simulation state carries no history to express it (see the
      session notes). */
  lemma GateNodeAtInp(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                      b: BS.LoopBool, t: LT.Tree, lk: L.Lookaround, r1: L.Regex)
    requires |acts| > 0 && acts[0] == LS.Areg(L.LookaroundR(lk, r1))
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    ensures (t.LK? && t.lk == lk
             && EL.LkGateOk(rer, lk, r1, inp, t.tlk, true)
             && EL.BoolTreeLk(rer, acts[1..], inp, b, t.t))
            || (t.LKFail? && t.lk == lk && EL.LkGateOk(rer, lk, r1, inp, t.tlk, false))
  {
    // unfold the gate case: the match on `t` admits only LK / LKFail
  }

  /** Corollary in the form §2 wants it: the body tree hanging at the gate is
      the one computed AT `inp`, i.e. the gate's position is `TR.CpOf(inp)`. */
  lemma GatePosIsWalkInp(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                         b: BS.LoopBool, t: LT.Tree, lk: L.Lookaround, r1: L.Regex)
    requires |acts| > 0 && acts[0] == LS.Areg(L.LookaroundR(lk, r1))
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    ensures t.LK? || t.LKFail?
    ensures t.tlk == FU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk))
  {
    GateNodeAtInp(rer, acts, inp, b, t, lk, r1);
  }

  /** L3a §2 CHECKED-SIDE GATE POSITION — the mirror of `GateNodeAtInp`. At a
      `CheckOracle(lid)` pc every other `TreeRepRE` disjunct pins a different
      instruction, so only the gate rule can apply: on a set bit the derivation
      carries the SAME tree on to `pc+1` at the SAME `inp` (the transparency
      `TT.StuttersRE` records), and on a clear bit the tree is `Mismatch`.
      Pure inversion, in the style of `TT.TtAtJmp`. */
  lemma GateFiresAtWalkInp(qm: AR.QMap, tstar: LT.Tree, code: RB.code, pc: nat,
                           inp: LC.Input, b: bool, lid: int)
    requires TR.TreeRepRE(qm, tstar, code, pc, inp, b)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    ensures LOr.view_get_oracle(qm.ov, TR.CpOf(inp), lid) ==>
              TR.TreeRepRE(qm, tstar, code, pc + 1, inp, b)
    ensures !LOr.view_get_oracle(qm.ov, TR.CpOf(inp), lid) ==> tstar == LT.Mismatch
  {
  }

  /** The cp-level reading of the mirror, in the form the simulation supplies
      its inputs: a derivation standing at lid's gate with the VM at `cp` fires
      that gate AT `cp` — because `PIV.PikeInvRE`'s `PTS` case carries
      `inp == InpOfCp(str, vms.cp)`, so the derivation's input at every step IS
      the VM's cp.

      Together with `GateNodeAtInp` (spec side) both halves of §2's position
      question are now local inversions: the gate fires at the walk's `inp` on
      BOTH sides. What is still missing to close the gate is neither of these —
      it is that the crossing which wrote the winning thread's FINAL `a_cp[l]`
      is the one on the first-leaf path (the sim relates threads to `tstar`
      subtrees, and a subtree does not know the path taken to reach it). */
  lemma GateFiresAtCp(qm: AR.QMap, tstar: LT.Tree, code: RB.code, pc: nat,
                      str: string, cp: nat, b: bool, lid: int)
    requires cp <= |str|
    requires TR.TreeRepRE(qm, tstar, code, pc, PIV.InpOfCp(str, cp), b)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    requires LOr.view_get_oracle(qm.ov, cp, lid)
    ensures TR.TreeRepRE(qm, tstar, code, pc + 1, PIV.InpOfCp(str, cp), b)
  {
    var inp := PIV.InpOfCp(str, cp);
    assert TR.CpOf(inp) == cp by { LS.ReverseLength(str[..cp]); }
    GateFiresAtWalkInp(qm, tstar, code, pc, inp, b, lid);
  }

  /** Agreeing OUTSIDE `Sp` and equal lengths give agreement INSIDE any `T`
      disjoint from `Sp`. Isolated so the set step doesn't drag heavy context. */
  lemma RegsAgreeOutsideToInside(a: AReg.Regs, b: AReg.Regs, T: set<int>, Sp: set<int>)
    requires CM.RegsAgreeOutside(a, b, Sp)
    requires |a.a_cp| == |b.a_cp| && |a.a_clk| == |b.a_clk|
    requires forall k: int :: k in T ==> k !in Sp
    ensures CM.RegsAgreeInside(a, b, T)
  {}

  /** THE FLookLoop VALUE LIFT (lookahead-only fold). On each matched positive
      lookahead's own capture registers, the fold result carries that body's
      FRESH match; and the fold preserves register lengths. Every capturing lid is
      a lookahead (`requires`, discharged by the caller for lookahead-capturing
      regexes; capture-free lookbehinds are L1 and can be admitted later). */
  lemma {:isolate_assertions} FLookLoopValueLift(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                                                 cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                                 mainast: R.regex, S: set<int>, ncap: int, nlook: int, nquant: int)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires NR.LookBehindFragmentRE(mainast) && PIV.QuantUnique(mainast)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex ::
                                  LTB.LookEntryOk(crv, l, la, body)
                                  && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
                                  && PIV.CapUnique(body) && PIV.QuantUnique(body)
                                  && PIV.CaptureRegs(body) <= S
                                  && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(mainast))
                                  && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body))
    // NOTE (L3a full fragment): NO lookahead-only requires. A capturing body is
    // necessarily a positive forward lookahead (fragment), and capture-free
    // positive lookbehinds are stepped through as the identity below -- so the
    // value lift holds for the whole fragment (lookbehinds included).
    // each matched body's own registers are UNSET in the incoming `cap`
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l)))
    // distinct matched lids write DISJOINT capture registers
    requires forall l1: int, l2: int ::
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 != l2
               && AReg.get_cp(lk, l1).Some? && AReg.get_cp(lk, l2).Some? ==>
                 PIV.CaptureRegs(VBody(crv, l1)) * PIV.CaptureRegs(VBody(crv, l2)) == {}
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==> cp_ctx_ok(crv, str, lk, l)
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            |res.0.a_cp| == ncap && |res.0.a_clk| == ncap && PIV.CapRegWf(res.0)
            && FLookLoopValueOk(crv, str, res.0, lid, maxlook, lk, ov, ncap, nlook, nquant)
    decreases maxlook - lid
  {
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    if lid > maxlook {
      assert res.0 == cap;
      return;
    }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
      FLookLoopValueLift(crv, str, next, maxlook, cap, lk, qt, ov, mainast, S, ncap, nlook, nquant);
      ValueOkSkipLid(crv, str, res.0, lid, maxlook, lk, ov, ncap, nlook, nquant);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
        FLookLoopValueLift(crv, str, next, maxlook, cap, lk, qt, ov, mainast, S, ncap, nlook, nquant);
        ValueOkSkipLid(crv, str, res.0, lid, maxlook, lk, ov, ncap, nlook, nquant);
      } else {
        var la: R.lookaround, body: R.regex :|
          LTB.LookEntryOk(crv, lid, la, body)
          && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
          && PIV.CapUnique(body) && PIV.QuantUnique(body)
          && PIV.CaptureRegs(body) <= S
          && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(mainast))
          && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
        assert looktype == la;
        assert body == VBody(crv, lid);
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var capN := if result.None? then cap else result.value.capture_regs;
        var lkN := if result.None? then lk else result.value.look_regs;
        var qtN := if result.None? then qt else result.value.quant_regs;
        assert res == AI.FLookLoop(crv, str, next, maxlook, capN, lkN, qtN, ov1);
        NR.PlusIsLookBehindFragmentRE(body);
        // capture_type(la) holds => la is Lookahead (positive forward, may
        // capture) or Lookbehind (capture-free -> the identity on captures).
        if la.Lookahead? {
          assert dir == LAnc.Forward && CP.capture_regex(la, body) == body;
          assert bytecode == CP.compile_to_bytecode(body);
          FFindMatchPlusOvStable(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
          assert ov1 == ov;
          ReplayPlusFrame(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
          assert CM.RegsAgreeOutside(capN, cap, PIV.CaptureRegs(body)) && lkN == lk;
          assert (forall k :: AI.get_idx(qtN.a_cp, k) < 0) && (forall k :: AI.get_idx(qtN.a_clk, k) >= -1);
          ReplayThreadWfLA(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant);
          assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
                 && |qtN.a_cp| == nquant && |qtN.a_clk| == nquant by {
            if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
          }

          // ---- value at lid: result ~ rfLid on CaptureRegs(body) ----
          assert cp_ctx_ok(crv, str, lk, lid);
          assert 0 <= cp <= |str| && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp);
          ReplayLidCapAgreeFresh(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant);
          FreshMatchWf(bytecode, str, cp, ov, lookcdn, body, ncap, nlook, nquant);
          var rfLid := FreshBodyMatch(crv, str, lid, lk, ov, ncap, nlook, nquant);
          var rf := AI.FFindMatch(bytecode, str,
                                  AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                                  ov, LAnc.Forward, lookcdn).0;
          assert rfLid == rf;                      // VBody(lid)==body, cdn==lookcdn, cp matches

          // ---- suffix bundle at S' = S - CaptureRegs(body); frame ----
          var Sp := S - PIV.CaptureRegs(body);
          assert forall l: int :: next <= l <= maxlook && AReg.get_cp(lkN, l).Some? ==>
                                    exists la2: R.lookaround, body2: R.regex ::
                                      LTB.LookEntryOk(crv, l, la2, body2)
                                      && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                                      && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                                      && PIV.CaptureRegs(body2) <= Sp
                                      && (forall q: nat :: q in PIV.QuantIds(body2) ==> q in PIV.QuantIdsInLooks(mainast))
                                      && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2))
          by {
            forall l: int | next <= l <= maxlook && AReg.get_cp(lkN, l).Some?
              ensures exists la2: R.lookaround, body2: R.regex ::
                        LTB.LookEntryOk(crv, l, la2, body2)
                        && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                        && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                        && PIV.CaptureRegs(body2) <= Sp
                        && (forall q: nat :: q in PIV.QuantIds(body2) ==> q in PIV.QuantIdsInLooks(mainast))
                        && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2))
            {
              assert AReg.get_cp(lk, l).Some?;
              var la2: R.lookaround, body2: R.regex :|
                LTB.LookEntryOk(crv, l, la2, body2)
                && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                && PIV.CaptureRegs(body2) <= S
                && (forall q: nat :: q in PIV.QuantIds(body2) ==> q in PIV.QuantIdsInLooks(mainast))
                && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2));
              assert body2 == VBody(crv, l) && body == VBody(crv, lid);
              assert PIV.CaptureRegs(VBody(crv, l)) * PIV.CaptureRegs(VBody(crv, lid)) == {};   // pairwise
              assert PIV.CaptureRegs(body2) * PIV.CaptureRegs(body) == {};
              assert PIV.CaptureRegs(body2) <= Sp by {
                forall k: int | k in PIV.CaptureRegs(body2) ensures k in Sp {
                  assert k in S;
                  assert k !in PIV.CaptureRegs(body) by {
                    if k in PIV.CaptureRegs(body) { assert k in PIV.CaptureRegs(body2) * PIV.CaptureRegs(body); }
                  }
                }
              }
            }
          }
          // ---- IH at [next] with capN (per-body-unset preserved by disjointness) ----
          assert forall l: int :: next <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                    CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l)))
          by {
            forall l: int | next <= l <= maxlook && AReg.get_cp(lk, l).Some?
              ensures CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l)))
            {
              assert body == VBody(crv, lid);
              assert PIV.CaptureRegs(VBody(crv, l)) * PIV.CaptureRegs(VBody(crv, lid)) == {};   // pairwise
              assert PIV.CaptureRegs(VBody(crv, l)) * PIV.CaptureRegs(body) == {};
              assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l)));   // per-body-unset
              forall k: int | k in PIV.CaptureRegs(VBody(crv, l))
                ensures AI.get_idx(capN.a_cp, k) == AI.get_idx(AReg.init_regs(ncap).a_cp, k)
                        && AI.get_idx(capN.a_clk, k) == AI.get_idx(AReg.init_regs(ncap).a_clk, k)
              {
                assert k !in PIV.CaptureRegs(body) by {
                  if k in PIV.CaptureRegs(body) { assert k in PIV.CaptureRegs(VBody(crv, l)) * PIV.CaptureRegs(body); }
                }
                assert AI.get_idx(capN.a_cp, k) == AI.get_idx(cap.a_cp, k);   // capN ~ cap off body
              }
            }
          }
          FLookLoopValueLift(crv, str, next, maxlook, capN, lkN, qtN, ov1, mainast, S, ncap, nlook, nquant);
          assert FLookLoopValueOk(crv, str, res.0, next, maxlook, lk, ov, ncap, nlook, nquant);
          assert |res.0.a_cp| == ncap && |res.0.a_clk| == ncap;   // from the IH ensures

          // ---- frame: res.0 == capN on CaptureRegs(body) (suffix writes disjoint regs) ----
          FLookLoopCaptureFrame(crv, str, next, maxlook, capN, lkN, qtN, ov1, mainast, Sp);
          assert CM.RegsAgreeOutside(res.0, capN, Sp);
          assert forall k: int :: k in PIV.CaptureRegs(body) ==> k !in Sp;
          RegsAgreeOutsideToInside(res.0, capN, PIV.CaptureRegs(body), Sp);
          assert CM.RegsAgreeInside(res.0, capN, PIV.CaptureRegs(body));

          // ---- assemble FLookLoopValueOk for [lid] ----
          forall l: int | lid <= l <= maxlook && MatchedPosLA(crv, lk, l)
            ensures var rf2 := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
                    (rf2.Some? ==> CM.RegsAgreeInside(res.0, rf2.value.capture_regs, PIV.CaptureRegs(VBody(crv, l))))
                    && (rf2.None? ==> CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l))))
          {
            if l == lid {
              if rfLid.Some? {
                assert result.Some? && CM.RegsAgreeInside(result.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body));
                assert CM.RegsAgreeInside(res.0, rfLid.value.capture_regs, PIV.CaptureRegs(body));
              } else {
                assert result.None? && capN == cap;
                assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body));   // per-body-unset(lid)
                assert CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), PIV.CaptureRegs(body));
              }
            }
          }
        } else {
          // ---- CAPTURING positive LOOKBEHIND (L3b): the backward capture replay,
          //      value-lifted exactly like the lookahead branch but with the
          //      lookbehind frames/bisimulation over compile_to_bytecode(reverse_regex(body)). ----
          assert la.Lookbehind?;
          assert dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body);
          assert bytecode == CP.compile_to_bytecode(R.reverse_regex(body));
          assert cp_ctx_ok(crv, str, lk, lid);
          assert 0 <= cp <= |str|;
          assert AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1);
          FFindMatchPlusOvStableLB(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
          assert ov1 == ov;
          ReplayPlusFrameLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body);
          assert CM.RegsAgreeOutside(capN, cap, PIV.CaptureRegs(body)) && lkN == lk;
          assert (forall k :: AI.get_idx(qtN.a_cp, k) < 0) && (forall k :: AI.get_idx(qtN.a_clk, k) >= -1);
          ReplayThreadWfLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant);
          assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
                 && |qtN.a_cp| == nquant && |qtN.a_clk| == nquant by {
            if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
          }

          // ---- value at lid: result ~ rf on CaptureRegs(body) (backward bisimulation) ----
          ReplayLidCapAgreeFreshLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant);
          var rfLid := FreshBodyMatch(crv, str, lid, lk, ov, ncap, nlook, nquant);
          var rf := AI.FFindMatch(bytecode, str,
                                  AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                                  ov, LAnc.Backward, lookcdn).0;
          assert rfLid == rf;                      // FreshBodyMatch(lid) dispatches to this backward run

          // ---- suffix bundle at S' = S - CaptureRegs(body); frame (direction-independent) ----
          var Sp := S - PIV.CaptureRegs(body);
          assert forall l: int :: next <= l <= maxlook && AReg.get_cp(lkN, l).Some? ==>
                                    exists la2: R.lookaround, body2: R.regex ::
                                      LTB.LookEntryOk(crv, l, la2, body2)
                                      && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                                      && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                                      && PIV.CaptureRegs(body2) <= Sp
                                      && (forall q: nat :: q in PIV.QuantIds(body2) ==> q in PIV.QuantIdsInLooks(mainast))
                                      && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2))
          by {
            forall l: int | next <= l <= maxlook && AReg.get_cp(lkN, l).Some?
              ensures exists la2: R.lookaround, body2: R.regex ::
                        LTB.LookEntryOk(crv, l, la2, body2)
                        && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                        && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                        && PIV.CaptureRegs(body2) <= Sp
                        && (forall q: nat :: q in PIV.QuantIds(body2) ==> q in PIV.QuantIdsInLooks(mainast))
                        && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2))
            {
              assert AReg.get_cp(lk, l).Some?;
              var la2: R.lookaround, body2: R.regex :|
                LTB.LookEntryOk(crv, l, la2, body2)
                && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                && PIV.CaptureRegs(body2) <= S
                && (forall q: nat :: q in PIV.QuantIds(body2) ==> q in PIV.QuantIdsInLooks(mainast))
                && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2));
              assert body2 == VBody(crv, l) && body == VBody(crv, lid);
              assert PIV.CaptureRegs(VBody(crv, l)) * PIV.CaptureRegs(VBody(crv, lid)) == {};   // pairwise
              assert PIV.CaptureRegs(body2) * PIV.CaptureRegs(body) == {};
              assert PIV.CaptureRegs(body2) <= Sp by {
                forall k: int | k in PIV.CaptureRegs(body2) ensures k in Sp {
                  assert k in S;
                  assert k !in PIV.CaptureRegs(body) by {
                    if k in PIV.CaptureRegs(body) { assert k in PIV.CaptureRegs(body2) * PIV.CaptureRegs(body); }
                  }
                }
              }
            }
          }
          // ---- IH at [next] with capN (per-body-unset preserved by disjointness) ----
          assert forall l: int :: next <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                    CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l)))
          by {
            forall l: int | next <= l <= maxlook && AReg.get_cp(lk, l).Some?
              ensures CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l)))
            {
              assert body == VBody(crv, lid);
              assert PIV.CaptureRegs(VBody(crv, l)) * PIV.CaptureRegs(VBody(crv, lid)) == {};   // pairwise
              assert PIV.CaptureRegs(VBody(crv, l)) * PIV.CaptureRegs(body) == {};
              assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l)));   // per-body-unset
              forall k: int | k in PIV.CaptureRegs(VBody(crv, l))
                ensures AI.get_idx(capN.a_cp, k) == AI.get_idx(AReg.init_regs(ncap).a_cp, k)
                        && AI.get_idx(capN.a_clk, k) == AI.get_idx(AReg.init_regs(ncap).a_clk, k)
              {
                assert k !in PIV.CaptureRegs(body) by {
                  if k in PIV.CaptureRegs(body) { assert k in PIV.CaptureRegs(VBody(crv, l)) * PIV.CaptureRegs(body); }
                }
                assert AI.get_idx(capN.a_cp, k) == AI.get_idx(cap.a_cp, k);   // capN ~ cap off body
              }
            }
          }
          FLookLoopValueLift(crv, str, next, maxlook, capN, lkN, qtN, ov1, mainast, S, ncap, nlook, nquant);
          assert FLookLoopValueOk(crv, str, res.0, next, maxlook, lk, ov, ncap, nlook, nquant);
          assert |res.0.a_cp| == ncap && |res.0.a_clk| == ncap;   // from the IH ensures

          // ---- frame: res.0 == capN on CaptureRegs(body) (suffix writes disjoint regs) ----
          FLookLoopCaptureFrame(crv, str, next, maxlook, capN, lkN, qtN, ov1, mainast, Sp);
          assert CM.RegsAgreeOutside(res.0, capN, Sp);
          assert forall k: int :: k in PIV.CaptureRegs(body) ==> k !in Sp;
          RegsAgreeOutsideToInside(res.0, capN, PIV.CaptureRegs(body), Sp);
          assert CM.RegsAgreeInside(res.0, capN, PIV.CaptureRegs(body));

          // ---- assemble FLookLoopValueOk for [lid] (now a MATCHED positive lookbehind) ----
          forall l: int | lid <= l <= maxlook && MatchedPosLA(crv, lk, l)
            ensures var rf2 := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
                    (rf2.Some? ==> CM.RegsAgreeInside(res.0, rf2.value.capture_regs, PIV.CaptureRegs(VBody(crv, l))))
                    && (rf2.None? ==> CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), PIV.CaptureRegs(VBody(crv, l))))
          {
            if l == lid {
              if rfLid.Some? {
                assert result.Some? && CM.RegsAgreeInside(result.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body));
                assert CM.RegsAgreeInside(res.0, rfLid.value.capture_regs, PIV.CaptureRegs(body));
              } else {
                assert result.None? && capN == cap;
                assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body));   // per-body-unset(lid)
                assert CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), PIV.CaptureRegs(body));
              }
            }
          }
        }
      }
  }

  /** L3a (E2): the value-lift conclusion for the QUANT bank — on each matched
      positive lookahead's own quant slots, `res.2` carries the fresh body
      match's clocks (the body-side quant clauses of `PIV.PathPresentLk` then
      transfer from `PIV.BodyPathPresentLk` by congruence). */
  ghost predicate FLookLoopQuantValueOk(crv: CP.FCompiled, str: string, res2: AReg.Regs, lid: int, maxlook: int,
                                        lk: AReg.Regs, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int) {
    forall l: int :: lid <= l <= maxlook && MatchedPosLA(crv, lk, l) ==>
                       var rf := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
                       rf.Some? ==> CM.RegsAgreeInside(res2, rf.value.quant_regs, LKC.QIdsInt(VBody(crv, l)))
  }

  /** `l == lid` is not a matched positive lookahead, so the quant value map
      for `[lid, maxlook]` is exactly the one for `[lid+1, maxlook]`. */
  lemma QuantValueOkSkipLid(crv: CP.FCompiled, str: string, res2: AReg.Regs, lid: int, maxlook: int,
                            lk: AReg.Regs, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int)
    requires FLookLoopQuantValueOk(crv, str, res2, lid + 1, maxlook, lk, ov, ncap, nlook, nquant)
    requires !MatchedPosLA(crv, lk, lid)
    ensures FLookLoopQuantValueOk(crv, str, res2, lid, maxlook, lk, ov, ncap, nlook, nquant)
  {
    forall l: int | lid <= l <= maxlook && MatchedPosLA(crv, lk, l)
      ensures var rf := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
              rf.Some? ==> CM.RegsAgreeInside(res2, rf.value.quant_regs, LKC.QIdsInt(VBody(crv, l)))
    { assert l != lid; }
  }

  /** L3a (E2): the QUANT-only replay bridge — the `FFindMatchPlus` replay's
      quant bank agrees with the FRESH body match's on `QIdsInt(body)`, with NO
      capture hypotheses (the bisimulation runs at `Sc == {}`: control never
      reads register values, so capture agreement is not needed to stay in
      lockstep). Entry: the body's quant slots are still INITIAL in the
      incoming bank. */
  lemma ReplayLidQuantAgreeFresh(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                 qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                 body: R.regex, la: R.lookaround, ncap: int, nlook: int, nquant: int)
    requires NR.LookBehindFragmentRE(body) && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead?
    requires bytecode == CP.compile_to_bytecode(body)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body))
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Forward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                              ov, LAnc.Forward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==>
            CM.RegsAgreeInside(result.value.quant_regs, rf.value.quant_regs, LKC.QIdsInt(body)))
  {
    var dir := LAnc.Forward;
    var ctxc := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctxc);
    NoTrueQuantStamp(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    var sf := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    assert CM.VmRel(inits, sf, {}, LKC.QIdsInt(body)) by {
      assert CM.ThreadRel(AI.init_thread(cap, lk, qt),
                          AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
    {}, LKC.QIdsInt(body)) by {
        assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), {});
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body));
      }
    }
    CM.FFindMatchCapRel(bytecode, str, inits, sf, ov, dir, lookcdn, {}, LKC.QIdsInt(body));
  }

  /** L3b: the per-lid BACKWARD replay↔fresh QUANT agreement — lookbehind twin of
      `ReplayLidQuantAgreeFresh`. Register-value-blind bisimulation at `Sc == {}`,
      `Sq == QIdsInt(body)`; `FFindMatchCapRel` is dir-generic, so it relates the two
      backward runs of `compile_to_bytecode(reverse_regex(body))` directly on the
      body's own quant slots (no reversed-set rewrite needed for the bisimulation). */
  lemma ReplayLidQuantAgreeFreshLB(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                   qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                   body: R.regex, ncap: int, nlook: int, nquant: int)
    requires NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body))
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                              ov, LAnc.Backward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==>
            CM.RegsAgreeInside(result.value.quant_regs, rf.value.quant_regs, LKC.QIdsInt(body)))
  {
    var rev := R.reverse_regex(body);
    PIV.ReversePlusFragment(body);
    NR.PlusIsLookBehindFragmentRE(rev);
    PIV.ReverseCapUnique(body);
    PIV.ReverseQuantUnique(body);
    var dir := LAnc.Backward;
    var ctxc := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctxc);
    NoTrueQuantStamp(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    var sf := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    assert CM.VmRel(inits, sf, {}, LKC.QIdsInt(body)) by {
      assert CM.ThreadRel(AI.init_thread(cap, lk, qt),
                          AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
    {}, LKC.QIdsInt(body)) by {
        assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), {});
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body));
      }
    }
    CM.FFindMatchCapRel(bytecode, str, inits, sf, ov, dir, lookcdn, {}, LKC.QIdsInt(body));
  }

  /** L3b: the BACKWARD quant WRITE frame — the replay writes quant clocks only
      inside the body's own quant slots (`QIdsInt(reverse_regex(body)) == QIdsInt(body)`
      via `ReverseQuantIds`). Lookbehind analogue of the lookahead branch's inline
      `QuantWritesInsideBody` + `FFindMatchQuantFrame`. Capture-independent. */
  lemma ReplayQuantFrameLB(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                           qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                           body: R.regex)
    requires NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Backward, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.quant_regs, qt, LKC.QIdsInt(body))
  {
    var rev := R.reverse_regex(body);
    PIV.ReversePlusFragment(body);
    NR.PlusIsLookBehindFragmentRE(rev);
    PIV.ReverseCapUnique(body);
    PIV.ReverseQuantUnique(body);
    PIV.ReverseQuantIds(body);                     // QuantIds(rev) == QuantIds(body)
    assert LKC.QIdsInt(rev) == LKC.QIdsInt(body);
    var dir := LAnc.Backward;
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    assert CM.VmQuantsAgree(inits, qt, LKC.QIdsInt(body)) by {
      assert inits.active == [AI.init_thread(cap, lk, qt)];
      assert AI.init_thread(cap, lk, qt).quant_regs == qt;
      assert CM.RegsAgreeOutside(qt, qt, LKC.QIdsInt(body));
    }
    QuantWritesInsideBody(rev);                    // QuantWritesInside(compile(rev), QIdsInt(rev)==QIdsInt(body))
    CM.FFindMatchQuantFrame(bytecode, str, inits, ov, dir, lookcdn, qt, LKC.QIdsInt(body));
    NoTrueQuantStamp(rev);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      FNulledPlusIdentity(body, res0.value.capture_regs, res0.value.look_regs, res0.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
  }

  /** L3a (E2) THE QUANT VALUE LIFT: `FLookLoop`'s final quant bank carries, on
      each matched positive lookahead's own quant slots, that body's FRESH
      match clocks. Quant-only mirror of `FLookLoopValueLift` — the capture
      bank enters through its LENGTH alone (the `Sc == {}` bridge), so none of
      the capture-side bookkeeping is re-threaded. */
  lemma {:isolate_assertions} FLookLoopQuantValueLift(
    crv: CP.FCompiled, str: string, lid: int, maxlook: int,
    cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
    mainast: R.regex, Sq: set<int>, ncap: int, nlook: int, nquant: int)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires NR.LookBehindFragmentRE(mainast) && PIV.QuantUnique(mainast)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex ::
                                  LTB.LookEntryOk(crv, l, la, body)
                                  && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
                                  && PIV.CapUnique(body) && PIV.QuantUnique(body)
                                  && LKC.QIdsInt(body) <= Sq
                                  && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body))
    // each matched body's own quant slots are INITIAL in the incoming bank
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(VBody(crv, l)))
    // distinct matched lids own DISJOINT quant ids
    requires forall l1: int, l2: int ::
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 != l2
               && AReg.get_cp(lk, l1).Some? && AReg.get_cp(lk, l2).Some? ==>
                 LKC.QIdsInt(VBody(crv, l1)) * LKC.QIdsInt(VBody(crv, l2)) == {}
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==> cp_ctx_ok(crv, str, lk, l)
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            |res.2.a_cp| == nquant && |res.2.a_clk| == nquant
            && (forall k :: AI.get_idx(res.2.a_cp, k) < 0)
            && (forall k :: AI.get_idx(res.2.a_clk, k) >= -1)
            && FLookLoopQuantValueOk(crv, str, res.2, lid, maxlook, lk, ov, ncap, nlook, nquant)
    decreases maxlook - lid
  {
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    if lid > maxlook {
      assert res.2 == qt;
      return;
    }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
      FLookLoopQuantValueLift(crv, str, next, maxlook, cap, lk, qt, ov, mainast, Sq, ncap, nlook, nquant);
      assert !MatchedPosLA(crv, lk, lid);
      QuantValueOkSkipLid(crv, str, res.2, lid, maxlook, lk, ov, ncap, nlook, nquant);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
        FLookLoopQuantValueLift(crv, str, next, maxlook, cap, lk, qt, ov, mainast, Sq, ncap, nlook, nquant);
        assert !MatchedPosLA(crv, lk, lid);
        QuantValueOkSkipLid(crv, str, res.2, lid, maxlook, lk, ov, ncap, nlook, nquant);
      } else {
        var la: R.lookaround, body: R.regex :|
          LTB.LookEntryOk(crv, lid, la, body)
          && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
          && PIV.CapUnique(body) && PIV.QuantUnique(body)
          && LKC.QIdsInt(body) <= Sq
          && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
        assert looktype == la;
        assert body == VBody(crv, lid);
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var capN := if result.None? then cap else result.value.capture_regs;
        var lkN := if result.None? then lk else result.value.look_regs;
        var qtN := if result.None? then qt else result.value.quant_regs;
        assert res == AI.FLookLoop(crv, str, next, maxlook, capN, lkN, qtN, ov1);
        NR.PlusIsLookBehindFragmentRE(body);
        assert cp_ctx_ok(crv, str, lk, lid);
        assert 0 <= cp <= |str| && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp);

        if la.Lookahead? {
          assert dir == LAnc.Forward && CP.capture_regex(la, body) == body;
          assert bytecode == CP.compile_to_bytecode(body);
          FFindMatchPlusOvStable(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
          assert ov1 == ov;
          ReplayPlusFrame(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
          assert lkN == lk;
          assert (forall k :: AI.get_idx(qtN.a_cp, k) < 0) && (forall k :: AI.get_idx(qtN.a_clk, k) >= -1);
          ReplayThreadWfLA(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant);
          assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
                 && |qtN.a_cp| == nquant && |qtN.a_clk| == nquant by {
            if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
          }

          // ---- the replay writes quants only inside the body's slots ----
          var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
          assert CM.VmQuantsAgree(inits, qt, LKC.QIdsInt(body)) by {
            assert inits.active == [AI.init_thread(cap, lk, qt)];
            assert AI.init_thread(cap, lk, qt).quant_regs == qt;
            assert CM.RegsAgreeOutside(qt, qt, LKC.QIdsInt(body));
          }
          QuantWritesInsideBody(body);
          CM.FFindMatchQuantFrame(bytecode, str, inits, ov, dir, lookcdn, qt, LKC.QIdsInt(body));
          NoTrueQuantStamp(body);
          assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
          FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
          var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
          if result.Some? {
            assert res0.Some? && QuantRegsFinal(res0.value);
            FNulledPlusIdentity(body, res0.value.capture_regs, res0.value.look_regs, res0.value.quant_regs,
                                crv.f_plus_bc, str, ovx, dir);
            assert qtN == res0.value.quant_regs;
          }
          assert CM.RegsAgreeOutside(qtN, qt, LKC.QIdsInt(body)) by {
            if result.None? { assert qtN == qt; }
          }

          // ---- value at lid: result ~ rfLid on QIdsInt(body) ----
          ReplayLidQuantAgreeFresh(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant);
          FreshMatchWf(bytecode, str, cp, ov, lookcdn, body, ncap, nlook, nquant);
          var rfLid := FreshBodyMatch(crv, str, lid, lk, ov, ncap, nlook, nquant);
          var rf := AI.FFindMatch(bytecode, str,
                                  AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                                  ov, LAnc.Forward, lookcdn).0;
          assert rfLid == rf;                    // VBody(lid)==body, cdn==lookcdn, cp matches

          // ---- suffix bundle at Sq' = Sq - QIdsInt(body) ----
          var Sqp := Sq - LKC.QIdsInt(body);
          assert forall l: int :: next <= l <= maxlook && AReg.get_cp(lkN, l).Some? ==>
                                    exists la2: R.lookaround, body2: R.regex ::
                                      LTB.LookEntryOk(crv, l, la2, body2)
                                      && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                                      && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                                      && LKC.QIdsInt(body2) <= Sqp
                                      && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2))
          by {
            forall l: int | next <= l <= maxlook && AReg.get_cp(lkN, l).Some?
              ensures exists la2: R.lookaround, body2: R.regex ::
                        LTB.LookEntryOk(crv, l, la2, body2)
                        && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                        && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                        && LKC.QIdsInt(body2) <= Sqp
                        && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2))
            {
              assert AReg.get_cp(lk, l).Some?;
              var la2: R.lookaround, body2: R.regex :|
                LTB.LookEntryOk(crv, l, la2, body2)
                && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                && LKC.QIdsInt(body2) <= Sq
                && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2));
              assert body2 == VBody(crv, l) && body == VBody(crv, lid);
              assert LKC.QIdsInt(VBody(crv, l)) * LKC.QIdsInt(VBody(crv, lid)) == {};   // pairwise
              assert LKC.QIdsInt(body2) * LKC.QIdsInt(body) == {};
              assert LKC.QIdsInt(body2) <= Sqp by {
                forall k: int | k in LKC.QIdsInt(body2) ensures k in Sqp {
                  assert k in Sq;
                  assert k !in LKC.QIdsInt(body) by {
                    if k in LKC.QIdsInt(body) { assert k in LKC.QIdsInt(body2) * LKC.QIdsInt(body); }
                  }
                }
              }
            }
          }
          // ---- IH entry: per-body quant slots still INITIAL in qtN ----
          assert forall l: int :: next <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                    CM.RegsAgreeInside(qtN, AReg.init_regs(nquant), LKC.QIdsInt(VBody(crv, l)))
          by {
            forall l: int | next <= l <= maxlook && AReg.get_cp(lk, l).Some?
              ensures CM.RegsAgreeInside(qtN, AReg.init_regs(nquant), LKC.QIdsInt(VBody(crv, l)))
            {
              assert LKC.QIdsInt(VBody(crv, l)) * LKC.QIdsInt(VBody(crv, lid)) == {};   // pairwise
              assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(VBody(crv, l)));
              forall k: int | k in LKC.QIdsInt(VBody(crv, l))
                ensures AI.get_idx(qtN.a_cp, k) == AI.get_idx(AReg.init_regs(nquant).a_cp, k)
                        && AI.get_idx(qtN.a_clk, k) == AI.get_idx(AReg.init_regs(nquant).a_clk, k)
              {
                assert k !in LKC.QIdsInt(body) by {
                  if k in LKC.QIdsInt(body) { assert k in LKC.QIdsInt(VBody(crv, l)) * LKC.QIdsInt(body); }
                }
                assert AI.get_idx(qtN.a_cp, k) == AI.get_idx(qt.a_cp, k)
                       && AI.get_idx(qtN.a_clk, k) == AI.get_idx(qt.a_clk, k);   // qtN ~ qt off body
              }
            }
          }
          FLookLoopQuantValueLift(crv, str, next, maxlook, capN, lkN, qtN, ov1, mainast, Sqp, ncap, nlook, nquant);
          assert FLookLoopQuantValueOk(crv, str, res.2, next, maxlook, lk, ov, ncap, nlook, nquant);   // lkN==lk, ov1==ov

          // ---- frame: res.2 == qtN on QIdsInt(body) (suffix writes disjoint slots) ----
          FLookLoopQuantFrame(crv, str, next, maxlook, capN, lkN, qtN, ov1, mainast, Sqp);
          assert CM.RegsAgreeOutside(res.2, qtN, Sqp);
          assert forall k: int :: k in LKC.QIdsInt(body) ==> k !in Sqp;
          RegsAgreeOutsideToInside(res.2, qtN, LKC.QIdsInt(body), Sqp);
          assert CM.RegsAgreeInside(res.2, qtN, LKC.QIdsInt(body));

          // ---- assemble FLookLoopQuantValueOk for [lid] ----
          forall l: int | lid <= l <= maxlook && MatchedPosLA(crv, lk, l)
            ensures var rf2 := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
                    rf2.Some? ==> CM.RegsAgreeInside(res.2, rf2.value.quant_regs, LKC.QIdsInt(VBody(crv, l)))
          {
            if l == lid {
              if rfLid.Some? {
                assert result.Some?;
                assert CM.RegsAgreeInside(result.value.quant_regs, rf.value.quant_regs, LKC.QIdsInt(body));
                assert qtN == result.value.quant_regs;
                assert CM.ThreadRegsWf(rfLid.value, ncap, nlook, nquant);   // FreshMatchWf
                assert CM.RegsAgreeInside(res.2, rfLid.value.quant_regs, LKC.QIdsInt(VBody(crv, l))) by {
                  forall k: int | k in LKC.QIdsInt(body)
                    ensures AI.get_idx(res.2.a_cp, k) == AI.get_idx(rfLid.value.quant_regs.a_cp, k)
                            && AI.get_idx(res.2.a_clk, k) == AI.get_idx(rfLid.value.quant_regs.a_clk, k)
                  {
                    assert AI.get_idx(res.2.a_cp, k) == AI.get_idx(qtN.a_cp, k)
                           && AI.get_idx(res.2.a_clk, k) == AI.get_idx(qtN.a_clk, k);
                  }
                }
              }
            }
          }
        } else {
          // ---- capture-free positive LOOKBEHIND: quants still rewritten, but
          // MatchedPosLA(lid) is false (not a lookahead) — skip-lid after the
          // IH, whose entry facts survive by quant-set disjointness. ----
          assert la.Lookbehind?;
          assert dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body);
          assert bytecode == CP.compile_to_bytecode(R.reverse_regex(body));
          assert AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1);
          FFindMatchPlusOvStableLB(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
          assert ov1 == ov;
          ReplayPlusFrameLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body);
          assert lkN == lk;
          assert (forall k :: AI.get_idx(qtN.a_cp, k) < 0) && (forall k :: AI.get_idx(qtN.a_clk, k) >= -1);
          ReplayThreadWfLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant);
          assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
                 && |qtN.a_cp| == nquant && |qtN.a_clk| == nquant by {
            if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
          }

          // ---- the replay writes quants only inside the body's slots ----
          ReplayQuantFrameLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body);
          assert CM.RegsAgreeOutside(qtN, qt, LKC.QIdsInt(body)) by {
            if result.None? { assert qtN == qt; }
          }

          // ---- value at lid: result ~ rf on QIdsInt(body) (backward quant bisimulation) ----
          ReplayLidQuantAgreeFreshLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant);
          FreshMatchWfLB(bytecode, str, cp, ov, lookcdn, body, ncap, nlook, nquant);
          var rfLid := FreshBodyMatch(crv, str, lid, lk, ov, ncap, nlook, nquant);
          var rf := AI.FFindMatch(bytecode, str,
                                  AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                                  ov, LAnc.Backward, lookcdn).0;
          assert rfLid == rf;

          // ---- suffix bundle at Sq' + IH entry, as in the lookahead branch ----
          var Sqp := Sq - LKC.QIdsInt(body);
          assert forall l: int :: next <= l <= maxlook && AReg.get_cp(lkN, l).Some? ==>
                                    exists la2: R.lookaround, body2: R.regex ::
                                      LTB.LookEntryOk(crv, l, la2, body2)
                                      && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                                      && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                                      && LKC.QIdsInt(body2) <= Sqp
                                      && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2))
          by {
            forall l: int | next <= l <= maxlook && AReg.get_cp(lkN, l).Some?
              ensures exists la2: R.lookaround, body2: R.regex ::
                        LTB.LookEntryOk(crv, l, la2, body2)
                        && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                        && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                        && LKC.QIdsInt(body2) <= Sqp
                        && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2))
            {
              assert AReg.get_cp(lk, l).Some?;
              var la2: R.lookaround, body2: R.regex :|
                LTB.LookEntryOk(crv, l, la2, body2)
                && NR.LookFreeRE(body2) && NR.PlusFragmentRE(body2)
                && PIV.CapUnique(body2) && PIV.QuantUnique(body2)
                && LKC.QIdsInt(body2) <= Sq
                && ((la2.NegLookbehind? || la2.NegLookahead?) ==> NR.CaptureFreeRE(body2));
              assert body2 == VBody(crv, l) && body == VBody(crv, lid);
              assert LKC.QIdsInt(VBody(crv, l)) * LKC.QIdsInt(VBody(crv, lid)) == {};   // pairwise
              assert LKC.QIdsInt(body2) * LKC.QIdsInt(body) == {};
              assert LKC.QIdsInt(body2) <= Sqp by {
                forall k: int | k in LKC.QIdsInt(body2) ensures k in Sqp {
                  assert k in Sq;
                  assert k !in LKC.QIdsInt(body) by {
                    if k in LKC.QIdsInt(body) { assert k in LKC.QIdsInt(body2) * LKC.QIdsInt(body); }
                  }
                }
              }
            }
          }
          assert forall l: int :: next <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                    CM.RegsAgreeInside(qtN, AReg.init_regs(nquant), LKC.QIdsInt(VBody(crv, l)))
          by {
            forall l: int | next <= l <= maxlook && AReg.get_cp(lk, l).Some?
              ensures CM.RegsAgreeInside(qtN, AReg.init_regs(nquant), LKC.QIdsInt(VBody(crv, l)))
            {
              assert LKC.QIdsInt(VBody(crv, l)) * LKC.QIdsInt(VBody(crv, lid)) == {};   // pairwise
              assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(VBody(crv, l)));
              forall k: int | k in LKC.QIdsInt(VBody(crv, l))
                ensures AI.get_idx(qtN.a_cp, k) == AI.get_idx(AReg.init_regs(nquant).a_cp, k)
                        && AI.get_idx(qtN.a_clk, k) == AI.get_idx(AReg.init_regs(nquant).a_clk, k)
              {
                assert k !in LKC.QIdsInt(body) by {
                  if k in LKC.QIdsInt(body) { assert k in LKC.QIdsInt(VBody(crv, l)) * LKC.QIdsInt(body); }
                }
                assert AI.get_idx(qtN.a_cp, k) == AI.get_idx(qt.a_cp, k)
                       && AI.get_idx(qtN.a_clk, k) == AI.get_idx(qt.a_clk, k);   // qtN ~ qt off body
              }
            }
          }
          FLookLoopQuantValueLift(crv, str, next, maxlook, capN, lkN, qtN, ov1, mainast, Sqp, ncap, nlook, nquant);
          assert FLookLoopQuantValueOk(crv, str, res.2, next, maxlook, lk, ov, ncap, nlook, nquant);

          // ---- frame: res.2 == qtN on QIdsInt(body) (suffix writes disjoint slots) ----
          FLookLoopQuantFrame(crv, str, next, maxlook, capN, lkN, qtN, ov1, mainast, Sqp);
          assert CM.RegsAgreeOutside(res.2, qtN, Sqp);
          assert forall k: int :: k in LKC.QIdsInt(body) ==> k !in Sqp;
          RegsAgreeOutsideToInside(res.2, qtN, LKC.QIdsInt(body), Sqp);
          assert CM.RegsAgreeInside(res.2, qtN, LKC.QIdsInt(body));

          // ---- assemble FLookLoopQuantValueOk for [lid] (a MATCHED positive lookbehind) ----
          forall l: int | lid <= l <= maxlook && MatchedPosLA(crv, lk, l)
            ensures var rf2 := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
                    rf2.Some? ==> CM.RegsAgreeInside(res.2, rf2.value.quant_regs, LKC.QIdsInt(VBody(crv, l)))
          {
            if l == lid {
              if rfLid.Some? {
                assert result.Some?;
                assert CM.RegsAgreeInside(result.value.quant_regs, rf.value.quant_regs, LKC.QIdsInt(body));
                assert qtN == result.value.quant_regs;
                assert CM.ThreadRegsWf(rfLid.value, ncap, nlook, nquant);   // FreshMatchWfLB
                assert CM.RegsAgreeInside(res.2, rfLid.value.quant_regs, LKC.QIdsInt(VBody(crv, l))) by {
                  forall k: int | k in LKC.QIdsInt(body)
                    ensures AI.get_idx(res.2.a_cp, k) == AI.get_idx(rfLid.value.quant_regs.a_cp, k)
                            && AI.get_idx(res.2.a_clk, k) == AI.get_idx(rfLid.value.quant_regs.a_clk, k)
                  {
                    assert AI.get_idx(res.2.a_cp, k) == AI.get_idx(qtN.a_cp, k)
                           && AI.get_idx(res.2.a_clk, k) == AI.get_idx(qtN.a_clk, k);
                  }
                }
              }
            }
          }
        }
      }
  }

  /** L3a (E2): the quant-bank companion of `ReplayCapAgreeFresh` — the same
      lockstep bisimulation (`CM.FFindMatchCapRel` threads BOTH agreement sets),
      with `Sq := QIdsInt(body)`: when the body's quant slots are still INITIAL
      in the incoming bank (the main pass stamps only outside-look quants, and
      earlier lids' replays write only their own disjoint slots), the replay's
      final quant bank agrees with the FRESH replay's on the body's slots. This
      is what lets the reconstructed `res.2` discharge the body-side quant
      clauses of `PIV.PathPresentLk` via `PIV.BodyPathPresentLk` + congruence. */
  lemma ReplayCapQuantAgreeFresh(bodycode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                 qt: AReg.Regs, ov: LOr.OracleView, cdns: LCdn.cdns, body: R.regex,
                                 ncap: int, nlook: int, nquant: int)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    ensures var ctxc := AI.cp_context(cp, str, LAnc.Forward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
            (ra.None? <==> rf.None?)
            && (ra.Some? ==>
                  CM.RegsAgreeInside(ra.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body))
                  && CM.RegsAgreeInside(ra.value.quant_regs, rf.value.quant_regs, LKC.QIdsInt(body)))
  {
    var ctxc := AI.cp_context(cp, str, LAnc.Forward);
    var sa := AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc);
    var sf := AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    var Sc := PIV.CaptureRegs(body);
    var Sq := LKC.QIdsInt(body);
    assert CM.VmRel(sa, sf, Sc, Sq) by {
      assert CM.ThreadRel(AI.init_thread(cap, lk, qt),
                          AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
                          Sc, Sq);
    }
    CM.FFindMatchCapRel(bodycode, str, sa, sf, ov, LAnc.Forward, cdns, Sc, Sq);
  }

  /** L3a (E2): `ReplayLidCapAgreeFresh` with the quant conclusion — the ACTUAL
      `FFindMatchPlus` replay's quant bank agrees with the FRESH body match's on
      `QIdsInt(body)` (alongside the capture agreement). Same route: reconstruct
      is the identity on a `QuantRegsFinal` result, then the `Sq`-threaded
      bisimulation (`ReplayCapQuantAgreeFresh`). The extra entry fact — body
      quant slots still INITIAL in the incoming bank — is the caller's (main
      pass stamps only outside-look quants; earlier lids' replays write only
      their own disjoint slots). */
  lemma ReplayLidCapQuantAgreeFresh(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                                    qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                                    body: R.regex, la: R.lookaround, ncap: int, nlook: int, nquant: int)
    requires NR.LookBehindFragmentRE(body) && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead?
    requires bytecode == CP.compile_to_bytecode(body)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body))
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Forward, cp, cap, lk, qt, 0, lookcdn).0;
      var rf := AI.FFindMatch(bytecode, str,
                              AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                            AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                              ov, LAnc.Forward, lookcdn).0;
      (result.None? <==> rf.None?)
      && (result.Some? ==>
            CM.RegsAgreeInside(result.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body))
            && CM.RegsAgreeInside(result.value.quant_regs, rf.value.quant_regs, LKC.QIdsInt(body)))
  {
    var dir := LAnc.Forward;
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    NoTrueQuantStamp(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
    ReplayCapQuantAgreeFresh(bytecode, str, cp, cap, lk, qt, ov, lookcdn, body, ncap, nlook, nquant);
  }

  /** §4b ENGINE BRIDGE: the body replay from the MAIN thread's `cap/lk/qt`
      agrees, on `CaptureRegs(body)`, with the replay from FRESH registers. `cap`
      has the body's ids UNSET (the main pass writes only outside-look captures,
      §4b groundwork), so `cap` agrees with fresh there; and the engine never
      branches on register values, so the two runs stay in lockstep
      (`CM.FFindMatchCapRel`). `Sq = {}`: control is quant-value-independent too,
      so no quant hypothesis is needed. Composed with `BodyTreeAtCp` on the fresh
      run, this pins the replay's body captures to the body's spec first leaf. */
  lemma ReplayCapAgreeFresh(bodycode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                            qt: AReg.Regs, ov: LOr.OracleView, cdns: LCdn.cdns, body: R.regex,
                            ncap: int, nlook: int, nquant: int)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    ensures var ctxc := AI.cp_context(cp, str, LAnc.Forward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
            (ra.None? <==> rf.None?)
            && (ra.Some? ==> CM.RegsAgreeInside(ra.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body)))
  {
    var ctxc := AI.cp_context(cp, str, LAnc.Forward);
    var sa := AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc);
    var sf := AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    var Sc := PIV.CaptureRegs(body);
    assert CM.VmRel(sa, sf, Sc, {}) by {
      assert CM.ThreadRel(AI.init_thread(cap, lk, qt),
                          AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
                          Sc, {}) by {
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), {});  // just equal lengths (nquant)
      }
    }
    CM.FFindMatchCapRel(bodycode, str, sa, sf, ov, LAnc.Forward, cdns, Sc, {});
  }

  /** L3b: the BACKWARD register-value-blind bisimulation — the lookbehind twin of
      `ReplayCapAgreeFresh`. A backward `FFindMatch` from the main thread's `cap`
      (fresh on `CaptureRegs(body)`) and one from a fully-fresh state agree on
      `CaptureRegs(body)`. Direction is the ONLY difference: `CM.FFindMatchCapRel`
      is dir-generic and control never reads register values, so no fragment /
      uniqueness / capture-freeness hypotheses are needed. */
  lemma ReplayCapAgreeFreshLB(bodycode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                              qt: AReg.Regs, ov: LOr.OracleView, cdns: LCdn.cdns, body: R.regex,
                              ncap: int, nlook: int, nquant: int)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    ensures var ctxc := AI.cp_context(cp, str, LAnc.Backward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Backward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Backward, cdns).0;
            (ra.None? <==> rf.None?)
            && (ra.Some? ==> CM.RegsAgreeInside(ra.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body)))
  {
    var ctxc := AI.cp_context(cp, str, LAnc.Backward);
    var sa := AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc);
    var sf := AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                            AReg.init_regs(nquant), 0, ctxc);
    var Sc := PIV.CaptureRegs(body);
    assert CM.VmRel(sa, sf, Sc, {}) by {
      assert CM.ThreadRel(AI.init_thread(cap, lk, qt),
                          AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)),
                          Sc, {}) by {
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), {});
      }
    }
    CM.FFindMatchCapRel(bodycode, str, sa, sf, ov, LAnc.Backward, cdns, Sc, {});
  }

  /** §4b ENGINE VALUE BRIDGE (capstone): the body replay from the MAIN thread's
      `cap/lk/qt` produces, on `CaptureRegs(body)`, exactly the capture registers
      of the FRESH body match, whose group-map denotation `GmOfLive(body, .)` is
      the body's SPEC first leaf `FirstLeaf(ComputeTr(body, InpOfCp(str,cp)))`.
      Composes `BodyTreeAtCp` (fresh match <-> spec leaf) with `ReplayCapAgreeFresh`
      (replay-cap ~ fresh on body ids). This closes the ENGINE half of §4b; what
      remains is the SPEC-side bridge from this standalone body leaf to the main
      tree's lookaround subtree (gm-independence of own-group captures). */
  lemma ReplayCapIsBodyLeaf(rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code,
                            endl: nat, ngroups: nat, str: string, cp: nat, cap: AReg.Regs, lk: AReg.Regs,
                            qt: AReg.Regs, ov: LOr.OracleView, cdns: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires NR.LookFreeRE(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    ensures var inp := PIV.InpOfCp(str, cp);
            var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, LG.Empty, WP.Forward);
            var ctxc := AI.cp_context(cp, str, LAnc.Forward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
            bestT == LT.FirstLeaf(t, inp)
            && (ra.None? <==> bestT.None?)
            && (ra.Some? ==>
                  bestT.Some? && rf.Some?
                  && CM.RegsAgreeInside(ra.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body))
                  && bestT.value.1 == PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs))
  {
    bestT := BodyTreeAtCp(rer, qm, body, bodycode, endl, ngroups, str, cp, ov, cdns, ncap, nlook, nquant);
    ReplayCapAgreeFresh(bodycode, str, cp, cap, lk, qt, ov, cdns, body, ncap, nlook, nquant);
    // BodyTreeAtCp:  BestMatchRE(body, bestT, rf) && bestT == FirstLeaf(t, inp)
    //   -> bestT.value.1 == GmOfLive(body, rf.regs), bestT.None? <==> rf.None?
    // ReplayCapAgreeFresh:  ra.None? <==> rf.None? && captures agree on CaptureRegs(body)
  }

  /** §4b ENGINE VALUE BRIDGE generalized off `LookFreeRE(body)` to the CAPTURING
      (depth-1) lookaround case — the `ReplayCapIsBodyLeaf` twin built on
      `BodyTreeAtCpLk`. The FRESH-match facts are UNCHANGED (`ReplayCapAgreeFresh`
      is register-value-blind — no fragment / look-free hypothesis — and
      `BestMatchRE` ties `bestT.1` to `GmOfLive(body, rf)` regardless of looks); the
      only weakening is the CHECKED-tree relation to the spec first leaf, which
      holds OUTSIDE `S := LkBodyGroups(Translate(body))` (the erased look captures)
      rather than everywhere. A clean composition — no new proof obligations beyond
      the two called lemmas. Downstream, closing the keystone `LkResult ~ GmOfLive`
      on the body's FULL `DefGroups` (not merely outside `S`) additionally needs
      the L3a look-capture RECONSTRUCTION (`FLookLoop`), which lies on the engine
      side, not in this composition. */
  lemma ReplayCapIsBodyLeafLk(rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code,
                              endl: nat, ngroups: nat, str: string, cp: nat, cap: AReg.Regs, lk: AReg.Regs,
                              qt: AReg.Regs, ov: LOr.OracleView, cdns: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    ensures var inp := PIV.InpOfCp(str, cp);
            var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, LG.Empty, WP.Forward);
            var S := LL.LkBodyGroups(T.Translate(body));
            var ctxc := AI.cp_context(cp, str, LAnc.Forward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
            // checked-tree first leaf, confined (replaces raw `bestT == FirstLeaf(t)`):
            (bestT.None? <==> LT.FirstLeaf(t, inp).None?)
            && (bestT.Some? ==>
                  LT.FirstLeaf(t, inp).Some?
                  && bestT.value.0 == LT.FirstLeaf(t, inp).value.0
                  && LL.GmAgreeOutside(bestT.value.1, LT.FirstLeaf(t, inp).value.1, S))
            // fresh-match facts (UNCHANGED from ReplayCapIsBodyLeaf):
            && (ra.None? <==> bestT.None?)
            && (ra.Some? ==>
                  bestT.Some? && rf.Some?
                  && CM.RegsAgreeInside(ra.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body))
                  && bestT.value.1 == PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs))
  {
    bestT := BodyTreeAtCpLk(rer, qm, body, bodycode, endl, ngroups, str, cp, ov, cdns, ncap, nlook, nquant);
    ReplayCapAgreeFresh(bodycode, str, cp, cap, lk, qt, ov, cdns, body, ncap, nlook, nquant);
    // BodyTreeAtCpLk:  BestMatchRE(body, bestT, rf) (fresh) && confined FirstLeaf facts
    //   -> bestT.1 == GmOfLive(body, rf.regs), bestT.None? <==> rf.None?
    // ReplayCapAgreeFresh:  ra.None? <==> rf.None? && captures agree on CaptureRegs(body)
  }

  /** L4 depth-k (ADDITIVE): the nested-fragment `ReplayCapIsBodyLeaf` twin,
      built on `BodyTreeAtCpNested`. The FRESH-match facts are UNCHANGED
      (`ReplayCapAgreeFresh` is register-value-blind); the checked-tree relation
      to the spec first leaf holds OUTSIDE `S := LkBodyGroups(Translate(body))`.
      A clean composition of the two called lemmas. */
  lemma ReplayCapIsBodyLeafNested(rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code,
                                  endl: nat, ngroups: nat, str: string, cp: nat, cap: AReg.Regs, lk: AReg.Regs,
                                  qt: AReg.Regs, ov: LOr.OracleView, cdns: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkNestedRE(qm, body, bodycode, endl)
    requires NR.NegLooksLookFreeRE(body)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    ensures var inp := PIV.InpOfCp(str, cp);
            var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, LG.Empty, WP.Forward);
            var S := LL.LkBodyGroups(T.Translate(body));
            var ctxc := AI.cp_context(cp, str, LAnc.Forward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
            // checked-tree first leaf, confined (replaces raw `bestT == FirstLeaf(t)`):
            (bestT.None? <==> LT.FirstLeaf(t, inp).None?)
            && (bestT.Some? ==>
                  LT.FirstLeaf(t, inp).Some?
                  && bestT.value.0 == LT.FirstLeaf(t, inp).value.0
                  && LL.GmAgreeOutside(bestT.value.1, LT.FirstLeaf(t, inp).value.1, S))
            // fresh-match facts (UNCHANGED from ReplayCapIsBodyLeaf):
            && (ra.None? <==> bestT.None?)
            && (ra.Some? ==>
                  bestT.Some? && rf.Some?
                  && CM.RegsAgreeInside(ra.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body))
                  && bestT.value.1 == PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs))
  {
    bestT := BodyTreeAtCpNested(rer, qm, body, bodycode, endl, ngroups, str, cp, ov, cdns, ncap, nlook, nquant);
    ReplayCapAgreeFresh(bodycode, str, cp, cap, lk, qt, ov, cdns, body, ncap, nlook, nquant);
    // BodyTreeAtCpNested:  BestMatchRE(body, bestT, rf) (fresh) && confined FirstLeaf facts
    //   -> bestT.1 == GmOfLive(body, rf.regs), bestT.None? <==> rf.None?
    // ReplayCapAgreeFresh:  ra.None? <==> rf.None? && captures agree on CaptureRegs(body)
  }


  // ===========================================================================
  // §4b -- SPEC-side gm-frame. `TreeRes` threads `gm` through the tree; a
  // look-free tree (`NoLKTree`) never branches on `gm` (only `LK` nodes read it),
  // so two runs from gms agreeing on a group set `S` end at the same position and
  // agree on `S`. Since `FirstLeaf(t, inp) == TreeRes(t, Empty, inp, Forward)` and
  // `LkResult` of a positive lookAHEAD is `TreeRes(tlk, gm, inp, Forward).1`, this
  // bridges the standalone body leaf (at `Empty`) to the main tree's lookaround
  // subtree (at the main `gm`) on the body's own groups -- the SPEC analogue of
  // the engine bisimulation.
  // ===========================================================================

  /** Two group maps agree on membership and value at every group in `S`. */
  ghost predicate GmAgreeOn(gm1: LG.GroupMap, gm2: LG.GroupMap, S: set<LG.GroupId>) {
    forall g :: g in S ==> (g in gm1 <==> g in gm2) && (g in gm1 ==> gm1[g] == gm2[g])
  }

  /** Applying the SAME group action to two `S`-agreeing maps preserves
      `S`-agreement (the action reads/writes one group -- or a reset set --
      identically on both). */
  lemma GMUpdateAgree(op: LG.GroupAction, idx: nat, gm1: LG.GroupMap, gm2: LG.GroupMap, S: set<LG.GroupId>)
    requires GmAgreeOn(gm1, gm2, S)
    ensures GmAgreeOn(LG.GMUpdate(op, idx, gm1), LG.GMUpdate(op, idx, gm2), S)
  {
    match op
    case Open(g) =>
    case Close(g) =>
      // GMClose modifies only group `g`; for `g' in S`, either g' != g (entry
      // unchanged in both) or g' == g in S (so Find(g, .) agrees -> same close).
      forall g' | g' in S
        ensures (g' in LG.GMClose(idx, g, gm1) <==> g' in LG.GMClose(idx, g, gm2))
                && (g' in LG.GMClose(idx, g, gm1) ==> LG.GMClose(idx, g, gm1)[g'] == LG.GMClose(idx, g, gm2)[g'])
      {
        if g' == g {
          assert LG.Find(g, gm1) == LG.Find(g, gm2);   // g in S: maps agree at g
        }
      }
    case Reset(gs) =>
  }

  /** SPEC-side gm-frame: for a look-free tree, `TreeRes` from `S`-agreeing gms
      lands at the same position and its leaf gms still agree on `S`. */
  lemma TreeResGmFrame(t: LT.Tree, gm1: LG.GroupMap, gm2: LG.GroupMap, inp: LC.Input,
                       dir: WP.Direction, S: set<LG.GroupId>)
    requires EL.NoLKTree(t)
    requires GmAgreeOn(gm1, gm2, S)
    ensures (LT.TreeRes(t, gm1, inp, dir).None? <==> LT.TreeRes(t, gm2, inp, dir).None?)
    ensures LT.TreeRes(t, gm1, inp, dir).Some? ==>
              LT.TreeRes(t, gm1, inp, dir).value.0 == LT.TreeRes(t, gm2, inp, dir).value.0
              && GmAgreeOn(LT.TreeRes(t, gm1, inp, dir).value.1, LT.TreeRes(t, gm2, inp, dir).value.1, S)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) =>
      TreeResGmFrame(t1, gm1, gm2, inp, dir, S);
      TreeResGmFrame(t2, gm1, gm2, inp, dir, S);
    case Read(c, t1) =>
      TreeResGmFrame(t1, gm1, gm2, LC.AdvanceInputP(inp, dir), dir, S);
    case ReadBackRef(brStr, t1) =>
      TreeResGmFrame(t1, gm1, gm2, LC.AdvanceInputN(inp, |brStr|, dir), dir, S);
    case Progress(t1) =>
      TreeResGmFrame(t1, gm1, gm2, inp, dir, S);
    case AnchorPass(a, t1) =>
      TreeResGmFrame(t1, gm1, gm2, inp, dir, S);
    case GroupActionT(a, t1) =>
      GMUpdateAgree(a, LC.Idx(inp), gm1, gm2, S);
      TreeResGmFrame(t1, LG.GMUpdate(a, LC.Idx(inp), gm1), LG.GMUpdate(a, LC.Idx(inp), gm2), inp, dir, S);
  }

  /** A `GmConfinedTree` has no `LK`/`LKFail` node (those cases are `false`), so
      it is a `NoLKTree` — the bridge that lets the ORIGINAL `TreeResGmFrame`
      apply to a confined look body inside the L4 gm-frame below. */
  lemma GmConfinedNoLK(t: LT.Tree, S: set<LG.GroupId>)
    requires CE.GmConfinedTree(t, S)
    ensures EL.NoLKTree(t)
    decreases t
  {
    match t
    case Choice(t1, t2) => GmConfinedNoLK(t1, S); GmConfinedNoLK(t2, S);
    case Read(_, t1) => GmConfinedNoLK(t1, S);
    case Progress(t1) => GmConfinedNoLK(t1, S);
    case GroupActionT(_, t1) => GmConfinedNoLK(t1, S);
    case AnchorPass(_, t1) => GmConfinedNoLK(t1, S);
    case ReadBackRef(_, t1) => GmConfinedNoLK(t1, S);
    case _ =>
  }

  /** L4 SPEC-side gm-frame, GENERALIZED to LK-node trees — the lemma the W4
      keystone needs where `TreeResGmFrame` currently forces `NoLKTree(t)`. Under
      `LkConfinedTree(t, S)` (every look body is confined to `S`, hence LK-free),
      `TreeRes` from `S`-agreeing gms lands at the same position with `S`-agreeing
      leaf gms. Each look body is discharged by the ORIGINAL `TreeResGmFrame`
      (it is `NoLKTree` by `GmConfinedNoLK`); only the CONTINUATIONS recurse — so
      the depth-1 gm-frame lifts through one layer of gates, exactly what one step
      of the keystone's depth induction consumes. */
  lemma TreeResGmFrameLk(t: LT.Tree, gm1: LG.GroupMap, gm2: LG.GroupMap, inp: LC.Input,
                         dir: WP.Direction, S: set<LG.GroupId>)
    requires CE.LkConfinedTree(t, S)
    requires GmAgreeOn(gm1, gm2, S)
    ensures (LT.TreeRes(t, gm1, inp, dir).None? <==> LT.TreeRes(t, gm2, inp, dir).None?)
    ensures LT.TreeRes(t, gm1, inp, dir).Some? ==>
              LT.TreeRes(t, gm1, inp, dir).value.0 == LT.TreeRes(t, gm2, inp, dir).value.0
              && GmAgreeOn(LT.TreeRes(t, gm1, inp, dir).value.1, LT.TreeRes(t, gm2, inp, dir).value.1, S)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) =>
      TreeResGmFrameLk(t1, gm1, gm2, inp, dir, S);
      TreeResGmFrameLk(t2, gm1, gm2, inp, dir, S);
    case Read(c, t1) =>
      TreeResGmFrameLk(t1, gm1, gm2, LC.AdvanceInputP(inp, dir), dir, S);
    case ReadBackRef(brStr, t1) =>
      TreeResGmFrameLk(t1, gm1, gm2, LC.AdvanceInputN(inp, |brStr|, dir), dir, S);
    case Progress(t1) =>
      TreeResGmFrameLk(t1, gm1, gm2, inp, dir, S);
    case AnchorPass(a, t1) =>
      TreeResGmFrameLk(t1, gm1, gm2, inp, dir, S);
    case GroupActionT(a, t1) =>
      GMUpdateAgree(a, LC.Idx(inp), gm1, gm2, S);
      TreeResGmFrameLk(t1, LG.GMUpdate(a, LC.Idx(inp), gm1), LG.GMUpdate(a, LC.Idx(inp), gm2), inp, dir, S);
    case LK(lk, tlk, t1) =>
      // the confined body is LK-free -> the ORIGINAL frame discharges it
      GmConfinedNoLK(tlk, S);
      TreeResGmFrame(tlk, gm1, gm2, inp, L.LkDir(lk), S);
      if L.Positivity(lk) {
        match LT.TreeRes(tlk, gm1, inp, L.LkDir(lk))
        case None =>
        case Some(pair1) =>
          var pair2 := LT.TreeRes(tlk, gm2, inp, L.LkDir(lk)).value;
          TreeResGmFrameLk(t1, pair1.1, pair2.1, inp, dir, S);
      } else {
        match LT.TreeRes(tlk, gm1, inp, L.LkDir(lk))
        case None => TreeResGmFrameLk(t1, gm1, gm2, inp, dir, S);
        case Some(_) =>
      }
    case LKFail(lk, tlk) =>
  }

  /** L4 SPEC-side gm-frame, generalized to ARBITRARY lookaround NESTING depth —
      the depth-parametric strengthening of the W4 brick `TreeResGmFrameLk`.
      Unlike `TreeResGmFrameLk`, this needs NO confinement hypothesis at all
      (`LkConfinedTree` is dropped): `TreeRes`'s CONTROL FLOW — its `None?` verdict
      and end position — never branches on the group map. Backreference strings are
      baked into the `ReadBackRef` node (not recomputed from `gm`), and a look
      node's success is decided by running its body, whose own control flow is
      likewise gm-blind. So every LK/LKFail body is discharged by a RECURSIVE call
      (a strict subterm, hence any nesting depth) instead of the depth-1
      `TreeResGmFrame` + `GmConfinedNoLK`, and `S`-agreement threads through
      unconditionally. Strictly generalizes both `TreeResGmFrame` (drops
      `NoLKTree`) and `TreeResGmFrameLk` (drops `LkConfinedTree`). */
  lemma TreeResGmFrameRec(t: LT.Tree, gm1: LG.GroupMap, gm2: LG.GroupMap, inp: LC.Input,
                          dir: WP.Direction, S: set<LG.GroupId>)
    requires GmAgreeOn(gm1, gm2, S)
    ensures (LT.TreeRes(t, gm1, inp, dir).None? <==> LT.TreeRes(t, gm2, inp, dir).None?)
    ensures LT.TreeRes(t, gm1, inp, dir).Some? ==>
              LT.TreeRes(t, gm1, inp, dir).value.0 == LT.TreeRes(t, gm2, inp, dir).value.0
              && GmAgreeOn(LT.TreeRes(t, gm1, inp, dir).value.1, LT.TreeRes(t, gm2, inp, dir).value.1, S)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) =>
      TreeResGmFrameRec(t1, gm1, gm2, inp, dir, S);
      TreeResGmFrameRec(t2, gm1, gm2, inp, dir, S);
    case Read(c, t1) =>
      TreeResGmFrameRec(t1, gm1, gm2, LC.AdvanceInputP(inp, dir), dir, S);
    case ReadBackRef(brStr, t1) =>
      TreeResGmFrameRec(t1, gm1, gm2, LC.AdvanceInputN(inp, |brStr|, dir), dir, S);
    case Progress(t1) =>
      TreeResGmFrameRec(t1, gm1, gm2, inp, dir, S);
    case AnchorPass(a, t1) =>
      TreeResGmFrameRec(t1, gm1, gm2, inp, dir, S);
    case GroupActionT(a, t1) =>
      GMUpdateAgree(a, LC.Idx(inp), gm1, gm2, S);
      TreeResGmFrameRec(t1, LG.GMUpdate(a, LC.Idx(inp), gm1), LG.GMUpdate(a, LC.Idx(inp), gm2), inp, dir, S);
    case LK(lk, tlk, t1) =>
      // the look body is discharged by RECURSION (any depth), not the depth-1 frame
      TreeResGmFrameRec(tlk, gm1, gm2, inp, L.LkDir(lk), S);
      if L.Positivity(lk) {
        match LT.TreeRes(tlk, gm1, inp, L.LkDir(lk))
        case None =>
        case Some(pair1) =>
          var pair2 := LT.TreeRes(tlk, gm2, inp, L.LkDir(lk)).value;
          TreeResGmFrameRec(t1, pair1.1, pair2.1, inp, dir, S);
      } else {
        match LT.TreeRes(tlk, gm1, inp, L.LkDir(lk))
        case None => TreeResGmFrameRec(t1, gm1, gm2, inp, dir, S);
        case Some(_) =>
      }
    case LKFail(lk, tlk) =>
  }

  // ===========================================================================
  // R3b (ADDITIVE): pure-spec VALUE composition for captures defined inside looks.
  //
  // These are the SPEC-tree half of the nested value-reconstruction seam. They
  // isolate how a SINGLE capture group `g` gets its value at the highest-priority
  // leaf of a `TreeRes`, independent of the surrounding group map (`gmMain`) and
  // of the continuation. Two orthogonal facts:
  //   * `TreeResGValueFramed`  -- `g`'s leaf value depends on the incoming map
  //     ONLY through its value AT `g` (changing OTHER groups is irrelevant).
  //   * `TreeResGNotWritten` / `TreeResLkNodeGValue` -- if `g` is written only
  //     inside a look, the value the look CONTRIBUTES flows out to the leaf
  //     unchanged (the continuation, defining `g` nowhere, only threads it).
  // Together: the value of an inner-look `g` at the OUTER leaf equals the owning
  // look's own sub-result at `g` (`LkResult` of that look), which is the last hop
  // of the `recon_inner` chain.
  // ===========================================================================

  /** A group action writes / touches group `g`. */
  ghost predicate ActTouchesG(a: LG.GroupAction, g: LG.GroupId) {
    match a
    case Open(x) => x == g
    case Close(x) => x == g
    case Reset(gs) => g in gs
  }

  /** A group action that does NOT touch `g` leaves `g`'s entry (membership AND
      value) unchanged under `GMUpdate`. */
  lemma GMUpdateFindNotTouch(a: LG.GroupAction, idx: nat, gm: LG.GroupMap, g: LG.GroupId)
    requires !ActTouchesG(a, g)
    ensures LG.Find(g, LG.GMUpdate(a, idx, gm)) == LG.Find(g, gm)
  {
    match a
    case Open(x) =>
    case Close(x) =>
      match LG.Find(x, gm) {
        case Some(_) =>
        case None =>
      }
    case Reset(gs) =>
      assert g !in (set y | y in gs);
  }

  /** `GMUpdate` reads/writes `g` using ONLY `g`'s own incoming entry: two maps
      that agree AT `g` (however they differ elsewhere) still agree at `g` after
      the SAME action. The single-group core of the value-composition frame. */
  lemma GMUpdateFindAgree(a: LG.GroupAction, idx: nat, gm1: LG.GroupMap, gm2: LG.GroupMap, g: LG.GroupId)
    requires LG.Find(g, gm1) == LG.Find(g, gm2)
    ensures LG.Find(g, LG.GMUpdate(a, idx, gm1)) == LG.Find(g, LG.GMUpdate(a, idx, gm2))
  {
    if !ActTouchesG(a, g) {
      GMUpdateFindNotTouch(a, idx, gm1, g);
      GMUpdateFindNotTouch(a, idx, gm2, g);
    } else {
      match a
      case Open(x) =>            // x == g: both set Range(idx, None)
      case Close(x) =>           // x == g: GMClose reads Find(g, .), equal by hyp
      case Reset(gs) =>          // g in gs: both drop g
        assert g in (set y | y in gs);
    }
  }

  /** R3b MILESTONE: `TreeRes`'s leaf value at a SINGLE group `g` depends on the
      incoming group map ONLY through its value at `g`. Changing the incoming map
      at ANY OTHER group leaves `g`'s captured value at the highest-priority leaf
      unchanged, and control flow (success / end position) is fully gm-blind. This
      is the "surrounding groups are irrelevant" half of value composition for
      nested-look captures: it lets the reconstruction swap the running `gmMain`
      for `Empty` (they agree at `g` by the outer `DefGroups` hypothesis) without
      disturbing `g`. Structural induction over `t`; the `LK` case recurses through
      the look body at ANY depth -- the sub-look's leaf value at `g` is itself
      `g`-framed, so the value threaded into the continuation agrees at `g`.
      Needs NO confinement: a group's value flows only from its OWN writes (which
      read the input position and, for `Close`, `g`'s own open entry), never from
      another group's entry. */
  lemma TreeResGValueFramed(t: LT.Tree, gm1: LG.GroupMap, gm2: LG.GroupMap, inp: LC.Input,
                            dir: WP.Direction, g: LG.GroupId)
    requires LG.Find(g, gm1) == LG.Find(g, gm2)
    ensures (LT.TreeRes(t, gm1, inp, dir).None? <==> LT.TreeRes(t, gm2, inp, dir).None?)
    ensures LT.TreeRes(t, gm1, inp, dir).Some? ==>
              LT.TreeRes(t, gm1, inp, dir).value.0 == LT.TreeRes(t, gm2, inp, dir).value.0
              && LG.Find(g, LT.TreeRes(t, gm1, inp, dir).value.1)
                 == LG.Find(g, LT.TreeRes(t, gm2, inp, dir).value.1)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) =>
      TreeResGValueFramed(t1, gm1, gm2, inp, dir, g);
      TreeResGValueFramed(t2, gm1, gm2, inp, dir, g);
    case Read(c, t1) =>
      TreeResGValueFramed(t1, gm1, gm2, LC.AdvanceInputP(inp, dir), dir, g);
    case ReadBackRef(brStr, t1) =>
      TreeResGValueFramed(t1, gm1, gm2, LC.AdvanceInputN(inp, |brStr|, dir), dir, g);
    case Progress(t1) =>
      TreeResGValueFramed(t1, gm1, gm2, inp, dir, g);
    case AnchorPass(a, t1) =>
      TreeResGValueFramed(t1, gm1, gm2, inp, dir, g);
    case GroupActionT(a, t1) =>
      GMUpdateFindAgree(a, LC.Idx(inp), gm1, gm2, g);
      TreeResGValueFramed(t1, LG.GMUpdate(a, LC.Idx(inp), gm1), LG.GMUpdate(a, LC.Idx(inp), gm2), inp, dir, g);
    case LK(lk, tlk, t1) =>
      TreeResGValueFramed(tlk, gm1, gm2, inp, L.LkDir(lk), g);
      if L.Positivity(lk) {
        match LT.TreeRes(tlk, gm1, inp, L.LkDir(lk))
        case None =>
        case Some(pair1) =>
          var pair2 := LT.TreeRes(tlk, gm2, inp, L.LkDir(lk)).value;
          TreeResGValueFramed(t1, pair1.1, pair2.1, inp, dir, g);
      } else {
        match LT.TreeRes(tlk, gm1, inp, L.LkDir(lk))
        case None => TreeResGValueFramed(t1, gm1, gm2, inp, dir, g);
        case Some(_) =>
      }
    case LKFail(lk, tlk) =>
  }

  /** `g` is written by NO group action anywhere in `t` (at any depth, INCLUDING
      inside look bodies). */
  ghost predicate GNotWritten(t: LT.Tree, g: LG.GroupId)
    decreases t
  {
    match t
    case Mismatch => true
    case Match => true
    case Choice(t1, t2) => GNotWritten(t1, g) && GNotWritten(t2, g)
    case Read(_, t1) => GNotWritten(t1, g)
    case ReadBackRef(_, t1) => GNotWritten(t1, g)
    case Progress(t1) => GNotWritten(t1, g)
    case AnchorPass(_, t1) => GNotWritten(t1, g)
    case GroupActionT(a, t1) => !ActTouchesG(a, g) && GNotWritten(t1, g)
    case LK(_, tlk, t1) => GNotWritten(tlk, g) && GNotWritten(t1, g)
    case LKFail(_, tlk) => GNotWritten(tlk, g)
  }

  /** If `g` is never written in `t`, the highest-priority leaf keeps `g`'s
      incoming value. The frame that carries a look's contributed value through a
      continuation which defines `g` nowhere. */
  lemma TreeResGNotWritten(t: LT.Tree, gm: LG.GroupMap, inp: LC.Input, dir: WP.Direction, g: LG.GroupId)
    requires GNotWritten(t, g)
    ensures LT.TreeRes(t, gm, inp, dir).Some? ==>
              LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1) == LG.Find(g, gm)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) =>
      TreeResGNotWritten(t1, gm, inp, dir, g);
      TreeResGNotWritten(t2, gm, inp, dir, g);
    case Read(c, t1) =>
      TreeResGNotWritten(t1, gm, LC.AdvanceInputP(inp, dir), dir, g);
    case ReadBackRef(brStr, t1) =>
      TreeResGNotWritten(t1, gm, LC.AdvanceInputN(inp, |brStr|, dir), dir, g);
    case Progress(t1) =>
      TreeResGNotWritten(t1, gm, inp, dir, g);
    case AnchorPass(a, t1) =>
      TreeResGNotWritten(t1, gm, inp, dir, g);
    case GroupActionT(a, t1) =>
      GMUpdateFindNotTouch(a, LC.Idx(inp), gm, g);
      TreeResGNotWritten(t1, LG.GMUpdate(a, LC.Idx(inp), gm), inp, dir, g);
    case LK(lk, tlk, t1) =>
      if L.Positivity(lk) {
        match LT.TreeRes(tlk, gm, inp, L.LkDir(lk))
        case None =>
        case Some(pair) =>
          TreeResGNotWritten(tlk, gm, inp, L.LkDir(lk), g);
          TreeResGNotWritten(t1, pair.1, inp, dir, g);
      } else {
        match LT.TreeRes(tlk, gm, inp, L.LkDir(lk))
        case None => TreeResGNotWritten(t1, gm, inp, dir, g);
        case Some(_) =>
      }
    case LKFail(lk, tlk) =>
  }

  /** B' BRIDGE (structural): a recursively-confined tree — every group action at
      ANY depth (spine or inside a look body) touches only `S` (`GmActionIn`) —
      never writes a group `g` OUTSIDE `S`. `GmActionIn(a,S)` bans `a` from
      touching any `g !in S`, so this is exactly the complement of `GNotWritten`.
      The lever that turns the campaign's depth-k confinement (`LkConfinedTreeRec`,
      already established for compiled bodies) into the `GNotWritten` frame the
      value-composition lemmas consume. */
  lemma LkConfinedTreeRecGNotWritten(t: LT.Tree, S: set<LG.GroupId>, g: LG.GroupId)
    requires CE.LkConfinedTreeRec(t, S)
    requires g !in S
    ensures GNotWritten(t, g)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) => LkConfinedTreeRecGNotWritten(t1, S, g); LkConfinedTreeRecGNotWritten(t2, S, g);
    case Read(_, t1) => LkConfinedTreeRecGNotWritten(t1, S, g);
    case ReadBackRef(_, t1) => LkConfinedTreeRecGNotWritten(t1, S, g);
    case Progress(t1) => LkConfinedTreeRecGNotWritten(t1, S, g);
    case AnchorPass(_, t1) => LkConfinedTreeRecGNotWritten(t1, S, g);
    case GroupActionT(a, t1) =>
      assert !ActTouchesG(a, g) by {
        match a case Open(x) => case Close(x) => case Reset(gs) => assert g !in gs;
      }
      LkConfinedTreeRecGNotWritten(t1, S, g);
    case LK(_, tlk, t1) => LkConfinedTreeRecGNotWritten(tlk, S, g); LkConfinedTreeRecGNotWritten(t1, S, g);
    case LKFail(_, tlk) => LkConfinedTreeRecGNotWritten(tlk, S, g);
  }

  /** B' UTILITY: a recursive-fragment regex's spec tree does NOT write a group `g`
      it does not define (`g !in DefGroups(r)`), at ANY depth (spine or inside a
      nested look body). `L.DefGroups` recurses THROUGH lookaround bodies, so
      `g !in DefGroups(r)` genuinely covers every capture position. This is the
      `GNotWritten` frame every value-composition step needs for a subtree whose
      regex is free of `g` — a sibling alternation branch, a look-free prefix, or
      (the branching owner-peel's key use) the SETTLED continuation AFTER `g`'s
      unique owner look, where `CapUnique` gives `g !in DefGroups(rest)`. Via
      `LL.ComputeTrConfinedRec` (`LkConfinedTreeRec` at `S = DefGroups(r)`) composed
      with the `LkConfinedTreeRecGNotWritten` bridge. */
  lemma GNotWrittenComputeTr(rer: LW.RegExpRecord, r: L.Regex, inp: LC.Input, gm: LG.GroupMap,
                             dir: WP.Direction, g: LG.GroupId)
    requires EL.PikeLkRegexRec(r)
    requires g !in (set x | x in L.DefGroups(r))
    ensures GNotWritten(LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir), g)
  {
    var S := set x | x in L.DefGroups(r);
    assert LL.DefGroupsIn(r, S);
    LL.ComputeTrConfinedRec(rer, r, inp, gm, dir, S);
    LkConfinedTreeRecGNotWritten(LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir), S, g);
  }

  /** Every group defined by an `Areg` of `acts` is in `AllDefsActs(acts)`. */
  lemma DefInAllDefsActs(acts: LS.Actions, i: int, x: LG.GroupId)
    requires 0 <= i < |acts| && acts[i].Areg? && x in L.DefGroups(acts[i].r)
    ensures x in (set y | y in AllDefsActs(acts))
    decreases |acts|
  {
    AllDefsActsCons(acts[0], acts[1..]);
    assert acts == [acts[0]] + acts[1..];
    if i == 0 { } else { DefInAllDefsActs(acts[1..], i - 1, x); assert acts[1..][i - 1] == acts[i]; }
  }

  /** B' UTILITY (actions form of `GNotWrittenComputeTr`): a recursive-fragment
      ACTION LIST whose defined groups and pending closes both miss `g` builds a
      spec tree that never writes `g`. This is the SETTLED-continuation frame the
      branching owner-peel needs: AFTER `g`'s unique owner look, the remaining
      action list defines `g` nowhere (`g !in AllDefsActs`) and has no pending
      `Aclose(g)` (`g !in PendingCloses`), so its subtree is `GNotWritten(_, g)` —
      the single-writer disjunct of `GBodyOK`/`GOwnerWF2` at each `LK` node. Via
      `LL.ComputeTreeConfinedRec` at `S = AllDefsActs ∪ PendingCloses` (∌ g) + the
      `LkConfinedTreeRecGNotWritten` bridge. */
  lemma GNotWrittenComputeTrActs(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input, gm: LG.GroupMap,
                                 dir: WP.Direction, g: LG.GroupId)
    requires EL.PikeLkActionsRec(acts)
    requires g !in (set x | x in AllDefsActs(acts))
    requires g !in PendingCloses(acts)
    ensures GNotWritten(LFU.ComputeTr(rer, acts, inp, gm, dir), g)
  {
    var S := (set x | x in AllDefsActs(acts)) + PendingCloses(acts);
    assert g !in S;
    assert LL.ConfinedActsRec(acts, S) by {
      forall i | 0 <= i < |acts|
        ensures (acts[i].Areg? ==> LL.DefGroupsIn(acts[i].r, S))
                && (acts[i].Aclose? ==> acts[i].gid in S)
      {
        if acts[i].Areg? {
          forall x | x in L.DefGroups(acts[i].r) ensures x in S { DefInAllDefsActs(acts, i, x); }
        }
        if acts[i].Aclose? { assert acts[i].gid in PendingCloses(acts); }
      }
    }
    var fuel := LFS.ActionsFuel(acts, inp, dir) + 1;
    LFS.FunctionalTerminates(rer, acts, inp, gm, dir, fuel);
    LL.ComputeTreeConfinedRec(rer, acts, inp, gm, dir, fuel, S);
    LkConfinedTreeRecGNotWritten(LFU.ComputeTr(rer, acts, inp, gm, dir), S, g);
  }

  /** Fuel form of `GNotWrittenComputeTrActs`: usable INSIDE a `ComputeTree` walk
      (no fuel saturation needed), so the single-writer disjunct can be discharged
      on the body/continuation subtrees at the walk's own fuel. */
  lemma GNotWrittenComputeTreeActs(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input, gm: LG.GroupMap,
                                   dir: WP.Direction, fuel: nat, g: LG.GroupId)
    requires EL.PikeLkActionsRec(acts)
    requires g !in (set x | x in AllDefsActs(acts))
    requires g !in PendingCloses(acts)
    ensures LFS.ComputeTree(rer, acts, inp, gm, dir, fuel).Some?
            ==> GNotWritten(LFS.ComputeTree(rer, acts, inp, gm, dir, fuel).value, g)
  {
    var S := (set x | x in AllDefsActs(acts)) + PendingCloses(acts);
    assert g !in S;
    assert LL.ConfinedActsRec(acts, S) by {
      forall i | 0 <= i < |acts|
        ensures (acts[i].Areg? ==> LL.DefGroupsIn(acts[i].r, S))
                && (acts[i].Aclose? ==> acts[i].gid in S)
      {
        if acts[i].Areg? {
          forall x | x in L.DefGroups(acts[i].r) ensures x in S { DefInAllDefsActs(acts, i, x); }
        }
        if acts[i].Aclose? { assert acts[i].gid in PendingCloses(acts); }
      }
    }
    LL.ComputeTreeConfinedRec(rer, acts, inp, gm, dir, fuel, S);
    if LFS.ComputeTree(rer, acts, inp, gm, dir, fuel).Some? {
      LkConfinedTreeRecGNotWritten(LFS.ComputeTree(rer, acts, inp, gm, dir, fuel).value, S, g);
    }
  }

  /** R3b (the task's clean "outer leaf value at an inner `g` == the LK sub-tree's
      value at `g`" form, ONE step): at a matched POSITIVE look node whose
      continuation `t1` never writes `g`, the whole node's leaf value at `g`
      equals the look SUB-tree's highest-priority value at `g` -- i.e. exactly the
      `LkResult` of that look at `g`. The continuation only THREADS the look's
      contributed value; it never rewrites it (each capture is defined once). */
  lemma TreeResLkNodeGValue(lk: L.Lookaround, tlk: LT.Tree, t1: LT.Tree, gm: LG.GroupMap,
                            inp: LC.Input, dir: WP.Direction, g: LG.GroupId)
    requires L.Positivity(lk)
    requires GNotWritten(t1, g)
    requires LT.TreeRes(LT.LK(lk, tlk, t1), gm, inp, dir).Some?
    ensures LG.Find(g, LT.TreeRes(LT.LK(lk, tlk, t1), gm, inp, dir).value.1)
         == LG.Find(g, LT.TreeRes(tlk, gm, inp, L.LkDir(lk)).value.1)
  {
    // node Some ==> sub Some (else the node is None); the node value is
    // TreeRes(t1, sub.value.1, inp, dir), and t1 never rewrites g.
    var pair := LT.TreeRes(tlk, gm, inp, L.LkDir(lk)).value;
    TreeResGNotWritten(t1, pair.1, inp, dir, g);
  }

  /** R3b bridge to the file's `GmAgreeOn` vocabulary: `TreeResGValueFramed` at
      the singleton `{g}`. Two maps agreeing at `g` yield leaves agreeing at `g`
      (and identical success / position). */
  lemma TreeResGValueFramedAgree(t: LT.Tree, gm1: LG.GroupMap, gm2: LG.GroupMap, inp: LC.Input,
                                 dir: WP.Direction, g: LG.GroupId)
    requires GmAgreeOn(gm1, gm2, {g})
    ensures (LT.TreeRes(t, gm1, inp, dir).None? <==> LT.TreeRes(t, gm2, inp, dir).None?)
    ensures LT.TreeRes(t, gm1, inp, dir).Some? ==>
              LT.TreeRes(t, gm1, inp, dir).value.0 == LT.TreeRes(t, gm2, inp, dir).value.0
              && GmAgreeOn(LT.TreeRes(t, gm1, inp, dir).value.1, LT.TreeRes(t, gm2, inp, dir).value.1, {g})
  {
    assert LG.Find(g, gm1) == LG.Find(g, gm2);
    TreeResGValueFramed(t, gm1, gm2, inp, dir, g);
  }

  /** Two maps agree at every group OTHER than `g` (they may differ at `g`). */
  ghost predicate AgreeOffG(gm1: LG.GroupMap, gm2: LG.GroupMap, g: LG.GroupId) {
    forall h :: h != g ==> LG.Find(h, gm1) == LG.Find(h, gm2)
  }

  /** The SAME action preserves off-`g` agreement (it touches groups != `g` where
      the two maps already agree, or `g` itself identically on both). */
  lemma GMUpdateAgreeOffG(a: LG.GroupAction, idx: nat, gm1: LG.GroupMap, gm2: LG.GroupMap, g: LG.GroupId)
    requires AgreeOffG(gm1, gm2, g)
    ensures AgreeOffG(LG.GMUpdate(a, idx, gm1), LG.GMUpdate(a, idx, gm2), g)
  {
    forall h | h != g
      ensures LG.Find(h, LG.GMUpdate(a, idx, gm1)) == LG.Find(h, LG.GMUpdate(a, idx, gm2))
    {
      GMUpdateFindAgree(a, idx, gm1, gm2, h);
    }
  }

  /** Off-`g` agreement is preserved through `TreeRes` for ANY tree -- it is just
      `TreeResGValueFramed` applied at every group != `g`. The companion of
      `TreeResGValueFramed` that lets the disjunction induction below re-establish
      its off-`g` hypothesis at each look boundary WITHOUT threading it through. */
  lemma TreeResAgreeOffG(t: LT.Tree, gm1: LG.GroupMap, gm2: LG.GroupMap, inp: LC.Input,
                         dir: WP.Direction, g: LG.GroupId)
    requires AgreeOffG(gm1, gm2, g)
    ensures LT.TreeRes(t, gm1, inp, dir).Some? ==>
              LT.TreeRes(t, gm2, inp, dir).Some?
              && AgreeOffG(LT.TreeRes(t, gm1, inp, dir).value.1, LT.TreeRes(t, gm2, inp, dir).value.1, g)
  {
    if LT.TreeRes(t, gm1, inp, dir).Some? {
      TreeResGmFrameRec(t, gm1, gm2, inp, dir, {});   // None-iff: gm2 side Some too
      forall h | h != g
        ensures LG.Find(h, LT.TreeRes(t, gm1, inp, dir).value.1)
             == LG.Find(h, LT.TreeRes(t, gm2, inp, dir).value.1)
      {
        TreeResGValueFramed(t, gm1, gm2, inp, dir, h);
      }
    }
  }

  /** `g` is never CLOSED (or reset while carrying an external value) before it is
      OPENED on any path -- the "def-before-use" shape every capture in a compiled
      tree has. Formally: a `Close(g)` node is forbidden UNLESS dominated by an
      earlier `Open(g)`/`Reset({..g..})` (after which the subtree is unconstrained,
      as `g`'s value is then input-determined). This is exactly the hypothesis that
      makes the value at `g` gm[g]-INDEPENDENT once `g` is written on the path. */
  ghost predicate GDefBeforeClose(t: LT.Tree, g: LG.GroupId)
    decreases t
  {
    match t
    case Mismatch => true
    case Match => true
    case Choice(t1, t2) => GDefBeforeClose(t1, g) && GDefBeforeClose(t2, g)
    case Read(_, t1) => GDefBeforeClose(t1, g)
    case ReadBackRef(_, t1) => GDefBeforeClose(t1, g)
    case Progress(t1) => GDefBeforeClose(t1, g)
    case AnchorPass(_, t1) => GDefBeforeClose(t1, g)
    case GroupActionT(a, t1) =>
      (match a
       case Open(x) => if x == g then true else GDefBeforeClose(t1, g)
       case Reset(gs) => if g in gs then true else GDefBeforeClose(t1, g)
       case Close(x) => x != g && GDefBeforeClose(t1, g))
    case LK(_, tlk, t1) => GDefBeforeClose(tlk, g) && GDefBeforeClose(t1, g)
    case LKFail(_, tlk) => GDefBeforeClose(tlk, g)
  }

  /** R3b HEADLINE: for a def-before-use tree, the leaf value at `g` is either
      contributed by a write on the highest-priority path -- and then it is
      INDEPENDENT of the incoming `gm[g]` (the two runs from maps differing only
      at `g` AGREE at `g`) -- or `g` was never written on that path, and each run
      simply passes its own `gm[g]` through. This is the pure-spec content of
      "the inner capture's value is determined by the owning look, not the
      surrounding gm": at the owning look the first disjunct fires, pinning the
      value to the look's own sub-result regardless of `gmMain`. Structural
      induction; off-`g` agreement of intermediate maps is re-derived on demand via
      `TreeResAgreeOffG`, so the induction carries only the single `g`-value. */
  lemma TreeResGIndepWhenWritten(t: LT.Tree, gm1: LG.GroupMap, gm2: LG.GroupMap, inp: LC.Input,
                                 dir: WP.Direction, g: LG.GroupId)
    requires AgreeOffG(gm1, gm2, g)
    requires GDefBeforeClose(t, g)
    ensures (LT.TreeRes(t, gm1, inp, dir).None? <==> LT.TreeRes(t, gm2, inp, dir).None?)
    ensures LT.TreeRes(t, gm1, inp, dir).Some? ==>
              LG.Find(g, LT.TreeRes(t, gm1, inp, dir).value.1)
              == LG.Find(g, LT.TreeRes(t, gm2, inp, dir).value.1)
              || (LG.Find(g, LT.TreeRes(t, gm1, inp, dir).value.1) == LG.Find(g, gm1)
                  && LG.Find(g, LT.TreeRes(t, gm2, inp, dir).value.1) == LG.Find(g, gm2))
    decreases t
  {
    TreeResGmFrameRec(t, gm1, gm2, inp, dir, {});   // None-iff + end position
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) =>
      TreeResGIndepWhenWritten(t1, gm1, gm2, inp, dir, g);
      TreeResGIndepWhenWritten(t2, gm1, gm2, inp, dir, g);
    case Read(c, t1) =>
      TreeResGIndepWhenWritten(t1, gm1, gm2, LC.AdvanceInputP(inp, dir), dir, g);
    case ReadBackRef(brStr, t1) =>
      TreeResGIndepWhenWritten(t1, gm1, gm2, LC.AdvanceInputN(inp, |brStr|, dir), dir, g);
    case Progress(t1) =>
      TreeResGIndepWhenWritten(t1, gm1, gm2, inp, dir, g);
    case AnchorPass(a, t1) =>
      TreeResGIndepWhenWritten(t1, gm1, gm2, inp, dir, g);
    case GroupActionT(a, t1) =>
      var idx := LC.Idx(inp);
      var gm1' := LG.GMUpdate(a, idx, gm1);
      var gm2' := LG.GMUpdate(a, idx, gm2);
      GMUpdateAgreeOffG(a, idx, gm1, gm2, g);
      match a {
        case Open(x) =>
          if x == g {
            assert LG.Find(g, gm1') == LG.Find(g, gm2');   // both Some(Range(idx, None))
            TreeResGValueFramed(t1, gm1', gm2', inp, dir, g);
          } else {
            GMUpdateFindNotTouch(a, idx, gm1, g);
            GMUpdateFindNotTouch(a, idx, gm2, g);
            TreeResGIndepWhenWritten(t1, gm1', gm2', inp, dir, g);
          }
        case Reset(gs) =>
          if g in gs {
            assert g in (set y | y in gs);
            assert LG.Find(g, gm1') == LG.Find(g, gm2');   // both None
            TreeResGValueFramed(t1, gm1', gm2', inp, dir, g);
          } else {
            GMUpdateFindNotTouch(a, idx, gm1, g);
            GMUpdateFindNotTouch(a, idx, gm2, g);
            TreeResGIndepWhenWritten(t1, gm1', gm2', inp, dir, g);
          }
        case Close(x) =>
          assert x != g;                                   // GDefBeforeClose
          GMUpdateFindNotTouch(a, idx, gm1, g);
          GMUpdateFindNotTouch(a, idx, gm2, g);
          TreeResGIndepWhenWritten(t1, gm1', gm2', inp, dir, g);
      }
    case LK(lk, tlk, t1) =>
      if L.Positivity(lk) {
        match LT.TreeRes(tlk, gm1, inp, L.LkDir(lk))
        case None =>
        case Some(pair1) =>
          var pair2 := LT.TreeRes(tlk, gm2, inp, L.LkDir(lk)).value;
          TreeResGIndepWhenWritten(tlk, gm1, gm2, inp, L.LkDir(lk), g);   // disjunct for pair.1
          TreeResAgreeOffG(tlk, gm1, gm2, inp, L.LkDir(lk), g);           // AgreeOffG(pair1.1, pair2.1, g)
          TreeResGIndepWhenWritten(t1, pair1.1, pair2.1, inp, dir, g);    // disjunct for node
      } else {
        match LT.TreeRes(tlk, gm1, inp, L.LkDir(lk))
        case None => TreeResGIndepWhenWritten(t1, gm1, gm2, inp, dir, g);
        case Some(_) =>
      }
    case LKFail(lk, tlk) =>
  }

  // ===========================================================================
  // R30b (ADDITIVE): SPEC-structural link from the OUTER tree's leaf value at an
  // inner capture `g` to the innermost OWNER lookaround's OWN sub-result at `g`.
  // The value flows outer-tree -> (through possibly several matched positive LK
  // layers) -> the owner look's body tree, and by R3b it is pinned by that body
  // (gm-blind except through gm[g], and `g` written once), so it equals the
  // owner sub-tree's OWN (fresh, Empty-map) `TreeRes` value at `g`.
  // ===========================================================================

  /** R30b (single-layer, composable): the "outer-leaf-at-`g` == owner sub-result
      -at-`g`" identity for ONE lookaround layer, with the owner sub-result taken
      at the FRESH map `Empty` (matching the engine fresh-match form). At a matched
      positive look node whose continuation `t1` never writes `g`, if `g` is FRESH
      at the node (`Find(g, gm) == None`), the whole node's leaf value at `g`
      equals the look SUB-tree's OWN (Empty-map) `TreeRes` value at `g`. Peels the
      layer with `TreeResLkNodeGValue` (node[g] == sub[g] at `gm`), then swaps `gm`
      for `Empty` with `TreeResGValueFramed` (they agree at `g`, both `None`). This
      is exactly the last hop the seam's `recon_inner` needs at each look layer. */
  lemma TreeResLkNodeGValueFresh(lk: L.Lookaround, tlk: LT.Tree, t1: LT.Tree, gm: LG.GroupMap,
                                 inp: LC.Input, dir: WP.Direction, g: LG.GroupId)
    requires L.Positivity(lk)
    requires GNotWritten(t1, g)
    requires LG.Find(g, gm) == None
    requires LT.TreeRes(LT.LK(lk, tlk, t1), gm, inp, dir).Some?
    ensures LT.TreeRes(tlk, LG.Empty, inp, L.LkDir(lk)).Some?
    ensures LG.Find(g, LT.TreeRes(LT.LK(lk, tlk, t1), gm, inp, dir).value.1)
         == LG.Find(g, LT.TreeRes(tlk, LG.Empty, inp, L.LkDir(lk)).value.1)
  {
    // node Some (positive lk) ==> sub Some at `gm`; framing carries Some to Empty.
    assert LT.TreeRes(tlk, gm, inp, L.LkDir(lk)).Some?;
    assert LG.Find(g, gm) == LG.Find(g, LG.Empty);   // both None
    TreeResGValueFramed(tlk, gm, LG.Empty, inp, L.LkDir(lk), g);
    TreeResLkNodeGValue(lk, tlk, t1, gm, inp, dir, g);
  }

  /** `g` is written by NO group action on the SPINE of `t` — i.e. anywhere
      OUTSIDE a look-body subtree. Writes to `g` INSIDE an `LK` body (`tlk`) are
      unconstrained: this is exactly the shape `ComputeTr(Translate(body))` has for
      a capture `g in LkBodyGroups(Translate(body))`, which by `CapUnique` occurs
      only inside one lookaround body and never on the outer spine. Strictly weaker
      than `GNotWritten` (which also forbids writes inside look bodies). */
  ghost predicate GWriteOnlyInLooks(t: LT.Tree, g: LG.GroupId)
    decreases t
  {
    match t
    case Mismatch => true
    case Match => true
    case Choice(t1, t2) => GWriteOnlyInLooks(t1, g) && GWriteOnlyInLooks(t2, g)
    case Read(_, t1) => GWriteOnlyInLooks(t1, g)
    case ReadBackRef(_, t1) => GWriteOnlyInLooks(t1, g)
    case Progress(t1) => GWriteOnlyInLooks(t1, g)
    case AnchorPass(_, t1) => GWriteOnlyInLooks(t1, g)
    case GroupActionT(a, t1) => !ActTouchesG(a, g) && GWriteOnlyInLooks(t1, g)
    case LK(_, tlk, t1) => GWriteOnlyInLooks(t1, g)     // tlk (look body) unconstrained
    case LKFail(_, tlk) => true
  }

  /** R30b MULTI-LAYER ENGINE (the task's "single highest-priority matched LK node"
      helper): for a tree whose `g`-writes all live inside look bodies
      (`GWriteOnlyInLooks`), the highest-priority leaf's value at `g` is EITHER the
      incoming `gm[g]` (no matched look on the path contributed `g`) OR the OWN
      sub-result value at `g` of a matched POSITIVE look node reached on that path
      — `Find(g, TreeRes(t)…) == Find(g, TreeRes(tsub, gmo, inpo, LkDir(lk))…)`.
      The look body `tsub` is itself a tree of the same shape (its own `g`-writes
      are again confined to its inner looks), so applying THIS lemma to `tsub`
      peels the next nesting layer; iterating (measure: nesting depth) descends to
      the INNERMOST owner whose body writes `g` directly on its spine. This is the
      pure-tree content of "the inner capture's value is pinned by the owning
      look, regardless of the surrounding group map". Structural induction over `t`
      (mirrors the `TreeResGmFrameRec` template); the LK case peels one layer with
      the R3b `TreeResLkNodeGValue` reasoning inlined and recurses into the
      CONTINUATION only. */
  lemma TreeResGSpineValue(t: LT.Tree, gm: LG.GroupMap, inp: LC.Input, dir: WP.Direction, g: LG.GroupId)
    returns (found: bool, lk: L.Lookaround, tsub: LT.Tree, gmo: LG.GroupMap, inpo: LC.Input)
    requires GWriteOnlyInLooks(t, g)
    requires LT.TreeRes(t, gm, inp, dir).Some?
    ensures found ==> tsub < t
    ensures !found ==> LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1) == LG.Find(g, gm)
    ensures found ==>
              L.Positivity(lk)
              && LT.TreeRes(tsub, gmo, inpo, L.LkDir(lk)).Some?
              && LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1)
                 == LG.Find(g, LT.TreeRes(tsub, gmo, inpo, L.LkDir(lk)).value.1)
    decreases t
  {
    match t
    case Match =>
      found, lk, tsub, gmo, inpo := false, L.LookAhead, t, gm, inp;
    case Mismatch =>
      found, lk, tsub, gmo, inpo := false, L.LookAhead, t, gm, inp;   // TreeRes None: vacuous
    case LKFail(lk0, tsub0) =>
      found, lk, tsub, gmo, inpo := false, L.LookAhead, tsub0, gm, inp;   // TreeRes None: vacuous
    case Choice(t1, t2) =>
      if LT.TreeRes(t1, gm, inp, dir).Some? {
        found, lk, tsub, gmo, inpo := TreeResGSpineValue(t1, gm, inp, dir, g);
      } else {
        found, lk, tsub, gmo, inpo := TreeResGSpineValue(t2, gm, inp, dir, g);
      }
    case Read(c, t1) =>
      found, lk, tsub, gmo, inpo := TreeResGSpineValue(t1, gm, LC.AdvanceInputP(inp, dir), dir, g);
    case ReadBackRef(brStr, t1) =>
      found, lk, tsub, gmo, inpo := TreeResGSpineValue(t1, gm, LC.AdvanceInputN(inp, |brStr|, dir), dir, g);
    case Progress(t1) =>
      found, lk, tsub, gmo, inpo := TreeResGSpineValue(t1, gm, inp, dir, g);
    case AnchorPass(a, t1) =>
      found, lk, tsub, gmo, inpo := TreeResGSpineValue(t1, gm, inp, dir, g);
    case GroupActionT(a, t1) =>
      GMUpdateFindNotTouch(a, LC.Idx(inp), gm, g);           // Find(g, GMUpdate) == Find(g, gm)
      found, lk, tsub, gmo, inpo := TreeResGSpineValue(t1, LG.GMUpdate(a, LC.Idx(inp), gm), inp, dir, g);
    case LK(lk0, tsub0, t1) =>
      if L.Positivity(lk0) {
        var sub := LT.TreeRes(tsub0, gm, inp, L.LkDir(lk0));
        assert sub.Some?;                                    // node Some ==> sub Some
        var fc, lkc, tsubc, gmoc, inpoc := TreeResGSpineValue(t1, sub.value.1, inp, dir, g);
        if fc {
          found, lk, tsub, gmo, inpo := true, lkc, tsubc, gmoc, inpoc;
        } else {
          // Find(g, leaf) == Find(g, sub.value.1) == Find(g, TreeRes(tsub0, gm, inp, LkDir).value.1)
          found, lk, tsub, gmo, inpo := true, lk0, tsub0, gm, inp;
        }
      } else {
        var sub := LT.TreeRes(tsub0, gm, inp, L.LkDir(lk0));
        assert sub.None?;                                    // node Some (negative) ==> sub None
        found, lk, tsub, gmo, inpo := TreeResGSpineValue(t1, gm, inp, dir, g);
      }
  }

  /** R31b UNIQUENESS SHAPE. `TreeResGSpineValue` above descends to the
      structurally-DEEPEST matched positive look on the winning spine — its value
      equation holds by value PRESERVATION (pass-through), NOT by the returned look
      OWNING `g`. For a body like `(?=(?<g>a))(?=b)` its returned `tsub` is `(?=b)`'s
      body (which never writes `g`), so a naive iterate-to-`!GWriteOnlyInLooks` would
      mis-identify the owner. `GOwnerWF(t, g)` is the extra hypothesis that makes
      owner-finding SOUND: no `g`-write on the spine, and at every `LK` node at most
      ONE of {body `tlk`, continuation `t1`} writes `g` (`GNotWritten(tlk,g) ||
      GNotWritten(t1,g)`) — i.e. along any single spine path `g`'s write lives in a
      UNIQUE look body. A compiled `ComputeTr(Translate(body))` tree satisfies this
      for `g in LkBodyGroups` by `CapUnique` (`g` captured in exactly one look body),
      EXCEPT where quantifier unrolling of the OWNER look itself duplicates that body
      on one path (quantified capturing lookaround) — flagged as the deeper-nesting
      obstruction. Strictly stronger than `GWriteOnlyInLooks`. */
  ghost predicate GOwnerWF(t: LT.Tree, g: LG.GroupId)
    decreases t
  {
    match t
    case Mismatch => true
    case Match => true
    case Choice(t1, t2) => GOwnerWF(t1, g) && GOwnerWF(t2, g)
    case Read(_, t1) => GOwnerWF(t1, g)
    case ReadBackRef(_, t1) => GOwnerWF(t1, g)
    case Progress(t1) => GOwnerWF(t1, g)
    case AnchorPass(_, t1) => GOwnerWF(t1, g)
    case GroupActionT(a, t1) => !ActTouchesG(a, g) && GOwnerWF(t1, g)
    case LK(_, tlk, t1) =>
      GOwnerWF(tlk, g) && GOwnerWF(t1, g) && (GNotWritten(tlk, g) || GNotWritten(t1, g))
    case LKFail(_, tlk) => GOwnerWF(tlk, g)
  }

  /** `GOwnerWF` refines `GWriteOnlyInLooks` (no spine writes, look bodies free). */
  lemma GOwnerWFImpliesSpine(t: LT.Tree, g: LG.GroupId)
    requires GOwnerWF(t, g)
    ensures GWriteOnlyInLooks(t, g)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) => GOwnerWFImpliesSpine(t1, g); GOwnerWFImpliesSpine(t2, g);
    case Read(_, t1) => GOwnerWFImpliesSpine(t1, g);
    case ReadBackRef(_, t1) => GOwnerWFImpliesSpine(t1, g);
    case Progress(t1) => GOwnerWFImpliesSpine(t1, g);
    case AnchorPass(_, t1) => GOwnerWFImpliesSpine(t1, g);
    case GroupActionT(a, t1) => GOwnerWFImpliesSpine(t1, g);
    case LK(_, tlk, t1) => GOwnerWFImpliesSpine(t1, g);
    case LKFail(_, tlk) =>
  }

  // ==========================================================================
  // B' FINDING (machine-checked): `GOwnerWF` COLLAPSES to `GNotWritten`, so the
  // "sound owner descent" `TreeResGOwnerDescent`/`TreeResGOwnerFresh` is VACUOUS
  // for any `g` that is actually WRITTEN (every captured inside-look group).
  //
  // `GOwnerWF`'s `LK` case requires `GOwnerWF(tlk, g)` on the look BODY. But the
  // owner look's body writes `g` DIRECTLY on its spine, and `GOwnerWF`'s
  // `GroupActionT` case bans `ActTouchesG(a,g)` at every level INCLUDING inside
  // look bodies (it recurses `GOwnerWF` into `tlk`). Hence `GOwnerWF(t,g) ==>
  // GNotWritten(t,g)` (below), and trivially the converse, so `GOwnerWF <==>
  // GNotWritten`. In `TreeResGOwnerDescent`'s `LK` case the owner-found branch is
  // guarded by `!GNotWritten(tsub0,g)` (the body writes `g`); under the precond
  // `GOwnerWF(t,g)` we have `GOwnerWF(tsub0,g) ==> GNotWritten(tsub0,g)`, so that
  // branch is DEAD. The descent therefore NEVER returns `found`, proving only the
  // trivial pass-through `Find(g,leaf) == Find(g,gm)`.
  //
  // CONSEQUENCE for brick B' milestone #2: composing the general owner↔tree
  // identity with `TreeResGOwnerFresh` cannot work as-is. The fix is to WEAKEN
  // `GOwnerWF`'s `LK` case so the owner look body is NOT required write-free:
  // split into an outer-context predicate (no `g` on the outer spine; ≤1 of
  // {body,cont} writes `g` per path) and a BODY predicate that PERMITS the owner
  // body's own spine to write `g` while still confining `g` to a unique look per
  // deeper path. The correct outer-spine-only invariant (`GWriteOnlyInLooks`) is
  // now established for the compiled tree by `ComputeTrGWriteOnlyInLooks` above.
  // ==========================================================================

  /** B' FINDING: `GOwnerWF` is no stronger than `GNotWritten` — its recursion
      into look bodies (`GOwnerWF(tlk,g)`) plus the spine-write ban collapses it to
      "`g` never written anywhere". Machine-checked witness that the current
      `TreeResGOwnerDescent`/`Fresh` scaffolding cannot find a genuine owner. */
  lemma GOwnerWFImpliesGNotWritten(t: LT.Tree, g: LG.GroupId)
    requires GOwnerWF(t, g)
    ensures GNotWritten(t, g)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) => GOwnerWFImpliesGNotWritten(t1, g); GOwnerWFImpliesGNotWritten(t2, g);
    case Read(_, t1) => GOwnerWFImpliesGNotWritten(t1, g);
    case ReadBackRef(_, t1) => GOwnerWFImpliesGNotWritten(t1, g);
    case Progress(t1) => GOwnerWFImpliesGNotWritten(t1, g);
    case AnchorPass(_, t1) => GOwnerWFImpliesGNotWritten(t1, g);
    case GroupActionT(a, t1) => GOwnerWFImpliesGNotWritten(t1, g);
    case LK(_, tlk, t1) => GOwnerWFImpliesGNotWritten(tlk, g); GOwnerWFImpliesGNotWritten(t1, g);
    case LKFail(_, tlk) => GOwnerWFImpliesGNotWritten(tlk, g);
  }

  /** B' FINDING (converse): `GNotWritten ==> GOwnerWF`, so the two are EQUIVALENT.
      Together with `GOwnerWFImpliesGNotWritten` this pins the collapse exactly. */
  lemma GNotWrittenImpliesGOwnerWF(t: LT.Tree, g: LG.GroupId)
    requires GNotWritten(t, g)
    ensures GOwnerWF(t, g)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) => GNotWrittenImpliesGOwnerWF(t1, g); GNotWrittenImpliesGOwnerWF(t2, g);
    case Read(_, t1) => GNotWrittenImpliesGOwnerWF(t1, g);
    case ReadBackRef(_, t1) => GNotWrittenImpliesGOwnerWF(t1, g);
    case Progress(t1) => GNotWrittenImpliesGOwnerWF(t1, g);
    case AnchorPass(_, t1) => GNotWrittenImpliesGOwnerWF(t1, g);
    case GroupActionT(a, t1) => GNotWrittenImpliesGOwnerWF(t1, g);
    case LK(_, tlk, t1) => GNotWrittenImpliesGOwnerWF(tlk, g); GNotWrittenImpliesGOwnerWF(t1, g);
    case LKFail(_, tlk) => GNotWrittenImpliesGOwnerWF(tlk, g);
  }

  /** R31b (2a) — SOUND iterate-to-owner. Under `GOwnerWF` the winning-path value at
      `g` is EITHER the incoming `gm[g]` (top level: `g` never written on the winning
      path — HONEST, no intermediate map leaks) OR the OWN sub-result at `g` of a
      matched positive look whose body writes `g` DIRECTLY on its spine
      (`!GWriteOnlyInLooks(tsub, g)`): the genuine INNERMOST owner. Unlike
      `TreeResGSpineValue`, the descent recurses into the BODY that carries the
      `g`-write (not blindly into the continuation), so it lands on the writer. The
      pass-through invariant `Find(g, threaded gm) == Find(g, gm)` is maintained
      because we only thread through subtrees proven `GNotWritten(_, g)`. */
  lemma TreeResGOwnerDescent(t: LT.Tree, gm: LG.GroupMap, inp: LC.Input, dir: WP.Direction, g: LG.GroupId)
    returns (found: bool, lk: L.Lookaround, tsub: LT.Tree, gmo: LG.GroupMap, inpo: LC.Input)
    requires GOwnerWF(t, g)
    requires LT.TreeRes(t, gm, inp, dir).Some?
    ensures found ==> tsub < t
    ensures found ==> LG.Find(g, gmo) == LG.Find(g, gm)   // g unwritten before the owner
    ensures !found ==> LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1) == LG.Find(g, gm)
    ensures found ==>
              L.Positivity(lk)
              && !GWriteOnlyInLooks(tsub, g)
              && LT.TreeRes(tsub, gmo, inpo, L.LkDir(lk)).Some?
              && LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1)
                 == LG.Find(g, LT.TreeRes(tsub, gmo, inpo, L.LkDir(lk)).value.1)
    decreases t
  {
    match t
    case Match =>
      found, lk, tsub, gmo, inpo := false, L.LookAhead, t, gm, inp;
    case Mismatch =>
      found, lk, tsub, gmo, inpo := false, L.LookAhead, t, gm, inp;   // TreeRes None: vacuous
    case LKFail(lk0, tsub0) =>
      found, lk, tsub, gmo, inpo := false, L.LookAhead, tsub0, gm, inp;   // TreeRes None: vacuous
    case Choice(t1, t2) =>
      if LT.TreeRes(t1, gm, inp, dir).Some? {
        found, lk, tsub, gmo, inpo := TreeResGOwnerDescent(t1, gm, inp, dir, g);
      } else {
        found, lk, tsub, gmo, inpo := TreeResGOwnerDescent(t2, gm, inp, dir, g);
      }
    case Read(c, t1) =>
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescent(t1, gm, LC.AdvanceInputP(inp, dir), dir, g);
    case ReadBackRef(brStr, t1) =>
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescent(t1, gm, LC.AdvanceInputN(inp, |brStr|, dir), dir, g);
    case Progress(t1) =>
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescent(t1, gm, inp, dir, g);
    case AnchorPass(a, t1) =>
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescent(t1, gm, inp, dir, g);
    case GroupActionT(a, t1) =>
      GMUpdateFindNotTouch(a, LC.Idx(inp), gm, g);           // Find(g, GMUpdate) == Find(g, gm)
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescent(t1, LG.GMUpdate(a, LC.Idx(inp), gm), inp, dir, g);
    case LK(lk0, tsub0, t1) =>
      if L.Positivity(lk0) {
        var sub := LT.TreeRes(tsub0, gm, inp, L.LkDir(lk0));
        assert sub.Some?;                                    // node Some ==> sub Some
        if GNotWritten(tsub0, g) {
          // body is g-free: value passes through the look, then descend continuation.
          TreeResGNotWritten(tsub0, gm, inp, L.LkDir(lk0), g);   // Find(g, sub.value.1) == Find(g, gm)
          var fc, lkc, tsubc, gmoc, inpoc := TreeResGOwnerDescent(t1, sub.value.1, inp, dir, g);
          if fc {
            found, lk, tsub, gmo, inpo := true, lkc, tsubc, gmoc, inpoc;
            assert tsubc < t1;
          } else {
            found, lk, tsub, gmo, inpo := false, lk0, tsub0, gm, inp;
          }
        } else {
          // body writes g: by GOwnerWF the continuation does NOT, so the node's leaf
          // value at g equals the look sub-result at g (TreeResLkNodeGValue).
          assert GNotWritten(t1, g);
          TreeResLkNodeGValue(lk0, tsub0, t1, gm, inp, dir, g);
          if !GWriteOnlyInLooks(tsub0, g) {
            // g written directly on tsub0's spine: this look is the innermost owner.
            found, lk, tsub, gmo, inpo := true, lk0, tsub0, gm, inp;
          } else {
            // g is deeper inside tsub0's own looks: recurse into the body.
            var fc, lkc, tsubc, gmoc, inpoc := TreeResGOwnerDescent(tsub0, gm, inp, L.LkDir(lk0), g);
            if fc {
              found, lk, tsub, gmo, inpo := true, lkc, tsubc, gmoc, inpoc;
              assert tsubc < tsub0;
            } else {
              found, lk, tsub, gmo, inpo := false, lk0, tsub0, gm, inp;
            }
          }
        }
      } else {
        var sub := LT.TreeRes(tsub0, gm, inp, L.LkDir(lk0));
        assert sub.None?;                                    // node Some (negative) ==> sub None
        found, lk, tsub, gmo, inpo := TreeResGOwnerDescent(t1, gm, inp, dir, g);
      }
  }

  /** R31b (2a) — FRESH-map owner form: `TreeResGOwnerDescent` with the incoming
      `g` fresh (`Find(g, gm) == None`, as at the body-tree root `Empty`). Because
      `g` is unwritten before the owner (`Find(g, gmo) == Find(g, gm) == None`), the
      owner sub-result value at `g` is frame-invariant in its incoming map at `g`
      (`TreeResGValueFramed`), so it may be read at `Empty` — the exact form the
      engine's per-owner fresh replay records. So on the winning path the outer leaf
      value at `g` is EITHER unset (`None`) OR the owner body's OWN `Empty`-map
      `TreeRes` value at `g`, at the descent-recorded position `inpo`. This is the
      spec half of `recon_inner`'s per-`g` obligation; (2b) must identify `tsub` with
      `ComputeTr(Translate(LookBodyOfRE(body, owner)))` at the engine cp of `inpo`. */
  lemma TreeResGOwnerFresh(t: LT.Tree, gm: LG.GroupMap, inp: LC.Input, dir: WP.Direction, g: LG.GroupId)
    returns (found: bool, lk: L.Lookaround, tsub: LT.Tree, gmo: LG.GroupMap, inpo: LC.Input)
    requires GOwnerWF(t, g)
    requires LT.TreeRes(t, gm, inp, dir).Some?
    requires LG.Find(g, gm) == None
    ensures found ==> tsub < t
    ensures !found ==> LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1) == None
    ensures found ==>
              L.Positivity(lk)
              && !GWriteOnlyInLooks(tsub, g)
              && LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk)).Some?
              && LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1)
                 == LG.Find(g, LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk)).value.1)
  {
    found, lk, tsub, gmo, inpo := TreeResGOwnerDescent(t, gm, inp, dir, g);
    if found {
      assert LG.Find(g, gmo) == LG.Find(g, gm) == None;
      assert LG.Find(g, LG.Empty) == None;                    // fresh map has no g
      TreeResGValueFramed(tsub, gmo, LG.Empty, inpo, L.LkDir(lk), g);
    }
  }

  // ==========================================================================
  // B' CORRECTED SOUND DESCENT (ADDITIVE). `GOwnerWF` collapses to `GNotWritten`
  // (see `GOwnerWFImpliesGNotWritten`), so `TreeResGOwnerFresh` never finds an
  // owner. The fix splits the well-formedness into two predicates:
  //   * `GBodyOK(t,g)`  — the LOOK-BODY context: `g` MAY be written on this spine
  //     (the owner writes it here), but along any single spine path `g`'s write
  //     lives in a UNIQUE look body (`GNotWritten(tlk,g) || GNotWritten(t1,g)` at
  //     each `LK`), and every look body is itself `GBodyOK`.
  //   * `GOwnerWF2(t,g)` — the OUTER context: identical, but ALSO no `g`-write on
  //     THIS (outer) spine (`!ActTouchesG(a,g)` at `GroupActionT`). The look
  //     bodies are `GBodyOK` (NOT `GOwnerWF2`), so the owner body is free to write
  //     `g` — this is exactly the conjunct the broken `GOwnerWF` got wrong.
  // `GOwnerWF2` does NOT collapse (`GOwnerWF2NonCollapse` exhibits a `g`-writing
  // witness), and `TreeResGOwnerDescentV` below is the genuinely SOUND owner
  // descent milestone #2 needs — it FINDS the innermost owner subtree and pins the
  // outer leaf value at `g` to that owner's own sub-result at `g`.
  // ==========================================================================

  /** LOOK-BODY well-formedness for `g`: `g`'s writes are confined to a UNIQUE
      look body per spine path (this spine MAY write `g`). */
  ghost predicate GBodyOK(t: LT.Tree, g: LG.GroupId)
    decreases t
  {
    match t
    case Mismatch => true
    case Match => true
    case Choice(t1, t2) => GBodyOK(t1, g) && GBodyOK(t2, g)
    case Read(_, t1) => GBodyOK(t1, g)
    case ReadBackRef(_, t1) => GBodyOK(t1, g)
    case Progress(t1) => GBodyOK(t1, g)
    case AnchorPass(_, t1) => GBodyOK(t1, g)
    case GroupActionT(a, t1) => GBodyOK(t1, g)          // spine write to g PERMITTED
    case LK(_, tlk, t1) =>
      GBodyOK(tlk, g) && GBodyOK(t1, g) && (GNotWritten(tlk, g) || GNotWritten(t1, g))
    case LKFail(_, tlk) => GBodyOK(tlk, g)
  }

  /** OUTER well-formedness for `g`: as `GBodyOK`, but NO `g`-write on THIS spine
      (`GroupActionT` bans `ActTouchesG`). Crucially the `LK` body is only required
      `GBodyOK` (may write `g` — the owner), NOT `GOwnerWF2`; this is where the
      broken `GOwnerWF` over-constrained and collapsed to `GNotWritten`. */
  ghost predicate GOwnerWF2(t: LT.Tree, g: LG.GroupId)
    decreases t
  {
    match t
    case Mismatch => true
    case Match => true
    case Choice(t1, t2) => GOwnerWF2(t1, g) && GOwnerWF2(t2, g)
    case Read(_, t1) => GOwnerWF2(t1, g)
    case ReadBackRef(_, t1) => GOwnerWF2(t1, g)
    case Progress(t1) => GOwnerWF2(t1, g)
    case AnchorPass(_, t1) => GOwnerWF2(t1, g)
    case GroupActionT(a, t1) => !ActTouchesG(a, g) && GOwnerWF2(t1, g)
    case LK(_, tlk, t1) =>
      GBodyOK(tlk, g) && GOwnerWF2(t1, g) && (GNotWritten(tlk, g) || GNotWritten(t1, g))
    case LKFail(_, tlk) => GBodyOK(tlk, g)
  }

  /** `GNotWritten` refines both (nothing written ⇒ trivially well-formed). */
  lemma GNotWrittenImpliesGBodyOK(t: LT.Tree, g: LG.GroupId)
    requires GNotWritten(t, g)
    ensures GBodyOK(t, g)
    decreases t
  {
    match t
    case Choice(t1, t2) => GNotWrittenImpliesGBodyOK(t1, g); GNotWrittenImpliesGBodyOK(t2, g);
    case Read(_, t1) => GNotWrittenImpliesGBodyOK(t1, g);
    case ReadBackRef(_, t1) => GNotWrittenImpliesGBodyOK(t1, g);
    case Progress(t1) => GNotWrittenImpliesGBodyOK(t1, g);
    case AnchorPass(_, t1) => GNotWrittenImpliesGBodyOK(t1, g);
    case GroupActionT(a, t1) => GNotWrittenImpliesGBodyOK(t1, g);
    case LK(_, tlk, t1) => GNotWrittenImpliesGBodyOK(tlk, g); GNotWrittenImpliesGBodyOK(t1, g);
    case LKFail(_, tlk) => GNotWrittenImpliesGBodyOK(tlk, g);
    case _ =>
  }

  /** THE BRIDGE: a `GBodyOK` tree whose OUTER spine happens to be `g`-write-free
      (`GWriteOnlyInLooks`) is `GOwnerWF2`. Used by the descent to re-enter the
      outer context when it recurses into a look body that carries `g` only DEEPER
      (its own spine is `g`-free). */
  lemma GBodyOKSpineImpliesOwnerWF2(t: LT.Tree, g: LG.GroupId)
    requires GBodyOK(t, g)
    requires GWriteOnlyInLooks(t, g)
    ensures GOwnerWF2(t, g)
    decreases t
  {
    match t
    case Choice(t1, t2) => GBodyOKSpineImpliesOwnerWF2(t1, g); GBodyOKSpineImpliesOwnerWF2(t2, g);
    case Read(_, t1) => GBodyOKSpineImpliesOwnerWF2(t1, g);
    case ReadBackRef(_, t1) => GBodyOKSpineImpliesOwnerWF2(t1, g);
    case Progress(t1) => GBodyOKSpineImpliesOwnerWF2(t1, g);
    case AnchorPass(_, t1) => GBodyOKSpineImpliesOwnerWF2(t1, g);
    case GroupActionT(a, t1) => GBodyOKSpineImpliesOwnerWF2(t1, g);   // GWriteOnlyInLooks: !ActTouchesG
    case LK(_, tlk, t1) => GBodyOKSpineImpliesOwnerWF2(t1, g);        // GWriteOnlyInLooks(LK) == on t1
    case LKFail(_, tlk) =>
    case _ =>
  }

  /** `GOwnerWF2` refines `GWriteOnlyInLooks` (no `g`-write on the OUTER spine) —
      the companion of `GOwnerWFImpliesSpine` for the corrected predicate. */
  lemma GOwnerWF2ImpliesSpine(t: LT.Tree, g: LG.GroupId)
    requires GOwnerWF2(t, g)
    ensures GWriteOnlyInLooks(t, g)
    decreases t
  {
    match t
    case Choice(t1, t2) => GOwnerWF2ImpliesSpine(t1, g); GOwnerWF2ImpliesSpine(t2, g);
    case Read(_, t1) => GOwnerWF2ImpliesSpine(t1, g);
    case ReadBackRef(_, t1) => GOwnerWF2ImpliesSpine(t1, g);
    case Progress(t1) => GOwnerWF2ImpliesSpine(t1, g);
    case AnchorPass(_, t1) => GOwnerWF2ImpliesSpine(t1, g);
    case GroupActionT(a, t1) => GOwnerWF2ImpliesSpine(t1, g);
    case LK(_, tlk, t1) => GOwnerWF2ImpliesSpine(t1, g);
    case _ =>
  }

  /** `GOwnerWF2` does NOT collapse to `GNotWritten` (unlike `GOwnerWF`): the tree
      `LK(LookAhead, GroupActionT(Open(g), Match), Match)` — a positive look whose
      body WRITES `g` — is `GOwnerWF2` yet NOT `GNotWritten`. This is precisely the
      shape the broken `GOwnerWF` excluded, so the corrected descent is non-vacuous. */
  lemma GOwnerWF2NonCollapse(g: LG.GroupId)
    ensures var t := LT.LK(L.LookAhead, LT.GroupActionT(LG.Open(g), LT.Match), LT.Match);
            GOwnerWF2(t, g) && !GNotWritten(t, g)
  {
    var body := LT.GroupActionT(LG.Open(g), LT.Match);
    assert GBodyOK(body, g);
    assert GNotWritten(LT.Match, g);
    assert !GNotWritten(body, g) by { assert ActTouchesG(LG.Open(g), g); }
  }

  /** B' CORRECTED SOUND DESCENT. Same navigation as `TreeResGOwnerDescent`, but
      under the corrected `GOwnerWF2` the owner-found branch (`!GWriteOnlyInLooks
      (tsub0,g)`, the body writes `g` on its spine) is LIVE — `GOwnerWF2` supplies
      `GNotWritten(t1,g)` (single-writer disjunct) WITHOUT forcing the body itself
      write-free, so the descent genuinely lands on the innermost owner. The
      deeper-recurse branch re-enters the outer context via the
      `GBodyOKSpineImpliesOwnerWF2` bridge. */
  lemma TreeResGOwnerDescentV(t: LT.Tree, gm: LG.GroupMap, inp: LC.Input, dir: WP.Direction, g: LG.GroupId)
    returns (found: bool, lk: L.Lookaround, tsub: LT.Tree, gmo: LG.GroupMap, inpo: LC.Input)
    requires GOwnerWF2(t, g)
    requires LT.TreeRes(t, gm, inp, dir).Some?
    ensures found ==> tsub < t
    ensures found ==> LG.Find(g, gmo) == LG.Find(g, gm)
    ensures !found ==> LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1) == LG.Find(g, gm)
    ensures found ==>
              L.Positivity(lk)
              && !GWriteOnlyInLooks(tsub, g)
              && LT.TreeRes(tsub, gmo, inpo, L.LkDir(lk)).Some?
              && LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1)
                 == LG.Find(g, LT.TreeRes(tsub, gmo, inpo, L.LkDir(lk)).value.1)
    decreases t
  {
    match t
    case Match =>
      found, lk, tsub, gmo, inpo := false, L.LookAhead, t, gm, inp;
    case Mismatch =>
      found, lk, tsub, gmo, inpo := false, L.LookAhead, t, gm, inp;
    case LKFail(lk0, tsub0) =>
      found, lk, tsub, gmo, inpo := false, L.LookAhead, tsub0, gm, inp;
    case Choice(t1, t2) =>
      if LT.TreeRes(t1, gm, inp, dir).Some? {
        found, lk, tsub, gmo, inpo := TreeResGOwnerDescentV(t1, gm, inp, dir, g);
      } else {
        found, lk, tsub, gmo, inpo := TreeResGOwnerDescentV(t2, gm, inp, dir, g);
      }
    case Read(c, t1) =>
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescentV(t1, gm, LC.AdvanceInputP(inp, dir), dir, g);
    case ReadBackRef(brStr, t1) =>
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescentV(t1, gm, LC.AdvanceInputN(inp, |brStr|, dir), dir, g);
    case Progress(t1) =>
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescentV(t1, gm, inp, dir, g);
    case AnchorPass(a, t1) =>
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescentV(t1, gm, inp, dir, g);
    case GroupActionT(a, t1) =>
      GMUpdateFindNotTouch(a, LC.Idx(inp), gm, g);           // !ActTouchesG from GOwnerWF2
      found, lk, tsub, gmo, inpo := TreeResGOwnerDescentV(t1, LG.GMUpdate(a, LC.Idx(inp), gm), inp, dir, g);
    case LK(lk0, tsub0, t1) =>
      if L.Positivity(lk0) {
        var sub := LT.TreeRes(tsub0, gm, inp, L.LkDir(lk0));
        assert sub.Some?;
        if GNotWritten(tsub0, g) {
          TreeResGNotWritten(tsub0, gm, inp, L.LkDir(lk0), g);
          var fc, lkc, tsubc, gmoc, inpoc := TreeResGOwnerDescentV(t1, sub.value.1, inp, dir, g);
          if fc {
            found, lk, tsub, gmo, inpo := true, lkc, tsubc, gmoc, inpoc;
            assert tsubc < t1;
          } else {
            found, lk, tsub, gmo, inpo := false, lk0, tsub0, gm, inp;
          }
        } else {
          // body writes g: GOwnerWF2 gives GNotWritten(t1,g) (single-writer) AND GBodyOK(tsub0,g).
          assert GNotWritten(t1, g);
          TreeResLkNodeGValue(lk0, tsub0, t1, gm, inp, dir, g);
          if !GWriteOnlyInLooks(tsub0, g) {
            // g on tsub0's OWN spine: this look is the innermost owner. (LIVE under GOwnerWF2!)
            found, lk, tsub, gmo, inpo := true, lk0, tsub0, gm, inp;
          } else {
            // g deeper inside tsub0's looks: re-enter the outer context and recurse.
            GBodyOKSpineImpliesOwnerWF2(tsub0, g);            // GOwnerWF2(tsub0, g)
            var fc, lkc, tsubc, gmoc, inpoc := TreeResGOwnerDescentV(tsub0, gm, inp, L.LkDir(lk0), g);
            if fc {
              found, lk, tsub, gmo, inpo := true, lkc, tsubc, gmoc, inpoc;
              assert tsubc < tsub0;
            } else {
              found, lk, tsub, gmo, inpo := false, lk0, tsub0, gm, inp;
            }
          }
        }
      } else {
        var sub := LT.TreeRes(tsub0, gm, inp, L.LkDir(lk0));
        assert sub.None?;
        found, lk, tsub, gmo, inpo := TreeResGOwnerDescentV(t1, gm, inp, dir, g);
      }
  }

  /** B' CORRECTED FRESH-map owner form (the genuinely non-vacuous `TreeResGOwner
      Fresh`). Under `GOwnerWF2` with `g` fresh, on the winning path the outer leaf
      value at `g` is EITHER unset (`None`) OR the INNERMOST OWNER look body's OWN
      `Empty`-map `TreeRes` value at `g`, at the descent-recorded position `inpo` —
      the SPEC half of `recon_inner` at GENERAL branching body structure. */
  lemma TreeResGOwnerFreshV(t: LT.Tree, gm: LG.GroupMap, inp: LC.Input, dir: WP.Direction, g: LG.GroupId)
    returns (found: bool, lk: L.Lookaround, tsub: LT.Tree, gmo: LG.GroupMap, inpo: LC.Input)
    requires GOwnerWF2(t, g)
    requires LT.TreeRes(t, gm, inp, dir).Some?
    requires LG.Find(g, gm) == None
    ensures found ==> tsub < t
    ensures !found ==> LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1) == None
    ensures found ==>
              L.Positivity(lk)
              && !GWriteOnlyInLooks(tsub, g)
              && LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk)).Some?
              && LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1)
                 == LG.Find(g, LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk)).value.1)
  {
    found, lk, tsub, gmo, inpo := TreeResGOwnerDescentV(t, gm, inp, dir, g);
    if found {
      assert LG.Find(g, gmo) == LG.Find(g, gm) == None;
      assert LG.Find(g, LG.Empty) == None;
      TreeResGValueFramed(tsub, gmo, LG.Empty, inpo, L.LkDir(lk), g);
    }
  }

  // ==========================================================================
  // B' (ADDITIVE): the SPINE-write-freedom of a compiled body tree for an
  // inside-look capture `g`, at GENERAL (branching) body structure.
  //
  // `g in LkBodyGroups(tr)` is written ONLY inside a look body, never on the outer
  // spine — EXCEPT that a quantifier wrapping `g`'s owner look emits a spine
  // `Reset(DefGroups(body))` that DOES touch `g` (`L.DefGroups` recurses through
  // looks). `GNotUnderQuantL(tr, g)` is exactly the side condition that rules this
  // out: `g` is not captured under any quantifier of `tr`. Under it (plus `g` being
  // an inside-look, hence non-openable, group — `g !in OuterDefsActs`), every SPINE
  // group action misses `g`, i.e. `GWriteOnlyInLooks(ComputeTr(tr), g)`. This is
  // the branching analogue of the chain fragment's implicit spine-freedom (a chain
  // has NO spine group actions at all), and the precondition that makes the SOUND
  // owner descent `TreeResGOwnerFresh` applicable at general body structure.
  // ==========================================================================

  /** `g` is not captured inside any QUANTIFIER body of `r` (at any depth). The
      side condition that keeps a compiled tree's SPINE free of `g`-writes: a
      quantifier over `g`'s owner look would emit a spine `Reset(DefGroups(body))`
      touching `g` (since `L.DefGroups` recurses through look bodies). The honest
      scope caveat flagged for `GOwnerWF` — a QUANTIFIED capturing lookaround. */
  ghost predicate GNotUnderQuantL(r: L.Regex, g: LG.GroupId)
    decreases r
  {
    match r
    case Disjunction(r1, r2) => GNotUnderQuantL(r1, g) && GNotUnderQuantL(r2, g)
    case Sequence(r1, r2) => GNotUnderQuantL(r1, g) && GNotUnderQuantL(r2, g)
    case Quantified(_, _, _, r1) => g !in (set x | x in L.DefGroups(r1)) && GNotUnderQuantL(r1, g)
    case Group(_, r1) => GNotUnderQuantL(r1, g)
    case LookaroundR(_, r1) => GNotUnderQuantL(r1, g)
    case _ => true
  }


  /** A capture-free regex has no capture ids. */
  lemma CapFreeCapIdsEmpty(r: R.regex)
    requires NR.CaptureFreeRE(r)
    ensures PIV.CapIds(r) == {}
    decreases r
  {
    match r
    case Re_alt(r1, r2) => CapFreeCapIdsEmpty(r1); CapFreeCapIdsEmpty(r2);
    case Re_con(r1, r2) => CapFreeCapIdsEmpty(r1); CapFreeCapIdsEmpty(r2);
    case Re_quant(_, _, _, r1) => CapFreeCapIdsEmpty(r1);
    case Re_lookaround(_, _, r1) => CapFreeCapIdsEmpty(r1);
    case _ =>
  }

  /** Capture-free look bodies ==> no inside-look capture ids at all. */
  lemma LookBodiesCapFreeInLooksEmpty(r: R.regex)
    requires NR.LookBodiesCaptureFreeRE(r)
    ensures PIV.CapIdsInLooks(r) == {}
    decreases r
  {
    match r
    case Re_alt(r1, r2) => LookBodiesCapFreeInLooksEmpty(r1); LookBodiesCapFreeInLooksEmpty(r2);
    case Re_con(r1, r2) => LookBodiesCapFreeInLooksEmpty(r1); LookBodiesCapFreeInLooksEmpty(r2);
    case Re_quant(_, _, _, r1) => LookBodiesCapFreeInLooksEmpty(r1);
    case Re_capture(_, r1) => LookBodiesCapFreeInLooksEmpty(r1);
    case Re_lookaround(_, _, r1) => CapFreeCapIdsEmpty(r1);
    case _ =>
  }

  /** A group id NOT captured anywhere in `r` is trivially not-under-quant:
      every `Quantified` body's `DefGroups` misses it. */
  lemma GNQLNotMember(r: R.regex, g: nat)
    requires T.TransWf(r)
    requires g !in PIV.CapIds(r)
    ensures GNotUnderQuantL(T.Translate(r), g)
    decreases r
  {
    match r
    case Re_alt(r1, r2) => GNQLNotMember(r1, g); GNQLNotMember(r2, g);
    case Re_con(r1, r2) => GNQLNotMember(r1, g); GNQLNotMember(r2, g);
    case Re_quant(_, _, _, r1) =>
      TranslateDefGroupsEqCapIds(r1);
      GNQLNotMember(r1, g);
    case Re_capture(_, r1) => GNQLNotMember(r1, g);
    case Re_lookaround(_, _, r1) => GNQLNotMember(r1, g);
    case _ =>
  }

  /** Under `NoCapUnderQuantRE` every quantifier body is capture-free, so
      `GNotUnderQuantL` holds for EVERY group id (membership not needed). */
  lemma GNQLFromNoCapUnderQuant(r: R.regex, g: nat)
    requires T.TransWf(r)
    requires NR.NoCapUnderQuantRE(r)
    ensures GNotUnderQuantL(T.Translate(r), g)
    decreases r
  {
    match r
    case Re_alt(r1, r2) => GNQLFromNoCapUnderQuant(r1, g); GNQLFromNoCapUnderQuant(r2, g);
    case Re_con(r1, r2) => GNQLFromNoCapUnderQuant(r1, g); GNQLFromNoCapUnderQuant(r2, g);
    case Re_quant(_, _, _, r1) =>
      CapFreeCapIdsEmpty(r1);
      TranslateDefGroupsEqCapIds(r1);
      assert PIV.CapIds(r1) == {};
      assert g !in PIV.CapIds(r1);
      GNQLFromNoCapUnderQuant(r1, g);
    case Re_capture(_, r1) => GNQLFromNoCapUnderQuant(r1, g);
    case Re_lookaround(_, _, r1) => GNQLFromNoCapUnderQuant(r1, g);
    case _ =>
  }

  /** THE C5 SCOPE BRIDGE: the two executable-shape conditions — (1) inside
      every look body no capture sits under a quantifier, (2) every quantifier
      body's look bodies are capture-free — imply `GNotUnderQuantL` for every
      inside-look capture id. The `Re_quant` case is VACUOUS ((2) forces
      `CapIdsInLooks(body) == {}`); the `Re_lookaround` case hands off to
      `GNQLFromNoCapUnderQuant` via (1); `CapUnique` disjointness feeds
      `GNQLNotMember` on the sibling at `alt`/`con`. */
  lemma GNQLTop(r: R.regex, g: nat)
    requires T.TransWf(r)
    requires PIV.CapUnique(r)
    requires NR.LookBodiesNoCapUnderQuantRE(r)
    requires NR.QuantsLookCapFreeRE(r)
    requires g in PIV.CapIdsInLooks(r)
    ensures GNotUnderQuantL(T.Translate(r), g)
    decreases r
  {
    match r
    case Re_alt(r1, r2) =>
      PIV.CapIdsSplit(r1); PIV.CapIdsSplit(r2);
      if g in PIV.CapIdsInLooks(r1) {
        GNQLTop(r1, g);
        assert g in PIV.CapIds(r1);
        assert g !in PIV.CapIds(r2);
        GNQLNotMember(r2, g);
      } else {
        GNQLTop(r2, g);
        assert g in PIV.CapIds(r2);
        assert g !in PIV.CapIds(r1);
        GNQLNotMember(r1, g);
      }
    case Re_con(r1, r2) =>
      PIV.CapIdsSplit(r1); PIV.CapIdsSplit(r2);
      if g in PIV.CapIdsInLooks(r1) {
        GNQLTop(r1, g);
        assert g in PIV.CapIds(r1);
        assert g !in PIV.CapIds(r2);
        GNQLNotMember(r2, g);
      } else {
        GNQLTop(r2, g);
        assert g in PIV.CapIds(r2);
        assert g !in PIV.CapIds(r1);
        GNQLNotMember(r1, g);
      }
    case Re_quant(_, _, _, r1) =>
      LookBodiesCapFreeInLooksEmpty(r1);
      assert g in PIV.CapIdsInLooks(r1);
      assert false;
    case Re_capture(_, r1) => GNQLTop(r1, g);
    case Re_lookaround(_, _, r1) =>
      GNQLFromNoCapUnderQuant(r1, g);
  }

  /** (A2) THE QUANT-BRIDGE: the RE-side shadow of `GNotUnderQuantL`. If a capture
      `g` of `body` is placed under NO quantifier by Linden's translation
      (`GNotUnderQuantL(Translate(body), g)`), then `g` has NO ancestor quantifier
      on the RE side either (`PIV.AncQuants(body, g) == {}`) — exactly the no-quant
      precondition `AncSetToMemberNested` consumes. Structural induction over
      `body`: the `Re_quant` case is VACUOUS for a captured `g` (it forces
      `g !in DefGroups(Translate(r1)) == CapIds(r1) ∋ g`, via
      `TranslateDefGroupsEqCapIds`); every other constructor descends. */
  lemma GNotUnderQuantLNoAncQuants(body: R.regex, g: nat)
    requires T.TransWf(body)
    requires g in PIV.CapIds(body)
    requires GNotUnderQuantL(T.Translate(body), g)
    ensures PIV.AncQuants(body, g) == {}
    decreases body
  {
    match body
    case Re_alt(r1, r2) =>
      if g in PIV.CapIds(r1) { GNotUnderQuantLNoAncQuants(r1, g); }
      else { GNotUnderQuantLNoAncQuants(r2, g); }
    case Re_con(r1, r2) =>
      if g in PIV.CapIds(r1) { GNotUnderQuantLNoAncQuants(r1, g); }
      else { GNotUnderQuantLNoAncQuants(r2, g); }
    case Re_quant(nul, qid, q, r1) =>
      // Translate(body) == Quantified(_,_,_,Translate(r1)); GNotUnderQuantL forces
      // g !in DefGroups(Translate(r1)), yet g in CapIds(r1) == that set.
      TranslateDefGroupsEqCapIds(r1);
      assert g in (set x | x in L.DefGroups(T.Translate(r1)));
      assert false;
    case Re_capture(cid, r1) =>
      if cid >= 0 && (cid as nat) == g {
      } else {
        GNotUnderQuantLNoAncQuants(r1, g);
      }
    case Re_lookaround(lid, l, r1) =>
      GNotUnderQuantLNoAncQuants(r1, g);
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
  }

  /** Action-list lift of `GNotUnderQuantL`: every pending `Areg` regex keeps `g`
      out of its quantifier bodies. Threaded down the `ComputeTree` walk. */
  ghost predicate GNQActs(act: LS.Actions, g: LG.GroupId) {
    forall i :: 0 <= i < |act| ==> (act[i].Areg? ==> GNotUnderQuantL(act[i].r, g))
  }

  lemma GNQActsCons(x: LS.Action, cont: LS.Actions, g: LG.GroupId)
    ensures GNQActs([x] + cont, g) <==> ((x.Areg? ==> GNotUnderQuantL(x.r, g)) && GNQActs(cont, g))
  {
    if (x.Areg? ==> GNotUnderQuantL(x.r, g)) && GNQActs(cont, g) {
      forall i | 0 <= i < |[x] + cont| ensures ([x] + cont)[i].Areg? ==> GNotUnderQuantL(([x] + cont)[i].r, g) {
        if i == 0 {} else { assert ([x] + cont)[i] == cont[i - 1]; }
      }
    }
    if GNQActs([x] + cont, g) {
      assert ([x] + cont)[0] == x;
      forall i | 0 <= i < |cont| ensures cont[i].Areg? ==> GNotUnderQuantL(cont[i].r, g) { assert ([x] + cont)[i + 1] == cont[i]; }
    }
  }

  lemma GNQActsTail(act: LS.Actions, g: LG.GroupId)
    requires |act| > 0 && GNQActs(act, g)
    ensures GNQActs(act[1..], g)
  {
    forall i | 0 <= i < |act[1..]| ensures act[1..][i].Areg? ==> GNotUnderQuantL(act[1..][i].r, g) { assert act[1..][i] == act[i + 1]; }
  }

  /** B' SPINE-FREEDOM WALK: a `ComputeTree` walk whose pending actions keep `g`
      out of every OPENABLE outer group (`g !in OuterDefsActs`) AND out of every
      quantifier body (`GNQActs`) builds a tree in which `g` is written only inside
      look bodies (`GWriteOnlyInLooks(_, g)`). Mirrors `ComputeTreeConfinedRec`'s
      case structure, but the LK case recurses ONLY into the CONTINUATION (look
      bodies are unconstrained for `GWriteOnlyInLooks`). Each spine group action
      misses `g`: `Aclose(gid)`/`Group(gid,..)` open/close an OUTER group `gid in
      OuterDefsActs`, so `gid != g`; a `Quantified` reset targets `DefGroups(r1)`,
      which `GNQActs` keeps `g` out of. */
  lemma ComputeTreeGWriteOnlyInLooks(rer: LW.RegExpRecord, act: LS.Actions, inp: LC.Input,
                                     gm: LG.GroupMap, dir: WP.Direction, fuel: nat, g: LG.GroupId)
    requires g !in OuterDefsActs(act)
    requires GNQActs(act, g)
    ensures LFS.ComputeTree(rer, act, inp, gm, dir, fuel).Some?
            ==> GWriteOnlyInLooks(LFS.ComputeTree(rer, act, inp, gm, dir, fuel).value, g)
    decreases fuel
  {
    if fuel == 0 || |act| == 0 { return; }
    var f := fuel - 1;
    var cont := act[1..];
    assert act == [act[0]] + cont;
    OuterDefsActsCons(act[0], cont);
    GNQActsCons(act[0], cont, g);
    GNQActsTail(act, g);
    // OuterDefsActs(cont) <= OuterDefsActs(act) always, so g misses it on the tail.
    assert g !in OuterDefsActs(cont);
    match act[0]
    case Acheck(strcheck) =>
      // suffix pass => Progress(rec(cont)); suffix fail => Mismatch (GWriteOnlyInLooks trivially).
      ComputeTreeGWriteOnlyInLooks(rer, cont, inp, gm, dir, f, g);
    case Aclose(gid) =>
      assert gid in OuterDefsActs(act);                    // Aclose contributes {gid}
      assert gid != g;
      ComputeTreeGWriteOnlyInLooks(rer, cont, inp, LG.GMClose(LC.Idx(inp), gid, gm), dir, f, g);
    case Areg(r) =>
      match r
      case Epsilon => ComputeTreeGWriteOnlyInLooks(rer, cont, inp, gm, dir, f, g);
      case Character(cd) =>
        match LC.ReadChar(rer, cd, inp, dir) {
          case None =>
          case Some(pair) => ComputeTreeGWriteOnlyInLooks(rer, cont, pair.1, gm, dir, f, g);
        }
      case Disjunction(r1, r2) =>
        assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2);
        OuterDefsActsCons(LS.Areg(r1), cont); OuterDefsActsCons(LS.Areg(r2), cont);
        GNQActsCons(LS.Areg(r1), cont, g); GNQActsCons(LS.Areg(r2), cont, g);
        ComputeTreeGWriteOnlyInLooks(rer, [LS.Areg(r1)] + cont, inp, gm, dir, f, g);
        ComputeTreeGWriteOnlyInLooks(rer, [LS.Areg(r2)] + cont, inp, gm, dir, f, g);
      case Sequence(r1, r2) =>
        var na := LS.SeqList(r1, r2, dir) + cont;
        assert g !in OuterDefsActs(na) && GNQActs(na, g) by {
          assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1) + DefGroupsOutsideLooksL(r2);
          if dir.Forward? {
            assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
            OuterDefsActsCons(LS.Areg(r2), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
            GNQActsCons(LS.Areg(r2), cont, g); GNQActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont, g);
          } else {
            assert na == [LS.Areg(r2)] + ([LS.Areg(r1)] + cont);
            OuterDefsActsCons(LS.Areg(r1), cont); OuterDefsActsCons(LS.Areg(r2), [LS.Areg(r1)] + cont);
            GNQActsCons(LS.Areg(r1), cont, g); GNQActsCons(LS.Areg(r2), [LS.Areg(r1)] + cont, g);
          }
        }
        ComputeTreeGWriteOnlyInLooks(rer, na, inp, gm, dir, f, g);
      case Quantified(greedy, min, delta, r1) =>
        var gidl := L.DefGroups(r1);
        assert g !in (set x | x in gidl);                  // GNotUnderQuantL(Quantified,..)
        assert DefGroupsOutsideLooksL(r) == DefGroupsOutsideLooksL(r1);
        if min > 0 {
          var quant := L.Quantified(greedy, min - 1, delta, r1);
          var na := [LS.Areg(r1), LS.Areg(quant)] + cont;
          assert g !in OuterDefsActs(na) && GNQActs(na, g) by {
            assert na == [LS.Areg(r1)] + ([LS.Areg(quant)] + cont);
            OuterDefsActsCons(LS.Areg(quant), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Areg(quant)] + cont);
            GNQActsCons(LS.Areg(quant), cont, g); GNQActsCons(LS.Areg(r1), [LS.Areg(quant)] + cont, g);
          }
          ComputeTreeGWriteOnlyInLooks(rer, na, inp, LG.GMReset(gidl, gm), dir, f, g);
        } else if delta == LN.NN(0) {
          ComputeTreeGWriteOnlyInLooks(rer, cont, inp, gm, dir, f, g);
        } else {
          var quant := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
          var na := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont;
          assert g !in OuterDefsActs(na) && GNQActs(na, g) by {
            assert na == [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            OuterDefsActsCons(LS.Areg(quant), cont); OuterDefsActsCons(LS.Acheck(inp), [LS.Areg(quant)] + cont);
            OuterDefsActsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            GNQActsCons(LS.Areg(quant), cont, g); GNQActsCons(LS.Acheck(inp), [LS.Areg(quant)] + cont, g);
            GNQActsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont), g);
          }
          ComputeTreeGWriteOnlyInLooks(rer, na, inp, LG.GMReset(gidl, gm), dir, f, g);
          ComputeTreeGWriteOnlyInLooks(rer, cont, inp, gm, dir, f, g);
        }
      case Group(gid, r1) =>
        assert gid in OuterDefsActs(act);                  // gid in DefGroupsOutsideLooksL(Group)
        assert gid != g;
        assert DefGroupsOutsideLooksL(r) == {gid} + DefGroupsOutsideLooksL(r1);
        var na := [LS.Areg(r1), LS.Aclose(gid)] + cont;
        assert g !in OuterDefsActs(na) && GNQActs(na, g) by {
          assert na == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
          OuterDefsActsCons(LS.Aclose(gid), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont);
          GNQActsCons(LS.Aclose(gid), cont, g); GNQActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont, g);
        }
        ComputeTreeGWriteOnlyInLooks(rer, na, inp, LG.GMOpen(LC.Idx(inp), gid, gm), dir, f, g);
      case LookaroundR(lk, r1) =>
        var bodyacts := [LS.Areg(r1)];
        match LFS.ComputeTree(rer, bodyacts, inp, gm, L.LkDir(lk), f) {
          case None =>
          case Some(treelk) =>
            match LS.LkResult(lk, treelk, gm, inp) {
              case Some(gmlk) => ComputeTreeGWriteOnlyInLooks(rer, cont, inp, gmlk, dir, f, g);  // LK body unconstrained
              case None =>                                                                        // LKFail: GWriteOnlyInLooks true
            }
        }
      case AnchorR(a) =>
        if LS.AnchorSatisfied(rer, a, inp) { ComputeTreeGWriteOnlyInLooks(rer, cont, inp, gm, dir, f, g); }
      case Backreference(gid) =>
        match LS.ReadBackref(rer, gm, gid, inp, dir) {
          case None =>
          case Some(pair) => ComputeTreeGWriteOnlyInLooks(rer, cont, pair.1, gm, dir, f, g);
        }
  }

  /** B' SPINE-FREEDOM (`ComputeTr` form): a compiled body tree writes an
      inside-look capture `g` ONLY inside look bodies, provided `g` is not an
      openable outer group of `r` (`g !in DefGroupsOutsideLooksL(r)`) and not
      captured under any quantifier (`GNotUnderQuantL(r, g)`). For `r = Translate
      (body)` with `g in LkBodyGroups(tr)` the first side condition is automatic
      (inside-look ∩ outside-look = ∅ under unique group ids); the second is the
      honest "no capturing look under repetition" scope caveat. This is the
      hypothesis `TreeResGOwnerFresh`/`GOwnerWF`'s descent needs at general body
      structure. */
  lemma ComputeTrGWriteOnlyInLooks(rer: LW.RegExpRecord, r: L.Regex, inp: LC.Input, gm: LG.GroupMap,
                                   dir: WP.Direction, g: LG.GroupId)
    requires g !in DefGroupsOutsideLooksL(r)
    requires GNotUnderQuantL(r, g)
    ensures GWriteOnlyInLooks(LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir), g)
  {
    var acts := [LS.Areg(r)];
    OuterDefsActsCons(LS.Areg(r), []);
    assert OuterDefsActs(acts) == DefGroupsOutsideLooksL(r);
    assert g !in OuterDefsActs(acts);
    assert GNQActs(acts, g) by { GNQActsCons(LS.Areg(r), [], g); }
    var fuel := LFS.ActionsFuel(acts, inp, dir) + 1;
    LFS.FunctionalTerminates(rer, acts, inp, gm, dir, fuel);
    ComputeTreeGWriteOnlyInLooks(rer, acts, inp, gm, dir, fuel, g);
  }

  // ==========================================================================
  // B' SINGLE-WRITER (ADDITIVE): `GBodyOK`/`GOwnerWF2` for a compiled body tree.
  //
  // The single-writer condition of the corrected descent — along each spine path
  // `g`'s write lives in a UNIQUE look body — is exactly `CapUnique` lifted to the
  // `ComputeTree` walk. The invariant is `GOnceInv`: across the pending action
  // list, `g` is "accounted for" AT MOST ONCE, counting BOTH the defs it still
  // appears in (`multiset(AllDefsActs)[g]`) AND a pending `Aclose(g)` (`g in
  // PendingCloses`) — a `Group(g,·)` moves `g` from the first to the second,
  // preserving the sum. Under `GNotUnderQuantL` (no `g` under a quantifier, so the
  // min>0 unfold does NOT duplicate `g`) the invariant is preserved, and at each
  // `LK` it yields the disjunct: `g in DefGroups(r1)` ⇒ `g` misses the whole
  // continuation (`GNotWrittenComputeTreeActs`), else `g` misses the body.
  // ==========================================================================

  /** `PendingCloses` of a cons. */
  lemma PendingClosesCons(x: LS.Action, cont: LS.Actions)
    ensures PendingCloses([x] + cont) == (if x.Aclose? then {x.gid} + PendingCloses(cont) else PendingCloses(cont))
  {
    var acts := [x] + cont;
    assert acts[0] == x && forall i :: 1 <= i < |acts| ==> acts[i] == cont[i - 1];
    forall y
      ensures (y in PendingCloses(acts))
         <==> (y in (if x.Aclose? then {x.gid} + PendingCloses(cont) else PendingCloses(cont)))
    {
      if y in PendingCloses(acts) {
        var i :| 0 <= i < |acts| && acts[i].Aclose? && acts[i].gid == y;
        if i == 0 { } else { assert cont[i - 1].Aclose? && cont[i - 1].gid == y; }
      }
      if x.Aclose? && y == x.gid { assert acts[0].Aclose? && acts[0].gid == y; }
      if y in PendingCloses(cont) {
        var j :| 0 <= j < |cont| && cont[j].Aclose? && cont[j].gid == y;
        assert acts[j + 1].Aclose? && acts[j + 1].gid == y;
      }
    }
  }

  /** `multiset` count of `g` in `AllDefsActs` of a cons. */
  lemma AllDefsActsMsCons(x: LS.Action, cont: LS.Actions, g: LG.GroupId)
    ensures multiset(AllDefsActs([x] + cont))[g]
         == (if x.Areg? then multiset(L.DefGroups(x.r))[g] else 0) + multiset(AllDefsActs(cont))[g]
  {
    AllDefsActsCons(x, cont);
  }

  /** THE INVARIANT: `g` is defined-or-pending AT MOST ONCE across `acts`. */
  ghost predicate GOnceInv(acts: LS.Actions, g: LG.GroupId) {
    multiset(AllDefsActs(acts))[g] + (if g in PendingCloses(acts) then 1 else 0) <= 1
  }

  /** B' SINGLE-WRITER WALK: under `GOnceInv` + `GNQActs` a `ComputeTree` walk
      builds a `GBodyOK(_, g)` tree — `g`'s write lives in a unique look body per
      spine path. At each `LK` the disjunct comes from `GOnceInv`: `g in DefGroups
      (r1)` forces `g` out of the whole continuation, else out of the body. */
  lemma ComputeTreeGBodyOK(rer: LW.RegExpRecord, act: LS.Actions, inp: LC.Input,
                           gm: LG.GroupMap, dir: WP.Direction, fuel: nat, g: LG.GroupId)
    requires EL.PikeLkActionsRec(act)
    requires GNQActs(act, g)
    requires GOnceInv(act, g)
    ensures LFS.ComputeTree(rer, act, inp, gm, dir, fuel).Some?
            ==> GBodyOK(LFS.ComputeTree(rer, act, inp, gm, dir, fuel).value, g)
    decreases fuel
  {
    if fuel == 0 || |act| == 0 { return; }
    var f := fuel - 1;
    var cont := act[1..];
    assert act == [act[0]] + cont;
    EL.PikeLkActionsRecConsIff(act[0], cont);
    EL.PikeLkActionsRecTail(act);
    GNQActsCons(act[0], cont, g);
    GNQActsTail(act, g);
    AllDefsActsMsCons(act[0], cont, g);
    PendingClosesCons(act[0], cont);
    // tail INV: cont only DROPS defs/closes of the head, so GOnceInv(cont) holds.
    assert multiset(AllDefsActs(cont))[g] <= multiset(AllDefsActs(act))[g];
    assert (g in PendingCloses(cont)) ==> (g in PendingCloses(act));
    assert GOnceInv(cont, g);
    match act[0]
    case Acheck(strcheck) =>
      ComputeTreeGBodyOK(rer, cont, inp, gm, dir, f, g);
    case Aclose(gid) =>
      ComputeTreeGBodyOK(rer, cont, inp, LG.GMClose(LC.Idx(inp), gid, gm), dir, f, g);
    case Areg(r) =>
      match r
      case Epsilon => ComputeTreeGBodyOK(rer, cont, inp, gm, dir, f, g);
      case Character(cd) =>
        match LC.ReadChar(rer, cd, inp, dir) {
          case None =>
          case Some(pair) => ComputeTreeGBodyOK(rer, cont, pair.1, gm, dir, f, g);
        }
      case Disjunction(r1, r2) =>
        var a1 := [LS.Areg(r1)] + cont; var a2 := [LS.Areg(r2)] + cont;
        assert L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
        assert GNQActs(a1, g) && GNQActs(a2, g) by { GNQActsCons(LS.Areg(r1), cont, g); GNQActsCons(LS.Areg(r2), cont, g); }
        assert EL.PikeLkActionsRec(a1) && EL.PikeLkActionsRec(a2) by { EL.PikeLkActionsRecConsIff(LS.Areg(r1), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont); }
        assert GOnceInv(a1, g) && GOnceInv(a2, g) by {
          AllDefsActsMsCons(LS.Areg(r1), cont, g); AllDefsActsMsCons(LS.Areg(r2), cont, g);
          PendingClosesCons(LS.Areg(r1), cont); PendingClosesCons(LS.Areg(r2), cont);
          assert multiset(L.DefGroups(r))[g] == multiset(L.DefGroups(r1))[g] + multiset(L.DefGroups(r2))[g];
        }
        ComputeTreeGBodyOK(rer, a1, inp, gm, dir, f, g);
        ComputeTreeGBodyOK(rer, a2, inp, gm, dir, f, g);
      case Sequence(r1, r2) =>
        var na := LS.SeqList(r1, r2, dir) + cont;
        assert L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
        assert EL.PikeLkActionsRec(na) && GNQActs(na, g) && GOnceInv(na, g) by {
          if dir.Forward? {
            assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
            GNQActsCons(LS.Areg(r2), cont, g); GNQActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont, g);
            AllDefsActsMsCons(LS.Areg(r2), cont, g); AllDefsActsMsCons(LS.Areg(r1), [LS.Areg(r2)] + cont, g);
            PendingClosesCons(LS.Areg(r2), cont); PendingClosesCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
          } else {
            assert na == [LS.Areg(r2)] + ([LS.Areg(r1)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r2), [LS.Areg(r1)] + cont);
            GNQActsCons(LS.Areg(r1), cont, g); GNQActsCons(LS.Areg(r2), [LS.Areg(r1)] + cont, g);
            AllDefsActsMsCons(LS.Areg(r1), cont, g); AllDefsActsMsCons(LS.Areg(r2), [LS.Areg(r1)] + cont, g);
            PendingClosesCons(LS.Areg(r1), cont); PendingClosesCons(LS.Areg(r2), [LS.Areg(r1)] + cont);
          }
          assert multiset(L.DefGroups(r))[g] == multiset(L.DefGroups(r1))[g] + multiset(L.DefGroups(r2))[g];
        }
        ComputeTreeGBodyOK(rer, na, inp, gm, dir, f, g);
      case Quantified(greedy, min, delta, r1) =>
        var gidl := L.DefGroups(r1);
        assert g !in (set x | x in L.DefGroups(r1));             // GNotUnderQuantL
        assert g !in L.DefGroups(r1);
        assert multiset(L.DefGroups(r1))[g] == 0;
        assert L.DefGroups(r) == gidl;
        if min > 0 {
          var quant := L.Quantified(greedy, min - 1, delta, r1);
          var na := [LS.Areg(r1), LS.Areg(quant)] + cont;
          assert EL.PikeLkActionsRec(na) && GNQActs(na, g) && GOnceInv(na, g) by {
            assert na == [LS.Areg(r1)] + ([LS.Areg(quant)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(quant), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(quant)] + cont);
            GNQActsCons(LS.Areg(quant), cont, g); GNQActsCons(LS.Areg(r1), [LS.Areg(quant)] + cont, g);
            AllDefsActsMsCons(LS.Areg(quant), cont, g); AllDefsActsMsCons(LS.Areg(r1), [LS.Areg(quant)] + cont, g);
            PendingClosesCons(LS.Areg(quant), cont); PendingClosesCons(LS.Areg(r1), [LS.Areg(quant)] + cont);
            assert L.DefGroups(quant) == gidl;
          }
          ComputeTreeGBodyOK(rer, na, inp, LG.GMReset(gidl, gm), dir, f, g);
        } else if delta == LN.NN(0) {
          ComputeTreeGBodyOK(rer, cont, inp, gm, dir, f, g);
        } else {
          var quant := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
          var na := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont;
          assert EL.PikeLkActionsRec(na) && GNQActs(na, g) && GOnceInv(na, g) by {
            assert na == [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            EL.PikeLkActionsRecConsIff(LS.Areg(quant), cont); EL.PikeLkActionsRecConsIff(LS.Acheck(inp), [LS.Areg(quant)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            GNQActsCons(LS.Areg(quant), cont, g); GNQActsCons(LS.Acheck(inp), [LS.Areg(quant)] + cont, g);
            GNQActsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont), g);
            AllDefsActsMsCons(LS.Areg(quant), cont, g); AllDefsActsMsCons(LS.Acheck(inp), [LS.Areg(quant)] + cont, g);
            AllDefsActsMsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont), g);
            PendingClosesCons(LS.Areg(quant), cont); PendingClosesCons(LS.Acheck(inp), [LS.Areg(quant)] + cont);
            PendingClosesCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            assert L.DefGroups(quant) == gidl;
          }
          ComputeTreeGBodyOK(rer, na, inp, LG.GMReset(gidl, gm), dir, f, g);
          ComputeTreeGBodyOK(rer, cont, inp, gm, dir, f, g);
        }
      case Group(gid, r1) =>
        var na := [LS.Areg(r1), LS.Aclose(gid)] + cont;
        assert L.DefGroups(r) == [gid] + L.DefGroups(r1);
        assert EL.PikeLkActionsRec(na) && GNQActs(na, g) && GOnceInv(na, g) by {
          assert na == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
          EL.PikeLkActionsRecConsIff(LS.Aclose(gid), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Aclose(gid)] + cont);
          GNQActsCons(LS.Aclose(gid), cont, g); GNQActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont, g);
          AllDefsActsMsCons(LS.Aclose(gid), cont, g); AllDefsActsMsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont, g);
          PendingClosesCons(LS.Aclose(gid), cont); PendingClosesCons(LS.Areg(r1), [LS.Aclose(gid)] + cont);
          // gid==g: def→pending (sum preserved); gid!=g: unchanged. (multiset(DefGroups(r))
          // == multiset([gid]) + multiset(DefGroups(r1)) from the DefGroups equality above.)
        }
        ComputeTreeGBodyOK(rer, na, inp, LG.GMOpen(LC.Idx(inp), gid, gm), dir, f, g);
      case LookaroundR(lk, r1) =>
        var bodyacts := [LS.Areg(r1)];
        assert EL.PikeLkRegexRec(r1) by {
          if L.Positivity(lk) { } else { assert SD.GroupFreeL(r1); GroupFreeImpliesNoLkBr(r1); EL.NoLkBrLIsPikeLkRegexRec(r1); }
        }
        assert EL.PikeLkActionsRec(bodyacts) by { EL.PikeLkActionsRecConsIff(LS.Areg(r1), []); }
        assert GNQActs(bodyacts, g) by { GNQActsCons(LS.Areg(r1), [], g); }   // GNotUnderQuantL(r1,g) from head
        assert L.DefGroups(r) == L.DefGroups(r1);
        AllDefsActsMsCons(LS.Areg(r1), [], g);
        assert multiset(AllDefsActs(bodyacts))[g] == multiset(L.DefGroups(r1))[g];
        assert multiset(L.DefGroups(r1))[g] <= multiset(AllDefsActs(act))[g];   // head contributes DefGroups(r1)
        assert GOnceInv(bodyacts, g) by { PendingClosesCons(LS.Areg(r1), []); }
        match LFS.ComputeTree(rer, bodyacts, inp, gm, L.LkDir(lk), f) {
          case None =>
          case Some(treelk) =>
            ComputeTreeGBodyOK(rer, bodyacts, inp, gm, L.LkDir(lk), f, g);        // GBodyOK(treelk, g)
            match LS.LkResult(lk, treelk, gm, inp) {
              case Some(gmlk) =>
                ComputeTreeGBodyOK(rer, cont, inp, gmlk, dir, f, g);              // GBodyOK(treecont, g)
                // single-writer disjunct (at gmlk, the continuation's own gm):
                if g in (set x | x in L.DefGroups(r1)) {
                  // g in the look body ⇒ (GOnceInv) g misses the whole continuation.
                  assert multiset(L.DefGroups(r1))[g] >= 1;
                  assert multiset(AllDefsActs(cont))[g] == 0;
                  assert g !in PendingCloses(act);                                // GOnceInv, def already ≥1
                  PendingClosesCons(act[0], cont);
                  assert g !in PendingCloses(cont) && g !in (set x | x in AllDefsActs(cont));
                  GNotWrittenComputeTreeActs(rer, cont, inp, gmlk, dir, f, g);    // GNotWritten(treecont, g)
                } else {
                  GNotWrittenComputeTreeActs(rer, bodyacts, inp, gm, L.LkDir(lk), f, g);  // GNotWritten(treelk, g)
                }
              case None =>                                                       // LKFail: only GBodyOK(treelk)
            }
        }
      case AnchorR(a) =>
        ComputeTreeGBodyOK(rer, cont, inp, gm, dir, f, g);
      case Backreference(gid) =>                                                  // PikeLkRegexRec false: vacuous
  }

  /** B' SINGLE-WRITER (`ComputeTr` form): a recursive-fragment regex's spec tree
      confines `g`'s writes to a UNIQUE look body per spine path (`GBodyOK`),
      provided `g` occurs at most once in `r`'s group ids (`multiset(DefGroups(r))
      [g] <= 1`, automatic under `NoDupSeq`) and is not captured under a quantifier
      (`GNotUnderQuantL`). */
  lemma ComputeTrGBodyOK(rer: LW.RegExpRecord, r: L.Regex, inp: LC.Input, gm: LG.GroupMap,
                         dir: WP.Direction, g: LG.GroupId)
    requires EL.PikeLkRegexRec(r)
    requires GNotUnderQuantL(r, g)
    requires multiset(L.DefGroups(r))[g] <= 1
    ensures GBodyOK(LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir), g)
  {
    var acts := [LS.Areg(r)];
    assert EL.PikeLkActionsRec(acts) by { EL.PikeLkActionsRecConsIff(LS.Areg(r), []); }
    assert GNQActs(acts, g) by { GNQActsCons(LS.Areg(r), [], g); }
    assert GOnceInv(acts, g) by { AllDefsActsMsCons(LS.Areg(r), [], g); PendingClosesCons(LS.Areg(r), []); }
    var fuel := LFS.ActionsFuel(acts, inp, dir) + 1;
    LFS.FunctionalTerminates(rer, acts, inp, gm, dir, fuel);
    ComputeTreeGBodyOK(rer, acts, inp, gm, dir, fuel, g);
  }

  /** B' HEADLINE (`GOwnerWF2` for a compiled body tree): the corrected
      well-formedness `TreeResGOwnerFreshV` needs, established for `ComputeTr([Areg
      (r)])` at GENERAL branching structure. Combines the SPINE-freedom
      (`ComputeTrGWriteOnlyInLooks`) and SINGLE-WRITER (`ComputeTrGBodyOK`) halves
      via the `GBodyOKSpineImpliesOwnerWF2` bridge. Side conditions (all discharged
      for `r = Translate(body)`, `g in LkBodyGroups(tr)` from `CapUnique`/`LookUnique`
      + no capturing look under repetition): `g` non-openable (`g !in
      DefGroupsOutsideLooksL`), `g` at most once in `DefGroups`, `g` not under a
      quantifier (`GNotUnderQuantL`). With this, `TreeResGOwnerFreshV` delivers the
      general-branching SPEC value identity `Find(g, outer leaf) == Find(g, owner
      body sub-result)` — the value half of `recon_inner`/milestone #2. */
  lemma ComputeTrGOwnerWF2(rer: LW.RegExpRecord, r: L.Regex, inp: LC.Input, gm: LG.GroupMap,
                           dir: WP.Direction, g: LG.GroupId)
    requires EL.PikeLkRegexRec(r)
    requires GNotUnderQuantL(r, g)
    requires g !in DefGroupsOutsideLooksL(r)
    requires multiset(L.DefGroups(r))[g] <= 1
    ensures GOwnerWF2(LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir), g)
  {
    ComputeTrGBodyOK(rer, r, inp, gm, dir, g);
    ComputeTrGWriteOnlyInLooks(rer, r, inp, gm, dir, g);
    GBodyOKSpineImpliesOwnerWF2(LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir), g);
  }

  /** B' MILESTONE #2 VALUE HALF (general branching, turnkey). For a recursive-
      fragment regex `r` (the shape `Translate(body)` emits) and an inside-look
      capture `g` (fresh in `gm`) whose write is confined by the side conditions,
      the compiled tree's winning-leaf value at `g` is EITHER unset (`None`) OR the
      INNERMOST OWNER look body subtree's OWN `Empty`-map sub-result value at `g`,
      at the descent-recorded position `inpo`. This composes `ComputeTrGOwnerWF2`
      (the corrected well-formedness, established for general branching) with the
      corrected sound descent `TreeResGOwnerFreshV`. The returned `tsub` is the
      abstract owner subtree (`!GWriteOnlyInLooks(tsub,g)`); the ONE remaining step
      to the displayed `recon_inner` identity is milestone #1 — structurally
      identifying `tsub` with `ComputeTr([Areg(Translate(LookBodyOfRE(body,owner)))]
      , inpo, Empty, LkDir(lk))` via `ComputeTrSingleLookUnfold`/`BoolTreeLk`'s LK
      pinning threaded through the regex-tracking descent. */
  lemma OuterLeafGOwnerSubtree(rer: LW.RegExpRecord, r: L.Regex, inp: LC.Input, gm: LG.GroupMap,
                               dir: WP.Direction, g: LG.GroupId)
    returns (found: bool, lk: L.Lookaround, tsub: LT.Tree, gmo: LG.GroupMap, inpo: LC.Input)
    requires EL.PikeLkRegexRec(r)
    requires GNotUnderQuantL(r, g)
    requires g !in DefGroupsOutsideLooksL(r)
    requires multiset(L.DefGroups(r))[g] <= 1
    requires LG.Find(g, gm) == None
    requires LT.TreeRes(LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir), gm, inp, dir).Some?
    ensures var t := LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir);
            (found ==> tsub < t)
            && (!found ==> LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1) == None)
            && (found ==>
                  L.Positivity(lk)
                  && !GWriteOnlyInLooks(tsub, g)
                  && LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk)).Some?
                  && LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1)
                     == LG.Find(g, LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk)).value.1))
  {
    var t := LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir);
    ComputeTrGOwnerWF2(rer, r, inp, gm, dir, g);
    found, lk, tsub, gmo, inpo := TreeResGOwnerFreshV(t, gm, inp, dir, g);
  }

  // ==========================================================================
  // B'' STRUCTURAL NAMING (milestone #1 core). A compiled `ComputeTr` tree
  // records, at EVERY `LK`/`LKFail` node, a body subtree that IS the compiled
  // body tree of that look's OWN body regex — `ComputeTr([Areg(r1)], inpX,
  // Empty, LkDir(lk0))` for a recursive-fragment body `r1` and the position
  // `inpX` at which `ComputeTr` built it. This is the general (all-depth,
  // all-branching) analogue of `ComputeTrSingleLookUnfold`'s per-layer pinning:
  // it holds uniformly over the whole tree by construction of `ComputeTr`. The
  // body map is pinned to `Empty` via `ComputeTrGmIndepLkRec` (positive bodies
  // recurse; negative bodies are group-free, hence still `PikeLkRegexRec`).
  // ==========================================================================

  /** `tlk` is the compiled body tree of SOME recursive-fragment body regex, at
      `Empty` map, in the look's own direction — the naming an `LK`/`LKFail`
      node's subtree carries by construction of `ComputeTr`. */
  ghost predicate NamedLkBody(rer: LW.RegExpRecord, lk0: L.Lookaround, tlk: LT.Tree) {
    exists r1: L.Regex, inpX: LC.Input ::
      EL.PikeLkRegexRec(r1)
      && tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inpX, LG.Empty, L.LkDir(lk0))
  }

  /** Every `LK`/`LKFail` body subtree of `t` is a `NamedLkBody`. Threaded down
      the sound owner descent so the innermost-owner subtree it lands on is
      recognized as a compiled look-body tree. */
  ghost predicate AllLkBodiesNamed(rer: LW.RegExpRecord, t: LT.Tree)
    decreases t
  {
    match t
    case Mismatch => true
    case Match => true
    case Choice(t1, t2) => AllLkBodiesNamed(rer, t1) && AllLkBodiesNamed(rer, t2)
    case Read(_, t1) => AllLkBodiesNamed(rer, t1)
    case ReadBackRef(_, t1) => AllLkBodiesNamed(rer, t1)
    case Progress(t1) => AllLkBodiesNamed(rer, t1)
    case AnchorPass(_, t1) => AllLkBodiesNamed(rer, t1)
    case GroupActionT(_, t1) => AllLkBodiesNamed(rer, t1)
    case LK(lk0, tlk, t1) =>
      NamedLkBody(rer, lk0, tlk) && AllLkBodiesNamed(rer, tlk) && AllLkBodiesNamed(rer, t1)
    case LKFail(lk0, tlk) =>
      NamedLkBody(rer, lk0, tlk) && AllLkBodiesNamed(rer, tlk)
  }

  /** B'' STRUCTURAL WALK: a recursive-fragment `ComputeTr` tree has every `LK`
      body subtree `NamedLkBody`. Mirrors `ComputeTrRw`'s one-step unfold
      (`decreases ActionsFuel`), recursing into every sub-`ComputeTr`; at the
      `LookaroundR` case the body subtree is `ComputeTr([Areg(r1)], inp, gm,
      LkDir(lk))`, pinned to `Empty` by `ComputeTrGmIndepLkRec`, so `(r1, inp)`
      witnesses `NamedLkBody`. */
  lemma ComputeTrAllLkBodiesNamed(rer: LW.RegExpRecord, act: LS.Actions, inp: LC.Input,
                                  gm: LG.GroupMap, dir: WP.Direction)
    requires EL.PikeLkActionsRec(act)
    ensures AllLkBodiesNamed(rer, LFU.ComputeTr(rer, act, inp, gm, dir))
    decreases LFS.ActionsFuel(act, inp, dir)
  {
    LFU.ComputeTrRw(rer, act, inp, gm, dir);
    var t := LFU.ComputeTr(rer, act, inp, gm, dir);
    if |act| == 0 { assert t == LT.Match; return; }
    var cont := act[1..];
    assert act == [act[0]] + cont;
    EL.PikeLkActionsRecConsIff(act[0], cont);
    EL.PikeLkActionsRecTail(act);
    match act[0]
    case Acheck(strcheck) =>
      if SS.IsStrictSuffix(inp, strcheck, dir) {
        LFS.CheckTermination(cont, inp, strcheck, dir);
        ComputeTrAllLkBodiesNamed(rer, cont, inp, gm, dir);
        assert t == LT.Progress(LFU.ComputeTr(rer, cont, inp, gm, dir));
      } else {
        assert t == LT.Mismatch;
      }
    case Aclose(gid) =>
      LFS.CloseTermination(cont, inp, dir, gid);
      ComputeTrAllLkBodiesNamed(rer, cont, inp, LG.GMClose(LC.Idx(inp), gid, gm), dir);
      assert t == LT.GroupActionT(LG.Close(gid), LFU.ComputeTr(rer, cont, inp, LG.GMClose(LC.Idx(inp), gid, gm), dir));
    case Areg(r) =>
      match r
      case Epsilon =>
        LFS.EpsilonTermination(cont, inp, dir);
        ComputeTrAllLkBodiesNamed(rer, cont, inp, gm, dir);
        assert t == LFU.ComputeTr(rer, cont, inp, gm, dir);
      case Character(cd) =>
        match LC.ReadChar(rer, cd, inp, dir) {
          case None => assert t == LT.Mismatch;
          case Some(pair) =>
            LFS.CharacterTermination(rer, cont, inp, dir, cd, pair.0, pair.1);
            ComputeTrAllLkBodiesNamed(rer, cont, pair.1, gm, dir);
            assert t == LT.Read(pair.0, LFU.ComputeTr(rer, cont, pair.1, gm, dir));
        }
      case Disjunction(r1, r2) =>
        assert EL.PikeLkActionsRec([LS.Areg(r1)] + cont) by { EL.PikeLkActionsRecConsIff(LS.Areg(r1), cont); }
        assert EL.PikeLkActionsRec([LS.Areg(r2)] + cont) by { EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont); }
        LFS.DisjunctionLeftTermination(cont, inp, dir, r1, r2);
        LFS.DisjunctionRightTermination(cont, inp, dir, r1, r2);
        ComputeTrAllLkBodiesNamed(rer, [LS.Areg(r1)] + cont, inp, gm, dir);
        ComputeTrAllLkBodiesNamed(rer, [LS.Areg(r2)] + cont, inp, gm, dir);
        assert t == LT.Choice(LFU.ComputeTr(rer, [LS.Areg(r1)] + cont, inp, gm, dir),
                              LFU.ComputeTr(rer, [LS.Areg(r2)] + cont, inp, gm, dir));
      case Sequence(r1, r2) =>
        var na := LS.SeqList(r1, r2, dir) + cont;
        assert EL.PikeLkActionsRec(na) by {
          if dir.Forward? {
            assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
          } else {
            assert na == [LS.Areg(r2)] + ([LS.Areg(r1)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r2), [LS.Areg(r1)] + cont);
          }
        }
        LFS.SequenceTermination(cont, inp, dir, r1, r2);
        ComputeTrAllLkBodiesNamed(rer, na, inp, gm, dir);
        assert t == LFU.ComputeTr(rer, na, inp, gm, dir);
      case Quantified(greedy, min, delta, r1) =>
        var gidl := L.DefGroups(r1);
        if min > 0 {
          var quant := L.Quantified(greedy, min - 1, delta, r1);
          var na := [LS.Areg(r1), LS.Areg(quant)] + cont;
          assert EL.PikeLkActionsRec(na) by {
            assert na == [LS.Areg(r1)] + ([LS.Areg(quant)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(quant), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(quant)] + cont);
          }
          LFS.QuantForcedTermination(cont, inp, dir, r1, min - 1, delta, greedy);
          assert (min - 1) + 1 == min;
          ComputeTrAllLkBodiesNamed(rer, na, inp, LG.GMReset(gidl, gm), dir);
          assert t == LT.GroupActionT(LG.Reset(gidl), LFU.ComputeTr(rer, na, inp, LG.GMReset(gidl, gm), dir));
        } else if delta == LN.NN(0) {
          LFS.QuantDoneTermination(cont, inp, dir, r1, greedy);
          ComputeTrAllLkBodiesNamed(rer, cont, inp, gm, dir);
          assert t == LFU.ComputeTr(rer, cont, inp, gm, dir);
        } else {
          var quant := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
          var na := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont;
          assert EL.PikeLkActionsRec(na) by {
            assert na == [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            EL.PikeLkActionsRecConsIff(LS.Areg(quant), cont); EL.PikeLkActionsRecConsIff(LS.Acheck(inp), [LS.Areg(quant)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
          }
          LFS.QuantFreeIterTermination(cont, inp, dir, r1, greedy, delta);
          LFS.QuantFreeSkipTermination(cont, inp, dir, r1, greedy, delta);
          ComputeTrAllLkBodiesNamed(rer, na, inp, LG.GMReset(gidl, gm), dir);
          ComputeTrAllLkBodiesNamed(rer, cont, inp, gm, dir);
          assert t == LT.GreedyChoice(greedy, LT.GroupActionT(LG.Reset(gidl), LFU.ComputeTr(rer, na, inp, LG.GMReset(gidl, gm), dir)),
                                      LFU.ComputeTr(rer, cont, inp, gm, dir));
        }
      case Group(gid, r1) =>
        var na := [LS.Areg(r1), LS.Aclose(gid)] + cont;
        assert EL.PikeLkActionsRec(na) by {
          assert na == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
          EL.PikeLkActionsRecConsIff(LS.Aclose(gid), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Aclose(gid)] + cont);
        }
        LFS.GroupTermination(cont, inp, dir, r1, gid);
        ComputeTrAllLkBodiesNamed(rer, na, inp, LG.GMOpen(LC.Idx(inp), gid, gm), dir);
        assert t == LT.GroupActionT(LG.Open(gid), LFU.ComputeTr(rer, na, inp, LG.GMOpen(LC.Idx(inp), gid, gm), dir));
      case LookaroundR(lk, r1) =>
        assert EL.PikeLkRegexRec(r1) by {
          if L.Positivity(lk) { } else { assert SD.GroupFreeL(r1); GroupFreeImpliesNoLkBr(r1); EL.NoLkBrLIsPikeLkRegexRec(r1); }
        }
        assert EL.PikeLkActionsRec([LS.Areg(r1)]) by { EL.PikeLkActionsRecConsIff(LS.Areg(r1), []); }
        LFS.LkLkTermination(cont, inp, dir, lk, r1);
        ComputeTrAllLkBodiesNamed(rer, [LS.Areg(r1)], inp, gm, L.LkDir(lk));
        var treelk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, gm, L.LkDir(lk));
        EL.ComputeTrGmIndepLkRec(rer, r1, inp, gm, L.LkDir(lk));
        assert treelk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
        assert NamedLkBody(rer, lk, treelk);   // witness (r1, inp)
        match LS.LkResult(lk, treelk, gm, inp) {
          case Some(gmlk) =>
            LFS.LkAfterTermination(cont, inp, dir, lk, r1);
            ComputeTrAllLkBodiesNamed(rer, cont, inp, gmlk, dir);
            assert t == LT.LK(lk, treelk, LFU.ComputeTr(rer, cont, inp, gmlk, dir));
          case None =>
            assert t == LT.LKFail(lk, treelk);
        }
      case AnchorR(a) =>
        if LS.AnchorSatisfied(rer, a, inp) {
          LFS.AnchorTermination(cont, inp, dir, a);
          ComputeTrAllLkBodiesNamed(rer, cont, inp, gm, dir);
          assert t == LT.AnchorPass(a, LFU.ComputeTr(rer, cont, inp, gm, dir));
        } else {
          assert t == LT.Mismatch;
        }
      case Backreference(gid) =>
        assert false;   // PikeLkRegexRec(Backreference) == false, excluded by PikeLkActionsRec
  }

  // ==========================================================================
  // B'' HEADLINE (deliverable #1): the ACTION-SPACE regex-tracking owner descent
  // that NAMES the owner subtree as the owner look's compiled body tree. Fuses
  // `ComputeTreeGBodyOK`'s per-case ACTION bookkeeping (`decreases ActionsFuel`,
  // `ComputeTrRw` one-step unfold) with `TreeResGOwnerFreshV`'s winning-path
  // following. Because the walk always PUSHES the owner look to the ACTION HEAD
  // before processing it, at that point the whole current tree IS the `LK` node
  // `LK(lk, treelk, tcont)` and the owner peel is the ATOMIC
  // `TreeResLkNodeGValueFresh` (no deep tree navigation). The single group map
  // threaded by `ComputeTr` (build) and `TreeRes` (evaluate) COINCIDE at every
  // step (GMUpdate mirrors GMOpen/GMClose/GMReset; the look continuation runs at
  // `LkResult == TreeRes(body)`), so the descent-recorded position `inpo` is BOTH
  // the owner body's BUILD position and its TreeRes position — resolving the
  // ComputeTr/TreeRes position alignment for free. The named owner subtree is
  // pinned to `Empty` by `ComputeTrGmIndepLkRec`.
  // ==========================================================================

  /** B'' deliverable #1. On the winning path of a recursive-fragment action
      list, the leaf value at an inside-look capture `g` is EITHER unset (`None`)
      OR the value at `g` of the OWNER positive look's compiled body tree
      `ComputeTr([Areg(rr)], inpo, Empty, LkDir(lk0))`, at the descent-recorded
      position `inpo`. `rr` is that look's OWN body regex, named off the action
      list. Composes with `TreeResLkNodeGValueFresh` at the owner (peeled atomicly
      because the owner look is at the action head). */
  lemma ComputeTrOwnerNamedActs(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                                gm: LG.GroupMap, dir: WP.Direction, g: LG.GroupId)
    returns (found: bool, lk0: L.Lookaround, rr: L.Regex, inpo: LC.Input, gmo: LG.GroupMap)
    requires EL.PikeLkActionsRec(acts)
    requires GNQActs(acts, g)
    requires GOnceInv(acts, g)
    requires g !in OuterDefsActs(acts)
    requires LG.Find(g, gm) == None
    requires LT.TreeRes(LFU.ComputeTr(rer, acts, inp, gm, dir), gm, inp, dir).Some?
    ensures var t := LFU.ComputeTr(rer, acts, inp, gm, dir);
            (!found ==> LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1) == None)
            && (found ==> SubLkBodyActs(acts, rr))       // rr is a look body of a pending Areg
            && (found ==>
                  L.Positivity(lk0)
                  && EL.PikeLkRegexRec(rr)
                  && g in DefGroupsOutsideLooksL(rr)          // g DIRECTLY captured in the owner body
                  && gmo == LG.Empty
                  && var tsub := LFU.ComputeTr(rer, [LS.Areg(rr)], inpo, gmo, L.LkDir(lk0));
                  LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk0)).Some?
                  && LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1)
                     == LG.Find(g, LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk0)).value.1))
    decreases LFS.ActionsFuel(acts, inp, dir)
  {
    found, lk0, rr, inpo, gmo := false, L.LookAhead, L.Epsilon, inp, gm;   // !found default
    LFU.ComputeTrRw(rer, acts, inp, gm, dir);
    var t := LFU.ComputeTr(rer, acts, inp, gm, dir);
    if |acts| == 0 {
      assert t == LT.Match;
      assert LT.TreeRes(t, gm, inp, dir) == Some((inp, gm));
      return;
    }
    var cont := acts[1..];
    assert acts == [acts[0]] + cont;
    EL.PikeLkActionsRecConsIff(acts[0], cont);
    EL.PikeLkActionsRecTail(acts);
    GNQActsCons(acts[0], cont, g);
    GNQActsTail(acts, g);
    OuterDefsActsCons(acts[0], cont);
    AllDefsActsMsCons(acts[0], cont, g);
    PendingClosesCons(acts[0], cont);
    assert multiset(AllDefsActs(cont))[g] <= multiset(AllDefsActs(acts))[g];
    assert (g in PendingCloses(cont)) ==> (g in PendingCloses(acts));
    assert GOnceInv(cont, g);
    assert g !in OuterDefsActs(cont);
    match acts[0]
    case Acheck(strcheck) =>
      if SS.IsStrictSuffix(inp, strcheck, dir) {
        LFS.CheckTermination(cont, inp, strcheck, dir);
        assert t == LT.Progress(LFU.ComputeTr(rer, cont, inp, gm, dir));
        assert LT.TreeRes(t, gm, inp, dir) == LT.TreeRes(LFU.ComputeTr(rer, cont, inp, gm, dir), gm, inp, dir);
        found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, cont, inp, gm, dir, g);
        if found { SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk tail-lift
      } else {
        assert t == LT.Mismatch;
        assert false;   // TreeRes(Mismatch) == None contradicts .Some?
      }
    case Aclose(gid) =>
      assert gid != g;   // g !in OuterDefsActs (Aclose contributes {gid})
      LFS.CloseTermination(cont, inp, dir, gid);
      var gm2 := LG.GMClose(LC.Idx(inp), gid, gm);
      assert t == LT.GroupActionT(LG.Close(gid), LFU.ComputeTr(rer, cont, inp, gm2, dir));
      GMUpdateFindNotTouch(LG.Close(gid), LC.Idx(inp), gm, g);   // Find(g, gm2) == None
      assert LT.TreeRes(t, gm, inp, dir) == LT.TreeRes(LFU.ComputeTr(rer, cont, inp, gm2, dir), gm2, inp, dir);
      found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, cont, inp, gm2, dir, g);
      if found { SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk tail-lift
    case Areg(r) =>
      match r
      case Epsilon =>
        LFS.EpsilonTermination(cont, inp, dir);
        assert t == LFU.ComputeTr(rer, cont, inp, gm, dir);
        found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, cont, inp, gm, dir, g);
        if found { SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk tail-lift
      case Character(cd) =>
        match LC.ReadChar(rer, cd, inp, dir) {
          case None => assert t == LT.Mismatch; assert false;
          case Some(pair) =>
            LFS.CharacterTermination(rer, cont, inp, dir, cd, pair.0, pair.1);
            LC.CanReadCorrect(inp, rer, cd, dir, pair.1);
            LC.AdvanceInputSuccess(inp, dir, pair.1);   // pair.1 == AdvanceInputP(inp, dir)
            assert t == LT.Read(pair.0, LFU.ComputeTr(rer, cont, pair.1, gm, dir));
            assert LT.TreeRes(t, gm, inp, dir) == LT.TreeRes(LFU.ComputeTr(rer, cont, pair.1, gm, dir), gm, pair.1, dir);
            found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, cont, pair.1, gm, dir, g);
            if found { SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk tail-lift
        }
      case Disjunction(r1, r2) =>
        var a1 := [LS.Areg(r1)] + cont; var a2 := [LS.Areg(r2)] + cont;
        assert GNQActs(a1, g) && GNQActs(a2, g) by { GNQActsCons(LS.Areg(r1), cont, g); GNQActsCons(LS.Areg(r2), cont, g); }
        assert EL.PikeLkActionsRec(a1) && EL.PikeLkActionsRec(a2) by { EL.PikeLkActionsRecConsIff(LS.Areg(r1), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont); }
        assert GOnceInv(a1, g) && GOnceInv(a2, g) by {
          AllDefsActsMsCons(LS.Areg(r1), cont, g); AllDefsActsMsCons(LS.Areg(r2), cont, g);
          PendingClosesCons(LS.Areg(r1), cont); PendingClosesCons(LS.Areg(r2), cont);
          assert multiset(L.DefGroups(r))[g] == multiset(L.DefGroups(r1))[g] + multiset(L.DefGroups(r2))[g];
        }
        assert g !in OuterDefsActs(a1) && g !in OuterDefsActs(a2) by {
          OuterDefsActsCons(LS.Areg(r1), cont); OuterDefsActsCons(LS.Areg(r2), cont);
          assert L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
        }
        LFS.DisjunctionLeftTermination(cont, inp, dir, r1, r2);
        LFS.DisjunctionRightTermination(cont, inp, dir, r1, r2);
        var tA := LFU.ComputeTr(rer, a1, inp, gm, dir);
        var tB := LFU.ComputeTr(rer, a2, inp, gm, dir);
        assert t == LT.Choice(tA, tB);
        if LT.TreeRes(tA, gm, inp, dir).Some? {
          assert LT.TreeRes(t, gm, inp, dir) == LT.TreeRes(tA, gm, inp, dir);
          found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, a1, inp, gm, dir, g);
          if found { SubLkBodyActsCons(LS.Areg(r1), cont, rr); SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk: r1 in Disjunction
        } else {
          assert LT.TreeRes(t, gm, inp, dir) == LT.TreeRes(tB, gm, inp, dir);
          found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, a2, inp, gm, dir, g);
          if found { SubLkBodyActsCons(LS.Areg(r2), cont, rr); SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk: r2 in Disjunction
        }
      case Sequence(r1, r2) =>
        var na := LS.SeqList(r1, r2, dir) + cont;
        assert EL.PikeLkActionsRec(na) && GNQActs(na, g) && GOnceInv(na, g) && g !in OuterDefsActs(na) by {
          if dir.Forward? {
            assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
            GNQActsCons(LS.Areg(r2), cont, g); GNQActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont, g);
            AllDefsActsMsCons(LS.Areg(r2), cont, g); AllDefsActsMsCons(LS.Areg(r1), [LS.Areg(r2)] + cont, g);
            PendingClosesCons(LS.Areg(r2), cont); PendingClosesCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
            OuterDefsActsCons(LS.Areg(r2), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
          } else {
            assert na == [LS.Areg(r2)] + ([LS.Areg(r1)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r2), [LS.Areg(r1)] + cont);
            GNQActsCons(LS.Areg(r1), cont, g); GNQActsCons(LS.Areg(r2), [LS.Areg(r1)] + cont, g);
            AllDefsActsMsCons(LS.Areg(r1), cont, g); AllDefsActsMsCons(LS.Areg(r2), [LS.Areg(r1)] + cont, g);
            PendingClosesCons(LS.Areg(r1), cont); PendingClosesCons(LS.Areg(r2), [LS.Areg(r1)] + cont);
            OuterDefsActsCons(LS.Areg(r1), cont); OuterDefsActsCons(LS.Areg(r2), [LS.Areg(r1)] + cont);
          }
          assert multiset(L.DefGroups(r))[g] == multiset(L.DefGroups(r1))[g] + multiset(L.DefGroups(r2))[g];
          assert L.DefGroups(r) == L.DefGroups(r1) + L.DefGroups(r2);
        }
        LFS.SequenceTermination(cont, inp, dir, r1, r2);
        assert t == LFU.ComputeTr(rer, na, inp, gm, dir);
        found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, na, inp, gm, dir, g);
        if found {   // SubLk: r1,r2 both in Sequence(r1,r2)
          if dir.Forward? {
            assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
            SubLkBodyActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont, rr); SubLkBodyActsCons(LS.Areg(r2), cont, rr);
          } else {
            assert na == [LS.Areg(r2)] + ([LS.Areg(r1)] + cont);
            SubLkBodyActsCons(LS.Areg(r2), [LS.Areg(r1)] + cont, rr); SubLkBodyActsCons(LS.Areg(r1), cont, rr);
          }
          SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr);
        }
      case Quantified(greedy, min, delta, r1) =>
        var gidl := L.DefGroups(r1);
        assert g !in (set x | x in L.DefGroups(r1));   // GNotUnderQuantL(Quantified)
        assert multiset(L.DefGroups(r1))[g] == 0;
        assert L.DefGroups(r) == gidl;
        assert LG.Find(g, LG.GMReset(gidl, gm)) == None by { GMUpdateFindNotTouch(LG.Reset(gidl), LC.Idx(inp), gm, g); }
        if min > 0 {
          var quant := L.Quantified(greedy, min - 1, delta, r1);
          var na := [LS.Areg(r1), LS.Areg(quant)] + cont;
          assert EL.PikeLkActionsRec(na) && GNQActs(na, g) && GOnceInv(na, g) && g !in OuterDefsActs(na) by {
            assert na == [LS.Areg(r1)] + ([LS.Areg(quant)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(quant), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(quant)] + cont);
            GNQActsCons(LS.Areg(quant), cont, g); GNQActsCons(LS.Areg(r1), [LS.Areg(quant)] + cont, g);
            AllDefsActsMsCons(LS.Areg(quant), cont, g); AllDefsActsMsCons(LS.Areg(r1), [LS.Areg(quant)] + cont, g);
            PendingClosesCons(LS.Areg(quant), cont); PendingClosesCons(LS.Areg(r1), [LS.Areg(quant)] + cont);
            OuterDefsActsCons(LS.Areg(quant), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Areg(quant)] + cont);
            assert L.DefGroups(quant) == gidl;
            assert DefGroupsOutsideLooksL(quant) == DefGroupsOutsideLooksL(r1);
          }
          LFS.QuantForcedTermination(cont, inp, dir, r1, min - 1, delta, greedy);
          assert (min - 1) + 1 == min;
          var titer := LFU.ComputeTr(rer, na, inp, LG.GMReset(gidl, gm), dir);
          assert t == LT.GroupActionT(LG.Reset(gidl), titer);
          assert LT.TreeRes(t, gm, inp, dir) == LT.TreeRes(titer, LG.GMReset(gidl, gm), inp, dir);
          found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, na, inp, LG.GMReset(gidl, gm), dir, g);
          if found {   // SubLk: r1 in Quantified(_,_,_,r1); quant's body is r1 too
            assert na == [LS.Areg(r1)] + ([LS.Areg(quant)] + cont);
            SubLkBodyActsCons(LS.Areg(r1), [LS.Areg(quant)] + cont, rr); SubLkBodyActsCons(LS.Areg(quant), cont, rr);
            assert SubLkBody(quant, rr) == SubLkBody(r1, rr);
            SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr);
          }
        } else if delta == LN.NN(0) {
          LFS.QuantDoneTermination(cont, inp, dir, r1, greedy);
          assert t == LFU.ComputeTr(rer, cont, inp, gm, dir);
          found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, cont, inp, gm, dir, g);
          if found { SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk tail-lift
        } else {
          var quant := L.Quantified(greedy, 0, LFS.NoiPred(delta), r1);
          var na := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont;
          assert EL.PikeLkActionsRec(na) && GNQActs(na, g) && GOnceInv(na, g) && g !in OuterDefsActs(na) by {
            assert na == [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            EL.PikeLkActionsRecConsIff(LS.Areg(quant), cont); EL.PikeLkActionsRecConsIff(LS.Acheck(inp), [LS.Areg(quant)] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            GNQActsCons(LS.Areg(quant), cont, g); GNQActsCons(LS.Acheck(inp), [LS.Areg(quant)] + cont, g);
            GNQActsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont), g);
            AllDefsActsMsCons(LS.Areg(quant), cont, g); AllDefsActsMsCons(LS.Acheck(inp), [LS.Areg(quant)] + cont, g);
            AllDefsActsMsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont), g);
            PendingClosesCons(LS.Areg(quant), cont); PendingClosesCons(LS.Acheck(inp), [LS.Areg(quant)] + cont);
            PendingClosesCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            OuterDefsActsCons(LS.Areg(quant), cont); OuterDefsActsCons(LS.Acheck(inp), [LS.Areg(quant)] + cont);
            OuterDefsActsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            assert L.DefGroups(quant) == gidl;
            assert DefGroupsOutsideLooksL(quant) == DefGroupsOutsideLooksL(r1);
          }
          LFS.QuantFreeIterTermination(cont, inp, dir, r1, greedy, delta);
          LFS.QuantFreeSkipTermination(cont, inp, dir, r1, greedy, delta);
          var titer := LFU.ComputeTr(rer, na, inp, LG.GMReset(gidl, gm), dir);
          var tskip := LFU.ComputeTr(rer, cont, inp, gm, dir);
          var X := LT.GroupActionT(LG.Reset(gidl), titer);
          assert t == LT.GreedyChoice(greedy, X, tskip);
          assert LT.TreeRes(X, gm, inp, dir) == LT.TreeRes(titer, LG.GMReset(gidl, gm), inp, dir);
          var iterRes := LT.TreeRes(titer, LG.GMReset(gidl, gm), inp, dir);
          var skipRes := LT.TreeRes(tskip, gm, inp, dir);
          if greedy {
            assert t == LT.Choice(X, tskip);
            if iterRes.Some? {
              assert LT.TreeRes(t, gm, inp, dir) == iterRes;
              found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, na, inp, LG.GMReset(gidl, gm), dir, g);
              if found { SubLkFreeQuantNaLift(r1, quant, inp, cont, acts[0], acts, rr); }   // SubLk: r1 in Quantified
            } else {
              assert LT.TreeRes(t, gm, inp, dir) == skipRes;
              found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, cont, inp, gm, dir, g);
              if found { SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk tail-lift
            }
          } else {
            assert t == LT.Choice(tskip, X);
            if skipRes.Some? {
              assert LT.TreeRes(t, gm, inp, dir) == skipRes;
              found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, cont, inp, gm, dir, g);
              if found { SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk tail-lift
            } else {
              assert LT.TreeRes(t, gm, inp, dir) == iterRes;
              found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, na, inp, LG.GMReset(gidl, gm), dir, g);
              if found { SubLkFreeQuantNaLift(r1, quant, inp, cont, acts[0], acts, rr); }   // SubLk: r1 in Quantified
            }
          }
        }
      case Group(gid, r1) =>
        var na := [LS.Areg(r1), LS.Aclose(gid)] + cont;
        assert gid != g;   // g !in OuterDefsActs (Group contributes {gid})
        assert L.DefGroups(r) == [gid] + L.DefGroups(r1);
        assert EL.PikeLkActionsRec(na) && GNQActs(na, g) && GOnceInv(na, g) && g !in OuterDefsActs(na) by {
          assert na == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
          EL.PikeLkActionsRecConsIff(LS.Aclose(gid), cont); EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Aclose(gid)] + cont);
          GNQActsCons(LS.Aclose(gid), cont, g); GNQActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont, g);
          AllDefsActsMsCons(LS.Aclose(gid), cont, g); AllDefsActsMsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont, g);
          PendingClosesCons(LS.Aclose(gid), cont); PendingClosesCons(LS.Areg(r1), [LS.Aclose(gid)] + cont);
          OuterDefsActsCons(LS.Aclose(gid), cont); OuterDefsActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont);
        }
        LFS.GroupTermination(cont, inp, dir, r1, gid);
        var gm2 := LG.GMOpen(LC.Idx(inp), gid, gm);
        GMUpdateFindNotTouch(LG.Open(gid), LC.Idx(inp), gm, g);   // Find(g, gm2) == None
        var tc := LFU.ComputeTr(rer, na, inp, gm2, dir);
        assert t == LT.GroupActionT(LG.Open(gid), tc);
        assert LT.TreeRes(t, gm, inp, dir) == LT.TreeRes(tc, gm2, inp, dir);
        found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, na, inp, gm2, dir, g);
        if found {   // SubLk: r1 in Group(gid, r1)
          assert na == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
          SubLkBodyActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont, rr); SubLkBodyActsCons(LS.Aclose(gid), cont, rr);
          SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr);
        }
      case LookaroundR(lk, r1) =>
        assert EL.PikeLkRegexRec(r1) by {
          if L.Positivity(lk) { } else { assert SD.GroupFreeL(r1); GroupFreeImpliesNoLkBr(r1); EL.NoLkBrLIsPikeLkRegexRec(r1); }
        }
        var bodyacts := [LS.Areg(r1)];
        assert EL.PikeLkActionsRec(bodyacts) by { EL.PikeLkActionsRecConsIff(LS.Areg(r1), []); }
        var treelk := LFU.ComputeTr(rer, bodyacts, inp, gm, L.LkDir(lk));
        match LS.LkResult(lk, treelk, gm, inp) {
          case None =>
            assert t == LT.LKFail(lk, treelk);
            assert LT.TreeRes(t, gm, inp, dir).None?;
            assert false;
          case Some(gmlk) =>
            var tcont := LFU.ComputeTr(rer, cont, inp, gmlk, dir);
            assert t == LT.LK(lk, treelk, tcont);
            assert LT.TreeRes(t, gm, inp, dir) == LT.TreeRes(tcont, gmlk, inp, dir);
            if g in (set x | x in L.DefGroups(r1)) {
              // g is written in this positive look's body (somewhere).
              assert L.Positivity(lk) by {
                if !L.Positivity(lk) { assert SD.GroupFreeL(r1); SD.GroupFreeDefGroups(r1); }
              }
              assert L.DefGroups(r) == L.DefGroups(r1);
              assert multiset(L.DefGroups(r1))[g] >= 1;
              assert multiset(L.DefGroups(r1))[g] <= 1;   // GOnceInv on acts
              assert multiset(AllDefsActs(cont))[g] == 0;
              assert g !in (set x | x in AllDefsActs(cont));
              assert g !in PendingCloses(cont);
              GNotWrittenComputeTrActs(rer, cont, inp, gmlk, dir, g);   // GNotWritten(tcont, g)
              // OUTER peel: leaf value at g == body-tree value at g (at Empty), position `inp`.
              TreeResLkNodeGValueFresh(lk, treelk, tcont, gm, inp, dir, g);
              if g in DefGroupsOutsideLooksL(r1) {
                // g on r1's OWN spine: THIS look is the INNERMOST owner.
                EL.ComputeTrGmIndepLkRec(rer, r1, inp, gm, L.LkDir(lk));   // treelk == ComputeTr(bodyacts, inp, Empty, LkDir)
                assert treelk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
                found, lk0, rr, inpo, gmo := true, lk, r1, inp, LG.Empty;
                SubLkBodyActsCons(acts[0], cont, rr);           // SubLk: rr == r1 is THIS look's body
                assert SubLkBody(r, rr); assert SubLkBodyActs(acts, rr);
              } else {
                // g DEEPER inside r1's own looks: recurse into the body to find the
                // innermost owner, then chain through the outer peel.
                assert GNQActs([LS.Areg(r1)], g) by { GNQActsCons(LS.Areg(r1), [], g); }
                assert EL.PikeLkActionsRec([LS.Areg(r1)]) by { EL.PikeLkActionsRecConsIff(LS.Areg(r1), []); }
                assert GOnceInv([LS.Areg(r1)], g) by { AllDefsActsMsCons(LS.Areg(r1), [], g); PendingClosesCons(LS.Areg(r1), []); }
                assert g !in OuterDefsActs([LS.Areg(r1)]) by { OuterDefsActsCons(LS.Areg(r1), []); }
                assert LT.TreeRes(treelk, gm, inp, L.LkDir(lk)).Some?;   // LkResult Some (positive)
                LFS.LkLkTermination(cont, inp, dir, lk, r1);
                var f2, l2, rr2, i2, gmo2 := ComputeTrOwnerNamedActs(rer, [LS.Areg(r1)], inp, gm, L.LkDir(lk), g);
                // frame body-tree value at g: Empty vs gm agree (both None at g).
                TreeResGValueFramed(treelk, LG.Empty, gm, inp, L.LkDir(lk), g);
                if f2 {
                  found, lk0, rr, inpo, gmo := f2, l2, rr2, i2, gmo2;
                  SubLkBodyActsCons(LS.Areg(r1), [], rr2);       // SubLkBodyActs([Areg(r1)],rr2) => SubLkBody(r1,rr2)
                  SubLkBodyActsCons(acts[0], cont, rr);
                  assert SubLkBody(r1, rr2) ==> SubLkBody(r, rr);   // rr==rr2, r==LookaroundR(lk,r1)
                  assert SubLkBodyActs(acts, rr);
                } else {
                  found := false;   // body leaf at g None ==> outer leaf at g None
                }
              }
            } else {
              // g-free body: recurse into cont at the gate map gmlk.
              assert g !in (set x | x in L.DefGroups(r1));
              GNotWrittenComputeTr(rer, r1, inp, gm, L.LkDir(lk), g);   // GNotWritten(treelk, g)
              if L.Positivity(lk) {
                TreeResGNotWritten(treelk, gm, inp, L.LkDir(lk), g);
              }
              assert LG.Find(g, gmlk) == None;
              LFS.LkAfterTermination(cont, inp, dir, lk, r1);
              found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, cont, inp, gmlk, dir, g);
              if found { SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk tail-lift
            }
        }
      case AnchorR(a) =>
        if LS.AnchorSatisfied(rer, a, inp) {
          LFS.AnchorTermination(cont, inp, dir, a);
          assert t == LT.AnchorPass(a, LFU.ComputeTr(rer, cont, inp, gm, dir));
          assert LT.TreeRes(t, gm, inp, dir) == LT.TreeRes(LFU.ComputeTr(rer, cont, inp, gm, dir), gm, inp, dir);
          found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, cont, inp, gm, dir, g);
          if found { SubLkBodyActsCons(acts[0], cont, rr); assert SubLkBodyActs(acts, rr); }   // SubLk tail-lift
        } else {
          assert t == LT.Mismatch;
          assert false;
        }
      case Backreference(gid) =>
        assert false;   // excluded by PikeLkActionsRec
  }

  /** B'' deliverable #1 (turnkey single-regex form). Same signature/side
      conditions as `OuterLeafGOwnerSubtree`, but the owner subtree is NAMED as the
      owner look's compiled body tree `ComputeTr([Areg(rr)], inpo, Empty,
      LkDir(lk0))` (built AND evaluated at the descent-recorded `inpo`) rather than
      left abstract. Wraps `ComputeTrOwnerNamedActs` at `acts = [Areg(r)]`. The
      value tie to `OuterLeafGOwnerSubtree`'s abstract `tsub` is immediate: BOTH
      the named `tsub` here and `OuterLeafGOwnerSubtree`'s `tsub` have `Find(g, .)`
      equal to `Find(g, TreeRes(t, gm, inp, dir).value.1)` (found), or both give
      the leaf value `None` (`!found`) — the winning path writes `g` in exactly one
      (innermost owner) look body, or nowhere. */
  lemma ComputeTrOwnerNamed(rer: LW.RegExpRecord, r: L.Regex, inp: LC.Input, gm: LG.GroupMap,
                            dir: WP.Direction, g: LG.GroupId)
    returns (found: bool, lk0: L.Lookaround, rr: L.Regex, inpo: LC.Input, gmo: LG.GroupMap)
    requires EL.PikeLkRegexRec(r)
    requires GNotUnderQuantL(r, g)
    requires g !in DefGroupsOutsideLooksL(r)
    requires multiset(L.DefGroups(r))[g] <= 1
    requires LG.Find(g, gm) == None
    requires LT.TreeRes(LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir), gm, inp, dir).Some?
    ensures var t := LFU.ComputeTr(rer, [LS.Areg(r)], inp, gm, dir);
            (!found ==> LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1) == None)
            && (found ==> SubLkBody(r, rr))              // rr is a look body of r
            && (found ==>
                  L.Positivity(lk0)
                  && EL.PikeLkRegexRec(rr)
                  && g in DefGroupsOutsideLooksL(rr)          // g DIRECTLY captured in the owner body
                  && gmo == LG.Empty
                  && var tsub := LFU.ComputeTr(rer, [LS.Areg(rr)], inpo, gmo, L.LkDir(lk0));
                  LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk0)).Some?
                  && LG.Find(g, LT.TreeRes(t, gm, inp, dir).value.1)
                     == LG.Find(g, LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk0)).value.1))
  {
    var acts := [LS.Areg(r)];
    assert EL.PikeLkActionsRec(acts) by { EL.PikeLkActionsRecConsIff(LS.Areg(r), []); }
    assert GNQActs(acts, g) by { GNQActsCons(LS.Areg(r), [], g); }
    assert GOnceInv(acts, g) by { AllDefsActsMsCons(LS.Areg(r), [], g); PendingClosesCons(LS.Areg(r), []); }
    assert g !in OuterDefsActs(acts) by { OuterDefsActsCons(LS.Areg(r), []); }
    found, lk0, rr, inpo, gmo := ComputeTrOwnerNamedActs(rer, acts, inp, gm, dir, g);
    if found { SubLkBodyActsCons(LS.Areg(r), [], rr); }   // SubLkBodyActs([Areg(r)],rr) => SubLkBody(r,rr)
  }

  /** B'' deliverable #2 — the TURNKEY owner<->tree correspondence. Composes
      `ComputeTrOwnerNamed` (at `r := Translate(body)`, `Forward`) with deliverable
      #1: the winning leaf value at `g` in the whole tree is EITHER absent (`None`)
      OR equal to the leaf value at `g` of the innermost DIRECT owner's OWN
      compiled body tree, built at the descent-recorded position `inpo` in the
      owner look's direction. The owner body is NAMED on the R-side as
      `Translate(LookBodyOfRE(body, InnermostOwnerDirect(body, g)))` via #1's
      identification of the L-descent's `rr`. `PikeLkRegexRec(Translate(body))` is
      discharged from the nested fragment (`TranslateFragmentPikeLkRec`); the
      remaining side conditions are `ComputeTrOwnerNamed`'s. */
  lemma OuterLeafInnerGEqOwnerBody(rer: LW.RegExpRecord, body: R.regex, g: nat,
                                   inp: LC.Input, gm: LG.GroupMap)
    returns (found: bool, owner: nat, lk0: L.Lookaround, inpo: LC.Input)
    requires T.TransWf(body) && NR.NestedFragmentRE(body) && NR.NegLooksLookFreeRE(body)
    requires PIV.CapUnique(body) && LTB.LookUnique(body)
    requires GNotUnderQuantL(T.Translate(body), g)
    requires g in LL.LkBodyGroups(T.Translate(body))
    requires multiset(L.DefGroups(T.Translate(body)))[g] <= 1
    requires LG.Find(g, gm) == None
    requires LT.TreeRes(LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, gm, WP.Forward), gm, inp, WP.Forward).Some?
    ensures owner in LTB.LookIds(body)
    ensures g in PIV.CapIds(NI.LookBodyOfRE(body, owner))
    ensures g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(body, owner))
    ensures T.TransWf(NI.LookBodyOfRE(body, owner))
    ensures var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, gm, WP.Forward);
            (!found ==> LG.Find(g, LT.TreeRes(t, gm, inp, WP.Forward).value.1) == None)
            && (found ==>
                  L.Positivity(lk0)
                  && var owb := T.Translate(NI.LookBodyOfRE(body, owner));
                  var tsub := LFU.ComputeTr(rer, [LS.Areg(owb)], inpo, LG.Empty, L.LkDir(lk0));
                  LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk0)).Some?
                  && LG.Find(g, LT.TreeRes(t, gm, inp, WP.Forward).value.1)
                     == LG.Find(g, LT.TreeRes(tsub, LG.Empty, inpo, L.LkDir(lk0)).value.1))
  {
    var tr := T.Translate(body);
    // g sits inside a look of body; get the innermost DIRECT owner.
    LkBodyGroupsEqCapIdsInLooks(body);                         // g in CapIdsInLooks(body)
    assert g in PIV.CapIdsInLooks(body);
    owner := NI.InnermostOwnerDirect(body, g);
    TransWfLookBodyOfRE(body, owner);                          // TransWf(LookBodyOfRE(body,owner))
    // side conditions of ComputeTrOwnerNamed
    EL.TranslateFragmentPikeLkRec(body);                       // PikeLkRegexRec(tr)
    TranslateDefGroupsOutsideEqCapIdsOutside(body);            // DefGroupsOutsideLooksL(tr)==CapIdsOutsideLooks(body)
    PIV.CapIdsLooksDisjoint(body);                             // Outside * InLooks == {}
    assert g !in DefGroupsOutsideLooksL(tr);
    // run the descent
    var rr, gmo;
    found, lk0, rr, inpo, gmo := ComputeTrOwnerNamed(rer, tr, inp, gm, WP.Forward, g);
    if found {
      // identify the descent's owner body rr with the named R-owner body
      TranslateOwnerBodyIsRR(body, g, rr, owner);
      assert rr == T.Translate(NI.LookBodyOfRE(body, owner));
      assert gmo == LG.Empty;
    }
  }

  /** R31b (2b) — the ATOMIC per-layer ComputeTr↔look-body bridge, the concrete
      realization of "the tree node an `LK` carries has sub-tree ==
      `ComputeTr(Translate(body of that look))` BY CONSTRUCTION of ComputeTr". For a
      single-look action list `[Areg(LookaroundR(lk, r1))]` (the shape `Translate`
      emits at a look node), the spec tree at `Empty` is EXACTLY
      `LK(lk, ComputeTr([Areg(r1)], inp, Empty, LkDir(lk)), Match)` when the gate
      passes, or `LKFail(lk, that body)` when it fails — its LK BODY subtree is the
      compiled body tree of the look's OWN body `r1`. Proven off `BoolTreeLk`'s
      `LookaroundR` case (its `LkGateOk` pins the body subtree). A regex-tracking
      owner descent composes THIS at each layer to identify the landed owner subtree
      with `ComputeTr(Translate(LookBodyOfRE(body, owner)))`. */
  lemma ComputeTrSingleLookUnfold(rer: LW.RegExpRecord, lk: L.Lookaround, r1: L.Regex, inp: LC.Input)
    requires EL.PikeLkRegexRec(L.LookaroundR(lk, r1))
    ensures var tbody := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
            var t := LFU.ComputeTr(rer, [LS.Areg(L.LookaroundR(lk, r1))], inp, LG.Empty, WP.Forward);
            (LS.LkResult(lk, tbody, LG.Empty, inp).Some? ==> t == LT.LK(lk, tbody, LT.Match))
            && (LS.LkResult(lk, tbody, LG.Empty, inp).None? ==> t == LT.LKFail(lk, tbody))
  {
    var acts := [LS.Areg(L.LookaroundR(lk, r1))];
    LFU.ComputeTrIsTree(rer, acts, inp, LG.Empty, WP.Forward);
    var t := LFU.ComputeTr(rer, acts, inp, LG.Empty, WP.Forward);
    assert LS.IsTree(rer, acts, inp, LG.Empty, WP.Forward, t);
    EL.BooleanCorrectLkRec(rer, L.LookaroundR(lk, r1), inp, t);
    assert EL.BoolTreeLk(rer, acts, inp, BS.CanExit, t);
    var tbody := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    // BoolTreeLk's LookaroundR case forces t to LK/LKFail; LkGateOk pins tlk == tbody.
    match t
    case LK(lk2, tlk, tc) =>
      assert lk2 == lk && EL.LkGateOk(rer, lk, r1, inp, tlk, true)
             && EL.BoolTreeLk(rer, [], inp, BS.CanExit, tc);
      assert tlk == tbody;                                   // LkGateOk: tlk == ComputeTr([Areg(r1)],..)
      assert tc == LT.Match;                                 // BoolTreeLk on empty cont
      assert LS.LkResult(lk, tbody, LG.Empty, inp).Some?;    // LkGateOk ok == true
    case LKFail(lk2, tlk) =>
      assert lk2 == lk && EL.LkGateOk(rer, lk, r1, inp, tlk, false);
      assert tlk == tbody;
      assert LS.LkResult(lk, tbody, LG.Empty, inp).None?;    // LkGateOk ok == false
    case Mismatch =>  assert false;
    case Match =>     assert false;
    case Choice(_, _) => assert false;
    case Read(_, _) => assert false;
    case ReadBackRef(_, _) => assert false;
    case Progress(_) => assert false;
    case AnchorPass(_, _) => assert false;
    case GroupActionT(_, _) => assert false;
  }

  /** R31b (2b) SINGLE-DIRECT-OWNER (NestDepth==2). When `body` IS a single positive
      look `LookaroundR(lk, tr1)` (the owner) that MATCHES, the OUTER body-tree's leaf
      value at any `g` equals the OWNER body tree `ComputeTr([Areg(tr1)], inp, Empty,
      LkDir(lk))`'s OWN (Empty-map) sub-result at `g`, at the owner's position `inp`.
      Composes `ComputeTrSingleLookUnfold` (outer tree == `LK(lk, tbody, Match)`) with
      the fresh single-layer peel `TreeResLkNodeGValueFresh`. `tbody` IS
      `ComputeTr(Translate(LookBodyOfRE(body, owner)))`, so this is the
      landed-owner-subtree == compiled-owner-body identity for the one-layer case —
      the SPEC half of `recon_inner`. The engine tie (owner replay == owner
      `LkResult`) is then `LkReplayMatchesSpecNested` applied to `tr1`, whose OUTER
      groups `S` include a directly-captured `g` (`g !in LkBodyGroups(tr1)`). */
  lemma SingleLookOuterLeafIsOwnerBody(rer: LW.RegExpRecord, lk: L.Lookaround, tr1: L.Regex,
                                       inp: LC.Input, g: LG.GroupId)
    requires EL.PikeLkRegexRec(L.LookaroundR(lk, tr1))
    requires L.Positivity(lk)
    requires LS.LkResult(lk, LFU.ComputeTr(rer, [LS.Areg(tr1)], inp, LG.Empty, L.LkDir(lk)),
                         LG.Empty, inp).Some?
    ensures var tbody := LFU.ComputeTr(rer, [LS.Areg(tr1)], inp, LG.Empty, L.LkDir(lk));
            var t := LFU.ComputeTr(rer, [LS.Areg(L.LookaroundR(lk, tr1))], inp, LG.Empty, WP.Forward);
            LT.TreeRes(t, LG.Empty, inp, WP.Forward).Some?
            && LT.TreeRes(tbody, LG.Empty, inp, L.LkDir(lk)).Some?
            && LG.Find(g, LT.TreeRes(t, LG.Empty, inp, WP.Forward).value.1)
               == LG.Find(g, LT.TreeRes(tbody, LG.Empty, inp, L.LkDir(lk)).value.1)
  {
    var tbody := LFU.ComputeTr(rer, [LS.Areg(tr1)], inp, LG.Empty, L.LkDir(lk));
    var t := LFU.ComputeTr(rer, [LS.Areg(L.LookaroundR(lk, tr1))], inp, LG.Empty, WP.Forward);
    ComputeTrSingleLookUnfold(rer, lk, tr1, inp);
    assert t == LT.LK(lk, tbody, LT.Match);                 // LkResult Some arm
    assert LT.TreeRes(tbody, LG.Empty, inp, L.LkDir(lk)).Some?;   // LkResult Some (positive)
    assert LG.Find(g, LG.Empty) == None;
    assert LT.TreeRes(t, LG.Empty, inp, WP.Forward).Some?;  // node Some: sub Some & cont Match Some
    TreeResLkNodeGValueFresh(lk, tbody, LT.Match, LG.Empty, inp, WP.Forward, g);
  }

  /** R30b (2b) DEPTH-3 (NestDepth==3, TWO-layer descent): the concrete next step
      beyond `SingleLookOuterLeafIsOwnerBody`, composing the atomic layer peel
      TWICE. When `body` is a positive lookAHEAD `lk_o` whose body is ITSELF a
      single positive look `LookaroundR(lk_i, tr1)` (the OWNER of a capture `g`
      captured directly in the look-free `tr1`), the OUTER body-tree's leaf value
      at `g` equals the OWNER body tree `ComputeTr([Areg(tr1)], inp, Empty,
      LkDir(lk_i))`'s OWN (Empty-map) sub-result at `g`, at the owner's position
      `inp` (looks at the head of the body do not advance the input, so the
      recorded position is unchanged). Proof: `SingleLookOuterLeafIsOwnerBody` on
      the INNER look (`lk_i, tr1`) ties the inner-look tree leaf at `g` to `tr1`'s
      body tree at `g`; then `ComputeTrSingleLookUnfold` unfolds the OUTER look to
      `LK(lk_o, t_inner, Match)` and `TreeResLkNodeGValueFresh` peels that layer,
      tying the outer leaf at `g` to the inner-look tree leaf at `g`. Chaining the
      two hops gives the depth-3 identity. `tr1 == Translate(LookBodyOfRE(body,
      inner-owner))`, so this is the landed-owner-subtree == compiled-owner-body
      identity for the two-layer case — the same recursion the general induction
      on `NestDepth` iterates. */
  lemma DoubleLookOuterLeafIsOwnerBody(rer: LW.RegExpRecord, lk_o: L.Lookaround, lk_i: L.Lookaround,
                                       tr1: L.Regex, inp: LC.Input, g: LG.GroupId)
    requires EL.PikeLkRegexRec(L.LookaroundR(lk_o, L.LookaroundR(lk_i, tr1)))
    requires L.Positivity(lk_o) && L.LkDir(lk_o) == WP.Forward
    requires L.Positivity(lk_i)
    // inner look matches (its body tree at Empty succeeds under the gate)
    requires LS.LkResult(lk_i, LFU.ComputeTr(rer, [LS.Areg(tr1)], inp, LG.Empty, L.LkDir(lk_i)),
                         LG.Empty, inp).Some?
    // outer look matches (its body — the inner-look tree — succeeds under the gate)
    requires LS.LkResult(lk_o, LFU.ComputeTr(rer, [LS.Areg(L.LookaroundR(lk_i, tr1))], inp, LG.Empty, WP.Forward),
                         LG.Empty, inp).Some?
    ensures var tbody := LFU.ComputeTr(rer, [LS.Areg(tr1)], inp, LG.Empty, L.LkDir(lk_i));
            var t := LFU.ComputeTr(rer, [LS.Areg(L.LookaroundR(lk_o, L.LookaroundR(lk_i, tr1)))],
                                   inp, LG.Empty, WP.Forward);
            LT.TreeRes(t, LG.Empty, inp, WP.Forward).Some?
            && LT.TreeRes(tbody, LG.Empty, inp, L.LkDir(lk_i)).Some?
            && LG.Find(g, LT.TreeRes(t, LG.Empty, inp, WP.Forward).value.1)
               == LG.Find(g, LT.TreeRes(tbody, LG.Empty, inp, L.LkDir(lk_i)).value.1)
  {
    // the recursive fragment threads down the two POSITIVE-look layers.
    assert EL.PikeLkRegexRec(L.LookaroundR(lk_i, tr1));   // outer positive => body recurses

    var tbody := LFU.ComputeTr(rer, [LS.Areg(tr1)], inp, LG.Empty, L.LkDir(lk_i));
    var tInner := LFU.ComputeTr(rer, [LS.Areg(L.LookaroundR(lk_i, tr1))], inp, LG.Empty, WP.Forward);
    var t := LFU.ComputeTr(rer, [LS.Areg(L.LookaroundR(lk_o, L.LookaroundR(lk_i, tr1)))],
                           inp, LG.Empty, WP.Forward);

    // ---- INNER layer: tInner leaf at g == tbody value at g -------------------
    SingleLookOuterLeafIsOwnerBody(rer, lk_i, tr1, inp, g);
    assert LT.TreeRes(tInner, LG.Empty, inp, WP.Forward).Some?;
    assert LT.TreeRes(tbody, LG.Empty, inp, L.LkDir(lk_i)).Some?;
    assert LG.Find(g, LT.TreeRes(tInner, LG.Empty, inp, WP.Forward).value.1)
        == LG.Find(g, LT.TreeRes(tbody, LG.Empty, inp, L.LkDir(lk_i)).value.1);

    // ---- OUTER layer: unfold the outer look, then peel it --------------------
    // LkDir(lk_o) == Forward, so ComputeTrSingleLookUnfold's `tbody` is exactly tInner.
    ComputeTrSingleLookUnfold(rer, lk_o, L.LookaroundR(lk_i, tr1), inp);
    assert t == LT.LK(lk_o, tInner, LT.Match);            // outer LkResult Some arm
    assert LG.Find(g, LG.Empty) == None;
    assert LT.TreeRes(t, LG.Empty, inp, WP.Forward).Some?;   // node Some: sub Some & cont Match Some
    TreeResLkNodeGValueFresh(lk_o, tInner, LT.Match, LG.Empty, inp, WP.Forward, g);
    // TreeResLkNodeGValueFresh: outer leaf at g == tInner leaf at LkDir(lk_o) == Forward.
    assert LG.Find(g, LT.TreeRes(t, LG.Empty, inp, WP.Forward).value.1)
        == LG.Find(g, LT.TreeRes(tInner, LG.Empty, inp, WP.Forward).value.1);
  }

  /** R30b (2b) chain shape: `r` is a LINEAR nest of POSITIVE forward lookaheads
      down to a look-free core — every layer is `LookaroundR(lk, body)` with `lk`
      a positive lookAHEAD (`LkDir == Forward`) and `body` EITHER look-free
      (`NoLkBrL`, the innermost core) OR itself such a chain. This is the fragment
      on which the depth-k owner descent is a straight iteration of the atomic
      layer peel — no branching regex structure (con/alt/quant) between the looks,
      so `ComputeTr` of each layer is EXACTLY `ComputeTrSingleLookUnfold`'s single
      `LK` node and the input never advances (each look re-anchors at `inp`). */
  ghost predicate FwdLookChain(r: L.Regex)
    decreases r
  {
    match r
    case LookaroundR(lk, r1) =>
      L.Positivity(lk) && L.LkDir(lk) == WP.Forward
      && (EL.NoLkBrL(r1) || FwdLookChain(r1))
    case _ => false
  }

  /** The look-free core at the bottom of a `FwdLookChain` — the body of the
      INNERMOST look, which owns any capture `g` recorded on the chain. */
  ghost function InnermostChainCore(r: L.Regex): L.Regex
    requires FwdLookChain(r)
    decreases r
  {
    match r
    case LookaroundR(lk, r1) => if EL.NoLkBrL(r1) then r1 else InnermostChainCore(r1)
    case _ => r
  }

  /** R30b (2b) GENERAL DEPTH-k (linear positive-lookahead chain): the depth-k
      analogue of `SingleLookOuterLeafIsOwnerBody`/`DoubleLookOuterLeafIsOwnerBody`,
      proven by INDUCTION on the chain (measure: the regex term, equivalently
      `NestDepth`). For a `FwdLookChain`, once the whole chain matches
      (`TreeRes(t) Some` — which forces every nested look on the winning path to
      have matched), the OUTER body-tree's leaf value at ANY `g` equals the
      INNERMOST owner core body tree `ComputeTr([Areg(core)], inp, Empty,
      Forward)`'s OWN (Empty-map) sub-result at `g`, at the shared position `inp`.
      Each inductive step: `ComputeTrSingleLookUnfold` unfolds the current look to
      `LK(lk, tbody, Match)` (the match hypothesis rules out `LKFail`), the IH ties
      `tbody`'s leaf at `g` to the core's, and `TreeResLkNodeGValueFresh` peels the
      layer — the SAME two-hop composition as the depth-3 case, iterated to the
      bottom of the chain. This is the general owner↔tree correspondence on the
      linear-nesting sub-fragment; the remaining gap to ARBITRARY body structure
      (looks in con/alt/quant, i.e. an owner several regex-nodes deep) is exactly
      the regex-tracking navigation of the abstract `TreeResGOwnerFresh` descent —
      identifying its landed `tsub` with the compiled owner body — documented as
      the open general step. */
  lemma ChainOuterLeafIsOwnerBody(rer: LW.RegExpRecord, chain: L.Regex, inp: LC.Input, g: LG.GroupId)
    requires EL.PikeLkRegexRec(chain)
    requires FwdLookChain(chain)
    requires LT.TreeRes(LFU.ComputeTr(rer, [LS.Areg(chain)], inp, LG.Empty, WP.Forward),
                        LG.Empty, inp, WP.Forward).Some?
    ensures var t := LFU.ComputeTr(rer, [LS.Areg(chain)], inp, LG.Empty, WP.Forward);
            var tcore := LFU.ComputeTr(rer, [LS.Areg(InnermostChainCore(chain))], inp, LG.Empty, WP.Forward);
            LT.TreeRes(tcore, LG.Empty, inp, WP.Forward).Some?
            && LG.Find(g, LT.TreeRes(t, LG.Empty, inp, WP.Forward).value.1)
               == LG.Find(g, LT.TreeRes(tcore, LG.Empty, inp, WP.Forward).value.1)
    decreases chain
  {
    var lk := chain.lk;
    var r1 := chain.r;
    assert chain == L.LookaroundR(lk, r1);
    assert L.Positivity(lk) && L.LkDir(lk) == WP.Forward;

    var t := LFU.ComputeTr(rer, [LS.Areg(chain)], inp, LG.Empty, WP.Forward);
    var tbody := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));   // == Forward

    // ---- unfold THIS look: TreeRes Some rules out LKFail, so t == LK(lk,tbody,Match)
    ComputeTrSingleLookUnfold(rer, lk, r1, inp);
    if LS.LkResult(lk, tbody, LG.Empty, inp).None? {
      assert t == LT.LKFail(lk, tbody);
      assert LT.TreeRes(t, LG.Empty, inp, WP.Forward).None?;   // contradiction with hypothesis
      assert false;
    }
    assert t == LT.LK(lk, tbody, LT.Match);
    assert LT.TreeRes(tbody, LG.Empty, inp, WP.Forward).Some?;    // LkResult Some (positive, LkDir Forward)

    var tcore := LFU.ComputeTr(rer, [LS.Areg(InnermostChainCore(chain))], inp, LG.Empty, WP.Forward);

    if EL.NoLkBrL(r1) {
      // base: r1 IS the innermost core; peel one layer.
      assert InnermostChainCore(chain) == r1;
      assert tcore == tbody;
      TreeResLkNodeGValueFresh(lk, tbody, LT.Match, LG.Empty, inp, WP.Forward, g);
    } else {
      // recurse: r1 is itself a chain; the IH ties tbody's leaf to the core's.
      assert FwdLookChain(r1);
      assert EL.PikeLkRegexRec(r1);                            // outer positive => body recurses
      assert InnermostChainCore(chain) == InnermostChainCore(r1);
      ChainOuterLeafIsOwnerBody(rer, r1, inp, g);              // on ComputeTr([Areg(r1)],..) == tbody
      assert LT.TreeRes(tcore, LG.Empty, inp, WP.Forward).Some?;
      assert LG.Find(g, LT.TreeRes(tbody, LG.Empty, inp, WP.Forward).value.1)
          == LG.Find(g, LT.TreeRes(tcore, LG.Empty, inp, WP.Forward).value.1);
      // peel THIS layer: outer leaf at g == tbody leaf at g (LkDir(lk) == Forward).
      TreeResLkNodeGValueFresh(lk, tbody, LT.Match, LG.Empty, inp, WP.Forward, g);
    }
  }

  /** R30b (2b) REGEX-level chain: the RegElk-`regex` preimage of `FwdLookChain`.
      `body` is a linear nest of POSITIVE lookAHEADs (`Re_lookaround(_, Lookahead,
      _)`, which `Translate`s to a positive forward Linden look) down to a
      look-free core. */
  ghost predicate FwdLookChainRE(body: R.regex)
    decreases body
  {
    match body
    case Re_lookaround(lid, la, r1) =>
      la.Lookahead? && (NR.LookFreeRE(r1) || FwdLookChainRE(r1))
    case _ => false
  }

  /** The look-free core (innermost look's body) of a `FwdLookChainRE`. This is
      exactly `NI.LookBodyOfRE(body, innermost-owner-lid)` (the lid bookkeeping is
      pure structural recursion), i.e. the compiled owner body the engine replays. */
  ghost function InnermostChainCoreRE(body: R.regex): (core: R.regex)
    requires T.TransWf(body) && FwdLookChainRE(body)
    ensures T.TransWf(core)
    decreases body
  {
    match body
    case Re_lookaround(lid, la, r1) => if NR.LookFreeRE(r1) then r1 else InnermostChainCoreRE(r1)
    case _ => body
  }

  /** R30b (2b) TRANSLATE BRIDGE: a `FwdLookChainRE` regex translates to a
      `FwdLookChain` Linden regex, and the Linden chain's innermost core is the
      TRANSLATE of the regex chain's core. So the abstract `ChainOuterLeafIsOwner
      Body` core IS the compiled owner body `Translate(InnermostChainCoreRE(body))`.
      Structural induction following the two chain definitions; the look-free base
      uses `EL.TranslateNoLkBr` (`LookFreeRE ==> NoLkBrL(Translate)`), the recursive
      step uses that `Translate` of a lookaround is a `LookaroundR` node (so
      `NoLkBrL(Translate(r1)) == false`, matching the recursion arm). */
  lemma TranslateFwdLookChain(body: R.regex)
    requires T.TransWf(body)
    requires FwdLookChainRE(body)
    ensures FwdLookChain(T.Translate(body))
    ensures InnermostChainCore(T.Translate(body)) == T.Translate(InnermostChainCoreRE(body))
    decreases body
  {
    match body
    case Re_lookaround(lid, la, r1) =>
      assert la.Lookahead?;
      assert T.Translate(body) == L.LookaroundR(L.LookAhead, T.Translate(r1));   // TrLookaround(Lookahead)
      assert L.Positivity(L.LookAhead) && L.LkDir(L.LookAhead) == WP.Forward;
      if NR.LookFreeRE(r1) {
        EL.TranslateNoLkBr(r1);                       // NoLkBrL(Translate(r1))
        assert InnermostChainCoreRE(body) == r1;
      } else {
        assert FwdLookChainRE(r1);
        assert r1.Re_lookaround?;                     // FwdLookChainRE false off lookaround
        assert !EL.NoLkBrL(T.Translate(r1));          // Translate(lookaround) == LookaroundR
        TranslateFwdLookChain(r1);
        assert InnermostChainCoreRE(body) == InnermostChainCoreRE(r1);
      }
  }

  /** R30b (2b) COMPILED-OWNER-BODY IDENTITY (linear fragment, headline of brick B):
      restates `ChainOuterLeafIsOwnerBody` for a `body: R.regex`, pinning the core
      to the actual compiled INNERMOST-OWNER body `Translate(InnermostChainCoreRE
      (body))` — the exact tree the engine replays for the owner look. This is the
      "landed-owner-subtree == compiled-owner-body" correspondence, at ARBITRARY
      nesting depth, on the linear positive-lookahead-chain sub-fragment. */
  lemma ChainOuterLeafIsCompiledOwnerBody(rer: LW.RegExpRecord, body: R.regex, inp: LC.Input, g: LG.GroupId)
    requires T.TransWf(body)
    requires FwdLookChainRE(body)
    requires EL.PikeLkRegexRec(T.Translate(body))
    requires LT.TreeRes(LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, LG.Empty, WP.Forward),
                        LG.Empty, inp, WP.Forward).Some?
    ensures var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, LG.Empty, WP.Forward);
            var obody := T.Translate(InnermostChainCoreRE(body));
            var tcore := LFU.ComputeTr(rer, [LS.Areg(obody)], inp, LG.Empty, WP.Forward);
            LT.TreeRes(tcore, LG.Empty, inp, WP.Forward).Some?
            && LG.Find(g, LT.TreeRes(t, LG.Empty, inp, WP.Forward).value.1)
               == LG.Find(g, LT.TreeRes(tcore, LG.Empty, inp, WP.Forward).value.1)
  {
    TranslateFwdLookChain(body);
    ChainOuterLeafIsOwnerBody(rer, T.Translate(body), inp, g);
    // ChainOuterLeafIsOwnerBody's core == InnermostChainCore(Translate(body))
    //                                   == Translate(InnermostChainCoreRE(body)).
  }

  /** L4 BOUNDARY (machine-checked): the depth-1 lookbehind fragment caps nesting
      depth at 1 — every lookaround leaf's body is look-free (`NestDepth == 0` by
      `LookFreePlusIsNestedRE`), so `1 + 0` is the deepest a node reaches. This
      pins down WHY the `NestedFragmentRE` swap alone cannot lift `BodyTreeAtCp` /
      `LkReplayMatchesSpec` to genuine nesting: those lemmas KEEP the required
      `PSM.StaticOkRE`, which DEFINITIONALLY contains `LookBehindFragmentRE(body)`
      (PikeSimRE.dfy), so any admissible `body` already satisfies `NestDepth <= 1`.
      Lifting to depth >= 2 needs `StaticOkRE` (and the compilation-rep stack it
      wraps: `NfaRepRE`, `PikeLkRegex`, the confinement predicates) generalized to
      the nested fragment first — the ENGINE half, disjoint from this SPEC brick. */
  lemma LookBehindFragmentDepth1(re: R.regex)
    requires NR.LookBehindFragmentRE(re)
    ensures NR.NestDepth(re) <= 1
    decreases re
  {
    match re
    case Re_alt(r1, r2) => LookBehindFragmentDepth1(r1); LookBehindFragmentDepth1(r2);
    case Re_con(r1, r2) => LookBehindFragmentDepth1(r1); LookBehindFragmentDepth1(r2);
    case Re_quant(_, _, _, r1) => LookBehindFragmentDepth1(r1);
    case Re_capture(_, r1) => LookBehindFragmentDepth1(r1);
    case Re_lookaround(lid, la, r1) => NR.LookFreePlusIsNestedRE(r1);   // NestDepth(r1) == 0
    case _ =>
  }

  /** §4b KEYSTONE: the per-lookaround value theorem. For a positive lookAHEAD
      with a look-free body, the engine replay from the main thread's `cap/lk/qt`
      MATCHES the spec `LkResult` on the body's own groups. Composes every §4b
      piece: `ReplayCapIsBodyLeaf` (engine: replay caps agree with the fresh body
      match on `CaptureRegs(body)`, whose `GmOfLive(body,.)` is the body's spec
      first leaf `FirstLeaf(ComputeTr(body,Empty))`), `TranslateNoLkBr` +
      `ComputeTrGmIndepLk` (the main-tree subtree `tlk` at the running gm equals
      the body tree at `Empty`), `ComputeTrNoLK` (`NoLKTree(tlk)`), and
      `TreeResGmFrame` (spec: `LkResult` at the running gm agrees with the leaf
      at `Empty` on the body's `DefGroups`). */
  lemma LkReplayMatchesSpec(
    rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat, ngroups: nat,
    str: string, cp: nat, cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
    cdns: LCdn.cdns, la: R.lookaround, tlk: LT.Tree, gmMain: LG.GroupMap,
    ncap: int, nlook: int, nquant: int)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires NR.LookFreeRE(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires la.Lookahead?
    requires tlk == LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], PIV.InpOfCp(str, cp), gmMain, WP.Forward)
    requires GmAgreeOn(gmMain, LG.Empty, set g | g in L.DefGroups(T.Translate(body)))
    ensures var inp := PIV.InpOfCp(str, cp);
            var ctxc := AI.cp_context(cp, str, LAnc.Forward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
            var S := set g | g in L.DefGroups(T.Translate(body));
            (ra.None? <==> LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).None?)
            && (ra.Some? ==>
                  LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).Some?
                  && rf.Some?
                  && CM.RegsAgreeInside(ra.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body))
                  && GmAgreeOn(LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).value,
                               PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs), S))
  {
    var inp := PIV.InpOfCp(str, cp);
    var S := set g | g in L.DefGroups(T.Translate(body));
    var tr := T.Translate(body);

    // engine: the replay from cap ~ fresh, both == the body's spec first leaf.
    var bestT := ReplayCapIsBodyLeaf(rer, qm, body, bodycode, endl, ngroups, str, cp, cap, lk, qt,
                                     ov, cdns, ncap, nlook, nquant);
    var tEmpty := LFU.ComputeTr(rer, [LS.Areg(tr)], inp, LG.Empty, WP.Forward);
    assert bestT == LT.FirstLeaf(tEmpty, inp);            // from ReplayCapIsBodyLeaf

    // tlk (at gmMain) == tEmpty (at Empty): group-map independence for look-free.
    EL.TranslateNoLkBr(body);                             // NoLkBrL(tr)
    EL.ComputeTrGmIndepLk(rer, tr, inp, gmMain, WP.Forward);
    assert tlk == tEmpty;
    EL.ComputeTrNoLK(rer, tr, inp, LG.Empty, WP.Forward);
    assert EL.NoLKTree(tlk);

    // spec: TreeRes at gmMain agrees with TreeRes at Empty on the body's groups.
    TreeResGmFrame(tlk, gmMain, LG.Empty, inp, WP.Forward, S);
    assert LT.FirstLeaf(tlk, inp) == LT.TreeRes(tlk, LG.Empty, inp, WP.Forward);   // definitional
    assert LT.FirstLeaf(tlk, inp) == bestT;

    // LkResult of a positive lookAHEAD == TreeRes(tlk, gmMain, inp, Forward) folded.
    assert L.Positivity(T.TrLookaround(la)) && L.LkDir(T.TrLookaround(la)) == WP.Forward;
  }

  /** L4 depth-k (ADDITIVE): the per-lookaround value keystone for the NESTED
      fragment. For a positive lookAHEAD whose body may nest positive looks to
      ANY depth (negative bodies stay look-free, `NegLooksLookFreeRE`), the engine
      replay from the main thread's `cap/lk/qt` MATCHES the spec `LkResult` in
      control flow AND on the body's OUTER groups `S := DefGroups(tr) \
      LkBodyGroups(tr)` (the captures NOT sunk inside nested looks). This is the
      composition-reachable depth-k analogue of `LkReplayMatchesSpec`, built on
      the verified nested chain (`ReplayCapIsBodyLeafNested`, the depth-k
      gm-independence `ComputeTrGmIndepLkRec`, and the confinement-free spec
      gm-frame `TreeResGmFrameRec`).

      SCOPE (honest): agreement on the FULL `DefGroups(tr)` — i.e. INCLUDING the
      groups captured inside nested look bodies (`LkBodyGroups(tr)`) — needs the
      depth-k look-capture RECONSTRUCTION (`FLookLoop` generalized off the depth-1
      fragment, run recursively on `NestDepth(body)` with the depth-(k-1) IH and
      `FBuildOracleCorrectAboveNested` supplying the inner columns). That
      reconstruction is the engine-side remaining obligation; it is NOT part of
      this pure composition, exactly as the depth-1 `ReplayCapIsBodyLeafLk`
      boundary noted. */
  lemma LkReplayMatchesSpecNested(
    rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat, ngroups: nat,
    str: string, cp: nat, cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
    cdns: LCdn.cdns, la: R.lookaround, tlk: LT.Tree, gmMain: LG.GroupMap,
    ncap: int, nlook: int, nquant: int)
    requires PSM.StaticOkNestedRE(qm, body, bodycode, endl)
    requires NR.NegLooksLookFreeRE(body)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires la.Lookahead?
    requires tlk == LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], PIV.InpOfCp(str, cp), gmMain, WP.Forward)
    requires GmAgreeOn(gmMain, LG.Empty, set g | g in L.DefGroups(T.Translate(body)))
    ensures var inp := PIV.InpOfCp(str, cp);
            var ctxc := AI.cp_context(cp, str, LAnc.Forward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
            var S := set g | g in L.DefGroups(T.Translate(body)) && g !in LL.LkBodyGroups(T.Translate(body));
            (ra.None? <==> LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).None?)
            && (ra.Some? ==>
                  LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).Some?
                  && rf.Some?
                  && CM.RegsAgreeInside(ra.value.capture_regs, rf.value.capture_regs, PIV.CaptureRegs(body))
                  && GmAgreeOn(LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).value,
                               PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs), S))
  {
    var inp := PIV.InpOfCp(str, cp);
    var Sd := set g | g in L.DefGroups(T.Translate(body));
    var Slk := LL.LkBodyGroups(T.Translate(body));
    var S := set g | g in L.DefGroups(T.Translate(body)) && g !in LL.LkBodyGroups(T.Translate(body));
    var tr := T.Translate(body);

    // engine: replay from cap ~ fresh; both == body spec first leaf OUTSIDE Slk.
    var bestT := ReplayCapIsBodyLeafNested(rer, qm, body, bodycode, endl, ngroups, str, cp, cap, lk, qt,
                                           ov, cdns, ncap, nlook, nquant);
    var tEmpty := LFU.ComputeTr(rer, [LS.Areg(tr)], inp, LG.Empty, WP.Forward);
    // ReplayCapIsBodyLeafNested: bestT.None <==> FirstLeaf(tEmpty).None; when Some,
    // bestT.0 == FirstLeaf(tEmpty).0 and GmAgreeOutside(bestT.1, FirstLeaf(tEmpty).1, Slk).

    // tlk (at gmMain) == tEmpty (at Empty): depth-k group-map independence.
    EL.TranslateFragmentPikeLkRec(body);                 // PikeLkRegexRec(tr)
    EL.ComputeTrGmIndepLkRec(rer, tr, inp, gmMain, WP.Forward);
    assert tlk == tEmpty;
    assert LT.FirstLeaf(tlk, inp) == LT.TreeRes(tlk, LG.Empty, inp, WP.Forward);   // definitional

    // spec: TreeRes at gmMain agrees with TreeRes at Empty on Sd (no confinement).
    TreeResGmFrameRec(tlk, gmMain, LG.Empty, inp, WP.Forward, Sd);

    // LkResult of a positive lookAHEAD == TreeRes(tlk, gmMain, inp, Forward) folded.
    assert L.Positivity(T.TrLookaround(la)) && L.LkDir(T.TrLookaround(la)) == WP.Forward;
  }

  /** L4 depth-k (ADDITIVE): the FULL-`DefGroups` value keystone for a nested
      positive lookAHEAD — the recursion target that EXTENDS `LkReplayMatchesSpecNested`
      (agreement OUTSIDE the inner looks) to agreement on the WHOLE `DefGroups(tr)`,
      i.e. ALSO on the captures recorded INSIDE nested look bodies.

      Stated as the honest COMPOSITION over the partition
      `DefGroups(tr) = (DefGroups(tr) \ LkBodyGroups(tr)) ∪ LkBodyGroups(tr)`: the
      OUTER half is discharged INTERNALLY by `LkReplayMatchesSpecNested`; the INNER
      half (`LkBodyGroups(tr)` — the groups sunk inside nested looks) is the explicit
      reconstruction premise `recon_inner`, whose engine reference is a RECONSTRUCTED
      register bank `(reccap, reclk, recqt)` — the depth-k `FLookLoop` output that
      fills in the inner-look captures the fresh body match `rf` leaves UNSET (a
      lookaround compiles to a single `CheckOracle` leaf, so `rf` never records its
      body's inner-look captures). The companion premise `recon_outer` pins that the
      reconstruction leaves the OUTER groups exactly as `rf` (FLookLoop writes only
      inside looks).

      WHY THE ENGINE REFERENCE IS NOT `rf`: for a body that is itself a single
      capturing look (e.g. `(?=(a))`), `LkBodyGroups(tr) == DefGroups(tr)` and the
      fresh body match `rf` sets NONE of those registers — so `GmOfLive(body, rf, …)`
      disagrees with the spec `LkResult` on exactly the inner groups. The values live
      in the reconstructed bank, which the top-level `FLookLoop` fills via the SEPARATE
      iterations for the inner (higher-id) lids. This is why the full keystone is a
      `FLookLoop`-reconstruction statement, not a fresh-match one.

      The two premises are EXACTLY what the recursive depth-k value lift discharges:
      `recon_outer` from the `FLookLoop` capture frame (`FLookLoopCaptureFrame`
      generalized off look-free bodies), and `recon_inner` by applying THIS keystone
      recursively to each of body's inner looks (`NestDepth(inner body) <
      NestDepth(body)`), bridged spec-side by how an outer body leaf records an inner
      look's own leaf and engine-side by the `FLookLoop` reconstruction merge.
      `ReplayLidCapAgreeFreshNested` + `ReplayCapIsBodyLeafNested` supply the
      per-inner-look replay↔fresh↔leaf tie. At `NestDepth(body) == 0` both premises
      are vacuous (`LkBodyGroups(tr) == {}`), so the full keystone holds
      unconditionally — see `LkReplayMatchesSpecNestedFullBase`. */
  lemma LkReplayMatchesSpecNestedFull(
    rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat, ngroups: nat,
    str: string, cp: nat, cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
    cdns: LCdn.cdns, la: R.lookaround, tlk: LT.Tree, gmMain: LG.GroupMap,
    ncap: int, nlook: int, nquant: int,
    reccap: AReg.Regs, reclk: AReg.Regs, recqt: AReg.Regs)
    requires PSM.StaticOkNestedRE(qm, body, bodycode, endl)
    requires NR.NegLooksLookFreeRE(body)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires la.Lookahead?
    requires tlk == LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], PIV.InpOfCp(str, cp), gmMain, WP.Forward)
    requires GmAgreeOn(gmMain, LG.Empty, set g | g in L.DefGroups(T.Translate(body)))
    // recon_outer: the reconstruction leaves the OUTER groups exactly as the fresh
    // body match (FLookLoop writes registers only inside look bodies).
    requires var ctxc := AI.cp_context(cp, str, LAnc.Forward);
             var rf := AI.FFindMatch(bodycode, str,
                                     AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                   AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
             var Sout := set g | g in L.DefGroups(T.Translate(body)) && g !in LL.LkBodyGroups(T.Translate(body));
             rf.Some? ==>
               GmAgreeOn(PIV.GmOfLive(body, reccap, reclk, recqt),
                         PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs), Sout)
    // recon_inner: on the INNER groups, the reconstruction matches the spec LkResult
    // (discharged by the recursive application to body's inner looks).
    requires var inp := PIV.InpOfCp(str, cp);
             var ctxc := AI.cp_context(cp, str, LAnc.Forward);
             var ra := AI.FFindMatch(bodycode, str,
                                     AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
             ra.Some? ==>
               LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).Some?
               && GmAgreeOn(LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).value,
                            PIV.GmOfLive(body, reccap, reclk, recqt), LL.LkBodyGroups(T.Translate(body)))
    ensures var inp := PIV.InpOfCp(str, cp);
            var ctxc := AI.cp_context(cp, str, LAnc.Forward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
            var Sfull := set g | g in L.DefGroups(T.Translate(body));
            (ra.None? <==> LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).None?)
            && (ra.Some? ==>
                  LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).Some?
                  && GmAgreeOn(LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).value,
                               PIV.GmOfLive(body, reccap, reclk, recqt), Sfull))
  {
    var inp := PIV.InpOfCp(str, cp);
    var ctxc := AI.cp_context(cp, str, LAnc.Forward);
    var tr := T.Translate(body);
    var Sout := set g | g in L.DefGroups(tr) && g !in LL.LkBodyGroups(tr);
    var Slk := LL.LkBodyGroups(tr);
    var Sfull := set g | g in L.DefGroups(tr);
    var ra := AI.FFindMatch(bodycode, str,
                            AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
    var rf := AI.FFindMatch(bodycode, str,
                            AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                          AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
    var lkr := LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp);
    var gmRec := PIV.GmOfLive(body, reccap, reclk, recqt);

    // OUTER half: LkReplayMatchesSpecNested ties LkResult to GmOfLive(body, rf) on Sout,
    // and the None-iff. Its S is exactly Sout.
    LkReplayMatchesSpecNested(rer, qm, body, bodycode, endl, ngroups, str, cp, cap, lk, qt, ov,
                              cdns, la, tlk, gmMain, ncap, nlook, nquant);

    if ra.Some? {
      var gmRf := PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs);
      // From Nested (ra.Some?): rf.Some?, lkr.Some?, and GmAgreeOn(lkr.value, gmRf, Sout).
      assert rf.Some? && lkr.Some?;
      assert GmAgreeOn(lkr.value, gmRf, Sout);       // Nested's outer-groups conclusion
      assert GmAgreeOn(gmRec, gmRf, Sout);           // recon_outer premise (rf.Some?)
      assert GmAgreeOn(lkr.value, gmRec, Slk);       // recon_inner premise (ra.Some?)
      // Union: every g in DefGroups(tr) is either in Slk or in Sout.
      forall g | g in Sfull
        ensures (g in lkr.value <==> g in gmRec) && (g in lkr.value ==> lkr.value[g] == gmRec[g])
      {
        if g in Slk {
          // recon_inner covers g directly.
          assert g in Slk;
        } else {
          assert g in Sout;              // g in DefGroups(tr) and g not in Slk
          // lkr.value ~ gmRf on Sout (Nested) and gmRec ~ gmRf on Sout (recon_outer),
          // so lkr.value ~ gmRec on Sout by transitivity at g.
        }
      }
      assert GmAgreeOn(lkr.value, gmRec, Sfull);
    }
  }

  /** L4 depth-k (ADDITIVE): the BASE case of `LkReplayMatchesSpecNestedFull`. When
      the body is look-free (`NestDepth(body) == 0`), `LkBodyGroups(Translate(body))
      == {}`, so the reconstruction premises are vacuous and the fresh body match
      IS the full reconstruction — the full-`DefGroups` keystone holds
      UNCONDITIONALLY, coinciding with the depth-1 capturing keystone. This anchors
      the depth induction. */
  lemma LkReplayMatchesSpecNestedFullBase(
    rer: LW.RegExpRecord, qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat, ngroups: nat,
    str: string, cp: nat, cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
    cdns: LCdn.cdns, la: R.lookaround, tlk: LT.Tree, gmMain: LG.GroupMap,
    ncap: int, nlook: int, nquant: int)
    requires PSM.StaticOkNestedRE(qm, body, bodycode, endl)
    requires NR.LookFreeRE(body)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov
    requires !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires la.Lookahead?
    requires tlk == LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], PIV.InpOfCp(str, cp), gmMain, WP.Forward)
    requires GmAgreeOn(gmMain, LG.Empty, set g | g in L.DefGroups(T.Translate(body)))
    ensures var inp := PIV.InpOfCp(str, cp);
            var ctxc := AI.cp_context(cp, str, LAnc.Forward);
            var ra := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, cap, lk, qt, 0, ctxc), ov, LAnc.Forward, cdns).0;
            var rf := AI.FFindMatch(bodycode, str,
                                    AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, ctxc), ov, LAnc.Forward, cdns).0;
            var Sfull := set g | g in L.DefGroups(T.Translate(body));
            (ra.None? <==> LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).None?)
            && (ra.Some? ==>
                  LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).Some?
                  && rf.Some?
                  && GmAgreeOn(LS.LkResult(T.TrLookaround(la), tlk, gmMain, inp).value,
                               PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs), Sfull))
  {
    var inp := PIV.InpOfCp(str, cp);
    var tr := T.Translate(body);
    assert T.TransWf(body);                        // from StaticOkNestedRE(qm, body, bodycode, endl)
    // look-free body => no LookaroundR node in Translate(body) => LkBodyGroups empty.
    NR.LookFreeNegLooksLookFree(body);            // NegLooksLookFreeRE(body), for Nested
    LkBodyGroupsEqCapIdsInLooks(body);            // LkBodyGroups(tr) == CapIdsInLooks(body)
    LookFreeCapIdsInLooksEmpty(body);             // CapIdsInLooks(body) == {}
    assert LL.LkBodyGroups(tr) == {};
    // Nested's S = DefGroups \ LkBodyGroups == full DefGroups now.
    assert (set g | g in L.DefGroups(tr) && g !in LL.LkBodyGroups(tr))
        == (set g | g in L.DefGroups(tr));
    LkReplayMatchesSpecNested(rer, qm, body, bodycode, endl, ngroups, str, cp, cap, lk, qt, ov,
                              cdns, la, tlk, gmMain, ncap, nlook, nquant);
  }

  /** A look-free regex captures nothing inside looks: `CapIdsInLooks == {}` (only
      lookaround nodes contribute, and there are none). */
  lemma LookFreeCapIdsInLooksEmpty(re: R.regex)
    requires NR.LookFreeRE(re)
    ensures PIV.CapIdsInLooks(re) == {}
    decreases re
  {
    match re
    case Re_alt(r1, r2) => LookFreeCapIdsInLooksEmpty(r1); LookFreeCapIdsInLooksEmpty(r2);
    case Re_con(r1, r2) => LookFreeCapIdsInLooksEmpty(r1); LookFreeCapIdsInLooksEmpty(r2);
    case Re_quant(_, _, _, r1) => LookFreeCapIdsInLooksEmpty(r1);
    case Re_capture(_, r1) => LookFreeCapIdsInLooksEmpty(r1);
    case _ =>
  }

  /** L3a extension of `OE.LmOfInv`: threads `CapUnique(re)` to derive the two
      capture-side facts the L3a `FLookLoop` frame/value lift ask of each
      matched lookaround (`LookEntryOk` pins the shared body). */
  lemma LmOfInvL3a(re: R.regex, fc: CP.FCompiled, lid: int)
    returns (la: R.lookaround, body: R.regex)
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re)
    requires LTB.LookUnique(re) && LTB.LookTablesOk(re, fc)
    requires PIV.QuantUnique(re) && PIV.CapUnique(re)
    requires lid in OE.LmOf(re)
    ensures T.TransWf(body)
    ensures OE.LmOf(re)[lid] == (T.TrLookaround(la), T.Translate(body))
    ensures LTB.LookEntryOk(fc, lid, la, body)
    ensures (la.Lookahead? || la.Lookbehind? || NR.CaptureFreeRE(body)) && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
    ensures lid >= 0 && (lid as nat) in LTB.LookIds(re)
    ensures PIV.QuantUnique(body)
    ensures forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(re)
    ensures PIV.CapUnique(body)
    ensures PIV.CapIds(body) <= PIV.CapIdsInLooks(re)
    decreases re
  {
    OE.LmOfDom(re);
    // the L1 half of the body facts, from the shared inversion
    la, body := OE.LmOfInv(re, fc, lid);
    // the two capture facts, by a parallel recursion threading CapUnique(re)
    match re
    case Re_alt(r1, r2) =>
      OE.LmOfDom(r1); OE.LmOfDom(r2);
      if lid in OE.LmOf(r2) {
        var la2, body2 := LmOfInvL3a(r2, fc, lid);
        LookEntryBody(fc, lid, la, body, la2, body2);
      } else {
        assert lid in OE.LmOf(r1);
        var la2, body2 := LmOfInvL3a(r1, fc, lid);
        LookEntryBody(fc, lid, la, body, la2, body2);
      }
    case Re_con(r1, r2) =>
      OE.LmOfDom(r1); OE.LmOfDom(r2);
      if lid in OE.LmOf(r2) {
        var la2, body2 := LmOfInvL3a(r2, fc, lid);
        LookEntryBody(fc, lid, la, body, la2, body2);
      } else {
        assert lid in OE.LmOf(r1);
        var la2, body2 := LmOfInvL3a(r1, fc, lid);
        LookEntryBody(fc, lid, la, body, la2, body2);
      }
    case Re_quant(_, _, _, r1) =>
      var la2, body2 := LmOfInvL3a(r1, fc, lid);
      LookEntryBody(fc, lid, la, body, la2, body2);
    case Re_capture(_, r1) =>
      var la2, body2 := LmOfInvL3a(r1, fc, lid);
      LookEntryBody(fc, lid, la, body, la2, body2);
    case Re_lookaround(lid0, la0, r1) =>
      OE.LmOfDom(r1);
      OE.LookFreeLmOfEmpty(r1);
      assert lid == lid0;
      assert body == r1;                      // LookEntryOk pins body == r1
      // CapIdsInLooks(Re_lookaround(_,_,r1)) == CapIds(r1); CapUnique(re) == CapUnique(r1)
      assert PIV.CapIdsInLooks(re) == PIV.CapIds(r1);
      assert PIV.CapUnique(r1);
  }

  /** Two inversions of the SAME lid share a body: `LookEntryOk` forces both to
      equal `fc.f_look_ast[lid]`, so the sub-recursion's capture facts transfer
      to the shared body. */
  lemma LookEntryBody(fc: CP.FCompiled, lid: int, la: R.lookaround, body: R.regex,
                      la2: R.lookaround, body2: R.regex)
    requires LTB.LookEntryOk(fc, lid, la, body) && LTB.LookEntryOk(fc, lid, la2, body2)
    ensures body == body2
  {}

  /** DISTINCT lookaround ids own bodies with DISJOINT capture ids. A body's
      captures sit under exactly one alt/con branch (lookaround bodies are
      look-free, so looks never nest), and `CapUnique` makes sibling branches
      share no ids. The cross-lid half of the value lift's per-body-disjoint
      hypothesis (lifted to registers by `PIV.CaptureRegsDisjoint`). */
  lemma LmOfBodiesDisjoint(re: R.regex, fc: CP.FCompiled, l1: int, l2: int)
    returns (la1: R.lookaround, b1: R.regex, la2: R.lookaround, b2: R.regex)
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re)
    requires LTB.LookUnique(re) && LTB.LookTablesOk(re, fc)
    requires PIV.QuantUnique(re) && PIV.CapUnique(re)
    requires l1 in OE.LmOf(re) && l2 in OE.LmOf(re) && l1 != l2
    ensures LTB.LookEntryOk(fc, l1, la1, b1) && LTB.LookEntryOk(fc, l2, la2, b2)
    ensures PIV.CapIds(b1) * PIV.CapIds(b2) == {}
    // L3a (E2): the quant twin — distinct lids own disjoint QUANT ids too
    // (same split: a body's quants sit under exactly one alt/con branch, and
    // `QuantUnique` makes sibling branches share none).
    ensures PIV.QuantIds(b1) * PIV.QuantIds(b2) == {}
    decreases re
  {
    OE.LmOfDom(re);
    match re
    case Re_alt(r1, r2) =>
      OE.LmOfDom(r1); OE.LmOfDom(r2);
      if l1 in OE.LmOf(r2) && l2 in OE.LmOf(r2) {
        la1, b1, la2, b2 := LmOfBodiesDisjoint(r2, fc, l1, l2);
      } else if l1 in OE.LmOf(r1) && l2 in OE.LmOf(r1) {
        la1, b1, la2, b2 := LmOfBodiesDisjoint(r1, fc, l1, l2);
      } else {
        AltConBodiesSplit(re, r1, r2, fc, l1, l2);
        if l1 in OE.LmOf(r1) {
          assert l2 in OE.LmOf(r2);
          la1, b1 := LmOfInvL3a(r1, fc, l1);
          la2, b2 := LmOfInvL3a(r2, fc, l2);
        } else {
          assert l1 in OE.LmOf(r2) && l2 in OE.LmOf(r1);
          la1, b1 := LmOfInvL3a(r2, fc, l1);
          la2, b2 := LmOfInvL3a(r1, fc, l2);
        }
        PIV.CapIdsSplit(r1); PIV.CapIdsSplit(r2);   // CapIdsInLooks(ri) <= CapIds(ri)
        PIV.QuantIdsSplit(r1); PIV.QuantIdsSplit(r2);   // QuantIdsInLooks(ri) <= QuantIds(ri)
      }
    case Re_con(r1, r2) =>
      OE.LmOfDom(r1); OE.LmOfDom(r2);
      if l1 in OE.LmOf(r2) && l2 in OE.LmOf(r2) {
        la1, b1, la2, b2 := LmOfBodiesDisjoint(r2, fc, l1, l2);
      } else if l1 in OE.LmOf(r1) && l2 in OE.LmOf(r1) {
        la1, b1, la2, b2 := LmOfBodiesDisjoint(r1, fc, l1, l2);
      } else {
        AltConBodiesSplit(re, r1, r2, fc, l1, l2);
        if l1 in OE.LmOf(r1) {
          assert l2 in OE.LmOf(r2);
          la1, b1 := LmOfInvL3a(r1, fc, l1);
          la2, b2 := LmOfInvL3a(r2, fc, l2);
        } else {
          assert l1 in OE.LmOf(r2) && l2 in OE.LmOf(r1);
          la1, b1 := LmOfInvL3a(r2, fc, l1);
          la2, b2 := LmOfInvL3a(r1, fc, l2);
        }
        PIV.CapIdsSplit(r1); PIV.CapIdsSplit(r2);
        PIV.QuantIdsSplit(r1); PIV.QuantIdsSplit(r2);
      }
    case Re_quant(_, _, _, r1) => la1, b1, la2, b2 := LmOfBodiesDisjoint(r1, fc, l1, l2);
    case Re_capture(_, r1) => la1, b1, la2, b2 := LmOfBodiesDisjoint(r1, fc, l1, l2);
    case Re_lookaround(lid0, la0, r1) =>
      OE.LmOfDom(r1);
      OE.LookFreeLmOfEmpty(r1);          // r1 look-free => LmOf(r1) == map[], so LmOf(re) == {lid0}
      assert l1 == lid0 && l2 == lid0;   // both in the singleton dom, contradicting l1 != l2
  }

  /** In an alt/con `re == C(r1, r2)`, `LmOf(re) == LmOf(r1) + LmOf(r2)` with
      DISJOINT domains (LookUnique), so each lid lands in exactly one branch. */
  lemma AltConBodiesSplit(re: R.regex, r1: R.regex, r2: R.regex, fc: CP.FCompiled, l1: int, l2: int)
    requires T.TransWf(re) && LTB.LookUnique(re)
    requires re.Re_alt? || re.Re_con?
    requires re.Re_alt? ==> re == R.Re_alt(r1, r2)
    requires re.Re_con? ==> re == R.Re_con(r1, r2)
    requires l1 in OE.LmOf(re) && l2 in OE.LmOf(re)
    ensures (l1 in OE.LmOf(r1)) <==> (l1 !in OE.LmOf(r2))
    ensures (l2 in OE.LmOf(r1)) <==> (l2 !in OE.LmOf(r2))
    ensures l1 in OE.LmOf(r1) || l1 in OE.LmOf(r2)
    ensures l2 in OE.LmOf(r1) || l2 in OE.LmOf(r2)
  {
    OE.LmOfDom(re); OE.LmOfDom(r1); OE.LmOfDom(r2);
    // LookUnique(C(r1,r2)) => LookIds(r1) * LookIds(r2) == {}
  }

  lemma LookRowsFromTablesL3a(ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code,
                              str: string, ov: LOr.OracleView, cdn: LCdn.cdns,
                              inits: AI.VmState, cap: AReg.Regs, look: AReg.Regs,
                              quant: AReg.Regs, nlook: int, endl: nat,
                              result: Option<AI.Thread>)
    requires T.TransWf(ast) && T.TransWf(re) && re == R.lazy_prefix(ast)
    requires NR.LookBehindFragmentRE(re) && LTB.LookUnique(re) && PIV.QuantUnique(re)
    requires PIV.CapUnique(re)
    requires crv == CP.FFullCompilation(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires nlook == R.max_lookaround(ast) + 1 && look == AReg.init_regs(nlook)
    requires |inits.processed.true_set| == RB.size(code)
             && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              forall l: int :: 1 <= l <= R.max_lookaround(ast)
                               && AReg.get_cp(result.value.look_regs, l).Some? ==>
                                 (l as nat) in LTB.LookIds(re)
                                 && exists la: R.lookaround, body: R.regex ::
                                   LTB.LookEntryOk(crv, l, la, body)
                                   && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
                                   && PIV.CapUnique(body) && PIV.QuantUnique(body)
                                   && PIV.CaptureRegs(body) <= PIV.CaptureRegsSet(PIV.CapIdsInLooks(ast))
                                   && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(ast))
                                   && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body))
    // (E4): every RECORDED look cp names one of re's lids (write confinement)
    ensures result.Some? ==>
              forall l: int :: AReg.get_cp(result.value.look_regs, l).Some? ==>
                                 l >= 0 && (l as nat) in LTB.LookIds(re)
    // distinct matched lids own DISJOINT capture registers
    ensures result.Some? ==>
              forall l1: int, l2: int ::
                1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 != l2
                && AReg.get_cp(result.value.look_regs, l1).Some?
                && AReg.get_cp(result.value.look_regs, l2).Some? ==>
                  PIV.CaptureRegs(VBody(crv, l1)) * PIV.CaptureRegs(VBody(crv, l2)) == {}
  {
    var S: set<int> := set x: nat | x in LTB.LookIds(re) :: x as int;
    // the code only gates on ids `re` actually owns
    forall pc: nat | pc < |code|
      ensures (code[pc].CheckOracle? ==> code[pc].col in S)
              && (code[pc].NegCheckOracle? ==> code[pc].ncl in S)
    {
      assert NR.GetPcRE(code, pc) == Some(code[pc]);
      if pc != endl { PIV.LookCheckIdsRE(re, code, 0, endl, pc); }
    }
    assert CM.LookChecksInside(code, S);
    assert CM.VmLooksAgree(inits, look, S) by {
      assert CM.RegsAgreeOutside(look, look, S);
    }
    CM.FFindMatchLookFrame(code, str, inits, ov, LAnc.Forward, cdn, look, S);

    // the lazy prefix owns no lookaround, so `re`'s ids are `ast`'s
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(pre) == {};
    assert LTB.LookIds(re) == LTB.LookIds(ast);
    assert PIV.QuantUnique(ast) && LTB.LookUnique(ast);
    assert NR.LookBehindFragmentRE(ast);
    assert PIV.CapUnique(ast);              // CapUnique(Re_con(pre, ast)) => CapUnique(ast)
    LTB.FFullCompilationLookOk(ast);
    OE.LmOfDom(ast);
    RL.AInitLaws(nlook);

    if result.Some? {
      forall l: int | 1 <= l <= R.max_lookaround(ast)
                      && AReg.get_cp(result.value.look_regs, l).Some?
        ensures (l as nat) in LTB.LookIds(re)
        ensures exists la: R.lookaround, body: R.regex ::
                  LTB.LookEntryOk(crv, l, la, body)
                  && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
                  && PIV.CapUnique(body) && PIV.QuantUnique(body)
                  && PIV.CaptureRegs(body) <= PIV.CaptureRegsSet(PIV.CapIdsInLooks(ast))
                  && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(ast))
                  && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body))
      {
        assert l in S;
        assert (l as nat) in LTB.LookIds(ast);
        assert (l as nat) in LTB.LookIds(re);
        assert l in OE.LmOf(ast);
        var la, body := LmOfInvL3a(ast, crv, l);
        // CaptureRegs(body) <= CaptureRegsSet(CapIdsInLooks(ast))
        PIV.CaptureRegsIsSet(body);          // CaptureRegs(body) == CaptureRegsSet(CapIds(body))
        PIV.CaptureRegsSetMono(PIV.CapIds(body), PIV.CapIdsInLooks(ast));
      }
      forall l: int | AReg.get_cp(result.value.look_regs, l).Some?
        ensures l >= 0 && (l as nat) in LTB.LookIds(re)
      {
        assert l in S;
        assert (l as nat) in LTB.LookIds(re);
      }
      forall l1: int, l2: int |
        1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 != l2
        && AReg.get_cp(result.value.look_regs, l1).Some?
        && AReg.get_cp(result.value.look_regs, l2).Some?
        ensures PIV.CaptureRegs(VBody(crv, l1)) * PIV.CaptureRegs(VBody(crv, l2)) == {}
      {
        assert l1 in S && l2 in S;
        assert (l1 as nat) in LTB.LookIds(ast) && (l2 as nat) in LTB.LookIds(ast);
        assert l1 in OE.LmOf(ast) && l2 in OE.LmOf(ast);
        var la1, b1, la2, b2 := LmOfBodiesDisjoint(ast, crv, l1, l2);
        assert b1 == VBody(crv, l1) && b2 == VBody(crv, l2);   // LookEntryOk pins bodies
        PIV.CaptureRegsDisjoint(b1, b2);
      }
    }
  }




  /** L3a `FBuildCapture` unfold: purely definitional — the answer IS
      `filter_reset` of the `FLookLoop` result triple. */
  lemma FBuildCaptureUnfoldL3a(crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                               ncap: int, nlook: int, nquant: int,
                               capture: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
                               fmp: (Option<AI.Thread>, LOr.OracleView))
    requires ncap == 2 * R.max_group(crv.f_main_ast) + 2
    requires nlook == R.max_lookaround(crv.f_main_ast) + 1
    requires nquant == R.max_quant(crv.f_main_ast) + 1
    requires capture == AReg.init_regs(ncap)
    requires look == AReg.init_regs(nlook)
    requires quant == AReg.init_regs(nquant)
    requires fmp == AI.FFindMatchPlus(crv.f_main_bc, crv.f_main_ast, crv.f_plus_bc, str, ov,
                                      LAnc.Forward, 0, capture, look, quant, 0, crv.f_main_cdns)
    ensures fmp.0.None? ==> AI.FBuildCapture(crv, str, ov).0 == None
    ensures fmp.0.Some? ==>
              var thread := fmp.0.value;
              var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(crv.f_main_ast),
                                      thread.capture_regs, thread.look_regs, thread.quant_regs, fmp.1);
              AI.FBuildCapture(crv, str, ov).0
              == Some(AI.filter_reset(crv.f_main_ast, res.0, res.1, res.2, -1))
  {
  }

  // The Some-branch extraction, as its own verification unit (the parent
  // times out with it inlined).
  /** The `Some`-result half of `MainTheorem`, isolated as its own lemma
      because the combined proof times out. Shows the engine's filtered
      capture array and the spec's first-leaf `GroupMap` denote the same
      `MatcherSpec` answer, via leaf-closedness (`FirstLeafClosed`), the
      live/plain equivalence (`PIV.GmOfLiveEqGmOf`), and the capture-array
      bridge (`PIV.GmOfCapArrayBridge`). */

  /** `NoPosLookbehindRE` translates to FORWARD-only positive looks on the L side
      (`TrLookaround` maps Lookahead to a forward positive look; the negatives are
      not positive). Feeds `FirstLeafClosedRec`'s scope. */
  lemma NoPosLookbehindFwdPosL(re: R.regex)
    requires T.TransWf(re)
    requires NoPosLookbehindRE(re)
    ensures FwdPosLooksL(T.Translate(re))
    decreases re
  {
    match re
    case Re_alt(r1, r2) => NoPosLookbehindFwdPosL(r1); NoPosLookbehindFwdPosL(r2);
    case Re_con(r1, r2) => NoPosLookbehindFwdPosL(r1); NoPosLookbehindFwdPosL(r2);
    case Re_quant(_, _, _, r1) => NoPosLookbehindFwdPosL(r1);
    case Re_capture(_, r1) => NoPosLookbehindFwdPosL(r1);
    case Re_lookaround(lid, la, r1) =>
      NoPosLookbehindFwdPosL(r1);
      assert !la.Lookbehind?;
    case _ =>
  }

  /** (L5 F7e-2) THE EXTRACTION with the leaf's CLOSEDNESS as the
      hypothesis instead of the L4 scope — the scope fed only `FirstLeafClosedRec`.
      Shared by the L4 wrapper below and the L5 twin (LiftSim `MainExtractionL5`,
      closedness from the L5 ladder `LindenElkFlipClosed.FirstLeafClosedRecL5`). */
  lemma MainExtractionFromClosed(raw: R.raw_regex, str: string,
                                 t: LT.Tree, thread: AI.Thread, leaf: LT.Leaf)
    requires NR.NestedFragmentRaw(raw)
    requires ClosedGm(leaf.1)                                   // (L5 F7e-2) closedness IS the scope's only use
    requires NR.NegLooksLookFreeRE(R.lazy_prefix(R.annotate(raw)))
    requires T.Latin1Wf(raw)
    requires EL.BoolTreeLk(LES.TheRer(raw), [LS.Areg(LES.SpecRegex(raw))], LC.InitInput(str), BS.CannotExit, t)
    requires LS.IsTree(LES.TheRer(raw), [LS.Areg(LES.SpecRegex(raw))], LC.InitInput(str), LG.Empty, WP.Forward, t)
    requires CM.ThreadRegsWf(thread, 2 * R.max_group(R.annotate(raw)) + 2,
                             R.max_lookaround(R.annotate(raw)) + 1,
                             R.max_quant(R.annotate(raw)) + 1)
    requires QuantRegsFinal(thread)
    // L3b: for a CAPTURING lookbehind the engine registers hold the REVERSED span,
    // so the ordered spec leaf is the POSITIONAL normalization (`NormGm`) of the
    // reconstructed `GmOfLive`. NO-OP for forward matches (`NormGm` is identity on
    // ordered ranges), so this subsumes the old `leaf.1 == GmOfLive`.
    requires var re := R.lazy_prefix(R.annotate(raw));
             leaf.1 == PIV.NormGm(PIV.GmOfLive(re, thread.capture_regs, thread.look_regs, thread.quant_regs))
    requires LT.FirstLeaf(t, LC.InitInput(str)) == Some(leaf)
    requires AI.FFullMatch(raw, str)
          == Some(AI.filter_reset(R.annotate(raw), thread.capture_regs, thread.look_regs,
                                  thread.quant_regs, -1))
    ensures LES.MatcherSpec(raw, str, LES.Normalize(AI.FFullMatch(raw, str)))
  {
    hide T.TransWf, NR.PlusFragmentRE, NR.LookBehindFragmentRE, NR.CaptureFreeRE, NR.LookFreeRE, NR.LookBehindFragmentRaw, NR.CaptureFreeRaw, NR.LookFreeRaw, EL.PikeLkRegex, EL.LkGateOk, SD.GroupFreeL;
    var ast := R.annotate(raw);
    var re := R.lazy_prefix(ast);
    var rer := LES.TheRer(raw);
    var inp := LC.InitInput(str);
    var ngroups := LES.NGroups(raw);
    var ncap := 2 * R.max_group(ast) + 2;
    T.AnnotateWf(raw);
    NR.SpecRegexNestedFragment(raw);
    var caps := thread.capture_regs;
    var lk := thread.look_regs;
    var qt := thread.quant_regs;
    assert LES.SpecRegex(raw) == T.Translate(re);


    // live == plain denotation on the closed leaf
    var f := AI.filter_reset(re, caps, lk, qt, -1);
    var cc := caps.a_clk;
    PIV.FilterCaptureLen(re, caps.a_cp, cc, lk.a_clk, qt.a_clk, -1);
    assert |f| == |caps.a_cp| == ncap == 2 * ngroups;
    // closedness (item 0): `leaf.1 == NormGm(GmOfLive)` and `NormRange` preserves
    // endIdx.Some?, so every present group of GmOfLive is closed. Needed by BOTH
    // the clock-order forall below AND the closed-match forall. (NO `GmOfLiveEqGmOf`
    // here — that needs the clock order the forall below produces.)
    assert leaf.1 == PIV.NormGm(PIV.GmOfLive(re, caps, lk, qt));            // requires
    assert forall g: LG.GroupId :: g in PIV.GmOfLive(re, caps, lk, qt)
                                   ==> PIV.GmOfLive(re, caps, lk, qt)[g].endIdx.Some? by {
      forall g: LG.GroupId | g in PIV.GmOfLive(re, caps, lk, qt)
        ensures PIV.GmOfLive(re, caps, lk, qt)[g].endIdx.Some?
      {
        assert g in leaf.1;                               // NormGm preserves keys
        assert leaf.1[g] == PIV.NormRange(PIV.GmOfLive(re, caps, lk, qt)[g]);  // NormGm def at g
        assert leaf.1[g].endIdx.Some?;                    // ClosedGm(leaf.1)
        PIV.NormRangeClosed(PIV.GmOfLive(re, caps, lk, qt)[g]);   // closedness transfers
      }
    }
    forall g: nat | 0 <= g < |f| && AI.get_idx(f, CP.start_reg(g)) >= 0 && AI.get_idx(f, CP.end_reg(g)) >= 0
      ensures AI.get_idx(cc, CP.end_reg(g)) >= AI.get_idx(cc, CP.start_reg(g))
    {
      assert g in PIV.GmOfLive(re, caps, lk, qt);
      assert PIV.GmOfLive(re, caps, lk, qt)[g].endIdx.Some?;
    }
    PIV.GmOfLiveEqGmOf(re, caps, lk, qt);                 // GmOfLive == GmOf (needs the clock order above)
    assert PIV.NormGm(PIV.GmOf(re, caps, lk, qt)) == leaf.1;   // leaf.1 == NormGm(GmOfLive) == NormGm(GmOf)

    // the capture-array bridge
    forall i | 0 <= i < |f| ensures f[i] >= -1 {
      assert AI.get_idx(caps.a_cp, i) >= -1;      // CapRegWf
      PIV.FilterCaptureGeqNeg1Nested(re, caps.a_cp, cc, lk.a_clk, qt.a_clk, -1, i);
      assert AI.get_idx(f, i) == f[i];
    }
    forall g: nat | 0 <= g < ngroups && f[2 * g] >= 0 ensures f[2 * g + 1] >= 0 {
      assert AI.get_idx(f, CP.start_reg(g)) == f[2 * g];
      assert g in PIV.GmOfLive(re, caps, lk, qt);
      assert PIV.GmOfLive(re, caps, lk, qt)[g].endIdx.Some?;
      assert AI.get_idx(f, CP.end_reg(g)) == f[2 * g + 1];
    }
    // item 0 (capturing lookbehind): `f` MAY contain reversed pairs (backward
    // spans). `NormalizeArr` swaps them POSITIONALLY, which is exactly `NormGm` on
    // the `GmOf` read (`GmOfCapArrayBridgeNorm` — no no-reversed-pairs hypothesis),
    // and `leaf.1 == NormGm(GmOfLive) == NormGm(GmOf)`.
    PIV.GmOfCapArrayBridgeNorm(re, caps, lk, qt, inp, ngroups);
    assert LES.NormalizeArr(f)
        == LES.CapArrayOfLeaf((inp, PIV.NormGm(PIV.GmOf(re, caps, lk, qt))), ngroups);
    assert LES.CapArrayOfLeaf((inp, PIV.NormGm(PIV.GmOf(re, caps, lk, qt))), ngroups)
        == LES.CapArrayOfLeaf(leaf, ngroups);

    // the lazy prefix is filter-transparent
    assert AI.get_idx(qt.a_clk, 0) >= -1;         // QuantRegsFinal
    FilterResetLazyPrefix(ast, caps, lk, qt);
    assert AI.filter_reset(ast, caps, lk, qt, -1) == f;

    assert LES.Normalize(AI.FFullMatch(raw, str)) == Some(LES.NormalizeArr(f));
    assert LES.MatcherSpec(raw, str, Some(LES.CapArrayOfLeaf(leaf, ngroups)));
  }

  /** `FConsume` (moving matched blocked threads to active for the next
      position) preserves `VmQuantFinal`. */

  lemma MainExtraction(raw: R.raw_regex, str: string,
                       t: LT.Tree, thread: AI.Thread, leaf: LT.Leaf)
    requires NR.LookBehindFragmentRaw(raw)
    requires T.Latin1Wf(raw)
    requires EL.BoolTreeLk(LES.TheRer(raw), [LS.Areg(LES.SpecRegex(raw))], LC.InitInput(str), BS.CannotExit, t)
    requires LS.IsTree(LES.TheRer(raw), [LS.Areg(LES.SpecRegex(raw))], LC.InitInput(str), LG.Empty, WP.Forward, t)
    requires CM.ThreadRegsWf(thread, 2 * R.max_group(R.annotate(raw)) + 2,
                             R.max_lookaround(R.annotate(raw)) + 1,
                             R.max_quant(R.annotate(raw)) + 1)
    requires QuantRegsFinal(thread)
    // L3b: for a CAPTURING lookbehind the engine registers hold the REVERSED span,
    // so the ordered spec leaf is the POSITIONAL normalization (`NormGm`) of the
    // reconstructed `GmOfLive`. NO-OP for forward matches (`NormGm` is identity on
    // ordered ranges), so this subsumes the old `leaf.1 == GmOfLive`.
    requires var re := R.lazy_prefix(R.annotate(raw));
             leaf.1 == PIV.NormGm(PIV.GmOfLive(re, thread.capture_regs, thread.look_regs, thread.quant_regs))
    requires LT.FirstLeaf(t, LC.InitInput(str)) == Some(leaf)
    requires AI.FFullMatch(raw, str)
          == Some(AI.filter_reset(R.annotate(raw), thread.capture_regs, thread.look_regs,
                                  thread.quant_regs, -1))
    ensures LES.MatcherSpec(raw, str, LES.Normalize(AI.FFullMatch(raw, str)))
  {
    hide T.TransWf, NR.PlusFragmentRE, NR.LookBehindFragmentRE, NR.CaptureFreeRE, NR.LookFreeRE, NR.LookBehindFragmentRaw, NR.CaptureFreeRaw, NR.LookFreeRaw, EL.PikeLkRegex, EL.LkGateOk, SD.GroupFreeL;
    var ast := R.annotate(raw);
    var re := R.lazy_prefix(ast);
    var rer := LES.TheRer(raw);
    var inp := LC.InitInput(str);
    var ngroups := LES.NGroups(raw);
    var ncap := 2 * R.max_group(ast) + 2;
    T.AnnotateWf(raw);
    NR.SpecRegexLookBehindFragment(raw);
    var caps := thread.capture_regs;
    var lk := thread.look_regs;
    var qt := thread.quant_regs;
    assert LES.SpecRegex(raw) == T.Translate(re);

    // closedness of the leaf gm
    assert LT.TreeRes(t, LG.Empty, inp, WP.Forward) == Some(leaf);
    assert OpenOf(LG.Empty) <= PendingCloses([LS.Areg(T.Translate(re))]);
    EL.TranslateFragmentPikeLk(re);
    assert EL.PikeLkActions([LS.Areg(T.Translate(re))]) by {
      assert [LS.Areg(T.Translate(re))] == [LS.Areg(T.Translate(re))] + [];
      assert EL.PikeLkActions([]);
      EL.PikeLkActionsConsIff(LS.Areg(T.Translate(re)), []);
    }
    assert LkClosedInGm(LG.Empty, [LS.Areg(T.Translate(re))]);   // Empty has no groups
    SpecRegexOuterLkDisjoint(raw);   // also ensures NoDupSeq(L.DefGroups(SpecRegex(raw)))
    assert T.Translate(re) == LES.SpecRegex(raw);
    assert OuterLkDisjoint([LS.Areg(T.Translate(re))]);
    assert NoDupRegsActs([LS.Areg(T.Translate(re))]) by { assert NoDupSeq(L.DefGroups(T.Translate(re))); }
    assert TRM.GmInBounds(LG.Empty, |inp.pref| + |inp.next|);   // Empty has no ranges
    FirstLeafClosed(rer, [LS.Areg(T.Translate(re))], inp, BS.CannotExit, t, LG.Empty, leaf);
    assert ClosedGm(leaf.1);

    // live == plain denotation on the closed leaf
    var f := AI.filter_reset(re, caps, lk, qt, -1);
    var cc := caps.a_clk;
    PIV.FilterCaptureLen(re, caps.a_cp, cc, lk.a_clk, qt.a_clk, -1);
    assert |f| == |caps.a_cp| == ncap == 2 * ngroups;
    // closedness (item 0): `leaf.1 == NormGm(GmOfLive)` and `NormRange` preserves
    // endIdx.Some?, so every present group of GmOfLive is closed. Needed by BOTH
    // the clock-order forall below AND the closed-match forall. (NO `GmOfLiveEqGmOf`
    // here — that needs the clock order the forall below produces.)
    assert leaf.1 == PIV.NormGm(PIV.GmOfLive(re, caps, lk, qt));            // requires
    assert forall g: LG.GroupId :: g in PIV.GmOfLive(re, caps, lk, qt)
                                   ==> PIV.GmOfLive(re, caps, lk, qt)[g].endIdx.Some? by {
      forall g: LG.GroupId | g in PIV.GmOfLive(re, caps, lk, qt)
        ensures PIV.GmOfLive(re, caps, lk, qt)[g].endIdx.Some?
      {
        assert g in leaf.1;                               // NormGm preserves keys
        assert leaf.1[g] == PIV.NormRange(PIV.GmOfLive(re, caps, lk, qt)[g]);  // NormGm def at g
        assert leaf.1[g].endIdx.Some?;                    // ClosedGm(leaf.1)
        PIV.NormRangeClosed(PIV.GmOfLive(re, caps, lk, qt)[g]);   // closedness transfers
      }
    }
    forall g: nat | 0 <= g < |f| && AI.get_idx(f, CP.start_reg(g)) >= 0 && AI.get_idx(f, CP.end_reg(g)) >= 0
      ensures AI.get_idx(cc, CP.end_reg(g)) >= AI.get_idx(cc, CP.start_reg(g))
    {
      assert g in PIV.GmOfLive(re, caps, lk, qt);
      assert PIV.GmOfLive(re, caps, lk, qt)[g].endIdx.Some?;
    }
    PIV.GmOfLiveEqGmOf(re, caps, lk, qt);                 // GmOfLive == GmOf (needs the clock order above)
    assert PIV.NormGm(PIV.GmOf(re, caps, lk, qt)) == leaf.1;   // leaf.1 == NormGm(GmOfLive) == NormGm(GmOf)

    // the capture-array bridge
    forall i | 0 <= i < |f| ensures f[i] >= -1 {
      assert AI.get_idx(caps.a_cp, i) >= -1;      // CapRegWf
      PIV.FilterCaptureGeqNeg1(re, caps.a_cp, cc, lk.a_clk, qt.a_clk, -1, i);
      assert AI.get_idx(f, i) == f[i];
    }
    forall g: nat | 0 <= g < ngroups && f[2 * g] >= 0 ensures f[2 * g + 1] >= 0 {
      assert AI.get_idx(f, CP.start_reg(g)) == f[2 * g];
      assert g in PIV.GmOfLive(re, caps, lk, qt);
      assert PIV.GmOfLive(re, caps, lk, qt)[g].endIdx.Some?;
      assert AI.get_idx(f, CP.end_reg(g)) == f[2 * g + 1];
    }
    // item 0 (capturing lookbehind): `f` MAY contain reversed pairs (backward
    // spans). `NormalizeArr` swaps them POSITIONALLY, which is exactly `NormGm` on
    // the `GmOf` read (`GmOfCapArrayBridgeNorm` — no no-reversed-pairs hypothesis),
    // and `leaf.1 == NormGm(GmOfLive) == NormGm(GmOf)`.
    PIV.GmOfCapArrayBridgeNorm(re, caps, lk, qt, inp, ngroups);
    assert LES.NormalizeArr(f)
        == LES.CapArrayOfLeaf((inp, PIV.NormGm(PIV.GmOf(re, caps, lk, qt))), ngroups);
    assert LES.CapArrayOfLeaf((inp, PIV.NormGm(PIV.GmOf(re, caps, lk, qt))), ngroups)
        == LES.CapArrayOfLeaf(leaf, ngroups);

    // the lazy prefix is filter-transparent
    assert AI.get_idx(qt.a_clk, 0) >= -1;         // QuantRegsFinal
    FilterResetLazyPrefix(ast, caps, lk, qt);
    assert AI.filter_reset(ast, caps, lk, qt, -1) == f;

    assert LES.Normalize(AI.FFullMatch(raw, str)) == Some(LES.NormalizeArr(f));
    assert LES.MatcherSpec(raw, str, Some(LES.CapArrayOfLeaf(leaf, ngroups)));
  }

  /** `FConsume` (moving matched blocked threads to active for the next
      position) preserves `VmQuantFinal`. */
  lemma FConsumeQuantFinal(s: AI.VmState)
    requires VmQuantFinal(s)
    ensures VmQuantFinal(AI.FConsume(s))
    decreases |s.blocked|
  {
    if |s.blocked| == 0 { return; }
    var t := s.blocked[0].0;
    var ce := s.blocked[0].1;
    var s1 := s.(blocked := s.blocked[1..]);
    assert s.blocked[0] in s.blocked;
    assert forall x | x in s1.blocked :: x in s.blocked;
    var s2 := if RC.is_accepted(s1.context.nextchar, ce)
    then s1.(active := [t.(exit_allowed := true, pc := t.pc + 1)] + s1.active)
    else s1;
    assert VmQuantFinal(s2) by {
      forall t2 | t2 in s2.active ensures QuantRegsFinal(t2) {
        if t2 != t.(exit_allowed := true, pc := t.pc + 1) { assert t2 in s.active; }
        else { assert QuantRegsFinal(t); }
      }
      forall tb | tb in s2.blocked ensures QuantRegsFinal(tb.0) {
        assert tb in s.blocked;
      }
    }
    FConsumeQuantFinal(s2);
  }

  /** R1 #4 (VBody bridge): the table-view body `VBody(crv, l)` is exactly the
      structural body `LookBodyOfRE(r, l)`. `LookTablesOk` records a
      `LookEntryOk` row at every look node (via `NI.LookBodyOfTablesTie`); that
      row pins `crv.f_look_ast[l] == LookBodyOfRE(r, l)` and `0 <= l < |f_look_ast|`,
      so the `VBody` lookup returns exactly that body. */
  lemma VBodyEqLookBody(crv: CP.FCompiled, r: R.regex, l: nat)
    requires LTB.LookTablesOk(r, crv)
    requires l in LTB.LookIds(r)
    ensures VBody(crv, l) == NI.LookBodyOfRE(r, l)
  {
    NI.LookBodyOfTablesTie(r, crv, l);
    var la: R.lookaround :| LTB.LookEntryOk(crv, l as int, la, NI.LookBodyOfRE(r, l));
  }

  // ==========================================================================
  // R2 (L4 depth-k, ADDITIVE): the FLookLoop frame + outer-value-lift brick for
  // NESTED bodies. A nested body compiles its inner looks to single CheckOracle
  // leaves (no SetRegisterToCP inside), so a replay of the body's own bytecode
  // writes captures only to the body's OUTER (directly-captured, outside-look)
  // registers -- exactly `CaptureRegsSet(CapIdsOutsideLooks(body))`. These
  // fragment-AGNOSTIC capture-write frames (they need only `NfaRepRE` + the
  // capture-id shape, never `LookBehindFragmentRE`) mirror
  // `PIV.CaptureWriteIdsOutsideRE`/`*MinRE`/`*OptRE` verbatim; the sole change is
  // dropping the fragment hypothesis so a NESTED body's compiled block is
  // covered. The lookaround case is trivial (a single CheckOracle leaf is not a
  // SetRegisterToCP), so nothing in the recursion inspects the body of a look.
  // ==========================================================================

  /** Fragment-agnostic twin of `PIV.CaptureWriteIdsOutsideRE`: for ANY `re`
      whose compiled block is `NfaRepRE(re, code, start, endl)` with distinct
      capture ids, every `SetRegisterToCP` in `[start, endl)` targets one of
      `re`'s OUTSIDE-look capture registers. Verbatim structural recursion; the
      `Re_lookaround` case is empty. */
  lemma CaptureWriteIdsOutsideREGen(re: R.regex, code: RB.code, start: nat, endl: nat, pc: nat)
    requires PIV.CapUnique(re)
    requires NR.NfaRepRE(re, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.SetRegisterToCP? ==>
              NR.GetPcRE(code, pc).value.reg in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re))
    decreases CP.rsize(re), 1
  {
    match re
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
    case Re_lookaround(_, _, _) =>
    case Re_alt(r1, r2) =>
      var e1: nat :| NR.GetPcRE(code, start) == Some(RB.Fork(start + 1, e1 + 1))
                     && NR.NfaRepRE(r1, code, start + 1, e1)
                     && NR.GetPcRE(code, e1) == Some(RB.Jmp(endl))
                     && NR.NfaRepRE(r2, code, e1 + 1, endl);
      NR.NfaRepIncrRE(r1, code, start + 1, e1);
      NR.NfaRepIncrRE(r2, code, e1 + 1, endl);
      if pc == start {
      } else if pc < e1 {
        CaptureWriteIdsOutsideREGen(r1, code, start + 1, e1, pc);
        PIV.CaptureRegsSetMono(PIV.CapIdsOutsideLooks(r1), PIV.CapIdsOutsideLooks(re));
      } else if pc == e1 {
      } else {
        CaptureWriteIdsOutsideREGen(r2, code, e1 + 1, endl, pc);
        PIV.CaptureRegsSetMono(PIV.CapIdsOutsideLooks(r2), PIV.CapIdsOutsideLooks(re));
      }
    case Re_con(r1, r2) =>
      var e1: nat :| NR.NfaRepRE(r1, code, start, e1) && NR.NfaRepRE(r2, code, e1, endl);
      NR.NfaRepIncrRE(r1, code, start, e1);
      NR.NfaRepIncrRE(r2, code, e1, endl);
      if pc < e1 {
        CaptureWriteIdsOutsideREGen(r1, code, start, e1, pc);
        PIV.CaptureRegsSetMono(PIV.CapIdsOutsideLooks(r1), PIV.CapIdsOutsideLooks(re));
      } else {
        CaptureWriteIdsOutsideREGen(r2, code, e1, endl, pc);
        PIV.CaptureRegsSetMono(PIV.CapIdsOutsideLooks(r2), PIV.CapIdsOutsideLooks(re));
      }
    case Re_capture(cid, r1) =>
      var e1: nat :| NR.GetPcRE(code, start) == Some(RB.SetRegisterToCP(CP.start_reg(cid)))
                     && NR.NfaRepRE(r1, code, start + 1, e1)
                     && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(cid)))
                     && endl == e1 + 1;
      NR.NfaRepIncrRE(r1, code, start + 1, e1);
      assert cid >= 0 && (cid as nat) in PIV.CapIdsOutsideLooks(re);   // CapUnique; Re_capture adds it outside
      if pc == start {
        assert CP.start_reg(cid) in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re));
      } else if pc < e1 {
        CaptureWriteIdsOutsideREGen(r1, code, start + 1, e1, pc);
        PIV.CaptureRegsSetMono(PIV.CapIdsOutsideLooks(r1), PIV.CapIdsOutsideLooks(re));
      } else {
        assert CP.end_reg(cid) in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re));
      }
    case Re_quant(nul, qid, q, r1) =>
      if q.min == 0 && q.max == None {
        var e1: nat :| NR.GetPcRE(code, start) == Some(if q.greedy then RB.Fork(start + 1, e1 + 2) else RB.Fork(e1 + 2, start + 1))
                       && NR.GetPcRE(code, start + 1) == Some(RB.SetQuantToClock(qid, false))
                       && NR.GetPcRE(code, start + 2) == Some(RB.BeginLoop)
                       && NR.NfaRepRE(r1, code, start + 3, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                       && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(start))
                       && endl == e1 + 2;
        NR.NfaRepIncrRE(r1, code, start + 3, e1);
        if pc <= start + 2 {
        } else if pc < e1 {
          CaptureWriteIdsOutsideREGen(r1, code, start + 3, e1, pc);
        } else {
        }
      } else if q.max.Some? {
        var em := NR.NfaRepREQuantInv(nul, qid, q, r1, code, start, endl);
        NR.NfaRepIncrMinRE(q.min as nat, qid, r1, code, start, em);
        NR.NfaRepIncrOptRE((q.max.value - q.min) as nat, q.greedy, qid, r1, code, em, endl);
        if pc < em {
          CaptureWriteIdsOutsideMinREGen(q.min as nat, qid, r1, code, start, em, pc);
        } else {
          CaptureWriteIdsOutsideOptREGen((q.max.value - q.min) as nat, q.greedy, qid, r1, code, em, endl, pc);
        }
      } else {
        var em, e1 := NR.NfaRepREPlusInv(nul, qid, q, r1, code, start, endl);
        NR.NfaRepIncrMinRE((q.min - 1) as nat, qid, r1, code, start, em);
        NR.NfaRepIncrRE(r1, code, em + 1, e1);
        if pc < em {
          CaptureWriteIdsOutsideMinREGen((q.min - 1) as nat, qid, r1, code, start, em, pc);
        } else if pc == em {
        } else if pc < e1 {
          CaptureWriteIdsOutsideREGen(r1, code, em + 1, e1, pc);
        } else {
        }
      }
  }

  lemma CaptureWriteIdsOutsideMinREGen(k: nat, qid: R.quantid, r1: R.regex, code: RB.code, start: nat, endl: nat, pc: nat)
    requires PIV.CapUnique(r1)
    requires NR.NfaRepMinRE(k, qid, r1, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.SetRegisterToCP? ==>
              NR.GetPcRE(code, pc).value.reg in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(r1))
    decreases CP.rsize(r1), k + 2
  {
    if k == 0 { return; }
    var e1: nat :| NR.GetPcRE(code, start) == Some(RB.SetQuantToClock(qid, false))
                   && NR.NfaRepRE(r1, code, start + 1, e1)
                   && NR.NfaRepMinRE(k - 1, qid, r1, code, e1, endl);
    NR.NfaRepIncrRE(r1, code, start + 1, e1);
    NR.NfaRepIncrMinRE(k - 1, qid, r1, code, e1, endl);
    if pc == start {
    } else if pc < e1 {
      CaptureWriteIdsOutsideREGen(r1, code, start + 1, e1, pc);
    } else {
      CaptureWriteIdsOutsideMinREGen(k - 1, qid, r1, code, e1, endl, pc);
    }
  }

  lemma CaptureWriteIdsOutsideOptREGen(k: nat, greedy: bool, qid: R.quantid, r1: R.regex, code: RB.code, start: nat, endl: nat, pc: nat)
    requires PIV.CapUnique(r1)
    requires NR.NfaRepOptRE(k, greedy, qid, r1, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.SetRegisterToCP? ==>
              NR.GetPcRE(code, pc).value.reg in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(r1))
    decreases CP.rsize(r1), k + 2
  {
    if k == 0 { return; }
    var e1: nat :| NR.GetPcRE(code, start) == Some(if greedy then RB.Fork(start + 1, endl) else RB.Fork(endl, start + 1))
                   && NR.GetPcRE(code, start + 1) == Some(RB.SetQuantToClock(qid, false))
                   && NR.GetPcRE(code, start + 2) == Some(RB.BeginLoop)
                   && NR.NfaRepRE(r1, code, start + 3, e1)
                   && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                   && NR.NfaRepOptRE(k - 1, greedy, qid, r1, code, e1 + 1, endl);
    NR.NfaRepIncrRE(r1, code, start + 3, e1);
    NR.NfaRepIncrOptRE(k - 1, greedy, qid, r1, code, e1 + 1, endl);
    if pc <= start + 2 {
    } else if pc < e1 {
      CaptureWriteIdsOutsideREGen(r1, code, start + 3, e1, pc);
    } else if pc == e1 {
    } else {
      CaptureWriteIdsOutsideOptREGen(k - 1, greedy, qid, r1, code, e1 + 1, endl, pc);
    }
  }

  /** R2: nested twin of `CM.CaptureBytecodeClassifiedOutside` — a NESTED body's
      compiled bytecode writes captures only to its OUTSIDE-look registers.
      `NR.CompileToBytecodeRepNested` supplies the `NfaRepRE` (and the `Accept`
      terminator), and `CaptureWriteIdsOutsideREGen` discharges every body pc. */
  lemma CaptureBytecodeClassifiedNestedOuter(body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body)
    ensures CM.CaptureWritesInside(CP.compile_to_bytecode(body),
                                   PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)))
  {
    var code := CP.compile_to_bytecode(body);
    var next := CP.compile(body, 0, CP.Progress).1;
    NR.CompileToBytecodeRepNested(body);
    var endl := next as nat;
    var Sc := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));
    forall pc: nat | pc < |code|
      ensures code[pc].SetRegisterToCP? ==> code[pc].reg in Sc
    {
      assert NR.GetPcRE(code, pc) == Some(code[pc]);
      if pc < endl {
        CaptureWriteIdsOutsideREGen(body, code, 0, endl, pc);
      } else {
        assert pc == endl;
        assert NR.GetPcRE(code, endl) == Some(RB.Accept);
      }
    }
  }

  /** R2: nested twin of `ReplayCaptureFrame`, restricted to OUTER caps. For a
      capturing positive lookAHEAD replay over a NESTED body's compiled block
      (run FORWARD), the `FFindMatch` result's capture bank agrees with `cap`
      OUTSIDE the body's OUTSIDE-look registers `CaptureRegsSet(CapIdsOutside
      Looks(body))`. The inner looks are single CheckOracle leaves (no capture
      writes), so no inner-look register is touched here. Built from the
      outer-caps capture-write classification + `CM.FFindMatchCapWriteFrame`. */
  lemma ReplayCaptureFrameNestedOuter(bytecode: RB.code, str: string, inits: AI.VmState, ov: LOr.OracleView,
                                      dir: LAnc.direction, lookcdn: LCdn.cdns,
                                      cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs,
                                      la: R.lookaround, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires inits.active == [AI.init_thread(cap, lk, qt)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires |inits.processed.true_set| == RB.size(bytecode)
             && |inits.processed.false_set| == RB.size(bytecode)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    ensures var r := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.capture_regs, cap,
                                            PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)))
  {
    var Sc := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));
    CaptureBytecodeClassifiedNestedOuter(body);
    assert CM.VmCapturesAgree(inits, cap, Sc) by {
      assert CM.RegsAgreeOutside(cap, cap, Sc);
    }
    CM.FFindMatchCapWriteFrame(bytecode, str, inits, ov, dir, lookcdn, cap, Sc);
  }

  /** R2: nested twin of `ReplayPlusCaptureFrame`, restricted to OUTER caps. The
      `FFindMatchPlus` capturing lookAHEAD replay over a NESTED body writes its
      capture bank only inside the body's OUTSIDE-look registers. The plus
      reconstruction is the identity on the `QuantRegsFinal` result
      (`FNulledPlusIdentity`, since `NoTrueQuantStampNested` + `FFindMatchQuant
      FinalAny` give a quant-final result), so the `FFindMatchPlus` capture bank
      IS the `FFindMatch` one, which `ReplayCaptureFrameNestedOuter` frames. */
  lemma ReplayPlusCaptureFrameNestedOuter(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                                          lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                          cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires AI.cp_context(cp, str, dir).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.capture_regs, cap,
                                            PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)))
  {
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    ReplayCaptureFrameNestedOuter(bytecode, str, inits, ov, dir, lookcdn, cap, lk, qt, la, body);
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  // ==========================================================================
  // R2 (look-bank side): a NESTED body's replay CROSSES its inner CheckOracle
  // gates and WRITES their look_regs a_cp entries -- so, unlike a look-free
  // body, the look bank does NOT pass through. The tightest true frame is that
  // the replay writes look entries only for the body's OWN look ids
  // (`LTB.LookIds(body)`), leaving every other look (in particular the outer
  // gates set by the main pass) untouched. Built exactly like the capture side:
  // a fragment-agnostic `LookChecksInside` classification + `CM.FFindMatch
  // LookFrame`. `LookCheckIdsREGen` mirrors `PIV.LookCheckIdsRE` with the
  // fragment hypothesis dropped for `NfaRepRE` + `LookUnique`.
  // ==========================================================================

  /** The int-lid image of `body`'s look ids -- the register indices a replay of
      `body` may touch in the look bank. */
  ghost function LookIdSet(body: R.regex): set<int> {
    set l: nat | l in LTB.LookIds(body) :: l as int
  }

  /** Fragment-agnostic twin of `PIV.LookCheckIdsRE`: every `CheckOracle`/
      `NegCheckOracle` in a block representing `re` (`NfaRepRE`) targets one of
      `re`'s own look ids. Verbatim structural recursion; the fragment hypothesis
      is unused (the `Re_lookaround` leaf carries only its own lid). */
  lemma LookCheckIdsREGen(re: R.regex, code: RB.code, start: nat, endl: nat, pc: nat)
    requires LTB.LookUnique(re)
    requires NR.NfaRepRE(re, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.col;
              l >= 0 && (l as nat) in LTB.LookIds(re)
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.NegCheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.ncl;
              l >= 0 && (l as nat) in LTB.LookIds(re)
    decreases CP.rsize(re), 1
  {
    match re
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
    case Re_lookaround(lid, la, r1) =>
      assert pc == start;
      assert lid >= 0;
    case Re_alt(r1, r2) =>
      var e1: nat :| NR.GetPcRE(code, start) == Some(RB.Fork(start + 1, e1 + 1))
                     && NR.NfaRepRE(r1, code, start + 1, e1)
                     && NR.GetPcRE(code, e1) == Some(RB.Jmp(endl))
                     && NR.NfaRepRE(r2, code, e1 + 1, endl);
      NR.NfaRepIncrRE(r1, code, start + 1, e1);
      NR.NfaRepIncrRE(r2, code, e1 + 1, endl);
      if pc == start {
      } else if pc < e1 {
        LookCheckIdsREGen(r1, code, start + 1, e1, pc);
      } else if pc == e1 {
      } else {
        LookCheckIdsREGen(r2, code, e1 + 1, endl, pc);
      }
    case Re_con(r1, r2) =>
      var e1: nat :| NR.NfaRepRE(r1, code, start, e1) && NR.NfaRepRE(r2, code, e1, endl);
      NR.NfaRepIncrRE(r1, code, start, e1);
      NR.NfaRepIncrRE(r2, code, e1, endl);
      if pc < e1 {
        LookCheckIdsREGen(r1, code, start, e1, pc);
      } else {
        LookCheckIdsREGen(r2, code, e1, endl, pc);
      }
    case Re_capture(cid, r1) =>
      var e1: nat :| NR.GetPcRE(code, start) == Some(RB.SetRegisterToCP(CP.start_reg(cid)))
                     && NR.NfaRepRE(r1, code, start + 1, e1)
                     && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(cid)))
                     && endl == e1 + 1;
      NR.NfaRepIncrRE(r1, code, start + 1, e1);
      if pc == start {
      } else if pc < e1 {
        LookCheckIdsREGen(r1, code, start + 1, e1, pc);
      } else {
      }
    case Re_quant(nul, qid, q, r1) =>
      if q.min == 0 && q.max == None {
        var e1: nat :| NR.GetPcRE(code, start) == Some(if q.greedy then RB.Fork(start + 1, e1 + 2) else RB.Fork(e1 + 2, start + 1))
                       && NR.GetPcRE(code, start + 1) == Some(RB.SetQuantToClock(qid, false))
                       && NR.GetPcRE(code, start + 2) == Some(RB.BeginLoop)
                       && NR.NfaRepRE(r1, code, start + 3, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                       && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(start))
                       && endl == e1 + 2;
        NR.NfaRepIncrRE(r1, code, start + 3, e1);
        if pc <= start + 2 {
        } else if pc < e1 {
          LookCheckIdsREGen(r1, code, start + 3, e1, pc);
        } else {
        }
      } else if q.max.Some? {
        var em := NR.NfaRepREQuantInv(nul, qid, q, r1, code, start, endl);
        NR.NfaRepIncrMinRE(q.min as nat, qid, r1, code, start, em);
        NR.NfaRepIncrOptRE((q.max.value - q.min) as nat, q.greedy, qid, r1, code, em, endl);
        if pc < em {
          LookCheckIdsMinREGen(q.min as nat, qid, r1, code, start, em, pc);
        } else {
          LookCheckIdsOptREGen((q.max.value - q.min) as nat, q.greedy, qid, r1, code, em, endl, pc);
        }
      } else {
        var em, e1 := NR.NfaRepREPlusInv(nul, qid, q, r1, code, start, endl);
        NR.NfaRepIncrMinRE((q.min - 1) as nat, qid, r1, code, start, em);
        NR.NfaRepIncrRE(r1, code, em + 1, e1);
        if pc < em {
          LookCheckIdsMinREGen((q.min - 1) as nat, qid, r1, code, start, em, pc);
        } else if pc == em {
        } else if pc < e1 {
          LookCheckIdsREGen(r1, code, em + 1, e1, pc);
        } else {
        }
      }
  }

  lemma LookCheckIdsMinREGen(k: nat, qid: R.quantid, r1: R.regex, code: RB.code, start: nat, endl: nat, pc: nat)
    requires LTB.LookUnique(r1)
    requires NR.NfaRepMinRE(k, qid, r1, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.col;
              l >= 0 && (l as nat) in LTB.LookIds(r1)
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.NegCheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.ncl;
              l >= 0 && (l as nat) in LTB.LookIds(r1)
    decreases CP.rsize(r1), k + 2
  {
    if k == 0 { return; }
    var e1: nat :| NR.GetPcRE(code, start) == Some(RB.SetQuantToClock(qid, false))
                   && NR.NfaRepRE(r1, code, start + 1, e1)
                   && NR.NfaRepMinRE(k - 1, qid, r1, code, e1, endl);
    NR.NfaRepIncrRE(r1, code, start + 1, e1);
    NR.NfaRepIncrMinRE(k - 1, qid, r1, code, e1, endl);
    if pc == start {
    } else if pc < e1 {
      LookCheckIdsREGen(r1, code, start + 1, e1, pc);
    } else {
      LookCheckIdsMinREGen(k - 1, qid, r1, code, e1, endl, pc);
    }
  }

  lemma LookCheckIdsOptREGen(k: nat, greedy: bool, qid: R.quantid, r1: R.regex, code: RB.code, start: nat, endl: nat, pc: nat)
    requires LTB.LookUnique(r1)
    requires NR.NfaRepOptRE(k, greedy, qid, r1, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.col;
              l >= 0 && (l as nat) in LTB.LookIds(r1)
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.NegCheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.ncl;
              l >= 0 && (l as nat) in LTB.LookIds(r1)
    decreases CP.rsize(r1), k + 2
  {
    if k == 0 { return; }
    var e1: nat :| NR.GetPcRE(code, start) == Some(if greedy then RB.Fork(start + 1, endl) else RB.Fork(endl, start + 1))
                   && NR.GetPcRE(code, start + 1) == Some(RB.SetQuantToClock(qid, false))
                   && NR.GetPcRE(code, start + 2) == Some(RB.BeginLoop)
                   && NR.NfaRepRE(r1, code, start + 3, e1)
                   && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                   && NR.NfaRepOptRE(k - 1, greedy, qid, r1, code, e1 + 1, endl);
    NR.NfaRepIncrRE(r1, code, start + 3, e1);
    NR.NfaRepIncrOptRE(k - 1, greedy, qid, r1, code, e1 + 1, endl);
    if pc <= start + 2 {
    } else if pc < e1 {
      LookCheckIdsREGen(r1, code, start + 3, e1, pc);
    } else if pc == e1 {
    } else {
      LookCheckIdsOptREGen(k - 1, greedy, qid, r1, code, e1 + 1, endl, pc);
    }
  }

  /** R2: `LookChecksInside(compile_to_bytecode(body), LookIdSet(body))` for a
      NESTED body -- every gate the replay executes targets one of `body`'s own
      look ids. Nested twin of the capture-side `CaptureBytecodeClassifiedNested
      Outer`, via `LookCheckIdsREGen`. */
  lemma LookBytecodeClassifiedNested(body: R.regex)
    requires NR.NestedFragmentRE(body) && LTB.LookUnique(body)
    ensures CM.LookChecksInside(CP.compile_to_bytecode(body), LookIdSet(body))
  {
    var code := CP.compile_to_bytecode(body);
    var next := CP.compile(body, 0, CP.Progress).1;
    NR.CompileToBytecodeRepNested(body);
    var endl := next as nat;
    var S := LookIdSet(body);
    forall pc: nat | pc < |code|
      ensures (code[pc].CheckOracle? ==> code[pc].col in S)
              && (code[pc].NegCheckOracle? ==> code[pc].ncl in S)
    {
      assert NR.GetPcRE(code, pc) == Some(code[pc]);
      if pc < endl {
        LookCheckIdsREGen(body, code, 0, endl, pc);
      } else {
        assert pc == endl;
        assert NR.GetPcRE(code, endl) == Some(RB.Accept);
      }
    }
  }

  /** R2: the FFindMatchPlus-level look frame for a NESTED positive lookAHEAD
      replay: the result's look bank agrees with the incoming `lk` OUTSIDE the
      body's own look ids `LookIdSet(body)`. So the replay only ADDS inner-look
      a_cp entries (its own gates) and never disturbs any look outside the body
      -- in particular the outer gates the main pass recorded. Structure mirrors
      `ReplayPlusCaptureFrameNestedOuter`: the FFindMatch look frame
      (`LookBytecodeClassifiedNested` + `CM.FFindMatchLookFrame`) plus the plus
      reconstruction identity (`FNulledPlusIdentity` leaves the look bank fixed). */
  lemma ReplayPlusLookFrameNested(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                                  lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                  cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body) && LTB.LookUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires AI.cp_context(cp, str, dir).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.look_regs, lk, LookIdSet(body))
  {
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    LookBytecodeClassifiedNested(body);
    assert CM.VmLooksAgree(inits, lk, LookIdSet(body)) by {
      assert CM.RegsAgreeOutside(lk, lk, LookIdSet(body));
    }
    CM.FFindMatchLookFrame(bytecode, str, inits, ov, dir, lookcdn, lk, LookIdSet(body));
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** recon A: the TIGHT twin of `ReplayPlusLookFrameNested`. The replay's main
      pass `compile_to_bytecode(body)` gates ONLY on `body`'s DIRECT (top-level)
      look ids (`DirectLidClassified`), so the result look bank agrees with the
      incoming `lk` OUTSIDE `DirectLidSet(body)` -- strictly tighter than
      `LookIdSet(body)`. This is the frame that makes the (f) look-stability
      invariant re-establishable at ALL nesting depths: a newly-set look id is a
      DIRECT child of `body`, never a grandchild. Verbatim clone of
      `ReplayPlusLookFrameNested` with `LookBytecodeClassifiedNested`/`LookIdSet`
      replaced by `DirectLidClassified`/`DirectLidSet`. */
  lemma ReplayPlusLookFrameDirectNested(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                                        lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                        cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body) && LTB.LookUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires AI.cp_context(cp, str, dir).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.look_regs, lk, DirectLidSet(body))
  {
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    DirectLidClassified(body);
    assert CM.VmLooksAgree(inits, lk, DirectLidSet(body)) by {
      assert CM.RegsAgreeOutside(lk, lk, DirectLidSet(body));
    }
    CM.FFindMatchLookFrame(bytecode, str, inits, ov, dir, lookcdn, lk, DirectLidSet(body));
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** R2: every look id of `re` has a correct table row, given `re`'s rows are
      all correct (`LookTablesOk`). Lets a body's replay-set inner-look id be
      resolved to a real look entry (with a body in the fragment) so the
      FLookLoop induction can process it downstream. Small structural recursion. */
  lemma LookIdEntryExists(re: R.regex, fc: CP.FCompiled, l: nat)
    requires LTB.LookTablesOk(re, fc)
    requires l in LTB.LookIds(re)
    ensures var li: int := l as int;   // (2026-08-28) cast-free trigger term for the exists
            exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(fc, li, la, body)
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if l in LTB.LookIds(r1) { LookIdEntryExists(r1, fc, l); } else { LookIdEntryExists(r2, fc, l); }
    case Re_con(r1, r2) =>
      if l in LTB.LookIds(r1) { LookIdEntryExists(r1, fc, l); } else { LookIdEntryExists(r2, fc, l); }
    case Re_quant(_, _, _, r1) => LookIdEntryExists(r1, fc, l);
    case Re_capture(_, r1) => LookIdEntryExists(r1, fc, l);
    case Re_lookaround(lid, la, r1) =>
      if l == lid as nat {
        assert LTB.LookEntryOk(fc, lid, la, r1);   // LookTablesOk's lookaround case
      } else {
        assert l in LTB.LookIds(r1);
        LookIdEntryExists(r1, fc, l);
      }
    case Re_empty => case Re_character(_) => case Re_anchor(_) =>
  }

  /** R2: the FULL per-replay frame the NESTED FLookLoop induction consumes, for
      a positive lookAHEAD replay over a NESTED body. Bundles the outer-caps
      capture frame, the own-look-ids look frame, and quant-finality. Nested twin
      of `ReplayPlusFrame` (which for a look-free body got `look_regs == lk`; a
      nested body instead only ADDS its own inner-look entries). */
  lemma ReplayPlusFrameNested(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                              lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                              cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body) && LTB.LookUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires AI.cp_context(cp, str, dir).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==>
              CM.RegsAgreeOutside(r.value.capture_regs, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)))
              && CM.RegsAgreeOutside(r.value.look_regs, lk, LookIdSet(body))
              && QuantRegsFinal(r.value)
  {
    ReplayPlusCaptureFrameNestedOuter(bytecode, str, ov, dir, lookcdn, plus_bcv, cp, cap, lk, qt, la, body);
    ReplayPlusLookFrameNested(bytecode, str, ov, dir, lookcdn, plus_bcv, cp, cap, lk, qt, la, body);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** C4e: the int-lid image of `body`'s OUTSIDE-look quant ids — the quant-bank
      indices a replay of `body` may touch (its inner looks are CheckOracle
      leaves, so their quants never appear in `body`'s code). Quant analogue of
      `PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body))`. */
  ghost function QIdsOuter(body: R.regex): set<int> {
    set q: nat | q in PIV.QuantIdsOutsideLooks(body) :: q as int
  }

  /** C4e: nested twin of `CaptureBytecodeClassifiedNestedOuter` for QUANTS — a
      NESTED body's compiled bytecode writes quant clocks only inside its
      OUTSIDE-look quant ids (`QuantWriteIdsRENested`, the L3a-sharpened classifier
      that already excludes inside-look quants). `NR.CompileToBytecodeRepNested`
      supplies the `NfaRepRE` + `Accept` terminator. */
  lemma QuantBytecodeClassifiedNestedOuter(body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.QuantUnique(body)
    ensures CM.QuantWritesInside(CP.compile_to_bytecode(body), QIdsOuter(body))
  {
    var code := CP.compile_to_bytecode(body);
    var next := CP.compile(body, 0, CP.Progress).1;
    NR.CompileToBytecodeRepNested(body);
    var endl := next as nat;
    var Sq := QIdsOuter(body);
    forall pc: nat | pc < |code|
      ensures code[pc].SetQuantToClock? ==> code[pc].sq in Sq
    {
      assert NR.GetPcRE(code, pc) == Some(code[pc]);
      if pc < endl {
        PIV.QuantWriteIdsRENested(body, code, 0, endl, pc);
        if code[pc].SetQuantToClock? {
          var qn: nat := code[pc].sq as nat;
          assert qn in PIV.QuantIdsOutsideLooks(body);
          assert (qn as int) in Sq;
        }
      } else {
        assert pc == endl;
        assert NR.GetPcRE(code, endl) == Some(RB.Accept);
      }
    }
  }

  /** C4e: nested twin of `ReplayPlusCaptureFrameNestedOuter` for QUANTS. The
      `FFindMatchPlus` capturing lookAHEAD replay over a NESTED body writes its
      quant bank only inside the body's OUTSIDE-look quant ids `QIdsOuter(body)`
      (its inner looks are CheckOracle leaves). The plus reconstruction is the
      identity on the `QuantRegsFinal` result (`FNulledPlusIdentity`), so the
      `FFindMatchPlus` quant bank IS the `FFindMatch` one, which the outer-quant
      write classification + `CM.FFindMatchQuantFrame` frames. */
  lemma ReplayPlusQuantFrameNestedOuter(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                                        lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                        cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires AI.cp_context(cp, str, dir).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.RegsAgreeOutside(r.value.quant_regs, qt, QIdsOuter(body))
  {
    var Sq := QIdsOuter(body);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    QuantBytecodeClassifiedNestedOuter(body);
    assert CM.VmQuantsAgree(inits, qt, Sq) by {
      assert inits.active == [AI.init_thread(cap, lk, qt)];
      assert AI.init_thread(cap, lk, qt).quant_regs == qt;
      assert CM.RegsAgreeOutside(qt, qt, Sq);
    }
    CM.FFindMatchQuantFrame(bytecode, str, inits, ov, dir, lookcdn, qt, Sq);
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, lk, qt));
    }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** R2: per-look-entry side condition for the nested FLookLoop frame. Each
      lookaround body in range is a nested-fragment regex with unique cap/quant/
      look ids and correct sub-rows; its OUTER capture regs land in `S`, its own
      look ids in `Slook`, and (this brick is lookahead-only) any CAPTURING look
      is a positive lookahead. STATIC (look-bank independent), so it transfers
      unchanged through the induction as the look bank grows. */
  ghost predicate FrameEntryOk(crv: CP.FCompiled, la: R.lookaround, body: R.regex, S: set<int>, Slook: set<int>) {
    NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body) && LTB.LookUnique(body)
    && LTB.LookTablesOk(body, crv)
    && PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) <= S
    && LookIdSet(body) <= Slook
    // (L5 F7c-2) the former `capture_type(la) ==> la.Lookahead?` clause is GONE:
    // the nested `FLookLoop*` frames now dispatch per kind (a positive LOOKBEHIND
    // lid replays `reverse_regex(body)` BACKWARD — the `...LB` helper twins).
  }

  /** R2 DELIVERABLE 1: the L4 nested capture+look frame for `FLookLoop`. Every
      matched positive-lookahead body may itself NEST looks to any depth. The
      capture bank is written only inside `S` (each body's OUTER capture regs
      land in `S`), and the look bank is written only inside `Slook` (each replay
      only ADDS its body's own inner-look ids). This is the honest nested
      weakening of `FLookLoopCaptureFrame`: NOT `res.1 == lk` (a nested body's
      replay crosses inner CheckOracle gates and writes their a_cp), but the
      OUTER looks/groups are untouched (`Slook`/`S` are the inner regions). The
      body-shape hypothesis is stated STATICALLY over the look tables so it
      survives the look-bank growth; the "matched look has a table row"
      invariant is preserved across each replay via the own-look-ids look frame
      + `LookIdEntryExists`. `decreases maxlook - lid`; mirrors
      `FLookLoopCaptureFrame`'s structure. */
  lemma {:isolate_assertions} FLookLoopCaptureFrameNested(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                                                          cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                                          S: set<int>, Slook: set<int>)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            CM.RegsAgreeOutside(res.0, cap, S) && CM.RegsAgreeOutside(res.1, lk, Slook)
    decreases maxlook - lid
  {
    if lid > maxlook { return; }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      FLookLoopCaptureFrameNested(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        FLookLoopCaptureFrameNested(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook);
      } else {
        var la: R.lookaround, body: R.regex :| LTB.LookEntryOk(crv, lid, la, body);
        assert 0 <= lid < |crv.f_look_types| && crv.f_look_types[lid] == la;
        assert looktype == la;
        assert FrameEntryOk(crv, la, body, S, Slook);
        assert la.Lookahead? || la.Lookbehind?;            // (L5 F7c-2) capture_type; per-kind dispatch below
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var ncap := if result.None? then cap else result.value.capture_regs;
        var nlk := if result.None? then lk else result.value.look_regs;
        var nqt := if result.None? then qt else result.value.quant_regs;
        // (L5 F7c-2) per-kind replay frames
        if la.Lookahead? {
          assert CP.capture_regex(la, body) == body;
          assert bytecode == CP.compile_to_bytecode(body);
          assert dir == LAnc.Forward;
          assert AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp);
          ReplayPlusFrameNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
        } else {
          assert CP.capture_regex(la, body) == R.reverse_regex(body);
          assert bytecode == CP.compile_to_bytecode(R.reverse_regex(body));
          assert dir == LAnc.Backward;
          assert AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1);
          ReplayPlusFrameNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body);
        }

        // ---- this replay's frames, weakened to S / Slook ----
        assert CM.RegsAgreeOutside(ncap, cap, S) by {
          if result.Some? {
            assert CM.RegsAgreeOutside(ncap, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
            CM.RegsAgreeOutsideWeaken(ncap, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)), S);
          } else {
            assert CM.RegsAgreeOutside(cap, cap, S);
          }
        }
        assert CM.RegsAgreeOutside(nlk, lk, Slook) by {
          if result.Some? {
            assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
            CM.RegsAgreeOutsideWeaken(nlk, lk, LookIdSet(body), Slook);
          } else {
            assert CM.RegsAgreeOutside(lk, lk, Slook);
          }
        }
        assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1) by {
          if result.Some? { assert QuantRegsFinal(result.value); }
        }

        // ---- preserve the "matched look has a table row" invariant for nlk ----
        assert forall l: int :: next <= l <= maxlook && AReg.get_cp(nlk, l).Some? ==>
                                  exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
        by {
          forall l: int | next <= l <= maxlook && AReg.get_cp(nlk, l).Some?
            ensures exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
          {
            if AReg.get_cp(lk, l).Some? {
              // old matched look: from the incoming invariant
            } else {
              // NEWLY set by this replay: nlk differs from lk at l, so l is one of body's own look ids
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
              assert AI.get_idx(nlk.a_cp, l) >= 0;   // get_cp(nlk,l).Some?
              assert AI.get_idx(lk.a_cp, l) < 0;      // get_cp(lk,l).None
              assert l in LookIdSet(body);
              assert (l as nat) in LTB.LookIds(body);
              assert LTB.LookTablesOk(body, crv);     // FrameEntryOk
              LookIdEntryExists(body, crv, l as nat);
            }
          }
        }

        FLookLoopCaptureFrameNested(crv, str, next, maxlook, ncap, nlk, nqt, ov1, S, Slook);
        var resTail := AI.FLookLoop(crv, str, next, maxlook, ncap, nlk, nqt, ov1);
        CM.RegsAgreeOutsideTrans(resTail.0, ncap, cap, S);
        CM.RegsAgreeOutsideTrans(resTail.1, nlk, lk, Slook);
      }
  }

  /** C4e: the L4 nested QUANT frame for `FLookLoop` — quant twin of
      `FLookLoopCaptureFrameNested`. Every matched positive-lookahead body may
      NEST looks; the quant bank is written only inside `Sq` (each body's
      OUTSIDE-look quant ids land in `Sq`; its inner-look quants come from the
      body's OWN inner lids, which are OTHER rows also covered by `Sq`). This is
      the nested weakening of `FLookLoopQuantFrame`: NOT the depth-1 LookFree
      per-body hypothesis, but the STATIC `FrameEntryOk` rows (surviving look-bank
      growth) plus the per-row `QIdsOuter(body) <= Sq`. The "matched look has a
      table row" invariant is preserved across each replay via the own-look-ids
      look frame (`ReplayPlusLookFrameNested`) + `LookIdEntryExists`, exactly as
      on the capture side. `decreases maxlook - lid`. */
  lemma {:isolate_assertions} FLookLoopQuantFrameNested(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                                                        cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                                        S: set<int>, Slook: set<int>, Sq: set<int>)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==>
                 FrameEntryOk(crv, la, body, S, Slook) && QIdsOuter(body) <= Sq
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            CM.RegsAgreeOutside(res.2, qt, Sq)
    decreases maxlook - lid
  {
    if lid > maxlook { return; }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      FLookLoopQuantFrameNested(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, Sq);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        FLookLoopQuantFrameNested(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, Sq);
      } else {
        var la: R.lookaround, body: R.regex :| LTB.LookEntryOk(crv, lid, la, body);
        assert 0 <= lid < |crv.f_look_types| && crv.f_look_types[lid] == la;
        assert looktype == la;
        assert FrameEntryOk(crv, la, body, S, Slook) && QIdsOuter(body) <= Sq;
        assert la.Lookahead? || la.Lookbehind?;            // (L5 F7c-2) capture_type; per-kind dispatch below
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var ncap := if result.None? then cap else result.value.capture_regs;
        var nlk := if result.None? then lk else result.value.look_regs;
        var nqt := if result.None? then qt else result.value.quant_regs;
        // (L5 F7c-2) per-kind replay frames
        if la.Lookahead? {
          assert CP.capture_regex(la, body) == body;
          assert bytecode == CP.compile_to_bytecode(body);
          assert dir == LAnc.Forward;
          assert AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp);
          ReplayPlusFrameNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
          ReplayPlusQuantFrameNestedOuter(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body);
        } else {
          assert CP.capture_regex(la, body) == R.reverse_regex(body);
          assert bytecode == CP.compile_to_bytecode(R.reverse_regex(body));
          assert dir == LAnc.Backward;
          assert AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1);
          ReplayPlusFrameNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body);
          ReplayPlusQuantFrameNestedOuterLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body);
        }

        // ---- this replay's quant frame, weakened to Sq ----
        assert CM.RegsAgreeOutside(nqt, qt, Sq) by {
          if result.Some? {
            assert CM.RegsAgreeOutside(nqt, qt, QIdsOuter(body));
            CM.RegsAgreeOutsideWeaken(nqt, qt, QIdsOuter(body), Sq);
          } else {
            assert CM.RegsAgreeOutside(qt, qt, Sq);
          }
        }
        assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1) by {
          if result.Some? { assert QuantRegsFinal(result.value); }
        }
        assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body)) by {
          if result.Some? {} else { assert nlk == lk; }
        }

        // ---- preserve the "matched look has a table row" invariant for nlk ----
        assert forall l: int :: next <= l <= maxlook && AReg.get_cp(nlk, l).Some? ==>
                                  exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
        by {
          forall l: int | next <= l <= maxlook && AReg.get_cp(nlk, l).Some?
            ensures exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
          {
            if AReg.get_cp(lk, l).Some? {
            } else {
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
              NewLookInBody(nlk, lk, body, l);
              assert LTB.LookTablesOk(body, crv);
              LookIdEntryExists(body, crv, l as nat);
            }
          }
        }

        FLookLoopQuantFrameNested(crv, str, next, maxlook, ncap, nlk, nqt, ov1, S, Slook, Sq);
        var resTail := AI.FLookLoop(crv, str, next, maxlook, ncap, nlk, nqt, ov1);
        CM.RegsAgreeOutsideTrans(resTail.2, nqt, qt, Sq);
      }
  }

  /** R2: nested twin of `FreshMatchWf` — register well-formedness of a nested
      body's FRESH forward match. Only the no-true-quant-stamp step is fragment
      specific (`NoTrueQuantStampNested`); the rest is structural. */
  lemma FreshMatchWfNested(bytecode: RB.code, str: string, cp: int, ov: LOr.OracleView, cdn: LCdn.cdns,
                           body: R.regex, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(body)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    ensures var rf := AI.FFindMatch(bytecode, str,
                                    AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                                    ov, LAnc.Forward, cdn).0;
            rf.Some? ==> CM.ThreadRegsWf(rf.value, ncap, nlook, nquant)
  {
    var dir := LAnc.Forward;
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                               AReg.init_regs(nquant), 0, ctx);
    CM.RegsClocksLEInit(ncap, 0);
    CM.RegsClocksLEInit(nlook, 0);
    CM.RegsClocksLEInit(nquant, 0);
    CM.FInitStateClocksLE(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                          AReg.init_regs(nquant), 0, ctx);
    CM.FInitStateRegsWf(bytecode, cp, ncap, nlook, nquant, 0, ctx);
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant)));
    }
    FFindMatchThreadFacts(bytecode, str, inits, ov, dir, cdn, ncap, nlook, nquant);
  }

  /** R2: nested twin of `ReplayThreadWfLA` — the nested lookahead replay
      preserves register well-formedness (lengths + `CapRegWf`). Only
      `NoTrueQuantStampNested` is fragment specific. */
  lemma ReplayThreadWfLANested(bytecode: RB.code, str: string, cp: int, cap: AReg.Regs, lk: AReg.Regs,
                               qt: AReg.Regs, ov: LOr.OracleView, lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>,
                               body: R.regex, la: R.lookaround, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead?
    requires bytecode == CP.compile_to_bytecode(body)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    requires PIV.CapRegWf(cap)
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures
      var result := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, LAnc.Forward, cp, cap, lk, qt, 0, lookcdn).0;
      result.Some? ==> CM.ThreadRegsWf(result.value, ncap, nlook, nquant)
  {
    var dir := LAnc.Forward;
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctx);
    assert CM.VmRegsWf(inits, ncap, nlook, nquant) by {
      assert CM.ThreadRegsWf(AI.init_thread(cap, lk, qt), ncap, nlook, nquant);
      assert inits.active == [AI.init_thread(cap, lk, qt)];
      forall t | t in inits.active ensures CM.ThreadRegsWf(t, ncap, nlook, nquant) {}
    }
    FFindMatchRegsWf(bytecode, str, inits, ov, dir, lookcdn, ncap, nlook, nquant);
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if fmres.Some? {
      FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                          plus_bcv, str, ovx, dir);
    }
  }

  /** R2: the nested lookahead replay only records look cps in `[.., |str|]`, so
      the `LookCpsLE(_, |str|)` invariant (which underwrites `cp_ctx_ok` on the
      recorded look positions) is PRESERVED across the replay. `CM.FFindMatch
      LookCpOk` bounds the FFindMatch result; `FNulledPlusIdentity` ties the
      FFindMatchPlus look bank to it. */
  lemma ReplayLookCpOkNested(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                             lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                             cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires 0 <= cp <= |str|
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires CM.LookCpsLE(lk, |str|)
    ensures var r := AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).0;
            r.Some? ==> CM.LookCpsLE(r.value.look_regs, |str|)
  {
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctx);
    assert CM.VmLookCpOk(inits, |str|) by {
      assert AI.init_thread(cap, lk, qt).look_regs == lk;
      assert inits.active == [AI.init_thread(cap, lk, qt)];
    }
    CM.FFindMatchLookCpOk(bytecode, str, inits, ov, dir, lookcdn);
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    if res0.Some? {
      var th := res0.value;
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** R2 DELIVERABLE 2 (value predicate): the OUTER-caps value-lift conclusion.
      On each matched positive lookahead's own OUTSIDE-look capture registers
      `CaptureRegsSet(CapIdsOutsideLooks(VBody(crv,l)))`, `res0` carries that
      body's FRESH match (or stays unset if the fresh body did not match). The
      restriction to OUTER caps is deliberate: a fresh single body match of a
      NESTED body compiles inner looks to CheckOracle leaves recording NONE of
      their captures, and the DEEPER lids' own iterations overwrite `res0`'s
      inner-look slots -- so `res0` agrees with the (inner-blind) fresh match
      only on the body's directly-captured groups. */
  ghost predicate FLookLoopValueOkOuter(crv: CP.FCompiled, str: string, res0: AReg.Regs, lid: int, maxlook: int,
                                        lk: AReg.Regs, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int) {
    forall l: int :: lid <= l <= maxlook && MatchedPosLA(crv, lk, l) ==>
                       var rf := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
                       (rf.Some? ==> CM.RegsAgreeInside(res0, rf.value.capture_regs,
                                                        PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, l)))))
                       && (rf.None? ==> CM.RegsAgreeInside(res0, AReg.init_regs(ncap),
                                                           PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, l)))))
  }

  /** `l == lid` is not a matched positive lookahead, so the outer value map for
      `[lid, maxlook]` is exactly the one for `[lid+1, maxlook]`. Nested twin of
      `ValueOkSkipLid`. */
  lemma ValueOkOuterSkipLid(crv: CP.FCompiled, str: string, res0: AReg.Regs, lid: int, maxlook: int,
                            lk: AReg.Regs, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int)
    requires FLookLoopValueOkOuter(crv, str, res0, lid + 1, maxlook, lk, ov, ncap, nlook, nquant)
    requires !MatchedPosLA(crv, lk, lid)
    ensures FLookLoopValueOkOuter(crv, str, res0, lid, maxlook, lk, ov, ncap, nlook, nquant)
  {
    forall l: int | lid <= l <= maxlook && MatchedPosLA(crv, lk, l)
      ensures var rf := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
              (rf.Some? ==> CM.RegsAgreeInside(res0, rf.value.capture_regs,
                                               PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, l)))))
              && (rf.None? ==> CM.RegsAgreeInside(res0, AReg.init_regs(ncap),
                                                  PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, l)))))
    { assert l != lid; }
  }

  /** R2 DELIVERABLE 2 (value lift): THE nested FLookLoop VALUE LIFT restricted to
      OUTER caps. On each matched positive-lookahead body's OWN outside-look
      capture registers, the fold result carries that body's FRESH match. The
      per-lid engine bridge is `ReplayLidCapAgreeFreshNested` (threaded replay ≈
      fresh replay on the body's caps, for a NESTED body). The recursion is the
      `FLookLoopValueLift` skeleton with the fragment/frame lemmas swapped for
      their nested twins; the extra static hypotheses (per-entry body props,
      full per-body-unset, ordered outer/all-caps disjointness, and look-id
      well-nestedness) are what let the induction survive the look-bank GROWTH a
      nested body's replay causes (its inner gates set fresh look entries). Those
      hypotheses are all STATIC / caller-dischargeable from the compilation's
      uniqueness + outer-before-inner lid ordering. `decreases maxlook - lid`. */
  lemma {:isolate_assertions} FLookLoopValueLiftOuter(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                                                      cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                                      S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>                // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (c') full per-body-unset
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (D-ord)
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (f) look-stability
               (lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
               && lid <= l2 <= maxlook && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (g_new)
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            |res.0.a_cp| == ncap && |res.0.a_clk| == ncap && PIV.CapRegWf(res.0)
            && FLookLoopValueOkOuter(crv, str, res.0, lid, maxlook, lk, ov, ncap, nlook, nquant)
    decreases maxlook - lid
  {
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    if lid > maxlook {
      assert res.0 == cap;
      return;
    }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
      FLookLoopValueLiftOuter(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
      ValueOkOuterSkipLid(crv, str, res.0, lid, maxlook, lk, ov, ncap, nlook, nquant);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
        FLookLoopValueLiftOuter(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
        ValueOkOuterSkipLid(crv, str, res.0, lid, maxlook, lk, ov, ncap, nlook, nquant);
      } else {
        var la: R.lookaround, body: R.regex :| LTB.LookEntryOk(crv, lid, la, body);
        assert 0 <= lid < |crv.f_look_types| && crv.f_look_types[lid] == la;
        assert looktype == la;
        assert body == VBody(crv, lid);
        assert FrameEntryOk(crv, la, body, S, Slook);
        assert la.Lookahead? || la.Lookbehind?;            // (L5 F7c-2) capture_type
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var capN := if result.None? then cap else result.value.capture_regs;
        var nlk := if result.None? then lk else result.value.look_regs;
        var nqt := if result.None? then qt else result.value.quant_regs;
        // (L5 F7c-2) per-kind replay facts (the `...LB` twins take the BACKWARD ones)
        assert la.Lookahead? ==> (dir == LAnc.Forward && CP.capture_regex(la, body) == body
                                  && bytecode == CP.compile_to_bytecode(body)
                                  && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp));
        assert la.Lookbehind? ==> (dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body)
                                   && bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
                                   && AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1));
        assert res == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1);
        assert 0 <= cp <= |str| by {
          assert cp == AI.get_idx(lk.a_cp, lid) && cp >= 0;   // get_cp(lk,lid)==Some(cp)
          assert AI.get_idx(lk.a_cp, lid) <= |str|;            // LookCpsLE
        }

        // per-lid replay frames / wf / cp / value
        if la.Lookahead? { FFindMatchPlusOvStableNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { FFindMatchPlusOvStableNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert ov1 == ov;
        if la.Lookahead? { ReplayPlusFrameNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusFrameNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.RegsAgreeOutside(capN, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body))) by {
          if result.Some? {} else { assert capN == cap; }
        }
        assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body)) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        // recon A: TIGHT look frame -- the replay writes only body's DIRECT children
        if la.Lookahead? { ReplayPlusLookFrameDirectNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusLookFrameDirectNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.RegsAgreeOutside(nlk, lk, DirectLidSet(body)) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1) by {
          if result.Some? { assert QuantRegsFinal(result.value); }
        }
        if la.Lookahead? { ReplayThreadWfLANested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant); }
        else { ReplayThreadWfLBNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant); }
        assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
               && |nqt.a_cp| == nquant && |nqt.a_clk| == nquant && |nlk.a_cp| == nlook && |nlk.a_clk| == nlook by {
          if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
        }
        if la.Lookahead? { ReplayLookCpOkNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        else { ReplayLookCpOkNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.LookCpsLE(nlk, |str|) by {
          if result.Some? {} else { assert nlk == lk; }
        }

        // value at lid: result ~ rfLid on CaptureRegs(body); iff-together
        if la.Lookahead? { ReplayLidCapAgreeFreshNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant); }
        else { ReplayLidCapAgreeFreshNestedLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant); }
        var rfLid := FreshBodyMatch(crv, str, lid, lk, ov, ncap, nlook, nquant);
        var rf := AI.FFindMatch(bytecode, str,
                                AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                              AReg.init_regs(nquant), 0, AI.cp_context(cp, str, dir)),
                                ov, dir, lookcdn).0;   // (L5 F7c-2) in the lid's own direction
        assert rfLid == rf;

        var Sp := S - PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));

        // ---- recursion hypothesis transfer at [next] with (capN, nlk, nqt) ----
        // (b) matched-look-has-entry for nlk
        assert forall l: int :: next <= l <= maxlook && AReg.get_cp(nlk, l).Some? ==>
                                  exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
        by {
          forall l: int | next <= l <= maxlook && AReg.get_cp(nlk, l).Some?
            ensures exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
          {
            if AReg.get_cp(lk, l).Some? {
            } else {
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
              NewLookInBody(nlk, lk, body, l);
              assert LTB.LookTablesOk(body, crv);
              LookIdEntryExists(body, crv, l as nat);
            }
          }
        }
        // (c') full per-body-unset for capN
        assert forall l: int, la2: R.lookaround, body2: R.regex ::
            next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2) ==>
              CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(body2))
        by {
          forall l: int, la2: R.lookaround, body2: R.regex | next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2)
            ensures CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(body2))
          {
            assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body2));   // (c')@cap
            assert PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) * PIV.CaptureRegs(body2) == {};   // (D-ord) lid<l
            assert CM.RegsAgreeOutside(capN, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
            UnsetOffTransfer(capN, cap, ncap, PIV.CaptureRegs(body2), PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
          }
        }
        // (f) look-stability for nlk
        assert forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
            (next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
            && next <= l2 <= maxlook && l2 != l1 && AReg.get_cp(nlk, l2).Some?) ==> l2 !in LookIdSet(b1)
        by {
          forall l1: int, la1: R.lookaround, b1: R.regex, l2: int |
            next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
            && next <= l2 <= maxlook && l2 != l1 && AReg.get_cp(nlk, l2).Some?
            ensures l2 !in LookIdSet(b1)
          {
            if AReg.get_cp(lk, l2).Some? {
              // (f)@lk
            } else {
              // recon A: l2 newly set => l2 is a DIRECT child of body; (g_new) (lid < l1) => l2 !in LookIds(b1)
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, DirectLidSet(body));
              NewLookInBodyDirect(nlk, lk, body, l2);
              assert (l2 as nat) in DirectLookIds(body);
              assert lid < l1;                                          // l1 >= next
              assert DirectLookIds(body) * LTB.LookIds(b1) == {};       // (g_new) with (lid, l1)
              assert (l2 as nat) !in LTB.LookIds(b1);
              if l2 in LookIdSet(b1) {
                var q: nat :| q in LTB.LookIds(b1) && (q as int) == l2;
                assert q == l2 as nat;
              }
            }
          }
        }

        FLookLoopValueLiftOuter(crv, str, next, maxlook, capN, nlk, nqt, ov1, S, Slook, ncap, nlook, nquant);
        assert res.0 == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1).0;
        assert FLookLoopValueOkOuter(crv, str, res.0, next, maxlook, nlk, ov, ncap, nlook, nquant);
        assert |res.0.a_cp| == ncap && |res.0.a_clk| == ncap && PIV.CapRegWf(res.0);

        // ---- suffix frame: res.0 == capN on OuterCaps(body) ----
        assert forall l: int, la2: R.lookaround, body2: R.regex ::
            next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2) ==> FrameEntryOk(crv, la2, body2, Sp, Slook)
        by {
          forall l: int, la2: R.lookaround, body2: R.regex | next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2)
            ensures FrameEntryOk(crv, la2, body2, Sp, Slook)
          {
            assert FrameEntryOk(crv, la2, body2, S, Slook);   // (a)
            assert PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) * PIV.CaptureRegs(body2) == {};   // (D-ord)
            OuterCapsLeCaptureRegs(body2);
            assert PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body2)) <= Sp by {
              forall k: int | k in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body2)) ensures k in Sp {
                assert k in S;
                assert k in PIV.CaptureRegs(body2);   // OuterCaps(body2) <= CaptureRegs(body2)
                assert k !in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) by {
                  if k in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) {
                    assert k in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) * PIV.CaptureRegs(body2);
                  }
                }
              }
            }
          }
        }
        FLookLoopCaptureFrameNested(crv, str, next, maxlook, capN, nlk, nqt, ov1, Sp, Slook);
        assert CM.RegsAgreeOutside(res.0, capN, Sp);
        assert forall k: int :: k in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) ==> k !in Sp;
        RegsAgreeOutsideToInside(res.0, capN, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)), Sp);
        assert CM.RegsAgreeInside(res.0, capN, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));

        // ---- assemble FLookLoopValueOkOuter for [lid] ----
        forall l: int | lid <= l <= maxlook && MatchedPosLA(crv, lk, l)
          ensures var rf2 := FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
                  (rf2.Some? ==> CM.RegsAgreeInside(res.0, rf2.value.capture_regs,
                                                    PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, l)))))
                  && (rf2.None? ==> CM.RegsAgreeInside(res.0, AReg.init_regs(ncap),
                                                       PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, l)))))
        {
          if l == lid {
            assert VBody(crv, l) == body;
            var OC := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));
            OuterCapsLeCaptureRegs(body);
            assert OC <= PIV.CaptureRegs(body);
            if rfLid.Some? {
              assert result.Some? && capN == result.value.capture_regs;
              assert CM.RegsAgreeInside(capN, rf.value.capture_regs, PIV.CaptureRegs(body));
              RegsAgreeInsideWeakenSub(capN, rf.value.capture_regs, OC, PIV.CaptureRegs(body));
              assert CM.RegsAgreeInside(res.0, capN, OC);   // suffix frame
              assert CM.RegsAgreeInside(res.0, rfLid.value.capture_regs, OC);   // chain via capN, rf==rfLid
            } else {
              assert result.None? && capN == cap && rfLid.None?;
              assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body));   // (c')@lid
              RegsAgreeInsideWeakenSub(cap, AReg.init_regs(ncap), OC, PIV.CaptureRegs(body));
              assert CM.RegsAgreeInside(res.0, capN, OC);
              assert CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), OC);
            }
          } else {
            assert next <= l <= maxlook;
            var la1x: R.lookaround, b1x: R.regex :| LTB.LookEntryOk(crv, lid, la1x, b1x);
            assert b1x == body;
            assert AReg.get_cp(lk, l).Some?;
            assert l !in LookIdSet(body);   // (f) l1=lid, l2=l, get_cp(lk,l).Some?
            assert 0 <= l < |lk.a_cp| && 0 <= l < |nlk.a_cp|;
            assert AReg.get_cp(nlk, l) == AReg.get_cp(lk, l) by {
              assert AI.get_idx(nlk.a_cp, l) == AI.get_idx(lk.a_cp, l);   // RegsAgreeOutside off LookIdSet(body)
            }
            assert MatchedPosLA(crv, nlk, l);
            var rfNlk := FreshBodyMatch(crv, str, l, nlk, ov, ncap, nlook, nquant);
            assert rfNlk == FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
            // instantiate the IH (over nlk) at l
            assert (rfNlk.Some? ==> CM.RegsAgreeInside(res.0, rfNlk.value.capture_regs,
                                                       PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, l)))))
                   && (rfNlk.None? ==> CM.RegsAgreeInside(res.0, AReg.init_regs(ncap),
                                                          PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, l)))));
          }
        }
      }
  }

  // ==========================================================================
  // R3 (recon): whole-loop capture reconstruction for NESTED bodies keyed on
  // the FINAL look bank `res.1` (so INNER looks matched only PART-WAY through
  // the loop are RETAINED, unlike R2's `FLookLoopValueOkOuter` which is keyed on
  // the loop's INPUT `lk` and covers only OUTER looks at the top call).
  // ==========================================================================

  /** R3: the `get_cp`↔`get_idx(a_cp)` bridge as an equality transfer — banks
      that agree on `a_cp` at index `k` (via `get_idx`) agree on `get_cp` at `k`.
      `get_cp(r,k) == opt_of_int(get_idx(r.a_cp,k))` by unfolding both. */
  lemma GetCpAgreeIdx(a: AReg.Regs, b: AReg.Regs, k: int)
    requires AI.get_idx(a.a_cp, k) == AI.get_idx(b.a_cp, k)
    ensures AReg.get_cp(a, k) == AReg.get_cp(b, k)
  {
    if 0 <= k < |a.a_cp| && 0 <= k < |b.a_cp| {
      assert a.a_cp[k] == AI.get_idx(a.a_cp, k) == AI.get_idx(b.a_cp, k) == b.a_cp[k];
    } else if 0 <= k < |a.a_cp| {
      assert a.a_cp[k] == AI.get_idx(a.a_cp, k) == AI.get_idx(b.a_cp, k) == -1;
    } else if 0 <= k < |b.a_cp| {
      assert b.a_cp[k] == AI.get_idx(b.a_cp, k) == AI.get_idx(a.a_cp, k) == -1;
    }
  }

  /** R3 STABILITY: the FINAL look bank agrees with the input `lk` at index `lid`.
      The whole fold over `[lid,maxlook]` only writes look ids in each matched
      body's `LookIdSet` (`FLookLoopCaptureFrameNested`), and by well-nestedness
      (hyp (h)) `lid` is in NONE of them. So framing against `Slook - {lid}` (the
      shape/`LookIdSet` requirement survives because `lid !in LookIdSet(body)`)
      pins `get_cp(res.1, lid) == get_cp(lk, lid)`. This is the fact that lets R3
      re-key `lid`'s coverage from `lk` onto `res.1`, and shows `lid` unmatched in
      `lk` stays unmatched in `res.1`. */
  lemma FLookLoopLidCpStable(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                             cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                             S: set<int>, Slook: set<int>)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l1: int, la1: R.lookaround, b1: R.regex ::                                  // (h)@lid
               lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> lid !in LookIdSet(b1)
    ensures AReg.get_cp(AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov).1, lid)
         == AReg.get_cp(lk, lid)
  {
    var Slookp := Slook - {lid};
    forall l: int, la: R.lookaround, body: R.regex | lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body)
      ensures FrameEntryOk(crv, la, body, S, Slookp)
    {
      assert FrameEntryOk(crv, la, body, S, Slook);   // LookIdSet(body) <= Slook
      assert lid !in LookIdSet(body);                 // (h)@lid
      assert LookIdSet(body) <= Slookp;
    }
    FLookLoopCaptureFrameNested(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slookp);
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    assert CM.RegsAgreeOutside(res.1, lk, Slookp);
    assert lid !in Slookp;
    assert AI.get_idx(res.1.a_cp, lid) == AI.get_idx(lk.a_cp, lid);
    GetCpAgreeIdx(res.1, lk, lid);
  }

  /** C4c STABILITY (clock twin of `FLookLoopLidCpStable`): the FINAL look bank's
      CLOCK at index `lid` is unchanged by the fold. Same argument — the fold only
      writes look ids in matched bodies' `LookIdSet`, none of which is `lid` by
      well-nestedness (h), so `RegsAgreeOutside(res.1, lk, Slook - {lid})` (which
      constrains BOTH `a_cp` and `a_clk`) pins the `a_clk` slot too. This is the
      look-clock stability the ancestor-chain assembly needs: an ancestor look
      `l`'s clock, set by an EARLIER stage (its parent's replay, or the main match
      for a top-level `l`), survives every LATER fold iteration untouched — so the
      chain read on the FINAL `res.1` equals the chain as each stage left it. */
  lemma FLookLoopLidLookClkStable(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                                  cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                  S: set<int>, Slook: set<int>)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l1: int, la1: R.lookaround, b1: R.regex ::                                  // (h)@lid
               lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> lid !in LookIdSet(b1)
    ensures AI.get_idx(AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov).1.a_clk, lid)
         == AI.get_idx(lk.a_clk, lid)
  {
    var Slookp := Slook - {lid};
    forall l: int, la: R.lookaround, body: R.regex | lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body)
      ensures FrameEntryOk(crv, la, body, S, Slookp)
    {
      assert FrameEntryOk(crv, la, body, S, Slook);   // LookIdSet(body) <= Slook
      assert lid !in LookIdSet(body);                 // (h)@lid
      assert LookIdSet(body) <= Slookp;
    }
    FLookLoopCaptureFrameNested(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slookp);
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    assert CM.RegsAgreeOutside(res.1, lk, Slookp);
    assert lid !in Slookp;
  }

  /** (BRICK D7 — premise 3, the THIRD CLOCK TWIN) WHOLE-LOOP top-look-clock
      stability: for ANY stable index `l` that lands in NO replayed body's
      `LookIdSet` (in particular any TOP-LEVEL look of `re`, `TopLookNotNested`),
      the FINAL look bank's clock at `l` is unchanged by the ENTIRE fold from
      `lid` to `maxlook`. Generalizes `FLookLoopLidLookClkStable` (which pins only
      the fold-START index `lid`) to an arbitrary framed index `l`: the fold only
      writes look ids in matched bodies' `LookIdSet`, none of which is `l`, so
      framing against `Slook - {l}` (`FLookLoopCaptureFrameNested`, which
      constrains BOTH `a_cp` and `a_clk`) pins the `a_clk` slot at `l`. This is
      the whole-loop stability the `re`-arm of `AllBodyTopFeeds` demands — a top
      look `l`'s clock, set by the MAIN match before the fold, survives every
      iteration untouched. Proof identical to `FLookLoopLidLookClkStable` with the
      stable index decoupled from the fold start. */
  lemma FLookLoopTopLookClkStableFull(crv: CP.FCompiled, str: string, lid: int, maxlook: int, l: int,
                                      cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                      S: set<int>, Slook: set<int>)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires forall l0: int, la: R.lookaround, body: R.regex ::
               lid <= l0 <= maxlook && LTB.LookEntryOk(crv, l0, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l0: int :: lid <= l0 <= maxlook && AReg.get_cp(lk, l0).Some? ==>
                                 exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l0, la, body)
    requires forall l1: int, la1: R.lookaround, b1: R.regex ::                                  // (h')@l
               lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> l !in LookIdSet(b1)
    ensures AI.get_idx(AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov).1.a_clk, l)
         == AI.get_idx(lk.a_clk, l)
  {
    var Slookp := Slook - {l};
    forall l0: int, la: R.lookaround, body: R.regex | lid <= l0 <= maxlook && LTB.LookEntryOk(crv, l0, la, body)
      ensures FrameEntryOk(crv, la, body, S, Slookp)
    {
      assert FrameEntryOk(crv, la, body, S, Slook);   // LookIdSet(body) <= Slook
      assert l !in LookIdSet(body);                   // (h')@l
      assert LookIdSet(body) <= Slookp;
    }
    FLookLoopCaptureFrameNested(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slookp);
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    assert CM.RegsAgreeOutside(res.1, lk, Slookp);
    assert l !in Slookp;
  }

  /** (cp twin of `FLookLoopTopLookClkStableFull`) WHOLE-LOOP top-look POSITION
      stability: for ANY stable index `l` in NO replayed body's `LookIdSet` (in
      particular any TOP-LEVEL look of `re`, `TopLookNotNested`), the FINAL look
      bank's recorded position at `l` is unchanged by the ENTIRE fold from `lid` to
      `maxlook`. Same argument as `FLookLoopTopLookClkStableFull` read off the
      `a_cp` slot and finished by `GetCpAgreeIdx`. This is the whole-loop POSITION
      stability the reverse-recon descent needs to transport `MatchedPosLA` /
      `FreshBodyMatch` (which read only `get_cp(lk, l)` at index `l`) from the
      reconstructed bank `res.1 = FLookLoop(...).1` back onto the winning thread's
      `look_regs` at a top look `l`. */
  lemma FLookLoopTopLookCpStableFull(crv: CP.FCompiled, str: string, lid: int, maxlook: int, l: int,
                                     cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                     S: set<int>, Slook: set<int>)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires forall l0: int, la: R.lookaround, body: R.regex ::
               lid <= l0 <= maxlook && LTB.LookEntryOk(crv, l0, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l0: int :: lid <= l0 <= maxlook && AReg.get_cp(lk, l0).Some? ==>
                                 exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l0, la, body)
    requires forall l1: int, la1: R.lookaround, b1: R.regex ::                                  // (h')@l
               lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> l !in LookIdSet(b1)
    ensures AReg.get_cp(AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov).1, l)
         == AReg.get_cp(lk, l)
  {
    var Slookp := Slook - {l};
    forall l0: int, la: R.lookaround, body: R.regex | lid <= l0 <= maxlook && LTB.LookEntryOk(crv, l0, la, body)
      ensures FrameEntryOk(crv, la, body, S, Slookp)
    {
      assert FrameEntryOk(crv, la, body, S, Slook);   // LookIdSet(body) <= Slook
      assert l !in LookIdSet(body);                   // (h')@l
      assert LookIdSet(body) <= Slookp;
    }
    FLookLoopCaptureFrameNested(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slookp);
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    assert CM.RegsAgreeOutside(res.1, lk, Slookp);
    assert l !in Slookp;
    assert AI.get_idx(res.1.a_cp, l) == AI.get_idx(lk.a_cp, l);
    GetCpAgreeIdx(res.1, lk, l);
  }

  /** (reconciliation) `MatchedPosLA` and `FreshBodyMatch` at index `l` read the
      look bank ONLY through `AReg.get_cp(lk, l)` (the recorded position of look
      `l`). So two look banks that agree at that one slot yield the SAME
      `MatchedPosLA` verdict and the SAME fresh body match. Combined with
      `FLookLoopTopLookCpStableFull` (`get_cp` stable at a top look under the
      whole fold), this transports both `MatchedPosLA` and `FreshBodyMatch` from
      the reconstructed bank `res.1 = FLookLoop(...).1` onto the winning thread's
      `look_regs` at a top look — the reconciliation the reverse-recon descent
      needs to key A1/A2's outputs (stated on `res.1`) onto the SIM carrier's
      thread banks. */
  lemma MatchedPosLAFreshBodyCpCong(crv: CP.FCompiled, str: string, l: int, a: AReg.Regs, b: AReg.Regs,
                                    ov: LOr.OracleView, ncap: int, nlook: int, nquant: int)
    requires AReg.get_cp(a, l) == AReg.get_cp(b, l)
    ensures MatchedPosLA(crv, a, l) == MatchedPosLA(crv, b, l)
    ensures FreshBodyMatch(crv, str, l, a, ov, ncap, nlook, nquant)
         == FreshBodyMatch(crv, str, l, b, ov, ncap, nlook, nquant)
  {
  }

  /** C4c BODY-SIDE (look-clock independence): for a group `gid` OUTSIDE all of
      `r`'s looks (`gid !in CapIdsInLooks(r)`), `PathPresentLk`/`MxAtGidLk` never
      read the look-clock bank `lc` — the descent to `gid` crosses no
      `Re_lookaround` node (one would place `gid` in `CapIdsInLooks(r)`). So both
      are invariant under ANY change to `lc`. This is the congruence the body-side
      transport needs that `NI.PathPresentLkAgree` cannot supply: the reconstructed
      look bank `res.1` and the fresh replay's look bank differ on `body`'s DEEP
      inner looks, but an INNERMOST-owned `gid` sits outside them, so its body
      presence is unaffected — letting `PathPresentLk(body, res0.a_clk, res1.a_clk,
      res2.a_clk, -1, gid)` be discharged from the fresh replay's presence keyed on
      the replay's OWN look bank. */
  lemma PathPresentLkLcIndep(r: R.regex, cc: seq<int>, lc1: seq<int>, lc2: seq<int>,
                             qc: seq<int>, mx: int, gid: nat)
    requires gid in PIV.CapIds(r)
    requires gid !in PIV.CapIdsInLooks(r)
    ensures PIV.PathPresentLk(r, cc, lc1, qc, mx, gid) == PIV.PathPresentLk(r, cc, lc2, qc, mx, gid)
    ensures PIV.MxAtGidLk(r, cc, lc1, qc, mx, gid) == PIV.MxAtGidLk(r, cc, lc2, qc, mx, gid)
    decreases r
  {
    match r
    case Re_empty => case Re_character(_) => case Re_anchor(_) =>
    case Re_alt(r1, r2) =>
      if gid in PIV.CapIds(r1) { PathPresentLkLcIndep(r1, cc, lc1, lc2, qc, mx, gid); }
      else { PathPresentLkLcIndep(r2, cc, lc1, lc2, qc, mx, gid); }
    case Re_con(r1, r2) =>
      if gid in PIV.CapIds(r1) { PathPresentLkLcIndep(r1, cc, lc1, lc2, qc, mx, gid); }
      else { PathPresentLkLcIndep(r2, cc, lc1, lc2, qc, mx, gid); }
    case Re_quant(nul, qid, q, r1) =>
      PathPresentLkLcIndep(r1, cc, lc1, lc2, qc, AI.get_idx(qc, qid), gid);
    case Re_capture(cid, r1) =>
      if cid == gid {} else { PathPresentLkLcIndep(r1, cc, lc1, lc2, qc, mx, gid); }
    case Re_lookaround(lid, l, r1) =>
      assert PIV.CapIdsInLooks(r) == PIV.CapIds(r1);   // all body caps are inside this look
      assert gid in PIV.CapIds(r1);                    // CapIds(lookaround) == CapIds(body)
      assert false;                                    // contradicts gid !in CapIdsInLooks(r)
  }

  /** C4c BODY-SIDE TRANSPORT (piece (iii) of `NI.LookPathComposeNested`'s
      premises). For an INNERMOST-owned inside-look group `g` (`g in CapIds(body)`,
      `g !in CapIdsInLooks(body)`), the fresh body-match presence — extracted from
      `g`'s liveness in the replay's OWN banks (`rfcap`,`rflk`,`rfqt`) via
      `NI.GmOfLivePresenceExtractLkNested` — transports onto the RECONSTRUCTED banks
      (`res0`,`res1`,`res2`), yielding `PIV.PathPresentLk(body, res0.a_clk,
      res1.a_clk, res2.a_clk, -1, g)` and the clock-dominance bound. Two congruence
      steps: `NI.PathPresentLkAgree` swaps the CAPTURE bank (`res0`~`rfcap` on
      `CapIds(body)`, from the value lift) and the QUANT bank (`res2`~`rfqt` on
      `QuantIds(body)`, the quant-clock reconcile — HYPOTHESIS here, deliverable 3)
      while KEEPING the replay's look bank; then `PathPresentLkLcIndep` swaps the
      look bank `rflk`->`res1` for free (`g` outside `body`'s looks, so `lc` is
      never read). This is the body half of the endpoint's inside-`S` presence feed;
      it needs NEITHER the ancestor-chain nor the engine's per-replay stamping. */
  lemma ReconBodyPathPresentLk(body: R.regex,
                               res0: AReg.Regs, res1: AReg.Regs, res2: AReg.Regs,
                               rfcap: AReg.Regs, rflk: AReg.Regs, rfqt: AReg.Regs, g: nat)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body)
    requires g in PIV.CapIds(body)
    requires g !in PIV.CapIdsInLooks(body)
    requires forall c: nat :: c in PIV.CapIds(body) && AI.get_idx(rfcap.a_clk, CP.start_reg(c)) < 0
                              ==> AI.get_idx(rfcap.a_cp, CP.start_reg(c)) < 0
    requires g in PIV.GmOfLive(body, rfcap, rflk, rfqt)
    // value-lift capture agreement: res0 ~ rfcap on body's capture-start clocks.
    requires forall c: nat :: c in PIV.CapIds(body) ==>
                                AI.get_idx(res0.a_clk, CP.start_reg(c)) == AI.get_idx(rfcap.a_clk, CP.start_reg(c))
    // quant-clock reconcile: res2 ~ rfqt on body's quant clocks (deliverable 3 feed).
    requires forall qd: nat :: qd in PIV.QuantIds(body) ==>
                                 AI.get_idx(res2.a_clk, qd as int) == AI.get_idx(rfqt.a_clk, qd as int)
    ensures PIV.PathPresentLk(body, res0.a_clk, AReg.as_arrays(res1).1, res2.a_clk, -1, g)
    ensures AI.get_idx(res0.a_clk, CP.start_reg(g)) >= 0
    ensures AI.get_idx(res0.a_clk, CP.start_reg(g))
         >= PIV.MxAtGidLk(body, res0.a_clk, AReg.as_arrays(res1).1, res2.a_clk, -1, g)
  {
    var rfcc := rfcap.a_clk;  var rflc := AReg.as_arrays(rflk).1;  var rfqc := AReg.as_arrays(rfqt).1;
    var rc0 := res0.a_clk;    var rc1 := AReg.as_arrays(res1).1;   var rc2 := res2.a_clk;
    // (1) fresh-replay presence on rf's OWN banks
    NI.GmOfLivePresenceExtractLkNested(body, rfcap, rflk, rfqt, g);
    assert PIV.PathPresentLk(body, rfcc, rflc, rfqc, -1, g);
    assert AI.get_idx(rfcc, CP.start_reg(g)) >= 0;
    assert AI.get_idx(rfcc, CP.start_reg(g)) >= PIV.MxAtGidLk(body, rfcc, rflc, rfqc, -1, g);
    // (2) swap capture+quant banks (keep rf's look bank)
    NI.PathPresentLkAgree(body, rfcc, rflc, rfqc, rc0, rflc, rc2, -1, g);
    assert PIV.PathPresentLk(body, rc0, rflc, rc2, -1, g);
    assert PIV.MxAtGidLk(body, rc0, rflc, rc2, -1, g) == PIV.MxAtGidLk(body, rfcc, rflc, rfqc, -1, g);
    // (3) swap look bank rflc -> rc1 for free (g outside body's looks)
    PathPresentLkLcIndep(body, rc0, rflc, rc1, rc2, -1, g);
    assert PIV.PathPresentLk(body, rc0, rc1, rc2, -1, g);
    assert PIV.MxAtGidLk(body, rc0, rc1, rc2, -1, g) == PIV.MxAtGidLk(body, rc0, rflc, rc2, -1, g);
    // (4) the bound, transported through the two MxAtGidLk equalities + cap agreement at g
    assert AI.get_idx(rc0, CP.start_reg(g)) == AI.get_idx(rfcc, CP.start_reg(g));   // cap agreement @ g
  }

  /** C4c CAPSTONE — the forward inside-`S` membership close on the RECONSTRUCTED
      banks. For an innermost-owned inside-look group `g` this puts `g` into the
      whole-regex live denotation of `(res0, res1, res2)` at the raw `LiveRange`
      value — exactly the fact the endpoint's inside-`S` value chain bottoms out on
      (the depth-k generalization of `M.GmOfLiveInsideLookPresentEq`'s RE-side
      hypothesis, now keyed on the reconstructed look bank `res1` in place of the
      main thread's). It isolates the two ENGINE feeds still owed by the recursive
      walk tower:
        (i)  the ancestor look-clock chain `NI.LookPathPresentLk(re, ·, owner)`, and
        (ii) `owner`'s own look clock (set & dominating),
      passing them as hypotheses; everything else is discharged here —
      `ReconBodyPathPresentLk` (body side, via the value lift + quant reconcile),
      C4b's `NI.LookPathComposeNested` (the ancestor assembly), and C4b's
      `NI.GmOfLiveKeepsPresentLkNested` (the close). When the walk tower supplies
      (i)/(ii) and the quant reconcile on the reconstructed banks, this lemma turns
      them into the endpoint's `GmOfLive` equality with NO further algebra. */
  lemma ReconInnerGmOfLiveClose(re: R.regex, body: R.regex, owner: nat,
                                res0: AReg.Regs, res1: AReg.Regs, res2: AReg.Regs,
                                rfcap: AReg.Regs, rflk: AReg.Regs, rfqt: AReg.Regs, g: nat)
    requires NR.NestedFragmentRE(re) && PIV.CapUnique(re)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body)
    // ownership: owner is g's innermost DIRECT owner in re; body is its structural body
    requires owner in LTB.LookIds(re)
    requires body == NI.LookBodyOfRE(re, owner)
    requires g in PIV.CapIds(body)
    requires g !in PIV.CapIdsInLooks(body)
    // ---- ENGINE FEED (owed by the recursive walk tower) ----
    // (i) ancestor look-clock chain to owner on the reconstructed banks
    requires NI.LookPathPresentLk(re, res0.a_clk, AReg.as_arrays(res1).1, res2.a_clk, -1, owner)
    // (ii) owner's own look clock (set & dominating)
    requires AI.get_idx(AReg.as_arrays(res1).1, owner as int) >= 0
    requires AI.get_idx(AReg.as_arrays(res1).1, owner as int)
          >= NI.MxAtLidLk(re, res2.a_clk, -1, owner)
    // ---- BODY-SIDE FEED (value lift + quant reconcile + fresh liveness) ----
    requires forall c: nat :: c in PIV.CapIds(body) && AI.get_idx(rfcap.a_clk, CP.start_reg(c)) < 0
                              ==> AI.get_idx(rfcap.a_cp, CP.start_reg(c)) < 0
    requires g in PIV.GmOfLive(body, rfcap, rflk, rfqt)
    requires forall c: nat :: c in PIV.CapIds(body) ==>
                                AI.get_idx(res0.a_clk, CP.start_reg(c)) == AI.get_idx(rfcap.a_clk, CP.start_reg(c))
    requires forall qd: nat :: qd in PIV.QuantIds(body) ==>
                                 AI.get_idx(res2.a_clk, qd as int) == AI.get_idx(rfqt.a_clk, qd as int)
    // value set at g in res0 (from the value lift's cp coverage)
    requires AI.get_idx(res0.a_cp, CP.start_reg(g)) >= 0
    ensures g in PIV.CapIds(re)
    ensures g in PIV.GmOfLive(re, res0, res1, res2)
    ensures PIV.GmOfLive(re, res0, res1, res2)[g]
         == PIV.LiveRange(res0.a_cp, res0.a_clk, g)
  {
    var cc := res0.a_clk;  var lc := AReg.as_arrays(res1).1;  var qc := res2.a_clk;
    // (1) body-side presence on the reconstructed banks
    ReconBodyPathPresentLk(body, res0, res1, res2, rfcap, rflk, rfqt, g);
    assert PIV.PathPresentLk(body, cc, lc, qc, -1, g);
    assert AI.get_idx(cc, CP.start_reg(g)) >= 0;
    assert AI.get_idx(cc, CP.start_reg(g)) >= PIV.MxAtGidLk(body, cc, lc, qc, -1, g);
    // (2) C4b ancestor assembly: full path presence to g in re
    NI.LookPathComposeNested(re, body, cc, lc, qc, -1, owner, g);
    assert g in PIV.CapIds(re);
    assert PIV.PathPresentLk(re, cc, lc, qc, -1, g);
    assert PIV.MxAtGidLk(re, cc, lc, qc, -1, g) == PIV.MxAtGidLk(body, cc, lc, qc, -1, g);
    assert AI.get_idx(cc, CP.start_reg(g)) >= PIV.MxAtGidLk(re, cc, lc, qc, -1, g);
    // (3) C4b close: g lands in GmOfLive at the raw LiveRange
    assert lc == AReg.as_arrays(res1).1;
    NI.GmOfLiveKeepsPresentLkNested(re, res0, res1, res2, g);
  }

  /** R3 DELIVERABLE 1 (predicate): whole-loop value reconstruction keyed on the
      FINAL look bank `res1`. For EVERY (possibly inner) matched positive
      lookahead `owner` — matched in `res1`, not just the loop's input `lk` — the
      fold result `res0` carries that body's FRESH match on its OWN outside-look
      capture registers. Generalizes `FLookLoopValueOkOuter` (keyed on `lk`) by
      RETAINING inner-look coverage the loop writes part-way through. */
  ghost predicate FLookLoopValueOkFull(crv: CP.FCompiled, str: string, res0: AReg.Regs, res1: AReg.Regs,
                                       lid: int, maxlook: int, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int) {
    forall owner: int :: lid <= owner <= maxlook && MatchedPosLA(crv, res1, owner) ==>
                           var rf := FreshBodyMatch(crv, str, owner, res1, ov, ncap, nlook, nquant);
                           (rf.Some? ==> CM.RegsAgreeInside(res0, rf.value.capture_regs,
                                                            PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, owner)))))
                           && (rf.None? ==> CM.RegsAgreeInside(res0, AReg.init_regs(ncap),
                                                               PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, owner)))))
  }

  /** R3: `owner == lid` is not a matched positive lookahead in `res1`, so the
      full value map for `[lid, maxlook]` (keyed on `res1`) is exactly the one for
      `[lid+1, maxlook]`. Full twin of `ValueOkOuterSkipLid`. */
  lemma ValueOkFullSkipLid(crv: CP.FCompiled, str: string, res0: AReg.Regs, res1: AReg.Regs,
                           lid: int, maxlook: int, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int)
    requires FLookLoopValueOkFull(crv, str, res0, res1, lid + 1, maxlook, ov, ncap, nlook, nquant)
    requires !MatchedPosLA(crv, res1, lid)
    ensures FLookLoopValueOkFull(crv, str, res0, res1, lid, maxlook, ov, ncap, nlook, nquant)
  {
    forall owner: int | lid <= owner <= maxlook && MatchedPosLA(crv, res1, owner)
      ensures var rf := FreshBodyMatch(crv, str, owner, res1, ov, ncap, nlook, nquant);
              (rf.Some? ==> CM.RegsAgreeInside(res0, rf.value.capture_regs,
                                               PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, owner)))))
              && (rf.None? ==> CM.RegsAgreeInside(res0, AReg.init_regs(ncap),
                                                  PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, owner)))))
    { assert owner != lid; }
  }

  /** R3 DELIVERABLE 1 (value lift): THE nested FLookLoop VALUE LIFT keyed on the
      FINAL look bank `res.1`. Generalizes `FLookLoopValueLiftOuter` (keyed on the
      loop's INPUT `lk`) so that INNER looks — matched only PART-WAY through the
      loop, when an OUTER look's replay crosses their CheckOracle gates and writes
      their `a_cp` into the threaded look bank — are RETAINED. Same hypotheses as
      `FLookLoopValueLiftOuter` PLUS (h) well-nested lids: this ordering fact
      (`LookIdSet(body)` sits strictly ABOVE the enclosing lid; caller-
      dischargeable from `LidsWellNested`) is what R3 needs and (f)/(g) do NOT
      give — (f) requires its target already matched in `lk`, so it cannot pin
      `lid !in LookIdSet(body_lid)` (self) nor cover an unmatched-in-`lk` `lid`.
      The recursion mirrors `FLookLoopValueLiftOuter`; the extra re-keying step is
      the R3 stability fact `FLookLoopLidCpStable` (`get_cp(res.1, lid) ==
      get_cp(lk, lid)`), which converts `lid`'s `lk`-keyed coverage onto `res.1`
      and settles the unmatched cases; owners `> lid` come DIRECTLY from the IH
      (already keyed on `res.1`), simpler than R2's `nlk`↔`lk` reconciliation.
      `decreases maxlook - lid`. */
  lemma {:isolate_assertions} FLookLoopValueLiftFull(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                                                     cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                                     S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>                // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (c') full per-body-unset
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (D-ord)
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (f) look-stability
               (lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
               && lid <= l2 <= maxlook && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (g_new)
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (h) well-nested lids
               lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) && lid <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            |res.0.a_cp| == ncap && |res.0.a_clk| == ncap && PIV.CapRegWf(res.0)
            && |res.1.a_cp| == nlook && |res.1.a_clk| == nlook          // L4 PERF: expose the look-bank length
            && |res.2.a_cp| == nquant && |res.2.a_clk| == nquant        // L4 PERF: expose the quant-bank length
            && FLookLoopValueOkFull(crv, str, res.0, res.1, lid, maxlook, ov, ncap, nlook, nquant)
    decreases maxlook - lid
  {
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    if lid > maxlook {
      assert res.0 == cap;
      return;
    }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
      FLookLoopValueLiftFull(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
      // stability: res.1 agrees with lk at lid; lk is None there => res.1 None => not matched
      assert forall l1: int, la1: R.lookaround, b1: R.regex ::
          lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> lid !in LookIdSet(b1);   // (h)@lid, l2:=lid
      FLookLoopLidCpStable(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slook);
      assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);
      assert !MatchedPosLA(crv, res.1, lid);
      ValueOkFullSkipLid(crv, str, res.0, res.1, lid, maxlook, ov, ncap, nlook, nquant);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
        FLookLoopValueLiftFull(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
        assert !MatchedPosLA(crv, res.1, lid);   // !capture_type(looktype), looktype == f_look_types[lid]
        ValueOkFullSkipLid(crv, str, res.0, res.1, lid, maxlook, ov, ncap, nlook, nquant);
      } else {
        var la: R.lookaround, body: R.regex :| LTB.LookEntryOk(crv, lid, la, body);
        assert 0 <= lid < |crv.f_look_types| && crv.f_look_types[lid] == la;
        assert looktype == la;
        assert body == VBody(crv, lid);
        assert FrameEntryOk(crv, la, body, S, Slook);
        assert la.Lookahead? || la.Lookbehind?;            // (L5 F7c-2) capture_type
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var capN := if result.None? then cap else result.value.capture_regs;
        var nlk := if result.None? then lk else result.value.look_regs;
        var nqt := if result.None? then qt else result.value.quant_regs;
        // (L5 F7c-2) per-kind replay facts (the `...LB` twins take the BACKWARD ones)
        assert la.Lookahead? ==> (dir == LAnc.Forward && CP.capture_regex(la, body) == body
                                  && bytecode == CP.compile_to_bytecode(body)
                                  && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp));
        assert la.Lookbehind? ==> (dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body)
                                   && bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
                                   && AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1));
        assert res == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1);
        assert 0 <= cp <= |str| by {
          assert cp == AI.get_idx(lk.a_cp, lid) && cp >= 0;   // get_cp(lk,lid)==Some(cp)
          assert AI.get_idx(lk.a_cp, lid) <= |str|;            // LookCpsLE
        }

        // per-lid replay frames / wf / cp / value
        if la.Lookahead? { FFindMatchPlusOvStableNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { FFindMatchPlusOvStableNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert ov1 == ov;
        if la.Lookahead? { ReplayPlusFrameNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusFrameNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.RegsAgreeOutside(capN, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body))) by {
          if result.Some? {} else { assert capN == cap; }
        }
        assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body)) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        // recon A: TIGHT look frame -- the replay writes only body's DIRECT children
        if la.Lookahead? { ReplayPlusLookFrameDirectNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusLookFrameDirectNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.RegsAgreeOutside(nlk, lk, DirectLidSet(body)) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1) by {
          if result.Some? { assert QuantRegsFinal(result.value); }
        }
        if la.Lookahead? { ReplayThreadWfLANested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant); }
        else { ReplayThreadWfLBNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant); }
        assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
               && |nqt.a_cp| == nquant && |nqt.a_clk| == nquant && |nlk.a_cp| == nlook && |nlk.a_clk| == nlook by {
          if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
        }
        if la.Lookahead? { ReplayLookCpOkNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        else { ReplayLookCpOkNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.LookCpsLE(nlk, |str|) by {
          if result.Some? {} else { assert nlk == lk; }
        }

        // value at lid: result ~ rfLid on CaptureRegs(body); iff-together
        if la.Lookahead? { ReplayLidCapAgreeFreshNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant); }
        else { ReplayLidCapAgreeFreshNestedLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant); }
        var rfLid := FreshBodyMatch(crv, str, lid, lk, ov, ncap, nlook, nquant);
        var rf := AI.FFindMatch(bytecode, str,
                                AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                              AReg.init_regs(nquant), 0, AI.cp_context(cp, str, dir)),
                                ov, dir, lookcdn).0;   // (L5 F7c-2) in the lid's own direction
        assert rfLid == rf;

        var Sp := S - PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));

        // ---- recursion hypothesis transfer at [next] with (capN, nlk, nqt) ----
        // (b) matched-look-has-entry for nlk
        assert forall l: int :: next <= l <= maxlook && AReg.get_cp(nlk, l).Some? ==>
                                  exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
        by {
          forall l: int | next <= l <= maxlook && AReg.get_cp(nlk, l).Some?
            ensures exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
          {
            if AReg.get_cp(lk, l).Some? {
            } else {
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
              NewLookInBody(nlk, lk, body, l);
              assert LTB.LookTablesOk(body, crv);
              LookIdEntryExists(body, crv, l as nat);
            }
          }
        }
        // (c') full per-body-unset for capN
        assert forall l: int, la2: R.lookaround, body2: R.regex ::
            next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2) ==>
              CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(body2))
        by {
          forall l: int, la2: R.lookaround, body2: R.regex | next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2)
            ensures CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(body2))
          {
            assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body2));   // (c')@cap
            assert PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) * PIV.CaptureRegs(body2) == {};   // (D-ord) lid<l
            assert CM.RegsAgreeOutside(capN, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
            UnsetOffTransfer(capN, cap, ncap, PIV.CaptureRegs(body2), PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
          }
        }
        // (f) look-stability for nlk
        assert forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
            (next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
            && next <= l2 <= maxlook && l2 != l1 && AReg.get_cp(nlk, l2).Some?) ==> l2 !in LookIdSet(b1)
        by {
          forall l1: int, la1: R.lookaround, b1: R.regex, l2: int |
            next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
            && next <= l2 <= maxlook && l2 != l1 && AReg.get_cp(nlk, l2).Some?
            ensures l2 !in LookIdSet(b1)
          {
            if AReg.get_cp(lk, l2).Some? {
              // (f)@lk
            } else {
              // recon A: l2 newly set => l2 is a DIRECT child of body; (g_new) (lid < l1) => l2 !in LookIds(b1)
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, DirectLidSet(body));
              NewLookInBodyDirect(nlk, lk, body, l2);
              assert (l2 as nat) in DirectLookIds(body);
              assert lid < l1;                                          // l1 >= next
              assert DirectLookIds(body) * LTB.LookIds(b1) == {};       // (g_new) with (lid, l1)
              assert (l2 as nat) !in LTB.LookIds(b1);
              if l2 in LookIdSet(b1) {
                var q: nat :| q in LTB.LookIds(b1) && (q as int) == l2;
                assert q == l2 as nat;
              }
            }
          }
        }
        // (h) well-nested lids for [next] — sub-instance of (h)@lid
        assert forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
            next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) && next <= l2 <= l1 ==> l2 !in LookIdSet(b1);

        FLookLoopValueLiftFull(crv, str, next, maxlook, capN, nlk, nqt, ov1, S, Slook, ncap, nlook, nquant);
        assert res.0 == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1).0;
        assert res.1 == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1).1;
        assert FLookLoopValueOkFull(crv, str, res.0, res.1, next, maxlook, ov, ncap, nlook, nquant);
        assert |res.0.a_cp| == ncap && |res.0.a_clk| == ncap && PIV.CapRegWf(res.0);

        // ---- R3 stability: res.1 agrees with lk at lid ----
        assert forall l1: int, la1: R.lookaround, b1: R.regex ::
            lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> lid !in LookIdSet(b1);   // (h)@lid, l2:=lid
        FLookLoopLidCpStable(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slook);
        assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);

        // ---- suffix frame: res.0 == capN on OuterCaps(body) ----
        assert forall l: int, la2: R.lookaround, body2: R.regex ::
            next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2) ==> FrameEntryOk(crv, la2, body2, Sp, Slook)
        by {
          forall l: int, la2: R.lookaround, body2: R.regex | next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2)
            ensures FrameEntryOk(crv, la2, body2, Sp, Slook)
          {
            assert FrameEntryOk(crv, la2, body2, S, Slook);   // (a)
            assert PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) * PIV.CaptureRegs(body2) == {};   // (D-ord)
            OuterCapsLeCaptureRegs(body2);
            assert PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body2)) <= Sp by {
              forall k: int | k in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body2)) ensures k in Sp {
                assert k in S;
                assert k in PIV.CaptureRegs(body2);   // OuterCaps(body2) <= CaptureRegs(body2)
                assert k !in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) by {
                  if k in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) {
                    assert k in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) * PIV.CaptureRegs(body2);
                  }
                }
              }
            }
          }
        }
        FLookLoopCaptureFrameNested(crv, str, next, maxlook, capN, nlk, nqt, ov1, Sp, Slook);
        assert CM.RegsAgreeOutside(res.0, capN, Sp);
        assert forall k: int :: k in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) ==> k !in Sp;
        RegsAgreeOutsideToInside(res.0, capN, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)), Sp);
        assert CM.RegsAgreeInside(res.0, capN, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));

        // ---- assemble FLookLoopValueOkFull for [lid] keyed on res.1 ----
        forall owner: int | lid <= owner <= maxlook && MatchedPosLA(crv, res.1, owner)
          ensures var rf2 := FreshBodyMatch(crv, str, owner, res.1, ov, ncap, nlook, nquant);
                  (rf2.Some? ==> CM.RegsAgreeInside(res.0, rf2.value.capture_regs,
                                                    PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, owner)))))
                  && (rf2.None? ==> CM.RegsAgreeInside(res.0, AReg.init_regs(ncap),
                                                       PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(VBody(crv, owner)))))
        {
          if owner == lid {
            // re-key lid's coverage from lk onto res.1 via stability
            var rf2 := FreshBodyMatch(crv, str, lid, res.1, ov, ncap, nlook, nquant);
            assert rf2 == rfLid by {
              assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);   // stability
            }
            assert VBody(crv, lid) == body;
            var OC := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));
            OuterCapsLeCaptureRegs(body);
            assert OC <= PIV.CaptureRegs(body);
            if rfLid.Some? {
              assert result.Some? && capN == result.value.capture_regs;
              assert CM.RegsAgreeInside(capN, rf.value.capture_regs, PIV.CaptureRegs(body));
              RegsAgreeInsideWeakenSub(capN, rf.value.capture_regs, OC, PIV.CaptureRegs(body));
              assert CM.RegsAgreeInside(res.0, capN, OC);   // suffix frame
              assert CM.RegsAgreeInside(res.0, rfLid.value.capture_regs, OC);   // chain via capN, rf==rfLid
            } else {
              assert result.None? && capN == cap && rfLid.None?;
              assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body));   // (c')@lid
              RegsAgreeInsideWeakenSub(cap, AReg.init_regs(ncap), OC, PIV.CaptureRegs(body));
              assert CM.RegsAgreeInside(res.0, capN, OC);
              assert CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), OC);
            }
          } else {
            // owner in [next, maxlook]: DIRECT from the IH (already keyed on res.1)
            assert next <= owner <= maxlook;
            assert MatchedPosLA(crv, res.1, owner);
            assert FLookLoopValueOkFull(crv, str, res.0, res.1, next, maxlook, ov, ncap, nlook, nquant);
          }
        }
      }
  }

  /** (DEEP reverse-recon LEVEL-LINK, predicate) Whole-loop child-record link
      keyed on the FINAL look bank `res1`: for EVERY matched positive lookahead
      `l1` (matched in `res1`), the FINAL bank's recorded positions at `l1`'s
      DIRECT-child look ids agree with `l1`'s FRESH body match's own records.
      This is the per-level position tie the deep landing recursion descends on:
      `res1`'s entry at an inner lid `l2` (child of `l1`) IS the position where
      `l1`'s fresh replay crossed `l2`'s gate. */
  ghost predicate FLookLoopChildLinkOk(crv: CP.FCompiled, str: string, res1: AReg.Regs,
                                       lid: int, maxlook: int, ov: LOr.OracleView,
                                       ncap: int, nlook: int, nquant: int) {
    forall l1: int :: lid <= l1 <= maxlook && MatchedPosLA(crv, res1, l1) ==>
                        var rf := FreshBodyMatch(crv, str, l1, res1, ov, ncap, nlook, nquant);
                        rf.Some? ==>
                          forall l2: int :: l2 in DirectLidSet(VBody(crv, l1)) ==>
                                              AReg.get_cp(res1, l2) == AReg.get_cp(rf.value.look_regs, l2)
                                              && AI.get_idx(res1.a_clk, l2) == AI.get_idx(rf.value.look_regs.a_clk, l2)
  }

  /** `l1 == lid` is not matched in `res1`, so the child-link map for
      `[lid, maxlook]` is exactly the one for `[lid+1, maxlook]`. */
  lemma ChildLinkSkipLid(crv: CP.FCompiled, str: string, res1: AReg.Regs, lid: int, maxlook: int,
                         ov: LOr.OracleView, ncap: int, nlook: int, nquant: int)
    requires FLookLoopChildLinkOk(crv, str, res1, lid + 1, maxlook, ov, ncap, nlook, nquant)
    requires !MatchedPosLA(crv, res1, lid)
    ensures FLookLoopChildLinkOk(crv, str, res1, lid, maxlook, ov, ncap, nlook, nquant)
  {
    forall l1: int | lid <= l1 <= maxlook && MatchedPosLA(crv, res1, l1)
      ensures var rf := FreshBodyMatch(crv, str, l1, res1, ov, ncap, nlook, nquant);
              rf.Some? ==>
                forall l2: int :: l2 in DirectLidSet(VBody(crv, l1)) ==>
                                    AReg.get_cp(res1, l2) == AReg.get_cp(rf.value.look_regs, l2)
                                    && AI.get_idx(res1.a_clk, l2) == AI.get_idx(rf.value.look_regs.a_clk, l2)
    { assert l1 != lid; }
  }

  /** (DEEP reverse-recon LEVEL-LINK, lift) THE whole-loop child-record link.
      Mirrors `FLookLoopValueLiftFull`'s induction verbatim with the SAME
      hypotheses (a)-(h) PLUS (c'-look): the incoming look bank is still INITIAL
      at every row's DIRECT-child ids (main code gates only on TOP lids, so this
      holds at the loop entry; the replay writes only the CURRENT row's direct
      children, disjoint from every later row's — (g_new) — so it transfers).
      At the matched row `lid`: the tail fold leaves `lid`'s direct children
      untouched (`FLookLoopTopLookCpStableFull` at each child, via (g_new)), the
      iteration's banks ARE the replay winner's, and the replay agrees with the
      FRESH match on the direct children (`ReplayLidLookAgreeFreshNested` at
      `SL := DirectLidSet(body)`) — so the FINAL bank's child records are the
      fresh match's. Rows above `lid` come from the IH keyed on `res.1`. */
  lemma {:isolate_assertions} FLookLoopChildLinkLift(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                                                     cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                                     S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>                // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (c') full per-body-unset
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (c'-look) child-unset
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(lk, AReg.init_regs(nlook), DirectLidSet(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (D-ord)
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (f) look-stability
               (lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
               && lid <= l2 <= maxlook && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (g_new)
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (h) well-nested lids
               lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) && lid <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            FLookLoopChildLinkOk(crv, str, res.1, lid, maxlook, ov, ncap, nlook, nquant)
    decreases maxlook - lid
  {
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    if lid > maxlook {
      return;
    }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
      FLookLoopChildLinkLift(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
      assert forall l1: int, la1: R.lookaround, b1: R.regex ::
          lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> lid !in LookIdSet(b1);   // (h)@lid, l2:=lid
      FLookLoopLidCpStable(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slook);
      assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);
      assert !MatchedPosLA(crv, res.1, lid);
      ChildLinkSkipLid(crv, str, res.1, lid, maxlook, ov, ncap, nlook, nquant);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
        FLookLoopChildLinkLift(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
        assert !MatchedPosLA(crv, res.1, lid);   // !capture_type(looktype), looktype == f_look_types[lid]
        ChildLinkSkipLid(crv, str, res.1, lid, maxlook, ov, ncap, nlook, nquant);
      } else {
        var la: R.lookaround, body: R.regex :| LTB.LookEntryOk(crv, lid, la, body);
        assert 0 <= lid < |crv.f_look_types| && crv.f_look_types[lid] == la;
        assert looktype == la;
        assert body == VBody(crv, lid);
        assert FrameEntryOk(crv, la, body, S, Slook);
        assert la.Lookahead? || la.Lookbehind?;            // (L5 F7c-2) capture_type
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var capN := if result.None? then cap else result.value.capture_regs;
        var nlk := if result.None? then lk else result.value.look_regs;
        var nqt := if result.None? then qt else result.value.quant_regs;
        // (L5 F7c-2) per-kind replay facts (the `...LB` twins take the BACKWARD ones)
        assert la.Lookahead? ==> (dir == LAnc.Forward && CP.capture_regex(la, body) == body
                                  && bytecode == CP.compile_to_bytecode(body)
                                  && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp));
        assert la.Lookbehind? ==> (dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body)
                                   && bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
                                   && AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1));
        assert res == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1);
        assert 0 <= cp <= |str| by {
          assert cp == AI.get_idx(lk.a_cp, lid) && cp >= 0;   // get_cp(lk,lid)==Some(cp)
          assert AI.get_idx(lk.a_cp, lid) <= |str|;            // LookCpsLE
        }

        // per-lid replay frames / wf / cp (verbatim from FLookLoopValueLiftFull)
        if la.Lookahead? { FFindMatchPlusOvStableNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { FFindMatchPlusOvStableNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert ov1 == ov;
        if la.Lookahead? { ReplayPlusFrameNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusFrameNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.RegsAgreeOutside(capN, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body))) by {
          if result.Some? {} else { assert capN == cap; }
        }
        assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body)) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        if la.Lookahead? { ReplayPlusLookFrameDirectNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusLookFrameDirectNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.RegsAgreeOutside(nlk, lk, DirectLidSet(body)) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1) by {
          if result.Some? { assert QuantRegsFinal(result.value); }
        }
        if la.Lookahead? { ReplayThreadWfLANested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant); }
        else { ReplayThreadWfLBNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant); }
        assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
               && |nqt.a_cp| == nquant && |nqt.a_clk| == nquant && |nlk.a_cp| == nlook && |nlk.a_clk| == nlook by {
          if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
        }
        if la.Lookahead? { ReplayLookCpOkNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        else { ReplayLookCpOkNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.LookCpsLE(nlk, |str|) by {
          if result.Some? {} else { assert nlk == lk; }
        }

        // THE level-link engine step: replay ~ fresh on lid's DIRECT children
        if la.Lookahead? { ReplayLidLookAgreeFreshNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, DirectLidSet(body), ncap, nlook, nquant); }
        else { ReplayLidLookAgreeFreshNestedLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, DirectLidSet(body), ncap, nlook, nquant); }
        var rfLid := FreshBodyMatch(crv, str, lid, lk, ov, ncap, nlook, nquant);
        var rf := AI.FFindMatch(bytecode, str,
                                AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                              AReg.init_regs(nquant), 0, AI.cp_context(cp, str, dir)),
                                ov, dir, lookcdn).0;   // (L5 F7c-2) in the lid's own direction
        assert rfLid == rf;

        // ---- recursion hypothesis transfer at [next] (verbatim + (c'-look)) ----
        // (b) matched-look-has-entry for nlk
        assert forall l: int :: next <= l <= maxlook && AReg.get_cp(nlk, l).Some? ==>
                                  exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
        by {
          forall l: int | next <= l <= maxlook && AReg.get_cp(nlk, l).Some?
            ensures exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
          {
            if AReg.get_cp(lk, l).Some? {
            } else {
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
              NewLookInBody(nlk, lk, body, l);
              assert LTB.LookTablesOk(body, crv);
              LookIdEntryExists(body, crv, l as nat);
            }
          }
        }
        // (c') full per-body-unset for capN
        assert forall l: int, la2: R.lookaround, body2: R.regex ::
            next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2) ==>
              CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(body2))
        by {
          forall l: int, la2: R.lookaround, body2: R.regex | next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2)
            ensures CM.RegsAgreeInside(capN, AReg.init_regs(ncap), PIV.CaptureRegs(body2))
          {
            assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body2));   // (c')@cap
            assert PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)) * PIV.CaptureRegs(body2) == {};   // (D-ord) lid<l
            assert CM.RegsAgreeOutside(capN, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
            UnsetOffTransfer(capN, cap, ncap, PIV.CaptureRegs(body2), PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
          }
        }
        // (c'-look) child-unset for nlk: the replay writes only lid's direct
        // children, disjoint from every later row's ((g_new) at (lid, l)).
        assert forall l: int, la2: R.lookaround, body2: R.regex ::
            next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2) ==>
              CM.RegsAgreeInside(nlk, AReg.init_regs(nlook), DirectLidSet(body2))
        by {
          forall l: int, la2: R.lookaround, body2: R.regex | next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2)
            ensures CM.RegsAgreeInside(nlk, AReg.init_regs(nlook), DirectLidSet(body2))
          {
            assert CM.RegsAgreeInside(lk, AReg.init_regs(nlook), DirectLidSet(body2));   // (c'-look)@lk
            assert DirectLookIds(body) * LTB.LookIds(body2) == {};                       // (g_new)@(lid, l)
            forall k: int | k in DirectLidSet(body2)
              ensures AI.get_idx(nlk.a_cp, k) == AI.get_idx(AReg.init_regs(nlook).a_cp, k)
                      && AI.get_idx(nlk.a_clk, k) == AI.get_idx(AReg.init_regs(nlook).a_clk, k)
            {
              var kn: nat :| kn in DirectLookIds(body2) && (kn as int) == k;
              DirectLidsSubLookIds(body2);
              assert kn in LTB.LookIds(body2);
              assert kn !in DirectLookIds(body) by {
                if kn in DirectLookIds(body) { assert kn in DirectLookIds(body) * LTB.LookIds(body2); }
              }
              assert k !in DirectLidSet(body) by {
                if k in DirectLidSet(body) {
                  var kn2: nat :| kn2 in DirectLookIds(body) && (kn2 as int) == k;
                  assert kn2 == kn;
                }
              }
              assert AI.get_idx(nlk.a_cp, k) == AI.get_idx(lk.a_cp, k)
                     && AI.get_idx(nlk.a_clk, k) == AI.get_idx(lk.a_clk, k);   // frame off DirectLidSet(body)
            }
          }
        }
        // (f) look-stability for nlk
        assert forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
            (next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
            && next <= l2 <= maxlook && l2 != l1 && AReg.get_cp(nlk, l2).Some?) ==> l2 !in LookIdSet(b1)
        by {
          forall l1: int, la1: R.lookaround, b1: R.regex, l2: int |
            next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
            && next <= l2 <= maxlook && l2 != l1 && AReg.get_cp(nlk, l2).Some?
            ensures l2 !in LookIdSet(b1)
          {
            if AReg.get_cp(lk, l2).Some? {
              // (f)@lk
            } else {
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, DirectLidSet(body));
              NewLookInBodyDirect(nlk, lk, body, l2);
              assert (l2 as nat) in DirectLookIds(body);
              assert lid < l1;                                          // l1 >= next
              assert DirectLookIds(body) * LTB.LookIds(b1) == {};       // (g_new) with (lid, l1)
              assert (l2 as nat) !in LTB.LookIds(b1);
              if l2 in LookIdSet(b1) {
                var q: nat :| q in LTB.LookIds(b1) && (q as int) == l2;
                assert q == l2 as nat;
              }
            }
          }
        }
        // (h) well-nested lids for [next] — sub-instance of (h)@lid
        assert forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
            next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) && next <= l2 <= l1 ==> l2 !in LookIdSet(b1);

        FLookLoopChildLinkLift(crv, str, next, maxlook, capN, nlk, nqt, ov1, S, Slook, ncap, nlook, nquant);
        assert res.1 == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1).1;
        assert FLookLoopChildLinkOk(crv, str, res.1, next, maxlook, ov, ncap, nlook, nquant);

        // ---- stability: res.1 agrees with lk at lid ----
        assert forall l1: int, la1: R.lookaround, b1: R.regex ::
            lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> lid !in LookIdSet(b1);   // (h)@lid, l2:=lid
        FLookLoopLidCpStable(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slook);
        assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);

        // ---- assemble the child-link for [lid] keyed on res.1 ----
        forall l1: int | lid <= l1 <= maxlook && MatchedPosLA(crv, res.1, l1)
          ensures var rf2 := FreshBodyMatch(crv, str, l1, res.1, ov, ncap, nlook, nquant);
                  rf2.Some? ==>
                    forall l2: int :: l2 in DirectLidSet(VBody(crv, l1)) ==>
                                        AReg.get_cp(res.1, l2) == AReg.get_cp(rf2.value.look_regs, l2)
                                        && AI.get_idx(res.1.a_clk, l2) == AI.get_idx(rf2.value.look_regs.a_clk, l2)
        {
          if l1 == lid {
            var rf2 := FreshBodyMatch(crv, str, lid, res.1, ov, ncap, nlook, nquant);
            assert rf2 == rfLid by {
              assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);   // stability
            }
            assert VBody(crv, lid) == body;
            if rf2.Some? {
              assert result.Some? by {
                // iff-together from the look-agreement lemma's None-iff
                assert rfLid.Some?;
              }
              assert nlk == result.value.look_regs;
              assert CM.RegsAgreeInside(result.value.look_regs, rf.value.look_regs, DirectLidSet(body));
              forall l2: int | l2 in DirectLidSet(body)
                ensures AReg.get_cp(res.1, l2) == AReg.get_cp(rf2.value.look_regs, l2)
                        && AI.get_idx(res.1.a_clk, l2) == AI.get_idx(rf2.value.look_regs.a_clk, l2)
              {
                // tail fold leaves l2 untouched: (h')@l2 on [next..] from (g_new)@(lid, ·)
                assert forall l1': int, la1': R.lookaround, b1': R.regex ::
                    next <= l1' <= maxlook && LTB.LookEntryOk(crv, l1', la1', b1') ==> l2 !in LookIdSet(b1')
                by {
                  forall l1': int, la1': R.lookaround, b1': R.regex |
                    next <= l1' <= maxlook && LTB.LookEntryOk(crv, l1', la1', b1')
                    ensures l2 !in LookIdSet(b1')
                  {
                    assert DirectLookIds(body) * LTB.LookIds(b1') == {};   // (g_new)@(lid, l1')
                    var kn: nat :| kn in DirectLookIds(body) && (kn as int) == l2;
                    assert kn !in LTB.LookIds(b1');
                    if l2 in LookIdSet(b1') {
                      var q: nat :| q in LTB.LookIds(b1') && (q as int) == l2;
                      assert q == kn;
                    }
                  }
                }
                FLookLoopTopLookCpStableFull(crv, str, next, maxlook, l2, capN, nlk, nqt, ov1, S, Slook);
                FLookLoopTopLookClkStableFull(crv, str, next, maxlook, l2, capN, nlk, nqt, ov1, S, Slook);
                assert AReg.get_cp(res.1, l2) == AReg.get_cp(nlk, l2);
                assert AI.get_idx(res.1.a_clk, l2) == AI.get_idx(nlk.a_clk, l2);
                // replay winner == fresh at l2 (RegsAgreeInside -> get_cp + clk)
                assert AI.get_idx(result.value.look_regs.a_cp, l2) == AI.get_idx(rf.value.look_regs.a_cp, l2);
                assert AI.get_idx(result.value.look_regs.a_clk, l2) == AI.get_idx(rf.value.look_regs.a_clk, l2);
                GetCpAgreeIdx(result.value.look_regs, rf.value.look_regs, l2);
                assert AReg.get_cp(nlk, l2) == AReg.get_cp(rf.value.look_regs, l2);
                assert rf2.value.look_regs == rf.value.look_regs;   // rf2 == rfLid == rf
              }
            }
          } else {
            assert next <= l1 <= maxlook;
            assert FLookLoopChildLinkOk(crv, str, res.1, next, maxlook, ov, ncap, nlook, nquant);
          }
        }
      }
  }

  /** (DEEP reverse-recon) the REVERSE look-bank invariant (clk-set ==> cp-set)
      is preserved through the WHOLE `FLookLoop` fold: each iteration replaces
      the banks with an `FFindMatchPlus` winner, whose `FFindMatch` run preserves
      `CM.VmLookCpSet` (cp and clock land in the same CheckOracle `set_reg`) and
      whose `FReconstructPlus` is the identity on the `QuantRegsFinal` result.
      With `PathPresentLk`'s ancestor look-clock conjunct, this recovers
      `MatchedPosLA(crv, res.1, A)` for EVERY look-ancestor `A` of a live inside
      capture — at ANY depth (the top-level reverse invariant `CM.FFindMatch
      LookCpSet` covers only the main match / top lids). */
  lemma FLookLoopLookCpSet(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                           cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                           S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires CM.LookCpSetWithClk(lk)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>                // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    ensures CM.LookCpSetWithClk(AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov).1)
    ensures CM.LookCpsLE(AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov).1, |str|)
    decreases maxlook - lid
  {
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    if lid > maxlook {
      return;
    }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      FLookLoopLookCpSet(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        FLookLoopLookCpSet(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
      } else {
        var la: R.lookaround, body: R.regex :| LTB.LookEntryOk(crv, lid, la, body);
        assert 0 <= lid < |crv.f_look_types| && crv.f_look_types[lid] == la;
        assert looktype == la;
        assert FrameEntryOk(crv, la, body, S, Slook);
        assert la.Lookahead? || la.Lookbehind?;            // (L5 F7c-2) capture_type
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var capN := if result.None? then cap else result.value.capture_regs;
        var nlk := if result.None? then lk else result.value.look_regs;
        var nqt := if result.None? then qt else result.value.quant_regs;
        // (L5 F7c-2) per-kind replay facts (the `...LB` twins take the BACKWARD ones)
        assert la.Lookahead? ==> (dir == LAnc.Forward && CP.capture_regex(la, body) == body
                                  && bytecode == CP.compile_to_bytecode(body)
                                  && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp));
        assert la.Lookbehind? ==> (dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body)
                                   && bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
                                   && AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1));
        assert res == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1);
        assert 0 <= cp <= |str| by {
          assert cp == AI.get_idx(lk.a_cp, lid) && cp >= 0;
          assert AI.get_idx(lk.a_cp, lid) <= |str|;         // LookCpsLE
        }

        // the winner's look bank keeps the reverse invariant
        var ctxc := AI.cp_context(cp, str, dir);
        var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctxc);
        assert CM.VmLookCpSet(inits) by {
          assert AI.init_thread(cap, lk, qt).look_regs == lk;
          assert inits.active == [AI.init_thread(cap, lk, qt)];
        }
        if la.Lookahead? { assert ctxc.nextchar == AI.get_char(str, cp); }
        else { assert ctxc.nextchar == AI.get_char(str, cp - 1); }
        if la.Lookahead? { CM.FFindMatchLookCpSet(bytecode, str, inits, ov, dir, lookcdn); }
        else { CM.FFindMatchLookCpSetB(bytecode, str, inits, ov, dir, lookcdn); }
        if la.Lookahead? { NoTrueQuantStampNested(body); }
        else { ReverseNestedPackage(body); NoTrueQuantStampNested(R.reverse_regex(body)); }
        assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
        FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
        var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
        if fmres.Some? {
          FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                              crv.f_plus_bc, str, ovx, dir);
        }
        assert CM.LookCpSetWithClk(nlk) by {
          if result.Some? { assert nlk == fmres.value.look_regs; } else { assert nlk == lk; }
        }
        assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1) by {
          if result.Some? { assert QuantRegsFinal(result.value); }
        }
        if la.Lookahead? { ReplayThreadWfLANested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant); }
        else { ReplayThreadWfLBNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant); }
        assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
               && |nqt.a_cp| == nquant && |nqt.a_clk| == nquant && |nlk.a_cp| == nlook && |nlk.a_clk| == nlook by {
          if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
        }
        if la.Lookahead? { ReplayLookCpOkNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        else { ReplayLookCpOkNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.LookCpsLE(nlk, |str|) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        // (b)@nlk (verbatim transfer)
        if la.Lookahead? { ReplayPlusFrameNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusFrameNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert forall l: int :: next <= l <= maxlook && AReg.get_cp(nlk, l).Some? ==>
                                  exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
        by {
          forall l: int | next <= l <= maxlook && AReg.get_cp(nlk, l).Some?
            ensures exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
          {
            if AReg.get_cp(lk, l).Some? {
            } else {
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
              NewLookInBody(nlk, lk, body, l);
              assert LTB.LookTablesOk(body, crv);
              LookIdEntryExists(body, crv, l as nat);
            }
          }
        }
        FLookLoopLookCpSet(crv, str, next, maxlook, capN, nlk, nqt, ov1, S, Slook, ncap, nlook, nquant);
      }
  }

  /** (DEEP reverse-recon) `LookCpsOracleTrue` — every recorded look cp is an
      ORACLE-TRUE position — is preserved through the WHOLE `FLookLoop` fold:
      each iteration's banks are an `FFindMatchPlus` winner over WRITE-FREE body
      code (`NoWriteOracleBodyCodeNested`), so the per-run invariant
      (`CM.FFindMatchLookOracleTrue`) carries, and `FReconstructPlus` is the
      identity. With `OracleOkAt` (bit ⟺ the spec body matches there), this
      makes EVERY `res.1`-recorded position — any depth — a position where the
      recorded look's SPEC BODY TREE has a leaf: the `rf.Some?`/`FirstLeaf.Some?`
      feed of the deep landing recursion at every level. */
  lemma FLookLoopLookOracleTrue(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                                cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires CM.LookCpsOracleTrue(lk, ov)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>                // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    ensures CM.LookCpsOracleTrue(AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov).1, ov)
    decreases maxlook - lid
  {
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    if lid > maxlook {
      return;
    }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      FLookLoopLookOracleTrue(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        FLookLoopLookOracleTrue(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
      } else {
        var la: R.lookaround, body: R.regex :| LTB.LookEntryOk(crv, lid, la, body);
        assert 0 <= lid < |crv.f_look_types| && crv.f_look_types[lid] == la;
        assert looktype == la;
        assert FrameEntryOk(crv, la, body, S, Slook);
        assert la.Lookahead? || la.Lookbehind?;            // (L5 F7c-2) capture_type
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var capN := if result.None? then cap else result.value.capture_regs;
        var nlk := if result.None? then lk else result.value.look_regs;
        var nqt := if result.None? then qt else result.value.quant_regs;
        // (L5 F7c-2) per-kind replay facts (the `...LB` twins take the BACKWARD ones)
        assert la.Lookahead? ==> (dir == LAnc.Forward && CP.capture_regex(la, body) == body
                                  && bytecode == CP.compile_to_bytecode(body)
                                  && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp));
        assert la.Lookbehind? ==> (dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body)
                                   && bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
                                   && AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1));
        assert res == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1);
        assert 0 <= cp <= |str| by {
          assert cp == AI.get_idx(lk.a_cp, lid) && cp >= 0;
          assert AI.get_idx(lk.a_cp, lid) <= |str|;         // LookCpsLE
        }

        // the oracle is stable through the replay; the winner keeps OracleTrue
        if la.Lookahead? { FFindMatchPlusOvStableNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { FFindMatchPlusOvStableNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert ov1 == ov;
        var ctxc := AI.cp_context(cp, str, dir);
        var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, ctxc);
        assert CM.VmLookOracleTrue(inits, ov) by {
          assert AI.init_thread(cap, lk, qt).look_regs == lk;
          assert inits.active == [AI.init_thread(cap, lk, qt)];
        }
        if la.Lookahead? { assert ctxc.nextchar == AI.get_char(str, cp); }
        else { assert ctxc.nextchar == AI.get_char(str, cp - 1); }
        if la.Lookahead? { NoWriteOracleBodyCodeNested(body); }
        else { ReverseNestedPackage(body); NoWriteOracleBodyCodeNested(R.reverse_regex(body)); }
        if la.Lookahead? { CM.FFindMatchLookOracleTrue(bytecode, str, inits, ov, dir, lookcdn); }
        else { CM.FFindMatchLookOracleTrueB(bytecode, str, inits, ov, dir, lookcdn); }
        if la.Lookahead? { NoTrueQuantStampNested(body); }
        else { ReverseNestedPackage(body); NoTrueQuantStampNested(R.reverse_regex(body)); }
        assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
        FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
        var (fmres, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
        if fmres.Some? {
          FNulledPlusIdentity(body, fmres.value.capture_regs, fmres.value.look_regs, fmres.value.quant_regs,
                              crv.f_plus_bc, str, ovx, dir);
        }
        assert CM.LookCpsOracleTrue(nlk, ov) by {
          if result.Some? { assert nlk == fmres.value.look_regs; } else { assert nlk == lk; }
        }
        assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1) by {
          if result.Some? { assert QuantRegsFinal(result.value); }
        }
        if la.Lookahead? { ReplayThreadWfLANested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant); }
        else { ReplayThreadWfLBNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant); }
        assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
               && |nqt.a_cp| == nquant && |nqt.a_clk| == nquant && |nlk.a_cp| == nlook && |nlk.a_clk| == nlook by {
          if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
        }
        if la.Lookahead? { ReplayLookCpOkNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        else { ReplayLookCpOkNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.LookCpsLE(nlk, |str|) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        // (b)@nlk (verbatim transfer)
        if la.Lookahead? { ReplayPlusFrameNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusFrameNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert forall l: int :: next <= l <= maxlook && AReg.get_cp(nlk, l).Some? ==>
                                  exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
        by {
          forall l: int | next <= l <= maxlook && AReg.get_cp(nlk, l).Some?
            ensures exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
          {
            if AReg.get_cp(lk, l).Some? {
            } else {
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
              NewLookInBody(nlk, lk, body, l);
              assert LTB.LookTablesOk(body, crv);
              LookIdEntryExists(body, crv, l as nat);
            }
          }
        }
        FLookLoopLookOracleTrue(crv, str, next, maxlook, capN, nlk, nqt, ov1, S, Slook, ncap, nlook, nquant);
      }
  }

  /** R3 DELIVERABLE 2 (DefGroups coverage corollary): under the whole-regex
      setup, EVERY inside-look group `g` whose innermost-DIRECT owner is matched
      in the FINAL look bank `res.1` has `res.0` carrying `g` at that owner's
      FRESH-body-match value. The bridge the seam `LkReplayMatchesSpecNestedFull`'s
      `recon_inner`/`recon_outer` premises consume. Proof: the `owner` guard is
      exactly `NI.InnermostOwnerDirect`'s three facts (`owner in LookIds(re)`,
      `g in CapIds(body_owner)`, `g !in CapIdsInLooks(body_owner)`); `VBodyEq
      LookBody` translates the table body to the structural body, `CapIdsSplit`
      places `g` in `CapIdsOutsideLooks(VBody(crv,owner))`, so `g`'s registers sit
      in `owner`'s OUTSIDE-look capture set; then DELIVERABLE 1
      (`FLookLoopValueLiftFull`) at `owner` supplies the value, weakened onto
      `CaptureRegsSet({g})`. Takes deliverable 1's hypotheses (a)-(h) as premises
      (the seam discharges them from the compilation's uniqueness + outer-before-
      inner ordering, as in `LookRowsFromTablesL3a`). */
  lemma FLookLoopFullCoversInLooks(crv: CP.FCompiled, str: string, ast: R.regex, re: R.regex,
                                   cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                   S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int, g: nat)
    // ---- whole-regex setup ----
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookTablesOk(re, crv)
    requires PIV.CapUnique(re) && LTB.LookUnique(re)
    requires g in PIV.CapIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)   // lid range
    // ---- deliverable-1 hypotheses (a)-(h) at lid=1, maxlook=max_lookaround(ast) ----
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(lk, l).Some? ==>    // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (c')
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (D-ord)
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (f)
               (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
               && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (g_new)
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (h)
               1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
            forall owner: nat :: owner in LTB.LookIds(re)
                                 && g in PIV.CapIds(NI.LookBodyOfRE(re, owner))
                                 && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
                                 && MatchedPosLA(crv, res.1, owner) ==>
                                   var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
                                   (rf.Some? ==> CM.RegsAgreeInside(res.0, rf.value.capture_regs, PIV.CaptureRegsSet({g})))
                                   && (rf.None? ==> CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), PIV.CaptureRegsSet({g})))
  {
    var maxlook := R.max_lookaround(ast);
    FLookLoopValueLiftFull(crv, str, 1, maxlook, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant);
    var res := AI.FLookLoop(crv, str, 1, maxlook, cap, lk, qt, ov);
    assert FLookLoopValueOkFull(crv, str, res.0, res.1, 1, maxlook, ov, ncap, nlook, nquant);

    forall owner: nat | owner in LTB.LookIds(re)
                        && g in PIV.CapIds(NI.LookBodyOfRE(re, owner))
                        && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
                        && MatchedPosLA(crv, res.1, owner)
      ensures var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
              (rf.Some? ==> CM.RegsAgreeInside(res.0, rf.value.capture_regs, PIV.CaptureRegsSet({g})))
              && (rf.None? ==> CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), PIV.CaptureRegsSet({g})))
    {
      // owner lands in the fold range [1, maxlook]
      assert 1 <= (owner as int) <= maxlook;                    // lid-range premise
      // table body == structural body; g sits OUTSIDE looks of it
      VBodyEqLookBody(crv, re, owner);
      var body := VBody(crv, owner as int);
      assert body == NI.LookBodyOfRE(re, owner);
      assert g in PIV.CapIds(body) && g !in PIV.CapIdsInLooks(body);
      PIV.CapIdsSplit(body);
      assert g in PIV.CapIdsOutsideLooks(body);
      // g's registers sit in owner's OUTSIDE-look capture set
      PIV.CaptureRegsSetMono({g}, PIV.CapIdsOutsideLooks(body));
      assert PIV.CaptureRegsSet({g}) <= PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));
      // deliverable 1 at owner supplies the value; weaken onto {g}
      var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
      if rf.Some? {
        assert CM.RegsAgreeInside(res.0, rf.value.capture_regs,
                                  PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
        RegsAgreeInsideWeakenSub(res.0, rf.value.capture_regs,
                                 PIV.CaptureRegsSet({g}), PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
      } else {
        assert CM.RegsAgreeInside(res.0, AReg.init_regs(ncap),
                                  PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
        RegsAgreeInsideWeakenSub(res.0, AReg.init_regs(ncap),
                                 PIV.CaptureRegsSet({g}), PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body)));
      }
    }
  }

  /** The array-backed init register bank's clock is `-1` (unset) at EVERY
      index — in range (`seq(n, _ => -1)`) or off the end (`get_idx` returns
      `-1`). The "cap is unset at `g`" fact the reverse-liveness converse needs. */
  lemma InitRegsClkUnset(n: int, k: int)
    ensures AI.get_idx(AReg.init_regs(n).a_clk, k) == -1
  {
    if 0 <= k < |AReg.init_regs(n).a_clk| { }
  }

  /** UNIQUENESS of the innermost-DIRECT owner: if `l` ALSO owns `g` directly
      (its body holds `g` outside its own looks), then `l == owner0`. Suppose
      not; `NestedGWriteFrame` places `owner0` inside a look of `l`'s body, so
      (`LookBodyCompose` + `LookBodyCapsIn`) `g in CapIds(body_owner0) <=
      CapIdsInLooks(body_l)` — contradicting `g !in CapIdsInLooks(body_l)`. */
  lemma InnermostOwnerUnique(re: R.regex, g: nat, owner0: nat, l: nat)
    requires PIV.CapUnique(re) && LTB.LookUnique(re)
    requires g in PIV.CapIdsInLooks(re)
    requires owner0 in LTB.LookIds(re) && g in PIV.CapIds(NI.LookBodyOfRE(re, owner0))
             && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner0))
    requires l in LTB.LookIds(re) && g in PIV.CapIds(NI.LookBodyOfRE(re, l))
             && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, l))
    ensures l == owner0
  {
    if l != owner0 {
      NI.NestedGWriteFrame(re, g, owner0, l);              // owner0 in LookIds(LookBodyOfRE(re, l))
      NI.LookBodyCompose(re, l, owner0);                   // LookBodyOfRE(re,owner0)==LookBodyOfRE(LookBodyOfRE(re,l),owner0)
      NI.LookBodyCapsIn(NI.LookBodyOfRE(re, l), owner0);   // CapIds(that) <= CapIdsInLooks(body_l)
      assert g in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, l));   // contradiction
    }
  }

  /** REVERSE-LIVENESS FRAME (contrapositive engine step): the fold LEAVES `g`'s
      start register at its incoming `cap` value — provided the unique innermost
      owner `owner0` of `g` did NOT match in the final look bank. The register is
      written at a step only when that step's replay RUNS and its body owns `g`
      OUTSIDE its looks (`g in CapIdsOutsideLooks(body)`); by uniqueness only
      `owner0`'s step qualifies, and if that step ran it would force
      `MatchedPosLA(res.1, owner0)` (via `FLookLoopLidCpStable`) — ruled out by
      the hypothesis. Mirrors `FLookLoopCaptureFrameNested`'s induction (same
      per-step frame/`(b)`-transfer machinery), tracking a single register plus
      the owner exception. `decreases maxlook - lid`. */
  lemma {:isolate_assertions} FLookLoopGRegUnsetFrame(
    crv: CP.FCompiled, str: string, lid: int, maxlook: int,
    cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
    S: set<int>, Slook: set<int>, g: nat, owner0: nat)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                       // (h)
               lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) && lid <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                // uniqueness of owner0
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) && g in PIV.CapIdsOutsideLooks(body) ==> l == owner0
    requires !MatchedPosLA(crv, AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov).1, owner0)
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            AI.get_idx(res.0.a_cp, CP.start_reg(g)) == AI.get_idx(cap.a_cp, CP.start_reg(g))
            && AI.get_idx(res.0.a_clk, CP.start_reg(g)) == AI.get_idx(cap.a_clk, CP.start_reg(g))
    decreases maxlook - lid
  {
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    if lid > maxlook {
      assert res.0 == cap;
      return;
    }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
      FLookLoopGRegUnsetFrame(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, g, owner0);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
        FLookLoopGRegUnsetFrame(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, g, owner0);
      } else {
        var la: R.lookaround, body: R.regex :| LTB.LookEntryOk(crv, lid, la, body);
        assert 0 <= lid < |crv.f_look_types| && crv.f_look_types[lid] == la;
        assert looktype == la;
        assert FrameEntryOk(crv, la, body, S, Slook);
        assert la.Lookahead? || la.Lookbehind?;            // (L5 F7c-2) capture_type
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var capN := if result.None? then cap else result.value.capture_regs;
        var nlk := if result.None? then lk else result.value.look_regs;
        var nqt := if result.None? then qt else result.value.quant_regs;
        // (L5 F7c-2) per-kind replay facts (the `...LB` twins take the BACKWARD ones)
        assert la.Lookahead? ==> (dir == LAnc.Forward && CP.capture_regex(la, body) == body
                                  && bytecode == CP.compile_to_bytecode(body)
                                  && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp));
        assert la.Lookbehind? ==> (dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body)
                                   && bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
                                   && AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1));
        assert res == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1);
        if la.Lookahead? { ReplayPlusFrameNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusFrameNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }

        if g in PIV.CapIdsOutsideLooks(body) {
          // this step OWNS g -> it is owner0 (uniqueness); it RAN -> owner0 matched -> contradiction
          assert lid == owner0;
          assert forall l1: int, la1: R.lookaround, b1: R.regex ::
              lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> lid !in LookIdSet(b1);   // (h)@lid
          FLookLoopLidCpStable(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slook);
          assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);
          assert MatchedPosLA(crv, res.1, lid);
          assert MatchedPosLA(crv, res.1, owner0);
          assert false;
        } else {
          // this step does NOT write start_reg(g)
          assert CM.RegsAgreeOutside(capN, cap, PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body))) by {
            if result.Some? {} else { assert capN == cap; }
          }
          PIV.StartRegInCaptureRegsSet(PIV.CapIdsOutsideLooks(body), g);
          assert CP.start_reg(g) !in PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));
          assert AI.get_idx(capN.a_cp, CP.start_reg(g)) == AI.get_idx(cap.a_cp, CP.start_reg(g));
          assert AI.get_idx(capN.a_clk, CP.start_reg(g)) == AI.get_idx(cap.a_clk, CP.start_reg(g));

          // ---- transfer hypotheses to [next] with (capN, nlk, nqt, ov1) ----
          assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1) by {
            if result.Some? { assert QuantRegsFinal(result.value); }
          }
          assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body)) by {
            if result.Some? {} else { assert nlk == lk; }
          }
          assert forall l: int :: next <= l <= maxlook && AReg.get_cp(nlk, l).Some? ==>
                                    exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
          by {
            forall l: int | next <= l <= maxlook && AReg.get_cp(nlk, l).Some?
              ensures exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
            {
              if AReg.get_cp(lk, l).Some? {
              } else {
                assert result.Some?;
                assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
                assert AI.get_idx(nlk.a_cp, l) >= 0;
                assert AI.get_idx(lk.a_cp, l) < 0;
                assert l in LookIdSet(body);
                assert (l as nat) in LTB.LookIds(body);
                assert LTB.LookTablesOk(body, crv);
                LookIdEntryExists(body, crv, l as nat);
              }
            }
          }
          assert !MatchedPosLA(crv, AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1).1, owner0);
          FLookLoopGRegUnsetFrame(crv, str, next, maxlook, capN, nlk, nqt, ov1, S, Slook, g, owner0);
          assert AI.get_idx(res.0.a_cp, CP.start_reg(g)) == AI.get_idx(capN.a_cp, CP.start_reg(g));
          assert AI.get_idx(res.0.a_clk, CP.start_reg(g)) == AI.get_idx(capN.a_clk, CP.start_reg(g));
        }
      }
  }

  /** REVERSE LIVENESS CONVERSE (companion to `FLookLoopFullCoversInLooks`):
      an in-look capture `g` that the fold left LIVE (`res.0`'s clock >= 0 at
      `start_reg(g)`) forces its unique innermost-DIRECT owner to have MATCHED
      in the final look bank. Contrapositive of the reverse-liveness frame:
      `owner0 := NI.InnermostOwnerDirect(re, g)`; if `owner0` did NOT match, the
      frame leaves `res.0` equal to `cap` at `start_reg(g)`, and `cap` is unset
      there (hypothesis (c') at `owner0`'s body, since `g in CapIds(body)`) — so
      `res.0` would be UNSET, contradicting the LIVE premise. Same whole-regex
      setup as `FLookLoopFullCoversInLooks`; the existential witness is `owner0`. */
  lemma FLookLoopInLookLiveOwnerMatched(crv: CP.FCompiled, str: string, ast: R.regex, re: R.regex,
                                        cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                        S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int, g: nat)
    // ---- whole-regex setup ----
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookTablesOk(re, crv)
    requires PIV.CapUnique(re) && LTB.LookUnique(re)
    requires g in PIV.CapIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)   // lid range
    // ---- deliverable-1 hypotheses (a)-(h) at lid=1, maxlook=max_lookaround(ast) ----
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(lk, l).Some? ==>    // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (c')
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (D-ord)
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (f)
               (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
               && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (g_new)
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (h)
               1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
            AI.get_idx(res.0.a_clk, CP.start_reg(g)) >= 0 ==>
              exists owner: nat :: owner in LTB.LookIds(re)
                                   && g in PIV.CapIds(NI.LookBodyOfRE(re, owner))
                                   && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
                                   && MatchedPosLA(crv, res.1, owner)
  {
    var maxlook := R.max_lookaround(ast);
    var res := AI.FLookLoop(crv, str, 1, maxlook, cap, lk, qt, ov);
    var owner0 := NI.InnermostOwnerDirect(re, g);   // owner0 in LookIds(re); g in CapIds(body); g !in CapIdsInLooks(body)

    if AI.get_idx(res.0.a_clk, CP.start_reg(g)) >= 0 {
      if !MatchedPosLA(crv, res.1, owner0) {
        // ---- derive the FRAME lemma's uniqueness hypothesis ----
        assert LTB.LookIds(re) == LTB.LookIds(ast) by {
          var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false), R.Re_character(R.Dot));
          assert re == R.Re_con(pre, ast);
          assert LTB.LookIds(pre) == {};
        }
        forall l: int, la: R.lookaround, body: R.regex |
          1 <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) && g in PIV.CapIdsOutsideLooks(body)
          ensures l == owner0
        {
          LookEntryOnlyReal(ast, crv, l, la, body);         // (l as nat) in LookIds(ast) == LookIds(re)
          var lid := l as nat;
          assert lid in LTB.LookIds(re);
          VBodyEqLookBody(crv, re, lid);
          assert body == NI.LookBodyOfRE(re, lid);
          assert FrameEntryOk(crv, la, body, S, Slook);      // premise (a)
          PIV.CapIdsLooksDisjoint(body);                     // CapUnique(body) from FrameEntryOk
          PIV.CapIdsSplit(body);
          assert g in PIV.CapIds(body) && g !in PIV.CapIdsInLooks(body);
          InnermostOwnerUnique(re, g, owner0, lid);
          assert lid == owner0;
        }

        // ---- run the frame: res.0 == cap at start_reg(g) ----
        FLookLoopGRegUnsetFrame(crv, str, 1, maxlook, cap, lk, qt, ov, S, Slook, g, owner0);
        assert AI.get_idx(res.0.a_clk, CP.start_reg(g)) == AI.get_idx(cap.a_clk, CP.start_reg(g));

        // ---- cap is UNSET at start_reg(g): (c') at owner0's body ----
        assert 1 <= (owner0 as int) <= maxlook;              // lid-range premise + owner0 in LookIds(re)
        NI.LookBodyOfTablesTie(re, crv, owner0);
        var laO: R.lookaround :| LTB.LookEntryOk(crv, owner0 as int, laO, NI.LookBodyOfRE(re, owner0));
        assert CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(NI.LookBodyOfRE(re, owner0)));  // (c')
        PIV.CaptureRegsIsSet(NI.LookBodyOfRE(re, owner0));
        PIV.StartRegInCaptureRegsSet(PIV.CapIds(NI.LookBodyOfRE(re, owner0)), g);
        assert CP.start_reg(g) in PIV.CaptureRegs(NI.LookBodyOfRE(re, owner0));
        InitRegsClkUnset(ncap, CP.start_reg(g));
        assert AI.get_idx(cap.a_clk, CP.start_reg(g)) == -1;
        assert false;   // res.0's clock at start_reg(g) is both >= 0 and == -1
      }
      // MatchedPosLA(res.1, owner0) holds — owner0 witnesses the existential
      assert owner0 in LTB.LookIds(re)
             && g in PIV.CapIds(NI.LookBodyOfRE(re, owner0))
             && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner0))
             && MatchedPosLA(crv, res.1, owner0);
    }
  }

  /** C4e: a body's OUTSIDE-look quant ids are among ALL its quant ids — quant
      twin of `OuterCapsLeCaptureRegs`. Via `PIV.QuantIdsSplit`. */
  lemma QIdsOuterLeQIdsInt(body: R.regex)
    ensures QIdsOuter(body) <= LKC.QIdsInt(body)
  {
    PIV.QuantIdsSplit(body);
    forall k: int | k in QIdsOuter(body) ensures k in LKC.QIdsInt(body) {
      var q: nat :| q in PIV.QuantIdsOutsideLooks(body) && (q as int) == k;
      assert q in PIV.QuantIds(body);
    }
  }

  /** C4e DELIVERABLE 2 (predicate): whole-loop QUANT reconstruction keyed on the
      FINAL look bank `res1` — quant twin of `FLookLoopValueOkFull`. For EVERY
      (possibly inner) matched positive lookahead `owner`, the fold's quant bank
      `res2` carries that body's FRESH match clocks on its OWN OUTSIDE-look quant
      ids `QIdsOuter(VBody(crv, owner))`. (Inner-look quants of the body come from
      the body's own inner lids — other owners — so, like inner-look CAPTURES on
      the capture side, they are covered per-owner and stitched by the endpoint,
      not claimed here.) */
  ghost predicate FLookLoopQuantValueOkFull(crv: CP.FCompiled, str: string, res2: AReg.Regs, res1: AReg.Regs,
                                            lid: int, maxlook: int, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int) {
    forall owner: int :: lid <= owner <= maxlook && MatchedPosLA(crv, res1, owner) ==>
                           var rf := FreshBodyMatch(crv, str, owner, res1, ov, ncap, nlook, nquant);
                           (rf.Some? ==> CM.RegsAgreeInside(res2, rf.value.quant_regs, QIdsOuter(VBody(crv, owner))))
                           && (rf.None? ==> CM.RegsAgreeInside(res2, AReg.init_regs(nquant), QIdsOuter(VBody(crv, owner))))
  }

  /** C4e: `owner == lid` is not a matched positive lookahead in `res1`, so the
      full quant map for `[lid, maxlook]` (keyed on `res1`) is exactly the one for
      `[lid+1, maxlook]`. Quant twin of `ValueOkFullSkipLid`. */
  lemma QuantValueOkFullSkipLid(crv: CP.FCompiled, str: string, res2: AReg.Regs, res1: AReg.Regs,
                                lid: int, maxlook: int, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int)
    requires FLookLoopQuantValueOkFull(crv, str, res2, res1, lid + 1, maxlook, ov, ncap, nlook, nquant)
    requires !MatchedPosLA(crv, res1, lid)
    ensures FLookLoopQuantValueOkFull(crv, str, res2, res1, lid, maxlook, ov, ncap, nlook, nquant)
  {
    forall owner: int | lid <= owner <= maxlook && MatchedPosLA(crv, res1, owner)
      ensures var rf := FreshBodyMatch(crv, str, owner, res1, ov, ncap, nlook, nquant);
              (rf.Some? ==> CM.RegsAgreeInside(res2, rf.value.quant_regs, QIdsOuter(VBody(crv, owner))))
              && (rf.None? ==> CM.RegsAgreeInside(res2, AReg.init_regs(nquant), QIdsOuter(VBody(crv, owner))))
    { assert owner != lid; }
  }

  /** C4e DELIVERABLE 2 (value lift): THE nested FLookLoop QUANT value lift keyed
      on the FINAL look bank `res.1` — quant twin of `FLookLoopValueLiftFull`,
      generalizing depth-1 `FLookLoopQuantValueLift` from `lk`-keyed to `res.1`-
      keyed (retaining inner looks matched part-way). The capture bank enters
      through its LENGTH alone; the per-lid value comes from `ReplayLidQuant
      AgreeFreshNested`, the per-replay quant write frame from `ReplayPlusQuant
      FrameNestedOuter`, and the suffix frame from `FLookLoopQuantFrameNested`.
      Same (a),(b),(e),(f),(g_new),(h) look-bank hypotheses as the capture lift,
      plus quant twins: (c'q) each body's quant slots INITIAL, (D-ord-q) outer
      quants of earlier ⟂ all quants of later, (Sq-bound) each body's outer quant
      ids land in `Sq`. `decreases maxlook - lid`. */
  lemma {:isolate_assertions} FLookLoopQuantValueLiftFull(crv: CP.FCompiled, str: string, lid: int, maxlook: int,
                                                          cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                                          S: set<int>, Slook: set<int>, Sq: set<int>, ncap: int, nlook: int, nquant: int)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: lid <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>                // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (c'q) per-body quant-unset
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (D-ord-q)
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 QIdsOuter(b1) * LKC.QIdsInt(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (f) look-stability
               (lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
               && lid <= l2 <= maxlook && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (g_new)
               lid <= l1 <= maxlook && lid <= l2 <= maxlook && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (h) well-nested lids
               lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) && lid <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (Sq-bound)
               lid <= l <= maxlook && LTB.LookEntryOk(crv, l, la, body) ==> QIdsOuter(body) <= Sq
    ensures var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
            |res.2.a_cp| == nquant && |res.2.a_clk| == nquant
            && (forall k :: AI.get_idx(res.2.a_cp, k) < 0)
            && (forall k :: AI.get_idx(res.2.a_clk, k) >= -1)
            && FLookLoopQuantValueOkFull(crv, str, res.2, res.1, lid, maxlook, ov, ncap, nlook, nquant)
    decreases maxlook - lid
  {
    var res := AI.FLookLoop(crv, str, lid, maxlook, cap, lk, qt, ov);
    if lid > maxlook {
      assert res.2 == qt;
      return;
    }
    var next := lid + 1;
    match AReg.get_cp(lk, lid)
    case None =>
      assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
      FLookLoopQuantValueLiftFull(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, Sq, ncap, nlook, nquant);
      assert forall l1: int, la1: R.lookaround, b1: R.regex ::
          lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> lid !in LookIdSet(b1);   // (h)@lid, l2:=lid
      FLookLoopLidCpStable(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slook);
      assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);
      assert !MatchedPosLA(crv, res.1, lid);
      QuantValueOkFullSkipLid(crv, str, res.2, res.1, lid, maxlook, ov, ncap, nlook, nquant);
    case Some(cp) =>
      var looktype := if 0 <= lid < |crv.f_look_types| then crv.f_look_types[lid] else R.Lookahead;
      if !AI.capture_type(looktype) {
        assert res == AI.FLookLoop(crv, str, next, maxlook, cap, lk, qt, ov);
        FLookLoopQuantValueLiftFull(crv, str, next, maxlook, cap, lk, qt, ov, S, Slook, Sq, ncap, nlook, nquant);
        assert !MatchedPosLA(crv, res.1, lid);   // !capture_type(looktype), looktype == f_look_types[lid]
        QuantValueOkFullSkipLid(crv, str, res.2, res.1, lid, maxlook, ov, ncap, nlook, nquant);
      } else {
        var la: R.lookaround, body: R.regex :| LTB.LookEntryOk(crv, lid, la, body);
        assert 0 <= lid < |crv.f_look_types| && crv.f_look_types[lid] == la;
        assert looktype == la;
        assert body == VBody(crv, lid);
        assert FrameEntryOk(crv, la, body, S, Slook);
        assert la.Lookahead? || la.Lookbehind?;            // (L5 F7c-2) capture_type
        var bytecode := AI.get_code_v(crv.f_look_capture_bc, lid);
        var dir := AI.capture_direction(looktype);
        var lookcdn := if 0 <= lid < |crv.f_look_cdns| then crv.f_look_cdns[lid] else [];
        var lookast := if 0 <= lid < |crv.f_look_ast| then crv.f_look_ast[lid] else R.Re_empty;
        assert lookast == body;
        assert bytecode == CP.compile_to_bytecode(CP.capture_regex(la, body));
        var (result, ov1) := AI.FFindMatchPlus(bytecode, lookast, crv.f_plus_bc, str, ov, dir,
                                               cp, cap, lk, qt, 0, lookcdn);
        var capN := if result.None? then cap else result.value.capture_regs;
        var nlk := if result.None? then lk else result.value.look_regs;
        var nqt := if result.None? then qt else result.value.quant_regs;
        // (L5 F7c-2) per-kind replay facts (the `...LB` twins take the BACKWARD ones)
        assert la.Lookahead? ==> (dir == LAnc.Forward && CP.capture_regex(la, body) == body
                                  && bytecode == CP.compile_to_bytecode(body)
                                  && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp));
        assert la.Lookbehind? ==> (dir == LAnc.Backward && CP.capture_regex(la, body) == R.reverse_regex(body)
                                   && bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
                                   && AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1));
        assert res == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1);
        assert 0 <= cp <= |str| by {
          assert cp == AI.get_idx(lk.a_cp, lid) && cp >= 0;   // get_cp(lk,lid)==Some(cp)
          assert AI.get_idx(lk.a_cp, lid) <= |str|;            // LookCpsLE
        }

        // per-lid replay frames / wf / cp / value
        if la.Lookahead? { FFindMatchPlusOvStableNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { FFindMatchPlusOvStableNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert ov1 == ov;
        if la.Lookahead? { ReplayPlusFrameNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusFrameNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        if la.Lookahead? { ReplayPlusQuantFrameNestedOuter(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusQuantFrameNestedOuterLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.RegsAgreeOutside(nqt, qt, QIdsOuter(body)) by {
          if result.Some? {} else { assert nqt == qt; }
        }
        assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body)) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        // recon A: TIGHT look frame -- the replay writes only body's DIRECT children
        if la.Lookahead? { ReplayPlusLookFrameDirectNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, la, body); }
        else { ReplayPlusLookFrameDirectNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.RegsAgreeOutside(nlk, lk, DirectLidSet(body)) by {
          if result.Some? {} else { assert nlk == lk; }
        }
        assert (forall k :: AI.get_idx(nqt.a_cp, k) < 0) && (forall k :: AI.get_idx(nqt.a_clk, k) >= -1) by {
          if result.Some? { assert QuantRegsFinal(result.value); }
        }
        if la.Lookahead? { ReplayThreadWfLANested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant); }
        else { ReplayThreadWfLBNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant); }
        assert |capN.a_cp| == ncap && |capN.a_clk| == ncap && PIV.CapRegWf(capN)
               && |nqt.a_cp| == nquant && |nqt.a_clk| == nquant && |nlk.a_cp| == nlook && |nlk.a_clk| == nlook by {
          if result.Some? { assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant); }
        }
        if la.Lookahead? { ReplayLookCpOkNested(bytecode, str, ov, dir, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        else { ReplayLookCpOkNestedLB(bytecode, str, ov, lookcdn, crv.f_plus_bc, cp, cap, lk, qt, body); }
        assert CM.LookCpsLE(nlk, |str|) by {
          if result.Some? {} else { assert nlk == lk; }
        }

        // value at lid: result ~ rfLid on QIdsInt(body); iff-together
        assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body));   // (c'q)@lid
        if la.Lookahead? { ReplayLidQuantAgreeFreshNested(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, la, ncap, nlook, nquant); }
        else { ReplayLidQuantAgreeFreshNestedLB(bytecode, str, cp, cap, lk, qt, ov, lookcdn, crv.f_plus_bc, body, ncap, nlook, nquant); }
        var rfLid := FreshBodyMatch(crv, str, lid, lk, ov, ncap, nlook, nquant);
        var rf := AI.FFindMatch(bytecode, str,
                                AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                              AReg.init_regs(nquant), 0, AI.cp_context(cp, str, dir)),
                                ov, dir, lookcdn).0;   // (L5 F7c-2) in the lid's own direction
        assert rfLid == rf;

        var Sqp := Sq - QIdsOuter(body);

        // ---- recursion hypothesis transfer at [next] with (capN, nlk, nqt) ----
        // (b) matched-look-has-entry for nlk
        assert forall l: int :: next <= l <= maxlook && AReg.get_cp(nlk, l).Some? ==>
                                  exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
        by {
          forall l: int | next <= l <= maxlook && AReg.get_cp(nlk, l).Some?
            ensures exists la2: R.lookaround, body2: R.regex :: LTB.LookEntryOk(crv, l, la2, body2)
          {
            if AReg.get_cp(lk, l).Some? {
            } else {
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, LookIdSet(body));
              NewLookInBody(nlk, lk, body, l);
              assert LTB.LookTablesOk(body, crv);
              LookIdEntryExists(body, crv, l as nat);
            }
          }
        }
        // (c'q) per-body quant-unset for nqt
        assert forall l: int, la2: R.lookaround, body2: R.regex ::
            next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2) ==>
              CM.RegsAgreeInside(nqt, AReg.init_regs(nquant), LKC.QIdsInt(body2))
        by {
          forall l: int, la2: R.lookaround, body2: R.regex | next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2)
            ensures CM.RegsAgreeInside(nqt, AReg.init_regs(nquant), LKC.QIdsInt(body2))
          {
            assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body2));   // (c'q)@qt
            assert QIdsOuter(body) * LKC.QIdsInt(body2) == {};   // (D-ord-q) lid<l
            assert CM.RegsAgreeOutside(nqt, qt, QIdsOuter(body));
            UnsetOffTransfer(nqt, qt, nquant, LKC.QIdsInt(body2), QIdsOuter(body));
          }
        }
        // (f) look-stability for nlk
        assert forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
            (next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
            && next <= l2 <= maxlook && l2 != l1 && AReg.get_cp(nlk, l2).Some?) ==> l2 !in LookIdSet(b1)
        by {
          forall l1: int, la1: R.lookaround, b1: R.regex, l2: int |
            next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
            && next <= l2 <= maxlook && l2 != l1 && AReg.get_cp(nlk, l2).Some?
            ensures l2 !in LookIdSet(b1)
          {
            if AReg.get_cp(lk, l2).Some? {
              // (f)@lk
            } else {
              assert result.Some?;
              assert CM.RegsAgreeOutside(nlk, lk, DirectLidSet(body));
              NewLookInBodyDirect(nlk, lk, body, l2);
              assert (l2 as nat) in DirectLookIds(body);
              assert lid < l1;                                          // l1 >= next
              assert DirectLookIds(body) * LTB.LookIds(b1) == {};       // (g_new) with (lid, l1)
              assert (l2 as nat) !in LTB.LookIds(b1);
              if l2 in LookIdSet(b1) {
                var q: nat :| q in LTB.LookIds(b1) && (q as int) == l2;
                assert q == l2 as nat;
              }
            }
          }
        }
        // (h) well-nested lids for [next] — sub-instance of (h)@lid
        assert forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
            next <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) && next <= l2 <= l1 ==> l2 !in LookIdSet(b1);

        FLookLoopQuantValueLiftFull(crv, str, next, maxlook, capN, nlk, nqt, ov1, S, Slook, Sq, ncap, nlook, nquant);
        assert res.0 == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1).0;
        assert res.1 == AI.FLookLoop(crv, str, next, maxlook, capN, nlk, nqt, ov1).1;
        assert FLookLoopQuantValueOkFull(crv, str, res.2, res.1, next, maxlook, ov, ncap, nlook, nquant);
        assert |res.2.a_cp| == nquant && |res.2.a_clk| == nquant
               && (forall k :: AI.get_idx(res.2.a_cp, k) < 0) && (forall k :: AI.get_idx(res.2.a_clk, k) >= -1);

        // ---- R3 stability: res.1 agrees with lk at lid ----
        assert forall l1: int, la1: R.lookaround, b1: R.regex ::
            lid <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> lid !in LookIdSet(b1);   // (h)@lid, l2:=lid
        FLookLoopLidCpStable(crv, str, lid, maxlook, cap, lk, qt, ov, S, Slook);
        assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);

        // ---- suffix frame: res.2 == nqt on QIdsOuter(body) ----
        assert forall l: int, la2: R.lookaround, body2: R.regex ::
            next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2) ==>
              FrameEntryOk(crv, la2, body2, S, Slook) && QIdsOuter(body2) <= Sqp
        by {
          forall l: int, la2: R.lookaround, body2: R.regex | next <= l <= maxlook && LTB.LookEntryOk(crv, l, la2, body2)
            ensures FrameEntryOk(crv, la2, body2, S, Slook) && QIdsOuter(body2) <= Sqp
          {
            assert FrameEntryOk(crv, la2, body2, S, Slook);   // (a)
            QIdsOuterLeQIdsInt(body2);
            assert QIdsOuter(body) * LKC.QIdsInt(body2) == {};   // (D-ord-q) lid<l
            assert QIdsOuter(body2) <= Sqp by {
              forall k: int | k in QIdsOuter(body2) ensures k in Sqp {
                assert k in Sq;   // (Sq-bound)
                assert k !in QIdsOuter(body) by {
                  if k in QIdsOuter(body) { assert k in QIdsOuter(body) * LKC.QIdsInt(body2); }
                }
              }
            }
          }
        }
        FLookLoopQuantFrameNested(crv, str, next, maxlook, capN, nlk, nqt, ov1, S, Slook, Sqp);
        assert CM.RegsAgreeOutside(res.2, nqt, Sqp);
        assert forall k: int :: k in QIdsOuter(body) ==> k !in Sqp;
        RegsAgreeOutsideToInside(res.2, nqt, QIdsOuter(body), Sqp);
        assert CM.RegsAgreeInside(res.2, nqt, QIdsOuter(body));

        // ---- assemble FLookLoopQuantValueOkFull for [lid] keyed on res.1 ----
        forall owner: int | lid <= owner <= maxlook && MatchedPosLA(crv, res.1, owner)
          ensures var rf2 := FreshBodyMatch(crv, str, owner, res.1, ov, ncap, nlook, nquant);
                  (rf2.Some? ==> CM.RegsAgreeInside(res.2, rf2.value.quant_regs, QIdsOuter(VBody(crv, owner))))
                  && (rf2.None? ==> CM.RegsAgreeInside(res.2, AReg.init_regs(nquant), QIdsOuter(VBody(crv, owner))))
        {
          if owner == lid {
            // re-key lid's coverage from lk onto res.1 via stability
            var rf2 := FreshBodyMatch(crv, str, lid, res.1, ov, ncap, nlook, nquant);
            assert rf2 == rfLid by {
              assert AReg.get_cp(res.1, lid) == AReg.get_cp(lk, lid);   // stability
            }
            assert VBody(crv, lid) == body;
            QIdsOuterLeQIdsInt(body);
            assert QIdsOuter(body) <= LKC.QIdsInt(body);
            if rfLid.Some? {
              assert result.Some? && nqt == result.value.quant_regs;
              assert CM.RegsAgreeInside(nqt, rf.value.quant_regs, LKC.QIdsInt(body));   // ReplayLidQuantAgreeFreshNested
              assert CM.RegsAgreeInside(res.2, rfLid.value.quant_regs, QIdsOuter(VBody(crv, owner))) by {
                forall k: int | k in QIdsOuter(body)
                  ensures AI.get_idx(res.2.a_cp, k) == AI.get_idx(rfLid.value.quant_regs.a_cp, k)
                          && AI.get_idx(res.2.a_clk, k) == AI.get_idx(rfLid.value.quant_regs.a_clk, k)
                {
                  assert k in LKC.QIdsInt(body);
                  assert AI.get_idx(res.2.a_cp, k) == AI.get_idx(nqt.a_cp, k)
                         && AI.get_idx(res.2.a_clk, k) == AI.get_idx(nqt.a_clk, k);   // suffix frame
                }
              }
            } else {
              assert result.None? && nqt == qt && rfLid.None?;
              assert CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body));   // (c'q)@lid
              assert CM.RegsAgreeInside(res.2, AReg.init_regs(nquant), QIdsOuter(VBody(crv, owner))) by {
                forall k: int | k in QIdsOuter(body)
                  ensures AI.get_idx(res.2.a_cp, k) == AI.get_idx(AReg.init_regs(nquant).a_cp, k)
                          && AI.get_idx(res.2.a_clk, k) == AI.get_idx(AReg.init_regs(nquant).a_clk, k)
                {
                  assert k in LKC.QIdsInt(body);
                  assert AI.get_idx(res.2.a_cp, k) == AI.get_idx(nqt.a_cp, k)
                         && AI.get_idx(res.2.a_clk, k) == AI.get_idx(nqt.a_clk, k);   // suffix frame
                }
              }
            }
          } else {
            // owner in [next, maxlook]: DIRECT from the IH (already keyed on res.1)
            assert next <= owner <= maxlook;
            assert MatchedPosLA(crv, res.1, owner);
            assert FLookLoopQuantValueOkFull(crv, str, res.2, res.1, next, maxlook, ov, ncap, nlook, nquant);
          }
        }
      }
  }

  /** C4e DELIVERABLE 2 (QuantIds coverage corollary): quant twin of
      `FLookLoopFullCoversInLooks`. Under the whole-regex setup, EVERY inside-look
      quant id `qd` whose innermost-DIRECT owner is matched in the FINAL look bank
      `res.1` has `res.2` carrying `qd`'s FRESH-body-match clock at that owner.
      The bridge the endpoint's inside-value capstone consumes for feed (iii).
      Proof mirrors the capture corollary: the `owner` guard is `NI.Innermost
      OwnerDirect`'s three facts (with `QuantIds`/`QuantIdsInLooks` for `qd`),
      `VBodyEqLookBody` translates the table body to the structural body,
      `QuantIdsSplit` places `qd` in `QuantIdsOutsideLooks(VBody(crv,owner))`, so
      `qd as int` sits in `QIdsOuter`; then DELIVERABLE 2 (`FLookLoopQuantValue
      LiftFull`) at `owner` supplies the value, weakened onto `{qd as int}`.
      Takes the lift's hypotheses (a),(b),(e),(f),(g_new),(h) plus the quant
      twins (c'q),(D-ord-q),(Sq-bound) as premises. */
  lemma FLookLoopQuantCoversInLooks(crv: CP.FCompiled, str: string, ast: R.regex, re: R.regex,
                                    cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                    S: set<int>, Slook: set<int>, Sq: set<int>, ncap: int, nlook: int, nquant: int, qd: nat)
    // ---- whole-regex setup ----
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookTablesOk(re, crv)
    requires PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires qd in PIV.QuantIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)   // lid range
    // ---- lift hypotheses (a),(b),(e),(f),(g_new),(h) + quant (c'q),(D-ord-q),(Sq-bound) at lid=1 ----
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(lk, l).Some? ==>    // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (c'q)
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(qt, AReg.init_regs(nquant), LKC.QIdsInt(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (D-ord-q)
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 QIdsOuter(b1) * LKC.QIdsInt(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (f)
               (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
               && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (g_new)
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (h)
               1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (Sq-bound)
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==> QIdsOuter(body) <= Sq
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
            forall owner: nat :: owner in LTB.LookIds(re)
                                 && qd in PIV.QuantIds(NI.LookBodyOfRE(re, owner))
                                 && qd !in PIV.QuantIdsInLooks(NI.LookBodyOfRE(re, owner))
                                 && MatchedPosLA(crv, res.1, owner) ==>
                                   var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
                                   (rf.Some? ==> CM.RegsAgreeInside(res.2, rf.value.quant_regs, {qd as int}))
                                   && (rf.None? ==> CM.RegsAgreeInside(res.2, AReg.init_regs(nquant), {qd as int}))
  {
    var maxlook := R.max_lookaround(ast);
    FLookLoopQuantValueLiftFull(crv, str, 1, maxlook, cap, lk, qt, ov, S, Slook, Sq, ncap, nlook, nquant);
    var res := AI.FLookLoop(crv, str, 1, maxlook, cap, lk, qt, ov);
    assert FLookLoopQuantValueOkFull(crv, str, res.2, res.1, 1, maxlook, ov, ncap, nlook, nquant);

    forall owner: nat | owner in LTB.LookIds(re)
                        && qd in PIV.QuantIds(NI.LookBodyOfRE(re, owner))
                        && qd !in PIV.QuantIdsInLooks(NI.LookBodyOfRE(re, owner))
                        && MatchedPosLA(crv, res.1, owner)
      ensures var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
              (rf.Some? ==> CM.RegsAgreeInside(res.2, rf.value.quant_regs, {qd as int}))
              && (rf.None? ==> CM.RegsAgreeInside(res.2, AReg.init_regs(nquant), {qd as int}))
    {
      // owner lands in the fold range [1, maxlook]
      assert 1 <= (owner as int) <= maxlook;                    // lid-range premise
      // table body == structural body; qd sits OUTSIDE looks of it
      VBodyEqLookBody(crv, re, owner);
      var body := VBody(crv, owner as int);
      assert body == NI.LookBodyOfRE(re, owner);
      assert qd in PIV.QuantIds(body) && qd !in PIV.QuantIdsInLooks(body);
      PIV.QuantIdsSplit(body);
      assert qd in PIV.QuantIdsOutsideLooks(body);
      // qd's register sits in owner's OUTSIDE-look quant set
      assert {qd as int} <= QIdsOuter(body) by {
        assert (qd as int) in QIdsOuter(body);
      }
      // deliverable 2 at owner supplies the value; weaken onto {qd as int}
      var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
      if rf.Some? {
        assert CM.RegsAgreeInside(res.2, rf.value.quant_regs, QIdsOuter(VBody(crv, owner as int)));
        RegsAgreeInsideWeakenSub(res.2, rf.value.quant_regs, {qd as int}, QIdsOuter(body));
      } else {
        assert CM.RegsAgreeInside(res.2, AReg.init_regs(nquant), QIdsOuter(VBody(crv, owner as int)));
        RegsAgreeInsideWeakenSub(res.2, AReg.init_regs(nquant), {qd as int}, QIdsOuter(body));
      }
    }
  }

  /** R1 (clean half): under the whole-regex `FLookLoopFullCoversInLooks` setup,
      an `res0`-LIVE inside-look group `g` (its start clock set after the fold) is
      OWNED-and-CAPTURED by its innermost-DIRECT owner's FRESH body match. Composes
      `FLookLoopInLookLiveOwnerMatched` (res0-live ⟹ some direct owner matched) with
      `InnermostOwnerUnique` (that owner IS `InnermostOwnerDirect(re,g)`) and
      `FLookLoopFullCoversInLooks` (the fresh match `rf` agrees with `res0` on `g`'s
      registers) — the `rf.None?` branch is ruled out because it would force `g`'s
      clock back to its `-1` init, contradicting `res0`-liveness. Delivers
      `rf.Some?` and that `rf` captured `g` (start clock ≥ 0). This is the
      register-side half of `FreshBodyDirectMember`; the remaining `GmOfLive`
      membership needs the fresh body match's own path-presence (real-match invariant
      / body spec run). */
  lemma FreshBodyDirectLive(crv: CP.FCompiled, str: string, ast: R.regex, re: R.regex,
                            cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                            S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int, g: nat)
    returns (owner: nat)
    // ---- whole-regex setup ----
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookTablesOk(re, crv)
    requires PIV.CapUnique(re) && LTB.LookUnique(re)
    requires g in PIV.CapIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)   // lid range
    // ---- deliverable-1 hypotheses (a)-(h) at lid=1, maxlook=max_lookaround(ast) ----
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)                                                            // (e)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (a)
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(lk, l).Some? ==>    // (b)
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::                                   // (c')
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (D-ord)
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (f)
               (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
               && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (g_new)
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (h)
               1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    // ---- res0-liveness at g (the fold set g's start clock) ----
    requires AI.get_idx(AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov).0.a_clk, CP.start_reg(g)) >= 0
    ensures owner in LTB.LookIds(re)
    ensures g in PIV.CapIds(NI.LookBodyOfRE(re, owner)) && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
            MatchedPosLA(crv, res.1, owner)
            && var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
            rf.Some?
            && CM.RegsAgreeInside(res.0, rf.value.capture_regs, PIV.CaptureRegsSet({g}))
            && AI.get_idx(rf.value.capture_regs.a_clk, CP.start_reg(g)) >= 0
  {
    var maxlook := R.max_lookaround(ast);
    var res := AI.FLookLoop(crv, str, 1, maxlook, cap, lk, qt, ov);
    assert AI.get_idx(res.0.a_clk, CP.start_reg(g)) >= 0;                     // requires
    // (a) res0-live ⟹ SOME direct owner of g is matched in res.1
    FLookLoopInLookLiveOwnerMatched(crv, str, ast, re, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant, g);
    owner := NI.InnermostOwnerDirect(re, g);   // owner in LookIds(re); g in CapIds(body); g !in CapIdsInLooks(body)
    var owner_ex: nat :| owner_ex in LTB.LookIds(re)
                         && g in PIV.CapIds(NI.LookBodyOfRE(re, owner_ex))
                         && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner_ex))
                         && MatchedPosLA(crv, res.1, owner_ex);
    // (a') pin the existential owner to InnermostOwnerDirect via uniqueness
    InnermostOwnerUnique(re, g, owner, owner_ex);
    assert owner_ex == owner;
    assert MatchedPosLA(crv, res.1, owner);
    // (b) coverage gives the rf.Some?/None? dichotomy on {g}
    FLookLoopFullCoversInLooks(crv, str, ast, re, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant, g);
    var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
    PIV.StartRegInCaptureRegsSet({g}, g);   // start_reg(g) in CaptureRegsSet({g})
    // (c) rf.None? is impossible: it would force g's start clock back to its -1 init
    if rf.None? {
      assert CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), PIV.CaptureRegsSet({g}));
      InitRegsClkUnset(ncap, CP.start_reg(g));
      assert AI.get_idx(res.0.a_clk, CP.start_reg(g))
          == AI.get_idx(AReg.init_regs(ncap).a_clk, CP.start_reg(g)) == -1;
      assert false;
    }
    assert rf.Some?;
    assert CM.RegsAgreeInside(res.0, rf.value.capture_regs, PIV.CaptureRegsSet({g}));
  }

  /** (A2) NESTED consumer twin of `PIV.DirectBodyKeepsPresentLk`: for a DIRECT
      group `g` (`g in CapIds(body)`, `g !in CapIdsInLooks(body)`) of a
      NESTED-fragment body, a match that SET `g` (clock+value) and reached it in
      look-free capture mode (`PathPresent`, dominating clock) lands `g` in the
      body's live denotation `GmOfLive` at the raw `LiveRange`. `PIV.DirectBody
      KeepsPresentLk` requires `NR.LookBehindFragmentRE(body)`, but the depth-k
      owner body `NI.LookBodyOfRE(re, owner)` is only `NR.NestedFragmentRE`, so
      this recomposes the DIRECT look-free->look-aware bridges (`PIV.DirectPath
      PresentLk` / `PIV.DirectMxAtGidLkEq`, both keyed on `g !in CapIdsInLooks`
      and needing only `CapUnique`) with the nested close
      `NI.GmOfLiveKeepsPresentLkNested`. This is the register-side close the R1
      `(A2)` wrapper's step (c) applies to the FRESH BODY MATCH for a nested body,
      once the fresh-match `PathPresent` + clock-dominance (the still-owed `(A2)`
      match-soundness producer) are supplied. */
  lemma DirectBodyKeepsPresentLkNested(body: R.regex, caps: AReg.Regs, look: AReg.Regs, quant: AReg.Regs, g: nat)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body)
    requires g in PIV.CapIds(body)
    requires g !in PIV.CapIdsInLooks(body)
    // the fresh match SET g (clock and value) ...
    requires AI.get_idx(AReg.as_arrays(caps).1, CP.start_reg(g)) >= 0
    requires AI.get_idx(AReg.as_arrays(caps).0, CP.start_reg(g)) >= 0
    // ... and reached g in look-free capture mode with a dominating clock.
    requires PIV.PathPresent(body, AReg.as_arrays(caps).1, AReg.as_arrays(quant).1, -1, g)
    requires AI.get_idx(AReg.as_arrays(caps).1, CP.start_reg(g))
          >= PIV.MxAtGid(body, AReg.as_arrays(caps).1, AReg.as_arrays(quant).1, -1, g)
    ensures g in PIV.GmOfLive(body, caps, look, quant)
    ensures PIV.GmOfLive(body, caps, look, quant)[g]
         == PIV.LiveRange(AReg.as_arrays(caps).0, AReg.as_arrays(caps).1, g)
  {
    var cc := AReg.as_arrays(caps).1;
    var lc := AReg.as_arrays(look).1;
    var qc := AReg.as_arrays(quant).1;
    PIV.DirectPathPresentLk(body, cc, lc, qc, -1, g);          // PathPresent -> PathPresentLk
    PIV.DirectMxAtGidLkEq(body, cc, lc, qc, -1, g);            // MxAtGidLk == MxAtGid
    NI.GmOfLiveKeepsPresentLkNested(body, caps, look, quant, g);  // the nested look-aware close
  }

  /** (A2) MEMBERSHIP -> VALUE, NESTED. The converse-free companion of
      `DirectBodyKeepsPresentLkNested`: instead of PRODUCING `g in GmOfLive` from
      look-free path presence, it takes membership `g in GmOfLive(body, caps, look,
      quant)` as GIVEN (plus `PIV.CapRegWf(caps)`, the free real-match "set-together"
      consistency: an unset clock forces an unset value) and reads off the RAW
      `LiveRange(caps.a_cp, caps.a_clk, g)`. This is not automatic: `GmOfLive` maps
      every present `gid` to `LiveRange(f, cc, gid)` over the FILTERED array `f`, so
      recovering the raw value needs `g`'s filter slots to survive unchanged. The
      proof re-extracts `g`'s look-aware path presence (`NI.GmOfLivePresenceExtractLk
      Nested`, fed the `CapRegWf` cp/clk consistency) and re-runs the close
      (`NI.GmOfLiveKeepsPresentLkNested`), whose tail proves exactly `LiveRange(f, cc,
      g) == LiveRange(cr, cc, g)`. Needs NEITHER `g`'s directness NOR any look-free
      bridge — the pure "present ⟹ raw LiveRange" fact for any nested body. */
  lemma DirectMemberValueNested(body: R.regex, caps: AReg.Regs, look: AReg.Regs, quant: AReg.Regs, g: nat)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body)
    requires g in PIV.CapIds(body)
    requires PIV.CapRegWf(caps)
    requires g in PIV.GmOfLive(body, caps, look, quant)
    requires AI.get_idx(AReg.as_arrays(caps).0, CP.start_reg(g)) >= 0   // value set at g (free from membership)
    ensures PIV.GmOfLive(body, caps, look, quant)[g]
         == PIV.LiveRange(AReg.as_arrays(caps).0, AReg.as_arrays(caps).1, g)
  {
    // set-together consistency for every body capture, from CapRegWf(caps).
    forall c: nat | c in PIV.CapIds(body) && AI.get_idx(caps.a_clk, CP.start_reg(c)) < 0
      ensures AI.get_idx(caps.a_cp, CP.start_reg(c)) < 0
    {
      assert AI.get_idx(caps.a_clk, CP.start_reg(c)) < 0;   // CapRegWf: clk<0 => cp<0
    }
    // (1) membership -> look-aware path presence + set/in-scope start clock & value.
    NI.GmOfLivePresenceExtractLkNested(body, caps, look, quant, g);
    // (2) re-run the close: present + dominating clock -> raw LiveRange value.
    NI.GmOfLiveKeepsPresentLkNested(body, caps, look, quant, g);
  }

  /** (A2) R1 CLOSE — REDUCTION FORM. Completes the R1 target `FreshBodyDirect
      Member` — that an `res0`-live inside-look `g` is present in its innermost
      DIRECT owner's FRESH body match's own live denotation — MODULO the single
      still-owed `(A2)` match-soundness PRODUCER, which is passed here as the two
      explicit engine hypotheses on the winning fresh match `rf` (value-set at `g`
      and look-free `PathPresent` + clock-dominance). Given those, this discharges
      ALL the surrounding wiring GREEN: `FreshBodyDirectLive` supplies `rf.Some?`,
      that `rf` captured `g` (start clock >= 0) and `g`'s DIRECTNESS in the owner
      body; `LookBodyFactsNested` supplies the body's `NestedFragmentRE`/`CapUnique`
      shape (and pins the owner as a lookAHEAD via `NoPosLookbehindRE`); the nested
      consumer `DirectBodyKeepsPresentLkNested` lands `g in GmOfLive(body, rf)` at
      the raw `LiveRange`. The ONLY residual is the producer premise — the
      real-match fact that the winning fresh thread's set-clock direct group is
      look-free path-present with a dominating clock. */
  lemma FreshBodyDirectMemberFromPresent(crv: CP.FCompiled, str: string, ast: R.regex, re: R.regex,
                                         cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                         S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int, g: nat)
    returns (owner: nat)
    // ---- whole-regex setup (verbatim from FreshBodyDirectLive) ----
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookTablesOk(re, crv)
    requires PIV.CapUnique(re) && LTB.LookUnique(re)
    requires g in PIV.CapIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    // ---- extra structural facts (for LookBodyFactsNested) ----
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re) && PIV.QuantUnique(re)   // (L5 F7c) lifted from NoPosLookbehindRE
    // ---- deliverable-1 hypotheses (a)-(h) (verbatim from FreshBodyDirectLive) ----
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
               (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
               && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
               1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    // ---- res0-liveness at g (verbatim from FreshBodyDirectLive) ----
    requires AI.get_idx(AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov).0.a_clk, CP.start_reg(g)) >= 0
    // ==== THE ISOLATED (A2) PRODUCER RESIDUAL (owed match-soundness) ====
    // For the (unique) innermost-DIRECT owner's FRESH winning body match `rf`,
    // `g`'s value is set AND `g` is look-free path-present with a dominating clock
    // — the real-match soundness of the winning fresh thread's registers. Stated
    // over ALL owners matching the owner-characterization (unique by
    // `InnermostOwnerUnique`; `InnermostOwnerDirect` is a lemma, not nameable in a
    // spec expression).
    requires var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
             forall owner0: nat ::
               owner0 in LTB.LookIds(re)
               && g in PIV.CapIds(NI.LookBodyOfRE(re, owner0))
               && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner0))
               && MatchedPosLA(crv, res.1, owner0) ==>
                 var body := NI.LookBodyOfRE(re, owner0);
                 var rf := FreshBodyMatch(crv, str, owner0 as int, res.1, ov, ncap, nlook, nquant);
                 rf.Some? ==>
                   AI.get_idx(AReg.as_arrays(rf.value.capture_regs).0, CP.start_reg(g)) >= 0
                   && PIV.PathPresent(body, AReg.as_arrays(rf.value.capture_regs).1,
                                      AReg.as_arrays(rf.value.quant_regs).1, -1, g)
                   && AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(g))
                      >= PIV.MxAtGid(body, AReg.as_arrays(rf.value.capture_regs).1,
                                     AReg.as_arrays(rf.value.quant_regs).1, -1, g)
    ensures owner in LTB.LookIds(re)
    ensures g in PIV.CapIds(NI.LookBodyOfRE(re, owner)) && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
            MatchedPosLA(crv, res.1, owner)
            && var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
            rf.Some?
            && var body := NI.LookBodyOfRE(re, owner);
            g in PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)
            && PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)[g]
               == PIV.LiveRange(AReg.as_arrays(rf.value.capture_regs).0,
                                AReg.as_arrays(rf.value.capture_regs).1, g)
  {
    // (1) the register-side half: owner, rf.Some?, g captured (start clock >= 0).
    owner := FreshBodyDirectLive(crv, str, ast, re, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant, g);
    var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
    var body := NI.LookBodyOfRE(re, owner);
    var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
    // FreshBodyDirectLive: MatchedPosLA(res.1, owner), rf.Some?, g direct in body,
    // and rf's start clock at g is set.
    assert MatchedPosLA(crv, res.1, owner);
    assert rf.Some?;
    assert g in PIV.CapIds(body) && g !in PIV.CapIdsInLooks(body);
    assert AI.get_idx(rf.value.capture_regs.a_clk, CP.start_reg(g)) >= 0;
    // (2) the owner body's shape: NestedFragmentRE + CapUnique (owner in LookIds(re)).
    LookBodyFactsL5(re, crv, owner);
    assert NR.NestedFragmentRE(body) && PIV.CapUnique(body);
    // (3) as_arrays projections coincide with the record fields.
    assert AReg.as_arrays(rf.value.capture_regs).1 == rf.value.capture_regs.a_clk;
    assert AReg.as_arrays(rf.value.capture_regs).0 == rf.value.capture_regs.a_cp;
    assert AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(g)) >= 0;   // clock set
    // (4) close with the (A2) producer residual (value-set + PathPresent + dominance).
    DirectBodyKeepsPresentLkNested(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs, g);
  }

  /** (A2) R1 CLOSE — MEMBERSHIP-RESIDUAL FORM. The SHARPEST reduction of the R1
      target `FreshBodyDirectMember`: identical ensures to `FreshBodyDirectMember
      FromPresent`, but the owed `(A2)` residual is collapsed from the three-part
      register producer (value-set + look-free `PathPresent` + clock-dominance) down
      to the SINGLE match-soundness fact `g in GmOfLive(body, rf)` — that `g` is a
      member of the winning fresh body match's own live denotation. Via `PIV.Best
      MatchRE` at that fresh match's `PTS_final` state this is EXACTLY "`g` is
      captured in the Linden body-match first-leaf's group map" — the thread<->leaf
      membership tie (the R2 wall). Everything else is discharged GREEN here:
      `FreshBodyDirectLive` supplies `owner`, `rf.Some?`, `g`'s directness in the
      owner body and `rf`'s set start clock at `g`; `LookBodyFactsNested` the body's
      `NestedFragmentRE`/`CapUnique`; the free `CapRegWf(rf.caps)` (dischargeable via
      `FreshMatchWfNested`) turns clock-set into value-set and feeds the "set-
      together" consistency; and `DirectMemberValueNested` reads off the raw
      `LiveRange` from membership. NO look-free bridge, NO `PathPresentIntro`
      ancestor chain — the entire clock/path algebra of the producer is absorbed
      into the one membership premise. */
  lemma FreshBodyDirectMemberFromMembership(crv: CP.FCompiled, str: string, ast: R.regex, re: R.regex,
                                            cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                            S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int, g: nat)
    returns (owner: nat)
    // ---- whole-regex setup (verbatim from FreshBodyDirectLive) ----
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookTablesOk(re, crv)
    requires PIV.CapUnique(re) && LTB.LookUnique(re)
    requires g in PIV.CapIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    // ---- extra structural facts (for LookBodyFactsNested) ----
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re) && PIV.QuantUnique(re)   // (L5 F7c) lifted from NoPosLookbehindRE
    // ---- deliverable-1 hypotheses (a)-(h) (verbatim from FreshBodyDirectLive) ----
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
               (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
               && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
               1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    // ---- res0-liveness at g (verbatim from FreshBodyDirectLive) ----
    requires AI.get_idx(AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov).0.a_clk, CP.start_reg(g)) >= 0
    // ==== THE ISOLATED (A2) MEMBERSHIP RESIDUAL (owed match-soundness) ====
    // For the (unique) innermost-DIRECT owner's FRESH winning body match `rf`,
    // `g` is a MEMBER of the body's OWN live denotation — the SOLE owed fact
    // (equivalently, via BestMatchRE at rf's PTS_final, `g` captured in the
    // Linden body-match first-leaf). `CapRegWf(rf.caps)` is the free register-wf
    // side condition (dischargeable via `FreshMatchWfNested`). Stated over ALL
    // owners matching the characterization (unique by `InnermostOwnerUnique`).
    requires var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
             forall owner0: nat ::
               owner0 in LTB.LookIds(re)
               && g in PIV.CapIds(NI.LookBodyOfRE(re, owner0))
               && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner0))
               && MatchedPosLA(crv, res.1, owner0) ==>
                 var body := NI.LookBodyOfRE(re, owner0);
                 var rf := FreshBodyMatch(crv, str, owner0 as int, res.1, ov, ncap, nlook, nquant);
                 rf.Some? ==>
                   PIV.CapRegWf(rf.value.capture_regs)
                   && AI.get_idx(AReg.as_arrays(rf.value.capture_regs).0, CP.start_reg(g)) >= 0   // value set (free from CapRegWf)
                   && g in PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)
    ensures owner in LTB.LookIds(re)
    ensures g in PIV.CapIds(NI.LookBodyOfRE(re, owner)) && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
            MatchedPosLA(crv, res.1, owner)
            && var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
            rf.Some?
            && var body := NI.LookBodyOfRE(re, owner);
            g in PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)
            && PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)[g]
               == PIV.LiveRange(AReg.as_arrays(rf.value.capture_regs).0,
                                AReg.as_arrays(rf.value.capture_regs).1, g)
  {
    // (1) the register-side half: owner, rf.Some?, g captured (start clock >= 0).
    owner := FreshBodyDirectLive(crv, str, ast, re, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant, g);
    var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
    var body := NI.LookBodyOfRE(re, owner);
    var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
    assert MatchedPosLA(crv, res.1, owner);
    assert rf.Some?;
    assert g in PIV.CapIds(body) && g !in PIV.CapIdsInLooks(body);
    assert AI.get_idx(rf.value.capture_regs.a_clk, CP.start_reg(g)) >= 0;
    // (2) the owner body's shape: NestedFragmentRE + CapUnique (owner in LookIds(re)).
    LookBodyFactsL5(re, crv, owner);
    assert NR.NestedFragmentRE(body) && PIV.CapUnique(body);
    // (3) the membership residual, instantiated at this owner.
    assert PIV.CapRegWf(rf.value.capture_regs)
           && g in PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs);
    // (4) value-set at g: CapRegWf turns the set start clock into a set start value.
    assert AReg.as_arrays(rf.value.capture_regs).0 == rf.value.capture_regs.a_cp;
    assert AReg.as_arrays(rf.value.capture_regs).1 == rf.value.capture_regs.a_clk;
    assert AI.get_idx(rf.value.capture_regs.a_cp, CP.start_reg(g)) >= 0;   // CapRegWf: clk>=0 => cp>=0
    // (5) read off the raw LiveRange value from membership.
    DirectMemberValueNested(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs, g);
  }

  /** (A2) R1 CLOSE — ANCESTOR-SET-RESIDUAL FORM. The SHARPEST reduction of the R1
      target `FreshBodyDirectMember` yet: identical ensures to `FreshBodyDirect
      MemberFromMembership`, but the owed `(A2)` residual is collapsed from the
      SEMANTIC membership `g in GmOfLive(body, rf)` (an R2-flavored thread<->leaf
      tie) down to the PURE REGISTER invariant `AncSetInvRE(body, rf.caps.a_clk)` —
      "every DIRECT set capture of the winning fresh body match has all its ancestor
      captures set", an anytime, monotone, NOT-pc-tied fact. Everything else is
      discharged GREEN here: `FreshBodyDirectLive` supplies `owner`, `rf.Some?`, `g`'s
      directness in the owner body and `rf`'s set start clock at `g`; `LookBodyFacts
      Nested` the body's `NestedFragmentRE`/`CapUnique`/`QuantUnique`; and
      `AncSetToMemberNested` turns the register invariant + set clock + the no-quant
      side condition `AncQuants(body, g) == {}` (the RE-side shadow of
      `GNotUnderQuantL`, itself dischargeable via `GNotUnderQuantLNoAncQuants`) into
      the membership AND the raw `LiveRange` value. This isolates the ENTIRE remaining
      (A2) obligation to the single step-preserved register invariant, owed only its
      threading through the fresh-body sim driver (the `FFindMatchAncSet` rider). */
  lemma FreshBodyDirectMemberFromAncSet(crv: CP.FCompiled, str: string, ast: R.regex, re: R.regex,
                                        cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                                        S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int, g: nat)
    returns (owner: nat)
    // ---- whole-regex setup (verbatim from FreshBodyDirectMemberFromMembership) ----
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookTablesOk(re, crv)
    requires PIV.CapUnique(re) && LTB.LookUnique(re)
    requires g in PIV.CapIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    // ---- extra structural facts (for LookBodyFactsNested) ----
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re) && PIV.QuantUnique(re)   // (L5 F7c) lifted from NoPosLookbehindRE
    // ---- deliverable-1 hypotheses (a)-(h) (verbatim) ----
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook)
    requires forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(lk, l).Some? ==>
                                exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    requires forall l: int, la: R.lookaround, body: R.regex ::
               1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                 CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
               (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
               && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1)
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
               1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
               && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                 DirectLookIds(b1) * LTB.LookIds(b2) == {}
    requires forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
               1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==> l2 !in LookIdSet(b1)
    // ---- res0-liveness at g (verbatim) ----
    requires AI.get_idx(AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov).0.a_clk, CP.start_reg(g)) >= 0
    // ==== THE ISOLATED (A2) ANCESTOR-SET RESIDUAL (owed match-soundness) ====
    // For the (unique) innermost-DIRECT owner's FRESH winning body match `rf`, the
    // anytime register invariant `AncSetInvRE(body, rf.caps.a_clk)` holds (plus the
    // free `CapRegWf(rf.caps)` and the no-quant side condition `AncQuants(body,g)==
    // {}`). Stated over ALL owners matching the characterization (unique by
    // `InnermostOwnerUnique`).
    requires var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
             forall owner0: nat ::
               owner0 in LTB.LookIds(re)
               && g in PIV.CapIds(NI.LookBodyOfRE(re, owner0))
               && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner0))
               && MatchedPosLA(crv, res.1, owner0) ==>
                 var body := NI.LookBodyOfRE(re, owner0);
                 PIV.AncQuants(body, g) == {}
                 && var rf := FreshBodyMatch(crv, str, owner0 as int, res.1, ov, ncap, nlook, nquant);
                 (rf.Some? ==>
                    PIV.CapRegWf(rf.value.capture_regs)
                    && AI.get_idx(AReg.as_arrays(rf.value.capture_regs).0, CP.start_reg(g)) >= 0   // value set (free from CapRegWf)
                    && AncSetInvRE(body, rf.value.capture_regs.a_clk))
    ensures owner in LTB.LookIds(re)
    ensures g in PIV.CapIds(NI.LookBodyOfRE(re, owner)) && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
            MatchedPosLA(crv, res.1, owner)
            && var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
            rf.Some?
            && var body := NI.LookBodyOfRE(re, owner);
            g in PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)
            && PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)[g]
               == PIV.LiveRange(AReg.as_arrays(rf.value.capture_regs).0,
                                AReg.as_arrays(rf.value.capture_regs).1, g)
  {
    // (1) the register-side half: owner, rf.Some?, g captured (start clock >= 0).
    owner := FreshBodyDirectLive(crv, str, ast, re, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant, g);
    var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
    var body := NI.LookBodyOfRE(re, owner);
    var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
    assert MatchedPosLA(crv, res.1, owner);
    assert rf.Some?;
    assert g in PIV.CapIds(body) && g !in PIV.CapIdsInLooks(body);
    assert AI.get_idx(rf.value.capture_regs.a_clk, CP.start_reg(g)) >= 0;
    // (2) the owner body's shape: NestedFragmentRE + CapUnique + QuantUnique.
    LookBodyFactsL5(re, crv, owner);
    assert NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body);
    // (3) the ancestor-set residual, instantiated at this owner.
    assert PIV.AncQuants(body, g) == {}
           && PIV.CapRegWf(rf.value.capture_regs)
           && AncSetInvRE(body, rf.value.capture_regs.a_clk);
    // (4) as_arrays projections coincide with the record's clock array.
    assert AReg.as_arrays(rf.value.capture_regs).1 == rf.value.capture_regs.a_clk;
    assert AncSetInvRE(body, AReg.as_arrays(rf.value.capture_regs).1);
    assert AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(g)) >= 0;
    // (5) close: the register invariant + set clock + no-quant -> membership + LiveRange.
    AncSetToMemberNested(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs, g);
  }

  /** (A2) R1 CLOSE — UNCONDITIONAL. The R1 target: an `res0`-live inside-look
      DIRECT `g` is present in its innermost DIRECT owner's FRESH body match's own
      live denotation at the raw `LiveRange`. The (A2) match-soundness PRODUCER —
      the anytime register invariant `AncSetInvRE(body, rf.caps.a_clk)` — is now
      PROVEN here (not owed): `FreshBodyMatchAncSet` threads it through the fresh
      body match's whole `FFindMatch` run from the vacuous init state. The remaining
      residual conjuncts are STANDARD fresh-match well-formedness the R1 keystone
      supplies: `SizesOkRE(body, ·)` (register files cover the body's writes),
      `cp_ctx_ok` (the recorded look position is in `[0,|str|]`), `TransWf(body)`,
      and `GNotUnderQuantL(Translate(body), g)` (the no-quant side condition). Given
      those, every owed fact is discharged: `AncSetInvRE` via `FreshBodyMatchAncSet`;
      `CapRegWf(rf.caps)` via `FreshMatchWfNested`; the value-set at `g` from
      `CapRegWf` + `FreshBodyDirectLive`'s set clock (the owner is unique by
      `InnermostOwnerUnique`); `AncQuants(body,g)=={}` via `GNotUnderQuantLNoAncQuants`.
      Then `FreshBodyDirectMemberFromAncSet` closes to `g in GmOfLive` + `LiveRange`.
      The deep (A2) register wall is thus dissolved — the owed producer is gone. */
  lemma FreshBodyDirectMember(crv: CP.FCompiled, str: string, ast: R.regex, re: R.regex,
                              cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, ov: LOr.OracleView,
                              S: set<int>, Slook: set<int>, ncap: int, nlook: int, nquant: int, g: nat)
    returns (owner: nat)
    // ---- whole-regex setup (verbatim from FreshBodyDirectMemberFromAncSet) ----
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookTablesOk(re, crv)
    requires PIV.CapUnique(re) && LTB.LookUnique(re)
    requires g in PIV.CapIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    // ---- extra structural facts (for LookBodyFactsNested) ----
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re) && PIV.QuantUnique(re)   // (L5 F7c-2b) lifted
    // ---- deliverable-1 hypotheses (a)-(h) (verbatim) ----
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires |cap.a_cp| == ncap && |cap.a_clk| == ncap && PIV.CapRegWf(cap)
    requires |lk.a_cp| == nlook && |lk.a_clk| == nlook
    requires CM.LookCpsLE(lk, |str|)
    requires AhO(crv, ast, cap, lk, S, Slook, ncap, str)
    // ---- res0-liveness at g (verbatim) ----
    requires AI.get_idx(AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov).0.a_clk, CP.start_reg(g)) >= 0
    // ==== STANDARD FRESH-MATCH WELL-FORMEDNESS (supplied by the R1 keystone) ====
    // For each innermost-DIRECT owner of `g` that matched, the fresh body match
    // runs with register files sized to the body, at a recorded look position in
    // `[0,|str|]`, over a translation-well-formed body whose `g` is placed under
    // no Linden quantifier. These are shallow structural side conditions — NOT the
    // deep (A2) register producer, which is proven internally.
    requires FreshWfO(crv, str, re, AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov).1,
                      g, ncap, nlook, nquant)
    ensures owner in LTB.LookIds(re)
    ensures g in PIV.CapIds(NI.LookBodyOfRE(re, owner)) && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
            MatchedPosLA(crv, res.1, owner)
            && var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
            rf.Some?
            && AI.get_idx(AReg.as_arrays(rf.value.capture_regs).0, CP.start_reg(g)) >= 0
            && var body := NI.LookBodyOfRE(re, owner);
            g in PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)
            && PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)[g]
               == PIV.LiveRange(AReg.as_arrays(rf.value.capture_regs).0,
                                AReg.as_arrays(rf.value.capture_regs).1, g)
  {
    reveal AhO();
    reveal FreshWfO();
    var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), cap, lk, qt, ov);
    // (1) the winning owner: register-side half (rf.Some?, g captured with set clock).
    var winner := FreshBodyDirectLive(crv, str, ast, re, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant, g);
    var wbody := NI.LookBodyOfRE(re, winner);
    var wrf := FreshBodyMatch(crv, str, winner as int, res.1, ov, ncap, nlook, nquant);
    assert winner in LTB.LookIds(re) && g in PIV.CapIds(wbody) && g !in PIV.CapIdsInLooks(wbody);
    assert MatchedPosLA(crv, res.1, winner) && wrf.Some?;
    assert AI.get_idx(wrf.value.capture_regs.a_clk, CP.start_reg(g)) >= 0;   // winner clock set at g

    // (2) discharge the (A2) ancestor-set residual for the consumer.
    forall owner0: nat |
      owner0 in LTB.LookIds(re)
      && g in PIV.CapIds(NI.LookBodyOfRE(re, owner0))
      && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner0))
      && MatchedPosLA(crv, res.1, owner0)
      ensures var body := NI.LookBodyOfRE(re, owner0);
              PIV.AncQuants(body, g) == {}
              && var rf := FreshBodyMatch(crv, str, owner0 as int, res.1, ov, ncap, nlook, nquant);
              (rf.Some? ==>
                 PIV.CapRegWf(rf.value.capture_regs)
                 && AI.get_idx(AReg.as_arrays(rf.value.capture_regs).0, CP.start_reg(g)) >= 0
                 && AncSetInvRE(body, rf.value.capture_regs.a_clk))
    {
      var body := NI.LookBodyOfRE(re, owner0);
      // body shape + a lookahead table row (VBody == body, cdn == compile_cdns(body)).
      LookBodyFactsL5(re, crv, owner0);
      assert NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body);
      var la0: R.lookaround :| LTB.LookEntryOk(crv, owner0 as int, la0, body)
                               && (la0.Lookbehind? ==> NR.LBOnlyLooksRE(body));
      var b0 := body;
      VBodyEqLookBody(crv, re, owner0);
      assert b0 == VBody(crv, owner0 as int) == body;                         // LookEntryOk: f_look_ast
      // MatchedPosLA pins la0 to a POSITIVE look (either kind under the L5 scope).
      assert crv.f_look_types[owner0] == la0;                                  // LookEntryOk
      assert la0.Lookahead? || la0.Lookbehind?;
      // no-quant side condition.
      GNotUnderQuantLNoAncQuants(body, g);                                      // requires TransWf + GNotUnderQuantL
      assert PIV.AncQuants(body, g) == {};
      var rf := FreshBodyMatch(crv, str, owner0 as int, res.1, ov, ncap, nlook, nquant);
      if rf.Some? {
        var cp := AReg.get_cp(res.1, owner0).value;
        var cdn := if 0 <= (owner0 as int) < |crv.f_look_cdns| then crv.f_look_cdns[owner0 as int] else [];
        assert cp_ctx_ok(crv, str, res.1, owner0);                            // residual hyp (MatchedPosLA -> Some)
        assert 0 <= cp <= |str|;
        if la0.Lookahead? {
          // unfold FreshBodyMatch to its FFindMatch form over compile_to_bytecode(body).
          var bc := CP.compile_to_bytecode(body);
          NR.CompileToBytecodeRepNested(body);
          var endl := CP.compile(body, 0, CP.Progress).1 as nat;
          assert NR.NfaRepRE(body, bc, 0, endl) && NR.GetPcRE(bc, endl) == Some(RB.Accept) && |bc| == endl + 1;
          assert AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp);
          assert rf == AI.FFindMatch(bc, str,
                                     AI.FInitState(bc, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                   AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                                     ov, LAnc.Forward, cdn).0;
          // (a) the (A2) PRODUCER: AncSetInvRE, threaded through the fresh body match.
          FreshBodyMatchAncSet(bc, str, cp, ov, cdn, body, endl, ncap, nlook, nquant);
          assert AncSetInvRE(body, rf.value.capture_regs.a_clk);
          // (b) register well-formedness (CapRegWf).
          FreshMatchWfNested(bc, str, cp, ov, cdn, body, ncap, nlook, nquant);
          assert CM.ThreadRegsWf(rf.value, ncap, nlook, nquant);
        } else {
          // (L5 F7c-2b) LOOKBEHIND owner: the fresh body match is the BACKWARD run of
          // compile(reverse_regex(body)); the ancestor-set rider and wf transfer.
          var rev := R.reverse_regex(body);
          var bc := CP.compile_to_bytecode(rev);
          ReverseNestedPackage(body);
          NR.CompileToBytecodeRepNested(rev);
          var endl := CP.compile(rev, 0, CP.Progress).1 as nat;
          assert NR.NfaRepRE(rev, bc, 0, endl) && NR.GetPcRE(bc, endl) == Some(RB.Accept) && |bc| == endl + 1;
          assert CP.capture_regex(la0, body) == rev && AI.capture_direction(la0) == LAnc.Backward;
          var ctxB := AI.cp_context(cp, str, LAnc.Backward);
          assert ctxB.nextchar == AI.get_char(str, cp - 1);
          var initsB := AI.FInitState(bc, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                      AReg.init_regs(nquant), 0, ctxB);
          assert rf == AI.FFindMatch(bc, str, initsB, ov, LAnc.Backward, cdn).0;
          FreshBodyMatchAncSetLB(bc, str, cp, ov, cdn, body, endl, ncap, nlook, nquant);
          assert AncSetInvRE(body, rf.value.capture_regs.a_clk);
          CM.FInitStateRegsWf(bc, cp, ncap, nlook, nquant, 0, ctxB);
          FFindMatchRegsWf(bc, str, initsB, ov, LAnc.Backward, cdn, ncap, nlook, nquant);
          assert CM.ThreadRegsWf(rf.value, ncap, nlook, nquant);
        }
        assert PIV.CapRegWf(rf.value.capture_regs);
        // (c) value-set at g: owner0 is the unique winner, whose clock at g is set.
        InnermostOwnerUnique(re, g, winner, owner0);
        assert owner0 == winner;
        assert rf == wrf;
        assert AI.get_idx(rf.value.capture_regs.a_clk, CP.start_reg(g)) >= 0;   // winner clock set
        assert AI.get_idx(rf.value.capture_regs.a_cp, CP.start_reg(g)) >= 0;    // CapRegWf: clk>=0 => cp>=0
        assert AReg.as_arrays(rf.value.capture_regs).0 == rf.value.capture_regs.a_cp;
      }
    }

    // (3) close via the ancestor-set consumer (now unconditional).
    owner := FreshBodyDirectMemberFromAncSet(crv, str, ast, re, cap, lk, qt, ov, S, Slook, ncap, nlook, nquant, g);

    // (4) value-set at the returned owner (for the `LiveRange` ensures's well-formedness):
    // owner matches the characterization (FromAncSet's ensures), so the residual applies.
    var rfo := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
    assert MatchedPosLA(crv, res.1, owner)
           && owner in LTB.LookIds(re)
           && g in PIV.CapIds(NI.LookBodyOfRE(re, owner))
           && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
           && rfo.Some?;
    assert PIV.CapRegWf(rfo.value.capture_regs)
           && AI.get_idx(AReg.as_arrays(rfo.value.capture_regs).0, CP.start_reg(g)) >= 0;   // residual at owner
    assert AI.get_idx(rfo.value.capture_regs.a_cp, CP.start_reg(g)) >= 0;
  }

  /** (A2 in-fragment) NO-QUANT `MxAtGid` COLLAPSE. When `g` has NO quantifier
      ancestor on its root->g path (`PIV.AncQuants(body, g) == {}`, the RE-side
      shadow of `GNotUnderQuantL`), the maxclock threshold `PIV.MxAtGid` never
      climbs above its `-1` seed: `MxAtGid` rises only at a `Re_quant` node, and an
      empty ancestor-quant set forces any quant node on the path to carry a negative
      id whose stamp reads `-1` (so `mx` stays `-1`). This is the fact that makes the
      clock-DOMINANCE input to `PathPresentIntro`/`DirectBodyKeepsPresentLkNested`
      (`clk >= MxAtGid == -1`) FREE from a merely set (`>= 0`) clock. */
  lemma MxAtGidNoQuant(body: R.regex, cc: seq<int>, qc: seq<int>, g: nat)
    requires g in PIV.CapIds(body)
    requires PIV.AncQuants(body, g) == {}
    ensures PIV.MxAtGid(body, cc, qc, -1, g) == -1
    decreases body
  {
    match body
    case Re_alt(r1, r2) =>
      if g in PIV.CapIds(r1) { MxAtGidNoQuant(r1, cc, qc, g); } else { MxAtGidNoQuant(r2, cc, qc, g); }
    case Re_con(r1, r2) =>
      if g in PIV.CapIds(r1) { MxAtGidNoQuant(r1, cc, qc, g); } else { MxAtGidNoQuant(r2, cc, qc, g); }
    case Re_quant(nul, qid, q, r1) =>
      if qid >= 0 { assert (qid as nat) in PIV.AncQuants(body, g); }   // contradicts == {}
      assert qid < 0;
      assert AI.get_idx(qc, qid) == -1;                               // negative slot reads -1
      assert PIV.AncQuants(r1, g) == {};
      MxAtGidNoQuant(r1, cc, qc, g);
    case Re_capture(cid, r1) =>
      if cid >= 0 && (cid as nat) == g {} else { MxAtGidNoQuant(r1, cc, qc, g); }
    case Re_lookaround(lid, l, r1) => MxAtGidNoQuant(r1, cc, qc, g);
    case _ =>
  }

  /** (A2 in-fragment) EMPTINESS PROPAGATION to ancestor captures: if `g` has no
      quantifier ancestor, neither does any capture `c` strictly enclosing `g`
      (`c in PIV.AncCaps(body, g)`) — `c`'s root->c path is a prefix of `g`'s, so
      its ancestor-quant set is a subset of `g`'s empty one. Lets `MxAtGidNoQuant`
      fire at each ancestor `c`, discharging `PathPresentIntro`'s per-ancestor
      clock-dominance. */
  lemma AncQuantsEmptyAncCap(body: R.regex, g: nat, c: nat)
    requires g in PIV.CapIds(body)
    requires PIV.CapUnique(body)
    requires c in PIV.AncCaps(body, g)
    requires PIV.AncQuants(body, g) == {}
    ensures c in PIV.CapIds(body)
    ensures PIV.AncQuants(body, c) == {}
    decreases body
  {
    match body
    case Re_alt(r1, r2) =>
      if g in PIV.CapIds(r1) {
        AncQuantsEmptyAncCap(r1, g, c);
        assert c !in PIV.CapIds(r2) by { if c in PIV.CapIds(r2) { assert c in PIV.CapIds(r1) * PIV.CapIds(r2); } }
      } else {
        AncQuantsEmptyAncCap(r2, g, c);
        assert c !in PIV.CapIds(r1) by { if c in PIV.CapIds(r1) { assert c in PIV.CapIds(r1) * PIV.CapIds(r2); } }
      }
    case Re_con(r1, r2) =>
      if g in PIV.CapIds(r1) {
        AncQuantsEmptyAncCap(r1, g, c);
        assert c !in PIV.CapIds(r2) by { if c in PIV.CapIds(r2) { assert c in PIV.CapIds(r1) * PIV.CapIds(r2); } }
      } else {
        AncQuantsEmptyAncCap(r2, g, c);
        assert c !in PIV.CapIds(r1) by { if c in PIV.CapIds(r1) { assert c in PIV.CapIds(r1) * PIV.CapIds(r2); } }
      }
    case Re_quant(nul, qid, q, r1) =>
      if qid >= 0 { assert (qid as nat) in PIV.AncQuants(body, g); }   // contradicts == {}
      assert qid < 0;
      assert PIV.AncQuants(r1, g) == {};
      assert c in PIV.AncCaps(r1, g);
      AncQuantsEmptyAncCap(r1, g, c);
    case Re_capture(cid, r1) =>
      // cid != g (else AncCaps(body,g) == {}, no member c)
      if cid >= 0 && (cid as nat) == c {
        // c is the immediate parent capture: its own path carries no ancestor quant
        assert PIV.AncQuants(body, c) == {};
        assert c in PIV.CapIds(body);
      } else {
        assert g in PIV.CapIds(r1);
        assert c in PIV.AncCaps(r1, g);
        AncQuantsEmptyAncCap(r1, g, c);
      }
    case Re_lookaround(lid, l, r1) => AncQuantsEmptyAncCap(r1, g, c);
    case _ =>
  }

  /** (A2 in-fragment) THE PRODUCER, MODULO ANCESTOR-CAPTURE-SET. Assembles
      `PIV.PathPresent(body, cc, qc, -1, g)` for a DIRECT `g` with NO quantifier
      ancestor from the SINGLE remaining register fact — every ancestor capture of
      `g` has its start clock SET (`>= 0`). Discharges `PIV.PathPresentIntro`'s two
      per-ancestor obligations: the quant obligation is VACUOUS (`AncQuants(body,g)
      == {}`); the capture obligation's clock-dominance is FREE (`MxAtGidNoQuant`
      makes every ancestor threshold `-1`, and `AncQuantsEmptyAncCap` lets it fire
      per ancestor), leaving only the set-clock hypothesis. Also emits the top-level
      `MxAtGid == -1` so `g`'s own dominance `clk(g) >= MxAtGid == -1` is free. This
      is the in-fragment reduction the coordinator identified: the whole clock/path
      algebra collapses to "ancestor captures are set". */
  lemma PathPresentNoQuantFromAncCapsSet(body: R.regex, cc: seq<int>, qc: seq<int>, g: nat)
    requires g in PIV.CapIds(body)
    requires PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires PIV.AncQuants(body, g) == {}
    requires forall c: nat :: c in PIV.AncCaps(body, g) ==> AI.get_idx(cc, CP.start_reg(c)) >= 0
    ensures PIV.PathPresent(body, cc, qc, -1, g)
    ensures PIV.MxAtGid(body, cc, qc, -1, g) == -1
  {
    forall c: nat | c in PIV.AncCaps(body, g)
      ensures AI.get_idx(cc, CP.start_reg(c)) >= 0
              && AI.get_idx(cc, CP.start_reg(c)) >= PIV.MxAtGid(body, cc, qc, -1, c)
    {
      AncQuantsEmptyAncCap(body, g, c);       // c in CapIds(body), AncQuants(body,c) == {}
      MxAtGidNoQuant(body, cc, qc, c);        // MxAtGid(body,cc,qc,-1,c) == -1
    }
    forall q: nat | q in PIV.AncQuants(body, g)
      ensures AI.get_idx(qc, q) >= PIV.MxAtQid(body, cc, qc, -1, q)
    {
      // vacuous: AncQuants(body, g) == {}
    }
    PIV.PathPresentIntro(body, cc, qc, -1, g);
    MxAtGidNoQuant(body, cc, qc, g);
  }

  /** (A2 in-fragment) `PathPresent` -> RAW ANCESTOR-SET (the converse of
      `PIV.PathPresentIntro`'s capture half): every capture strictly enclosing `g`
      has its start clock SET (`>= 0`). Read off the `Re_capture` clause of
      `PIV.PathPresent` along the descent — it demands each enclosing `cid`'s start
      clock be `>= 0` (and `>= mx`). This is the fact `NI.NestInvOpenSite` yields at
      `g`'s Open site (via `PathPresent`) and that the anytime register invariant
      `AncSetInvRE` maintains to `Accept`. */
  lemma PathPresentAncCapSet(re: R.regex, cc: seq<int>, qc: seq<int>, mx: int, g: nat)
    requires g in PIV.CapIds(re)
    requires PIV.PathPresent(re, cc, qc, mx, g)
    ensures forall c: nat :: c in PIV.AncCaps(re, g) ==> AI.get_idx(cc, CP.start_reg(c)) >= 0
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if g in PIV.CapIds(r1) { PathPresentAncCapSet(r1, cc, qc, mx, g); } else { PathPresentAncCapSet(r2, cc, qc, mx, g); }
    case Re_con(r1, r2) =>
      if g in PIV.CapIds(r1) { PathPresentAncCapSet(r1, cc, qc, mx, g); } else { PathPresentAncCapSet(r2, cc, qc, mx, g); }
    case Re_quant(nul, qid, q, r1) =>
      PathPresentAncCapSet(r1, cc, qc, AI.get_idx(qc, qid), g);
    case Re_capture(cid, r1) =>
      if cid >= 0 && (cid as nat) == g {
        // AncCaps(re, g) == {} : nothing to prove
      } else {
        assert g in PIV.CapIds(r1);
        assert AI.get_idx(cc, CP.start_reg(cid)) >= 0;   // PathPresent's enclosing-capture clause
        PathPresentAncCapSet(r1, cc, qc, mx, g);
      }
    case Re_lookaround(lid, l, r1) => PathPresentAncCapSet(r1, cc, qc, mx, g);
    case _ =>
  }

  /** (A2 in-fragment) THE ANYTIME REGISTER INVARIANT. `AncSetInvRE(re, cc)`: for
      every DIRECT capture `g` (`g !in CapIdsInLooks`) whose start clock is SET in
      `cc`, every capture strictly enclosing `g` is ALSO set. This is a pure
      register fact — NOT tied to a `pc` — so it does NOT collapse at the `Accept`
      terminator the way the positional `NestTopRE` does. It is MONOTONE and holds
      universally (any fragment): the engine never CLEARS a capture register (only
      `SetRegisterToCP` writes them, always to `Some(cp)` with `clk >= 0`; quantifier
      `Reset` writes only QUANT registers), and to reach `Open(g)` in the bytecode
      the thread must first pass `Open(c)` for each ancestor `c` (nesting). Reading
      it off the winning thread + `PathPresentNoQuantFromAncCapsSet` (for a no-quant
      `g`) yields the (A2) producer. */
  ghost predicate AncSetInvRE(re: R.regex, cc: seq<int>)
  {
    forall g: nat :: g in PIV.CapIds(re) && g !in PIV.CapIdsInLooks(re)
                     && AI.get_idx(cc, CP.start_reg(g)) >= 0
                     ==> (forall c: nat :: c in PIV.AncCaps(re, g) ==> AI.get_idx(cc, CP.start_reg(c)) >= 0)
  }

  /** (A2 in-fragment) ENTRY (base case) of the `AncSetInvRE` rider: the FRESH
      init registers (all clocks `< 0`, so NO capture start clock is set) satisfy
      `AncSetInvRE` VACUOUSLY. This is the base case the sim driver threads forward
      via `AncSetFrameStart` (non-Open steps) and `AncSetOpenStep` (the Open step)
      to the winning fresh thread. */
  lemma AncSetInitVacuous(re: R.regex, cc: seq<int>)
    requires forall k :: AI.get_idx(cc, k) < 0
    ensures AncSetInvRE(re, cc)
  {
    // The antecedent `AI.get_idx(cc, CP.start_reg(g)) >= 0` is false for every g.
  }

  /** (A2 in-fragment) FRAME preservation of `AncSetInvRE`: any VM step that leaves
      every capture START clock unchanged preserves it. Covers ALL non-Open steps
      the sim takes — `Close` (writes `end_reg`), quantifier `Reset` (writes a QUANT
      register), `Consume`, and every control step (`Fork`/`Jmp`/`BeginLoop`/
      `EndLoop`/anchors/`CheckOracle`) that touches no capture register — since
      `AncSetInvRE` reads only start clocks (`CP.start_reg` over `CapIds`, and
      `AncCaps <= CapIds`). */
  lemma AncSetFrameStart(re: R.regex, cc: seq<int>, cc': seq<int>)
    requires forall g: nat :: g in PIV.CapIds(re) ==> AI.get_idx(cc', CP.start_reg(g)) == AI.get_idx(cc, CP.start_reg(g))
    requires AncSetInvRE(re, cc)
    ensures AncSetInvRE(re, cc')
  {
    forall g: nat | g in PIV.CapIds(re) && g !in PIV.CapIdsInLooks(re) && AI.get_idx(cc', CP.start_reg(g)) >= 0
      ensures forall c: nat :: c in PIV.AncCaps(re, g) ==> AI.get_idx(cc', CP.start_reg(c)) >= 0
    {
      assert AI.get_idx(cc, CP.start_reg(g)) >= 0;       // g in CapIds(re)
      forall c: nat | c in PIV.AncCaps(re, g)
        ensures AI.get_idx(cc', CP.start_reg(c)) >= 0
      {
        assert c in PIV.CapIds(re);                      // AncCaps <= CapIds
        assert AI.get_idx(cc, CP.start_reg(c)) >= 0;     // AncSetInvRE(re, cc)
      }
    }
  }

  /** (A2 in-fragment) OPEN-STEP preservation of `AncSetInvRE` — the ONLY
      non-trivial VM step, and the mathematical HEART of the producer. When the
      thread executes `Open(g)` (`SetRegisterToCP(start_reg(g))`), writing `g`'s
      start clock, `AncSetInvRE` is preserved: the newly-set `g`'s own ancestor
      captures were ALREADY set, which `NI.NestInvOpenSite` certifies from the
      positional invariant `NestInvRE` (already threaded by `PikeInvFullRE`) as
      `PIV.PathPresent(re, cc, qc, mx, g)`, read off as raw ancestor-set by
      `PathPresentAncCapSet`; every OTHER set direct group keeps its (unchanged)
      start clock and its ancestors' (`start_reg` is injective: `== 2*·`), so
      `AncSetInvRE(re, cc)` carries them. This is the single step that consumes the
      bytecode Open-nesting; all others are `AncSetFrameStart`. Together they show
      `AncSetInvRE` is a genuine step-preserved invariant — inductively true from
      the fresh init state (vacuous: no capture set) to the winning thread at
      `Accept`, where the positional invariant is vacuous but this register fact is
      not. */
  lemma AncSetOpenStep(re: R.regex, code: RB.code, pcb: nat, pce: nat, pc: nat,
                       cc: seq<int>, cc': seq<int>, qc: seq<int>, mx: int, g: nat)
    requires NR.NfaRepRE(re, code, pcb, pce)
    requires PIV.CapUnique(re)
    requires pcb <= pc < pce
    requires NI.NestInvRE(re, code, pcb, pce, pc, cc, qc, mx)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(g)))
    requires AncSetInvRE(re, cc)
    requires AI.get_idx(cc', CP.start_reg(g)) >= 0
    requires forall k :: k != CP.start_reg(g) ==> AI.get_idx(cc', k) == AI.get_idx(cc, k)
    ensures AncSetInvRE(re, cc')
  {
    NI.NestInvOpenSite(re, code, pcb, pce, pc, cc, qc, mx, g);   // g in CapIds, direct, PathPresent(re,cc,qc,mx,g)
    PathPresentAncCapSet(re, cc, qc, mx, g);                     // forall c in AncCaps(re,g): cc[start_reg(c)]>=0
    forall h: nat | h in PIV.CapIds(re) && h !in PIV.CapIdsInLooks(re) && AI.get_idx(cc', CP.start_reg(h)) >= 0
      ensures forall c: nat :: c in PIV.AncCaps(re, h) ==> AI.get_idx(cc', CP.start_reg(c)) >= 0
    {
      forall c: nat | c in PIV.AncCaps(re, h)
        ensures AI.get_idx(cc', CP.start_reg(c)) >= 0
      {
        assert c in PIV.CapIds(re);                              // AncCaps <= CapIds
        if CP.start_reg(c) == CP.start_reg(g) {
          // cc'[start_reg(c)] == cc'[start_reg(g)] >= 0
        } else {
          // cc'[start_reg(c)] == cc[start_reg(c)]; show cc[start_reg(c)] >= 0
          if h == g {
            // c in AncCaps(re,g): PathPresentAncCapSet
          } else {
            assert CP.start_reg(h) == 2 * h && CP.start_reg(g) == 2 * g;   // injective
            assert CP.start_reg(h) != CP.start_reg(g);                     // h != g
            assert AI.get_idx(cc, CP.start_reg(h)) >= 0;                   // cc' == cc off start_reg(g)
            // AncSetInvRE(re,cc): h direct & set => every ancestor set, incl. c
          }
        }
      }
    }
  }

  /** (A2 in-fragment) LAST MILE: `AncSetInvRE` -> the R1 close. For a DIRECT,
      no-quantifier-ancestor `g` of a nested body, the anytime register invariant
      `AncSetInvRE(body, caps.a_clk)` (which `AncSetFrameStart`/`AncSetOpenStep`
      prove step-preserved, hence hold at the winning fresh thread) + a set start
      clock for `g` deliver the FULL (A2) close: `g in GmOfLive(body, ·)` at the raw
      `LiveRange`. Chains `PathPresentNoQuantFromAncCapsSet` (the no-quant collapse:
      `AncSetInvRE` gives every ancestor of `g` set, which becomes `PIV.PathPresent`
      + the free `-1` dominance) with the committed consumer `DirectBodyKeepsPresent
      LkNested`. `PIV.AncQuants(body, g) == {}` is the RE-side shadow of
      `GNotUnderQuantL(T.Translate(body), g)`; `PIV.CapRegWf(caps)` turns the set
      clock into a set value. This isolates the ENTIRE remaining (A2) obligation to
      the SINGLE register fact `AncSetInvRE(body, rf.caps.a_clk)` — a proven
      step-preserved invariant, owed only its threading through the sim driver. */
  lemma AncSetToMemberNested(body: R.regex, caps: AReg.Regs, look: AReg.Regs, quant: AReg.Regs, g: nat)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires g in PIV.CapIds(body)
    requires g !in PIV.CapIdsInLooks(body)
    requires PIV.AncQuants(body, g) == {}          // RE-side shadow of GNotUnderQuantL
    requires AncSetInvRE(body, AReg.as_arrays(caps).1)   // the step-preserved register invariant
    requires PIV.CapRegWf(caps)
    requires AI.get_idx(AReg.as_arrays(caps).1, CP.start_reg(g)) >= 0   // g's start clock set
    ensures g in PIV.GmOfLive(body, caps, look, quant)
    ensures PIV.GmOfLive(body, caps, look, quant)[g]
         == PIV.LiveRange(AReg.as_arrays(caps).0, AReg.as_arrays(caps).1, g)
  {
    var cc := AReg.as_arrays(caps).1;
    var qc := AReg.as_arrays(quant).1;
    // AncSetInvRE at the DIRECT, set g: every ancestor capture of g is set.
    assert forall c: nat :: c in PIV.AncCaps(body, g) ==> AI.get_idx(cc, CP.start_reg(c)) >= 0;
    // no-quant collapse: PathPresent + MxAtGid == -1.
    PathPresentNoQuantFromAncCapsSet(body, cc, qc, g);
    assert PIV.PathPresent(body, cc, qc, -1, g);
    assert PIV.MxAtGid(body, cc, qc, -1, g) == -1;
    // value set at g (CapRegWf: clk>=0 => cp>=0).
    assert AI.get_idx(AReg.as_arrays(caps).0, CP.start_reg(g)) >= 0;
    // close via the committed nested consumer.
    DirectBodyKeepsPresentLkNested(body, caps, look, quant, g);
  }

  // ===========================================================================
  // (A2) PRODUCER: threading `AncSetInvRE` through the fresh-body sim driver.
  //
  // `AncSetInvRE(re, cc)` is a MONOTONE, anytime register invariant that does
  // NOT collapse at Accept (unlike the positional `NestTopRE`). To read it off
  // the winning thread we thread a JOINT per-thread invariant through the whole
  // `FFindMatch` run: for every live thread, `AncSetInvRE` on its capture clocks
  // AND (guarded by an in-range pc) the positional companion `NI.NestTopRE`.
  // The positional companion is needed ONLY at the Open write, where
  // `AncSetOpenStep` consumes it to certify that the newly-opened group's
  // ancestors were already set. Every other step preserves `AncSetInvRE` via
  // `AncSetFrameStart` (capture start clocks unchanged) and advances the
  // positional companion via `NI.NestInvAdvance`/`NestInvStamp`/`NestInvFrameOdd`.
  // The positional claim is CONDITIONAL on `0 <= pc <= endl`, which makes the
  // control-flow successor cases self-supplying (a target's non-negativity is
  // free inside the guard), so no separate target-range lemma is needed.
  // ===========================================================================

  /** Per active thread: the anytime register invariant `AncSetInvRE`, plus the
      positional companion `NI.NestTopRE` guarded by an in-range pc. */
  ghost predicate ThreadAncNestRE(re: R.regex, code: RB.code, endl: nat, t: AI.Thread)
    requires NR.NfaRepRE(re, code, 0, endl)
  {
    AncSetInvRE(re, t.capture_regs.a_clk)
    && (0 <= t.pc <= endl ==>
          NI.NestTopRE(re, code, endl, t.pc as nat, t.capture_regs.a_clk, t.quant_regs.a_clk))
  }

  /** Per blocked thread: like `ThreadAncNestRE` but the positional companion is
      at `pc + 1` (blocked threads resume one instruction on after consuming). */
  ghost predicate BlkAncNestRE(re: R.regex, code: RB.code, endl: nat, t: AI.Thread)
    requires NR.NfaRepRE(re, code, 0, endl)
  {
    AncSetInvRE(re, t.capture_regs.a_clk)
    && (0 <= t.pc + 1 <= endl ==>
          NI.NestTopRE(re, code, endl, (t.pc + 1) as nat, t.capture_regs.a_clk, t.quant_regs.a_clk))
  }

  /** The joint invariant over the whole VM state: `ThreadAncNestRE` for every
      active thread, `BlkAncNestRE` for every blocked thread, and `AncSetInvRE`
      on `bestmatch` (the positional companion collapses at Accept, but the
      register invariant does not — this is exactly what the producer reads off). */
  ghost predicate VmAncNestRE(re: R.regex, code: RB.code, endl: nat, s: AI.VmState)
    requires NR.NfaRepRE(re, code, 0, endl)
  {
    (forall t | t in s.active :: ThreadAncNestRE(re, code, endl, t))
    && (forall tb | tb in s.blocked :: BlkAncNestRE(re, code, endl, tb.0))
    && (s.bestmatch.Some? ==> AncSetInvRE(re, s.bestmatch.value.capture_regs.a_clk))
  }

  /** (A2) THE ε-CLOSURE RIDER. `FAdvanceEpsilon` preserves the joint invariant
      `VmClocksLE ∧ VmRegsWf ∧ VmAncNestRE`. Mirrors `CM.FAdvanceEpsilonClocksLE`
      and `CM.FAdvanceEpsilonRegsWf` case-for-case over the ε-closure fuel, adding
      the `AncSetInvRE`/`NestTopRE` advance at each step: the Open write uses
      `AncSetOpenStep` + `NI.NestInvOpenWrite`; a Close write uses `AncSetFrameStart`
      + `NI.NestInvFrameOdd` + `NI.NestInvAdvance`; the quant stamp uses
      `AncSetFrameStart` + `NI.NestInvStamp`; every non-writing control step uses
      `NI.NestInvAdvance` (registers unchanged, so `AncSetInvRE` carries verbatim). */
  lemma FAdvanceEpsilonAncSet(re: R.regex, code: RB.code, endl: nat, s: AI.VmState,
                              ov: LOr.OracleView, dir: LAnc.direction,
                              ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(re)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires |code| == endl + 1
    requires PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires forall pc: nat, q: int, b: bool ::
               NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, b)) ==> !b
    requires |s.processed.true_set| == RB.size(code) && |s.processed.false_set| == RB.size(code)
    requires CM.VmClocksLE(s) && CM.VmRegsWf(s, ncap, nlook, nquant)
    requires s.clock >= 0 && s.cp >= 0
    requires VmAncNestRE(re, code, endl, s)
    ensures var r := AI.FAdvanceEpsilon(code, s, ov, dir).0;
            CM.VmClocksLE(r) && CM.VmRegsWf(r, ncap, nlook, nquant) && VmAncNestRE(re, code, endl, r)
    decreases AI.unprocessed(s.processed), |s.active|
  {
    if |s.active| == 0 {
      return;                       // FAdvanceEpsilon returns (s, ov)
    }
    var t := s.active[0];
    var ac := s.active[1..];
    assert t in s.active;
    assert forall x | x in ac :: x in s.active;
    var i := RB.get_instr(code, t.pc);

    if AI.bpc_mem(s.processed, t.pc, t.exit_allowed) {
      var s' := s.(active := ac);
      assert CM.VmClocksLE(s') && CM.VmRegsWf(s', ncap, nlook, nquant) && VmAncNestRE(re, code, endl, s');
      FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
      return;
    }

    var b0 := s.processed;
    var s1 := s.(clock := s.clock + 1, processed := AI.bpc_add(b0, t.pc, t.exit_allowed));
    assert AI.unprocessed(s1.processed) <= AI.unprocessed(b0)
           && (0 <= t.pc < RB.size(code) ==> AI.unprocessed(s1.processed) < AI.unprocessed(b0))
    by { AI.UnprocessedAdd(b0, t.pc, t.exit_allowed); }
    assert s.clock <= s1.clock;
    // Clock/positional facts for the head thread.
    assert CM.ThreadClocksLE(t, s.clock);                       // VmClocksLE(s), t in active
    assert CM.ThreadRegsWf(t, ncap, nlook, nquant);             // VmRegsWf(s), t in active
    assert ThreadAncNestRE(re, code, endl, t);                  // VmAncNestRE(s), t in active
    assert CM.ThreadClocksLE(t, s1.clock) by { CM.ThreadClocksLEMono(t, s.clock, s1.clock); }
    var cc := t.capture_regs.a_clk;
    var qc := t.quant_regs.a_clk;
    var clk := s1.clock;
    assert forall k :: AI.get_idx(cc, k) <= s.clock;            // ThreadClocksLE(t, s.clock)
    assert forall k :: AI.get_idx(qc, k) <= s.clock;

    match i {
      case Consume(ce) =>
        var (nb, ni) := AI.add_thread(t, ce, s1.blocked, s1.isblocked);
        var s' := s1.(blocked := nb, isblocked := ni, active := ac);
        assert 0 <= t.pc < |code|;
        // blocked-thread positional advance (guarded): pc -> pc+1 via a Consume edge.
        assert BlkAncNestRE(re, code, endl, t) by {
          if 0 <= t.pc + 1 <= endl {
            var pc: nat := t.pc as nat;
            assert pc < endl;                                   // Consume != Accept
            assert NI.NestTopRE(re, code, endl, pc, cc, qc);   // ThreadAncNestRE(t), 0<=pc<=endl
            assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
            assert NI.StepEdgeRE(code, pc, pc + 1);
            NI.NestInvAdvance(re, code, 0, endl, pc, pc + 1, cc, qc, -1);
          }
        }
        assert CM.VmClocksLE(s') by {
          forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
            assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock);
          }
          forall tb | tb in s'.blocked ensures CM.ThreadClocksLE(tb.0, s'.clock) {
            assert tb == (t, ce) || tb in s.blocked;
          }
        }
        assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
          forall tb | tb in s'.blocked ensures CM.ThreadRegsWf(tb.0, ncap, nlook, nquant) {
            assert tb == (t, ce) || tb in s.blocked;
          }
        }
        assert VmAncNestRE(re, code, endl, s') by {
          forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) { assert t2 in s.active; }
          forall tb | tb in s'.blocked ensures BlkAncNestRE(re, code, endl, tb.0) {
            assert tb == (t, ce) || tb in s.blocked;
          }
        }
        FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);

      case Accept =>
        // FAdvanceEpsilon returns (s1.(active := [], bestmatch := Some(t)), ov).
        assert CM.ThreadClocksLE(t, s1.clock);
        assert CM.ThreadRegsWf(t, ncap, nlook, nquant);
        assert AncSetInvRE(re, t.capture_regs.a_clk);          // ThreadAncNestRE(t)

      case Jmp(x) =>
        var s' := s1.(active := [t.(pc := x)] + ac);
        assert 0 <= t.pc < |code|;
        var pc: nat := t.pc as nat;
        assert pc < endl;
        var th' := t.(pc := x);
        assert ThreadAncNestRE(re, code, endl, th') by {
          if 0 <= x <= endl {
            assert NI.NestTopRE(re, code, endl, pc, cc, qc);
            assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
            assert NI.StepEdgeRE(code, pc, x as nat);
            NI.NestInvAdvance(re, code, 0, endl, pc, x as nat, cc, qc, -1);
          }
        }
        assert CM.VmClocksLE(s') by {
          forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
            if t2 == th' { } else { assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock); }
          }
        }
        assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
          forall t2 | t2 in s'.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
            if t2 != th' { assert t2 in s.active; }
          }
        }
        assert VmAncNestRE(re, code, endl, s') by {
          forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) {
            if t2 != th' { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);

      case Fork(x, y) =>
        var newt := AI.Thread(x, t.capture_regs, t.look_regs, t.quant_regs, t.exit_allowed);
        var s' := s1.(active := [newt, t.(pc := y)] + ac);
        assert 0 <= t.pc < |code|;
        var pc: nat := t.pc as nat;
        assert pc < endl;
        var th2 := t.(pc := y);
        assert NI.NestTopRE(re, code, endl, pc, cc, qc);
        assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
        assert ThreadAncNestRE(re, code, endl, newt) by {
          if 0 <= x <= endl {
            assert NI.StepEdgeRE(code, pc, x as nat);
            NI.NestInvAdvance(re, code, 0, endl, pc, x as nat, cc, qc, -1);
          }
        }
        assert ThreadAncNestRE(re, code, endl, th2) by {
          if 0 <= y <= endl {
            assert NI.StepEdgeRE(code, pc, y as nat);
            NI.NestInvAdvance(re, code, 0, endl, pc, y as nat, cc, qc, -1);
          }
        }
        assert CM.VmClocksLE(s') by {
          forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
            if t2 == newt || t2 == th2 { } else { assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock); }
          }
        }
        assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
          forall t2 | t2 in s'.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
            if t2 != newt && t2 != th2 { assert t2 in s.active; }
          }
        }
        assert VmAncNestRE(re, code, endl, s') by {
          forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) {
            if t2 != newt && t2 != th2 { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);

      case SetRegisterToCP(reg) =>
        var t' := t.(capture_regs := AReg.set_reg(t.capture_regs, reg, Some(s1.cp), s1.clock), pc := t.pc + 1);
        var s' := s1.(active := [t'] + ac);
        assert 0 <= t.pc < |code|;
        var pc: nat := t.pc as nat;
        assert pc < endl;
        var cc' := t'.capture_regs.a_clk;
        // register lengths & the write bridge
        assert |cc| == ncap;                                   // VmRegsWf(t)
        assert CM.ThreadRegsWf(t', ncap, nlook, nquant) by {
          CM.SetRegLens(t.capture_regs, reg, Some(s1.cp), s1.clock);
          PIV.CapRegWfSet(t.capture_regs, reg, s1.cp, s1.clock);
        }
        assert CM.ThreadClocksLE(t', s1.clock) by {
          CM.RegsClocksLESet(t.capture_regs, reg, Some(s1.cp), s1.clock, s1.clock);
        }
        // which register did we write? CodeShapeAt pins reg to a start/end reg of some cap.
        NI.CodeShapeAt(re, code, 0, endl, pc);
        var gid: nat :| gid in PIV.CapIds(re) && (reg == CP.start_reg(gid) || reg == CP.end_reg(gid));
        NI.CapIdsLEMaxGroup(re);
        assert gid <= R.max_group(re);
        assert ncap >= 2 * R.max_group(re) + 2;                // SizesOkRE
        assert CP.start_reg(gid) == 2 * gid && CP.end_reg(gid) == 2 * gid + 1;
        assert NI.NestTopRE(re, code, endl, pc, cc, qc);
        assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
        assert forall k :: AI.get_idx(cc, k) < clk;            // <= s.clock < clk
        assert forall k :: AI.get_idx(qc, k) < clk;
        assert 0 <= reg < |cc|;                                // reg in {2gid, 2gid+1}, both < 2*maxg+2 <= ncap == |cc|
        assert cc' == cc[reg := clk];
        assert forall k :: k != reg ==> AI.get_idx(cc', k) == AI.get_idx(cc, k)
        by { forall k | k != reg ensures AI.get_idx(cc', k) == AI.get_idx(cc, k) {
               CM.SetRegOtherIdx(t.capture_regs, reg, Some(s1.cp), s1.clock, k); } }
        if reg % 2 == 0 {
          // OPEN write: reg == start_reg(gid).
          assert reg == CP.start_reg(gid);                     // end_reg is odd
          assert AI.get_idx(cc', reg) == clk >= 0;
          AncSetOpenStep(re, code, 0, endl, pc, cc, cc', qc, -1, gid);
          NI.NestInvOpenWrite(re, code, 0, endl, pc, cc, cc', qc, -1, reg, clk);
          assert NI.NestTopRE(re, code, endl, pc + 1, cc', qc);
          assert AncSetInvRE(re, cc');
        } else {
          // CLOSE write: reg is odd, no start clock changes.
          assert forall g: nat :: g in PIV.CapIds(re) ==>
                                    AI.get_idx(cc', CP.start_reg(g)) == AI.get_idx(cc, CP.start_reg(g))
          by { forall g: nat | g in PIV.CapIds(re)
                 ensures AI.get_idx(cc', CP.start_reg(g)) == AI.get_idx(cc, CP.start_reg(g)) {
                 assert CP.start_reg(g) == 2 * g && CP.start_reg(g) != reg;   // reg odd
                 CM.SetRegOtherIdx(t.capture_regs, reg, Some(s1.cp), s1.clock, CP.start_reg(g)); } }
          AncSetFrameStart(re, cc, cc');
          assert AncSetInvRE(re, cc');
          assert forall j :: j % 2 == 0 ==> AI.get_idx(cc', j) == AI.get_idx(cc, j)
          by { forall j | j % 2 == 0 ensures AI.get_idx(cc', j) == AI.get_idx(cc, j) {
                 assert j != reg; CM.SetRegOtherIdx(t.capture_regs, reg, Some(s1.cp), s1.clock, j); } }
          NI.NestInvFrameOdd(re, code, 0, endl, pc, cc, cc', qc, -1);
          assert NI.NestInvRE(re, code, 0, endl, pc, cc', qc, -1);
          assert NI.StepEdgeRE(code, pc, pc + 1);
          NI.NestInvAdvance(re, code, 0, endl, pc, pc + 1, cc', qc, -1);
          assert NI.NestTopRE(re, code, endl, pc + 1, cc', qc);
        }
        assert ThreadAncNestRE(re, code, endl, t');
        assert CM.VmClocksLE(s') by {
          forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
            if t2 == t' { } else { assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock); }
          }
        }
        assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
          forall t2 | t2 in s'.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
            if t2 != t' { assert t2 in s.active; }
          }
        }
        assert VmAncNestRE(re, code, endl, s') by {
          forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) {
            if t2 != t' { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);

      case SetQuantToClock(q, bq) =>
        assert 0 <= t.pc < |code|;
        assert NR.GetPcRE(code, t.pc) == Some(i);              // get_instr <-> GetPcRE bridge
        assert !bq;                                            // no-true-stamp requires
        var ocp := if bq then Some(s1.cp) else None;
        var t' := t.(quant_regs := AReg.set_reg(t.quant_regs, q, ocp, s1.clock), pc := t.pc + 1);
        var s' := s1.(active := [t'] + ac);
        var pc: nat := t.pc as nat;
        assert pc < endl;
        var qc' := t'.quant_regs.a_clk;
        assert |qc| == nquant;                                 // VmRegsWf(t)
        assert CM.ThreadRegsWf(t', ncap, nlook, nquant) by {
          CM.SetRegLens(t.quant_regs, q, ocp, s1.clock);
        }
        assert CM.ThreadClocksLE(t', s1.clock) by {
          CM.RegsClocksLESet(t.quant_regs, q, ocp, s1.clock, s1.clock);
        }
        NI.CodeShapeAt(re, code, 0, endl, pc);
        assert q >= 0 && (q as nat) in PIV.QuantIds(re);
        NI.QuantIdsLEMaxQuant(re);
        assert (q as nat) <= R.max_quant(re);
        assert 0 <= q < |qc|;
        assert NI.NestTopRE(re, code, endl, pc, cc, qc);
        assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
        assert forall k :: AI.get_idx(cc, k) < clk;
        assert forall k :: AI.get_idx(qc, k) < clk;
        assert qc' == qc[q := clk];
        NI.NestInvStamp(re, code, 0, endl, pc, cc, qc, qc', -1, q, clk);
        assert NI.NestTopRE(re, code, endl, pc + 1, cc, qc');
        // AncSetInvRE reads only capture clocks (unchanged).
        assert t'.capture_regs.a_clk == cc;
        assert AncSetInvRE(re, cc);
        assert ThreadAncNestRE(re, code, endl, t');
        assert CM.VmClocksLE(s') by {
          forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
            if t2 == t' { } else { assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock); }
          }
        }
        assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
          forall t2 | t2 in s'.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
            if t2 != t' { assert t2 in s.active; }
          }
        }
        assert VmAncNestRE(re, code, endl, s') by {
          forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) {
            if t2 != t' { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);

      case CheckOracle(l) =>
        assert 0 <= t.pc < |code|;
        var pc: nat := t.pc as nat;
        assert pc < endl;
        if LOr.view_get_oracle(ov, s1.cp, l) {
          var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(s1.cp), s1.clock));
          var s' := s1.(active := [t'] + ac);
          assert CM.ThreadClocksLE(t', s1.clock) by {
            CM.RegsClocksLESet(t.look_regs, l, Some(s1.cp), s1.clock, s1.clock);
          }
          assert CM.ThreadRegsWf(t', ncap, nlook, nquant) by {
            CM.SetRegLens(t.look_regs, l, Some(s1.cp), s1.clock);
          }
          // look write is positional-neutral (NestInvRE reads capture+quant only).
          assert t'.capture_regs.a_clk == cc && t'.quant_regs.a_clk == qc;
          assert ThreadAncNestRE(re, code, endl, t') by {
            if 0 <= t.pc + 1 <= endl {
              assert NI.NestTopRE(re, code, endl, pc, cc, qc);
              assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
              assert NI.StepEdgeRE(code, pc, pc + 1);
              NI.NestInvAdvance(re, code, 0, endl, pc, pc + 1, cc, qc, -1);
            }
          }
          assert CM.VmClocksLE(s') by {
            forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
              if t2 == t' { } else { assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock); }
            }
          }
          assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
            forall t2 | t2 in s'.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
              if t2 != t' { assert t2 in s.active; }
            }
          }
          assert VmAncNestRE(re, code, endl, s') by {
            forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) {
              if t2 != t' { assert t2 in s.active; }
            }
          }
          FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
        } else {
          var s' := s1.(active := ac);
          assert CM.VmClocksLE(s') by {
            forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
              assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock);
            }
          }
          assert CM.VmRegsWf(s', ncap, nlook, nquant);
          assert VmAncNestRE(re, code, endl, s') by {
            forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) { assert t2 in s.active; }
          }
          FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
        }

      case NegCheckOracle(l) =>
        assert 0 <= t.pc < |code|;
        var pc: nat := t.pc as nat;
        assert pc < endl;
        if LOr.view_get_oracle(ov, s1.cp, l) {
          var s' := s1.(active := ac);
          assert CM.VmClocksLE(s') by {
            forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
              assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock);
            }
          }
          assert CM.VmRegsWf(s', ncap, nlook, nquant);
          assert VmAncNestRE(re, code, endl, s') by {
            forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) { assert t2 in s.active; }
          }
          FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
        } else {
          var th' := t.(pc := t.pc + 1);
          var s' := s1.(active := [th'] + ac);
          assert ThreadAncNestRE(re, code, endl, th') by {
            if 0 <= t.pc + 1 <= endl {
              assert NI.NestTopRE(re, code, endl, pc, cc, qc);
              assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
              assert NI.StepEdgeRE(code, pc, pc + 1);
              NI.NestInvAdvance(re, code, 0, endl, pc, pc + 1, cc, qc, -1);
            }
          }
          assert CM.VmClocksLE(s') by {
            forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
              if t2 == th' { } else { assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock); }
            }
          }
          assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
            forall t2 | t2 in s'.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
              if t2 != th' { assert t2 in s.active; }
            }
          }
          assert VmAncNestRE(re, code, endl, s') by {
            forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) {
              if t2 != th' { assert t2 in s.active; }
            }
          }
          FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
        }

      case WriteOracle(l) =>
        var s' := s1.(active := ac);
        assert 0 <= t.pc < |code|;
        assert CM.VmClocksLE(s') by {
          forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
            assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock);
          }
        }
        assert CM.VmRegsWf(s', ncap, nlook, nquant);
        assert VmAncNestRE(re, code, endl, s') by {
          forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) { assert t2 in s.active; }
        }
        FAdvanceEpsilonAncSet(re, code, endl, s', LOr.view_set_oracle(ov, s1.cp, l), dir, ncap, nlook, nquant);

      case BeginLoop =>
        var th' := t.(exit_allowed := false, pc := t.pc + 1);
        var s' := s1.(active := [th'] + ac);
        assert 0 <= t.pc < |code|;
        var pc: nat := t.pc as nat;
        assert pc < endl;
        assert ThreadAncNestRE(re, code, endl, th') by {
          if 0 <= t.pc + 1 <= endl {
            assert NI.NestTopRE(re, code, endl, pc, cc, qc);
            assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
            assert NI.StepEdgeRE(code, pc, pc + 1);
            NI.NestInvAdvance(re, code, 0, endl, pc, pc + 1, cc, qc, -1);
          }
        }
        assert CM.VmClocksLE(s') by {
          forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
            if t2 == th' { } else { assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock); }
          }
        }
        assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
          forall t2 | t2 in s'.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
            if t2 != th' { assert t2 in s.active; }
          }
        }
        assert VmAncNestRE(re, code, endl, s') by {
          forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) {
            if t2 != th' { assert t2 in s.active; }
          }
        }
        FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);

      case EndLoop =>
        assert 0 <= t.pc < |code|;
        var pc: nat := t.pc as nat;
        assert pc < endl;
        if t.exit_allowed {
          var th' := t.(pc := t.pc + 1);
          var s' := s1.(active := [th'] + ac);
          assert ThreadAncNestRE(re, code, endl, th') by {
            if 0 <= t.pc + 1 <= endl {
              assert NI.NestTopRE(re, code, endl, pc, cc, qc);
              assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
              assert NI.StepEdgeRE(code, pc, pc + 1);
              NI.NestInvAdvance(re, code, 0, endl, pc, pc + 1, cc, qc, -1);
            }
          }
          assert CM.VmClocksLE(s') by {
            forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
              if t2 == th' { } else { assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock); }
            }
          }
          assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
            forall t2 | t2 in s'.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
              if t2 != th' { assert t2 in s.active; }
            }
          }
          assert VmAncNestRE(re, code, endl, s') by {
            forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) {
              if t2 != th' { assert t2 in s.active; }
            }
          }
          FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
        } else {
          var s' := s1.(active := ac);
          assert CM.VmClocksLE(s') by {
            forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
              assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock);
            }
          }
          assert CM.VmRegsWf(s', ncap, nlook, nquant);
          assert VmAncNestRE(re, code, endl, s') by {
            forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) { assert t2 in s.active; }
          }
          FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
        }

      case CheckNullable(qid) =>
        // CheckNullable never occurs in nested main code (NoWriteInstrNestedRE).
        assert 0 <= t.pc < |code|;
        var pc: nat := t.pc as nat;
        assert pc < endl;
        assert NR.GetPcRE(code, pc) == Some(i);
        NR.NoWriteInstrNestedRE(re, code, 0, endl, pc);
        assert false;

      case AnchorAssertion(a) =>
        assert 0 <= t.pc < |code|;
        var pc: nat := t.pc as nat;
        assert pc < endl;
        if LAnc.is_satisfied(a, s1.context, dir) {
          var th' := t.(pc := t.pc + 1);
          var s' := s1.(active := [th'] + ac);
          assert ThreadAncNestRE(re, code, endl, th') by {
            if 0 <= t.pc + 1 <= endl {
              assert NI.NestTopRE(re, code, endl, pc, cc, qc);
              assert NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1);
              assert NI.StepEdgeRE(code, pc, pc + 1);
              NI.NestInvAdvance(re, code, 0, endl, pc, pc + 1, cc, qc, -1);
            }
          }
          assert CM.VmClocksLE(s') by {
            forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
              if t2 == th' { } else { assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock); }
            }
          }
          assert CM.VmRegsWf(s', ncap, nlook, nquant) by {
            forall t2 | t2 in s'.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
              if t2 != th' { assert t2 in s.active; }
            }
          }
          assert VmAncNestRE(re, code, endl, s') by {
            forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) {
              if t2 != th' { assert t2 in s.active; }
            }
          }
          FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
        } else {
          var s' := s1.(active := ac);
          assert CM.VmClocksLE(s') by {
            forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
              assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock);
            }
          }
          assert CM.VmRegsWf(s', ncap, nlook, nquant);
          assert VmAncNestRE(re, code, endl, s') by {
            forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) { assert t2 in s.active; }
          }
          FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
        }

      case Fail =>
        var s' := s1.(active := ac);
        assert CM.VmClocksLE(s') by {
          forall t2 | t2 in s'.active ensures CM.ThreadClocksLE(t2, s'.clock) {
            assert t2 in s.active; CM.ThreadClocksLEMono(t2, s.clock, s'.clock);
          }
        }
        assert CM.VmRegsWf(s', ncap, nlook, nquant);
        assert VmAncNestRE(re, code, endl, s') by {
          forall t2 | t2 in s'.active ensures ThreadAncNestRE(re, code, endl, t2) { assert t2 in s.active; }
        }
        FAdvanceEpsilonAncSet(re, code, endl, s', ov, dir, ncap, nlook, nquant);
    }
  }

  /** (A2) `FConsume` preserves the joint invariant. Blocked threads carry
      `BlkAncNestRE` (positional companion at `pc + 1`); the ones that accept the
      next char resume as active threads at `pc + 1`, which is exactly
      `ThreadAncNestRE`. Mirrors `CM.FConsumeClocksLE` + `CM.FConsumeRegsWf`. */
  lemma FConsumeAncSet(re: R.regex, code: RB.code, endl: nat, s: AI.VmState,
                       ncap: int, nlook: int, nquant: int)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires CM.VmClocksLE(s) && CM.VmRegsWf(s, ncap, nlook, nquant)
    requires VmAncNestRE(re, code, endl, s)
    ensures var r := AI.FConsume(s);
            CM.VmClocksLE(r) && CM.VmRegsWf(r, ncap, nlook, nquant) && VmAncNestRE(re, code, endl, r)
    decreases |s.blocked|
  {
    if |s.blocked| == 0 { return; }
    var t := s.blocked[0].0;
    var ce := s.blocked[0].1;
    var s1 := s.(blocked := s.blocked[1..]);
    assert s.blocked[0] in s.blocked;
    assert forall x | x in s1.blocked :: x in s.blocked;
    var th' := t.(exit_allowed := true, pc := t.pc + 1);
    var s2 := if RC.is_accepted(s1.context.nextchar, ce)
    then s1.(active := [th'] + s1.active)
    else s1;
    assert BlkAncNestRE(re, code, endl, t);                 // t == s.blocked[0].0
    assert CM.VmClocksLE(s2) by {
      assert s2.clock == s.clock;
      forall t2 | t2 in s2.active ensures CM.ThreadClocksLE(t2, s2.clock) {
        if t2 == th' { assert CM.ThreadClocksLE(t, s.clock); } else { assert t2 in s.active; }
      }
      forall tb | tb in s2.blocked ensures CM.ThreadClocksLE(tb.0, s2.clock) { assert tb in s.blocked; }
      if s2.bestmatch.Some? { assert CM.ThreadClocksLE(s2.bestmatch.value, s2.clock); }
    }
    assert CM.VmRegsWf(s2, ncap, nlook, nquant) by {
      forall t2 | t2 in s2.active ensures CM.ThreadRegsWf(t2, ncap, nlook, nquant) {
        if t2 == th' { assert CM.ThreadRegsWf(t, ncap, nlook, nquant); } else { assert t2 in s.active; }
      }
      forall tb | tb in s2.blocked ensures CM.ThreadRegsWf(tb.0, ncap, nlook, nquant) { assert tb in s.blocked; }
    }
    assert VmAncNestRE(re, code, endl, s2) by {
      forall t2 | t2 in s2.active ensures ThreadAncNestRE(re, code, endl, t2) {
        if t2 == th' {
          // th'.capture_regs == t.capture_regs, th'.quant_regs == t.quant_regs, th'.pc == t.pc + 1
          assert th'.capture_regs.a_clk == t.capture_regs.a_clk;
          assert th'.quant_regs.a_clk == t.quant_regs.a_clk;
        } else { assert t2 in s.active; }
      }
      forall tb | tb in s2.blocked ensures BlkAncNestRE(re, code, endl, tb.0) { assert tb in s.blocked; }
    }
    FConsumeAncSet(re, code, endl, s2, ncap, nlook, nquant);
  }

  /** (A2) THE OUTER DRIVER: a whole `FFindMatch` run preserves `AncSetInvRE` to
      the winning thread. Threads the joint invariant across the per-char
      `FAdvanceEpsilon`/`FConsume` phases (via `FAdvanceEpsilonAncSet` and
      `FConsumeAncSet`), so the returned best-match thread satisfies the anytime
      register invariant `AncSetInvRE(re, r.capture_regs.a_clk)`. Mirrors
      `M.FFindMatchThreadFacts`'s driver structure (`decreases |str| - s.cp`). */
  lemma FFindMatchAncSet(re: R.regex, code: RB.code, endl: nat, str: string, s: AI.VmState,
                         ov: LOr.OracleView, dir: LAnc.direction, cdn: LCdn.cdns,
                         ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(re)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires |code| == endl + 1
    requires PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires forall pc: nat, q: int, b: bool ::
               NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, b)) ==> !b
    requires |s.processed.true_set| == RB.size(code) && |s.processed.false_set| == RB.size(code)
    requires dir == LAnc.Forward
    requires s.context.nextchar == AI.get_char(str, s.cp)
    requires s.clock >= 0 && s.cp >= 0
    requires CM.VmClocksLE(s) && CM.VmRegsWf(s, ncap, nlook, nquant)
    requires VmAncNestRE(re, code, endl, s)
    ensures var r := AI.FFindMatch(code, str, s, ov, dir, cdn).0;
            r.Some? ==> AncSetInvRE(re, r.value.capture_regs.a_clk)
    decreases |str| - s.cp
  {
    var s0 := s.(cdn := LCdn.build_cdn_v(cdn, s.cp, ov, s.context, dir));
    assert CM.VmClocksLE(s0) && CM.VmRegsWf(s0, ncap, nlook, nquant) && VmAncNestRE(re, code, endl, s0);
    FAdvanceEpsilonAncSet(re, code, endl, s0, ov, dir, ncap, nlook, nquant);
    CM.FAdvanceEpsilonClocksLE(code, s0, ov, dir);         // r.clock >= s0.clock
    var (s1, ov1) := AI.FAdvanceEpsilon(code, s0, ov, dir);
    assert s1.cp == s.cp && s1.context == s.context;
    assert s1.clock >= s0.clock >= 0;
    assert CM.VmClocksLE(s1) && CM.VmRegsWf(s1, ncap, nlook, nquant) && VmAncNestRE(re, code, endl, s1);

    if |s1.blocked| == 0 {
      assert AI.FFindMatch(code, str, s, ov, dir, cdn).0 == s1.bestmatch;
    } else if s1.context.nextchar.None? {
      assert AI.FFindMatch(code, str, s, ov, dir, cdn).0 == s1.bestmatch;
    } else {
      assert AI.get_char(str, s.cp).Some?;
      assert 0 <= s.cp < |str|;
      FConsumeAncSet(re, code, endl, s1, ncap, nlook, nquant);
      CM.FConsumeClocksLE(s1);                             // r.clock == s1.clock
      var s2 := AI.FConsume(s1);
      var s3 := s2.(processed := AI.init_bpcset(RB.size(code)), isblocked := AI.init_pcset(RB.size(code)),
      cdn := LCdn.init_cdn(), cp := AI.incr_cp(s2.cp, dir));
      var newchar := AI.get_char(str, s3.cp - AI.cp_offset(dir));
      var s4 := s3.(context := LAnc.update_context(s3.context, newchar));
      assert s4.cp == s.cp + 1;
      assert s4.context.nextchar == AI.get_char(str, s4.cp);
      assert s4.active == s2.active && s4.blocked == s2.blocked
             && s4.bestmatch == s2.bestmatch && s4.clock == s2.clock;
      assert CM.VmClocksLE(s4);
      assert CM.VmRegsWf(s4, ncap, nlook, nquant);
      assert VmAncNestRE(re, code, endl, s4);
      assert s4.clock >= 0 by { assert s4.clock == s2.clock == s1.clock; }
      FFindMatchAncSet(re, code, endl, str, s4, ov1, dir, cdn, ncap, nlook, nquant);
      assert AI.FFindMatch(code, str, s, ov, dir, cdn) == AI.FFindMatch(code, str, s4, ov1, dir, cdn);
    }
  }

  /** (A2) THE FRESH-BODY-MATCH BRIDGE: a fresh (init-register) FORWARD match of a
      NESTED-fragment body from position `cp` yields `AncSetInvRE(body, ·)` on the
      winning thread. Establishes the ε-closure driver's entry invariant at
      `FInitState` — `AncSetInvRE` VACUOUSLY (fresh clocks all `< 0`, via
      `AncSetInitVacuous`) and the positional companion at `pc == 0` (via
      `NI.NestTopInit`) — then threads it with `FFindMatchAncSet`. Mirrors
      `FreshMatchWfNested`'s entry setup; this is the (A2) producer at the fresh
      body match, ready to discharge `FreshBodyDirectMemberFromAncSet`'s residual. */
  lemma FreshBodyMatchAncSet(bytecode: RB.code, str: string, cp: int, ov: LOr.OracleView, cdn: LCdn.cdns,
                             body: R.regex, endl: nat, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(body)
    requires NR.NfaRepRE(body, bytecode, 0, endl)
    requires NR.GetPcRE(bytecode, endl) == Some(RB.Accept)
    requires |bytecode| == endl + 1
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    ensures var rf := AI.FFindMatch(bytecode, str,
                                    AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                                    ov, LAnc.Forward, cdn).0;
            rf.Some? ==> AncSetInvRE(body, rf.value.capture_regs.a_clk)
  {
    var dir := LAnc.Forward;
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                               AReg.init_regs(nquant), 0, ctx);
    CM.RegsClocksLEInit(ncap, 0); CM.RegsClocksLEInit(nlook, 0); CM.RegsClocksLEInit(nquant, 0);
    CM.FInitStateClocksLE(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                          AReg.init_regs(nquant), 0, ctx);
    CM.FInitStateRegsWf(bytecode, cp, ncap, nlook, nquant, 0, ctx);
    NoTrueQuantStampNested(body);
    // entry joint invariant: AncSetInvRE vacuously, NestTop at pc 0.
    CM.RegsClocksLEInit(ncap, -1);                       // init capture clocks all < 0
    CM.RegsClocksLEInit(nquant, -1);
    assert VmAncNestRE(body, bytecode, endl, inits) by {
      var th := AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant));
      assert inits.active == [th];
      forall t | t in inits.active ensures ThreadAncNestRE(body, bytecode, endl, t) {
        assert t == th;
        assert forall k :: AI.get_idx(th.capture_regs.a_clk, k) < 0;   // RegsClocksLEInit(ncap,-1)
        AncSetInitVacuous(body, th.capture_regs.a_clk);
        if 0 <= th.pc <= endl {
          assert th.pc == 0;
          NI.NestTopInit(body, bytecode, endl, th.capture_regs.a_clk, th.quant_regs.a_clk);
        }
      }
    }
    FFindMatchAncSet(body, bytecode, endl, str, inits, ov, dir, cdn, ncap, nlook, nquant);
  }
  // ===========================================================================
  // (L5 F7c-2b) LOOKBEHIND twins for the ancestor-set rider of the fresh body
  // match: the BACKWARD run of `compile(reverse_regex(body))`. The invariant
  // `AncSetInvRE` is `reverse_regex`-invariant (capture NESTING is untouched).
  // ===========================================================================

  lemma ReverseMaxGroup(r: R.regex)
    ensures R.max_group(R.reverse_regex(r)) == R.max_group(r)
    decreases r
  {
    match r
    case Re_alt(r1, r2) => ReverseMaxGroup(r1); ReverseMaxGroup(r2);
    case Re_con(r1, r2) => ReverseMaxGroup(r1); ReverseMaxGroup(r2);
    case Re_quant(_, _, _, r1) => ReverseMaxGroup(r1);
    case Re_capture(_, r1) => ReverseMaxGroup(r1);
    case Re_lookaround(_, _, r1) => ReverseMaxGroup(r1);
    case _ =>
  }
  lemma ReverseMaxQuant(r: R.regex)
    ensures R.max_quant(R.reverse_regex(r)) == R.max_quant(r)
    decreases r
  {
    match r
    case Re_alt(r1, r2) => ReverseMaxQuant(r1); ReverseMaxQuant(r2);
    case Re_con(r1, r2) => ReverseMaxQuant(r1); ReverseMaxQuant(r2);
    case Re_quant(_, _, _, r1) => ReverseMaxQuant(r1);
    case Re_capture(_, r1) => ReverseMaxQuant(r1);
    case Re_lookaround(_, _, r1) => ReverseMaxQuant(r1);
    case _ =>
  }
  lemma ReverseSizesOk(body: R.regex, ncap: int, nlook: int, nquant: int)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    ensures PSM.SizesOkRE(R.reverse_regex(body), ncap, nlook, nquant)
  { ReverseMaxGroup(body); ReverseMaxQuant(body); }

  /** Capture NESTING is `reverse_regex`-invariant (unique ids pick the same branch). */
  lemma ReverseAncCaps(r: R.regex, gid: nat)
    requires PIV.CapUnique(r) && gid in PIV.CapIds(r)
    ensures gid in PIV.CapIds(R.reverse_regex(r))
    ensures PIV.AncCaps(R.reverse_regex(r), gid) == PIV.AncCaps(r, gid)
    decreases r
  {
    PIV.ReverseCapIds(r);
    match r
    case Re_alt(r1, r2) =>
      PIV.ReverseCapIds(r1); PIV.ReverseCapIds(r2);
      assert R.reverse_regex(r) == R.Re_alt(R.reverse_regex(r1), R.reverse_regex(r2));
      if gid in PIV.CapIds(r1) {
        ReverseAncCaps(r1, gid);
      } else {
        assert gid in PIV.CapIds(r2);
        ReverseAncCaps(r2, gid);
      }
    case Re_con(r1, r2) =>
      PIV.ReverseCapIds(r1); PIV.ReverseCapIds(r2);
      assert PIV.CapIds(r1) * PIV.CapIds(r2) == {};                          // CapUnique
      assert R.reverse_regex(r) == R.Re_con(R.reverse_regex(r2), R.reverse_regex(r1));
      if gid in PIV.CapIds(r1) {
        assert gid !in PIV.CapIds(r2) by { assert gid in PIV.CapIds(r1) * PIV.CapIds(r2) ==> false; }
        assert gid !in PIV.CapIds(R.reverse_regex(r2));
        ReverseAncCaps(r1, gid);
        assert PIV.AncCaps(R.reverse_regex(r), gid) == PIV.AncCaps(R.reverse_regex(r1), gid);
      } else {
        assert gid in PIV.CapIds(r2);
        assert gid in PIV.CapIds(R.reverse_regex(r2));
        ReverseAncCaps(r2, gid);
        assert PIV.AncCaps(R.reverse_regex(r), gid) == PIV.AncCaps(R.reverse_regex(r2), gid);
      }
    case Re_quant(_, _, _, r1) => ReverseAncCaps(r1, gid);
    case Re_lookaround(_, _, r1) => ReverseAncCaps(r1, gid);
    case Re_capture(cid, r1) =>
      if cid >= 0 && (cid as nat) == gid {
      } else {
        ReverseAncCaps(r1, gid);
      }
    case _ =>
  }

  lemma AncSetInvREReverse(re: R.regex, cc: seq<int>)
    requires PIV.CapUnique(re)
    ensures AncSetInvRE(R.reverse_regex(re), cc) <==> AncSetInvRE(re, cc)
  {
    var rev := R.reverse_regex(re);
    PIV.ReverseCapIds(re);
    ReverseCapIdsInLooks(re);
    forall g: nat | g in PIV.CapIds(re) ensures PIV.AncCaps(rev, g) == PIV.AncCaps(re, g) {
      ReverseAncCaps(re, g);
    }
  }

  /** Backward twin of `FFindMatchAncSet` (the step lemmas are direction-generic). */
  lemma FFindMatchAncSetB(re: R.regex, code: RB.code, endl: nat, str: string, s: AI.VmState,
                          ov: LOr.OracleView, dir: LAnc.direction, cdn: LCdn.cdns,
                          ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(re)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires |code| == endl + 1
    requires PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires forall pc: nat, q: int, b: bool ::
               NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, b)) ==> !b
    requires |s.processed.true_set| == RB.size(code) && |s.processed.false_set| == RB.size(code)
    requires dir == LAnc.Backward
    requires s.context.nextchar == AI.get_char(str, s.cp - 1)
    requires s.clock >= 0 && 0 <= s.cp <= |str|
    requires CM.VmClocksLE(s) && CM.VmRegsWf(s, ncap, nlook, nquant)
    requires VmAncNestRE(re, code, endl, s)
    ensures var r := AI.FFindMatch(code, str, s, ov, dir, cdn).0;
            r.Some? ==> AncSetInvRE(re, r.value.capture_regs.a_clk)
    decreases s.cp
  {
    var s0 := s.(cdn := LCdn.build_cdn_v(cdn, s.cp, ov, s.context, dir));
    assert CM.VmClocksLE(s0) && CM.VmRegsWf(s0, ncap, nlook, nquant) && VmAncNestRE(re, code, endl, s0);
    FAdvanceEpsilonAncSet(re, code, endl, s0, ov, dir, ncap, nlook, nquant);
    CM.FAdvanceEpsilonClocksLE(code, s0, ov, dir);
    var (s1, ov1) := AI.FAdvanceEpsilon(code, s0, ov, dir);
    assert s1.cp == s.cp && s1.context == s.context;
    assert s1.clock >= s0.clock >= 0;
    assert CM.VmClocksLE(s1) && CM.VmRegsWf(s1, ncap, nlook, nquant) && VmAncNestRE(re, code, endl, s1);

    if |s1.blocked| == 0 {
      assert AI.FFindMatch(code, str, s, ov, dir, cdn).0 == s1.bestmatch;
    } else if s1.context.nextchar.None? {
      assert AI.FFindMatch(code, str, s, ov, dir, cdn).0 == s1.bestmatch;
    } else {
      assert AI.get_char(str, s.cp - 1).Some?;
      assert 0 < s.cp <= |str|;
      FConsumeAncSet(re, code, endl, s1, ncap, nlook, nquant);
      CM.FConsumeClocksLE(s1);
      var s2 := AI.FConsume(s1);
      var s3 := s2.(processed := AI.init_bpcset(RB.size(code)), isblocked := AI.init_pcset(RB.size(code)),
      cdn := LCdn.init_cdn(), cp := AI.incr_cp(s2.cp, dir));
      var newchar := AI.get_char(str, s3.cp - AI.cp_offset(dir));
      var s4 := s3.(context := LAnc.update_context(s3.context, newchar));
      assert s4.cp == s.cp - 1;
      assert s4.context.nextchar == AI.get_char(str, s4.cp - 1);
      assert s4.active == s2.active && s4.blocked == s2.blocked
             && s4.bestmatch == s2.bestmatch && s4.clock == s2.clock;
      assert CM.VmClocksLE(s4);
      assert CM.VmRegsWf(s4, ncap, nlook, nquant);
      assert VmAncNestRE(re, code, endl, s4);
      assert s4.clock >= 0 by { assert s4.clock == s2.clock == s1.clock; }
      FFindMatchAncSetB(re, code, endl, str, s4, ov1, dir, cdn, ncap, nlook, nquant);
      assert AI.FFindMatch(code, str, s, ov, dir, cdn) == AI.FFindMatch(code, str, s4, ov1, dir, cdn);
    }
  }

  /** LB twin of `FreshBodyMatchAncSet`: the ancestor-set rider for the fresh
      BACKWARD body match of `compile(reverse_regex(body))`, stated on `body`. */
  lemma FreshBodyMatchAncSetLB(bytecode: RB.code, str: string, cp: int, ov: LOr.OracleView, cdn: LCdn.cdns,
                               body: R.regex, endl: nat, ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires bytecode == CP.compile_to_bytecode(R.reverse_regex(body))
    requires NR.NfaRepRE(R.reverse_regex(body), bytecode, 0, endl)
    requires NR.GetPcRE(bytecode, endl) == Some(RB.Accept)
    requires |bytecode| == endl + 1
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires 0 <= cp <= |str|
    requires AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1)
    ensures var rf := AI.FFindMatch(bytecode, str,
                                    AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                                  AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                                    ov, LAnc.Backward, cdn).0;
            rf.Some? ==> AncSetInvRE(body, rf.value.capture_regs.a_clk)
  {
    var dir := LAnc.Backward;
    var rev := R.reverse_regex(body);
    ReverseNestedPackage(body);
    ReverseSizesOk(body, ncap, nlook, nquant);
    var ctx := AI.cp_context(cp, str, dir);
    var inits := AI.FInitState(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                               AReg.init_regs(nquant), 0, ctx);
    CM.RegsClocksLEInit(ncap, 0); CM.RegsClocksLEInit(nlook, 0); CM.RegsClocksLEInit(nquant, 0);
    CM.FInitStateClocksLE(bytecode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                          AReg.init_regs(nquant), 0, ctx);
    CM.FInitStateRegsWf(bytecode, cp, ncap, nlook, nquant, 0, ctx);
    NoTrueQuantStampNested(rev);
    CM.RegsClocksLEInit(ncap, -1);
    CM.RegsClocksLEInit(nquant, -1);
    assert VmAncNestRE(rev, bytecode, endl, inits) by {
      var th := AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant));
      assert inits.active == [th];
      forall t | t in inits.active ensures ThreadAncNestRE(rev, bytecode, endl, t) {
        assert t == th;
        assert forall k :: AI.get_idx(th.capture_regs.a_clk, k) < 0;
        AncSetInitVacuous(rev, th.capture_regs.a_clk);
        if 0 <= th.pc <= endl {
          assert th.pc == 0;
          NI.NestTopInit(rev, bytecode, endl, th.capture_regs.a_clk, th.quant_regs.a_clk);
        }
      }
    }
    FFindMatchAncSetB(rev, bytecode, endl, str, inits, ov, dir, cdn, ncap, nlook, nquant);
    var rf := AI.FFindMatch(bytecode, str, inits, ov, dir, cdn).0;
    if rf.Some? {
      AncSetInvREReverse(body, rf.value.capture_regs.a_clk);
    }
  }


  // ===========================================================================
  // (REVERSE GATE-CROSSING CONNECTIVE) The winning-thread LOOK-DOMINANCE register
  // read-off. Mirrors the (A2) `AncSetInvRE` producer's LAST MILE
  // (`AncSetToMemberNested`): a register predicate `LookDomInvRE` that, for every
  // matched TOP look `lid`, carries `LookPathPresent` + the look-stamp-over-
  // threshold bound, and reads off `NI.LookPathDom(re, lc[lid], qc, lid)` via the
  // nested top-look assembler `NI.LookPathDomIntroTop`. This is the exact residual
  // `LiftSim.DescentPackageDirectFromRes1` owes on the winning thread's banks.
  // ===========================================================================

  /** (REVERSE GATE) THE LOOK-DOMINANCE REGISTER INVARIANT. For every matched TOP
      look `lid` (`lc[lid] >= 0`), path presence to the gate holds and the look
      stamp dominates the node threshold `MxAtLidLk`. Restricted to `TopLookIds`
      (the deliverable's scope): a top look's descent never crosses a look body,
      so the depth-1 `LookPathPresent`/`MxAtLidLk` read exactly the path. The
      guard `lid in LookIds(re)` keeps the `LookPathPresent`/`MxAtLidLk` calls
      well-formed (`TopLookIds <= LookIds`, but a predicate body cannot invoke the
      subset lemma). */
  ghost predicate LookDomInvRE(re: R.regex, cc: seq<int>, lc: seq<int>, qc: seq<int>)
  {
    forall lid: nat :: lid in LTB.LookIds(re) && lid in NI.TopLookIds(re)
                       && AI.get_idx(lc, lid as int) >= 0
                       ==> NI.LookPathPresent(re, cc, qc, -1, lid)
                           && AI.get_idx(lc, lid as int) >= NI.MxAtLidLk(re, qc, -1, lid)
  }

  /** (REVERSE GATE) LAST MILE: `LookDomInvRE` -> `NI.LookPathDom` at a matched
      TOP look `A0`. Reads the per-`A0` conjunct off the invariant and closes with
      `NI.LookPathDomIntroTop` (the nested top-look dominance assembler). This is
      exactly the shape `DescentPackageDirectFromRes1`'s residual `requires`
      consumes on the winning thread's banks. */
  lemma LookDomInvToLookPathDom(re: R.regex, cc: seq<int>, lc: seq<int>, qc: seq<int>, A0: nat)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re)
    requires A0 in NI.TopLookIds(re)
    requires AI.get_idx(lc, A0 as int) >= 0
    requires LookDomInvRE(re, cc, lc, qc)
    ensures A0 in LTB.LookIds(re)
    ensures NI.LookPathDom(re, AI.get_idx(lc, A0 as int), qc, A0)
  {
    NI.TopLookIdsIn(re);
    assert A0 in LTB.LookIds(re);
    assert NI.LookPathPresent(re, cc, qc, -1, A0)
           && AI.get_idx(lc, A0 as int) >= NI.MxAtLidLk(re, qc, -1, A0);
    NI.LookPathDomIntroTop(re, cc, qc, -1, A0, AI.get_idx(lc, A0 as int));
  }

  /** (REVERSE GATE — the CROSSING step, analog of `AncSetOpenStep`) A gate
      crossing `CheckOracle(l)` that stamps `lc'[l] := clk` (a FRESH clock beating
      every stored quant clock, `clk > B >= qc[k]`) ESTABLISHES the invariant for
      the newly-matched look, and frames it for every other. For the top look `l`
      itself (when `l in TopLookIds`), the positional `NI.NestInvLookSiteNested`
      reads `LookPathPresent(re, cc, qc, -1, l)` straight off the gate-site
      `NestInvRE`, and `NI.MxAtLidLE` bounds the node threshold below the fresh
      stamp (`MxAtLidLk <= B < clk`) — the "crossing establishes dominance
      outright" fact. For every OTHER matched top look the look bank is unchanged
      at its slot and `cc`/`qc` are untouched, so the conjunct carries from
      `LookDomInvRE(re, cc, lc, qc)`. This is the sole invariant-ESTABLISHING step;
      it is proven NON-CIRCULARLY from the winning thread's own gate-site
      positional invariant. */
  lemma LookCrossEstablishesDomTop(re: R.regex, code: RB.code, endl: nat, pc: nat,
                                   cc: seq<int>, lc: seq<int>, lc': seq<int>, qc: seq<int>,
                                   l: int, clk: int, B: int)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires 0 <= pc < endl
    requires NI.NestInvRE(re, code, 0, endl, pc, cc, qc, -1)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(l))
    requires -1 <= B
    requires forall k :: AI.get_idx(qc, k) <= B
    requires clk > B
    requires forall j: int :: j != l ==> AI.get_idx(lc', j) == AI.get_idx(lc, j)
    requires AI.get_idx(lc', l) == clk
    requires LookDomInvRE(re, cc, lc, qc)
    ensures LookDomInvRE(re, cc, lc', qc)
  {
    forall lid: nat | lid in LTB.LookIds(re) && lid in NI.TopLookIds(re)
                      && AI.get_idx(lc', lid as int) >= 0
      ensures NI.LookPathPresent(re, cc, qc, -1, lid)
              && AI.get_idx(lc', lid as int) >= NI.MxAtLidLk(re, qc, -1, lid)
    {
      if lid as int == l {
        NI.NestInvLookSiteNested(re, code, 0, endl, pc, cc, qc, -1, l);
        assert NI.LookPathPresent(re, cc, qc, -1, lid);
        NI.MxAtLidLE(re, qc, -1, lid, B);          // MxAtLidLk(re,qc,-1,lid) <= B < clk
        assert AI.get_idx(lc', lid as int) == clk;
      } else {
        assert AI.get_idx(lc', lid as int) == AI.get_idx(lc, lid as int);
        assert AI.get_idx(lc, lid as int) >= 0;
      }
    }
  }

  /** (REVERSE GATE — capture-write frame) A fresh capture-clock write (`Open`)
      preserves `LookDomInvRE`: `NI.LookPathPresentFreshCap` shows path presence
      is monotone under a stamp beating every quant clock, and `MxAtLidLk` reads
      no capture slot so the look-stamp bound is untouched (`qc`, `lc` unchanged).
      Mirrors `AncSetFrameStart` for the capture writes. */
  lemma LookDomFrameCap(re: R.regex, cc: seq<int>, cc': seq<int>, lc: seq<int>, qc: seq<int>, B: int)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re)
    requires -1 <= B
    requires forall k :: AI.get_idx(qc, k) <= B
    requires forall j: int :: AI.get_idx(cc', j) == AI.get_idx(cc, j)
                              || (AI.get_idx(cc', j) >= 0 && AI.get_idx(cc', j) >= B)
    requires LookDomInvRE(re, cc, lc, qc)
    ensures LookDomInvRE(re, cc', lc, qc)
  {
    forall lid: nat | lid in LTB.LookIds(re) && lid in NI.TopLookIds(re)
                      && AI.get_idx(lc, lid as int) >= 0
      ensures NI.LookPathPresent(re, cc', qc, -1, lid)
              && AI.get_idx(lc, lid as int) >= NI.MxAtLidLk(re, qc, -1, lid)
    {
      NI.LookPathPresentFreshCap(re, cc, cc', qc, -1, lid, B);
    }
  }

  /** (REVERSE GATE — OFF-path quant re-stamp frame) A `SetQuantToClock(q)` whose
      quantifier `q` encloses NO look (`LookIds(QidBody(re,q)) == {}`) preserves
      `LookDomInvRE`: every look is off `q`'s path, so `NI.LookPathPresentQuant
      OffPath` leaves both `LookPathPresent` and `MxAtLidLk` unchanged. NOTE: this
      is the COMPLEMENT of the genuine obstruction — an ON-path re-stamp (an
      enclosing quant of a MATCHED top look) BREAKS dominance (`NI.LookPathDom
      OnPathBreaksNested`), which is exactly why the anytime register invariant is
      NOT step-preserved in general (see the reverse-gate residual note). */
  lemma LookDomFrameQuantOffPath(re: R.regex, cc: seq<int>, lc: seq<int>, qc: seq<int>,
                                 qc': seq<int>, q: nat)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re) && PIV.QuantUnique(re)
    requires q in PIV.QuantIds(re)
    requires LTB.LookIds(PIV.QidBody(re, q)) == {}
    requires forall j: int :: j != q as int ==> AI.get_idx(qc', j) == AI.get_idx(qc, j)
    requires LookDomInvRE(re, cc, lc, qc)
    ensures LookDomInvRE(re, cc, lc, qc')
  {
    forall lid: nat | lid in LTB.LookIds(re) && lid in NI.TopLookIds(re)
                      && AI.get_idx(lc, lid as int) >= 0
      ensures NI.LookPathPresent(re, cc, qc', -1, lid)
              && AI.get_idx(lc, lid as int) >= NI.MxAtLidLk(re, qc', -1, lid)
    {
      assert lid !in LTB.LookIds(PIV.QidBody(re, q));
      NI.LookPathPresentQuantOffPath(re, cc, qc, qc', -1, lid, q);
    }
  }

  /** (REVERSE GATE — THREAD-LEVEL INTERFACE) The deliverable's reduction, made
      explicit and machine-checked ON THE WINNING THREAD: given `LookDomInvRE` on
      the thread's own banks and a matched top look `A0` (clock set), reads off
      EXACTLY `DescentPackageDirectFromRes1`'s owed residual
      `NI.LookPathDom(re, thread.look_regs.a_clk[A0], thread.quant_regs.a_clk, A0)`.
      Thin wrapper over `LookDomInvToLookPathDom`; this isolates the ENTIRE
      remaining reverse-gate obligation to the SINGLE producer of `LookDomInvRE`
      on the whole-regex `FFindMatch` winning thread (the (A2)-mirror driver). */
  lemma ReverseGateResidualFromInv(re: R.regex, thread: AI.Thread, A0: nat)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re)
    requires A0 in NI.TopLookIds(re)
    requires A0 in LTB.LookIds(re)
    requires AI.get_idx(thread.look_regs.a_clk, A0 as int) >= 0
    requires LookDomInvRE(re, thread.capture_regs.a_clk, thread.look_regs.a_clk,
                          thread.quant_regs.a_clk)
    ensures NI.LookPathDom(re, AI.get_idx(thread.look_regs.a_clk, A0 as int),
                           thread.quant_regs.a_clk, A0)
  {
    LookDomInvToLookPathDom(re, thread.capture_regs.a_clk, thread.look_regs.a_clk,
                            thread.quant_regs.a_clk, A0);
  }

  /** (REVERSE GATE — `MatchedPosLA` form) The interface stated with the descent's
      native `MatchedPosLA` hypothesis (a recorded look cp). Bridges cp-set to
      clock-set via `CM.LookClkSetWithCp` (the anytime look-clock producer's
      invariant, carried on every VM thread) + `RL.AAsArraysLaws`, then closes
      through `ReverseGateResidualFromInv`. This is the deliverable's exact shape:
      `MatchedPosLA(crv, thread.look_regs, A0) ⟹ LookPathDom(...)`, modulo the
      single producer of `LookDomInvRE` on the winning thread. */
  lemma ReverseGateResidualFromInvMatched(crv: CP.FCompiled, re: R.regex, thread: AI.Thread, A0: nat)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re)
    requires A0 in NI.TopLookIds(re)
    requires A0 in LTB.LookIds(re)
    requires MatchedPosLA(crv, thread.look_regs, A0 as int)
    requires CM.LookClkSetWithCp(thread.look_regs)
    requires |thread.look_regs.a_cp| == |thread.look_regs.a_clk|
    requires LookDomInvRE(re, thread.capture_regs.a_clk, thread.look_regs.a_clk,
                          thread.quant_regs.a_clk)
    ensures NI.LookPathDom(re, AI.get_idx(thread.look_regs.a_clk, A0 as int),
                           thread.quant_regs.a_clk, A0)
  {
    assert AReg.get_cp(thread.look_regs, A0 as int).Some?;      // MatchedPosLA
    RL.AAsArraysLaws(thread.look_regs);
    assert AI.get_idx(thread.look_regs.a_cp, A0 as int) >= 0;   // as_arrays tie
    assert AI.get_idx(thread.look_regs.a_clk, A0 as int) >= 0;  // LookClkSetWithCp
    ReverseGateResidualFromInv(re, thread, A0);
  }

  /** (DEEP reverse-recon descent — TOP-ANCESTOR MATCHED) The reverse of
      `ReverseGateResidualFromInvMatched`'s cp->clk step, keyed on the DEEP case's
      available fact. For a top look `A0` whose LOOK CLOCK is set on the winning
      thread — delivered by the whole-loop ancestor-clock chain / `LocalTopFeed` at
      `A0` (a res0-live capture in `A0`'s body forces `A0`'s clock set) reconciled
      onto the thread banks — the REVERSE look-bank invariant `CM.LookCpSetWithClk`
      (carried on the winning thread by `CM.FFindMatchLookCpSet`) recovers that
      `A0`'s cp is RECORDED, i.e. `MatchedPosLA(crv, thread.look_regs, A0)`. This is
      the top-ancestor-matched fact the DEEP case needs (`A1`/`FLookLoopInLookLive
      OwnerMatched` gives only the INNERMOST owner matched); the lookahead-type pin
      is the fragment static the caller discharges from `LookTablesOk` +
      `NoPosLookbehindRE` (as for `DescentPackageDirectFull`). */
  lemma TopLookMatchedFromDom(crv: CP.FCompiled, re: R.regex, thread: AI.Thread, A0: nat)
    requires 0 <= (A0 as int) < |crv.f_look_types| && crv.f_look_types[A0 as int].Lookahead?
    requires AI.get_idx(thread.look_regs.a_clk, A0 as int) >= 0
    requires CM.LookCpSetWithClk(thread.look_regs)
    requires |thread.look_regs.a_cp| == |thread.look_regs.a_clk|
    ensures MatchedPosLA(crv, thread.look_regs, A0 as int)
  {
    assert AI.get_idx(thread.look_regs.a_cp, A0 as int) >= 0;   // LookCpSetWithClk at A0
    RL.AAsArraysLaws(thread.look_regs);
    assert AReg.get_cp(thread.look_regs, A0 as int).Some?;      // as_arrays tie
    assert AI.capture_type(crv.f_look_types[A0 as int]);        // Lookahead captures
  }

  /** R2: nested twin of `NoWriteOracleBodyCode` — a nested body's compiled
      bytecode holds no `WriteOracle` (its inner looks compile to CheckOracle
      leaves; WriteOracle only comes from the build pass). Via
      `NR.NoWriteInstrNestedRE`. */
  lemma NoWriteOracleBodyCodeNested(body: R.regex)
    requires NR.NestedFragmentRE(body)
    ensures CM.NoWriteOracleCode(CP.compile_to_bytecode(body))
  {
    var code := CP.compile_to_bytecode(body);
    var next := CP.compile(body, 0, CP.Progress).1;
    NR.CompileToBytecodeRepNested(body);
    var endl := next as nat;
    forall pc: nat | pc < |code| ensures !code[pc].WriteOracle? {
      assert NR.GetPcRE(code, pc) == Some(code[pc]);
      if pc < endl {
        NR.NoWriteInstrNestedRE(body, code, 0, endl, pc);
      } else {
        assert pc == endl;
        assert NR.GetPcRE(code, endl) == Some(RB.Accept);
      }
    }
  }

  /** R2: nested twin of `FFindMatchPlusOvStable` — a nested positive lookAHEAD
      replay reads the oracle but never writes it, so `FFindMatchPlus` returns
      `ov` unchanged. Only the fragment inputs differ (`NoWriteOracleBodyCode
      Nested`, `NoTrueQuantStampNested`). */
  lemma FFindMatchPlusOvStableNested(bytecode: RB.code, str: string, ov: LOr.OracleView, dir: LAnc.direction,
                                     lookcdn: LCdn.cdns, plus_bcv: seq<RB.code>, cp: int,
                                     cap: AReg.Regs, lk: AReg.Regs, qt: AReg.Regs, la: R.lookaround, body: R.regex)
    requires NR.NestedFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires la.Lookahead? && dir == LAnc.Forward
    requires bytecode == CP.compile_to_bytecode(body)
    requires AI.cp_context(cp, str, dir).nextchar == AI.get_char(str, cp)
    requires (forall k :: AI.get_idx(qt.a_cp, k) < 0)
             && (forall k :: AI.get_idx(qt.a_clk, k) >= -1)
    ensures AI.FFindMatchPlus(bytecode, body, plus_bcv, str, ov, dir, cp, cap, lk, qt, 0, lookcdn).1 == ov
  {
    var inits := AI.FInitState(bytecode, cp, cap, lk, qt, 0, AI.cp_context(cp, str, dir));
    NoWriteOracleBodyCodeNested(body);
    CM.FFindMatchOvStable(bytecode, str, inits, ov, dir, lookcdn);
    NoTrueQuantStampNested(body);
    assert VmQuantFinal(inits) by { assert QuantRegsFinal(AI.init_thread(cap, lk, qt)); }
    FFindMatchQuantFinalAny(bytecode, str, inits, ov, dir, lookcdn);
    var (res0, ovx) := AI.FFindMatch(bytecode, str, inits, ov, dir, lookcdn);
    assert ovx == ov;
    if res0.Some? {
      var th := res0.value;
      assert QuantRegsFinal(th);
      FNulledPlusIdentity(body, th.capture_regs, th.look_regs, th.quant_regs, plus_bcv, str, ovx, dir);
    }
  }

  /** Agreement on `T` from agreement on a SUPERSET `U`. */
  lemma RegsAgreeInsideWeakenSub(a: AReg.Regs, b: AReg.Regs, T: set<int>, U: set<int>)
    requires CM.RegsAgreeInside(a, b, U) && T <= U
    ensures CM.RegsAgreeInside(a, b, T)
  {}

  /** R2: a regex's OUTSIDE-look capture regs are among ALL its capture regs. */
  lemma OuterCapsLeCaptureRegs(re: R.regex)
    ensures PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re)) <= PIV.CaptureRegs(re)
  {
    PIV.CapIdsSplit(re);
    PIV.CaptureRegsSetMono(PIV.CapIdsOutsideLooks(re), PIV.CapIds(re));
    PIV.CaptureRegsIsSet(re);
  }

  /** R2: a look id NEWLY recorded by a body's replay (Some in `nlk`, None in the
      pre-replay `lk`, and `nlk`/`lk` agree outside `body`'s own look ids) is one
      of `body`'s own look ids. The `get_cp`↔`get_idx(a_cp)` bridge + the
      agree-outside contrapositive. */
  lemma NewLookInBody(nlk: AReg.Regs, lk: AReg.Regs, body: R.regex, l: int)
    requires CM.RegsAgreeOutside(nlk, lk, LookIdSet(body))
    requires AReg.get_cp(nlk, l).Some?
    requires AReg.get_cp(lk, l).None?
    ensures l >= 0 && (l as nat) in LTB.LookIds(body)
  {
    assert AI.get_idx(nlk.a_cp, l) >= 0 by {
      assert 0 <= l < |nlk.a_cp|;
      assert nlk.a_cp[l] >= 0;
    }
    assert AI.get_idx(lk.a_cp, l) < 0 by {
      if 0 <= l < |lk.a_cp| { assert lk.a_cp[l] < 0; }
    }
    assert l in LookIdSet(body) by {
      if l !in LookIdSet(body) {
        assert AI.get_idx(nlk.a_cp, l) == AI.get_idx(lk.a_cp, l);
        assert false;
      }
    }
    var l2: nat :| l2 in LTB.LookIds(body) && (l2 as int) == l;
    assert l as nat == l2;
  }

  /** recon A: DIRECT twin of `NewLookInBody`. Under the TIGHT replay frame
      (`RegsAgreeOutside(nlk, lk, DirectLidSet(body))`), any look id `l` newly
      set by the replay is a DIRECT (top-level) look id of `body`. Mirror of
      `NewLookInBody` with `LookIdSet`/`LookIds` replaced by `DirectLidSet`/
      `DirectLookIds`. */
  lemma NewLookInBodyDirect(nlk: AReg.Regs, lk: AReg.Regs, body: R.regex, l: int)
    requires CM.RegsAgreeOutside(nlk, lk, DirectLidSet(body))
    requires AReg.get_cp(nlk, l).Some?
    requires AReg.get_cp(lk, l).None?
    ensures l >= 0 && (l as nat) in DirectLookIds(body)
  {
    assert AI.get_idx(nlk.a_cp, l) >= 0 by {
      assert 0 <= l < |nlk.a_cp|;
      assert nlk.a_cp[l] >= 0;
    }
    assert AI.get_idx(lk.a_cp, l) < 0 by {
      if 0 <= l < |lk.a_cp| { assert lk.a_cp[l] < 0; }
    }
    assert l in DirectLidSet(body) by {
      if l !in DirectLidSet(body) {
        assert AI.get_idx(nlk.a_cp, l) == AI.get_idx(lk.a_cp, l);
        assert false;
      }
    }
    var l2: nat :| l2 in DirectLookIds(body) && (l2 as int) == l;
    assert l as nat == l2;
  }

  // ==========================================================================
  // R30a (L4 depth-k, ADDITIVE): discharge the (a)-(h) hypotheses of R3's
  // `FLookLoopValueLiftFull` / `FLookLoopFullCoversInLooks` (and R2's
  // `FLookLoopCaptureFrameNested`) from the compilation tables — the nested
  // analogue of `LookRowsFromTablesL3a`. The frame data comes from
  // `LookBodyFactsNested` (each look body is a nested fragment with its own
  // uniqueness/tables), well-nesting from `LTB.LidsWellNested`, and cross-lid
  // capture disjointness from `NI.LookBodiesCapsDisjointOrNested`.
  //
  // SCOPE: capturing looks are Lookahead-only (`NoPosLookbehindRE`), matching
  // the nested keystone; `FrameEntryOk`'s `capture_type(la) ==> la.Lookahead?`
  // clause forbids POSITIVE lookbehinds. recon A: the old (g) hypothesis
  // (`LookIds(b1)*LookIds(b2)=={}` for distinct rows) was only TRUE at nesting
  // depth <= 2; it is REPLACED by the ordered depth-general (g_new)
  // (`l1 < l2 ==> DirectLookIds(b1)*LookIds(b2)=={}`, `GNewFromTablesNested` via
  // `DirectEarlyNotInLateBody`), so `LookRowsFromTablesNested` /
  // `FLookLoopFullCoversFromTables` are now depth-GENERAL — the
  // `NR.NestDepth(re) <= 2` premise is GONE. The strong-(g) cluster
  // (`GDisjointBodies`/`GDisjointFromTablesNested`/`NestDepth0NoLookIds`) is kept
  // as dead code. ALL hypotheses are depth-general.
  // ==========================================================================

  /** No POSITIVE lookbehind occurs anywhere in `re`: at every lookaround node
      `la` is not `Lookbehind` (it may be `Lookahead`, `NegLookahead`, or
      `NegLookbehind`). This is exactly the side condition that makes
      `FrameEntryOk`'s `AI.capture_type(la) ==> la.Lookahead?` clause hold
      (`capture_type` is `Lookahead? || Lookbehind?`), i.e. the Lookahead-only
      scope of the nested capture-reconstruction bricks. */
  predicate NoPosLookbehindRE(re: R.regex)
    decreases re
  {
    match re
    case Re_empty => true
    case Re_character(_) => true
    case Re_anchor(_) => true
    case Re_alt(r1, r2) => NoPosLookbehindRE(r1) && NoPosLookbehindRE(r2)
    case Re_con(r1, r2) => NoPosLookbehindRE(r1) && NoPosLookbehindRE(r2)
    case Re_quant(_, _, _, r1) => NoPosLookbehindRE(r1)
    case Re_capture(_, r1) => NoPosLookbehindRE(r1)
    case Re_lookaround(lid, la, r1) => !la.Lookbehind? && NoPosLookbehindRE(r1)
  }


  /** Annotation transfers `NR.NoPosLookbehindRaw` (annotation preserves the
      lookaround CONSTRUCTOR at every look node). */
  lemma AnnotateNoPosLookbehind(ra: R.raw_regex, c: int, l: int, q: int)
    requires NR.NoPosLookbehindRaw(ra)
    ensures NoPosLookbehindRE(R.annotate_regex(ra, c, l, q).0)
    decreases ra
  {
    match ra
    case Raw_alt(r1, r2) =>
      AnnotateNoPosLookbehind(r1, c, l, q);
      var (_, c1, l1, q1) := R.annotate_regex(r1, c, l, q);
      AnnotateNoPosLookbehind(r2, c1, l1, q1);
    case Raw_con(r1, r2) =>
      AnnotateNoPosLookbehind(r1, c, l, q);
      var (_, c1, l1, q1) := R.annotate_regex(r1, c, l, q);
      AnnotateNoPosLookbehind(r2, c1, l1, q1);
    case Raw_quant(_, r1) => AnnotateNoPosLookbehind(r1, c, l, q + 1);
    case Raw_count(_, r1) => AnnotateNoPosLookbehind(r1, c, l, q + 1);
    case Raw_capture(r1) => AnnotateNoPosLookbehind(r1, c + 1, l, q);
    case Raw_lookaround(_, r1) => AnnotateNoPosLookbehind(r1, c, l + 1, q);
    case _ =>
  }

  /** The body of a look node in a nested-fragment regex is itself a nested
      fragment with its own uniqueness/tables, its lids sit among `re`'s, and
      the enclosing look is not a positive lookbehind. The nested analogue of
      `LookBodyOfFragment` + the uniqueness/table transfers, in one recursion
      mirroring `NI.LookBodyOfRE`. Depth-general. */
  lemma LookBodyFactsNested(re: R.regex, crv: CP.FCompiled, lid: nat)
    requires NR.NestedFragmentRE(re)
    requires NoPosLookbehindRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires lid in LTB.LookIds(re)
    ensures var body := NI.LookBodyOfRE(re, lid);
            NR.NestedFragmentRE(body)
            && PIV.CapUnique(body) && PIV.QuantUnique(body) && LTB.LookUnique(body)
            && LTB.LookTablesOk(body, crv)
            && LTB.LookIds(body) <= LTB.LookIds(re)
            && (exists la: R.lookaround :: LTB.LookEntryOk(crv, lid as int, la, body) && !la.Lookbehind?)
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookBodyFactsNested(r1, crv, lid); }
      else { LookBodyFactsNested(r2, crv, lid); }
    case Re_con(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookBodyFactsNested(r1, crv, lid); }
      else { LookBodyFactsNested(r2, crv, lid); }
    case Re_quant(_, _, _, r1) => LookBodyFactsNested(r1, crv, lid);
    case Re_capture(_, r1) => LookBodyFactsNested(r1, crv, lid);
    case Re_lookaround(lid0, la0, r1) =>
      if lid0 >= 0 && (lid0 as nat) == lid {
        // this node IS the owner: body == r1
        assert NI.LookBodyOfRE(re, lid) == r1;
        assert LTB.LookEntryOk(crv, lid as int, la0, r1);   // LookTablesOk's lookaround case
        assert !la0.Lookbehind?;                            // NoPosLookbehindRE
      } else {
        // owner nested in r1
        assert lid in LTB.LookIds(r1);
        LookBodyFactsNested(r1, crv, lid);
        assert LTB.LookIds(r1) <= LTB.LookIds(re);
      }
  }
  /** (L5) The L4 scope is a special case of the L5 scope (no positive
      lookbehinds at all ⇒ nothing to constrain). */
  lemma NoPosImpliesL5Scope(re: R.regex)
    requires NoPosLookbehindRE(re)
    ensures NR.L5ScopeRE(re)
    decreases re
  {
    match re
    case Re_alt(r1, r2) => NoPosImpliesL5Scope(r1); NoPosImpliesL5Scope(r2);
    case Re_con(r1, r2) => NoPosImpliesL5Scope(r1); NoPosImpliesL5Scope(r2);
    case Re_quant(_, _, _, r1) => NoPosImpliesL5Scope(r1);
    case Re_capture(_, r1) => NoPosImpliesL5Scope(r1);
    case Re_lookaround(_, _, r1) => NoPosImpliesL5Scope(r1);
    case _ =>
  }

  /** (L5) The L5-scope twin of `LookBodyFactsNested`: the same body facts, the
      body is itself in the L5 scope, and the owning look is EITHER not a
      positive lookbehind OR a positive lookbehind whose body is lookbehind-only
      (`NR.LBOnlyLooksRE`) — the per-lid dispatch every L5 consumer makes. */
  lemma LookBodyFactsL5(re: R.regex, crv: CP.FCompiled, lid: nat)
    requires NR.NestedFragmentRE(re)
    requires NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires lid in LTB.LookIds(re)
    ensures var body := NI.LookBodyOfRE(re, lid);
            NR.NestedFragmentRE(body)
            && PIV.CapUnique(body) && PIV.QuantUnique(body) && LTB.LookUnique(body)
            && LTB.LookTablesOk(body, crv)
            && LTB.LookIds(body) <= LTB.LookIds(re)
            && NR.L5ScopeRE(body)
            && (exists la: R.lookaround :: LTB.LookEntryOk(crv, lid as int, la, body)
                                           && (la.Lookbehind? ==> NR.LBOnlyLooksRE(body)))
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookBodyFactsL5(r1, crv, lid); }
      else { LookBodyFactsL5(r2, crv, lid); }
    case Re_con(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookBodyFactsL5(r1, crv, lid); }
      else { LookBodyFactsL5(r2, crv, lid); }
    case Re_quant(_, _, _, r1) => LookBodyFactsL5(r1, crv, lid);
    case Re_capture(_, r1) => LookBodyFactsL5(r1, crv, lid);
    case Re_lookaround(lid0, la0, r1) =>
      if lid0 >= 0 && (lid0 as nat) == lid {
        assert NI.LookBodyOfRE(re, lid) == r1;
        assert LTB.LookEntryOk(crv, lid as int, la0, r1);   // LookTablesOk's lookaround case
        assert la0.Lookbehind? ==> NR.LBOnlyLooksRE(r1);    // L5ScopeRE
        assert NR.L5ScopeRE(r1);
      } else {
        assert lid in LTB.LookIds(r1);
        LookBodyFactsL5(r1, crv, lid);
        assert LTB.LookIds(r1) <= LTB.LookIds(re);
      }
  }


  /** R2: transfer of "unset on `Bset`" across a write confined to `Dset`
      (disjoint from `Bset`): if `cap` is init on `Bset` and `capN` agrees with
      `cap` outside `Dset`, then `capN` is init on `Bset` too. */
  lemma UnsetOffTransfer(capN: AReg.Regs, cap: AReg.Regs, ncap: int, Bset: set<int>, Dset: set<int>)
    requires CM.RegsAgreeInside(cap, AReg.init_regs(ncap), Bset)
    requires CM.RegsAgreeOutside(capN, cap, Dset)
    requires Dset * Bset == {}
    requires |capN.a_cp| == |cap.a_cp| && |capN.a_clk| == |cap.a_clk|
    ensures CM.RegsAgreeInside(capN, AReg.init_regs(ncap), Bset)
  {
    forall k: int | k in Bset
      ensures AI.get_idx(capN.a_cp, k) == AI.get_idx(AReg.init_regs(ncap).a_cp, k)
              && AI.get_idx(capN.a_clk, k) == AI.get_idx(AReg.init_regs(ncap).a_clk, k)
    {
      assert k !in Dset by { if k in Dset { assert k in Dset * Bset; } }
      assert AI.get_idx(capN.a_cp, k) == AI.get_idx(cap.a_cp, k);
    }
  }

  // ==========================================================================
  // R31a (L4 depth-k, ADDITIVE): ENGINE-glue tables-discharge. Produces the
  // (a)-(h) hypotheses that R3's `FLookLoopValueLiftFull`/`FLookLoopFullCovers
  // InLooks` and R2's `FLookLoopCaptureFrameNested` require, from the
  // whole-regex compilation setup — the nested analogue of
  // `LookRowsFromTablesL3a`. S := CaptureRegsSet(CapIdsInLooks(re)), Slook :=
  // LookIdSet(re). recon A: (g) is replaced by the ordered (g_new); ALL
  // hypotheses are now depth-general (no `NR.NestDepth(re) <= 2` premise).
  // ==========================================================================

  /** `tl_flatten` never shrinks below its `tail`: the compiled body sits in
      front of the terminal instruction(s). */
  lemma TlFlattenLenGe(t: CP.treelist, tail: seq<RB.instruction>)
    ensures |CP.tl_flatten(t, tail)| >= |tail|
    decreases t
  {
    match t
    case Leaf(l) =>
    case Concat(a, b) => TlFlattenLenGe(b, tail); TlFlattenLenGe(a, CP.tl_flatten(b, tail));
  }

  /** Every compiled block is non-empty (it ends in `Accept`). Lets us rule out
      a "garbage" look-table row, whose seed `f_look_capture_bc` is `[]`. */
  lemma CompileToBytecodeNonEmpty(x: R.regex)
    ensures |CP.compile_to_bytecode(x)| >= 1
  {
    TlFlattenLenGe(CP.compile(x, 0, CP.Progress).0, [RB.Accept]);
  }

  /** A look-table row satisfying `LookEntryOk` is a REAL look id: the
      `FFullCompilation` seed leaves every non-lookid row's `f_look_capture_bc`
      at `[]`, but `LookEntryOk` pins it to the (non-empty) compiled capture
      block. So the (a)-(h) row quantifiers never hit a spurious row. */
  lemma LookEntryOnlyReal(ast: R.regex, crv: CP.FCompiled, l: int, la: R.lookaround, body: R.regex)
    requires crv == CP.FFullCompilation(ast)
    requires 0 <= l <= R.max_lookaround(ast)
    requires LTB.LookEntryOk(crv, l, la, body)
    ensures (l as nat) in LTB.LookIds(ast)
  {
    if (l as nat) !in LTB.LookIds(ast) {
      var nlook0 := R.max_lookaround(ast) + 1;
      var nquant0 := R.max_quant(ast) + 1;
      var seed := CP.FCompiled(ast, CP.compile_to_bytecode(R.lazy_prefix(ast)), LCdn.compile_cdns(ast),
                               seq(nlook0, i => R.Lookahead), seq(nlook0, i => R.Re_empty),
                               seq(nlook0, i => []), seq(nlook0, i => []),
                               seq(nlook0, i => []), seq(nquant0, i => []));
      assert CP.FFullCompilation(ast) == CP.FCompileExtra(ast, seed);
      LTB.FCompileExtraLookFrame(ast, seed);
      assert LTB.SameLookSizes(seed, crv);
      assert LTB.AgreeAt(seed, crv, l as nat);
      assert |seed.f_look_capture_bc| == nlook0 && |crv.f_look_capture_bc| == nlook0;
      assert seed.f_look_capture_bc[l] == [];
      assert crv.f_look_capture_bc[l] == seed.f_look_capture_bc[l];   // AgreeAt
      assert crv.f_look_capture_bc[l] == CP.compile_to_bytecode(CP.capture_regex(la, body));  // LookEntryOk
      CompileToBytecodeNonEmpty(CP.capture_regex(la, body));
      assert false;
    }
  }

  /** Every lid in a look body sits STRICTLY ABOVE the enclosing lid — the
      body-scoped reading of `LidsWellNested`. Discharges (h) and kills the
      "outer nested in inner" arm of the (D-ord) trichotomy (an `l1 < l2` pair
      can never have `l1` nested in `l2`'s body). */
  lemma LookBodyLidsGt(r: R.regex, l: nat)
    requires LTB.LidsWellNested(r)
    requires l in LTB.LookIds(r)
    ensures forall x: nat :: x in LTB.LookIds(NI.LookBodyOfRE(r, l)) ==> l < x
    decreases r
  {
    match r
    case Re_alt(r1, r2) =>
      if l in LTB.LookIds(r1) { LookBodyLidsGt(r1, l); } else { LookBodyLidsGt(r2, l); }
    case Re_con(r1, r2) =>
      if l in LTB.LookIds(r1) { LookBodyLidsGt(r1, l); } else { LookBodyLidsGt(r2, l); }
    case Re_quant(_, _, _, r1) => LookBodyLidsGt(r1, l);
    case Re_capture(_, r1) => LookBodyLidsGt(r1, l);
    case Re_lookaround(lid0, _, r1) =>
      if lid0 >= 0 && (lid0 as nat) == l {
        assert NI.LookBodyOfRE(r, l) == r1;
        // LidsWellNested at this node: every lid of r1 is > lid0 == l
      } else {
        assert l in LTB.LookIds(r1);
        LookBodyLidsGt(r1, l);
        assert NI.LookBodyOfRE(r, l) == NI.LookBodyOfRE(r1, l);
      }
  }

  /** (a) per-row: any `LookEntryOk` row of the whole-regex tables satisfies
      `FrameEntryOk` at S := CaptureRegsSet(CapIdsInLooks(re)), Slook :=
      LookIdSet(re). Body facts from `LookBodyFactsNested`; the capture-set
      containment from `NI.LookBodyCapsIn` (body caps are inside-look caps of
      re); the lookahead-only clause from `NoPosLookbehindRE`. Depth-general. */
  lemma FrameEntryOkFromTables(ast: R.regex, re: R.regex, crv: CP.FCompiled,
                               l: int, la: R.lookaround, body: R.regex)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires 1 <= l <= R.max_lookaround(ast)
    requires LTB.LookEntryOk(crv, l, la, body)
    ensures FrameEntryOk(crv, la, body,
                         PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)), LookIdSet(re))
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(pre) == {};
    assert LTB.LookIds(re) == LTB.LookIds(ast);
    LookEntryOnlyReal(ast, crv, l, la, body);           // (l as nat) in LookIds(ast) == LookIds(re)
    var lid := l as nat;
    assert lid in LTB.LookIds(re);
    LookBodyFactsL5(re, crv, lid);
    var body' := NI.LookBodyOfRE(re, lid);
    // LookEntryOk determinism at row lid pins body == body' (via the table tie).
    NI.LookBodyOfTablesTie(re, crv, lid);
    var la0: R.lookaround :| LTB.LookEntryOk(crv, lid as int, la0, body');
    assert body == crv.f_look_ast[lid] == body';
    // CaptureRegsSet(CapIdsOutsideLooks(body)) <= CaptureRegsSet(CapIdsInLooks(re))
    NI.LookBodyCapsIn(re, lid);                          // CapIds(body') <= CapIdsInLooks(re)
    PIV.CapIdsSplit(body');                              // CapIdsOutsideLooks(body') <= CapIds(body')
    PIV.CaptureRegsSetMono(PIV.CapIdsOutsideLooks(body'), PIV.CapIdsInLooks(re));
    // LookIdSet(body) <= LookIdSet(re)
    assert LTB.LookIds(body') <= LTB.LookIds(re);
    assert LookIdSet(body') <= LookIdSet(re);
  }

  /** (h) per-row: `l2 !in LookIdSet(b1)` for `l2 <= l1`. The row `b1` is
      `LookBodyOfRE(re, l1)`, whose lids are all `> l1` (`LookBodyLidsGt`), so
      no `l2 <= l1` lands inside. Depth-general. */
  lemma HFromTables(ast: R.regex, re: R.regex, crv: CP.FCompiled,
                    l1: int, la1: R.lookaround, b1: R.regex, l2: int)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookUnique(re) && LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires 1 <= l1 <= R.max_lookaround(ast)
    requires LTB.LookEntryOk(crv, l1, la1, b1)
    requires 1 <= l2 <= l1
    ensures l2 !in LookIdSet(b1)
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(re) == LTB.LookIds(ast);
    LookEntryOnlyReal(ast, crv, l1, la1, b1);
    var lid1 := l1 as nat;
    assert lid1 in LTB.LookIds(re);
    NI.LookBodyOfTablesTie(re, crv, lid1);
    var la0: R.lookaround :| LTB.LookEntryOk(crv, lid1 as int, la0, NI.LookBodyOfRE(re, lid1));
    assert b1 == crv.f_look_ast[lid1] == NI.LookBodyOfRE(re, lid1);
    LookBodyLidsGt(re, lid1);                       // every x in LookIds(b1) has l1 < x
    if l2 in LookIdSet(b1) {
      var x: nat :| x in LTB.LookIds(b1) && (x as int) == l2;
      assert lid1 < x;                              // LookBodyLidsGt
      assert false;                                 // x == l2 <= l1 == lid1 < x
    }
  }

  /** (D-ord) per-pair: for `l1 < l2`, `CaptureRegsSet(CapIdsOutsideLooks(b1))`
      is disjoint from `CaptureRegs(b2)`. The two bodies are disjoint siblings
      or `b2` is nested inside `b1` (`NI.LookBodiesCapsDisjointOrNested`); the
      third "b1 nested in b2" arm is killed by well-nesting (`l1 < l2` forbids
      `l1 in LookIds(b2)`). In the nested arm `b2`'s caps sit in `b1`'s
      INSIDE-look caps, disjoint from `b1`'s OUTSIDE-look caps. Depth-general. */
  lemma DOrdFromTables(ast: R.regex, re: R.regex, crv: CP.FCompiled,
                       l1: int, la1: R.lookaround, b1: R.regex,
                       l2: int, la2: R.lookaround, b2: R.regex)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)   // (L5 F7c) lifted from NoPosLookbehindRE
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires 1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
    requires LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2)
    ensures PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(re) == LTB.LookIds(ast);
    LookEntryOnlyReal(ast, crv, l1, la1, b1);
    LookEntryOnlyReal(ast, crv, l2, la2, b2);
    var lid1 := l1 as nat;
    var lid2 := l2 as nat;
    NI.LookBodyOfTablesTie(re, crv, lid1);
    NI.LookBodyOfTablesTie(re, crv, lid2);
    var la01: R.lookaround :| LTB.LookEntryOk(crv, lid1 as int, la01, NI.LookBodyOfRE(re, lid1));
    var la02: R.lookaround :| LTB.LookEntryOk(crv, lid2 as int, la02, NI.LookBodyOfRE(re, lid2));
    assert b1 == NI.LookBodyOfRE(re, lid1);
    assert b2 == NI.LookBodyOfRE(re, lid2);
    LookBodyFactsL5(re, crv, lid1);                 // CapUnique(b1)
    PIV.CaptureRegsIsSet(b2);                           // CaptureRegs(b2) == CaptureRegsSet(CapIds(b2))
    PIV.CapIdsSplit(b1);                                // CapIdsOutsideLooks(b1) <= CapIds(b1)
    NI.LookBodiesCapsDisjointOrNested(re, lid1, lid2);
    if PIV.CapIds(b1) * PIV.CapIds(b2) == {} {
      // siblings: outside(b1) <= CapIds(b1), disjoint from CapIds(b2)
      assert PIV.CapIdsOutsideLooks(b1) * PIV.CapIds(b2) == {};
      PIV.CaptureRegsSetDisjoint(PIV.CapIdsOutsideLooks(b1), PIV.CapIds(b2));
    } else if lid2 in LTB.LookIds(b1) && PIV.CapIds(b2) <= PIV.CapIds(b1) {
      // b2 nested in b1: b2's caps are INSIDE-look caps of b1
      NI.LookBodyCompose(re, lid1, lid2);              // b2 == LookBodyOfRE(b1, lid2)
      NI.LookBodyCapsIn(b1, lid2);                     // CapIds(b2) <= CapIdsInLooks(b1)
      PIV.CapIdsLooksDisjoint(b1);                     // outside(b1) * inside(b1) == {}
      assert PIV.CapIdsOutsideLooks(b1) * PIV.CapIds(b2) == {};
      PIV.CaptureRegsSetDisjoint(PIV.CapIdsOutsideLooks(b1), PIV.CapIds(b2));
    } else {
      // b1 nested in b2 (l1 in LookIds(b2)) — impossible: well-nesting forces l2 < l1
      assert lid1 in LTB.LookIds(b2);
      LookBodyLidsGt(re, lid2);                         // x in LookIds(b2) ==> l2 < x
      assert lid2 < lid1;                               // contra l1 < l2
      assert false;
    }
  }

  /** A look body's lids are among the whole regex's lids — the LookIds twin of
      `NI.LookBodyCapsIn`. */
  lemma LookBodyLidsSubset(r: R.regex, l: nat)
    requires l in LTB.LookIds(r)
    ensures LTB.LookIds(NI.LookBodyOfRE(r, l)) <= LTB.LookIds(r)
    decreases r
  {
    match r
    case Re_alt(r1, r2) =>
      if l in LTB.LookIds(r1) { LookBodyLidsSubset(r1, l); } else { LookBodyLidsSubset(r2, l); }
    case Re_con(r1, r2) =>
      if l in LTB.LookIds(r1) { LookBodyLidsSubset(r1, l); } else { LookBodyLidsSubset(r2, l); }
    case Re_quant(_, _, _, r1) => LookBodyLidsSubset(r1, l);
    case Re_capture(_, r1) => LookBodyLidsSubset(r1, l);
    case Re_lookaround(lid0, _, r1) =>
      if lid0 >= 0 && (lid0 as nat) == l {
      } else {
        LookBodyLidsSubset(r1, l);
      }
  }

  /** A regex with no lookaround nesting (`NestDepth == 0`) has no lookaround at
      all, hence no look ids. */
  lemma NestDepth0NoLookIds(r: R.regex)
    requires NR.NestDepth(r) == 0
    ensures LTB.LookIds(r) == {}
    decreases r
  {
    match r
    case Re_alt(r1, r2) => NestDepth0NoLookIds(r1); NestDepth0NoLookIds(r2);
    case Re_con(r1, r2) => NestDepth0NoLookIds(r1); NestDepth0NoLookIds(r2);
    case Re_quant(_, _, _, r1) => NestDepth0NoLookIds(r1);
    case Re_capture(_, r1) => NestDepth0NoLookIds(r1);
    case Re_lookaround(lid0, _, r1) => // NestDepth == 1 + NestDepth(r1) >= 1: vacuous
    case _ =>
  }

  /** (g) STRUCTURAL core, under `NestDepth(r) <= 2`: two DISTINCT looks own
      bodies with disjoint lid sets. Distinct rows are siblings (disjoint lids
      by `LookUnique`) or nested; at depth <= 2 the nested (inner) body is
      look-free (`NestDepthLookBodyDrops` drops its depth below 1, so
      `NestDepth == 0` and `NestDepth0NoLookIds` empties its lids). This is the
      clause that FAILS at depth 3 (an `l1 ⊃ l2 ⊃ l3` shares `l3`). */
  lemma GDisjointBodies(r: R.regex, l1: nat, l2: nat)
    requires LTB.LookUnique(r)
    requires NR.NestDepth(r) <= 2
    requires l1 in LTB.LookIds(r) && l2 in LTB.LookIds(r) && l1 != l2
    ensures LTB.LookIds(NI.LookBodyOfRE(r, l1)) * LTB.LookIds(NI.LookBodyOfRE(r, l2)) == {}
    decreases r
  {
    match r
    case Re_alt(r1, r2) =>
      if l1 in LTB.LookIds(r1) && l2 in LTB.LookIds(r1) {
        GDisjointBodies(r1, l1, l2);
      } else if l1 !in LTB.LookIds(r1) && l2 !in LTB.LookIds(r1) {
        GDisjointBodies(r2, l1, l2);
      } else {
        if l1 in LTB.LookIds(r1) { LookBodyLidsSubset(r1, l1); LookBodyLidsSubset(r2, l2); }
        else { LookBodyLidsSubset(r2, l1); LookBodyLidsSubset(r1, l2); }
      }
    case Re_con(r1, r2) =>
      if l1 in LTB.LookIds(r1) && l2 in LTB.LookIds(r1) {
        GDisjointBodies(r1, l1, l2);
      } else if l1 !in LTB.LookIds(r1) && l2 !in LTB.LookIds(r1) {
        GDisjointBodies(r2, l1, l2);
      } else {
        if l1 in LTB.LookIds(r1) { LookBodyLidsSubset(r1, l1); LookBodyLidsSubset(r2, l2); }
        else { LookBodyLidsSubset(r2, l1); LookBodyLidsSubset(r1, l2); }
      }
    case Re_quant(_, _, _, r1) => GDisjointBodies(r1, l1, l2);
    case Re_capture(_, r1) => GDisjointBodies(r1, l1, l2);
    case Re_lookaround(lid0, _, r1) =>
      if lid0 >= 0 && (lid0 as nat) == l1 {
        assert NI.LookBodyOfRE(r, l1) == r1;
        assert l2 in LTB.LookIds(r1);
        assert NI.LookBodyOfRE(r, l2) == NI.LookBodyOfRE(r1, l2);
        NI.NestDepthLookBodyDrops(r1, l2);
        assert NR.NestDepth(NI.LookBodyOfRE(r1, l2)) == 0;   // NestDepth(r1) <= 1
        NestDepth0NoLookIds(NI.LookBodyOfRE(r1, l2));
      } else if lid0 >= 0 && (lid0 as nat) == l2 {
        assert NI.LookBodyOfRE(r, l2) == r1;
        assert l1 in LTB.LookIds(r1);
        assert NI.LookBodyOfRE(r, l1) == NI.LookBodyOfRE(r1, l1);
        NI.NestDepthLookBodyDrops(r1, l1);
        assert NR.NestDepth(NI.LookBodyOfRE(r1, l1)) == 0;
        NestDepth0NoLookIds(NI.LookBodyOfRE(r1, l1));
      } else {
        assert l1 in LTB.LookIds(r1) && l2 in LTB.LookIds(r1);
        assert NI.LookBodyOfRE(r, l1) == NI.LookBodyOfRE(r1, l1);
        assert NI.LookBodyOfRE(r, l2) == NI.LookBodyOfRE(r1, l2);
        GDisjointBodies(r1, l1, l2);
      }
  }

  /** (g) per-pair from the tables, under `NestDepth(re) <= 2`: distinct rows
      have lid-disjoint bodies. Maps rows to `LookBodyOfRE` (determinism) and
      calls `GDisjointBodies`. */
  lemma GDisjointFromTablesNested(ast: R.regex, re: R.regex, crv: CP.FCompiled,
                                  l1: int, la1: R.lookaround, b1: R.regex,
                                  l2: int, la2: R.lookaround, b2: R.regex)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookUnique(re) && LTB.LookTablesOk(re, crv)
    requires NR.NestDepth(re) <= 2
    requires 1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 != l2
    requires LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2)
    ensures LTB.LookIds(b1) * LTB.LookIds(b2) == {}
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(re) == LTB.LookIds(ast);
    LookEntryOnlyReal(ast, crv, l1, la1, b1);
    LookEntryOnlyReal(ast, crv, l2, la2, b2);
    var lid1 := l1 as nat;
    var lid2 := l2 as nat;
    NI.LookBodyOfTablesTie(re, crv, lid1);
    NI.LookBodyOfTablesTie(re, crv, lid2);
    var la01: R.lookaround :| LTB.LookEntryOk(crv, lid1 as int, la01, NI.LookBodyOfRE(re, lid1));
    var la02: R.lookaround :| LTB.LookEntryOk(crv, lid2 as int, la02, NI.LookBodyOfRE(re, lid2));
    assert b1 == NI.LookBodyOfRE(re, lid1);
    assert b2 == NI.LookBodyOfRE(re, lid2);
    GDisjointBodies(re, lid1, lid2);
  }

  /** recon A: (g_new) per-pair from the tables, DEPTH-GENERAL. For ordered rows
      `l1 < l2`, the DIRECT children of the earlier body never land in the later
      body (`DirectEarlyNotInLateBody`). Replaces the `NestDepth(re) <= 2`
      `GDisjointFromTablesNested`. Maps rows to `LookBodyOfRE` (determinism) as
      before, then calls the structural core. */
  lemma GNewFromTablesNested(ast: R.regex, re: R.regex, crv: CP.FCompiled,
                             l1: int, la1: R.lookaround, b1: R.regex,
                             l2: int, la2: R.lookaround, b2: R.regex)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires LTB.LookUnique(re) && LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires 1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
    requires LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2)
    ensures DirectLookIds(b1) * LTB.LookIds(b2) == {}
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(re) == LTB.LookIds(ast);
    LookEntryOnlyReal(ast, crv, l1, la1, b1);
    LookEntryOnlyReal(ast, crv, l2, la2, b2);
    var lid1 := l1 as nat;
    var lid2 := l2 as nat;
    NI.LookBodyOfTablesTie(re, crv, lid1);
    NI.LookBodyOfTablesTie(re, crv, lid2);
    var la01: R.lookaround :| LTB.LookEntryOk(crv, lid1 as int, la01, NI.LookBodyOfRE(re, lid1));
    var la02: R.lookaround :| LTB.LookEntryOk(crv, lid2 as int, la02, NI.LookBodyOfRE(re, lid2));
    assert b1 == NI.LookBodyOfRE(re, lid1);
    assert b2 == NI.LookBodyOfRE(re, lid2);
    DirectEarlyNotInLateBody(re, lid1, lid2);
  }

  /** The STATIC quartet (a)/(D-ord)/(g_new)/(h): the hypotheses of R3's
      `FLookLoopFullCoversInLooks` that depend only on the look tables + nesting
      (not on the running register banks), at S := CaptureRegsSet(CapIdsInLooks
      (re)), Slook := LookIdSet(re). recon A: ALL FOUR are now DEPTH-GENERAL --
      (g) was replaced by the ordered (g_new) (`GNewFromTablesNested` via
      `DirectEarlyNotInLateBody`), so the `NR.NestDepth(re) <= 2` premise is GONE.
      Each forall dispatches to its per-row helper. */
  lemma LookRowsStaticNested(ast: R.regex, re: R.regex, crv: CP.FCompiled)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    ensures forall l: int, la: R.lookaround, body: R.regex ::                                  // (a)
              1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                FrameEntryOk(crv, la, body, PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)), LookIdSet(re))
    ensures forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (D-ord)
              1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
              && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    ensures forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::  // (g_new)
              1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
              && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                DirectLookIds(b1) * LTB.LookIds(b2) == {}
    ensures forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::                          // (h)
              1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==>
                l2 !in LookIdSet(b1)
  {
    forall l: int, la: R.lookaround, body: R.regex |
      1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body)
      ensures FrameEntryOk(crv, la, body, PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)), LookIdSet(re))
    { FrameEntryOkFromTables(ast, re, crv, l, la, body); }

    forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex |
      1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
      && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2)
      ensures PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    { DOrdFromTables(ast, re, crv, l1, la1, b1, l2, la2, b2); }

    forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex |
      1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
      && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2)
      ensures DirectLookIds(b1) * LTB.LookIds(b2) == {}
    { GNewFromTablesNested(ast, re, crv, l1, la1, b1, l2, la2, b2); }

    forall l1: int, la1: R.lookaround, b1: R.regex, l2: int |
      1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1
      ensures l2 !in LookIdSet(b1)
    { HFromTables(ast, re, crv, l1, la1, b1, l2); }
  }

  /** The DYNAMIC trio (b)/(c')/(e) plus register well-formedness: the
      hypotheses that read the MAIN-MATCH result register banks. `cap`/`look`/
      `quant` are the INITIAL (fresh) banks; the winning thread's banks satisfy:
      (e) look cps <= |str| (`FFindMatchLookCpOk`); (b) every recorded lid has a
      table row (nested look-check classification + `LookIdEntryExists`); (c')
      the capture bank is INIT on every look body's capture regs (the main pass
      writes only OUTSIDE-look caps, `CaptureBytecodeClassifiedNestedOuter`,
      transported to `RegsAgreeInside` off each body's caps). */
  lemma {:isolate_assertions} LookRowsDynamicNested(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
    ncap: int, nlook: int, nquant: int, endl: nat, result: Option<AI.Thread>)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str| && inits.clock >= 0
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==> CM.ThreadRegsWf(result.value, ncap, nlook, nquant)                   // reg wf
    ensures result.Some? ==> CM.LookCpsLE(result.value.look_regs, |str|)                           // (e)
    ensures result.Some? ==>
              forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(result.value.look_regs, l).Some? ==>  // (b)
                                 exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    ensures result.Some? ==>
              forall l: int, la: R.lookaround, body: R.regex ::                                            // (c')
                1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                  CM.RegsAgreeInside(result.value.capture_regs, AReg.init_regs(ncap), PIV.CaptureRegs(body))
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(re) == LTB.LookIds(ast);

    // reg wf of the winning thread
    assert CM.VmRegsWf(inits, ncap, nlook, nquant) by {
      assert AI.init_thread(cap, look, quant) in inits.active;
      assert PIV.CapRegWf(cap);                      // init_regs
    }
    FFindMatchRegsWf(code, str, inits, ov, LAnc.Forward, cdn, ncap, nlook, nquant);

    // (e): look cps <= |str|
    assert CM.VmLookCpOk(inits, |str|) by {
      assert CM.LookCpsLE(look, |str|) by {
        forall l: int ensures AI.get_idx(look.a_cp, l) <= |str| {
          if 0 <= l < |look.a_cp| { assert look.a_cp[l] == -1; }
        }
      }
      assert AI.init_thread(cap, look, quant).look_regs == look;
    }
    CM.FFindMatchLookCpOk(code, str, inits, ov, LAnc.Forward, cdn);

    // look-frame: recorded lids sit in LookIdSet(re)
    var Slk := LookIdSet(re);
    LookBytecodeClassifiedNested(re);                 // LookChecksInside(code, Slk)
    assert CM.VmLooksAgree(inits, look, Slk) by {
      assert CM.RegsAgreeOutside(look, look, Slk);
    }
    CM.FFindMatchLookFrame(code, str, inits, ov, LAnc.Forward, cdn, look, Slk);

    // capture-frame: main pass writes only OUTSIDE-look caps
    var Sc := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re));
    CaptureBytecodeClassifiedNestedOuter(re);         // CaptureWritesInside(code, Sc)
    assert CM.VmCapturesAgree(inits, cap, Sc) by {
      assert AI.init_thread(cap, look, quant).capture_regs == cap;
      assert CM.RegsAgreeOutside(cap, cap, Sc);
    }
    CM.FFindMatchCapWriteFrame(code, str, inits, ov, LAnc.Forward, cdn, cap, Sc);

    if result.Some? {
      var lk := result.value.look_regs;
      var cp' := result.value.capture_regs;
      assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant);
      assert CM.RegsAgreeOutside(lk, look, Slk);
      assert CM.RegsAgreeOutside(cp', cap, Sc);

      // (b)
      forall l: int | 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(lk, l).Some?
        ensures exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
      {
        assert l in Slk by {
          if l !in Slk {
            assert AI.get_idx(lk.a_cp, l) == AI.get_idx(look.a_cp, l);   // RegsAgreeOutside
            assert AReg.get_cp(look, l).None?;                          // init: a_cp[l] == -1
            assert AReg.get_cp(lk, l).None?;                            // contradiction
          }
        }
        assert (l as nat) in LTB.LookIds(re);
        LookIdEntryExists(re, crv, l as nat);
      }

      // (c')
      forall l: int, la: R.lookaround, body: R.regex |
        1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body)
        ensures CM.RegsAgreeInside(cp', AReg.init_regs(ncap), PIV.CaptureRegs(body))
      {
        LookEntryOnlyReal(ast, crv, l, la, body);
        var lid := l as nat;
        NI.LookBodyOfTablesTie(re, crv, lid);
        var la0: R.lookaround :| LTB.LookEntryOk(crv, lid as int, la0, NI.LookBodyOfRE(re, lid));
        assert body == NI.LookBodyOfRE(re, lid);
        NI.LookBodyCapsIn(re, lid);                    // CapIds(body) <= CapIdsInLooks(re)
        PIV.CapIdsLooksDisjoint(re);                   // outside(re) * inside(re) == {}
        assert PIV.CapIds(body) * PIV.CapIdsOutsideLooks(re) == {};
        PIV.CaptureRegsSetDisjoint(PIV.CapIds(body), PIV.CapIdsOutsideLooks(re));
        PIV.CaptureRegsIsSet(body);                    // CaptureRegs(body) == CaptureRegsSet(CapIds(body))
        assert forall k: int :: k in PIV.CaptureRegs(body) ==> k !in Sc;
        RegsAgreeOutsideToInside(cp', cap, PIV.CaptureRegs(body), Sc);
      }
    }
  }

  /** The DIRECT (top-level) lookaround ids of `re`: a lookaround node
      contributes its own lid but NOT the lids inside its body (the body is a
      single CheckOracle leaf in the main code — its inner looks live only in
      the look tables). This is exactly the set the MAIN bytecode gates on. */
  ghost function DirectLookIds(re: R.regex): set<nat>
    decreases re
  {
    match re
    case Re_empty => {}
    case Re_character(_) => {}
    case Re_anchor(_) => {}
    case Re_alt(r1, r2) => DirectLookIds(r1) + DirectLookIds(r2)
    case Re_con(r1, r2) => DirectLookIds(r1) + DirectLookIds(r2)
    case Re_quant(_, _, _, r1) => DirectLookIds(r1)
    case Re_capture(_, r1) => DirectLookIds(r1)
    case Re_lookaround(lid, _, r1) => if lid >= 0 then {lid as nat} else {}
  }

  ghost function DirectLidSet(re: R.regex): set<int> {
    set l: nat | l in DirectLookIds(re) :: l as int
  }

  /** DIRECT-lid twin of `LookCheckIdsREGen`: every `CheckOracle`/`NegCheckOracle`
      in the main block of `re` targets a DIRECT (top-level) lid. Verbatim clone
      of `LookCheckIdsREGen` with `LookIds` replaced by `DirectLookIds` — the
      recursion never descends into a lookaround body (that leaf is a single
      gate), so the tighter set holds. */
  lemma LookCheckDirectREGen(re: R.regex, code: RB.code, start: nat, endl: nat, pc: nat)
    requires LTB.LookUnique(re)
    requires NR.NfaRepRE(re, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.col;
              l >= 0 && (l as nat) in DirectLookIds(re)
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.NegCheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.ncl;
              l >= 0 && (l as nat) in DirectLookIds(re)
    decreases CP.rsize(re), 1
  {
    match re
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
    case Re_lookaround(lid, la, r1) =>
      assert pc == start;
      assert lid >= 0;
      assert (lid as nat) in DirectLookIds(re);
    case Re_alt(r1, r2) =>
      var e1: nat :| NR.GetPcRE(code, start) == Some(RB.Fork(start + 1, e1 + 1))
                     && NR.NfaRepRE(r1, code, start + 1, e1)
                     && NR.GetPcRE(code, e1) == Some(RB.Jmp(endl))
                     && NR.NfaRepRE(r2, code, e1 + 1, endl);
      NR.NfaRepIncrRE(r1, code, start + 1, e1);
      NR.NfaRepIncrRE(r2, code, e1 + 1, endl);
      if pc == start {
      } else if pc < e1 {
        LookCheckDirectREGen(r1, code, start + 1, e1, pc);
      } else if pc == e1 {
      } else {
        LookCheckDirectREGen(r2, code, e1 + 1, endl, pc);
      }
    case Re_con(r1, r2) =>
      var e1: nat :| NR.NfaRepRE(r1, code, start, e1) && NR.NfaRepRE(r2, code, e1, endl);
      NR.NfaRepIncrRE(r1, code, start, e1);
      NR.NfaRepIncrRE(r2, code, e1, endl);
      if pc < e1 {
        LookCheckDirectREGen(r1, code, start, e1, pc);
      } else {
        LookCheckDirectREGen(r2, code, e1, endl, pc);
      }
    case Re_capture(cid, r1) =>
      var e1: nat :| NR.GetPcRE(code, start) == Some(RB.SetRegisterToCP(CP.start_reg(cid)))
                     && NR.NfaRepRE(r1, code, start + 1, e1)
                     && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(cid)))
                     && endl == e1 + 1;
      NR.NfaRepIncrRE(r1, code, start + 1, e1);
      if pc == start {
      } else if pc < e1 {
        LookCheckDirectREGen(r1, code, start + 1, e1, pc);
      } else {
      }
    case Re_quant(nul, qid, q, r1) =>
      if q.min == 0 && q.max == None {
        var e1: nat :| NR.GetPcRE(code, start) == Some(if q.greedy then RB.Fork(start + 1, e1 + 2) else RB.Fork(e1 + 2, start + 1))
                       && NR.GetPcRE(code, start + 1) == Some(RB.SetQuantToClock(qid, false))
                       && NR.GetPcRE(code, start + 2) == Some(RB.BeginLoop)
                       && NR.NfaRepRE(r1, code, start + 3, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                       && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(start))
                       && endl == e1 + 2;
        NR.NfaRepIncrRE(r1, code, start + 3, e1);
        if pc <= start + 2 {
        } else if pc < e1 {
          LookCheckDirectREGen(r1, code, start + 3, e1, pc);
        } else {
        }
      } else if q.max.Some? {
        var em := NR.NfaRepREQuantInv(nul, qid, q, r1, code, start, endl);
        NR.NfaRepIncrMinRE(q.min as nat, qid, r1, code, start, em);
        NR.NfaRepIncrOptRE((q.max.value - q.min) as nat, q.greedy, qid, r1, code, em, endl);
        if pc < em {
          LookCheckDirectMinREGen(q.min as nat, qid, r1, code, start, em, pc);
        } else {
          LookCheckDirectOptREGen((q.max.value - q.min) as nat, q.greedy, qid, r1, code, em, endl, pc);
        }
      } else {
        var em, e1 := NR.NfaRepREPlusInv(nul, qid, q, r1, code, start, endl);
        NR.NfaRepIncrMinRE((q.min - 1) as nat, qid, r1, code, start, em);
        NR.NfaRepIncrRE(r1, code, em + 1, e1);
        if pc < em {
          LookCheckDirectMinREGen((q.min - 1) as nat, qid, r1, code, start, em, pc);
        } else if pc == em {
        } else if pc < e1 {
          LookCheckDirectREGen(r1, code, em + 1, e1, pc);
        } else {
        }
      }
  }

  lemma LookCheckDirectMinREGen(k: nat, qid: R.quantid, r1: R.regex, code: RB.code, start: nat, endl: nat, pc: nat)
    requires LTB.LookUnique(r1)
    requires NR.NfaRepMinRE(k, qid, r1, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.col;
              l >= 0 && (l as nat) in DirectLookIds(r1)
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.NegCheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.ncl;
              l >= 0 && (l as nat) in DirectLookIds(r1)
    decreases CP.rsize(r1), k + 2
  {
    if k == 0 { return; }
    var e1: nat :| NR.GetPcRE(code, start) == Some(RB.SetQuantToClock(qid, false))
                   && NR.NfaRepRE(r1, code, start + 1, e1)
                   && NR.NfaRepMinRE(k - 1, qid, r1, code, e1, endl);
    NR.NfaRepIncrRE(r1, code, start + 1, e1);
    NR.NfaRepIncrMinRE(k - 1, qid, r1, code, e1, endl);
    if pc == start {
    } else if pc < e1 {
      LookCheckDirectREGen(r1, code, start + 1, e1, pc);
    } else {
      LookCheckDirectMinREGen(k - 1, qid, r1, code, e1, endl, pc);
    }
  }

  lemma LookCheckDirectOptREGen(k: nat, greedy: bool, qid: R.quantid, r1: R.regex, code: RB.code, start: nat, endl: nat, pc: nat)
    requires LTB.LookUnique(r1)
    requires NR.NfaRepOptRE(k, greedy, qid, r1, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.col;
              l >= 0 && (l as nat) in DirectLookIds(r1)
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.NegCheckOracle? ==>
              var l := NR.GetPcRE(code, pc).value.ncl;
              l >= 0 && (l as nat) in DirectLookIds(r1)
    decreases CP.rsize(r1), k + 2
  {
    if k == 0 { return; }
    var e1: nat :| NR.GetPcRE(code, start) == Some(if greedy then RB.Fork(start + 1, endl) else RB.Fork(endl, start + 1))
                   && NR.GetPcRE(code, start + 1) == Some(RB.SetQuantToClock(qid, false))
                   && NR.GetPcRE(code, start + 2) == Some(RB.BeginLoop)
                   && NR.NfaRepRE(r1, code, start + 3, e1)
                   && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                   && NR.NfaRepOptRE(k - 1, greedy, qid, r1, code, e1 + 1, endl);
    NR.NfaRepIncrRE(r1, code, start + 3, e1);
    NR.NfaRepIncrOptRE(k - 1, greedy, qid, r1, code, e1 + 1, endl);
    if pc <= start + 2 {
    } else if pc < e1 {
      LookCheckDirectREGen(r1, code, start + 3, e1, pc);
    } else if pc == e1 {
    } else {
      LookCheckDirectOptREGen(k - 1, greedy, qid, r1, code, e1 + 1, endl, pc);
    }
  }

  /** `LookChecksInside(compile_to_bytecode(re), DirectLidSet(re))`: the main
      bytecode gates only on DIRECT lids. Nested-body twin of the (b) look
      classification but with the TIGHTER direct set — the (f) backbone. */
  lemma DirectLidClassified(re: R.regex)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re)
    ensures CM.LookChecksInside(CP.compile_to_bytecode(re), DirectLidSet(re))
  {
    var code := CP.compile_to_bytecode(re);
    var next := CP.compile(re, 0, CP.Progress).1;
    NR.CompileToBytecodeRepNested(re);
    var endl := next as nat;
    var S := DirectLidSet(re);
    forall pc: nat | pc < |code|
      ensures (code[pc].CheckOracle? ==> code[pc].col in S)
              && (code[pc].NegCheckOracle? ==> code[pc].ncl in S)
    {
      assert NR.GetPcRE(code, pc) == Some(code[pc]);
      if pc < endl {
        LookCheckDirectREGen(re, code, 0, endl, pc);
      } else {
        assert pc == endl;
        assert NR.GetPcRE(code, endl) == Some(RB.Accept);
      }
    }
  }

  /** Direct lids are among all lids. */
  lemma DirectLidsSubLookIds(re: R.regex)
    ensures DirectLookIds(re) <= LTB.LookIds(re)
    decreases re
  {
    match re
    case Re_alt(r1, r2) => DirectLidsSubLookIds(r1); DirectLidsSubLookIds(r2);
    case Re_con(r1, r2) => DirectLidsSubLookIds(r1); DirectLidsSubLookIds(r2);
    case Re_quant(_, _, _, r1) => DirectLidsSubLookIds(r1);
    case Re_capture(_, r1) => DirectLidsSubLookIds(r1);
    case Re_lookaround(lid, _, r1) =>
    case _ =>
  }

  /** No DIRECT (top-level) lid lands inside any look body: a lid inside `l1`'s
      body is nested under `l1`'s lookaround, hence not top-level. Uniqueness
      keeps a lid from being BOTH. The (f) disjointness. */
  lemma DirectLidsNotInBody(re: R.regex, l1: nat)
    requires LTB.LookUnique(re)
    requires l1 in LTB.LookIds(re)
    ensures DirectLookIds(re) * LTB.LookIds(NI.LookBodyOfRE(re, l1)) == {}
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if l1 in LTB.LookIds(r1) {
        DirectLidsNotInBody(r1, l1);
        LookBodyLidsSubset(r1, l1);                // LookIds(body) <= LookIds(r1)
        DirectLidsSubLookIds(r2);                  // DirectLookIds(r2) <= LookIds(r2)
      } else {
        DirectLidsNotInBody(r2, l1);
        LookBodyLidsSubset(r2, l1);
        DirectLidsSubLookIds(r1);
      }
    case Re_con(r1, r2) =>
      if l1 in LTB.LookIds(r1) {
        DirectLidsNotInBody(r1, l1);
        LookBodyLidsSubset(r1, l1);
        DirectLidsSubLookIds(r2);
      } else {
        DirectLidsNotInBody(r2, l1);
        LookBodyLidsSubset(r2, l1);
        DirectLidsSubLookIds(r1);
      }
    case Re_quant(_, _, _, r1) => DirectLidsNotInBody(r1, l1);
    case Re_capture(_, r1) => DirectLidsNotInBody(r1, l1);
    case Re_lookaround(lid0, _, r1) =>
      if lid0 >= 0 && (lid0 as nat) == l1 {
        assert NI.LookBodyOfRE(re, l1) == r1;
        // DirectLookIds(re) == {lid0}; lid0 !in LookIds(r1) by LookUnique
      } else {
        assert l1 in LTB.LookIds(r1);
        assert NI.LookBodyOfRE(re, l1) == NI.LookBodyOfRE(r1, l1);
        LookBodyLidsSubset(r1, l1);                // LookIds(body) <= LookIds(r1); lid0 !in LookIds(r1)
      }
  }

  /** recon A: the STRUCTURAL core of the replacement hypothesis (g_new). For two
      distinct rows ordered `l1 < l2`, the DIRECT (top-level) look ids of the
      EARLIER row's body never land inside the LATER row's body. Depth-general
      (no `NestDepth` cap): a direct child of `l1`'s body has `l1` as its parent;
      were it inside `l2`'s body it would be nested under `l2`, forcing `l2` to be
      an ancestor of a child of `l1`, i.e. `l2 <= l1` -- contradicting `l1 < l2`.
      The `l2 IS this node` case is impossible by well-nesting (`l1 in LookIds(r1)`
      forces `l1 > lid0 == l2`); the `l1 IS this node` case reduces to
      `DirectLidsNotInBody`; siblings are disjoint by `LookUnique`. Mirrors
      `GDisjointBodies`/`DirectLidsNotInBody` structure. */
  lemma DirectEarlyNotInLateBody(r: R.regex, l1: nat, l2: nat)
    requires LTB.LookUnique(r) && LTB.LidsWellNested(r)
    requires l1 in LTB.LookIds(r) && l2 in LTB.LookIds(r) && l1 < l2
    ensures DirectLookIds(NI.LookBodyOfRE(r, l1)) * LTB.LookIds(NI.LookBodyOfRE(r, l2)) == {}
    decreases r
  {
    match r
    case Re_alt(r1, r2) =>
      if l1 in LTB.LookIds(r1) && l2 in LTB.LookIds(r1) {
        DirectEarlyNotInLateBody(r1, l1, l2);
      } else if l1 !in LTB.LookIds(r1) && l2 !in LTB.LookIds(r1) {
        DirectEarlyNotInLateBody(r2, l1, l2);
      } else {
        if l1 in LTB.LookIds(r1) {
          LookBodyLidsSubset(r1, l1); LookBodyLidsSubset(r2, l2);
          DirectLidsSubLookIds(NI.LookBodyOfRE(r1, l1));
        } else {
          LookBodyLidsSubset(r2, l1); LookBodyLidsSubset(r1, l2);
          DirectLidsSubLookIds(NI.LookBodyOfRE(r2, l1));
        }
      }
    case Re_con(r1, r2) =>
      if l1 in LTB.LookIds(r1) && l2 in LTB.LookIds(r1) {
        DirectEarlyNotInLateBody(r1, l1, l2);
      } else if l1 !in LTB.LookIds(r1) && l2 !in LTB.LookIds(r1) {
        DirectEarlyNotInLateBody(r2, l1, l2);
      } else {
        if l1 in LTB.LookIds(r1) {
          LookBodyLidsSubset(r1, l1); LookBodyLidsSubset(r2, l2);
          DirectLidsSubLookIds(NI.LookBodyOfRE(r1, l1));
        } else {
          LookBodyLidsSubset(r2, l1); LookBodyLidsSubset(r1, l2);
          DirectLidsSubLookIds(NI.LookBodyOfRE(r2, l1));
        }
      }
    case Re_quant(_, _, _, r1) => DirectEarlyNotInLateBody(r1, l1, l2);
    case Re_capture(_, r1) => DirectEarlyNotInLateBody(r1, l1, l2);
    case Re_lookaround(lid0, _, r1) =>
      if lid0 >= 0 && (lid0 as nat) == l1 {
        // l1 IS this node: body(l1) == r1; l2 (!= l1) nested in r1
        assert NI.LookBodyOfRE(r, l1) == r1;
        assert l2 in LTB.LookIds(r1);
        assert NI.LookBodyOfRE(r, l2) == NI.LookBodyOfRE(r1, l2);
        DirectLidsNotInBody(r1, l2);   // DirectLookIds(r1) * LookIds(LookBodyOfRE(r1,l2)) == {}
      } else if lid0 >= 0 && (lid0 as nat) == l2 {
        // l2 IS this node: l1 nested in r1 => l1 > lid0 == l2 (well-nesting), contradicting l1 < l2
        assert l1 in LTB.LookIds(r1);
        assert lid0 as nat < l1;       // LidsWellNested at this node
        assert false;
      } else {
        assert l1 in LTB.LookIds(r1) && l2 in LTB.LookIds(r1);
        assert NI.LookBodyOfRE(r, l1) == NI.LookBodyOfRE(r1, l1);
        assert NI.LookBodyOfRE(r, l2) == NI.LookBodyOfRE(r1, l2);
        DirectEarlyNotInLateBody(r1, l1, l2);
      }
  }

  /** (f) look-stability from the MAIN match: every recorded lid `l2` is DIRECT
      (the main bytecode gates only on direct lids, `DirectLidClassified` +
      look-frame), and no direct lid lands inside another look's body
      (`DirectLidsNotInBody`), so `l2 !in LookIdSet(b1)`. */
  lemma {:isolate_assertions} FStabilityNested(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs, nlook: int, result: Option<AI.Thread>)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re) && LTB.LookTablesOk(re, crv)
    requires look == AReg.init_regs(nlook)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
                (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
                && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1
                && AReg.get_cp(result.value.look_regs, l2).Some?) ==> l2 !in LookIdSet(b1)
  {
    var Sd := DirectLidSet(re);
    DirectLidClassified(re);                            // LookChecksInside(code, Sd)
    assert CM.VmLooksAgree(inits, look, Sd) by {
      assert CM.RegsAgreeOutside(look, look, Sd);
    }
    CM.FFindMatchLookFrame(code, str, inits, ov, LAnc.Forward, cdn, look, Sd);
    if result.Some? {
      var lk := result.value.look_regs;
      assert CM.RegsAgreeOutside(lk, look, Sd);
      forall l1: int, la1: R.lookaround, b1: R.regex, l2: int |
        1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
        && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1
        && AReg.get_cp(lk, l2).Some?
        ensures l2 !in LookIdSet(b1)
      {
        // l2 recorded => l2 is a direct lid
        assert l2 in Sd by {
          if l2 !in Sd {
            assert AI.get_idx(lk.a_cp, l2) == AI.get_idx(look.a_cp, l2);   // RegsAgreeOutside
            assert AReg.get_cp(look, l2).None?;                           // init: -1
            assert AReg.get_cp(lk, l2).None?;                             // contradiction
          }
        }
        assert (l2 as nat) in DirectLookIds(re);
        // b1 == LookBodyOfRE(re, l1)
        LookEntryOnlyReal(ast, crv, l1, la1, b1);
        var lid1 := l1 as nat;
        NI.LookBodyOfTablesTie(re, crv, lid1);
        var la0: R.lookaround :| LTB.LookEntryOk(crv, lid1 as int, la0, NI.LookBodyOfRE(re, lid1));
        assert b1 == NI.LookBodyOfRE(re, lid1);
        DirectLidsNotInBody(re, lid1);                  // DirectLookIds(re) * LookIds(b1) == {}
        if l2 in LookIdSet(b1) {
          var x: nat :| x in LTB.LookIds(b1) && (x as int) == l2;
          assert x == (l2 as nat);
          assert x in DirectLookIds(re) * LTB.LookIds(b1);   // false
        }
      }
    }
  }

  /** DELIVERABLE #3: the nested analogue of `LookRowsFromTablesL3a`. From the
      whole-regex main-match setup, PRODUCES every (a)-(h) hypothesis that R3's
      `FLookLoopValueLiftFull`/`FLookLoopFullCoversInLooks` and R2's
      `FLookLoopCaptureFrameNested` require, at cap/lk/qt := the winning thread's
      register banks, S := CaptureRegsSet(CapIdsInLooks(re)), Slook :=
      LookIdSet(re). recon A: (a)/(D-ord)/(g_new)/(h) are ALL unconditional
      (table+nesting only, DEPTH-GENERAL — no `NestDepth` cap); (b)/(c')/(e)/(f)
      + register wf + quant finality read the winning thread and are guarded by
      `result.Some?`. Assembles `LookRowsStaticNested` + `LookRowsDynamicNested`
      + `FStabilityNested` + `FFindMatchQuantFinalAny`. */
  lemma LookRowsFromTablesNested(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
    ncap: int, nlook: int, nquant: int, endl: nat, result: Option<AI.Thread>)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str| && inits.clock >= 0
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    // ---- (a) FrameEntryOk per row (table+nesting only) ----
    ensures forall l: int, la: R.lookaround, body: R.regex ::
              1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                FrameEntryOk(crv, la, body, PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)), LookIdSet(re))
    // ---- (D-ord) ----
    ensures forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
              1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
              && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {}
    // ---- (g_new) [depth-general] ----
    ensures forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
              1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
              && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
                DirectLookIds(b1) * LTB.LookIds(b2) == {}
    // ---- (h) ----
    ensures forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
              1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==>
                l2 !in LookIdSet(b1)
    // ---- register wf + quant finality of the winning thread ----
    ensures result.Some? ==> CM.ThreadRegsWf(result.value, ncap, nlook, nquant)
    ensures result.Some? ==>
              (forall k :: AI.get_idx(result.value.quant_regs.a_cp, k) < 0)
              && (forall k :: AI.get_idx(result.value.quant_regs.a_clk, k) >= -1)
    // ---- (e) ----
    ensures result.Some? ==> CM.LookCpsLE(result.value.look_regs, |str|)
    // ---- (b) ----
    ensures result.Some? ==>
              forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(result.value.look_regs, l).Some? ==>
                                 exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body)
    // ---- (c') ----
    ensures result.Some? ==>
              forall l: int, la: R.lookaround, body: R.regex ::
                1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
                  CM.RegsAgreeInside(result.value.capture_regs, AReg.init_regs(ncap), PIV.CaptureRegs(body))
    // ---- (f) ----
    ensures result.Some? ==>
              forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
                (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
                && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1
                && AReg.get_cp(result.value.look_regs, l2).Some?) ==> l2 !in LookIdSet(b1)
  {
    LookRowsStaticNested(ast, re, crv);
    LookRowsDynamicNested(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant,
                          ncap, nlook, nquant, endl, result);
    FStabilityNested(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant, nlook, result);
    // quant finality of the winning thread
    NoTrueQuantStampNested(re);
    assert VmQuantFinal(inits) by {
      assert QuantRegsFinal(AI.init_thread(cap, look, quant)) by {
        forall k ensures AI.get_idx(quant.a_cp, k) < 0 && AI.get_idx(quant.a_clk, k) >= -1 {
          if 0 <= k < |quant.a_cp| { assert quant.a_cp[k] == -1; }
          if 0 <= k < |quant.a_clk| { assert quant.a_clk[k] == -1; }
        }
      }
    }
    FFindMatchQuantFinalAny(code, str, inits, ov, LAnc.Forward, cdn);
  }

  /** C4e: quant twin of `NI.LookBodyCapsIn` — a look body's own quant ids are
      inside-look quant ids of `r` (hence quant ids of `r`). Pure structural
      induction over `LookBodyOfRE`, mirroring the capture version. */
  lemma LookBodyQuantsIn(r: R.regex, lid: nat)
    requires lid in LTB.LookIds(r)
    ensures PIV.QuantIds(NI.LookBodyOfRE(r, lid)) <= PIV.QuantIdsInLooks(r)
    ensures PIV.QuantIds(NI.LookBodyOfRE(r, lid)) <= PIV.QuantIds(r)
    decreases r
  {
    PIV.QuantIdsSplit(r);
    match r
    case Re_alt(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookBodyQuantsIn(r1, lid); } else { LookBodyQuantsIn(r2, lid); }
    case Re_con(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookBodyQuantsIn(r1, lid); } else { LookBodyQuantsIn(r2, lid); }
    case Re_quant(_, _, _, r1) => LookBodyQuantsIn(r1, lid);
    case Re_capture(_, r1) => LookBodyQuantsIn(r1, lid);
    case Re_lookaround(lid0, _, r1) =>
      if lid0 >= 0 && (lid0 as nat) == lid {
      } else {
        LookBodyQuantsIn(r1, lid);
      }
  }

  /** C4e: quant twin of `NI.LookBodiesCapsDisjointOrNested`. For two distinct
      look ids, either their bodies' QUANT ids are DISJOINT (siblings) or one is
      nested in the other and the inner body's quants are a SUBSET. Pure
      structure + unique ids; mirrors the capture trichotomy with `QuantUnique` +
      `LookBodyQuantsIn`. */
  lemma LookBodiesQuantsDisjointOrNested(r: R.regex, l1: nat, l2: nat)
    requires PIV.QuantUnique(r) && LTB.LookUnique(r)
    requires l1 in LTB.LookIds(r) && l2 in LTB.LookIds(r) && l1 != l2
    ensures (PIV.QuantIds(NI.LookBodyOfRE(r, l1)) * PIV.QuantIds(NI.LookBodyOfRE(r, l2)) == {})
            || (l2 in LTB.LookIds(NI.LookBodyOfRE(r, l1))
                && PIV.QuantIds(NI.LookBodyOfRE(r, l2)) <= PIV.QuantIds(NI.LookBodyOfRE(r, l1)))
            || (l1 in LTB.LookIds(NI.LookBodyOfRE(r, l2))
                && PIV.QuantIds(NI.LookBodyOfRE(r, l1)) <= PIV.QuantIds(NI.LookBodyOfRE(r, l2)))
    decreases r
  {
    match r
    case Re_alt(r1, r2) =>
      if l1 in LTB.LookIds(r1) && l2 in LTB.LookIds(r1) {
        LookBodiesQuantsDisjointOrNested(r1, l1, l2);
      } else if l1 !in LTB.LookIds(r1) && l2 !in LTB.LookIds(r1) {
        LookBodiesQuantsDisjointOrNested(r2, l1, l2);
      } else {
        if l1 in LTB.LookIds(r1) { LookBodyQuantsIn(r1, l1); LookBodyQuantsIn(r2, l2); }
        else { LookBodyQuantsIn(r2, l1); LookBodyQuantsIn(r1, l2); }
        forall q: nat | q in PIV.QuantIds(NI.LookBodyOfRE(r, l1)) * PIV.QuantIds(NI.LookBodyOfRE(r, l2))
          ensures false
        { assert q in PIV.QuantIds(r1) * PIV.QuantIds(r2); }
      }
    case Re_con(r1, r2) =>
      if l1 in LTB.LookIds(r1) && l2 in LTB.LookIds(r1) {
        LookBodiesQuantsDisjointOrNested(r1, l1, l2);
      } else if l1 !in LTB.LookIds(r1) && l2 !in LTB.LookIds(r1) {
        LookBodiesQuantsDisjointOrNested(r2, l1, l2);
      } else {
        if l1 in LTB.LookIds(r1) { LookBodyQuantsIn(r1, l1); LookBodyQuantsIn(r2, l2); }
        else { LookBodyQuantsIn(r2, l1); LookBodyQuantsIn(r1, l2); }
        forall q: nat | q in PIV.QuantIds(NI.LookBodyOfRE(r, l1)) * PIV.QuantIds(NI.LookBodyOfRE(r, l2))
          ensures false
        { assert q in PIV.QuantIds(r1) * PIV.QuantIds(r2); }
      }
    case Re_quant(_, _, _, r1) => LookBodiesQuantsDisjointOrNested(r1, l1, l2);
    case Re_capture(_, r1) => LookBodiesQuantsDisjointOrNested(r1, l1, l2);
    case Re_lookaround(lid0, _, r1) =>
      if lid0 >= 0 && (lid0 as nat) == l1 {
        assert l2 in LTB.LookIds(r1);
        assert NI.LookBodyOfRE(r, l1) == r1;
        assert NI.LookBodyOfRE(r, l2) == NI.LookBodyOfRE(r1, l2);
        LookBodyQuantsIn(r1, l2);
      } else if lid0 >= 0 && (lid0 as nat) == l2 {
        assert l1 in LTB.LookIds(r1);
        assert NI.LookBodyOfRE(r, l2) == r1;
        assert NI.LookBodyOfRE(r, l1) == NI.LookBodyOfRE(r1, l1);
        LookBodyQuantsIn(r1, l1);
      } else {
        assert l1 in LTB.LookIds(r1) && l2 in LTB.LookIds(r1);
        assert NI.LookBodyOfRE(r, l1) == NI.LookBodyOfRE(r1, l1);
        assert NI.LookBodyOfRE(r, l2) == NI.LookBodyOfRE(r1, l2);
        LookBodiesQuantsDisjointOrNested(r1, l1, l2);
      }
  }

  /** DELIVERABLE #4: the PREMISE-FREE corollary (engine side of recon_inner +
      recon_outer). From the whole-regex main-match setup alone (all (a)-(h)
      discharged by `LookRowsFromTablesNested`), the whole-regex `FLookLoop`'s
      capture bank `res.0`:
      - (recon_outer) writes ONLY inside look bodies: agrees with the main-match
        bank OUTSIDE `CaptureRegsSet(CapIdsInLooks(re))`, and the look bank
        `res.1` agrees OUTSIDE `LookIdSet(re)` (`FLookLoopCaptureFrameNested`);
      - (recon_inner) carries every `g in CapIdsInLooks(re)` whose innermost
        owner is a matched positive lookahead, at the owner's fresh-body value
        (`FLookLoopFullCoversInLooks`). */
  lemma FLookLoopFullCoversFromTables(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
    ncap: int, nlook: int, nquant: int, endl: nat, result: Option<AI.Thread>, g: nat)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires g in PIV.CapIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str| && inits.clock >= 0
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                      result.value.capture_regs, result.value.look_regs, result.value.quant_regs, ov);
              // recon_outer: FLookLoop writes captures/looks only inside look bodies
              CM.RegsAgreeOutside(res.0, result.value.capture_regs, PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)))
              && CM.RegsAgreeOutside(res.1, result.value.look_regs, LookIdSet(re))
              // recon_inner: res.0 carries every matched g at its innermost owner's fresh value
              && (forall owner: nat :: owner in LTB.LookIds(re)
                                       && g in PIV.CapIds(NI.LookBodyOfRE(re, owner))
                                       && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner))
                                       && MatchedPosLA(crv, res.1, owner) ==>
                                         var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
                                         (rf.Some? ==> CM.RegsAgreeInside(res.0, rf.value.capture_regs, PIV.CaptureRegsSet({g})))
                                         && (rf.None? ==> CM.RegsAgreeInside(res.0, AReg.init_regs(ncap), PIV.CaptureRegsSet({g}))))
  {
    LookRowsFromTablesNested(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant,
                             ncap, nlook, nquant, endl, result);
    if result.Some? {
      var S := PIV.CaptureRegsSet(PIV.CapIdsInLooks(re));
      var Slook := LookIdSet(re);
      var c := result.value.capture_regs;
      var l := result.value.look_regs;
      var q := result.value.quant_regs;
      assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant);
      FLookLoopFullCoversInLooks(crv, str, ast, re, c, l, q, ov, S, Slook, ncap, nlook, nquant, g);
      FLookLoopCaptureFrameNested(crv, str, 1, R.max_lookaround(ast), c, l, q, ov, S, Slook);
    }
  }

  /** C4e: (D-ord-q) per-pair — quant twin of `DOrdFromTables`. For `l1 < l2`,
      `QIdsOuter(b1)` is disjoint from `QIdsInt(b2)`. The two bodies are disjoint
      siblings or `b2` is nested in `b1` (`LookBodiesQuantsDisjointOrNested`); the
      third arm is killed by well-nesting. In the nested arm `b2`'s quants sit in
      `b1`'s INSIDE-look quants, disjoint from `b1`'s OUTSIDE-look quants. */
  lemma DOrdQuantFromTables(ast: R.regex, re: R.regex, crv: CP.FCompiled,
                            l1: int, la1: R.lookaround, b1: R.regex,
                            l2: int, la2: R.lookaround, b2: R.regex)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)   // (L5 F7c) lifted from NoPosLookbehindRE
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires 1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
    requires LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2)
    ensures QIdsOuter(b1) * LKC.QIdsInt(b2) == {}
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(re) == LTB.LookIds(ast);
    LookEntryOnlyReal(ast, crv, l1, la1, b1);
    LookEntryOnlyReal(ast, crv, l2, la2, b2);
    var lid1 := l1 as nat;
    var lid2 := l2 as nat;
    NI.LookBodyOfTablesTie(re, crv, lid1);
    NI.LookBodyOfTablesTie(re, crv, lid2);
    var la01: R.lookaround :| LTB.LookEntryOk(crv, lid1 as int, la01, NI.LookBodyOfRE(re, lid1));
    var la02: R.lookaround :| LTB.LookEntryOk(crv, lid2 as int, la02, NI.LookBodyOfRE(re, lid2));
    assert b1 == NI.LookBodyOfRE(re, lid1);
    assert b2 == NI.LookBodyOfRE(re, lid2);
    PIV.QuantIdsSplit(b1);                               // QuantIdsOutsideLooks(b1) <= QuantIds(b1)
    LookBodyFactsL5(re, crv, lid1);                  // QuantUnique(b1)
    LookBodiesQuantsDisjointOrNested(re, lid1, lid2);
    // nat-set disjointness: QuantIdsOutsideLooks(b1) * QuantIds(b2) == {}
    if PIV.QuantIds(b1) * PIV.QuantIds(b2) == {} {
      assert PIV.QuantIdsOutsideLooks(b1) * PIV.QuantIds(b2) == {};
    } else if lid2 in LTB.LookIds(b1) && PIV.QuantIds(b2) <= PIV.QuantIds(b1) {
      NI.LookBodyCompose(re, lid1, lid2);               // b2 == LookBodyOfRE(b1, lid2)
      LookBodyQuantsIn(b1, lid2);                        // QuantIds(b2) <= QuantIdsInLooks(b1)
      PIV.QuantIdsLooksDisjoint(b1);                     // outside(b1) * inside(b1) == {}
      assert PIV.QuantIdsOutsideLooks(b1) * PIV.QuantIds(b2) == {};
    } else {
      assert lid1 in LTB.LookIds(b2);
      LookBodyLidsGt(re, lid2);                          // x in LookIds(b2) ==> l2 < x
      assert lid2 < lid1;                                // contra l1 < l2
      assert false;
    }
    // transfer nat-disjointness to the int images
    forall k: int | k in QIdsOuter(b1) * LKC.QIdsInt(b2) ensures false {
      var q1: nat :| q1 in PIV.QuantIdsOutsideLooks(b1) && (q1 as int) == k;
      var q2: nat :| q2 in PIV.QuantIds(b2) && (q2 as int) == k;
      assert q1 == q2;
      assert q1 in PIV.QuantIdsOutsideLooks(b1) * PIV.QuantIds(b2);
    }
  }

  /** C4e: (Sq-bound) per-row — each body's OUTSIDE-look quant ids land in the
      int image of `re`'s in-look quant ids. Via `LookBodyQuantsIn` (`QuantIds
      (body) <= QuantIdsInLooks(re)`) + `QuantIdsSplit`. */
  lemma SqBoundQuantFromTables(ast: R.regex, re: R.regex, crv: CP.FCompiled,
                               l: int, la: R.lookaround, body: R.regex)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires 1 <= l <= R.max_lookaround(ast)
    requires LTB.LookEntryOk(crv, l, la, body)
    ensures QIdsOuter(body) <= (set q: nat | q in PIV.QuantIdsInLooks(re) :: q as int)
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(re) == LTB.LookIds(ast);
    LookEntryOnlyReal(ast, crv, l, la, body);
    var lid := l as nat;
    NI.LookBodyOfTablesTie(re, crv, lid);
    var la0: R.lookaround :| LTB.LookEntryOk(crv, lid as int, la0, NI.LookBodyOfRE(re, lid));
    assert body == NI.LookBodyOfRE(re, lid);
    LookBodyQuantsIn(re, lid);                           // QuantIds(body) <= QuantIdsInLooks(re)
    PIV.QuantIdsSplit(body);                             // QuantIdsOutsideLooks(body) <= QuantIds(body)
    forall k: int | k in QIdsOuter(body)
      ensures k in (set q: nat | q in PIV.QuantIdsInLooks(re) :: q as int)
    {
      var q: nat :| q in PIV.QuantIdsOutsideLooks(body) && (q as int) == k;
      assert q in PIV.QuantIds(body);
      assert q in PIV.QuantIdsInLooks(re);
    }
  }

  /** C4e: nested twin of `MainMatchBodyQuantsInit` — the main pass never stamps
      an inside-look quant, so a genuine-start search returns a winning thread
      whose quant bank agrees with the INITIAL bank OUTSIDE `QIdsOuter(re)`. Via
      the nested outer-quant classifier `QuantBytecodeClassifiedNestedOuter` +
      `CM.FFindMatchQuantFrame`. */
  lemma MainMatchBodyQuantsInitNested(re: R.regex, code: RB.code, str: string,
                                      inits: AI.VmState, cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
                                      ov: LOr.OracleView, cdn: LCdn.cdns, result: Option<AI.Thread>)
    requires NR.NestedFragmentRE(re) && PIV.QuantUnique(re)
    requires code == CP.compile_to_bytecode(re)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str|
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==> CM.RegsAgreeOutside(result.value.quant_regs, quant, QIdsOuter(re))
  {
    QuantBytecodeClassifiedNestedOuter(re);              // QuantWritesInside(code, QIdsOuter(re))
    assert CM.VmQuantsAgree(inits, quant, QIdsOuter(re)) by {
      assert AI.init_thread(cap, look, quant).quant_regs == quant;
      assert CM.RegsAgreeOutside(quant, quant, QIdsOuter(re));
    }
    CM.FFindMatchQuantFrame(code, str, inits, ov, LAnc.Forward, cdn, quant, QIdsOuter(re));
  }

  /** C4e: a look body's quant ids are disjoint from `re`'s OUTSIDE-look quant
      ids — `QIdsInt(body)` (int image of `QuantIds(body)`) misses `QIdsOuter(re)`.
      Via `LookBodyQuantsIn` (`QuantIds(body) <= QuantIdsInLooks(re)`) +
      `QuantIdsLooksDisjoint`. Feeds the (c'q) discharge in the premise-free
      quant corollary. */
  lemma BodyQIdsIntDisjointOuterRe(ast: R.regex, re: R.regex, crv: CP.FCompiled,
                                   l: int, la: R.lookaround, body: R.regex)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires 1 <= l <= R.max_lookaround(ast)
    requires LTB.LookEntryOk(crv, l, la, body)
    ensures LKC.QIdsInt(body) * QIdsOuter(re) == {}
  {
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false),
                          R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert LTB.LookIds(re) == LTB.LookIds(ast);
    LookEntryOnlyReal(ast, crv, l, la, body);
    var lid := l as nat;
    NI.LookBodyOfTablesTie(re, crv, lid);
    var la0: R.lookaround :| LTB.LookEntryOk(crv, lid as int, la0, NI.LookBodyOfRE(re, lid));
    assert body == NI.LookBodyOfRE(re, lid);
    LookBodyQuantsIn(re, lid);                           // QuantIds(body) <= QuantIdsInLooks(re)
    PIV.QuantIdsLooksDisjoint(re);                       // outside(re) * inside(re) == {}
    forall k: int | k in LKC.QIdsInt(body) * QIdsOuter(re) ensures false {
      var q1: nat :| q1 in PIV.QuantIds(body) && (q1 as int) == k;
      var q2: nat :| q2 in PIV.QuantIdsOutsideLooks(re) && (q2 as int) == k;
      assert q1 == q2;
      assert q1 in PIV.QuantIdsInLooks(re);
      assert q2 in PIV.QuantIdsOutsideLooks(re) * PIV.QuantIdsInLooks(re);
    }
  }

  /** C4e DELIVERABLE 3: the PREMISE-FREE quant corollary — quant analogue of
      `FLookLoopFullCoversFromTables`, supplying the endpoint's inside-value feed
      (iii) directly. From the whole-regex main-match setup alone, the whole-regex
      `FLookLoop`'s quant bank `res.2`:
      - (recon_outer) writes only inside look bodies: agrees with the main-match
        quant bank OUTSIDE the int image of `QuantIdsInLooks(re)`
        (`FLookLoopQuantFrameNested`);
      - (recon_inner) carries every `qd in QuantIdsInLooks(re)` whose innermost
        owner is a matched positive lookahead, at the owner's fresh-body value
        (`FLookLoopQuantCoversInLooks`).
      `LookRowsFromTablesNested` discharges the shared (a),(b),(e),(f),(g_new),(h)
      + register wf + quant finality; the quant twins (c'q)/(D-ord-q)/(Sq-bound)
      are discharged here from `MainMatchBodyQuantsInitNested`/`DOrdQuantFrom
      Tables`/`SqBoundQuantFromTables`. */
  lemma FLookLoopQuantCoversFromTables(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
    ncap: int, nlook: int, nquant: int, endl: nat, result: Option<AI.Thread>, qd: nat)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires qd in PIV.QuantIdsInLooks(re)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str| && inits.clock >= 0
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                      result.value.capture_regs, result.value.look_regs, result.value.quant_regs, ov);
              // recon_outer: FLookLoop writes quants only inside look bodies
              CM.RegsAgreeOutside(res.2, result.value.quant_regs,
                                  (set q: nat | q in PIV.QuantIdsInLooks(re) :: q as int))
              // recon_inner: res.2 carries every matched qd at its innermost owner's fresh value
              && (forall owner: nat :: owner in LTB.LookIds(re)
                                       && qd in PIV.QuantIds(NI.LookBodyOfRE(re, owner))
                                       && qd !in PIV.QuantIdsInLooks(NI.LookBodyOfRE(re, owner))
                                       && MatchedPosLA(crv, res.1, owner) ==>
                                         var rf := FreshBodyMatch(crv, str, owner as int, res.1, ov, ncap, nlook, nquant);
                                         (rf.Some? ==> CM.RegsAgreeInside(res.2, rf.value.quant_regs, {qd as int}))
                                         && (rf.None? ==> CM.RegsAgreeInside(res.2, AReg.init_regs(nquant), {qd as int})))
  {
    LookRowsFromTablesNested(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant,
                             ncap, nlook, nquant, endl, result);
    if result.Some? {
      var S := PIV.CaptureRegsSet(PIV.CapIdsInLooks(re));
      var Slook := LookIdSet(re);
      var Sq := set q: nat | q in PIV.QuantIdsInLooks(re) :: q as int;
      var c := result.value.capture_regs;
      var l := result.value.look_regs;
      var q := result.value.quant_regs;
      assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant);

      // ---- quant twins of (c'q)/(D-ord-q)/(Sq-bound) at the winning thread ----
      MainMatchBodyQuantsInitNested(re, code, str, inits, cap, look, quant, ov, cdn, result);
      assert CM.RegsAgreeOutside(q, quant, QIdsOuter(re));
      PIV.QuantIdsLooksDisjoint(re);
      // (c'q): each body's quant slots are INITIAL in the winning quant bank
      assert forall lx: int, lax: R.lookaround, body: R.regex ::
          1 <= lx <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, lx, lax, body) ==>
            CM.RegsAgreeInside(q, AReg.init_regs(nquant), LKC.QIdsInt(body))
      by {
        forall lx: int, lax: R.lookaround, body: R.regex |
          1 <= lx <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, lx, lax, body)
          ensures CM.RegsAgreeInside(q, AReg.init_regs(nquant), LKC.QIdsInt(body))
        {
          BodyQIdsIntDisjointOuterRe(ast, re, crv, lx, lax, body);
          assert forall k: int :: k in LKC.QIdsInt(body) ==> k !in QIdsOuter(re);
          RegsAgreeOutsideToInside(q, AReg.init_regs(nquant), LKC.QIdsInt(body), QIdsOuter(re));
        }
      }
      assert forall lx1: int, lax1: R.lookaround, b1: R.regex, lx2: int, lax2: R.lookaround, b2: R.regex ::  // (D-ord-q)
          1 <= lx1 <= R.max_lookaround(ast) && 1 <= lx2 <= R.max_lookaround(ast) && lx1 < lx2
          && LTB.LookEntryOk(crv, lx1, lax1, b1) && LTB.LookEntryOk(crv, lx2, lax2, b2) ==>
            QIdsOuter(b1) * LKC.QIdsInt(b2) == {}
      by {
        forall lx1: int, lax1: R.lookaround, b1: R.regex, lx2: int, lax2: R.lookaround, b2: R.regex |
          1 <= lx1 <= R.max_lookaround(ast) && 1 <= lx2 <= R.max_lookaround(ast) && lx1 < lx2
          && LTB.LookEntryOk(crv, lx1, lax1, b1) && LTB.LookEntryOk(crv, lx2, lax2, b2)
          ensures QIdsOuter(b1) * LKC.QIdsInt(b2) == {}
        { DOrdQuantFromTables(ast, re, crv, lx1, lax1, b1, lx2, lax2, b2); }
      }
      assert forall lx: int, lax: R.lookaround, body: R.regex ::                                   // (Sq-bound)
          1 <= lx <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, lx, lax, body) ==> QIdsOuter(body) <= Sq
      by {
        forall lx: int, lax: R.lookaround, body: R.regex |
          1 <= lx <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, lx, lax, body)
          ensures QIdsOuter(body) <= Sq
        { SqBoundQuantFromTables(ast, re, crv, lx, lax, body); }
      }

      FLookLoopQuantCoversInLooks(crv, str, ast, re, c, l, q, ov, S, Slook, Sq, ncap, nlook, nquant, qd);
      FLookLoopQuantFrameNested(crv, str, 1, R.max_lookaround(ast), c, l, q, ov, S, Slook, Sq);
    }
  }

  // ==========================================================================
  // L4 PERF: OPAQUE wrappers for the endpoint's heavy QUANTIFIED facts. Each is
  // ESTABLISHED cheaply inside its producing adapter (`reveal` + the raw fact
  // just proven, a direct match in the adapter's SMALL context) and consumed
  // OPAQUELY (no triggers) at the MainTheoremL4 -> DeepConclude boundary, so the
  // ~5000-obligation context no longer floods every VC with these facts'
  // trigger instantiations. Consumers `reveal` internally to recover the raw
  // fact for their (already-green) bodies.
  // ==========================================================================
  ghost opaque predicate ValueOkO(crv: CP.FCompiled, str: string, res0: AReg.Regs, res1: AReg.Regs,
                                  lid: int, maxlook: int, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int) {
    FLookLoopValueOkFull(crv, str, res0, res1, lid, maxlook, ov, ncap, nlook, nquant)
  }
  ghost opaque predicate QuantValueOkO(crv: CP.FCompiled, str: string, res2: AReg.Regs, res1: AReg.Regs,
                                       lid: int, maxlook: int, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int) {
    FLookLoopQuantValueOkFull(crv, str, res2, res1, lid, maxlook, ov, ncap, nlook, nquant)
  }
  ghost opaque predicate ChildLinkO(crv: CP.FCompiled, str: string, res1: AReg.Regs,
                                    lid: int, maxlook: int, ov: LOr.OracleView, ncap: int, nlook: int, nquant: int) {
    FLookLoopChildLinkOk(crv, str, res1, lid, maxlook, ov, ncap, nlook, nquant)
  }
  ghost opaque predicate LookInvO(res1: AReg.Regs, ov: LOr.OracleView, str: string) {
    CM.LookCpsOracleTrue(res1, ov) && CM.LookCpSetWithClk(res1) && CM.LookCpsLE(res1, |str|)
  }
  ghost opaque predicate TopLookFrameO(re: R.regex, res1: AReg.Regs, look0: AReg.Regs) {
    forall lz: nat :: lz in NI.TopLookIds(re) ==>
                        AI.get_idx(res1.a_clk, lz as int) == AI.get_idx(look0.a_clk, lz as int)
                        && AReg.get_cp(res1, lz as int) == AReg.get_cp(look0, lz as int)
  }
  ghost opaque predicate QuantFrameO(re: R.regex, res2: AReg.Regs, quant0: AReg.Regs) {
    forall q: nat :: q in PIV.QuantIdsOutsideLooks(re) ==>
                       AI.get_idx(res2.a_clk, q as int) == AI.get_idx(quant0.a_clk, q as int)
  }
  ghost opaque predicate CaptureFrameO(re: R.regex, res0: AReg.Regs, cap0: AReg.Regs) {
    forall k: int :: k !in PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)) ==>
                       AI.get_idx(res0.a_cp, k) == AI.get_idx(cap0.a_cp, k)
                       && AI.get_idx(res0.a_clk, k) == AI.get_idx(cap0.a_clk, k)
  }
  ghost opaque predicate Res0LiveO(re: R.regex, res0: AReg.Regs) {
    forall c: nat :: c in PIV.CapIds(re) && AI.get_idx(res0.a_clk, CP.start_reg(c)) < 0
                     ==> AI.get_idx(res0.a_cp, CP.start_reg(c)) < 0
  }
  ghost opaque predicate ThreadLookInvO(look0: AReg.Regs, ov: LOr.OracleView, str: string) {
    CM.LookCpSetWithClk(look0) && CM.LookCpsOracleTrue(look0, ov) && CM.LookCpsLE(look0, |str|)
    && |look0.a_cp| == |look0.a_clk|
  }
  ghost opaque predicate FrameEntryAllO(crv: CP.FCompiled, re: R.regex, ast: R.regex) {
    forall l: int, la: R.lookaround, b: R.regex ::
      1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, b) ==>
        FrameEntryOk(crv, la, b, PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)), LookIdSet(re))
  }
  ghost opaque predicate OracleSufAllO(rer: LW.RegExpRecord, qm: AR.QMap, str: string) {
    forall cp: nat :: cp <= |str| ==> LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
  }
  /** L4 PERF: the (a)-(h) look-table hypotheses that `FreshBodyDirectMember`
      needs, bundled OPAQUE. The (D-ord)/(g_new) SIX-variable quantifiers are the
      dominant Z3 trigger-explosion source; wrapping them lets the owner-forall
      hold the tables atomically (no triggers on its other assertions) and
      `FreshBodyDirectMember` reveal them only in its own body. */
  ghost opaque predicate AhO(crv: CP.FCompiled, ast: R.regex, cap: AReg.Regs, lk: AReg.Regs,
                             S: set<int>, Slook: set<int>, ncap: int, str: string) {
    (forall l: int, la: R.lookaround, body: R.regex ::
       1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==> FrameEntryOk(crv, la, body, S, Slook))
    && (forall l: int :: 1 <= l <= R.max_lookaround(ast) && AReg.get_cp(lk, l).Some? ==>
                           exists la: R.lookaround, body: R.regex :: LTB.LookEntryOk(crv, l, la, body))
    && (forall l: int, la: R.lookaround, body: R.regex ::
          1 <= l <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l, la, body) ==>
            CM.RegsAgreeInside(cap, AReg.init_regs(ncap), PIV.CaptureRegs(body)))
    && (forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
          1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
          && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
            PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(b1)) * PIV.CaptureRegs(b2) == {})
    && (forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
          (1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1)
          && 1 <= l2 <= R.max_lookaround(ast) && l2 != l1 && AReg.get_cp(lk, l2).Some?) ==> l2 !in LookIdSet(b1))
    && (forall l1: int, la1: R.lookaround, b1: R.regex, l2: int, la2: R.lookaround, b2: R.regex ::
          1 <= l1 <= R.max_lookaround(ast) && 1 <= l2 <= R.max_lookaround(ast) && l1 < l2
          && LTB.LookEntryOk(crv, l1, la1, b1) && LTB.LookEntryOk(crv, l2, la2, b2) ==>
            DirectLookIds(b1) * LTB.LookIds(b2) == {})
    && (forall l1: int, la1: R.lookaround, b1: R.regex, l2: int ::
          1 <= l1 <= R.max_lookaround(ast) && LTB.LookEntryOk(crv, l1, la1, b1) && 1 <= l2 <= l1 ==> l2 !in LookIdSet(b1))
  }

  /** (L4 PERF adapter) The per-g STANDARD FRESH-MATCH WELL-FORMEDNESS forall,
      wrapped OPAQUE so its `cp_ctx_ok` / `GNotUnderQuantL` triggers never enter
      the FreshBodyDirectMember CALL context. `FreshWfAtG` establishes it (once,
      minimal context); FreshBodyDirectMember reveals it internally. `res1` is the
      caller's `FLookLoop(...).1`. */
  ghost opaque predicate FreshWfO(crv: CP.FCompiled, str: string, re: R.regex, res1: AReg.Regs,
                                  g: nat, ncap: int, nlook: int, nquant: int) {
    forall owner0: nat ::
      owner0 in LTB.LookIds(re)
      && g in PIV.CapIds(NI.LookBodyOfRE(re, owner0))
      && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, owner0))
      && MatchedPosLA(crv, res1, owner0) ==>
        var body := NI.LookBodyOfRE(re, owner0);
        PSM.SizesOkRE(body, ncap, nlook, nquant)
        && (AReg.get_cp(res1, owner0).Some? ==> cp_ctx_ok(crv, str, res1, owner0))
        && T.TransWf(body)
        && GNotUnderQuantL(T.Translate(body), g)
  }

  /** (L4 PERF adapter) The whole-bank `FLookLoopQuantValueOkFull` invariant from
      the STATIC package alone — the endpoint needs it (ForwardMemberOne), and
      proving the lift's `(c'q)/(D-ord-q)/(Sq-bound)` preconditions inline in
      MainTheoremL4 timed out. This mirrors `FLookLoopQuantCoversFromTables`'s
      variant setup verbatim (a minimal context) and then calls the lift, so the
      expensive quantifier matching happens once, here, not in the whole lemma. */
  lemma EndpointQuantValueOk(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
    ncap: int, nlook: int, nquant: int, endl: nat, result: Option<AI.Thread>)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str| && inits.clock >= 0
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                      result.value.capture_regs, result.value.look_regs, result.value.quant_regs, ov);
              |res.2.a_cp| == nquant && |res.2.a_clk| == nquant
              && (forall k :: AI.get_idx(res.2.a_cp, k) < 0) && (forall k :: AI.get_idx(res.2.a_clk, k) >= -1)
              && QuantValueOkO(crv, str, res.2, res.1, 1, R.max_lookaround(ast), ov, ncap, nlook, nquant)
              && QuantFrameO(re, res.2, result.value.quant_regs)
  {
    reveal QuantValueOkO();
    LookRowsFromTablesNested(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant,
                             ncap, nlook, nquant, endl, result);
    if result.Some? {
      var S := PIV.CaptureRegsSet(PIV.CapIdsInLooks(re));
      var Slook := LookIdSet(re);
      var Sq := set qz: nat | qz in PIV.QuantIdsInLooks(re) :: qz as int;
      var c := result.value.capture_regs;
      var l := result.value.look_regs;
      var q := result.value.quant_regs;
      assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant);
      var maxlook := R.max_lookaround(ast);

      // ---- quant twins of (c'q)/(D-ord-q)/(Sq-bound) — verbatim from FLookLoopQuantCoversFromTables ----
      MainMatchBodyQuantsInitNested(re, code, str, inits, cap, look, quant, ov, cdn, result);
      assert CM.RegsAgreeOutside(q, quant, QIdsOuter(re));
      PIV.QuantIdsLooksDisjoint(re);
      assert forall lx: int, lax: R.lookaround, body: R.regex ::
          1 <= lx <= maxlook && LTB.LookEntryOk(crv, lx, lax, body) ==>
            CM.RegsAgreeInside(q, AReg.init_regs(nquant), LKC.QIdsInt(body))
      by {
        forall lx: int, lax: R.lookaround, body: R.regex |
          1 <= lx <= maxlook && LTB.LookEntryOk(crv, lx, lax, body)
          ensures CM.RegsAgreeInside(q, AReg.init_regs(nquant), LKC.QIdsInt(body))
        {
          BodyQIdsIntDisjointOuterRe(ast, re, crv, lx, lax, body);
          RegsAgreeOutsideToInside(q, AReg.init_regs(nquant), LKC.QIdsInt(body), QIdsOuter(re));
        }
      }
      assert forall lx1: int, lax1: R.lookaround, b1: R.regex, lx2: int, lax2: R.lookaround, b2: R.regex ::
          1 <= lx1 <= maxlook && 1 <= lx2 <= maxlook && lx1 < lx2
          && LTB.LookEntryOk(crv, lx1, lax1, b1) && LTB.LookEntryOk(crv, lx2, lax2, b2) ==>
            QIdsOuter(b1) * LKC.QIdsInt(b2) == {}
      by {
        forall lx1: int, lax1: R.lookaround, b1: R.regex, lx2: int, lax2: R.lookaround, b2: R.regex |
          1 <= lx1 <= maxlook && 1 <= lx2 <= maxlook && lx1 < lx2
          && LTB.LookEntryOk(crv, lx1, lax1, b1) && LTB.LookEntryOk(crv, lx2, lax2, b2)
          ensures QIdsOuter(b1) * LKC.QIdsInt(b2) == {}
        { DOrdQuantFromTables(ast, re, crv, lx1, lax1, b1, lx2, lax2, b2); }
      }
      assert forall lx: int, lax: R.lookaround, body: R.regex ::
          1 <= lx <= maxlook && LTB.LookEntryOk(crv, lx, lax, body) ==> QIdsOuter(body) <= Sq
      by {
        forall lx: int, lax: R.lookaround, body: R.regex |
          1 <= lx <= maxlook && LTB.LookEntryOk(crv, lx, lax, body)
          ensures QIdsOuter(body) <= Sq
        { SqBoundQuantFromTables(ast, re, crv, lx, lax, body); }
      }

      FLookLoopQuantValueLiftFull(crv, str, 1, maxlook, c, l, q, ov, S, Slook, Sq, ncap, nlook, nquant);
      // the quant frame (RegsAgreeOutside(res.2, q, Sq)) — same (a)/(Sq-bound) setup
      assert forall lx: int, lax: R.lookaround, body: R.regex ::
          1 <= lx <= maxlook && LTB.LookEntryOk(crv, lx, lax, body) ==>
            FrameEntryOk(crv, lax, body, S, Slook) && QIdsOuter(body) <= Sq;
      FLookLoopQuantFrameNested(crv, str, 1, maxlook, c, l, q, ov, S, Slook, Sq);
      // QuantFrameO: QuantIdsOutsideLooks is disjoint from Sq, so the RegsAgreeOutside
      // just established pins res.2's clock to quant's on those ids.
      var res := AI.FLookLoop(crv, str, 1, maxlook, c, l, q, ov);
      assert QuantFrameO(re, res.2, q) by {
        reveal QuantFrameO();
        forall qz: nat | qz in PIV.QuantIdsOutsideLooks(re)
          ensures AI.get_idx(res.2.a_clk, qz as int) == AI.get_idx(q.a_clk, qz as int)
        {
          assert (qz as int) !in Sq by {
            if (qz as int) in Sq {
              var q2: nat :| q2 in PIV.QuantIdsInLooks(re) && q2 as int == qz as int;
              assert q2 == qz;
              PIV.QuantIdsLooksDisjoint(re);
              assert qz in PIV.QuantIdsOutsideLooks(re) * PIV.QuantIdsInLooks(re);
            }
          }
        }
      }
    }
  }

  /** (L4 PERF adapter) The whole-bank `FLookLoopValueOkFull` from the STATIC
      package. `FLookLoopValueLiftFull`'s preconditions are ALL directly ensured
      by `LookRowsFromTablesNested` (no quant/look variant needed), so this is a
      thin two-call wrapper — but isolating it keeps the value-lift out of
      MainTheoremL4's ambient context. */
  lemma EndpointValueOk(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
    ncap: int, nlook: int, nquant: int, endl: nat, result: Option<AI.Thread>)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str| && inits.clock >= 0
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                      result.value.capture_regs, result.value.look_regs, result.value.quant_regs, ov);
              |res.0.a_cp| == ncap && |res.0.a_clk| == ncap && PIV.CapRegWf(res.0)
              && |res.1.a_cp| == nlook && |res.1.a_clk| == nlook
              && |res.2.a_cp| == nquant && |res.2.a_clk| == nquant
              && ValueOkO(crv, str, res.0, res.1, 1, R.max_lookaround(ast), ov, ncap, nlook, nquant)
              && Res0LiveO(re, res.0) && CaptureFrameO(re, res.0, result.value.capture_regs)
    ensures FrameEntryAllO(crv, re, ast)
  {
    reveal ValueOkO(), Res0LiveO();
    LookRowsFromTablesNested(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant,
                             ncap, nlook, nquant, endl, result);
    assert FrameEntryAllO(crv, re, ast) by { reveal FrameEntryAllO(); }
    if result.Some? {
      var S := PIV.CaptureRegsSet(PIV.CapIdsInLooks(re));
      var Slook := LookIdSet(re);
      var c := result.value.capture_regs;
      var l := result.value.look_regs;
      var q := result.value.quant_regs;
      assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant);
      FLookLoopValueLiftFull(crv, str, 1, R.max_lookaround(ast), c, l, q, ov, S, Slook, ncap, nlook, nquant);
      // Res0LiveO: CapRegWf(res.0) makes cp<0 whenever clk<0 (register invariant)
      var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast), c, l, q, ov);
      assert Res0LiveO(re, res.0) by {
        reveal Res0LiveO();
        forall cc: nat | cc in PIV.CapIds(re) && AI.get_idx(res.0.a_clk, CP.start_reg(cc)) < 0
          ensures AI.get_idx(res.0.a_cp, CP.start_reg(cc)) < 0
        {
          assert PIV.CapRegWf(res.0);
        }
      }
      // CaptureFrameO: FLookLoop writes captures only inside look bodies (Sreg).
      FLookLoopCaptureFrameNested(crv, str, 1, R.max_lookaround(ast), c, l, q, ov, S, Slook);
      assert CaptureFrameO(re, res.0, c) by { reveal CaptureFrameO(); }
    }
  }

  /** (L4 PERF adapter) `FLookLoopChildLinkOk` from the STATIC package. Unlike the
      value/quant lifts, `FLookLoopChildLinkLift` needs the (c'-look) precondition
      (the winning look bank is INITIAL on every look body's direct-child lids),
      which no existing `FromTables` wrapper produces — proving it inline in
      MainTheoremL4 timed out. Here it is built once, in a minimal context: the
      main code gates only DIRECT lids (`DirectLidClassified` -> `LookChecksInside
      (code, DirectLidSet(re))`), so the winning look bank agrees with the initial
      bank OUTSIDE `DirectLidSet(re)` (`CM.FFindMatchLookFrame`); and a look body's
      direct children are disjoint from `re`'s direct lids (`DirectLidsNotInBody`),
      so the bank is initial on each `DirectLidSet(body)`. */
  lemma EndpointChildLinkOk(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
    ncap: int, nlook: int, nquant: int, endl: nat, result: Option<AI.Thread>)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str| && inits.clock >= 0
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                      result.value.capture_regs, result.value.look_regs, result.value.quant_regs, ov);
              ChildLinkO(crv, str, res.1, 1, R.max_lookaround(ast), ov, ncap, nlook, nquant)
  {
    reveal ChildLinkO();
    LookRowsFromTablesNested(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant,
                             ncap, nlook, nquant, endl, result);
    var maxlook := R.max_lookaround(ast);
    var initlk := AReg.init_regs(nlook);
    var Sd := DirectLidSet(re);

    // main-run look-bank frame: writes look only at DIRECT lids of re
    DirectLidClassified(re);                                   // LookChecksInside(code, Sd)
    assert CM.VmLooksAgree(inits, initlk, Sd) by {
      forall t | t in inits.active ensures CM.RegsAgreeOutside(t.look_regs, initlk, Sd) {
        assert t == AI.init_thread(cap, look, quant);
      }
    }
    CM.FFindMatchLookFrame(code, str, inits, ov, LAnc.Forward, cdn, initlk, Sd);

    if result.Some? {
      var S := PIV.CaptureRegsSet(PIV.CapIdsInLooks(re));
      var Slook := LookIdSet(re);
      var c := result.value.capture_regs;
      var l := result.value.look_regs;
      var q := result.value.quant_regs;
      assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant);
      assert CM.RegsAgreeOutside(l, initlk, Sd);              // FFindMatchLookFrame

      // (c'-look): the winning look bank is INITIAL on each body's direct children
      assert forall lx: int, lax: R.lookaround, body: R.regex ::
          1 <= lx <= maxlook && LTB.LookEntryOk(crv, lx, lax, body) ==>
            CM.RegsAgreeInside(l, initlk, DirectLidSet(body))
      by {
        forall lx: int, lax: R.lookaround, body: R.regex |
          1 <= lx <= maxlook && LTB.LookEntryOk(crv, lx, lax, body)
          ensures CM.RegsAgreeInside(l, initlk, DirectLidSet(body))
        {
          LookEntryOnlyReal(ast, crv, lx, lax, body);          // (lx as nat) in LookIds(ast) == LookIds(re)
          var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false), R.Re_character(R.Dot));
          assert re == R.Re_con(pre, ast);
          assert LTB.LookIds(re) == LTB.LookIds(ast);
          NI.LookBodyOfTablesTie(re, crv, lx as nat);
          var la0: R.lookaround :| LTB.LookEntryOk(crv, lx as nat as int, la0, NI.LookBodyOfRE(re, lx as nat));
          assert body == NI.LookBodyOfRE(re, lx as nat);
          DirectLidsNotInBody(re, lx as nat);                  // DirectLookIds(re) * LookIds(body) == {}
          DirectLidsSubLookIds(body);                          // DirectLookIds(body) <= LookIds(body)
          forall k: int | k in DirectLidSet(body) ensures k !in Sd {
            var kn: nat :| kn in DirectLookIds(body) && (kn as int) == k;
            assert kn in LTB.LookIds(body);
            if k in Sd {
              var kr: nat :| kr in DirectLookIds(re) && (kr as int) == k;
              assert kr == kn;
              assert kr in DirectLookIds(re) * LTB.LookIds(body);
            }
          }
          RegsAgreeOutsideToInside(l, initlk, DirectLidSet(body), Sd);
        }
      }

      FLookLoopChildLinkLift(crv, str, 1, maxlook, c, l, q, ov, S, Slook, ncap, nlook, nquant);
    }
  }

  /** (L4 PERF adapter) The res.1 look-bank invariants `LookCpsOracleTrue`,
      `LookCpSetWithClk`, `LookCpsLE` from the STATIC package — the winning main
      look bank carries the clk/cp/oracle-true shape (`CM.FFindMatchLook*`), and
      `FLookLoopLookOracleTrue`/`FLookLoopLookCpSet` lift it through the fold. */
  lemma EndpointLookInv(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
    ncap: int, nlook: int, nquant: int, endl: nat, result: Option<AI.Thread>)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str| && inits.clock >= 0
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                      result.value.capture_regs, result.value.look_regs, result.value.quant_regs, ov);
              LookInvO(res.1, ov, str)
              && ThreadLookInvO(result.value.look_regs, ov, str)
  {
    reveal LookInvO(), ThreadLookInvO();
    LookRowsFromTablesNested(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant,
                             ncap, nlook, nquant, endl, result);
    NoWriteOracleBodyCodeNested(re);                           // NoWriteOracleCode(code)
    var maxlook := R.max_lookaround(ast);
    if result.Some? {
      var S := PIV.CaptureRegsSet(PIV.CapIdsInLooks(re));
      var Slook := LookIdSet(re);
      var c := result.value.capture_regs;
      var l := result.value.look_regs;
      var q := result.value.quant_regs;
      assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant);
      assert CM.VmLookClkSet(inits) by {
        RL.AInitLaws(nlook);
        forall lz | AI.get_idx(look.a_cp, lz) >= 0 ensures AI.get_idx(look.a_clk, lz) >= 0 {
          if 0 <= lz < nlook { assert look.a_cp[lz] == -1; }
        }
      }
      CM.FFindMatchLookClkSet(code, str, inits, ov, LAnc.Forward, cdn);
      assert CM.LookClkSetWithCp(l);
      assert CM.VmLookCpSet(inits) by {
        RL.AInitLaws(nlook);
        forall lz | AI.get_idx(look.a_clk, lz) >= 0 ensures AI.get_idx(look.a_cp, lz) >= 0 {
          if 0 <= lz < nlook { assert look.a_clk[lz] == -1; }
        }
      }
      CM.FFindMatchLookCpSet(code, str, inits, ov, LAnc.Forward, cdn);
      assert CM.LookCpSetWithClk(l);
      assert CM.VmLookOracleTrue(inits, ov) by {
        RL.AInitLaws(nlook);
        forall lz | AI.get_idx(look.a_cp, lz) >= 0
          ensures LOr.view_get_oracle(ov, AI.get_idx(look.a_cp, lz), lz)
        {
          if 0 <= lz < nlook { assert look.a_cp[lz] == -1; }
        }
      }
      CM.FFindMatchLookOracleTrue(code, str, inits, ov, LAnc.Forward, cdn);
      assert CM.LookCpsOracleTrue(l, ov);
      FLookLoopLookOracleTrue(crv, str, 1, maxlook, c, l, q, ov, S, Slook, ncap, nlook, nquant);
      FLookLoopLookCpSet(crv, str, 1, maxlook, c, l, q, ov, S, Slook, ncap, nlook, nquant);
      assert ThreadLookInvO(l, ov, str) by { reveal ThreadLookInvO(); assert CM.LookCpsLE(l, |str|); }
    }
  }

  /** (L4 PERF adapter) The TOP-look frame: `FLookLoop` leaves every TOP lid's
      look record untouched (the fold replays nested children, never top rows).
      Verbatim from MainTheoremL4's block — per top lid `l`, the (h')@l premise
      (`l !in LookIdSet` of every row's body, via `TopLookNotNested`) feeds
      `FLookLoopTopLook{Clk,Cp}StableFull`. */
  lemma EndpointTopLookFrame(
    ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, str: string,
    ov: LOr.OracleView, cdn: LCdn.cdns, inits: AI.VmState,
    cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs,
    ncap: int, nlook: int, nquant: int, endl: nat, result: Option<AI.Thread>)
    requires crv == CP.FFullCompilation(ast)
    requires re == R.lazy_prefix(ast)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NestedFragmentRE(re) && NR.L5ScopeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv) && LTB.LidsWellNested(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires forall x: nat :: x in LTB.LookIds(re) ==> 1 <= x <= R.max_lookaround(ast)
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code)
    requires inits.context.nextchar == AI.get_char(str, inits.cp)
    requires 0 <= inits.cp <= |str| && inits.clock >= 0
    requires inits.active == [AI.init_thread(cap, look, quant)]
    requires inits.blocked == [] && inits.bestmatch.None?
    requires result == AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0
    ensures result.Some? ==>
              var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                      result.value.capture_regs, result.value.look_regs, result.value.quant_regs, ov);
              TopLookFrameO(re, res.1, result.value.look_regs)
  {
    reveal TopLookFrameO();
    LookRowsFromTablesNested(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant,
                             ncap, nlook, nquant, endl, result);
    var maxlook := R.max_lookaround(ast);
    if result.Some? {
      var S := PIV.CaptureRegsSet(PIV.CapIdsInLooks(re));
      var Slook := LookIdSet(re);
      var c := result.value.capture_regs;
      var l := result.value.look_regs;
      var q := result.value.quant_regs;
      assert CM.ThreadRegsWf(result.value, ncap, nlook, nquant);
      NI.TopLookIdsIn(re);
      forall lz: nat | lz in NI.TopLookIds(re)
        ensures AI.get_idx(AI.FLookLoop(crv, str, 1, maxlook, c, l, q, ov).1.a_clk, lz as int)
             == AI.get_idx(l.a_clk, lz as int)
                && AReg.get_cp(AI.FLookLoop(crv, str, 1, maxlook, c, l, q, ov).1, lz as int)
                   == AReg.get_cp(l, lz as int)
      {
        assert forall l1: int, la1: R.lookaround, b1: R.regex ::
            1 <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1) ==> (lz as int) !in LookIdSet(b1)
        by {
          forall l1: int, la1: R.lookaround, b1: R.regex |
            1 <= l1 <= maxlook && LTB.LookEntryOk(crv, l1, la1, b1)
            ensures (lz as int) !in LookIdSet(b1)
          {
            LookEntryOnlyReal(ast, crv, l1, la1, b1);
            var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false), R.Re_character(R.Dot));
            assert re == R.Re_con(pre, ast);
            assert LTB.LookIds(re) == LTB.LookIds(ast);
            NI.LookBodyOfTablesTie(re, crv, l1 as nat);
            var laT: R.lookaround :| LTB.LookEntryOk(crv, l1, laT, NI.LookBodyOfRE(re, l1 as nat));
            assert b1 == NI.LookBodyOfRE(re, l1 as nat);
            NI.TopLookNotNested(re, lz, l1 as nat);
            if (lz as int) in LookIdSet(b1) {
              var x: nat :| x in LTB.LookIds(b1) && (x as int) == lz as int;
              assert x == lz;
            }
          }
        }
        FLookLoopTopLookClkStableFull(crv, str, 1, maxlook, lz as int, c, l, q, ov, S, Slook);
        FLookLoopTopLookCpStableFull(crv, str, 1, maxlook, lz as int, c, l, q, ov, S, Slook);
      }
    }
  }
}
