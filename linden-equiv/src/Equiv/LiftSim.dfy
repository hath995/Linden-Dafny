// L3a — THE LIFT: the standalone parallel simulation VM ↔ machine B.
//
// SCAFFOLD (2026-08-02): definitions are REAL and resolve; the lemmas are
// BODILESS — each carries a FILL note naming its template and ingredients.
// Fill order: TtLkSameTree → GateStepValue → LiftInit → LiftAdvanceEpsilon →
// LiftConsume → LiftFindMatch → LiftEndpoint. Verify per-symbol as you go
// (bodiless lemmas verify trivially and warn; the warnings disappear as
// bodies land).
//
// WHAT THIS PROVES, once filled: the VM run induces a valid LK-aware
// PikeTree trace (PikeTreeLk) on the SPEC tree t, whose states pair with the
// VM's — per thread, the B-side group map `gmt` carries the t-side
// accumulated captures, tied OUTSIDE S to GmOfLive(thread regs) and INSIDE S
// to the fresh body replay at the thread's own a_cp[l]. At the end,
// PTL.PikeTreeLkComputesFirstLeaf pins B's best to FirstLeaf(t, inp), so the
// winner's leaf values — inside-look groups INCLUDED — equal the engine's
// reconstruction with no position theorem and no leaf-occurrence reasoning.
//
// WHY NO A-MACHINE / NO PikeSimRE COMPOSITION: B's own correctness layer
// (PtsPreservationLk) already handles priority and memoization soundness on
// the t side, so the lift only has to produce LEGAL B steps mirroring VM
// behavior; the one genuinely shared obligation with the old sim is the
// processed↔seen pairing (SeenRepLk below, mirrored from SeenInclusionRE).
// The existing sim and its files stay UNTOUCHED.
//
// GRANULARITY: the ClockMono frame trio (FAdvanceEpsilon / FConsume /
// FFindMatch parallel induction) — the shape that went first-try five times
// in this campaign (FFindMatchLookCpOk, LookClkSet, LookOracleTrue,
// FFindMatchLookFrame, FFindMatchCapWriteFrame). LiftAdvanceEpsilon's
// per-instruction cases mirror those recursions; the CheckOracle case is the
// only one that STEPS B through a gate, and its value content is
// GateStepValue = the proven keystone LkReplayMatchesSpec at cp = s1.cp.
include "MainTheorem.dfy"
include "PikeTreeLk.dfy"
include "LookBehindKeystone.dfy"

/** The lift: a per-thread pairing between the RegElk VM and the LK-aware
    PikeTree machine on the SPEC tree, whose group-map tie carries the
    reconstructed inside-look capture values. Scaffold — lemmas are bodiless. */
module LindenElkLiftSim {
  import opened Std.Wrappers
  import R = RegElkRegex
  import RB = Bytecode
  import CP = Compiler
  import NR = LindenElkNfaRep
  import AI = ArrayInterp
  import AReg = Array_Regs
  import LG = Groups
  import LT = Tree
  import LC = Chars
  import L = Regex
  import LS = Semantics
  import BS = BooleanSemantics
  import WP = WarblrePrimitives
  import LW = WarblreRegExpRecord
  import LOr = Oracle
  import LAnc = Anchors
  import LCdn = Cdn
  import PT = PikeTree
  import SS = SeenSets
  import AR = LindenElkActionsRep
  import EL = LindenElkEntryLk
  import WO = LindenElkWalkOk
  import ATR = LindenElkActionsTreeRep
  import PIV = LindenElkPikeInv
  import CM = LindenElkClockMono
  import PTL = LindenElkPikeTreeLk
  import M = LindenElkMain
  import LBK = LindenLookBehindKeystone
  import LBV = LindenLookBehindValue
  import BV = LindenElkBackValue
  import SD = LindenSpanDuality
  import CD = LindenCloseDisc
  import OS = LindenElkOracleSpec
  import OB = LindenElkOracleBuild
  import T = LindenElkTranslate
  import RC = Charclasses
  import LL = LindenElkLookLeaves
  import LFU = FunctionalUtils
  import FS = FunctionalSemantics
  import SSx = StrictSuffix
  import LN = WarblreNumeric
  import PSM = LindenElkPikeSim
  import RL = LindenElkRegsLaws
  import LKC = LindenElkLookCapture
  import OE = LindenElkOracleEntry
  import LES = LindenElkSpec
  import WOE = LindenElkWalkOkEntry
  import WkE = LindenElkWalkOkEntry
  import TT = LindenElkTreeThread
  import NUL = LindenElkNullable
  import CE = LindenElkCheckErase
  import TREP = LindenElkTreeRep
  import LTB = LindenElkLookTables
  import NI = LindenElkNestInv

  // ==========================================================================
  // SOLID definitions — the pairing.
  // ==========================================================================

  /** The t-side walk state at a pc: some action list represented at `pc`
      whose (checked-flag-erased) spec tree is `tb`. The B-side analogue of
      `TT.TreeThreadRE`.

      NOTE (2026-08-03 do-while-seam reformulation): `WO.WalkOk` was DROPPED from
      this bundle. It was a construction artifact of `ActionsTreeRepFRE` (which
      builds `tstar` top-down and needs the star loop-view guard to proceed).
      `EL.BoolTreeLk` ALREADY self-guards the do-while: its free-star iteration
      arm hardcodes `Acheck` at `CannotExit`, so a nullable empty iteration
      dead-ends at `Mismatch`. Keeping `WalkOk` made the `min==1 Inf` seam
      unsatisfiable (`WalkOkQuantSeam` inserts an `Acheck` the `BoolTreeLk`
      continuation lacks); without it the seam continuation
      `[Areg(r1),Areg(star)]+cont` satisfies `ActionsRepL` + `BoolTreeLk` = tb.t. */
  ghost predicate TtLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                       tb: LT.Tree, pc: nat, ea: bool)
    decreases RB.size(code) - pc
  {
    // `tr_begin`-style transparency: `ActionsRepL` has no `BeginLoop` disjunct
    // (TT.ActionsRepNotAtBeginLoop), yet the VM steps a `BeginLoop` thread
    // straight to `pc+1` (exit_allowed:=false). This stutter lets the tb-pairing
    // see through it, mirroring `TreeRepRE.tr_begin` on the tstar side — so
    // `TtLkAtBeginLoop` becomes a REAL stutter and every non-BeginLoop `TtLkAt*`
    // inversion is unaffected (the first disjunct is dead off a BeginLoop pc).
    (pc < RB.size(code) && NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
     && TtLk(rer, qm, code, inp, tb, pc + 1, false))
    // SQC see-through (2026-08-07 session 5): the star/backfork iteration arm
    // parks a thread AT the `SetQuantToClock` pc, where NO `ActionsRepL`
    // exists for the arm's `GroupActionT(Reset, ·)` tree (the body's actions
    // live past the following BeginLoop). Instruction-gated, like the
    // BeginLoop stutter — dead off an SQC pc.
    || (pc < RB.size(code)
        && exists q: int ::
             NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
             && q in qm.quants
             && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
             && TtLk(rer, qm, code, inp, tb.t, pc + 1, ea))
    || (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActions(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb))
  }

  /** A lookaround occurrence at the TOP LEVEL of `r` — reachable without
      passing an enclosing quantifier's `Reset`. (Under a quantifier the walk
      re-enters through `Reset(DefGroups(body))`, which re-clears the gate's
      groups; a top-level occurrence has no such guard, so `GateAheadClear`
      must hold of it NOW.) */
  ghost predicate RegexTopGate(r: L.Regex, lk: L.Lookaround, r1: L.Regex)
    decreases r
  {
    match r
    case LookaroundR(lk2, rb) => lk2 == lk && rb == r1
    case Sequence(a, b) => RegexTopGate(a, lk, r1) || RegexTopGate(b, lk, r1)
    case Disjunction(a, b) => RegexTopGate(a, lk, r1) || RegexTopGate(b, lk, r1)
    case Group(_, rb) => RegexTopGate(rb, lk, r1)
    case Quantified(_, _, _, _) => false
    case _ => false
  }

  /** A gate is PENDING in the action list when some `Areg` holds it at top
      level. */
  ghost predicate GatePending(acts: LS.Actions, lk: L.Lookaround, r1: L.Regex) {
    exists i :: 0 <= i < |acts| && acts[i].Areg? && RegexTopGate(acts[i].r, lk, r1)
  }

  /** The keystone's `Empty` hypothesis, as a walk-state invariant: any gate
      pending without an intervening reset has its body groups ABSENT from the
      accumulated map. First encounter: never set; re-entry: the iteration's
      `Reset` cleared them; other lids' merges are disjoint
      (`M.LmOfBodiesDisjoint`). */
  ghost predicate GateAheadClear(acts: LS.Actions, gmt: LG.GroupMap) {
    forall lk: L.Lookaround, r1: L.Regex | GatePending(acts, lk, r1) ::
      forall g :: g in L.DefGroups(r1) ==> g !in gmt
  }

  /** OUTSIDE `S`: `gmt` is exactly the thread's live denotation — today's
      `ThreadTracksGm`, transported to the t side. */
  ghost predicate GmtTieOutside(re: R.regex, th: AI.Thread, gmt: LG.GroupMap, S: set<LG.GroupId>) {
    var gml := PIV.GmOfLive(re, th.capture_regs, th.look_regs, th.quant_regs);
    forall g: LG.GroupId | g !in S ::
      (g in gmt <==> g in gml) && (g in gmt ==> gmt[g] == gml[g])
  }

  /** INSIDE `S`: each present inside-look group's value is the FRESH BODY
      REPLAY's value at the thread's own recorded `a_cp[l]` — the exact shape
      `FLookLoopValueOk` delivers engine-side, so the endpoint composes with
      the existing (E) bridge with no translation. (SEAM: the owner-lid
      existential may want the `LookEntryOk` table pin added once the gate case
      is filled — `M.LookRowsFromTablesL3a` produces that bundle.) */
  ghost predicate GmtTieInside(crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                               th: AI.Thread, gmt: LG.GroupMap, S: set<LG.GroupId>,
                               ncap: int, nlook: int, nquant: int) {
    forall g: LG.GroupId | g in S && g in gmt ::
      exists l: int ::
        0 <= l < nlook
        && g in PIV.CapIds(M.VBody(crv, l))
        && M.MatchedPosLA(crv, th.look_regs, l)
        && var rf := M.FreshBodyMatch(crv, str, l, th.look_regs, ov, ncap, nlook, nquant);
           rf.Some?
           && var gmb := PIV.GmOfLive(M.VBody(crv, l), rf.value.capture_regs,
                                      rf.value.look_regs, rf.value.quant_regs);
              // L3b: a LOOKBEHIND's fresh match runs BACKWARD, so its `GmOfLive` reads
              // the span REVERSED (item-0 quirk); the ordered spec `gmt[g]` is the
              // endpoint SWAP of that reversed read. NO-OP for lookaheads (forward,
              // already ordered) and for capture-free lookbehinds (no such `g`).
              var looktype := if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead;
              g in gmb && gmt[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb[g]) else gmb[g])
  }

  /** The tb-pairing walk at a `pc`, WITH the `GateAheadClear` invariant and the
      same `tr_begin`-style BeginLoop stutter as `TtLk`. `ThreadRepLk` uses this
      (rather than a bare `ActionsRepL` existential) so the per-thread pairing
      survives a `BeginLoop` worklist step. Off a BeginLoop pc it is exactly the
      old existential. */
  ghost predicate WalkPairLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             tb: LT.Tree, gmt: LG.GroupMap, pc: nat, ea: bool)
    decreases RB.size(code) - pc
  {
    (pc < RB.size(code) && NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
     && WalkPairLk(rer, qm, code, inp, tb, gmt, pc + 1, false))
    // SQC see-through (2026-08-07 session 5): mirror of TtLk's — the iteration
    // arm's `GroupActionT(Reset, ·)` pairs AT the `SetQuantToClock` pc with the
    // child walking at the RESET-updated map (which is what re-clears the
    // body's gates for `GateAheadClear` downstream).
    || (pc < RB.size(code)
        && exists q: int ::
             NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
             && q in qm.quants
             && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
             && WalkPairLk(rer, qm, code, inp, tb.t,
                           LG.GMUpdate(tb.g, LC.Idx(inp), gmt), pc + 1, ea))
    || (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActions(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb)
          && GateAheadClear(acts, gmt)
          // Defs walk-invariant (carrier REPLACED 2026-08-07 session 5:
          // `NoDupSeq(AllDefsActs)` is FALSE after any quantifier unfold —
          // the (C1,C2,C3) `WalkDefsOk` is the quantifier-stable form; the
          // CheckOracle merge consumes C1 via `RegexTopGateSubTopLk`).
          && WalkDefsOk(acts))
  }

  /** The full per-thread pairing: the B-side `(tb, gmt)` corresponds to VM
      thread `th` — walk-represented at `th.pc`, reset-clear ahead, and
      value-tied on both sides of `S`. */
  ghost predicate ThreadRepLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                              inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, tb: LT.Tree, gmt: LG.GroupMap, th: AI.Thread,
                              ncap: int, nlook: int, nquant: int) {
    th.pc >= 0
    && WalkPairLk(rer, qm, code, inp, tb, gmt, th.pc as nat, th.exit_allowed)
    && GmtTieOutside(re, th, gmt, S)
    && GmtTieInside(crv, str, ov, th, gmt, S, ncap, nlook, nquant)
  }

  /** (L4 NESTED) The per-thread pairing with the depth-1-hardwired
      `GmtTieInside` conjunct DROPPED. Under look nesting an inside-S group can
      be captured inside a NESTED look, for which `GmtTieInside` (which pins the
      value to a SINGLE fresh-body replay `FreshBodyMatch(crv, str, l, ..)`) is
      FALSE; the nested endpoint closes those inner groups post-hoc via the
      already-proven components, so it drops the conjunct here. Everything else
      (`WalkPairLk`, `GmtTieOutside`, and the structural `th.pc >= 0`) is kept
      verbatim. */
  ghost predicate ThreadRepLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                    inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                    S: set<LG.GroupId>, tb: LT.Tree, gmt: LG.GroupMap, th: AI.Thread,
                                    ncap: int, nlook: int, nquant: int) {
    th.pc >= 0
    && WalkPairLk(rer, qm, code, inp, tb, gmt, th.pc as nat, th.exit_allowed)
    && GmtTieOutside(re, th, gmt, S)
  }

  /** Active lists pair index-wise, in order (priority is positional). */
  ghost predicate ActiveRepLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                              inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, tl: seq<(LT.Tree, LG.GroupMap)>, vl: seq<AI.Thread>,
                              ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |vl| == 0)
    || (|tl| > 0 && |vl| > 0
        && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, tl[0].0, tl[0].1, vl[0],
                       ncap, nlook, nquant)
        && ActiveRepLk(rer, qm, re, code, inp, crv, str, ov, S, tl[1..], vl[1..],
                       ncap, nlook, nquant))
  }

  /** Blocked lists pair through the SAME matching filter as the existing sim
      (landmine 3): RegElk blocks unconditionally, the tree machine only blocks
      `Read` trees, and `PIV.MatchingBlocked` realigns them — char checks are
      gate-free, so the verdicts transfer verbatim. The B-side blocked tree is
      the post-`Read` continuation at `nextinp` with the flag re-armed, exactly
      `BlockedRepRE`'s shape with `TtLk` in place of `TreeThreadRE`. */
  ghost predicate BlockedRepLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                               inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                               ov: LOr.OracleView, S: set<LG.GroupId>,
                               tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                               ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |bl| == 0)
    || (|tl| > 0 && |bl| > 0
        && bl[0].0.pc >= 0
        && TtLk(rer, qm, code, nextinp, tl[0].0, (bl[0].0.pc + 1) as nat, true)
        && GmtTieOutside(re, bl[0].0, tl[0].1, S)
        && GmtTieInside(crv, str, ov, bl[0].0, tl[0].1, S, ncap, nlook, nquant)
        && BlockedRepLk(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                        ncap, nlook, nquant))
  }

  /** (L4 NESTED) The blocked-list pairing with the depth-1-hardwired
      `GmtTieInside` conjunct DROPPED (see `ThreadRepLkNested`). The blocked-tie
      filter (`TtLk` at `pc+1`) and the outside value tie are kept verbatim. */
  ghost predicate BlockedRepLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                     inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                                     ov: LOr.OracleView, S: set<LG.GroupId>,
                                     tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                                     ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |bl| == 0)
    || (|tl| > 0 && |bl| > 0
        && bl[0].0.pc >= 0
        && TtLk(rer, qm, code, nextinp, tl[0].0, (bl[0].0.pc + 1) as nat, true)
        && GmtTieOutside(re, bl[0].0, tl[0].1, S)
        && BlockedRepLkNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                              ncap, nlook, nquant))
  }

  /** Best-match tie: `None` together, or the recorded B leaf carries the
      winning thread's values on both sides of `S`. */
  ghost predicate BestTieLk(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                            S: set<LG.GroupId>, bbest: Option<LT.Leaf>, bm: Option<AI.Thread>,
                            ncap: int, nlook: int, nquant: int) {
    (bbest.None? <==> bm.None?)
    && (bbest.Some? ==>
          bm.Some?
          && GmtTieOutside(re, bm.value, bbest.value.1, S)
          && GmtTieInside(crv, str, ov, bm.value, bbest.value.1, S, ncap, nlook, nquant)
          // (E3) the winning thread carries the look-path facts for every lid
          // owning a leaf-present inside-S group — the (E) PathPresentLk feed.
          && LookNestOkT(re, S, bbest.value.1, bm.value)
          // (E4) the CONVERSE: dominance-surviving fresh-match groups are in
          // the leaf — the reverse value tie's feed.
          && LookNestBackT(re, crv, str, ov, S, bbest.value.1, bm.value, ncap, nlook, nquant))
  }

  /** (D3) `BestTieLkNested` with the two look-path carriers restricted to
      TOP-LEVEL looks (`*Top` variants). Consumed ONLY by the `*Rec` tier
      (`LiftInvRec`, `L3aCompositeCloseRec`) — leaves the depth-1/`Nested`
      tiers' `BestTieLkNested` untouched. */
  ghost predicate BestTieLkNestedTop(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                  S: set<LG.GroupId>, bbest: Option<LT.Leaf>, bm: Option<AI.Thread>,
                                  ncap: int, nlook: int, nquant: int) {
    (bbest.None? <==> bm.None?)
    && (bbest.Some? ==>
          bm.Some?
          && GmtTieOutside(re, bm.value, bbest.value.1, S)
          && LookNestOkTTop(re, S, bbest.value.1, bm.value)
          && LookNestBackTTop(re, crv, str, ov, S, bbest.value.1, bm.value, ncap, nlook, nquant))
  }

  /** (L4 NESTED) The best-match tie with the depth-1-hardwired `GmtTieInside`
      conjunct DROPPED (see `ThreadRepLkNested`). The outside value tie and BOTH
      look-path carriers (`LookNestOkT` (E3), `LookNestBackT` (E4)) are kept
      verbatim — those are already stated over the depth-general ownership
      machinery. */
  ghost predicate BestTieLkNested(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                  S: set<LG.GroupId>, bbest: Option<LT.Leaf>, bm: Option<AI.Thread>,
                                  ncap: int, nlook: int, nquant: int) {
    (bbest.None? <==> bm.None?)
    && (bbest.Some? ==>
          bm.Some?
          && GmtTieOutside(re, bm.value, bbest.value.1, S)
          && LookNestOkT(re, S, bbest.value.1, bm.value)
          && LookNestBackT(re, crv, str, ov, S, bbest.value.1, bm.value, ncap, nlook, nquant))
  }

  // ==========================================================================
  // L4 depth-k RECURSIVE walk tower (brick C3.6). The `WalkPairLk`/`TtLk` family
  // and its `ThreadRepLk*`/`BlockedRepLk*`/`LiftInv*` clients rebuilt on the
  // RECURSIVE action predicate `EL.PikeLkActionsRec` (EntryLk.dfy:785) in place
  // of the depth-1 `EL.PikeLkActions`. NOTE: `EL.BoolTreeLk` is SHARED — there is
  // NO `BoolTreeLkRec`; `EL.ComputeBoolTreeLkRec` also ensures `EL.BoolTreeLk`,
  // so the ONLY leaf-arm change is `PikeLkActions -> PikeLkActionsRec`. The
  // BeginLoop/SetQuant see-through arms, `GateAheadClear`, and `WalkDefsOk` are
  // verbatim. Everything above `WalkPairLk`'s leaf arm (the `*Nested` tier, which
  // drops `GmtTieInside`) is what these `*Rec` clones mirror.
  // ==========================================================================

  /** `TtLk` rebuilt on `EL.PikeLkActionsRec` (recursive fragment). */
  ghost predicate TtLkRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          tb: LT.Tree, pc: nat, ea: bool)
    decreases RB.size(code) - pc
  {
    (pc < RB.size(code) && NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
     && TtLkRec(rer, qm, code, inp, tb, pc + 1, false))
    || (pc < RB.size(code)
        && exists q: int ::
             NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
             && q in qm.quants
             && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
             && TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ea))
    || (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActionsRec(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb))
  }

  /** `WalkPairLk` rebuilt on `EL.PikeLkActionsRec` (recursive fragment). */
  ghost predicate WalkPairLkRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                tb: LT.Tree, gmt: LG.GroupMap, pc: nat, ea: bool)
    decreases RB.size(code) - pc
  {
    (pc < RB.size(code) && NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
     && WalkPairLkRec(rer, qm, code, inp, tb, gmt, pc + 1, false))
    || (pc < RB.size(code)
        && exists q: int ::
             NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
             && q in qm.quants
             && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
             && WalkPairLkRec(rer, qm, code, inp, tb.t,
                              LG.GMUpdate(tb.g, LC.Idx(inp), gmt), pc + 1, ea))
    || (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActionsRec(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb)
          && GateAheadClear(acts, gmt)
          && WalkDefsOk(acts))
  }

  /** `ThreadRepLkNested` (the `GmtTieInside`-free per-thread tie) on
      `WalkPairLkRec`. */
  ghost predicate ThreadRepLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                 inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                 S: set<LG.GroupId>, tb: LT.Tree, gmt: LG.GroupMap, th: AI.Thread,
                                 ncap: int, nlook: int, nquant: int) {
    th.pc >= 0
    && WalkPairLkRec(rer, qm, code, inp, tb, gmt, th.pc as nat, th.exit_allowed)
    && GmtTieOutside(re, th, gmt, S)
  }

  /** `BlockedRepLkNested` on `TtLkRec`. */
  ghost predicate BlockedRepLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                  inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                                  ov: LOr.OracleView, S: set<LG.GroupId>,
                                  tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                                  ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |bl| == 0)
    || (|tl| > 0 && |bl| > 0
        && bl[0].0.pc >= 0
        && TtLkRec(rer, qm, code, nextinp, tl[0].0, (bl[0].0.pc + 1) as nat, true)
        && GmtTieOutside(re, bl[0].0, tl[0].1, S)
        && BlockedRepLkRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                           ncap, nlook, nquant))
  }

  /** `ThreadRepLkCNested` riding `ThreadRepLkRec`. */
  ghost predicate ThreadRepLkCRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                  inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                  S: set<LG.GroupId>, tcan: LT.Tree, gmt: LG.GroupMap, th: AI.Thread,
                                  ncap: int, nlook: int, nquant: int) {
    th.pc >= 0
    && TreeRepLkRE(rer, qm, code, inp, tcan, th.pc as nat, th.exit_allowed)
    && exists traw: LT.Tree ::
         CE.ProgErase(traw) == CE.ProgErase(tcan)
         && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gmt, th, ncap, nlook, nquant)
  }

  /** `ActiveRepLkCNested` riding `ThreadRepLkCRec`. */
  ghost predicate ActiveRepLkCRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                  inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                  S: set<LG.GroupId>, tl: seq<(LT.Tree, LG.GroupMap)>, vl: seq<AI.Thread>,
                                  ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |vl| == 0)
    || (|tl| > 0 && |vl| > 0
        && ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, tl[0].0, tl[0].1, vl[0],
                           ncap, nlook, nquant)
        && ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, tl[1..], vl[1..],
                           ncap, nlook, nquant))
  }

  /** `BlockedRepLkCNested` with its raw erasure witness on `WalkPairLkRec`. */
  ghost predicate BlockedRepLkCRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                   inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                                   ov: LOr.OracleView, S: set<LG.GroupId>,
                                   tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                                   ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |bl| == 0)
    || (|tl| > 0 && |bl| > 0
        && bl[0].0.pc >= 0
        && TreeRepLkRE(rer, qm, code, nextinp, tl[0].0, (bl[0].0.pc + 1) as nat, true)
        && (exists traw: LT.Tree ::
              CE.ProgErase(traw) == CE.ProgErase(tl[0].0)
              && WalkPairLkRec(rer, qm, code, nextinp, traw, tl[0].1, (bl[0].0.pc + 1) as nat, true))
        && GmtTieOutside(re, bl[0].0, tl[0].1, S)
        && BlockedRepLkCRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                            ncap, nlook, nquant))
  }

  /** `LiftInvNested` on the `*Rec` pairings (`ActiveRepLkCRec`,
      `BlockedRepLkCRec`, `BestTieLkNested`). (D3) The look-path carriers are the
      TOP-LEVEL-restricted `*Top` variants: at a nested gate only the top-level
      gate lid is stamped, so the inner-lid obligations of the full carriers are
      unsatisfiable at depth >= 2. Confined to the `*Rec` tier (the depth-1/`Nested`
      `LiftInv`/`LiftInvNested` keep the full carriers). */
  ghost predicate LiftInvRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                          crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                          bst: PT.PikeTreeState, vms: AI.VmState,
                          ncap: int, nlook: int, nquant: int) {
    match bst
    case PTS_final(bbest) => BestTieLkNestedTop(re, crv, str, ov, S, bbest, vms.bestmatch, ncap, nlook, nquant)
    case PTS(inp, bactive, bbest, bblocked, bseen) =>
      0 <= vms.cp <= |str|
      && inp == PIV.InpOfCp(str, vms.cp)
      && PIV.ContextOkRE(str, vms.cp, vms.context)
      && ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, bactive, vms.active, ncap, nlook, nquant)
      && (forall nextinp :: LC.AdvanceInput(inp, WP.Forward) == Some(nextinp) ==>
            BlockedRepLkCRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, bblocked,
                          PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant))
      && (LC.AdvanceInput(inp, WP.Forward) == None ==> bblocked == [])
      && LookNestRepCTop(re, S, bactive, vms.active)
      && (LC.AdvanceInput(inp, WP.Forward).Some? ==>
            LookNestRepBTop(re, S, bblocked, PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp)))
      && LookNestBackRepCTop(re, crv, str, ov, S, bactive, vms.active, ncap, nlook, nquant)
      && (LC.AdvanceInput(inp, WP.Forward).Some? ==>
            LookNestBackRepBTop(re, crv, str, ov, S, bblocked,
                             PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant))
      && BestTieLkNestedTop(re, crv, str, ov, S, bbest, vms.bestmatch, ncap, nlook, nquant)
      && SeenRepLk(rer, qm, code, inp, bseen, vms.processed,
                   PIV.HdTreeOf(bactive), PIV.HeadPcOf(vms.active))
      && IsblockedRepLk(rer, qm, code, inp, bseen, vms.isblocked)
      && LL.OracleOkSuffix(rer, qm, inp)
  }

  /** `LiftInvCNested` carrying the standalone `LiftInvRec`. */
  ghost predicate LiftInvCRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                           endl: nat, ngroups: nat, crv: CP.FCompiled, str: string,
                           ov: LOr.OracleView, S: set<LG.GroupId>,
                           ptsA: PT.PikeTreeState, ptsB: PT.PikeTreeState, vms: AI.VmState,
                           ncap: int, nlook: int, nquant: int)
    requires NR.NfaRepRE(re, code, 0, endl)
  {
    PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, vms, ncap, nlook, nquant)
    && (ptsB.PTS? ==> ptsA.PTS? && ptsA.inp == ptsB.inp)
    && LiftInvRec(rer, qm, re, code, crv, str, ov, S, ptsB, vms, ncap, nlook, nquant)
  }

  /** processed ↔ seen pairing (landmine 2) — the ONE obligation genuinely
      shared with the old sim's structure. Mirrors `PIV.SeenInclusionRE`: every
      processed `(pc, b)` has its B-tree in `seen`, with the same stutter-chain
      escape hatch for the head being processed.

      RE-KEYED on the PLANTED CANONICAL form (2026-08-07): machine B runs the
      `TreeRepLkRE`-canonical trees, which are UNIQUE per `(pc, b)`
      (`TreeRepLkDetermRE`) — so a processed slot's recorded tree EQUALS any
      later head canonical at the same `(pc, b)`, and `LiftStepC`'s skip case
      closes: VM skips on `bpc_mem` ⟹ head tree is `Inseen` ⟹ `pts_skip`. */
  ghost predicate SeenRepLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                            treeseen: SS.SeenTrees, processed: AI.Bpcset,
                            current: Option<LT.Tree>, currentpc: nat) {
    // Verbatim mirror of `PIV.SeenInclusionRE` with `TreeRepLkRE` in place of
    // `TT.TreeThreadRE`: every processed `(pc, b)` either has its canonical
    // B-tree recorded in `treeseen`, or it is a gate/loop STUTTER whose chain
    // reaches the head currently being processed (`current` at `currentpc`).
    forall pc: nat, b: bool :: AI.bpc_mem(processed, pc, b) ==>
      (exists t: LT.Tree :: SS.Inseen(treeseen, t) && TreeRepLkRE(rer, qm, code, inp, t, pc, b))
      || (TT.StuttersRE(pc, code)
          && exists t: LT.Tree ::
               PIV.StutterChainTo(code, pc, currentpc) && current == Some(t)
               && TreeRepLkRE(rer, qm, code, inp, t, pc, b))
  }

  /** The `isblocked` dedup pairing — mirror of `PSM.IsblockedInclusionRE`
      with the canonical `TreeRepLkRE`: every pc the VM has already blocked
      this phase has its canonical tree memoized, so the `Consume`-dedup drop
      is a B `pts_skip` (at a `Consume` pc the canonical rule is
      flag-independent, so the recorded `b` transfers to the head's). */
  ghost predicate IsblockedRepLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code,
                                 inp: LC.Input, treeseen: SS.SeenTrees, isblocked: AI.pcset)
  {
    forall pc0: nat :: AI.pc_mem(isblocked, pc0) ==>
      exists t: LT.Tree, b: bool ::
        SS.Inseen(treeseen, t) && TreeRepLkRE(rer, qm, code, inp, t, pc0, b)
  }

  /** THE LIFT INVARIANT: the B state pairs with the VM state. Mirrors
      `PIV.PikeInvRE`'s shape with the B-side (t-based, value-carrying)
      relations. `PTS_final` pairs through `BestTieLk` alone.

      RE-KEYED on the PLANTED CANONICAL pairing (2026-08-07): machine B runs
      the `TreeRepLkRE`-canonical trees; `ActiveRepLkC`/`BlockedRepLkC` carry
      the canonical tie per head plus the value layer through the raw
      erasure-witness (see the §(c′) header before `ThreadRepLkC`). */
  ghost predicate LiftInv(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                          crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                          bst: PT.PikeTreeState, vms: AI.VmState,
                          ncap: int, nlook: int, nquant: int) {
    match bst
    case PTS_final(bbest) => BestTieLk(re, crv, str, ov, S, bbest, vms.bestmatch, ncap, nlook, nquant)
    case PTS(inp, bactive, bbest, bblocked, bseen) =>
      0 <= vms.cp <= |str|
      && inp == PIV.InpOfCp(str, vms.cp)
      && PIV.ContextOkRE(str, vms.cp, vms.context)   // aligns VM anchor/char reads with the position
      && ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, bactive, vms.active, ncap, nlook, nquant)
      && (forall nextinp :: LC.AdvanceInput(inp, WP.Forward) == Some(nextinp) ==>
            BlockedRepLkC(rer, qm, re, code, inp, nextinp, crv, str, ov, S, bblocked,
                          PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant))
      && (LC.AdvanceInput(inp, WP.Forward) == None ==> bblocked == [])
      // (E3) the look-path carrier, index-wise over both pairings
      && LookNestRepC(re, S, bactive, vms.active)
      && (LC.AdvanceInput(inp, WP.Forward).Some? ==>
            LookNestRepB(re, S, bblocked, PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp)))
      // (E4) the converse carrier, same pairings
      && LookNestBackRepC(re, crv, str, ov, S, bactive, vms.active, ncap, nlook, nquant)
      && (LC.AdvanceInput(inp, WP.Forward).Some? ==>
            LookNestBackRepB(re, crv, str, ov, S, bblocked,
                             PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant))
      && BestTieLk(re, crv, str, ov, S, bbest, vms.bestmatch, ncap, nlook, nquant)
      && SeenRepLk(rer, qm, code, inp, bseen, vms.processed,
                   PIV.HdTreeOf(bactive), PIV.HeadPcOf(vms.active))
      && IsblockedRepLk(rer, qm, code, inp, bseen, vms.isblocked)
      // the gate helpers read the oracle column at the current input; the
      // walk carries this (OracleOkSuffixStep advances it with cp)
      && LL.OracleOkSuffix(rer, qm, inp)
  }

  /** (L4 NESTED) The standalone lift invariant with the `GmtTieInside`-carrying
      pairings swapped for their `*Nested` forms (`ActiveRepLkCNested`,
      `BlockedRepLkCNested`, `BestTieLkNested`). Every other conjunct — the (E3)
      `LookNest*` carriers, the (E4) `LookNestBack*` carriers, the seen/isblocked
      bookkeeping, the oracle suffix — is depth-agnostic and kept verbatim. */
  ghost predicate LiftInvNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                          crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                          bst: PT.PikeTreeState, vms: AI.VmState,
                          ncap: int, nlook: int, nquant: int) {
    match bst
    case PTS_final(bbest) => BestTieLkNested(re, crv, str, ov, S, bbest, vms.bestmatch, ncap, nlook, nquant)
    case PTS(inp, bactive, bbest, bblocked, bseen) =>
      0 <= vms.cp <= |str|
      && inp == PIV.InpOfCp(str, vms.cp)
      && PIV.ContextOkRE(str, vms.cp, vms.context)   // aligns VM anchor/char reads with the position
      && ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, bactive, vms.active, ncap, nlook, nquant)
      && (forall nextinp :: LC.AdvanceInput(inp, WP.Forward) == Some(nextinp) ==>
            BlockedRepLkCNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, bblocked,
                          PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant))
      && (LC.AdvanceInput(inp, WP.Forward) == None ==> bblocked == [])
      // (E3) the look-path carrier, index-wise over both pairings
      && LookNestRepC(re, S, bactive, vms.active)
      && (LC.AdvanceInput(inp, WP.Forward).Some? ==>
            LookNestRepB(re, S, bblocked, PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp)))
      // (E4) the converse carrier, same pairings
      && LookNestBackRepC(re, crv, str, ov, S, bactive, vms.active, ncap, nlook, nquant)
      && (LC.AdvanceInput(inp, WP.Forward).Some? ==>
            LookNestBackRepB(re, crv, str, ov, S, bblocked,
                             PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant))
      && BestTieLkNested(re, crv, str, ov, S, bbest, vms.bestmatch, ncap, nlook, nquant)
      && SeenRepLk(rer, qm, code, inp, bseen, vms.processed,
                   PIV.HdTreeOf(bactive), PIV.HeadPcOf(vms.active))
      && IsblockedRepLk(rer, qm, code, inp, bseen, vms.isblocked)
      // the gate helpers read the oracle column at the current input; the
      // walk carries this (OracleOkSuffixStep advances it with cp)
      && LL.OracleOkSuffix(rer, qm, inp)
  }

  // ---- seen-tracking bricks (mirror PIV's SeenInclusion bookkeeping) ---------

  /** Initial state satisfies `SeenRepLk` vacuously (`init_bpcset` is all-false,
      so no `(pc, b)` is processed). Mirror of `PIV.InitialInclusionRE`. Feeds the
      `LiftInitC`/`L3aCompositeClose` entry (`bseen == SS.InitialSeenTrees`). */
  lemma InitialSeenRepLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         current: Option<LT.Tree>, currentpc: nat, n: int)
    ensures SeenRepLk(rer, qm, code, inp, SS.InitialSeenTrees, AI.init_bpcset(n), current, currentpc)
  {
    forall pc: nat, b: bool | AI.bpc_mem(AI.init_bpcset(n), pc, b)
      ensures false
    { }
  }

  /** After memoizing the current tree `t` at `(pc, b)`, `SeenRepLk` still holds —
      every entry resolves to the LEFT (seen-tree) disjunct. Mirror of
      `PIV.AddInclusionRE`. Used at B's pts_active/pts_match/pts_blocked steps
      (each does `SS.AddSeenTrees(seen, active[0].0)` on the just-processed head). */
  lemma AddSeenRepLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                     treeseen: SS.SeenTrees, processed: AI.Bpcset, t: LT.Tree, pc: nat, b: bool,
                     nextcurrent: Option<LT.Tree>, nextpc: nat)
    requires SeenRepLk(rer, qm, code, inp, treeseen, processed, Some(t), pc)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    ensures SeenRepLk(rer, qm, code, inp, SS.AddSeenTrees(treeseen, t),
                      AI.bpc_add(processed, pc, b), nextcurrent, nextpc)
  {
    forall pc0: nat, b0: bool | AI.bpc_mem(AI.bpc_add(processed, pc, b), pc0, b0)
      ensures (exists t': LT.Tree :: SS.Inseen(SS.AddSeenTrees(treeseen, t), t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
           || (TT.StuttersRE(pc0, code) && exists t': LT.Tree ::
                 PIV.StutterChainTo(code, pc0, nextpc) && nextcurrent == Some(t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
    {
      PIV.BpcAddMemFwd(processed, pc, b, pc0, b0);
      if pc0 == pc && b0 == b {
        SS.InAdd(treeseen, t, t);            // Inseen(AddSeenTrees(treeseen, t), t)
      } else {
        assert AI.bpc_mem(processed, pc0, b0);
        if exists t': LT.Tree :: SS.Inseen(treeseen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0) {
          var t': LT.Tree :| SS.Inseen(treeseen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0);
          SS.InAdd(treeseen, t', t);
        } else {
          // right disjunct at (pc0,b0): current == Some(t) forces the witness to be
          // t, now memoized ⟹ new LEFT disjunct.
          var t': LT.Tree :| TT.StuttersRE(pc0, code) && PIV.StutterChainTo(code, pc0, pc)
            && Some(t) == Some(t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0);
          SS.InAdd(treeseen, t', t);
        }
      }
    }
  }

  /** Growing only the seen set (no new processed slot) preserves `SeenRepLk`:
      LEFT witnesses survive the add, the stutter disjunct is untouched. Mirror of
      `PIV.SeenGrowInclusionRE` (B's do-while fork memoizes a second tree). */
  lemma SeenGrowSeenRepLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          treeseen: SS.SeenTrees, processed: AI.Bpcset, extra: LT.Tree,
                          current: Option<LT.Tree>, currentpc: nat)
    requires SeenRepLk(rer, qm, code, inp, treeseen, processed, current, currentpc)
    ensures SeenRepLk(rer, qm, code, inp, SS.AddSeenTrees(treeseen, extra),
                      processed, current, currentpc)
  {
    forall pc0: nat, b0: bool | AI.bpc_mem(processed, pc0, b0)
      ensures (exists t': LT.Tree :: SS.Inseen(SS.AddSeenTrees(treeseen, extra), t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
           || (TT.StuttersRE(pc0, code) && exists t': LT.Tree ::
                 PIV.StutterChainTo(code, pc0, currentpc) && current == Some(t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
    {
      if exists t': LT.Tree :: SS.Inseen(treeseen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0) {
        var t': LT.Tree :| SS.Inseen(treeseen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0);
        SS.InAdd(treeseen, t', extra);
      }
    }
  }

  /** Skipping an already-seen tree leaves `SeenRepLk` intact (the stutter
      disjunct promotes to LEFT since the tree is already memoized), advancing the
      head pointer. Mirror of `PIV.SkipInclusionRE` — B's `pts_skip` case. */
  lemma SkipSeenRepLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                      treeseen: SS.SeenTrees, processed: AI.Bpcset, tree: LT.Tree, currentpc: nat,
                      current: Option<LT.Tree>, nextpc: nat)
    requires SeenRepLk(rer, qm, code, inp, treeseen, processed, Some(tree), currentpc)
    requires SS.Inseen(treeseen, tree)
    ensures SeenRepLk(rer, qm, code, inp, treeseen, processed, current, nextpc)
  {
    forall pc0: nat, b0: bool | AI.bpc_mem(processed, pc0, b0)
      ensures (exists t': LT.Tree :: SS.Inseen(treeseen, t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
           || (TT.StuttersRE(pc0, code) && exists t': LT.Tree ::
                 PIV.StutterChainTo(code, pc0, nextpc) && current == Some(t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
    {
      if exists t': LT.Tree :: SS.Inseen(treeseen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0) {
      } else {
        var t': LT.Tree :| TT.StuttersRE(pc0, code) && PIV.StutterChainTo(code, pc0, currentpc)
          && Some(tree) == Some(t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0);
        assert SS.Inseen(treeseen, t');   // t' == tree, already seen
      }
    }
  }

  /** Marking a slot processed whose tree is ALREADY memoized (B skips, seen
      unchanged): the new slot resolves LEFT with the head itself; old escape
      entries promote to LEFT since their witness (the head) is seen. The
      `Consume`-dedup drop's seen brick. */
  lemma SeenAddProcessedSlotRepLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                  treeseen: SS.SeenTrees, processed: AI.Bpcset, t: LT.Tree,
                                  pc: nat, b: bool, current: Option<LT.Tree>, nextpc: nat)
    requires SeenRepLk(rer, qm, code, inp, treeseen, processed, Some(t), pc)
    requires SS.Inseen(treeseen, t)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    ensures SeenRepLk(rer, qm, code, inp, treeseen, AI.bpc_add(processed, pc, b), current, nextpc)
  {
    forall pc0: nat, b0: bool | AI.bpc_mem(AI.bpc_add(processed, pc, b), pc0, b0)
      ensures (exists t': LT.Tree :: SS.Inseen(treeseen, t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
           || (TT.StuttersRE(pc0, code) && exists t': LT.Tree ::
                 PIV.StutterChainTo(code, pc0, nextpc) && current == Some(t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
    {
      PIV.BpcAddMemFwd(processed, pc, b, pc0, b0);
      if pc0 == pc && b0 == b {
        // LEFT with the head itself — already memoized.
      } else {
        assert AI.bpc_mem(processed, pc0, b0);
        if exists t': LT.Tree :: SS.Inseen(treeseen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0) {
        } else {
          var t': LT.Tree :| TT.StuttersRE(pc0, code) && PIV.StutterChainTo(code, pc0, pc)
            && Some(t) == Some(t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0);
          assert SS.Inseen(treeseen, t');   // t' == t, already seen ⟹ LEFT
        }
      }
    }
  }

  /** Processing a STUTTER pc (Jmp/BeginLoop — B does not step, nothing is
      memoized): the new processed slot resolves to the stutter escape hatch,
      whose chain extends by the one stutter step to the head's new pc.
      Mirror of `PIV.StutterInclusionRE`. */
  lemma StutterSeenRepLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         treeseen: SS.SeenTrees, processed: AI.Bpcset, t: LT.Tree, pc: nat, b: bool,
                         nextpc: nat)
    requires PIV.StutterSuccIs(code, pc, nextpc)
    requires SeenRepLk(rer, qm, code, inp, treeseen, processed, Some(t), pc)
    requires TT.StuttersRE(pc, code)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    ensures SeenRepLk(rer, qm, code, inp, treeseen, AI.bpc_add(processed, pc, b), Some(t), nextpc)
  {
    forall pc0: nat, b0: bool | AI.bpc_mem(AI.bpc_add(processed, pc, b), pc0, b0)
      ensures (exists t': LT.Tree :: SS.Inseen(treeseen, t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
           || (TT.StuttersRE(pc0, code) && exists t': LT.Tree ::
                 PIV.StutterChainTo(code, pc0, nextpc) && Some(t) == Some(t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0))
    {
      PIV.BpcAddMemFwd(processed, pc, b, pc0, b0);
      if pc0 == pc && b0 == b {
        // RIGHT disjunct: the just-stuttered head, one step from nextpc.
        assert PIV.StutterChainTo(code, pc, nextpc);   // base: StutterSuccIs(code, pc, nextpc)
      } else {
        assert AI.bpc_mem(processed, pc0, b0);
        if exists t': LT.Tree :: SS.Inseen(treeseen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0) {
        } else {
          var t': LT.Tree :| TT.StuttersRE(pc0, code) && PIV.StutterChainTo(code, pc0, pc)
            && Some(t) == Some(t') && TreeRepLkRE(rer, qm, code, inp, t', pc0, b0);
          PIV.StutterChainExtend(code, pc0, pc, nextpc);   // StutterChainTo(code, pc0, nextpc)
        }
      }
    }
  }

  // ==========================================================================
  // THE FILLER'S WORKLIST — bodiless lemmas, in fill order.
  // ==========================================================================

  /** PER-ACTS functional determinism: `BoolTreeLk` is a function of
      `(acts, inp, b)`. Every head pins the tree's shape and recurses; the gate
      case is closed by `LkGateOk` pinning `tlk == ComputeTr(...)` (so both
      bodies agree) and the verdict `LkResult(...).Some?` being single-valued
      (so both take the same `LK`/`LKFail` branch). */
  least lemma BoolTreeLkDeterm(rer: LW.RegExpRecord, acts: LS.Actions, inp: LC.Input,
                               b: BS.LoopBool, t1: LT.Tree, t2: LT.Tree)
    requires EL.BoolTreeLk(rer, acts, inp, b, t1)
    requires EL.BoolTreeLk(rer, acts, inp, b, t2)
    ensures t1 == t2
  {
    if |acts| == 0 {
    } else {
      var cont := acts[1..];
      match acts[0]
      case Acheck(strcheck) =>
        if b == BS.CanExit {
          match t1 { case Progress(c1) => match t2 { case Progress(c2) =>
            BoolTreeLkDeterm(rer, cont, inp, BS.CanExit, c1, c2); case _ => } case _ => }
        }
      case Aclose(gid) =>
        match t1 { case GroupActionT(g1, c1) => match t2 { case GroupActionT(g2, c2) =>
          BoolTreeLkDeterm(rer, cont, inp, b, c1, c2); case _ => } case _ => }
      case Areg(r) =>
        match r
        case Epsilon => BoolTreeLkDeterm(rer, cont, inp, b, t1, t2);
        case Character(cd) =>
          match LC.ReadChar(rer, cd, inp, WP.Forward) {
            case None =>
            case Some(pair) =>
              match t1 { case Read(cc1, c1) => match t2 { case Read(cc2, c2) =>
                BoolTreeLkDeterm(rer, cont, pair.1, BS.CanExit, c1, c2); case _ => } case _ => }
          }
        case Disjunction(r1, r2) =>
          match t1 { case Choice(a1, b1t) => match t2 { case Choice(a2, b2t) =>
            BoolTreeLkDeterm(rer, [LS.Areg(r1)] + cont, inp, b, a1, a2);
            BoolTreeLkDeterm(rer, [LS.Areg(r2)] + cont, inp, b, b1t, b2t); case _ => } case _ => }
        case Sequence(r1, r2) =>
          BoolTreeLkDeterm(rer, [LS.Areg(r1), LS.Areg(r2)] + cont, inp, b, t1, t2);
        case Quantified(greedy, min, delta, r1) =>
          var gidl := L.DefGroups(r1);
          if min > 0 {
            var q1 := L.Quantified(greedy, min - 1, delta, r1);
            match t1 { case GroupActionT(g1, c1) => match t2 { case GroupActionT(g2, c2) =>
              BoolTreeLkDeterm(rer, [LS.Areg(r1), LS.Areg(q1)] + cont, inp, b, c1, c2); case _ => } case _ => }
          } else if delta == LN.NN(0) {
            BoolTreeLkDeterm(rer, cont, inp, b, t1, t2);
          } else {
            var qn := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
            var iacts := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(qn)] + cont;
            match t1 {
              case Choice(a1, b1t) =>
                match t2 {
                  case Choice(a2, b2t) =>
                    var it1 := if greedy then a1 else b1t;  var sk1 := if greedy then b1t else a1;
                    var it2 := if greedy then a2 else b2t;  var sk2 := if greedy then b2t else a2;
                    match it1 {
                      case GroupActionT(g1, ti1) =>
                        match it2 {
                          case GroupActionT(g2, ti2) =>
                            BoolTreeLkDeterm(rer, iacts, inp, BS.CannotExit, ti1, ti2);
                            BoolTreeLkDeterm(rer, cont, inp, b, sk1, sk2);
                          case _ =>
                        }
                      case _ =>
                    }
                  case _ =>
                }
              case _ =>
            }
          }
        case Group(gid, r1) =>
          match t1 { case GroupActionT(g1, c1) => match t2 { case GroupActionT(g2, c2) =>
            BoolTreeLkDeterm(rer, [LS.Areg(r1), LS.Aclose(gid)] + cont, inp, b, c1, c2); case _ => } case _ => }
        case AnchorR(a) =>
          if LS.AnchorSatisfied(rer, a, inp) {
            match t1 { case AnchorPass(a1, c1) => match t2 { case AnchorPass(a2, c2) =>
              BoolTreeLkDeterm(rer, cont, inp, b, c1, c2); case _ => } case _ => }
          }
        case LookaroundR(lk, r1) =>
          // LkGateOk pins tlk == ComputeTr(rer,[Areg(r1)],inp,Empty,LkDir(lk)) on BOTH
          // sides; its verdict LkResult(lk,tlk,Empty,inp).Some? is single-valued.
          var tlkc := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
          match t1 {
            case LK(l1, k1, c1) =>
              assert k1 == tlkc;
              match t2 {
                case LK(l2, k2, c2) =>
                  assert k2 == tlkc;
                  BoolTreeLkDeterm(rer, cont, inp, b, c1, c2);
                case LKFail(l2, k2) =>
                  assert k2 == tlkc;   // both verdicts read LkResult(lk,tlkc,Empty,inp).Some?
                  assert false;
                case _ =>
              }
            case LKFail(l1, k1) =>
              assert k1 == tlkc;
              match t2 {
                case LK(l2, k2, c2) => assert k2 == tlkc; assert false;
                case LKFail(l2, k2) => assert k2 == tlkc;
                case _ =>
              }
            case _ =>
          }
        case Backreference(_) =>
    }
  }

  // ==========================================================================
  // ERASED-CANONICAL LK TREES — the determinism layer for the seen/skip pairing.
  //
  // WHY (2026-08-05): `TtLkSameTree` as originally stated is FALSE. At a
  // do-while's backward fork BOTH `[Areg(star)]+cont` (the loop-view `NfaRepL`
  // disjunct) and `[Acheck(s), Areg(star)]+cont` (`ActionRepL`'s zero-width
  // Acheck at a `BackForkAt` pc, strcheck unconstrained) are
  // `ActionsRepL`-representable at the same pc, and their `BoolTreeLk` trees
  // differ by exactly a `Progress` wrapper — the per-`(pc, ea)` tree is NOT
  // unique. This is real machine behavior, not a proof artifact: in `(a+)+` a
  // first-outer-iteration thread and a re-entered thread reach the same inner
  // fork in the same ε-phase carrying trees that differ by a planted
  // `Progress`, so B's exact-tree-keyed `pts_skip` cannot fire where the VM's
  // `(pc, ea)`-keyed skip does. Machine-A canonicalized by PLANTING the guard
  // (`ActionsTreeRepFRE`'s tr_plus construction) and running the machine on
  // canonical `TreeRepRE` trees; machine B runs the RAW spec tree, so the fix
  // here is the QUOTIENT: `Progress` is leaf-transparent
  // (`TreeLeaves(Progress(t)) == TreeLeaves(t)`, Tree.dfy), so erase it —
  // key B's memoization on `ProgErase`d trees and prove walk confluence
  // MODULO erasure. `ETreeRepLk` is the erased canonical form: a least
  // predicate keyed on `(code, pc, inp, b)` alone (mirror of `TR.TreeRepRE`
  // with LK/LKFail nodes KEPT at the gates, pinned functionally by
  // `ComputeTr`/`LkResult`, and the two Progress-producing rules turned into
  // stutters). Its determinism (`ETreeRepLkDeterm`) is a least lemma —
  // termination by ordinal induction, no hand-rolled measure.
  // ==========================================================================

  // `ProgErase` (the quotient map — erase every `Progress` guard) lives in
  // `CE` (CheckErase.dfy) beside `PSize`/`BoolCheckInsert`, whose strengthened
  // ensures `CE.ProgErase(tstar) == CE.ProgErase(t)` records that check insertion is
  // the IDENTITY on erased trees.

  /** `Progress` is leaf-transparent, so erasure preserves the leaf sequence —
      the fact that keeps an erased seen-key SOUND for first-leaf memoization
      (skipping a tree whose erasure was already processed skips equal
      leaves). */
  lemma ProgEraseLeavesEq(t: LT.Tree, gm: LG.GroupMap, inp: LC.Input, dir: WP.Direction)
    ensures LT.TreeLeaves(CE.ProgErase(t), gm, inp, dir) == LT.TreeLeaves(t, gm, inp, dir)
    decreases t
  {
    match t
    case Mismatch =>
    case Match =>
    case Choice(t1, t2) =>
      ProgEraseLeavesEq(t1, gm, inp, dir);
      ProgEraseLeavesEq(t2, gm, inp, dir);
    case Read(c, t1) =>
      ProgEraseLeavesEq(t1, gm, LC.AdvanceInputP(inp, dir), dir);
    case ReadBackRef(s, t1) =>
      ProgEraseLeavesEq(t1, gm, LC.AdvanceInputN(inp, |s|, dir), dir);
    case Progress(t1) =>
      ProgEraseLeavesEq(t1, gm, inp, dir);
    case AnchorPass(a, t1) =>
      ProgEraseLeavesEq(t1, gm, inp, dir);
    case GroupActionT(g, t1) =>
      ProgEraseLeavesEq(t1, LG.GMUpdate(g, LC.Idx(inp), gm), inp, dir);
    case LK(lk, tlk, t1) =>
      ProgEraseLeavesEq(tlk, gm, inp, L.LkDir(lk));
      var sub := LT.TreeLeaves(tlk, gm, inp, L.LkDir(lk));
      if L.Positivity(lk) {
        if |sub| > 0 { ProgEraseLeavesEq(t1, sub[0].1, inp, dir); }
      } else {
        if |sub| == 0 { ProgEraseLeavesEq(t1, gm, inp, dir); }
      }
    case LKFail(lk, tlk) =>
  }

  /** The ERASED canonical LK tree at `(code, pc, inp, b)` — `TR.TreeRepRE`'s
      rule set with (i) LK/LKFail nodes KEPT at the oracle gates, pinned
      FUNCTIONALLY by `ComputeTr`/`LkResult` (`LkGateOk`'s shape — no oracle
      consultation, no acts existential), and (ii) the two Progress-producing
      rules (`tr_progress` at EndLoop, the guard of `tr_plus` at a backward
      fork) turned into STUTTERS. This is the image of every `BoolTreeLk` walk
      tree under `ProgErase`, and it is a FUNCTION of `(pc, inp, b)`
      (`ETreeRepLkDeterm`). The gate cases are instruction-first with no
      existential over `lid`, per `TreeRepRE`'s hard-won style note. */
  least predicate ETreeRepLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             t: LT.Tree, pc: nat, b: bool)
  {
    // e_match
    (NR.GetPcRE(code, pc) == Some(RB.Accept) && t == LT.Match)
    // e_jmp
    || (exists nextpc: int :: NR.GetPcRE(code, pc) == Some(RB.Jmp(nextpc)) && nextpc >= 0
          && ETreeRepLk(rer, qm, code, inp, t, nextpc as nat, b))
    // e_begin
    || (NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
        && ETreeRepLk(rer, qm, code, inp, t, pc + 1, false))
    // e_reset
    || (t.GroupActionT? && t.g.Reset? && exists qid: int ::
          NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
          && qid in qm.quants && qm.quants[qid] == t.g.gl
          && ETreeRepLk(rer, qm, code, inp, t.t, pc + 1, b))
    // e_choice (forward forks)
    || (t.Choice? && exists pcl: int, pcr: int ::
          NR.GetPcRE(code, pc) == Some(RB.Fork(pcl, pcr)) && pcl >= 0 && pcr >= 0
          && pcl as nat > pc && pcr as nat > pc
          && ETreeRepLk(rer, qm, code, inp, t.t1, pcl as nat, b)
          && ETreeRepLk(rer, qm, code, inp, t.t2, pcr as nat, b))
    // e_plus — tr_plus with the Progress guard ERASED: a BARE Choice at the
    // do-while's backward fork, representable only at b == true (like tr_plus)
    || (t.Choice? && b == true && exists pcl: int, pcr: int ::
          NR.GetPcRE(code, pc) == Some(RB.Fork(pcl, pcr)) && pcl >= 0 && pcr >= 0
          && (pcl as nat <= pc || pcr as nat <= pc)
          && ETreeRepLk(rer, qm, code, inp, t.t1, pcl as nat, true)
          && ETreeRepLk(rer, qm, code, inp, t.t2, pcr as nat, true))
    // e_plusfail
    || (t == LT.Mismatch && b == false && exists pcl: int, pcr: int ::
          NR.GetPcRE(code, pc) == Some(RB.Fork(pcl, pcr)) && pcl >= 0 && pcr >= 0
          && (pcl as nat <= pc || pcr as nat <= pc))
    // e_read
    || (t.Read? && exists ce, nextinp ::
          NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
          && AR.ReadCharE(ce, inp) == Some((t.c, nextinp))
          && ETreeRepLk(rer, qm, code, nextinp, t.t, pc + 1, true))
    // e_progress — tr_progress ERASED to a stutter (EndLoop falls through)
    || (b == true && NR.GetPcRE(code, pc) == Some(RB.EndLoop)
        && ETreeRepLk(rer, qm, code, inp, t, pc + 1, true))
    // e_progressfail
    || (t == LT.Mismatch && b == false && NR.GetPcRE(code, pc) == Some(RB.EndLoop))
    // e_open
    || (t.GroupActionT? && t.g.Open?
        && NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(t.g.g as int)))
        && ETreeRepLk(rer, qm, code, inp, t.t, pc + 1, b))
    // e_close
    || (t.GroupActionT? && t.g.Close?
        && NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.end_reg(t.g.g as int)))
        && ETreeRepLk(rer, qm, code, inp, t.t, pc + 1, b))
    // e_anchorpass (Linden-side satisfaction; the anchor is pinned by the
    // instruction through `TrAnchor`)
    || (t.AnchorPass? && exists a: R.anchor ::
          NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
          && T.TrAnchor(a) == t.a
          && LS.AnchorSatisfied(rer, t.a, inp)
          && ETreeRepLk(rer, qm, code, inp, t.t, pc + 1, b))
    // e_anchorfail
    || (t == LT.Mismatch && exists a: R.anchor ::
          NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
          && !LS.AnchorSatisfied(rer, T.TrAnchor(a), inp))
    // e_readfail
    || (t == LT.Mismatch && exists ce ::
          NR.GetPcRE(code, pc) == Some(RB.Consume(ce)) && AR.ReadCharE(ce, inp) == None)
    // e_lk / e_lkfail — the gate, LK nodes KEPT. The body tree and verdict are
    // functional in `(lk, r1, inp)`; the node stores the ERASED body image.
    || (match NR.GetPcRE(code, pc)
        case Some(CheckOracle(lid)) =>
          lid in qm.looks
          && var lk := qm.looks[lid].0;
             var r1 := qm.looks[lid].1;
             var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
             if LS.LkResult(lk, tlk, LG.Empty, inp).Some?
             then t.LK? && t.lk == lk && t.tlk == CE.ProgErase(tlk)
                  && ETreeRepLk(rer, qm, code, inp, t.t, pc + 1, b)
             else t == LT.LKFail(lk, CE.ProgErase(tlk))
        case Some(NegCheckOracle(lid)) =>
          lid in qm.looks
          && var lk := qm.looks[lid].0;
             var r1 := qm.looks[lid].1;
             var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
             if LS.LkResult(lk, tlk, LG.Empty, inp).Some?
             then t.LK? && t.lk == lk && t.tlk == CE.ProgErase(tlk)
                  && ETreeRepLk(rer, qm, code, inp, t.t, pc + 1, b)
             else t == LT.LKFail(lk, CE.ProgErase(tlk))
        case _ => false)
  }

  /** Determinism of the erased canonical form: at a fixed `(pc, inp, b)` the
      represented tree is unique — the quotient replacement for the FALSE
      exact-tree `TtLkSameTree`. Mirror of `TR.TreeRepDetermRE` (least-lemma
      ordinal induction; `qm` pins the Reset payload, `SetRegisterToCP` parity
      separates Open from Close); the erased stutters recurse on the SAME
      trees, and the gate cases close functionally (both sides' `tlk` and
      verdict are pinned by `ComputeTr`/`LkResult` at the instruction's
      table entry). */
  least lemma ETreeRepLkDeterm(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                               t1: LT.Tree, t2: LT.Tree, pc: nat, b: bool)
    requires ETreeRepLk(rer, qm, code, inp, t1, pc, b)
    requires ETreeRepLk(rer, qm, code, inp, t2, pc, b)
    ensures t1 == t2
  {
    match NR.GetPcRE(code, pc)
    case Some(Accept) =>            // both e_match
    case Some(Jmp(np)) =>           // both e_jmp
      ETreeRepLkDeterm(rer, qm, code, inp, t1, t2, np as nat, b);
    case Some(BeginLoop) =>         // both e_begin
      ETreeRepLkDeterm(rer, qm, code, inp, t1, t2, pc + 1, false);
    case Some(SetQuantToClock(qid, bb)) =>  // both e_reset (only bb == false has a rule)
      match t1 {
        case GroupActionT(g1, tc1) =>
          match t2 {
            case GroupActionT(g2, tc2) =>
              assert g1 == LG.Reset(qm.quants[qid]) && g2 == LG.Reset(qm.quants[qid]);
              ETreeRepLkDeterm(rer, qm, code, inp, tc1, tc2, pc + 1, b);
            case _ =>
          }
        case _ =>
      }
    case Some(Fork(pl, pr)) =>
      if pl >= 0 && pr >= 0 && pl as nat > pc && pr as nat > pc {
        // forward fork: both e_choice
        match t1 {
          case Choice(ta1, tb1) =>
            match t2 {
              case Choice(ta2, tb2) =>
                ETreeRepLkDeterm(rer, qm, code, inp, ta1, ta2, pl as nat, b);
                ETreeRepLkDeterm(rer, qm, code, inp, tb1, tb2, pr as nat, b);
              case _ =>
            }
          case _ =>
        }
      } else if !b {
        // backward-arm fork at b == false: both e_plusfail (Mismatch)
      } else {
        // backward-arm fork at b == true: both e_plus (bare Choice — the
        // erased guard makes first- and re-traversal shapes IDENTICAL, which
        // is the entire point of the quotient)
        match t1 {
          case Choice(ta1, tb1) =>
            match t2 {
              case Choice(ta2, tb2) =>
                ETreeRepLkDeterm(rer, qm, code, inp, ta1, ta2, pl as nat, true);
                ETreeRepLkDeterm(rer, qm, code, inp, tb1, tb2, pr as nat, true);
              case _ =>
            }
          case _ =>
        }
      }
    case Some(Consume(ce)) =>       // e_read (Some) or e_readfail (None)
      match AR.ReadCharE(ce, inp) {
        case None =>                // both Mismatch
        case Some(pair) =>
          match t1 {
            case Read(c1, tc1) =>
              match t2 {
                case Read(c2, tc2) =>
                  ETreeRepLkDeterm(rer, qm, code, pair.1, tc1, tc2, pc + 1, true);
                case _ =>
              }
            case _ =>
          }
      }
    case Some(EndLoop) =>           // e_progress stutter (b) or e_progressfail (!b)
      if b {
        ETreeRepLkDeterm(rer, qm, code, inp, t1, t2, pc + 1, true);
      }
    case Some(SetRegisterToCP(reg)) =>  // e_open (even reg) xor e_close (odd reg)
      match t1 {
        case GroupActionT(g1, tc1) =>
          match t2 {
            case GroupActionT(g2, tc2) =>
              assert g1.Open? ==> reg == 2 * (g1.g as int);
              assert g1.Close? ==> reg == 2 * (g1.g as int) + 1;
              assert g2.Open? ==> reg == 2 * (g2.g as int);
              assert g2.Close? ==> reg == 2 * (g2.g as int) + 1;
              assert g1 == g2;
              ETreeRepLkDeterm(rer, qm, code, inp, tc1, tc2, pc + 1, b);
            case _ =>
          }
        case _ =>
      }
    case Some(AnchorAssertion(a)) =>  // e_anchorpass (satisfied) or e_anchorfail
      if LS.AnchorSatisfied(rer, T.TrAnchor(a), inp) {
        match t1 {
          case AnchorPass(a1, tc1) =>
            match t2 {
              case AnchorPass(a2, tc2) =>
                ETreeRepLkDeterm(rer, qm, code, inp, tc1, tc2, pc + 1, b);
              case _ =>
            }
          case _ =>
        }
      }
    case Some(CheckOracle(lid)) =>  // e_lk (verdict Some) or e_lkfail — functional split
      if lid in qm.looks {
        var lk := qm.looks[lid].0;
        var r1 := qm.looks[lid].1;
        var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
        if LS.LkResult(lk, tlk, LG.Empty, inp).Some? {
          match t1 {
            case LK(l1, k1, tc1) =>
              match t2 {
                case LK(l2, k2, tc2) =>
                  ETreeRepLkDeterm(rer, qm, code, inp, tc1, tc2, pc + 1, b);
                case _ =>
              }
            case _ =>
          }
        }
        // verdict None: both == LKFail(lk, CE.ProgErase(tlk)) directly
      }
    case Some(NegCheckOracle(lid)) =>
      if lid in qm.looks {
        var lk := qm.looks[lid].0;
        var r1 := qm.looks[lid].1;
        var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
        if LS.LkResult(lk, tlk, LG.Empty, inp).Some? {
          match t1 {
            case LK(l1, k1, tc1) =>
              match t2 {
                case LK(l2, k2, tc2) =>
                  ETreeRepLkDeterm(rer, qm, code, inp, tc1, tc2, pc + 1, b);
                case _ =>
              }
            case _ =>
          }
        }
      }
    case Some(_) =>                 // WriteOracle/CheckNullable/Fail: no rule — vacuous
    case None =>                    // vacuous
  }

  /** The PLANTED canonical LK tree at `(code, pc, inp, b)` — `TR.TreeRepRE`'s
      rule set verbatim (tr_progress/tr_plus KEEP their `Progress` guards) with
      LK/LKFail nodes KEPT at the oracle gates, pinned functionally. This is
      the tree machine B actually RUNS (unique per `(pc, ea)` by
      `TreeRepLkDetermRE`, AND stutter-discriminating: at an EndLoop pc the
      tree is `Progress(x)`, at pc+1 it is `x` — matching the VM's distinct
      `(pc, ea)` memo entries, which the ERASED form cannot: erasure conflates
      a processed `Progress(x)` with its queued child `x` and would make B
      skip work the VM performs). `ETreeRepLk` above remains as the erased
      image; `ProgErase` of a planted tree relates it to the raw spec tree. */
  least predicate TreeRepLkRE(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                              t: LT.Tree, pc: nat, b: bool)
  {
    // tr_match
    (NR.GetPcRE(code, pc) == Some(RB.Accept) && t == LT.Match)
    // tr_jmp
    || (exists nextpc: int :: NR.GetPcRE(code, pc) == Some(RB.Jmp(nextpc)) && nextpc >= 0
          && TreeRepLkRE(rer, qm, code, inp, t, nextpc as nat, b))
    // tr_begin
    || (NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
        && TreeRepLkRE(rer, qm, code, inp, t, pc + 1, false))
    // tr_reset
    || (t.GroupActionT? && t.g.Reset? && exists qid: int ::
          NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
          && qid in qm.quants && qm.quants[qid] == t.g.gl
          && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b))
    // tr_choice (forward forks)
    || (t.Choice? && exists pcl: int, pcr: int ::
          NR.GetPcRE(code, pc) == Some(RB.Fork(pcl, pcr)) && pcl >= 0 && pcr >= 0
          && pcl as nat > pc && pcr as nat > pc
          && TreeRepLkRE(rer, qm, code, inp, t.t1, pcl as nat, b)
          && TreeRepLkRE(rer, qm, code, inp, t.t2, pcr as nat, b))
    // tr_plus (the guard KEPT: consumed with the Choice at the backward fork)
    || (t.Progress? && t.t.Choice? && b == true && exists pcl: int, pcr: int ::
          NR.GetPcRE(code, pc) == Some(RB.Fork(pcl, pcr)) && pcl >= 0 && pcr >= 0
          && (pcl as nat <= pc || pcr as nat <= pc)
          && TreeRepLkRE(rer, qm, code, inp, t.t.t1, pcl as nat, true)
          && TreeRepLkRE(rer, qm, code, inp, t.t.t2, pcr as nat, true))
    // tr_plusfail
    || (t == LT.Mismatch && b == false && exists pcl: int, pcr: int ::
          NR.GetPcRE(code, pc) == Some(RB.Fork(pcl, pcr)) && pcl >= 0 && pcr >= 0
          && (pcl as nat <= pc || pcr as nat <= pc))
    // tr_read
    || (t.Read? && exists ce, nextinp ::
          NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
          && AR.ReadCharE(ce, inp) == Some((t.c, nextinp))
          && TreeRepLkRE(rer, qm, code, nextinp, t.t, pc + 1, true))
    // tr_progress (the guard KEPT: EndLoop falls through)
    || (t.Progress? && b == true && NR.GetPcRE(code, pc) == Some(RB.EndLoop)
        && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, true))
    // tr_progressfail
    || (t == LT.Mismatch && b == false && NR.GetPcRE(code, pc) == Some(RB.EndLoop))
    // tr_open
    || (t.GroupActionT? && t.g.Open?
        && NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(t.g.g as int)))
        && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b))
    // tr_close
    || (t.GroupActionT? && t.g.Close?
        && NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.end_reg(t.g.g as int)))
        && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b))
    // tr_anchorpass
    || (t.AnchorPass? && exists a: R.anchor ::
          NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
          && T.TrAnchor(a) == t.a
          && LS.AnchorSatisfied(rer, t.a, inp)
          && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b))
    // tr_anchorfail
    || (t == LT.Mismatch && exists a: R.anchor ::
          NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
          && !LS.AnchorSatisfied(rer, T.TrAnchor(a), inp))
    // tr_readfail
    || (t == LT.Mismatch && exists ce ::
          NR.GetPcRE(code, pc) == Some(RB.Consume(ce)) && AR.ReadCharE(ce, inp) == None)
    // tr_lk / tr_lkfail — the gate, LK nodes KEPT with the RAW functional body
    // (what machine B's LkResult merge evaluates)
    || (match NR.GetPcRE(code, pc)
        case Some(CheckOracle(lid)) =>
          lid in qm.looks
          && var lk := qm.looks[lid].0;
             var r1 := qm.looks[lid].1;
             var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
             if LS.LkResult(lk, tlk, LG.Empty, inp).Some?
             then t.LK? && t.lk == lk && t.tlk == tlk
                  && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b)
             else t == LT.LKFail(lk, tlk)
        case Some(NegCheckOracle(lid)) =>
          lid in qm.looks
          && var lk := qm.looks[lid].0;
             var r1 := qm.looks[lid].1;
             var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
             if LS.LkResult(lk, tlk, LG.Empty, inp).Some?
             then t.LK? && t.lk == lk && t.tlk == tlk
                  && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b)
             else t == LT.LKFail(lk, tlk)
        case _ => false)
  }

  /** Determinism of the PLANTED canonical form: at a fixed `(pc, inp, b)` the
      represented tree is unique — what closes machine B's EXACT-tree skip in
      lockstep with the VM's `(pc, ea)` skip, with `PikeTreeLk` unchanged.
      Mirror of `TR.TreeRepDetermRE` extended with the functional gate. */
  least lemma TreeRepLkDetermRE(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                t1: LT.Tree, t2: LT.Tree, pc: nat, b: bool)
    requires TreeRepLkRE(rer, qm, code, inp, t1, pc, b)
    requires TreeRepLkRE(rer, qm, code, inp, t2, pc, b)
    ensures t1 == t2
  {
    match NR.GetPcRE(code, pc)
    case Some(Accept) =>            // both tr_match
    case Some(Jmp(np)) =>           // both tr_jmp
      TreeRepLkDetermRE(rer, qm, code, inp, t1, t2, np as nat, b);
    case Some(BeginLoop) =>         // both tr_begin
      TreeRepLkDetermRE(rer, qm, code, inp, t1, t2, pc + 1, false);
    case Some(SetQuantToClock(qid, bb)) =>  // both tr_reset
      match t1 {
        case GroupActionT(g1, tc1) =>
          match t2 {
            case GroupActionT(g2, tc2) =>
              assert g1 == LG.Reset(qm.quants[qid]) && g2 == LG.Reset(qm.quants[qid]);
              TreeRepLkDetermRE(rer, qm, code, inp, tc1, tc2, pc + 1, b);
            case _ =>
          }
        case _ =>
      }
    case Some(Fork(pl, pr)) =>
      if pl >= 0 && pr >= 0 && pl as nat > pc && pr as nat > pc {
        // forward fork: both tr_choice
        match t1 {
          case Choice(ta1, tb1) =>
            match t2 {
              case Choice(ta2, tb2) =>
                TreeRepLkDetermRE(rer, qm, code, inp, ta1, ta2, pl as nat, b);
                TreeRepLkDetermRE(rer, qm, code, inp, tb1, tb2, pr as nat, b);
              case _ =>
            }
          case _ =>
        }
      } else if !b {
        // backward-arm fork at b == false: both tr_plusfail (Mismatch)
      } else {
        // backward-arm fork: both tr_plus (Progress(Choice))
        match t1 {
          case Progress(tc1) =>
            match t2 {
              case Progress(tc2) =>
                match tc1 {
                  case Choice(ta1, tb1) =>
                    match tc2 {
                      case Choice(ta2, tb2) =>
                        TreeRepLkDetermRE(rer, qm, code, inp, ta1, ta2, pl as nat, true);
                        TreeRepLkDetermRE(rer, qm, code, inp, tb1, tb2, pr as nat, true);
                      case _ =>
                    }
                  case _ =>
                }
              case _ =>
            }
          case _ =>
        }
      }
    case Some(Consume(ce)) =>       // tr_read (Some) or tr_readfail (None)
      match AR.ReadCharE(ce, inp) {
        case None =>                // both Mismatch
        case Some(pair) =>
          match t1 {
            case Read(c1, tc1) =>
              match t2 {
                case Read(c2, tc2) =>
                  TreeRepLkDetermRE(rer, qm, code, pair.1, tc1, tc2, pc + 1, true);
                case _ =>
              }
            case _ =>
          }
      }
    case Some(EndLoop) =>           // tr_progress (b) or tr_progressfail (!b)
      if b {
        match t1 {
          case Progress(tc1) =>
            match t2 {
              case Progress(tc2) =>
                TreeRepLkDetermRE(rer, qm, code, inp, tc1, tc2, pc + 1, true);
              case _ =>
            }
          case _ =>
        }
      }
    case Some(SetRegisterToCP(reg)) =>  // tr_open (even reg) xor tr_close (odd reg)
      match t1 {
        case GroupActionT(g1, tc1) =>
          match t2 {
            case GroupActionT(g2, tc2) =>
              assert g1.Open? ==> reg == 2 * (g1.g as int);
              assert g1.Close? ==> reg == 2 * (g1.g as int) + 1;
              assert g2.Open? ==> reg == 2 * (g2.g as int);
              assert g2.Close? ==> reg == 2 * (g2.g as int) + 1;
              assert g1 == g2;
              TreeRepLkDetermRE(rer, qm, code, inp, tc1, tc2, pc + 1, b);
            case _ =>
          }
        case _ =>
      }
    case Some(AnchorAssertion(a)) =>  // tr_anchorpass (satisfied) or tr_anchorfail
      if LS.AnchorSatisfied(rer, T.TrAnchor(a), inp) {
        match t1 {
          case AnchorPass(a1, tc1) =>
            match t2 {
              case AnchorPass(a2, tc2) =>
                TreeRepLkDetermRE(rer, qm, code, inp, tc1, tc2, pc + 1, b);
              case _ =>
            }
          case _ =>
        }
      }
    case Some(CheckOracle(lid)) =>  // tr_lk (verdict Some) or tr_lkfail — functional split
      if lid in qm.looks {
        var lk := qm.looks[lid].0;
        var r1 := qm.looks[lid].1;
        var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
        if LS.LkResult(lk, tlk, LG.Empty, inp).Some? {
          match t1 {
            case LK(l1, k1, tc1) =>
              match t2 {
                case LK(l2, k2, tc2) =>
                  TreeRepLkDetermRE(rer, qm, code, inp, tc1, tc2, pc + 1, b);
                case _ =>
              }
            case _ =>
          }
        }
      }
    case Some(NegCheckOracle(lid)) =>
      if lid in qm.looks {
        var lk := qm.looks[lid].0;
        var r1 := qm.looks[lid].1;
        var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
        if LS.LkResult(lk, tlk, LG.Empty, inp).Some? {
          match t1 {
            case LK(l1, k1, tc1) =>
              match t2 {
                case LK(l2, k2, tc2) =>
                  TreeRepLkDetermRE(rer, qm, code, inp, tc1, tc2, pc + 1, b);
                case _ =>
              }
            case _ =>
          }
        }
      }
    case Some(_) =>                 // WriteOracle/CheckNullable/Fail: no rule — vacuous
    case None =>                    // vacuous
  }

  // ---- per-instruction CANONICAL inversions (the `TreeRepLkRE`-At* tier) ----
  //
  // `LiftStepC`'s per-instruction cases use these to read off the canonical
  // head's shape and re-establish the canonical tie for the children — the
  // rules are instruction-gated, so at a pinned instruction exactly one rule
  // family can fire (the same discrimination the determinism lemma performs).
  // Fork arms come FREE here (tr_choice/tr_plus carry both arms) — the old
  // "Fork branches hardest" problem does not exist at the canonical level.

  lemma TreeRepLkREAtAccept(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                            t: LT.Tree, pc: nat, b: bool)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.Accept)
    ensures t == LT.Match
  { }

  lemma TreeRepLkREAtJmp(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         t: LT.Tree, pc: nat, b: bool, x: int)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.Jmp(x))
    ensures x >= 0 && TreeRepLkRE(rer, qm, code, inp, t, x as nat, b)
  { }

  lemma TreeRepLkREAtBeginLoop(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                               t: LT.Tree, pc: nat, b: bool)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
    ensures TreeRepLkRE(rer, qm, code, inp, t, pc + 1, false)
  { }

  lemma TreeRepLkREAtSetQuant(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                              t: LT.Tree, pc: nat, b: bool, qid: int, bb: bool)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, bb))
    ensures !bb && qid in qm.quants
    ensures t.GroupActionT? && t.g == LG.Reset(qm.quants[qid])
    ensures TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b)
  { }

  lemma TreeRepLkREAtFork(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          t: LT.Tree, pc: nat, b: bool, x: int, y: int)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    ensures x >= 0 && y >= 0
    ensures x as nat > pc && y as nat > pc ==>       // forward fork: tr_choice
      t.Choice?
      && TreeRepLkRE(rer, qm, code, inp, t.t1, x as nat, b)
      && TreeRepLkRE(rer, qm, code, inp, t.t2, y as nat, b)
    ensures (x as nat <= pc || y as nat <= pc) && b ==>   // backward fork: tr_plus
      t.Progress? && t.t.Choice?
      && TreeRepLkRE(rer, qm, code, inp, t.t.t1, x as nat, true)
      && TreeRepLkRE(rer, qm, code, inp, t.t.t2, y as nat, true)
    ensures (x as nat <= pc || y as nat <= pc) && !b ==>  // tr_plusfail
      t == LT.Mismatch
  { }

  lemma TreeRepLkREAtConsume(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             t: LT.Tree, pc: nat, b: bool, ce: RC.char_expectation)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    ensures AR.ReadCharE(ce, inp).None? ==> t == LT.Mismatch
    ensures AR.ReadCharE(ce, inp).Some? ==>
      t.Read? && t.c == AR.ReadCharE(ce, inp).value.0
      && TreeRepLkRE(rer, qm, code, AR.ReadCharE(ce, inp).value.1, t.t, pc + 1, true)
  { }

  lemma TreeRepLkREAtEndLoop(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             t: LT.Tree, pc: nat, b: bool)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.EndLoop)
    ensures b ==> t.Progress? && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, true)
    ensures !b ==> t == LT.Mismatch
  { }

  lemma TreeRepLkREAtSetReg(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                            t: LT.Tree, pc: nat, b: bool, reg: int)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(reg))
    ensures t.GroupActionT? && (t.g.Open? || t.g.Close?)
    ensures t.g.Open? ==> reg == CP.start_reg(t.g.g as int)
    ensures t.g.Close? ==> reg == CP.end_reg(t.g.g as int)
    ensures TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b)
  { }

  lemma TreeRepLkREAtAnchor(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                            t: LT.Tree, pc: nat, b: bool, a: R.anchor)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
    ensures LS.AnchorSatisfied(rer, T.TrAnchor(a), inp) ==>
      t.AnchorPass? && t.a == T.TrAnchor(a)
      && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b)
    ensures !LS.AnchorSatisfied(rer, T.TrAnchor(a), inp) ==> t == LT.Mismatch
  { }

  lemma TreeRepLkREAtCheckOracle(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                 t: LT.Tree, pc: nat, b: bool, lid: int)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    ensures lid in qm.looks
    ensures var lk := qm.looks[lid].0;
            var r1 := qm.looks[lid].1;
            var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
            if LS.LkResult(lk, tlk, LG.Empty, inp).Some?
            then t.LK? && t.lk == lk && t.tlk == tlk
                 && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b)
            else t == LT.LKFail(lk, tlk)
  { }

  lemma TreeRepLkREAtNegCheckOracle(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                    t: LT.Tree, pc: nat, b: bool, lid: int)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    requires NR.GetPcRE(code, pc) == Some(RB.NegCheckOracle(lid))
    ensures lid in qm.looks
    ensures var lk := qm.looks[lid].0;
            var r1 := qm.looks[lid].1;
            var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
            if LS.LkResult(lk, tlk, LG.Empty, inp).Some?
            then t.LK? && t.lk == lk && t.tlk == tlk
                 && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, b)
            else t == LT.LKFail(lk, tlk)
  { }

  // ==========================================================================
  // THE CONSTRUCTOR: from a represented, walk-guarded stack's BoolTreeLk tree
  // to the PLANTED canonical tree machine B runs.
  //
  // Mirror of the PROVEN `ATR.ActionsTreeRepFRE` / `AtBackForkTreeRep` pair
  // (ActionsTreeRepRE.dfy:177/:826) with LK nodes KEPT and the S-machinery/
  // leaf-agreement congruences replaced by ERASURE EQUALITY (`ProgErase(tcan)
  // == ProgErase(t)` — the constructed tree differs from the spec walk tree
  // only by planted `Progress` guards, so their leaves are EQUAL via
  // `ProgEraseLeavesEq`). No oracle: the gate is decided by the FUNCTIONAL
  // verdict, exactly like `BoolTreeLk`'s `LkGateOk`. `WalkOk` is kept — it
  // excludes the one adversarial config (a bare loop-view star at
  // `CannotExit`) and is available at the ONE invocation site: the entry
  // pairing (`WkE.WalkOkEntry`). The check-insertion seam (`min == 1, Inf`)
  // uses `CE.BoolCheckInsert`, whose strengthened ensures makes the insertion
  // invisible to the erasure tie.
  // ==========================================================================

  /** Fuel-indexed core of the construction: returns the PLANTED canonical
      tree — `TreeRepLkRE`-represented at `(pc, EaOf(b))` and erasure-equal to
      the spec walk tree `t`. One case per action/regex shape, mirroring
      `ATR.ActionsTreeRepFRE` case-for-case. */
  lemma {:isolate_assertions} ActionsTreeRepLkF(rer: LW.RegExpRecord, qm: AR.QMap, acts: LS.Actions,
                                                code: RB.code, pc: nat, inp: LC.Input,
                                                b: BS.LoopBool, t: LT.Tree, n: nat)
    returns (tcan: LT.Tree)
    requires EL.PikeLkActions(acts)
    requires ATR.ActionsRepFuelL(rer, qm, acts, code, pc, n)
    requires WO.WalkOk(acts, code, pc, ATR.EaOf(b))
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    ensures TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b))
    ensures CE.ProgErase(tcan) == CE.ProgErase(t)
    decreases CE.PSize(t), ATR.MsizeA(acts), n, 1
  {
    if |acts| == 0 && NR.GetPcRE(code, pc) == Some(RB.Accept) {
      assert t == LT.Match;
      tcan := LT.Match;
      // tr_match
    } else if exists pcstart: nat :: NR.GetPcRE(code, pc) == Some(RB.Jmp(pcstart))
                && ATR.ActionsRepFuelL(rer, qm, acts, code, pcstart, n - 1) {
      var pcstart: nat :| NR.GetPcRE(code, pc) == Some(RB.Jmp(pcstart))
        && ATR.ActionsRepFuelL(rer, qm, acts, code, pcstart, n - 1);
      WO.WalkOkJmp(acts, code, pc, ATR.EaOf(b), pcstart);
      tcan := ActionsTreeRepLkF(rer, qm, acts, code, pcstart, inp, b, t, n - 1);
      // tr_jmp
      assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
    } else {
      var cont := acts[1..];
      var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid)
        && ATR.ActionsRepFuelL(rer, qm, cont, code, pcmid, n - 1);
      EL.PikeLkActionsTail(acts);
      assert acts == [acts[0]] + cont;
      EL.PikeLkActionsConsIff(acts[0], cont);
      match acts[0]
      case Acheck(strcheck) =>
        assert LS.ActionsRegexSize(acts) == LS.ActionsRegexSize(cont);
        if NR.GetPcRE(code, pc) == Some(RB.EndLoop) {
          assert pcmid == pc + 1;
          if b == BS.CanExit {
            match t {
              case Progress(tc) =>
                WO.WalkOkAcheckEndLoop(acts, code, pc, ATR.EaOf(b));
                var sub := ActionsTreeRepLkF(rer, qm, cont, code, pc + 1, inp, BS.CanExit, tc, n - 1);
                tcan := LT.Progress(sub);
                // tr_progress (fall-through EndLoop)
                assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, true);
              case _ =>
            }
          } else {
            // t == Mismatch: tr_progressfail
            tcan := LT.Mismatch;
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, false);
          }
        } else {
          // the zero-width check at the do-while's backward fork
          assert AR.BackForkAt(code, pc) && pcmid == pc;
          if b == BS.CanExit {
            match t {
              case Progress(tc) =>
                WO.WalkOkAcheckBackFork(acts, code, pc, ATR.EaOf(b));
                var sub := AtBackForkTreeLkF(rer, qm, cont, code, pc, inp, tc, n - 1);
                tcan := LT.Progress(sub);
                // the companion's ensures IS tr_plus for Progress(sub)
                assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, true);
              case _ =>
            }
          } else {
            // t == Mismatch: tr_plusfail
            var fx: int, fy: int :| NR.GetPcRE(code, pc) == Some(RB.Fork(fx, fy))
              && fx >= 0 && fy >= 0 && (fx as nat <= pc || fy as nat <= pc);
            tcan := LT.Mismatch;
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, false);
          }
        }
      case Aclose(gid) =>
        match t {
          case GroupActionT(g, tc) =>
            assert g == LG.Close(gid);
            WO.WalkOkAclose(acts, code, pc, ATR.EaOf(b));
            assert CE.PSize(tc) < CE.PSize(t);
            var sub := ActionsTreeRepLkF(rer, qm, cont, code, pc + 1, inp, b, tc, n - 1);
            tcan := LT.GroupActionT(g, sub);
            // tr_close
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
          case _ =>
        }
      case Areg(r) =>
        assert EL.PikeLkRegex(r);
        match r
        case Epsilon =>
          assert pcmid == pc;
          WO.WalkOkEpsilon(acts, code, pc, ATR.EaOf(b));
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          tcan := ActionsTreeRepLkF(rer, qm, cont, code, pc, inp, b, t, n - 1);
        case Character(cd) => {
          var ce :| NR.GetPcRE(code, pc) == Some(RB.Consume(ce)) && AR.ExpectationMatches(rer, ce, cd);
          AR.ReadAgree(rer, ce, cd, inp);
          match LC.ReadChar(rer, cd, inp, WP.Forward) {
            case None =>
              // t == Mismatch; tr_readfail (ReadCharE == None by ReadAgree)
              tcan := LT.Mismatch;
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case Some(pair) =>
              match t {
                case Read(c, tc) =>
                  assert c == pair.0;
                  WO.WalkOkCharacter(acts, code, pc, ATR.EaOf(b));
                  assert CE.PSize(tc) < CE.PSize(t);
                  var sub := ActionsTreeRepLkF(rer, qm, cont, code, pc + 1, pair.1, BS.CanExit, tc, n - 1);
                  tcan := LT.Read(c, sub);
                  // tr_read with witness (ce, pair.1)
                  assert AR.ReadCharE(ce, inp) == Some((c, pair.1));
                  assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                case _ =>
              }
          }
        }
        case Disjunction(r1, r2) => {
          EL.PikeLkActionsConsIff(LS.Areg(r1), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.Fork(pc + 1, e1 + 1))
                       && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid))
                       && AR.NfaRepL(rer, qm, r2, code, e1 + 1, pcmid);
          AR.NfaRepIncrL(rer, qm, r1, code, pc + 1, e1);
          match t {
            case Choice(ta, tb) =>
              WO.WalkOkAlt(acts, code, pc, ATR.EaOf(b), r1, r2, pc + 1, e1 + 1);
              // left branch: [Areg r1]+cont at pc+1 (cont reached via Jmp(e1 -> pcmid))
              var la := [LS.Areg(r1)] + cont;
              assert AR.ActionsRepL(rer, qm, cont, code, e1) by {
                ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                assert NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid));
              }
              assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, e1);
              assert la[0] == LS.Areg(r1) && la[1..] == cont;
              assert AR.ActionsRepL(rer, qm, la, code, pc + 1);
              ATR.ActionsRepLToFuel(rer, qm, la, code, pc + 1);
              var na: nat :| ATR.ActionsRepFuelL(rer, qm, la, code, pc + 1, na);
              assert CE.PSize(ta) < CE.PSize(t);
              var suba := ActionsTreeRepLkF(rer, qm, la, code, pc + 1, inp, b, ta, na);
              // right branch: [Areg r2]+cont at e1+1
              var lb := [LS.Areg(r2)] + cont;
              ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
              assert AR.ActionRepL(rer, qm, LS.Areg(r2), code, e1 + 1, pcmid);
              assert lb[0] == LS.Areg(r2) && lb[1..] == cont;
              assert AR.ActionsRepL(rer, qm, lb, code, e1 + 1);
              ATR.ActionsRepLToFuel(rer, qm, lb, code, e1 + 1);
              var nb: nat :| ATR.ActionsRepFuelL(rer, qm, lb, code, e1 + 1, nb);
              assert CE.PSize(tb) < CE.PSize(t);
              var subb := ActionsTreeRepLkF(rer, qm, lb, code, e1 + 1, inp, b, tb, nb);
              tcan := LT.Choice(suba, subb);
              // tr_choice with the forward Fork(pc+1, e1+1): e1 >= pc+1 by NfaRepIncrL
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case _ =>
          }
        }
        case Sequence(r1, r2) => {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
          assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
          var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
          var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
          assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
          assert AR.ActionRepL(rer, qm, LS.Areg(r2), code, e1, pcmid);
          assert ([LS.Areg(r2)] + cont)[0] == LS.Areg(r2) && ([LS.Areg(r2)] + cont)[1..] == cont;
          ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
          assert AR.ActionsRepL(rer, qm, [LS.Areg(r2)] + cont, code, e1);
          assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc, e1);
          assert na[0] == LS.Areg(r1) && na[1..] == [LS.Areg(r2)] + cont;
          assert AR.ActionsRepL(rer, qm, na, code, pc);
          assert LS.ActionsRegexSize(na) < LS.ActionsRegexSize(acts);
          assert ATR.MsizeA(na) < ATR.MsizeA(acts);
          ATR.ActionsRepLToFuel(rer, qm, na, code, pc);
          var nn: nat :| ATR.ActionsRepFuelL(rer, qm, na, code, pc, nn);
          WO.WalkOkSeq(acts, code, pc, ATR.EaOf(b), r1, r2);
          tcan := ActionsTreeRepLkF(rer, qm, na, code, pc, inp, b, t, nn);
        }
        case Quantified(greedy, min, delta, r1) => {
          var gidl := L.DefGroups(r1);
          if min > 0 {
            match delta {
              case Inf =>
                var em, e1x := AR.NfaRepLPlusInv(rer, qm, greedy, min, r1, code, pc, pcmid);
                assert NUL.NonNullableL(r1);
                var qid: int :| NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                  && qid in qm.quants && qm.quants[qid] == gidl;
                AR.NfaRepIncrL(rer, qm, r1, code, em + 1, e1x);
                if min > 1 {
                  var quant1 := L.Quantified(greedy, min - 1, LN.Inf, r1);
                  var eb: nat :| (exists qid2: int ::
                        NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid2, false))
                        && qid2 in qm.quants && qm.quants[qid2] == gidl)
                    && AR.NfaRepL(rer, qm, r1, code, pc + 1, eb)
                    && AR.NfaRepMinL(rer, qm, min - 2, r1, code, eb, em);
                  AR.NfaRepLPlusIntro(rer, qm, greedy, min - 1, r1, code, eb, em, e1x, pcmid, qid);
                  assert AR.NfaRepL(rer, qm, quant1, code, eb, pcmid);
                  match t {
                    case GroupActionT(g, tc) =>
                      assert g == LG.Reset(gidl);
                      EL.PikeLkActionsConsIff(LS.Areg(quant1), cont);
                      EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(quant1)] + cont);
                      ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                      assert AR.ActionRepL(rer, qm, LS.Areg(quant1), code, eb, pcmid);
                      var lq1 := [LS.Areg(quant1)] + cont;
                      assert lq1[0] == LS.Areg(quant1) && lq1[1..] == cont;
                      assert AR.ActionsRepL(rer, qm, lq1, code, eb);
                      var ia := [LS.Areg(r1)] + lq1;
                      assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, eb);
                      assert ia[0] == LS.Areg(r1) && ia[1..] == lq1;
                      assert AR.ActionsRepL(rer, qm, ia, code, pc + 1);
                      assert ia == [LS.Areg(r1), LS.Areg(quant1)] + cont;
                      ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 1);
                      var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 1, ni);
                      WO.WalkOkQuantForced(acts, code, pc, ATR.EaOf(b), greedy, min, delta, r1);
                      assert CE.PSize(tc) < CE.PSize(t);
                      var sub := ActionsTreeRepLkF(rer, qm, ia, code, pc + 1, inp, b, tc, ni);
                      tcan := LT.GroupActionT(g, sub);
                      // tr_reset at pc (the copy's clock-mark carries the Reset)
                      assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                    case _ =>
                  }
                } else {
                  // min == 1: THE SEAM. Insert the check; erasure makes the
                  // insertion invisible (BoolCheckInsert's ProgErase ensures).
                  assert em == pc;
                  var q0 := L.Quantified(greedy, 0, LN.Inf, r1);
                  match t {
                    case GroupActionT(g, tc) =>
                      assert g == LG.Reset(gidl);
                      assert EL.BoolTreeLk(rer, [LS.Areg(r1), LS.Areg(q0)] + cont, inp, b, tc);
                      var pre := [LS.Areg(r1)];
                      var rest := [LS.Areg(q0)] + cont;
                      EL.PikeLkActionsConsIff(LS.Areg(q0), cont);
                      EL.PikeLkActionsConsIff(LS.Areg(r1), rest);
                      assert EL.PikeLkActions(pre) by {
                        assert pre == [LS.Areg(r1)] + [];
                        EL.PikeLkActionsConsIff(LS.Areg(r1), []);
                      }
                      assert pre + rest == [LS.Areg(r1), LS.Areg(q0)] + cont;
                      assert CE.ConsumesBeforeAreg(pre) by {
                        assert pre[0].Areg? && NUL.NonNullableL(pre[0].r);
                      }
                      var t1ck := CE.BoolCheckInsert(rer, pre, inp, rest, inp, b, tc);
                      assert CE.ProgErase(t1ck) == CE.ProgErase(tc);
                      var ia := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q0)] + cont;
                      assert ia == pre + [LS.Acheck(inp)] + rest;
                      assert EL.BoolTreeLk(rer, ia, inp, b, t1ck);
                      assert AR.BackForkAt(code, e1x) by {
                        assert NR.GetPcRE(code, e1x)
                            == Some(if greedy then RB.Fork(em, e1x + 1) else RB.Fork(e1x + 1, em));
                        assert em <= e1x;
                      }
                      assert AR.NfaRepL(rer, qm, q0, code, e1x, e1x + 1) by {
                        assert NUL.NonNullableL(r1)
                          && NR.GetPcRE(code, e1x)
                             == Some(if greedy then RB.Fork(em, e1x + 1) else RB.Fork(e1x + 1, em))
                          && em <= e1x
                          && (exists qid2: int ::
                                NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid2, false))
                                && qid2 in qm.quants && qm.quants[qid2] == L.DefGroups(r1))
                          && AR.NfaRepL(rer, qm, r1, code, em + 1, e1x);
                      }
                      ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                      var lq := [LS.Areg(q0)] + cont;
                      assert AR.ActionRepL(rer, qm, LS.Areg(q0), code, e1x, e1x + 1);
                      assert lq[0] == LS.Areg(q0) && lq[1..] == cont;
                      assert AR.ActionsRepL(rer, qm, lq, code, e1x);
                      var lc := [LS.Acheck(inp)] + lq;
                      EL.PikeLkActionsConsIff(LS.Acheck(inp), lq);
                      assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1x, e1x);
                      assert lc[0] == LS.Acheck(inp) && lc[1..] == lq;
                      assert AR.ActionsRepL(rer, qm, lc, code, e1x);
                      assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, e1x);
                      assert ia == [LS.Areg(r1)] + lc;
                      assert ia[0] == LS.Areg(r1) && ia[1..] == lc;
                      assert AR.ActionsRepL(rer, qm, ia, code, pc + 1);
                      EL.PikeLkActionsConsIff(LS.Areg(r1), lc);
                      assert EL.PikeLkActions(ia);
                      ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 1);
                      var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 1, ni);
                      WO.WalkOkQuantSeam(acts, code, pc, ATR.EaOf(b), greedy, r1, inp);
                      assert CE.PSize(t1ck) == CE.PSize(tc);
                      assert CE.PSize(t1ck) < CE.PSize(t);
                      var sub := ActionsTreeRepLkF(rer, qm, ia, code, pc + 1, inp, b, t1ck, ni);
                      tcan := LT.GroupActionT(g, sub);
                      // erasure: ProgErase(sub) == ProgErase(t1ck) == ProgErase(tc)
                      // (BoolCheckInsert's insertion is Progress-only); tr_reset at pc
                      assert CE.ProgErase(sub) == CE.ProgErase(tc);
                      assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                    case _ =>
                  }
                }
              case NN(kx) =>
                var em := AR.NfaRepLQuantInv(rer, qm, greedy, min, kx, r1, code, pc, pcmid);
                var quant1 := L.Quantified(greedy, min - 1, delta, r1);
                var eb: nat :| (exists qid: int ::
                      NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                      && qid in qm.quants && qm.quants[qid] == gidl)
                  && AR.NfaRepL(rer, qm, r1, code, pc + 1, eb)
                  && AR.NfaRepMinL(rer, qm, min - 1, r1, code, eb, em);
                AR.NfaRepLQuantIntro(rer, qm, greedy, min - 1, kx, r1, code, eb, em, pcmid);
                assert AR.NfaRepL(rer, qm, quant1, code, eb, pcmid);
                match t {
                  case GroupActionT(g, tc) =>
                    assert g == LG.Reset(gidl);
                    EL.PikeLkActionsConsIff(LS.Areg(quant1), cont);
                    EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(quant1)] + cont);
                    ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                    assert AR.ActionRepL(rer, qm, LS.Areg(quant1), code, eb, pcmid);
                    var lq1 := [LS.Areg(quant1)] + cont;
                    assert lq1[0] == LS.Areg(quant1) && lq1[1..] == cont;
                    assert AR.ActionsRepL(rer, qm, lq1, code, eb);
                    var ia := [LS.Areg(r1)] + lq1;
                    assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, eb);
                    assert ia[0] == LS.Areg(r1) && ia[1..] == lq1;
                    assert AR.ActionsRepL(rer, qm, ia, code, pc + 1);
                    assert ia == [LS.Areg(r1), LS.Areg(quant1)] + cont;
                    ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 1);
                    var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 1, ni);
                    WO.WalkOkQuantForced(acts, code, pc, ATR.EaOf(b), greedy, min, delta, r1);
                    assert CE.PSize(tc) < CE.PSize(t);
                    var sub := ActionsTreeRepLkF(rer, qm, ia, code, pc + 1, inp, b, tc, ni);
                    tcan := LT.GroupActionT(g, sub);
                    // tr_reset at pc
                    assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                  case _ =>
                }
            }
            return;
          }
          if delta.NN? {
            var k := delta.n;
            var em := AR.NfaRepLQuantInv(rer, qm, greedy, 0, k, r1, code, pc, pcmid);
            assert em == pc;
            if k == 0 {
              // spent quantifier: transparent, peel
              assert pc == pcmid;
              WO.WalkOkQuantSpent(acts, code, pc, ATR.EaOf(b), greedy, r1);
              assert LS.ActionsRegexSize(cont) < LS.ActionsRegexSize(acts);
              assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
              tcan := ActionsTreeRepLkF(rer, qm, cont, code, pcmid, inp, b, t, n - 1);
            } else {
              // one bounded layer: the fork skips to the common end pcmid
              var quant := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
              assert quant == L.Quantified(greedy, 0, LN.NN(k - 1), r1);
              var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, pcmid) else RB.Fork(pcmid, pc + 1))
                && (exists qid: int ::
                      NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                      && qid in qm.quants && qm.quants[qid] == gidl)
                && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                && AR.NfaRepOptL(rer, qm, k - 1, greedy, r1, code, e1 + 1, pcmid);
              AR.NfaRepIncrL(rer, qm, r1, code, pc + 3, e1);
              AR.NfaRepIncrOptL(rer, qm, k - 1, greedy, r1, code, e1 + 1, pcmid);
              match t {
                case Choice(ta, tb) =>
                  var itert := if greedy then ta else tb;
                  var skipt := if greedy then tb else ta;
                  match itert {
                    case GroupActionT(g, ti) =>
                      assert g == LG.Reset(gidl);
                      WO.WalkOkQuantLayer(acts, code, pc, ATR.EaOf(b), greedy, delta, r1,
                                          if greedy then pc + 1 else pcmid,
                                          if greedy then pcmid else pc + 1, inp);
                      // skip branch: cont at the common end pcmid
                      assert CE.PSize(skipt) < CE.PSize(t);
                      var subs := ActionsTreeRepLkF(rer, qm, cont, code, pcmid, inp, b, skipt, n - 1);
                      // iteration branch at pc+3 with the NN(k-1) continuation at e1+1
                      EL.PikeLkActionsConsIff(LS.Areg(quant), cont);
                      EL.PikeLkActionsConsIff(LS.Acheck(inp), [LS.Areg(quant)] + cont);
                      EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
                      ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                      var lq := [LS.Areg(quant)] + cont;
                      assert AR.NfaRepMinL(rer, qm, 0, r1, code, e1 + 1, e1 + 1);
                      AR.NfaRepLQuantIntro(rer, qm, greedy, 0, k - 1, r1, code, e1 + 1, e1 + 1, pcmid);
                      assert AR.ActionRepL(rer, qm, LS.Areg(quant), code, e1 + 1, pcmid);
                      assert lq[0] == LS.Areg(quant) && lq[1..] == cont;
                      assert AR.ActionsRepL(rer, qm, lq, code, e1 + 1);
                      var lc := [LS.Acheck(inp)] + lq;
                      assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1, e1 + 1);
                      assert lc[0] == LS.Acheck(inp) && lc[1..] == lq;
                      assert AR.ActionsRepL(rer, qm, lc, code, e1);
                      var ia := [LS.Areg(r1)] + lc;
                      assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 3, e1);
                      assert ia[0] == LS.Areg(r1) && ia[1..] == lc;
                      assert AR.ActionsRepL(rer, qm, ia, code, pc + 3);
                      assert ia == [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont;
                      ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 3);
                      var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 3, ni);
                      assert CE.PSize(ti) < CE.PSize(t);
                      var subi := ActionsTreeRepLkF(rer, qm, ia, code, pc + 3, inp, BS.CannotExit, ti, ni);
                      // assemble: subi at pc+3 (false) -> tr_begin at pc+2 ->
                      // tr_reset at pc+1 -> tr_choice with the skip at pcmid
                      assert TreeRepLkRE(rer, qm, code, inp, subi, pc + 3, false);
                      assert TreeRepLkRE(rer, qm, code, inp, subi, pc + 2, ATR.EaOf(b));
                      var iterstar := LT.GroupActionT(g, subi);
                      assert TreeRepLkRE(rer, qm, code, inp, iterstar, pc + 1, ATR.EaOf(b));
                      tcan := if greedy then LT.Choice(iterstar, subs) else LT.Choice(subs, iterstar);
                      assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                      assert CE.ProgErase(iterstar) == CE.ProgErase(itert);
                      assert CE.ProgErase(tcan) == CE.ProgErase(t);
                    case _ =>
                  }
                case _ =>
              }
            }
            return;
          }
          assert min == 0 && delta == LN.Inf;
          var quant := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
          assert quant == L.Quantified(greedy, 0, LN.Inf, r1) == L.Quantified(greedy, min, delta, r1);
          if exists e1: nat :: NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                       && (exists qid: int ::
                             NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                             && qid in qm.quants && qm.quants[qid] == gidl)
                       && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                       && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                       && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                       && pcmid == e1 + 2 {
            // the star FAST PATH (forward decision point)
            var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                         && (exists qid: int ::
                               NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                               && qid in qm.quants && qm.quants[qid] == gidl)
                         && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                         && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                         && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                         && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                         && pcmid == e1 + 2;
            AR.NfaRepIncrL(rer, qm, r1, code, pc + 3, e1);
            match t {
              case Choice(ta, tb) =>
                var itert := if greedy then ta else tb;
                var skipt := if greedy then tb else ta;
                match itert {
                  case GroupActionT(g, ti) =>
                    assert g == LG.Reset(gidl);
                    WO.WalkOkQuantLayer(acts, code, pc, ATR.EaOf(b), greedy, delta, r1,
                                        if greedy then pc + 1 else pcmid,
                                        if greedy then pcmid else pc + 1, inp);
                    // skip branch at pcmid == e1+2
                    assert CE.PSize(skipt) < CE.PSize(t);
                    var subs := ActionsTreeRepLkF(rer, qm, cont, code, pcmid, inp, b, skipt, n - 1);
                    // iteration branch: [Areg r1, Acheck inp, Areg quant] + cont at pc+3
                    EL.PikeLkActionsConsIff(LS.Areg(quant), cont);
                    EL.PikeLkActionsConsIff(LS.Acheck(inp), [LS.Areg(quant)] + cont);
                    EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
                    ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                    var lq := [LS.Areg(quant)] + cont;
                    assert AR.ActionRepL(rer, qm, LS.Areg(quant), code, pc, pcmid);
                    assert lq[0] == LS.Areg(quant) && lq[1..] == cont;
                    assert AR.ActionsRepL(rer, qm, lq, code, pc);
                    AR.ActionsRepLJmp(rer, qm, lq, code, e1 + 1, pc);
                    var lc := [LS.Acheck(inp)] + lq;
                    assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1, e1 + 1);
                    assert lc[0] == LS.Acheck(inp) && lc[1..] == lq;
                    assert AR.ActionsRepL(rer, qm, lc, code, e1);
                    var ia := [LS.Areg(r1)] + lc;
                    assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 3, e1);
                    assert ia[0] == LS.Areg(r1) && ia[1..] == lc;
                    assert AR.ActionsRepL(rer, qm, ia, code, pc + 3);
                    assert ia == [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont;
                    ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 3);
                    var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 3, ni);
                    assert CE.PSize(ti) < CE.PSize(t);
                    var subi := ActionsTreeRepLkF(rer, qm, ia, code, pc + 3, inp, BS.CannotExit, ti, ni);
                    // assemble: tr_begin at pc+2, tr_reset at pc+1, tr_choice at pc
                    assert TreeRepLkRE(rer, qm, code, inp, subi, pc + 3, false);
                    assert TreeRepLkRE(rer, qm, code, inp, subi, pc + 2, ATR.EaOf(b));
                    var iterstar := LT.GroupActionT(g, subi);
                    assert TreeRepLkRE(rer, qm, code, inp, iterstar, pc + 1, ATR.EaOf(b));
                    tcan := if greedy then LT.Choice(iterstar, subs) else LT.Choice(subs, iterstar);
                    assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                    assert CE.ProgErase(iterstar) == CE.ProgErase(itert);
                    assert CE.ProgErase(tcan) == CE.ProgErase(t);
                  case _ =>
                }
              case _ =>
            }
          } else {
            // the LOOP VIEW: a bare star at the do-while's backward fork.
            // WalkOk pins the flag to CanExit; the fused fork lemma builds the
            // Choice and tr_plus consumes the PLANTED Progress with the fork.
            assert NUL.NonNullableL(r1);
            var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em))
              && em <= pc
              && (exists qid: int ::
                    NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                    && qid in qm.quants && qm.quants[qid] == gidl)
              && AR.NfaRepL(rer, qm, r1, code, em + 1, pc)
              && pcmid == pc + 1;
            WO.WalkOkLoopView(acts, code, pc, ATR.EaOf(b), greedy, LN.Inf, r1,
                              if greedy then em else pc + 1,
                              if greedy then pc + 1 else em, inp);
            assert ATR.EaOf(b) == true;
            assert b == BS.CanExit;
            assert AR.BackForkAt(code, pc);
            var sub := AtBackForkTreeLkF(rer, qm, acts, code, pc, inp, t, n);
            tcan := LT.Progress(sub);
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
          }
        }
        case Group(gid, r1) => {
          EL.PikeLkActionsConsIff(LS.Aclose(gid), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Aclose(gid)] + cont);
          var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(gid as int)))
                       && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(gid as int)))
                       && pcmid == e1 + 1;
          match t {
            case GroupActionT(g, tc) =>
              assert g == LG.Open(gid);
              WO.WalkOkGroup(acts, code, pc, ATR.EaOf(b), gid, r1);
              var lc := [LS.Aclose(gid)] + cont;
              assert AR.ActionRepL(rer, qm, LS.Aclose(gid), code, e1, e1 + 1);
              assert lc[0] == LS.Aclose(gid) && lc[1..] == cont;
              ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
              assert AR.ActionsRepL(rer, qm, lc, code, e1);
              var ga := [LS.Areg(r1)] + lc;
              assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, e1);
              assert ga[0] == LS.Areg(r1) && ga[1..] == lc;
              assert AR.ActionsRepL(rer, qm, ga, code, pc + 1);
              assert ga == [LS.Areg(r1), LS.Aclose(gid)] + cont;
              ATR.ActionsRepLToFuel(rer, qm, ga, code, pc + 1);
              var ng: nat :| ATR.ActionsRepFuelL(rer, qm, ga, code, pc + 1, ng);
              assert CE.PSize(tc) < CE.PSize(t);
              var sub := ActionsTreeRepLkF(rer, qm, ga, code, pc + 1, inp, b, tc, ng);
              tcan := LT.GroupActionT(g, sub);
              // tr_open
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case _ =>
          }
        }
        case AnchorR(la) => {
          var ra: R.anchor :| NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(ra))
                              && T.TrAnchor(ra) == la;
          if LS.AnchorSatisfied(rer, la, inp) {
            match t {
              case AnchorPass(la2, tc) =>
                assert la2 == la;
                WO.WalkOkAnchor(acts, code, pc, ATR.EaOf(b));
                assert CE.PSize(tc) < CE.PSize(t);
                var sub := ActionsTreeRepLkF(rer, qm, cont, code, pc + 1, inp, b, tc, n - 1);
                tcan := LT.AnchorPass(la2, sub);
                // tr_anchorpass (Linden-side satisfaction, anchor pinned via ra)
                assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
              case _ =>
            }
          } else {
            // t == Mismatch; tr_anchorfail via ra
            tcan := LT.Mismatch;
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
          }
        }
        case LookaroundR(lk, r1) => {
          // THE GATE. NfaRepL pins the oracle instruction + the looks-table
          // row; TreeRepLkRE's gate rule is decided by the same FUNCTIONAL
          // verdict BoolTreeLk's LkGateOk used — no oracle bit involved. The
          // node is KEPT with the RAW functional body.
          var lid: int :| NR.GetPcRE(code, pc)
                            == Some(if AR.PositiveL(lk) then RB.CheckOracle(lid)
                                                        else RB.NegCheckOracle(lid))
                          && lid in qm.looks && qm.looks[lid] == (lk, r1);
          assert pcmid == pc + 1;
          var tlkc := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
          match t {
            case LK(lk2, tlk, tc) =>
              assert lk2 == lk && tlk == tlkc && LS.LkResult(lk, tlk, LG.Empty, inp).Some?;
              WO.WalkOkLookaround(acts, code, pc, ATR.EaOf(b));
              assert CE.PSize(tc) < CE.PSize(t);
              var sub := ActionsTreeRepLkF(rer, qm, cont, code, pc + 1, inp, b, tc, n - 1);
              tcan := LT.LK(lk, tlkc, sub);
              // tr_lk
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case LKFail(lk2, tlk) =>
              assert lk2 == lk && tlk == tlkc && LS.LkResult(lk, tlk, LG.Empty, inp).None?;
              // tr_lkfail: direct, no recursion
              tcan := LT.LKFail(lk, tlkc);
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case _ =>
          }
        }
        case Backreference(gid) =>   // not pike
    }
  }

  /** The fused fork lemma: at the do-while's backward fork with the walk
      allowed to exit, builds the canonical Choice whose PLANTED `Progress`
      wrapper is consumed by `tr_plus` together with the fork. Mirror of
      `ATR.AtBackForkTreeRep`: pops `Acheck`/`Epsilon`/`Sequence`/spent heads;
      every other head shape contradicts the pinned Fork; at the loop-view
      star the iteration is lifted to `CanExit` (`CE.BoolFlagLift`) and both
      branches delegate to the general construction. */
  lemma AtBackForkTreeLkF(rer: LW.RegExpRecord, qm: AR.QMap, acts: LS.Actions, code: RB.code,
                          pc: nat, inp: LC.Input, tc: LT.Tree, n: nat)
    returns (tcstar: LT.Tree)
    requires EL.PikeLkActions(acts)
    requires ATR.ActionsRepFuelL(rer, qm, acts, code, pc, n)
    requires WO.WalkOk(acts, code, pc, true)
    requires EL.BoolTreeLk(rer, acts, inp, BS.CanExit, tc)
    requires AR.BackForkAt(code, pc)
    ensures TreeRepLkRE(rer, qm, code, inp, LT.Progress(tcstar), pc, true)
    ensures CE.ProgErase(tcstar) == CE.ProgErase(tc)
    decreases CE.PSize(tc), ATR.MsizeA(acts), n, 0
  {
    var fx: int, fy: int :| NR.GetPcRE(code, pc) == Some(RB.Fork(fx, fy))
      && fx >= 0 && fy >= 0 && (fx as nat <= pc || fy as nat <= pc);
    assert |acts| > 0;
    var cont := acts[1..];
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid)
      && ATR.ActionsRepFuelL(rer, qm, cont, code, pcmid, n - 1);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + cont;
    EL.PikeLkActionsConsIff(acts[0], cont);
    match acts[0]
    case Acheck(strcheck) =>
      // a stacked check: zero-width at the fork; its Progress collapses into
      // the single planted guard
      assert pcmid == pc;
      assert LS.ActionsRegexSize(acts) == LS.ActionsRegexSize(cont);
      match tc {
        case Progress(tc2) =>
          WO.WalkOkAcheckBackFork(acts, code, pc, true);
          tcstar := AtBackForkTreeLkF(rer, qm, cont, code, pc, inp, tc2, n - 1);
          assert CE.ProgErase(tc) == CE.ProgErase(tc2);
        case _ =>
      }
    case Aclose(gid) =>
      assert false;   // SetRegisterToCP != Fork
    case Areg(r) =>
      assert EL.PikeLkRegex(r);
      match r
      case Epsilon =>
        assert pcmid == pc;
        WO.WalkOkEpsilon(acts, code, pc, true);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        tcstar := AtBackForkTreeLkF(rer, qm, cont, code, pc, inp, tc, n - 1);
      case Character(cd) =>
        var ce :| NR.GetPcRE(code, pc) == Some(RB.Consume(ce)) && AR.ExpectationMatches(rer, ce, cd);
        assert false;   // Consume != Fork
      case AnchorR(la) =>
        var ra: R.anchor :| NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(ra)) && T.TrAnchor(ra) == la;
        assert false;   // AnchorAssertion != Fork
      case Disjunction(r1, r2) =>
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.Fork(pc + 1, e1 + 1))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid))
          && AR.NfaRepL(rer, qm, r2, code, e1 + 1, pcmid);
        AR.NfaRepIncrL(rer, qm, r1, code, pc + 1, e1);
        assert false;   // both arms forward: contradicts the backward arm
      case Sequence(r1, r2) =>
        EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
        EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        assert AR.ActionRepL(rer, qm, LS.Areg(r2), code, e1, pcmid);
        assert ([LS.Areg(r2)] + cont)[0] == LS.Areg(r2) && ([LS.Areg(r2)] + cont)[1..] == cont;
        ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
        assert AR.ActionsRepL(rer, qm, [LS.Areg(r2)] + cont, code, e1);
        assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc, e1);
        assert na[0] == LS.Areg(r1) && na[1..] == [LS.Areg(r2)] + cont;
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert LS.ActionsRegexSize(na) < LS.ActionsRegexSize(acts);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        ATR.ActionsRepLToFuel(rer, qm, na, code, pc);
        var nn: nat :| ATR.ActionsRepFuelL(rer, qm, na, code, pc, nn);
        WO.WalkOkSeq(acts, code, pc, true, r1, r2);
        tcstar := AtBackForkTreeLkF(rer, qm, na, code, pc, inp, tc, nn);
      case Quantified(greedy, min, delta, r1) =>
        var gidl := L.DefGroups(r1);
        if min > 0 {
          match delta {
            case Inf =>
              var em, e1x := AR.NfaRepLPlusInv(rer, qm, greedy, min, r1, code, pc, pcmid);
              if em == pc {
                assert false;    // SetQuantToClock != Fork
              } else {
                var eb: nat :| (exists qid: int ::
                      NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                      && qid in qm.quants && qm.quants[qid] == gidl)
                  && AR.NfaRepL(rer, qm, r1, code, pc + 1, eb)
                  && AR.NfaRepMinL(rer, qm, min - 2, r1, code, eb, em);
                assert false;    // SetQuantToClock != Fork
              }
            case NN(kx) =>
              var em := AR.NfaRepLQuantInv(rer, qm, greedy, min, kx, r1, code, pc, pcmid);
              var eb: nat :| (exists qid: int ::
                    NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                    && qid in qm.quants && qm.quants[qid] == gidl)
                && AR.NfaRepL(rer, qm, r1, code, pc + 1, eb)
                && AR.NfaRepMinL(rer, qm, min - 1, r1, code, eb, em);
              assert false;      // SetQuantToClock != Fork
          }
        } else if delta.NN? {
          var k := delta.n;
          var em := AR.NfaRepLQuantInv(rer, qm, greedy, 0, k, r1, code, pc, pcmid);
          assert em == pc;
          if k == 0 {
            assert pc == pcmid;
            WO.WalkOkQuantSpent(acts, code, pc, true, greedy, r1);
            assert LS.ActionsRegexSize(cont) < LS.ActionsRegexSize(acts);
            assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
            tcstar := AtBackForkTreeLkF(rer, qm, cont, code, pc, inp, tc, n - 1);
          } else {
            var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, pcmid) else RB.Fork(pcmid, pc + 1))
              && (exists qid: int ::
                    NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                    && qid in qm.quants && qm.quants[qid] == gidl)
              && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
              && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
              && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
              && AR.NfaRepOptL(rer, qm, k - 1, greedy, r1, code, e1 + 1, pcmid);
            AR.NfaRepIncrL(rer, qm, r1, code, pc + 3, e1);
            AR.NfaRepIncrOptL(rer, qm, k - 1, greedy, r1, code, e1 + 1, pcmid);
            assert false;   // a bounded layer pins a FORWARD fork
          }
        } else {
          assert min == 0 && delta == LN.Inf;
          if exists e1: nat :: NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                       && (exists qid: int ::
                             NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                             && qid in qm.quants && qm.quants[qid] == gidl)
                       && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                       && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                       && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                       && pcmid == e1 + 2 {
            var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
              && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
              && pcmid == e1 + 2;
            AR.NfaRepIncrL(rer, qm, r1, code, pc + 3, e1);
            assert false;   // the fast path pins a forward fork
          } else {
            // THE LOOP VIEW: the star seen from the fork itself
            assert NUL.NonNullableL(r1);
            var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em))
              && em <= pc
              && (exists qid: int ::
                    NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                    && qid in qm.quants && qm.quants[qid] == gidl)
              && AR.NfaRepL(rer, qm, r1, code, em + 1, pc)
              && pcmid == pc + 1;
            var qid: int :| NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
              && qid in qm.quants && qm.quants[qid] == gidl;
            var q0 := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
            assert q0 == L.Quantified(greedy, 0, LN.Inf, r1) == r;
            WO.WalkOkLoopView(acts, code, pc, true, greedy, LN.Inf, r1,
                              if greedy then em else pc + 1,
                              if greedy then pc + 1 else em, inp);
            match tc {
              case Choice(cta, ctb) =>
                var itert := if greedy then cta else ctb;
                var skipt := if greedy then ctb else cta;
                match itert {
                  case GroupActionT(g, ti) =>
                    assert g == LG.Reset(gidl);
                    var il := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q0)] + cont;
                    assert EL.BoolTreeLk(rer, il, inp, BS.CannotExit, ti);
                    // skip branch: the general construction at the exit arm
                    assert CE.PSize(skipt) < CE.PSize(tc);
                    var subs := ActionsTreeRepLkF(rer, qm, cont, code, pc + 1, inp, BS.CanExit, skipt, n - 1);
                    // iteration branch: lift to CanExit, then bridge
                    EL.PikeLkActionsConsIff(LS.Areg(q0), cont);
                    EL.PikeLkActionsConsIff(LS.Acheck(inp), [LS.Areg(q0)] + cont);
                    EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q0)] + cont));
                    assert il == [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q0)] + cont));
                    assert EL.PikeLkActions(il);
                    assert CE.ShieldedActs(il) by {
                      forall i | 0 <= i < |il| && il[i].Acheck?
                        ensures exists j :: 0 <= j < i && il[j].Areg? && NUL.NonNullableL(il[j].r)
                      {
                        assert il[0] == LS.Areg(r1);
                        assert i > 0;
                        assert il[0].Areg? && NUL.NonNullableL(il[0].r);
                      }
                    }
                    CE.BoolFlagLift(rer, il, inp, ti);
                    assert EL.BoolTreeLk(rer, il, inp, BS.CanExit, ti);
                    // representation of the iteration list at em+1
                    ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                    var lq := [LS.Areg(q0)] + cont;
                    assert AR.NfaRepL(rer, qm, q0, code, pc, pc + 1) by {
                      assert NUL.NonNullableL(r1)
                        && NR.GetPcRE(code, pc)
                           == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em))
                        && em <= pc
                        && (exists qid2: int ::
                              NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid2, false))
                              && qid2 in qm.quants && qm.quants[qid2] == L.DefGroups(r1))
                        && AR.NfaRepL(rer, qm, r1, code, em + 1, pc);
                    }
                    assert AR.ActionRepL(rer, qm, LS.Areg(q0), code, pc, pc + 1);
                    assert lq[0] == LS.Areg(q0) && lq[1..] == cont;
                    assert AR.ActionsRepL(rer, qm, lq, code, pc);
                    var lc := [LS.Acheck(inp)] + lq;
                    assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, pc, pc);
                    assert lc[0] == LS.Acheck(inp) && lc[1..] == lq;
                    assert AR.ActionsRepL(rer, qm, lc, code, pc);
                    assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, em + 1, pc);
                    assert il == [LS.Areg(r1)] + lc;
                    assert il[0] == LS.Areg(r1) && il[1..] == lc;
                    assert AR.ActionsRepL(rer, qm, il, code, em + 1);
                    ATR.ActionsRepLToFuel(rer, qm, il, code, em + 1);
                    var ni: nat :| ATR.ActionsRepFuelL(rer, qm, il, code, em + 1, ni);
                    assert CE.PSize(ti) < CE.PSize(tc);
                    var subi := ActionsTreeRepLkF(rer, qm, il, code, em + 1, inp, BS.CanExit, ti, ni);
                    // assemble: tr_reset at the stamp, then tr_plus at the
                    // fork — arms at (em, true)/(pc+1, true), the planted
                    // Progress consumed with the Choice
                    assert TreeRepLkRE(rer, qm, code, inp, subi, em + 1, true);
                    var iterstar := LT.GroupActionT(g, subi);
                    assert TreeRepLkRE(rer, qm, code, inp, iterstar, em, true);
                    tcstar := if greedy then LT.Choice(iterstar, subs) else LT.Choice(subs, iterstar);
                    assert TreeRepLkRE(rer, qm, code, inp, LT.Progress(tcstar), pc, true);
                    assert CE.ProgErase(iterstar) == CE.ProgErase(itert);
                    assert CE.ProgErase(tcstar) == CE.ProgErase(tc);
                  case _ =>
                }
              case _ =>
            }
          }
        }
      case Group(gid, r1) =>
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(gid as int)))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(gid as int)))
          && pcmid == e1 + 1;
        assert false;   // SetRegisterToCP != Fork
      case LookaroundR(lk, r1) =>
        var lid: int :| NR.GetPcRE(code, pc)
                          == Some(if AR.PositiveL(lk) then RB.CheckOracle(lid)
                                                      else RB.NegCheckOracle(lid))
                        && lid in qm.looks && qm.looks[lid] == (lk, r1);
        assert false;   // CheckOracle/NegCheckOracle != Fork
      case Backreference(_) =>     // not pike
  }

  /** The construction, fuel-free: from a represented, walk-guarded stack's
      `BoolTreeLk` tree, the PLANTED canonical tree machine B runs — unique
      per `(pc, ea)` (`TreeRepLkDetermRE`) and leaf-equal to the spec tree
      (erasure-equal, then `ProgEraseLeavesEq`). THE ONE INVOCATION SITE is
      the entry pairing (`WkE.WalkOkEntry` supplies `WalkOk` there);
      downstream the canonical tie is maintained by per-instruction
      `TreeRepLkRE` inversions, never by re-running this. */
  lemma ActionsTreeRepLkRE(rer: LW.RegExpRecord, qm: AR.QMap, acts: LS.Actions, code: RB.code,
                           pc: nat, inp: LC.Input, b: BS.LoopBool, t: LT.Tree)
    returns (tcan: LT.Tree)
    requires EL.PikeLkActions(acts)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires WO.WalkOk(acts, code, pc, ATR.EaOf(b))
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    ensures TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b))
    ensures CE.ProgErase(tcan) == CE.ProgErase(t)
  {
    ATR.ActionsRepLToFuel(rer, qm, acts, code, pc);
    var n: nat :| ATR.ActionsRepFuelL(rer, qm, acts, code, pc, n);
    tcan := ActionsTreeRepLkF(rer, qm, acts, code, pc, inp, b, t, n);
  }

  /** (1) t-side determinism — QUOTIENTED (2026-08-05). The exact-tree
      statement is FALSE (see the section header above: Progress-planting at
      backward forks). The TRUE statement is confluence MODULO `ProgErase`,
      which is what the seen/skip pairing actually needs once B's memo is
      keyed on erased trees. FILL: bridge `ActionsRepL + BoolTreeLk ⟹
      ETreeRepLk(CE.ProgErase(t))` (mirror `ActionsTreeRepFRE`'s fuel induction,
      LK nodes kept, no tstar construction), then `ETreeRepLkDeterm` closes.
      The bridge needs the b == CanExit side condition at backward-fork heads
      (from `NonNullableL` of loop-view bodies inductively; at the TOP from
      the invariant fact that VM threads at a `BackForkAt` pc have
      `exit_allowed` — carried in `LiftInvC`). */
  lemma TtLkSameTree(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                     t1: LT.Tree, t2: LT.Tree, pc: nat, ea: bool)
    requires !rer.multiline
    requires TtLk(rer, qm, code, inp, t1, pc, ea)
    requires TtLk(rer, qm, code, inp, t2, pc, ea)
    ensures CE.ProgErase(t1) == CE.ProgErase(t2)

  /** FRAME for GateStepValue's non-owned-group carry: a positive gate's merged
      map `LkResult(lk, tlk, gmt, inp).value` differs from the incoming `gmt`
      ONLY on the body's own `DefGroups(r1)` — the body tree is confined there
      (`LL.ComputeTrConfined`), so every leaf (and hence the first-leaf merge)
      agrees with `gmt` outside it. Lets the gate-step reuse the standing
      `GmtTieInside` for lids other than the one being crossed. */
  lemma LkResultAgreeOutside(rer: LW.RegExpRecord, lk: L.Lookaround, r1: L.Regex, inp: LC.Input,
                             tlk: LT.Tree, gmt: LG.GroupMap)
    requires L.Positivity(lk)
    requires EL.NoLkBrL(r1)
    requires tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk))
    requires LS.LkResult(lk, tlk, gmt, inp).Some?
    ensures LL.GmAgreeOutside(LS.LkResult(lk, tlk, gmt, inp).value, gmt,
                              set g | g in L.DefGroups(r1))
  {
    var S := set g | g in L.DefGroups(r1);
    assert LL.DefGroupsIn(r1, S);
    LL.ComputeTrConfined(rer, r1, inp, LG.Empty, L.LkDir(lk), S);   // GmConfinedTree(tlk, S)
    var dir := L.LkDir(lk);
    var tr := LT.TreeRes(tlk, gmt, inp, dir);
    // positive-gate unfold: LkResult.value == TreeRes(tlk, gmt, inp, dir).value.1
    assert LS.LkResult(lk, tlk, gmt, inp).value == tr.value.1;
    LT.FirstTreeLeaf(tlk, gmt, inp, dir);                           // tr == HdError(TreeLeaves)
    var leaves := LT.TreeLeaves(tlk, gmt, inp, dir);
    assert |leaves| > 0 && tr.value == leaves[0];
    LL.GmConfinedLeaves(tlk, gmt, inp, dir, S);                     // each leaf agrees gmt outside S
    assert LL.GmAgreeOutside(leaves[0].1, gmt, S);
  }

  /** (L4 NESTED) `LkResultAgreeOutside` for a look body that may itself contain
      nested looks: the depth-1 `NoLkBrL(r1)` (body look-free) is replaced by
      the recursive `EL.PikeLkRegexRec(r1)`, and the confinement walk uses the
      depth-k `ComputeTrConfinedRec`/`GmConfinedLeavesRec` (recursive
      `LkConfinedTreeRec`) — the outer tree still writes only `DefGroups(r1)`, so
      the outside-S agreement is identical. */
  lemma LkResultAgreeOutsideNested(rer: LW.RegExpRecord, lk: L.Lookaround, r1: L.Regex, inp: LC.Input,
                             tlk: LT.Tree, gmt: LG.GroupMap)
    requires L.Positivity(lk)
    requires EL.PikeLkRegexRec(r1)
    requires tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk))
    requires LS.LkResult(lk, tlk, gmt, inp).Some?
    ensures LL.GmAgreeOutside(LS.LkResult(lk, tlk, gmt, inp).value, gmt,
                              set g | g in L.DefGroups(r1))
  {
    var S := set g | g in L.DefGroups(r1);
    assert LL.DefGroupsIn(r1, S);
    LL.ComputeTrConfinedRec(rer, r1, inp, LG.Empty, L.LkDir(lk), S);   // LkConfinedTreeRec(tlk, S)
    var dir := L.LkDir(lk);
    var tr := LT.TreeRes(tlk, gmt, inp, dir);
    // positive-gate unfold: LkResult.value == TreeRes(tlk, gmt, inp, dir).value.1
    assert LS.LkResult(lk, tlk, gmt, inp).value == tr.value.1;
    LT.FirstTreeLeaf(tlk, gmt, inp, dir);                           // tr == HdError(TreeLeaves)
    var leaves := LT.TreeLeaves(tlk, gmt, inp, dir);
    assert |leaves| > 0 && tr.value == leaves[0];
    LL.GmConfinedLeavesRec(tlk, gmt, inp, dir, S);                  // each leaf agrees gmt outside S
    assert LL.GmAgreeOutside(leaves[0].1, gmt, S);
  }

  /** (2) THE GATE VALUE STEP — the crux, and it is the PROVEN keystone
      re-packaged. When the VM crosses `CheckOracle(l)` at `cp` (writing
      `a_cp[l] := cp` with the bit set), the B head's LK node dissolves and the
      merged `LkResult` values on the body's groups equal the FRESH REPLAY at
      the just-written `a_cp[l]` — i.e. `GmtTieInside` is re-established for
      the new entries, and `GateAheadClear` supplies the keystone's
      `GmAgreeOn(gmt, Empty, DefGroups(body))` hypothesis.
      FILL: instantiate `M.LkReplayMatchesSpec` at `cp`; the per-lid static
      package (`StaticOkRE`/`SizesOkRE`/body compile/`LookEntryOk`) comes from
      `M.LookRowsFromTablesL3a`'s bundle; `CM.RegsAgreeInside(cap, init,
      CaptureRegs(body))` from the standing `LooksCapUnset` +
      `CaptureBytecodeClassifiedOutside`; `OracleOkSuffix` via
      `LL.OracleOkSuffixStep`. The statement below is the SEAM to adjust
      against the keystone's exact ensures.

      FILL RECIPE (reverse-engineered 2026-08-03): this does NOT need the walk
      peel — it is a pure value step. `M.LkReplayMatchesSpec` (MainTheorem.dfy:
      4253) is the keystone; its ensures ties `LS.LkResult(TrLookaround(la),
      tlk, gmMain, inp).value` to `PIV.GmOfLive(body, rf.captures...)` on
      `S' = DefGroups(Translate(body))`, with `rf = FFindMatch(bodycode, ...,
      init regs at cp)` — which is EXACTLY `M.FreshBodyMatch(crv,str,l,...)`.
      So: (1) SIGNATURE IS UNDERSPECIFIED — add the keystone's requires (its
      static package from `LookRowsFromTablesL3a`, `body == VBody(crv,l)`,
      `bodycode == compile_to_bytecode(body)`, `LookFreeRE(body)`,
      `RegsAgreeInside(cap,init,CaptureRegs(body))`, and note `gmMain := gmt`).
      The `GmAgreeOn(gmt, Empty, DefGroups(Translate(body)))` keystone hyp IS
      the `GateAheadClear`-derived `forall g in DefGroups(r1) ==> g !in gmt`
      requires already present (Empty and gmt agree on absent groups).
      (2) SPLIT g in S ∩ gmt2 by owner: g owned by l ⇒ new value via keystone;
      g owned by l'' != l ⇒ preserved from GmtTieInside(th) since th2 only
      changed a_cp[l] and FreshBodyMatch(l'') reads only a_cp[l''] (stable);
      owner uniqueness from `M.LmOfBodiesDisjoint`. `MatchedPosLA(th2,l)` holds
      because th2 set look_regs[l] := Some(cp).

      READY-TO-WRITE RECIPE (2026-08-03 — every ingredient located/verified):
      add params `body, la, bodycode, endl, ngroups, qt` + requires
      `r1==T.Translate(body)`, `lk==T.TrLookaround(la)`, `body==M.VBody(crv,l)`,
      `PSM.StaticOkRE(qm,body,bodycode,endl)`, `PSM.SizesOkRE(body,ncap,nlook,
      nquant)`, `bodycode==CP.compile_to_bytecode(body)`, `NR.LookFreeRE(body)`,
      `la.Lookahead?`, `T.TransWf(body)`, `|qt.a_cp|==nquant && |qt.a_clk|==
      nquant`, `LL.OracleOkSuffix(rer,qm,InpOfCp(str,cp))`, and the l-th table
      bounds/type (`0<=l<nlook`, `0<=l<|crv.f_look_{ast,cdns,types}|`,
      `crv.f_look_types[l].Lookahead?`, `AI.capture_type(crv.f_look_types[l])`,
      `RL.ASize(th.look_regs)>l`). BODY:
      (a) tlk bridge: `EL.TranslateNoLkBr(body)` (⇒NoLkBrL(r1)) +
          `EL.ComputeTrGmIndepLk(rer,r1,inp,gmt,Forward)` ⇒ LkGateOk's Empty-tlk
          == keystone's gmt-tlk.
      (b) keystone Empty-hyp: `M.GmAgreeOn(gmt,Empty,DefGroups(r1))` from the
          GateAheadClear requires (g in DefGroups(r1) ⇒ g!in gmt; Empty has none).
      (c) call `M.LkReplayMatchesSpec(rer,qm,body,bodycode,endl,ngroups,str,cp,
          AReg.init_regs(ncap),AReg.init_regs(nlook),qt,ov,crv.f_look_cdns[l],la,
          tlk,gmt,ncap,nlook,nquant)` — cap=init makes RegsAgreeInside reflexive;
          LkResult.Some ⇒ ra.Some ⇒ rf.Some && GmAgreeOn(gmt2,GmOfLive(body,rf),
          DefGroups(Translate(body))). Its rf == M.FreshBodyMatch(crv,str,l,th2)
          because get_cp(th2.look_regs,l)==Some(cp) (RL.ASetLaws) and body/cdn/cp
          align.
      (d) forall g in S∩gmt2: `M.TranslateDefGroupsEqCapIds(body)` (DefGroups(r1)
          ==CapIds(body)==CapIds(VBody(crv,l))); if g in DefGroups(r1) ⇒ owner l
          via keystone GmAgreeOn; else `LkResultAgreeOutside(rer,lk,r1,inp,tlk,
          gmt)` (VERIFIED above) gives gmt2[g]==gmt[g], reduce to GmtTieInside(th)
          with owner l'!=l (l'==l impossible: g!in CapIds(VBody(crv,l))); carry
          MatchedPosLA/FreshBodyMatch across the l-only set_reg via RL.ASetLaws
          (get_cp at l'!=l unchanged ⇒ FreshBodyMatch(l',th2)==FreshBodyMatch(
          l',th)). */
  lemma GateStepValue(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                      crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                      lk: L.Lookaround, r1: L.Regex, tlk: LT.Tree, tb: LT.Tree,
                      gmt: LG.GroupMap, th: AI.Thread, th2: AI.Thread, l: int, cp: nat,
                      body: R.regex, la: R.lookaround, bodycode: RB.code, endl: nat, ngroups: nat,
                      qt: AReg.Regs, ncap: int, nlook: int, nquant: int)
    requires qm.ov == ov && !rer.ignoreCase && !rer.multiline
    requires cp <= |str|
    requires l in qm.looks && qm.looks[l] == (lk, r1)
    requires L.Positivity(lk) && L.LkDir(lk) == WP.Forward
    requires LS.LkResult(lk, tlk, gmt, PIV.InpOfCp(str, cp)).Some?
    requires EL.LkGateOk(rer, lk, r1, PIV.InpOfCp(str, cp), tlk, true)
    // th2 = th with a_cp[l] := cp at some clock stamp (the CheckOracle write)
    requires exists clkv: int {:trigger AReg.set_reg(th.look_regs, l, Some(cp as int), clkv)} ::
      th2 == th.(pc := th.pc + 1,
                 look_regs := AReg.set_reg(th.look_regs, l, Some(cp as int), clkv))
    requires GmtTieInside(crv, str, ov, th, gmt, S, ncap, nlook, nquant)
    requires forall g :: g in L.DefGroups(r1) ==> g !in gmt        // GateAheadClear at this gate
    // --- the keystone's static package + the l-th table identification ---
    requires T.TransWf(body) && NR.LookFreeRE(body) && la.Lookahead?
    requires r1 == T.Translate(body) && lk == T.TrLookaround(la) && body == M.VBody(crv, l)
    requires bodycode == CP.compile_to_bytecode(body)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires 0 <= l < nlook && l < RL.ASize(th.look_regs)
    requires 0 <= l < |crv.f_look_ast| && 0 <= l < |crv.f_look_cdns| && 0 <= l < |crv.f_look_types|
    requires crv.f_look_types[l].Lookahead? && AI.capture_type(crv.f_look_types[l])
    ensures var gmt2 := LS.LkResult(lk, tlk, gmt, PIV.InpOfCp(str, cp)).value;
            GmtTieInside(crv, str, ov, th2, gmt2, S, ncap, nlook, nquant)
  {
    var inp := PIV.InpOfCp(str, cp);
    var tr := T.Translate(body);
    var gmt2 := LS.LkResult(lk, tlk, gmt, inp).value;
    var Sbody := set g | g in L.DefGroups(tr);
    var clkv: int :| th2 == th.(pc := th.pc + 1,
                                look_regs := AReg.set_reg(th.look_regs, l, Some(cp as int), clkv));

    // ---- (a) tlk bridge: LkGateOk's Empty-tlk == keystone's gmt-tlk ----
    EL.TranslateNoLkBr(body);                                // NoLkBrL(tr)
    EL.ComputeTrGmIndepLk(rer, tr, inp, gmt, WP.Forward);    // ComputeTr(tr,gmt) == ComputeTr(tr,Empty)
    assert tlk == LFU.ComputeTr(rer, [LS.Areg(tr)], inp, gmt, WP.Forward);

    // ---- (b) the keystone's Empty-agreement hypothesis from GateAheadClear ----
    assert M.GmAgreeOn(gmt, LG.Empty, Sbody) by {
      forall g | g in Sbody
        ensures (g in gmt <==> g in LG.Empty) && (g in gmt ==> gmt[g] == LG.Empty[g])
      { assert g in L.DefGroups(r1); }
    }

    // ---- (c) invoke the keystone ----
    assert T.TrLookaround(la) == lk;
    M.LkReplayMatchesSpec(rer, qm, body, bodycode, endl, ngroups, str, cp,
                          AReg.init_regs(ncap), AReg.init_regs(nlook), qt, ov,
                          crv.f_look_cdns[l], la, tlk, gmt, ncap, nlook, nquant);
    var rfK := AI.FFindMatch(bodycode, str,
                 AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                               AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                 ov, LAnc.Forward, crv.f_look_cdns[l]).0;
    assert rfK.Some?;
    assert M.GmAgreeOn(gmt2,
             PIV.GmOfLive(body, rfK.value.capture_regs, rfK.value.look_regs, rfK.value.quant_regs), Sbody);

    // ---- rf alignment: FreshBodyMatch(l, th2) == the keystone's rfK ----
    RL.ASetLaws(th.look_regs, l, Some(cp as int), clkv);
    assert AReg.get_cp(th2.look_regs, l) == Some(cp as int);
    assert cp as int == cp;
    var rfl := M.FreshBodyMatch(crv, str, l, th2.look_regs, ov, ncap, nlook, nquant);
    assert rfl == rfK;

    M.TranslateDefGroupsEqCapIds(body);                      // Sbody == CapIds(body) == CapIds(VBody(crv,l))
    assert Sbody == PIV.CapIds(body);

    // ---- (d) re-establish GmtTieInside for th2 / gmt2 ----
    forall g: LG.GroupId | g in S && g in gmt2
      ensures exists l': int ::
        0 <= l' < nlook
        && g in PIV.CapIds(M.VBody(crv, l'))
        && M.MatchedPosLA(crv, th2.look_regs, l')
        && var rf' := M.FreshBodyMatch(crv, str, l', th2.look_regs, ov, ncap, nlook, nquant);
           rf'.Some?
           && var gmb := PIV.GmOfLive(M.VBody(crv, l'), rf'.value.capture_regs,
                                      rf'.value.look_regs, rf'.value.quant_regs);
              var looktype := if 0 <= l' < |crv.f_look_types| then crv.f_look_types[l'] else R.Lookahead;
              g in gmb && gmt2[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb[g]) else gmb[g])
    {
      if g in Sbody {
        // Case A: g is owned by the gate just crossed (lid l), value from the keystone.
        var gmbK := PIV.GmOfLive(body, rfK.value.capture_regs, rfK.value.look_regs, rfK.value.quant_regs);
        assert g in gmbK && gmt2[g] == gmbK[g];              // keystone GmAgreeOn at g in Sbody
        assert g in PIV.CapIds(M.VBody(crv, l));             // Sbody == CapIds(body) == CapIds(VBody(crv,l))
        assert M.MatchedPosLA(crv, th2.look_regs, l);        // get_cp l = Some(cp); type Lookahead
        assert M.VBody(crv, l) == body && rfl == rfK;
        assert 0 <= l < nlook;                               // witness l' = l
      } else {
        // Case B: g owned by a DIFFERENT lid; gmt2 == gmt off Sbody (frame), carry GmtTieInside(th).
        LkResultAgreeOutside(rer, lk, r1, inp, tlk, gmt);    // GmAgreeOutside(gmt2, gmt, Sbody)
        assert g !in Sbody;
        assert g in gmt && gmt2[g] == gmt[g];
        assert exists l'': int ::
          0 <= l'' < nlook && g in PIV.CapIds(M.VBody(crv, l''))
          && M.MatchedPosLA(crv, th.look_regs, l'')
          && var rf'' := M.FreshBodyMatch(crv, str, l'', th.look_regs, ov, ncap, nlook, nquant);
             rf''.Some?
             && var gmb'' := PIV.GmOfLive(M.VBody(crv, l''), rf''.value.capture_regs,
                                          rf''.value.look_regs, rf''.value.quant_regs);
                var looktype := if 0 <= l'' < |crv.f_look_types| then crv.f_look_types[l''] else R.Lookahead;
                g in gmb'' && gmt[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb''[g]) else gmb''[g]);
        var l'': int :|
          0 <= l'' < nlook && g in PIV.CapIds(M.VBody(crv, l''))
          && M.MatchedPosLA(crv, th.look_regs, l'')
          && var rf'' := M.FreshBodyMatch(crv, str, l'', th.look_regs, ov, ncap, nlook, nquant);
             rf''.Some?
             && var gmb'' := PIV.GmOfLive(M.VBody(crv, l''), rf''.value.capture_regs,
                                          rf''.value.look_regs, rf''.value.quant_regs);
                var looktype := if 0 <= l'' < |crv.f_look_types| then crv.f_look_types[l''] else R.Lookahead;
                g in gmb'' && gmt[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb''[g]) else gmb''[g]);
        // l'' != l: else g in CapIds(VBody(crv,l)) == Sbody, contradicting g !in Sbody.
        assert l'' != l by {
          if l'' == l { assert g in PIV.CapIds(M.VBody(crv, l)); }
        }
        // th2 differs from th only at slot l, so l'' reads the SAME cp on both banks.
        RL.ASetLaws(th.look_regs, l, Some(cp as int), clkv);
        assert AReg.get_cp(th2.look_regs, l'') == AReg.get_cp(th.look_regs, l'');
        assert M.MatchedPosLA(crv, th2.look_regs, l'');
        assert M.FreshBodyMatch(crv, str, l'', th2.look_regs, ov, ncap, nlook, nquant)
            == M.FreshBodyMatch(crv, str, l'', th.look_regs, ov, ncap, nlook, nquant);
      }
    }
  }

  /** THE LB TWIN of `GateStepValue`: a thread crossing a passing positive
      LOOKBEHIND gate lifts `GmtTieInside` across the merge to `(th2, gmt2)`. The
      inside-`Sbody` value is the ENDPOINT SWAP of the fresh BACKWARD body match
      (`LBK.BackFreshBodyGmTie`) — `gmt2[g] == SwapRange(gmbK[g])`, exactly the
      `looktype.Lookbehind?` arm of `GmtTieInside`. Case B (off `Sbody`) is the same
      frame carry as the lookahead twin. */
  lemma {:isolate_assertions} GateStepValueLB(
                      rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                      crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                      lk: L.Lookaround, r1: L.Regex, tlk: LT.Tree, tb: LT.Tree,
                      gmt: LG.GroupMap, th: AI.Thread, th2: AI.Thread, l: int, cp: nat,
                      body: R.regex, la: R.lookaround, bodycode: RB.code, endl: nat, ngroups: nat,
                      qt: AReg.Regs, ncap: int, nlook: int, nquant: int)
    requires qm.ov == ov && !rer.ignoreCase && !rer.multiline
    requires cp <= |str| && |ov| == |str| + 1
    requires l in qm.looks && qm.looks[l] == (lk, r1)
    requires L.Positivity(lk) && L.LkDir(lk) == WP.Backward
    requires LS.LkResult(lk, tlk, gmt, PIV.InpOfCp(str, cp)).Some?
    requires EL.LkGateOk(rer, lk, r1, PIV.InpOfCp(str, cp), tlk, true)
    requires exists clkv: int {:trigger AReg.set_reg(th.look_regs, l, Some(cp as int), clkv)} ::
      th2 == th.(pc := th.pc + 1,
                 look_regs := AReg.set_reg(th.look_regs, l, Some(cp as int), clkv))
    requires GmtTieInside(crv, str, ov, th, gmt, S, ncap, nlook, nquant)
    requires forall g :: g in L.DefGroups(r1) ==> g !in gmt        // GateAheadClear at this gate
    requires T.TransWf(body) && NR.LookFreeRE(body) && la.Lookbehind?
    requires NR.PlusFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires SD.GroupOkL(T.Translate(body)) && CD.NoDupG(L.DefGroups(T.Translate(body)))
    requires r1 == T.Translate(body) && lk == T.TrLookaround(la) && body == M.VBody(crv, l)
    requires bodycode == CP.compile_to_bytecode(body)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires 0 <= l < nlook && l < RL.ASize(th.look_regs)
    requires 0 <= l < |crv.f_look_ast| && 0 <= l < |crv.f_look_cdns| && 0 <= l < |crv.f_look_types|
    requires crv.f_look_types[l].Lookbehind? && AI.capture_type(crv.f_look_types[l])
    ensures var gmt2 := LS.LkResult(lk, tlk, gmt, PIV.InpOfCp(str, cp)).value;
            GmtTieInside(crv, str, ov, th2, gmt2, S, ncap, nlook, nquant)
  {
    var inp := PIV.InpOfCp(str, cp);
    var tr := T.Translate(body);
    var gmt2 := LS.LkResult(lk, tlk, gmt, inp).value;
    var Sbody := set g | g in L.DefGroups(tr);
    var clkv: int :| th2 == th.(pc := th.pc + 1,
                                look_regs := AReg.set_reg(th.look_regs, l, Some(cp as int), clkv));

    // ---- (a) tlk bridge (BACKWARD): LkGateOk's Empty-tlk == the gmt-tlk ----
    EL.TranslateNoLkBr(body);
    EL.ComputeTrGmIndepLk(rer, tr, inp, gmt, WP.Backward);
    assert tlk == LFU.ComputeTr(rer, [LS.Areg(tr)], inp, gmt, WP.Backward);

    // ---- (b) the keystone's Empty-agreement hypothesis from GateAheadClear ----
    assert M.GmAgreeOn(gmt, LG.Empty, Sbody) by {
      forall g | g in Sbody
        ensures (g in gmt <==> g in LG.Empty) && (g in gmt ==> gmt[g] == LG.Empty[g])
      { assert g in L.DefGroups(r1); }
    }

    // ---- (c) invoke the BACKWARD value crux ----
    assert T.TrLookaround(la) == lk;
    LBK.BackFreshBodyGmTie(rer, body, str, cp, ov, crv.f_look_cdns[l], la, tlk, gmt,
                           ncap, nlook, nquant, |str|);
    var bcB := CP.compile_to_bytecode(R.reverse_regex(body));
    var raB := AI.FFindMatch(bcB, str,
                 AI.FInitState(bcB, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                               AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                 ov, LAnc.Backward, crv.f_look_cdns[l]).0;

    // ---- rf alignment: FreshBodyMatch(l, th2) == the backward run raB ----
    RL.ASetLaws(th.look_regs, l, Some(cp as int), clkv);
    assert AReg.get_cp(th2.look_regs, l) == Some(cp as int);
    assert CP.capture_regex(crv.f_look_types[l], body) == R.reverse_regex(body);   // Lookbehind
    assert AI.capture_direction(crv.f_look_types[l]) == LAnc.Backward;
    var rfl := M.FreshBodyMatch(crv, str, l, th2.look_regs, ov, ncap, nlook, nquant);
    assert rfl == raB;

    M.TranslateDefGroupsEqCapIds(body);                      // Sbody == CapIds(body) == CapIds(VBody(crv,l))
    assert Sbody == PIV.CapIds(body);

    // ---- (d) re-establish GmtTieInside for th2 / gmt2 ----
    forall g: LG.GroupId | g in S && g in gmt2
      ensures exists l': int ::
        0 <= l' < nlook
        && g in PIV.CapIds(M.VBody(crv, l'))
        && M.MatchedPosLA(crv, th2.look_regs, l')
        && var rf' := M.FreshBodyMatch(crv, str, l', th2.look_regs, ov, ncap, nlook, nquant);
           rf'.Some?
           && var gmb := PIV.GmOfLive(M.VBody(crv, l'), rf'.value.capture_regs,
                                      rf'.value.look_regs, rf'.value.quant_regs);
              var looktype := if 0 <= l' < |crv.f_look_types| then crv.f_look_types[l'] else R.Lookahead;
              g in gmb && gmt2[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb[g]) else gmb[g])
    {
      if g in Sbody {
        // Case A: g owned by the crossed lookbehind l; value = SWAP of the fresh backward match.
        var gmbK := PIV.GmOfLive(body, rfl.value.capture_regs, rfl.value.look_regs, rfl.value.quant_regs);
        assert g in gmbK && LBV.SwapGm(gmt2)[g] == gmbK[g];   // BackFreshBodyGmTie GmAgreeOn at g in Sbody
        assert LBV.SwapGm(gmt2)[g] == LBV.SwapRange(gmt2[g]);
        LBV.SwapRangeInvol(gmt2[g]);
        assert gmt2[g] == LBV.SwapRange(gmbK[g]);
        assert g in PIV.CapIds(M.VBody(crv, l));
        assert M.MatchedPosLA(crv, th2.look_regs, l);          // get_cp l = Some(cp); type Lookbehind
        assert M.VBody(crv, l) == body && rfl == raB;
        assert 0 <= l < nlook;                                 // witness l' = l
      } else {
        // Case B: g owned by a DIFFERENT lid; gmt2 == gmt off Sbody (frame), carry GmtTieInside(th).
        LkResultAgreeOutside(rer, lk, r1, inp, tlk, gmt);      // GmAgreeOutside(gmt2, gmt, Sbody)
        assert g !in Sbody;
        assert g in gmt && gmt2[g] == gmt[g];
        assert exists l'': int ::
          0 <= l'' < nlook && g in PIV.CapIds(M.VBody(crv, l''))
          && M.MatchedPosLA(crv, th.look_regs, l'')
          && var rf'' := M.FreshBodyMatch(crv, str, l'', th.look_regs, ov, ncap, nlook, nquant);
             rf''.Some?
             && var gmb'' := PIV.GmOfLive(M.VBody(crv, l''), rf''.value.capture_regs,
                                          rf''.value.look_regs, rf''.value.quant_regs);
                var looktype := if 0 <= l'' < |crv.f_look_types| then crv.f_look_types[l''] else R.Lookahead;
                g in gmb'' && gmt[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb''[g]) else gmb''[g]);
        var l'': int :|
          0 <= l'' < nlook && g in PIV.CapIds(M.VBody(crv, l''))
          && M.MatchedPosLA(crv, th.look_regs, l'')
          && var rf'' := M.FreshBodyMatch(crv, str, l'', th.look_regs, ov, ncap, nlook, nquant);
             rf''.Some?
             && var gmb'' := PIV.GmOfLive(M.VBody(crv, l''), rf''.value.capture_regs,
                                          rf''.value.look_regs, rf''.value.quant_regs);
                var looktype := if 0 <= l'' < |crv.f_look_types| then crv.f_look_types[l''] else R.Lookahead;
                g in gmb'' && gmt[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb''[g]) else gmb''[g]);
        assert l'' != l by {
          if l'' == l { assert g in PIV.CapIds(M.VBody(crv, l)); }
        }
        RL.ASetLaws(th.look_regs, l, Some(cp as int), clkv);
        assert AReg.get_cp(th2.look_regs, l'') == AReg.get_cp(th.look_regs, l'');
        assert M.MatchedPosLA(crv, th2.look_regs, l'');
        assert M.FreshBodyMatch(crv, str, l'', th2.look_regs, ov, ncap, nlook, nquant)
            == M.FreshBodyMatch(crv, str, l'', th.look_regs, ov, ncap, nlook, nquant);
      }
    }
  }

  /** (3) Initial pairing: fresh VM state ↔ `PikeTreeInitialState(tcan, inp)`
      where `tcan` is the PLANTED CANONICAL entry tree (constructed here from
      the raw entry walk tree `t` by `ActionsTreeRepLkRE` + `WkE.WalkOkEntry`;
      `t` remains the value layer's erasure witness, and
      `ProgErase(tcan) == ProgErase(t)` is the endpoint `FirstLeaf` glue). */
  lemma LiftInit(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                 t: LT.Tree, vms: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (tcan: LT.Tree)
    requires !rer.multiline
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re) && PIV.CapUnique(re)
    requires code == CP.compile_to_bytecode(re)
    requires AR.ActionsRepL(rer, qm, [LS.Areg(T.Translate(re))], code, 0)
    requires LL.OracleOkSuffix(rer, qm, LC.InitInput(str))
    requires EL.BoolTreeLk(rer, [LS.Areg(T.Translate(re))], LC.InitInput(str), BS.CannotExit, t)
    requires vms.cp == 0
    requires vms.active == [AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant))]
    requires vms.blocked == [] && vms.bestmatch.None?
    requires vms.processed == AI.init_bpcset(|code|)
    requires vms.isblocked == AI.init_pcset(|code|)
    requires PIV.ContextOkRE(str, vms.cp, vms.context)
    ensures TreeRepLkRE(rer, qm, code, LC.InitInput(str), tcan, 0, false)
    ensures CE.ProgErase(tcan) == CE.ProgErase(t)   // endpoint glue: FirstLeaf(tcan) == FirstLeaf(t)
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S,
                    PT.PikeTreeInitialState(tcan, LC.InitInput(str)), vms, ncap, nlook, nquant)
  {
    var inp := LC.InitInput(str);
    var itr := AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant));
    var acts := [LS.Areg(T.Translate(re))];

    // inp == InpOfCp(str, 0)
    assert str[..0] == [] && str[0..] == str;
    assert LC.Reverse(str[..0]) == [];
    assert inp == PIV.InpOfCp(str, 0);

    // entry walk-state facts
    EL.TranslateFragmentPikeLk(re);                           // PikeLkRegex(Translate(re))
    EL.PikeLkActionsConsIff(LS.Areg(T.Translate(re)), []);    // PikeLkActions(acts)
    assert EL.PikeLkActions(acts);
    PIV.GmOfLiveInit(re, ncap, nlook, nquant);               // GmOfLive(re, init...) == Empty

    // the single entry thread pairs with (t, Empty)
    assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, t, LG.Empty, itr, ncap, nlook, nquant) by {
      assert itr.pc == 0 && itr.exit_allowed == false;
      assert GateAheadClear(acts, LG.Empty);                 // Empty has no keys
      assert ATR.EaOf(BS.CannotExit) == itr.exit_allowed;
      TranslateDefGroupsNoDup(re);                            // NoDupSeq(DefGroups(Translate(re)))
      WalkDefsOkEntry(T.Translate(re));
      M.AllDefsActsCons(LS.Areg(T.Translate(re)), []);
      assert M.AllDefsActs(acts) == L.DefGroups(T.Translate(re));   // AllDefsActs([]) == []
      assert exists actsw: LS.Actions, bw: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, actsw, code, itr.pc as nat)
          && EL.PikeLkActions(actsw)
          && ATR.EaOf(bw) == itr.exit_allowed
          && EL.BoolTreeLk(rer, actsw, inp, bw, t)
          && GateAheadClear(actsw, LG.Empty)
          && WalkDefsOk(actsw);
      assert PIV.GmOfLive(re, itr.capture_regs, itr.look_regs, itr.quant_regs) == LG.Empty;
      assert GmtTieOutside(re, itr, LG.Empty, S);
      assert GmtTieInside(crv, str, ov, itr, LG.Empty, S, ncap, nlook, nquant);  // vacuous
    }
    // Construct machine B's PLANTED CANONICAL entry tree; the raw walk tree
    // `t` is its value-layer erasure witness.
    WkE.WalkOkEntry(re);
    assert WO.WalkOk(acts, code, 0, false);
    assert ATR.EaOf(BS.CannotExit) == false;
    tcan := ActionsTreeRepLkRE(rer, qm, acts, code, 0, inp, BS.CannotExit, t);
    var bst := PT.PikeTreeInitialState(tcan, inp);
    assert bst == PT.PTS(inp, [(tcan, LG.Empty)], None, [], SS.InitialSeenTrees);
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, tcan, LG.Empty, itr,
                        ncap, nlook, nquant) by {
      assert TreeRepLkRE(rer, qm, code, inp, tcan, itr.pc as nat, itr.exit_allowed);
      assert CE.ProgErase(t) == CE.ProgErase(tcan)
          && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, t, LG.Empty, itr, ncap, nlook, nquant);
    }
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, [(tcan, LG.Empty)], [itr], ncap, nlook, nquant);

    // blocked: both sides empty (vms.blocked == [])
    forall nextinp | LC.AdvanceInput(inp, WP.Forward) == Some(nextinp)
      ensures BlockedRepLkC(rer, qm, re, code, inp, nextinp, crv, str, ov, S, [],
                            PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant)
    {
      assert LC.Reverse(vms.blocked) == [];
      assert PIV.MatchingBlocked([], inp) == [];
    }
    assert BestTieLk(re, crv, str, ov, S, None, vms.bestmatch, ncap, nlook, nquant);
  }

  // ==========================================================================
  // (4a) THE ε-PHASE CASE TIER — per-VM-worklist-step preservation lemmas,
  // mirroring PSM's Preserve*Case set. Each takes the pre-states (bst, s), the
  // ticked state s1 (clock+1, slot marked processed) and the case's successor
  // vms2, and returns the B successor with its step(s) and LiftInv(bst1, vms2).
  // The canonical tie (TreeRepLkREAt*) pins the head shape; the raw
  // erasure-witness carries the value layer through the proven cores.
  // ==========================================================================

  /** `TrcPikeTreeLk` is reflexive. */
  lemma TrcLkRefl(s: PT.PikeTreeState)
    ensures PTL.TrcPikeTreeLk(s, s)
  {}

  /** Prepending one `PikeTreeStepLk` keeps a `TrcPikeTreeLk` chain. */
  lemma TrcLkCons(s1: PT.PikeTreeState, mid: PT.PikeTreeState, s2: PT.PikeTreeState)
    requires PTL.PikeTreeStepLk(s1, mid)
    requires PTL.TrcPikeTreeLk(mid, s2)
    ensures PTL.TrcPikeTreeLk(s1, s2)
  {}

  /** Step-counted `TrcPikeTreeLk` — the nat-indexed detour that lets
      transitivity avoid a two-least-requires induction (PSM's `TrcN` shape). */
  ghost predicate TrcLkN(a: PT.PikeTreeState, b: PT.PikeTreeState, n: nat)
    decreases n
  {
    (a == b && n == 0)
    || (n > 0 && exists z :: PTL.PikeTreeStepLk(a, z) && TrcLkN(z, b, n - 1))
  }

  /** Every `TrcPikeTreeLk` chain has a finite step count. */
  least lemma TrcLkToN(a: PT.PikeTreeState, b: PT.PikeTreeState)
    requires PTL.TrcPikeTreeLk(a, b)
    ensures exists n: nat :: TrcLkN(a, b, n)
  {
    if a == b {
      assert TrcLkN(a, b, 0);
    } else {
      var z :| PTL.PikeTreeStepLk(a, z) && PTL.TrcPikeTreeLk(z, b);
      TrcLkToN(z, b);
      var n: nat :| TrcLkN(z, b, n);
      assert TrcLkN(a, b, n + 1);
    }
  }

  /** A counted chain is a plain chain. */
  lemma TrcLkFromN(a: PT.PikeTreeState, b: PT.PikeTreeState, n: nat)
    requires TrcLkN(a, b, n)
    ensures PTL.TrcPikeTreeLk(a, b)
    decreases n
  {
    if a == b && n == 0 {
    } else {
      var z :| PTL.PikeTreeStepLk(a, z) && TrcLkN(z, b, n - 1);
      TrcLkFromN(z, b, n - 1);
      TrcLkCons(a, z, b);
    }
  }

  /** `TrcLkN` is transitive with counts adding. */
  lemma TrcLkNTrans(a: PT.PikeTreeState, b: PT.PikeTreeState, c: PT.PikeTreeState, n: nat, m: nat)
    requires TrcLkN(a, b, n)
    requires TrcLkN(b, c, m)
    ensures TrcLkN(a, c, n + m)
    decreases n
  {
    if a == b && n == 0 {
    } else {
      var z :| PTL.PikeTreeStepLk(a, z) && TrcLkN(z, b, n - 1);
      TrcLkNTrans(z, b, c, n - 1, m);
    }
  }

  /** Concatenating `TrcPikeTreeLk` chains. */
  lemma TrcLkTrans(a: PT.PikeTreeState, b: PT.PikeTreeState, c: PT.PikeTreeState)
    requires PTL.TrcPikeTreeLk(a, b)
    requires PTL.TrcPikeTreeLk(b, c)
    ensures PTL.TrcPikeTreeLk(a, c)
  {
    TrcLkToN(a, b);
    TrcLkToN(b, c);
    var n: nat :| TrcLkN(a, b, n);
    var m: nat :| TrcLkN(b, c, m);
    TrcLkNTrans(a, b, c, n, m);
    TrcLkFromN(a, c, n + m);
  }

  /** A canonical head sits at a fetchable pc (every rule pins an instruction). */
  lemma TreeRepLkREInRange(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                           t: LT.Tree, pc: nat, b: bool)
    requires TreeRepLkRE(rer, qm, code, inp, t, pc, b)
    ensures NR.GetPcRE(code, pc).Some? && pc < |code|
  { }

  /** Growing the seen set preserves the isblocked pairing (witness carries).
      Mirror of `PSM.IsblockedGrow`. */
  lemma IsblockedGrowLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                        treeseen: SS.SeenTrees, isblocked: AI.pcset, extra: LT.Tree)
    requires IsblockedRepLk(rer, qm, code, inp, treeseen, isblocked)
    ensures IsblockedRepLk(rer, qm, code, inp, SS.AddSeenTrees(treeseen, extra), isblocked)
  {
    forall pc0: nat | AI.pc_mem(isblocked, pc0)
      ensures exists t: LT.Tree, b: bool ::
        SS.Inseen(SS.AddSeenTrees(treeseen, extra), t) && TreeRepLkRE(rer, qm, code, inp, t, pc0, b)
    {
      var t: LT.Tree, b: bool :| SS.Inseen(treeseen, t) && TreeRepLkRE(rer, qm, code, inp, t, pc0, b);
      SS.InAdd(treeseen, t, extra);
    }
  }

  /** WalkPairLk relocates through a `Jmp` — the SAME `(acts, b)` witness moves
      via `ActionsRepLThruJmp`, so `GateAheadClear`/NoDup transfer verbatim. */
  lemma WalkPairLkAtJmp(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                        tb: LT.Tree, gmt: LG.GroupMap, pc: nat, ea: bool, x: int)
    requires WalkPairLk(rer, qm, code, inp, tb, gmt, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Jmp(x))
    ensures x >= 0 && WalkPairLk(rer, qm, code, inp, tb, gmt, x as nat, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gmt)
      && WalkDefsOk(acts);
    ActionsRepLThruJmp(rer, qm, acts, code, pc, x);
  }

  /** POLARITY PIN at gate pcs — the static sweep tying a `CheckOracle` /
      `NegCheckOracle` instruction to its look's recorded flavour through
      `qm.looks`: `NfaRepRE`'s lookaround rule CHOOSES the instruction by the
      look's positivity, and `LmapOk` records the table row. This is what lets
      the kill/pass gate cases read the FUNCTIONAL verdict off the oracle BIT
      (`LkResult` branches on `Positivity`). `PIV.LookCheckIdsRE`'s skeleton. */
  lemma GatePolarityRE(re: R.regex, qm: AR.QMap, code: RB.code, start: nat, endl: nat, pc: nat)
    requires T.TransWf(re) && AR.LmapOk(re, qm)
    requires NR.NfaRepRE(re, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckOracle? ==>
      var l := NR.GetPcRE(code, pc).value.col;
      l in qm.looks && AR.PositiveL(qm.looks[l].0)
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.NegCheckOracle? ==>
      var l := NR.GetPcRE(code, pc).value.ncl;
      l in qm.looks && !AR.PositiveL(qm.looks[l].0)
    decreases CP.rsize(re), 1
  {
    match re
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
    case Re_lookaround(lid, la, r1) =>
      assert pc == start;
      assert lid in qm.looks && qm.looks[lid] == (T.TrLookaround(la), T.Translate(r1));
      assert AR.PositiveL(T.TrLookaround(la)) <==> (la.Lookahead? || la.Lookbehind?);
    case Re_alt(r1, r2) =>
      var e1: nat :| NR.GetPcRE(code, start) == Some(RB.Fork(start + 1, e1 + 1))
        && NR.NfaRepRE(r1, code, start + 1, e1)
        && NR.GetPcRE(code, e1) == Some(RB.Jmp(endl))
        && NR.NfaRepRE(r2, code, e1 + 1, endl);
      NR.NfaRepIncrRE(r1, code, start + 1, e1);
      NR.NfaRepIncrRE(r2, code, e1 + 1, endl);
      if pc == start {
      } else if pc < e1 {
        GatePolarityRE(r1, qm, code, start + 1, e1, pc);
      } else if pc == e1 {
      } else {
        GatePolarityRE(r2, qm, code, e1 + 1, endl, pc);
      }
    case Re_con(r1, r2) =>
      var e1: nat :| NR.NfaRepRE(r1, code, start, e1) && NR.NfaRepRE(r2, code, e1, endl);
      NR.NfaRepIncrRE(r1, code, start, e1);
      NR.NfaRepIncrRE(r2, code, e1, endl);
      if pc < e1 {
        GatePolarityRE(r1, qm, code, start, e1, pc);
      } else {
        GatePolarityRE(r2, qm, code, e1, endl, pc);
      }
    case Re_capture(cid, r1) =>
      var e1: nat :| NR.GetPcRE(code, start) == Some(RB.SetRegisterToCP(CP.start_reg(cid)))
        && NR.NfaRepRE(r1, code, start + 1, e1)
        && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(cid)))
        && endl == e1 + 1;
      NR.NfaRepIncrRE(r1, code, start + 1, e1);
      if pc == start {
      } else if pc < e1 {
        GatePolarityRE(r1, qm, code, start + 1, e1, pc);
      } else {
      }
    case Re_quant(nul, qid, q, r1) =>
      if q.min == 0 && q.max == None {
        var e1: nat :| NR.GetPcRE(code, start) == Some(if q.greedy then RB.Fork(start + 1, e1 + 2) else RB.Fork(e1 + 2, start + 1))
          && NR.GetPcRE(code, start + 1) == Some(RB.SetQuantToClock(qid, false))
          && NR.GetPcRE(code, start + 2) == Some(RB.BeginLoop)
          && NR.NfaRepRE(r1, code, start + 3, e1)
          && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
          && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(start))
          && endl == e1 + 2;
        NR.NfaRepIncrRE(r1, code, start + 3, e1);
        if pc <= start + 2 {
        } else if pc < e1 {
          GatePolarityRE(r1, qm, code, start + 3, e1, pc);
        } else {
        }
      } else if q.max.Some? {
        var em := NR.NfaRepREQuantInv(nul, qid, q, r1, code, start, endl);
        NR.NfaRepIncrMinRE(q.min as nat, qid, r1, code, start, em);
        NR.NfaRepIncrOptRE((q.max.value - q.min) as nat, q.greedy, qid, r1, code, em, endl);
        if pc < em {
          GatePolarityMinRE(q.min as nat, qid, r1, qm, code, start, em, pc);
        } else {
          GatePolarityOptRE((q.max.value - q.min) as nat, q.greedy, qid, r1, qm, code, em, endl, pc);
        }
      } else {
        var em, e1 := NR.NfaRepREPlusInv(nul, qid, q, r1, code, start, endl);
        NR.NfaRepIncrMinRE((q.min - 1) as nat, qid, r1, code, start, em);
        NR.NfaRepIncrRE(r1, code, em + 1, e1);
        if pc < em {
          GatePolarityMinRE((q.min - 1) as nat, qid, r1, qm, code, start, em, pc);
        } else if pc == em {
        } else if pc < e1 {
          GatePolarityRE(r1, qm, code, em + 1, e1, pc);
        } else {
        }
      }
  }

  /** `GatePolarityRE` for the forced-copy chain. */
  lemma GatePolarityMinRE(k: nat, qid: R.quantid, r1: R.regex, qm: AR.QMap, code: RB.code,
                          start: nat, endl: nat, pc: nat)
    requires T.TransWf(r1) && AR.LmapOk(r1, qm)
    requires NR.NfaRepMinRE(k, qid, r1, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckOracle? ==>
      var l := NR.GetPcRE(code, pc).value.col;
      l in qm.looks && AR.PositiveL(qm.looks[l].0)
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.NegCheckOracle? ==>
      var l := NR.GetPcRE(code, pc).value.ncl;
      l in qm.looks && !AR.PositiveL(qm.looks[l].0)
    decreases CP.rsize(r1), k + 2
  {
    if k == 0 { return; }
    var e1: nat :| NR.GetPcRE(code, start) == Some(RB.SetQuantToClock(qid, false))
      && NR.NfaRepRE(r1, code, start + 1, e1)
      && NR.NfaRepMinRE(k - 1, qid, r1, code, e1, endl);
    NR.NfaRepIncrRE(r1, code, start + 1, e1);
    NR.NfaRepIncrMinRE(k - 1, qid, r1, code, e1, endl);
    if pc == start {
    } else if pc < e1 {
      GatePolarityRE(r1, qm, code, start + 1, e1, pc);
    } else {
      GatePolarityMinRE(k - 1, qid, r1, qm, code, e1, endl, pc);
    }
  }

  /** `GatePolarityRE` for the optional-layer chain. */
  lemma GatePolarityOptRE(k: nat, greedy: bool, qid: R.quantid, r1: R.regex, qm: AR.QMap,
                          code: RB.code, start: nat, endl: nat, pc: nat)
    requires T.TransWf(r1) && AR.LmapOk(r1, qm)
    requires NR.NfaRepOptRE(k, greedy, qid, r1, code, start, endl)
    requires start <= pc < endl
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckOracle? ==>
      var l := NR.GetPcRE(code, pc).value.col;
      l in qm.looks && AR.PositiveL(qm.looks[l].0)
    ensures NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.NegCheckOracle? ==>
      var l := NR.GetPcRE(code, pc).value.ncl;
      l in qm.looks && !AR.PositiveL(qm.looks[l].0)
    decreases CP.rsize(r1), k + 2
  {
    if k == 0 { return; }
    var e1: nat :| NR.GetPcRE(code, start) == Some(if greedy then RB.Fork(start + 1, endl) else RB.Fork(endl, start + 1))
      && NR.GetPcRE(code, start + 1) == Some(RB.SetQuantToClock(qid, false))
      && NR.GetPcRE(code, start + 2) == Some(RB.BeginLoop)
      && NR.NfaRepRE(r1, code, start + 3, e1)
      && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
      && NR.NfaRepOptRE(k - 1, greedy, qid, r1, code, e1 + 1, endl);
    NR.NfaRepIncrRE(r1, code, start + 3, e1);
    NR.NfaRepIncrOptRE(k - 1, greedy, qid, r1, code, e1 + 1, endl);
    if pc <= start + 2 {
    } else if pc < e1 {
      GatePolarityRE(r1, qm, code, start + 3, e1, pc);
    } else if pc == e1 {
    } else {
      GatePolarityOptRE(k - 1, greedy, qid, r1, qm, code, e1 + 1, endl, pc);
    }
  }

  /** SKIP: the head's `(pc, ea)` is already processed — the VM drops it, and
      B fires `pts_skip`: the seen slot's canonical tree EQUALS the head's by
      `TreeRepLkDetermRE` (the whole point of the planted-canonical pivot);
      the stutter escape is killed by `NoStutterCycle`. */
  lemma LiftPreserveSkipLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                           bst: PT.PikeTreeState, s: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    ensures PTL.PikeTreeStepLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, s.(active := s.active[1..]),
                    ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;

    // The processed slot resolves LEFT: the stutter escape would need
    // StutterChainTo(pc, pc), impossible in tame code.
    assert AI.bpc_mem(s.processed, pc, ea);
    assert (exists t': LT.Tree :: SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, ea))
        || (TT.StuttersRE(pc, code)
            && exists t': LT.Tree ::
                 PIV.StutterChainTo(code, pc, pc) && Some(t) == Some(t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc, ea));
    if !(exists t': LT.Tree :: SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, ea)) {
      PIV.NoStutterCycle(code, pc);
      assert false;
    }
    var t': LT.Tree :| SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, ea);
    TreeRepLkDetermRE(rer, qm, code, inp, t, t', pc, ea);
    assert SS.Inseen(seen, t);

    // pts_skip
    bst1 := PT.PTS(inp, ta[1..], best, tb, seen);
    assert PTL.PikeTreeStepLk(bst, bst1);

    // invariant at the successor
    SkipSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc,
                  PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(s.active[1..]));
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
  }

  /** (L4 NESTED) clone of `LiftPreserveSkipLk` — GmtTieInside dropped. */
  lemma LiftPreserveSkipLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                           bst: PT.PikeTreeState, s: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    ensures PTL.PikeTreeStepLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, s.(active := s.active[1..]),
                    ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;

    // The processed slot resolves LEFT: the stutter escape would need
    // StutterChainTo(pc, pc), impossible in tame code.
    assert AI.bpc_mem(s.processed, pc, ea);
    assert (exists t': LT.Tree :: SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, ea))
        || (TT.StuttersRE(pc, code)
            && exists t': LT.Tree ::
                 PIV.StutterChainTo(code, pc, pc) && Some(t) == Some(t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc, ea));
    if !(exists t': LT.Tree :: SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, ea)) {
      PIV.NoStutterCycle(code, pc);
      assert false;
    }
    var t': LT.Tree :| SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, ea);
    TreeRepLkDetermRE(rer, qm, code, inp, t, t', pc, ea);
    assert SS.Inseen(seen, t);

    // pts_skip
    bst1 := PT.PTS(inp, ta[1..], best, tb, seen);
    assert PTL.PikeTreeStepLk(bst, bst1);

    // invariant at the successor
    SkipSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc,
                  PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(s.active[1..]));
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
  }

  /** STUTTER (Jmp / BeginLoop): the VM relocates the head thread, B does not
      step — the SAME canonical tree represents at the relocated `(pc', ea')`
      (`tr_jmp`/`tr_begin`), the raw witness relocates with its stack, and the
      seen escape chain extends one step (`StutterSeenRepLk`). */
  lemma LiftPreserveStutterLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                              crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                              bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState, th': AI.Thread,
                              vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires (exists x: int ::
                NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Jmp(x))
                && th' == s.active[0].(pc := x))
          || (NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.BeginLoop)
              && th' == s.active[0].(exit_allowed := false, pc := s.active[0].pc + 1))
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);

    // the relocated head pairing
    var pc': nat;
    if exists x: int :: NR.GetPcRE(code, pc) == Some(RB.Jmp(x)) && th' == th.(pc := x) {
      var x: int :| NR.GetPcRE(code, pc) == Some(RB.Jmp(x)) && th' == th.(pc := x);
      TreeRepLkREAtJmp(rer, qm, code, inp, t, pc, ea, x);
      WalkPairLkAtJmp(rer, qm, code, inp, traw, gm, pc, ea, x);
      pc' := x as nat;
      assert PIV.StutterSuccIs(code, pc, pc');
    } else {
      TreeRepLkREAtBeginLoop(rer, qm, code, inp, t, pc, ea);
      WalkPairLkAtBeginLoop(rer, qm, code, inp, traw, gm, pc, ea);
      pc' := pc + 1;
      assert PIV.StutterSuccIs(code, pc, pc');
    }
    assert th'.pc == pc' as int;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc', th'.exit_allowed);
    assert WalkPairLk(rer, qm, code, inp, traw, gm, pc', th'.exit_allowed);
    assert th'.capture_regs == th.capture_regs && th'.look_regs == th.look_regs
        && th'.quant_regs == th.quant_regs;
    assert GmtTieOutside(re, th', gm, S);
    assert GmtTieInside(crv, str, ov, th', gm, S, ncap, nlook, nquant);
    assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th', ncap, nlook, nquant);
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th', ncap, nlook, nquant);

    // active: same (tree, gm) list against the relocated head
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ta == [ta[0]] + ta[1..];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, vms2.active, ncap, nlook, nquant);

    // seen: the escape chain extends by one stutter step
    assert TT.StuttersRE(pc, code);
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    StutterSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea, pc');
    assert PIV.HeadPcOf(vms2.active) == pc';
  }

  /** (L4 NESTED) clone of `LiftPreserveStutterLk` — GmtTieInside dropped. */
  lemma LiftPreserveStutterLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                              crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                              bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState, th': AI.Thread,
                              vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires (exists x: int ::
                NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Jmp(x))
                && th' == s.active[0].(pc := x))
          || (NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.BeginLoop)
              && th' == s.active[0].(exit_allowed := false, pc := s.active[0].pc + 1))
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);

    // the relocated head pairing
    var pc': nat;
    if exists x: int :: NR.GetPcRE(code, pc) == Some(RB.Jmp(x)) && th' == th.(pc := x) {
      var x: int :| NR.GetPcRE(code, pc) == Some(RB.Jmp(x)) && th' == th.(pc := x);
      TreeRepLkREAtJmp(rer, qm, code, inp, t, pc, ea, x);
      WalkPairLkAtJmp(rer, qm, code, inp, traw, gm, pc, ea, x);
      pc' := x as nat;
      assert PIV.StutterSuccIs(code, pc, pc');
    } else {
      TreeRepLkREAtBeginLoop(rer, qm, code, inp, t, pc, ea);
      WalkPairLkAtBeginLoop(rer, qm, code, inp, traw, gm, pc, ea);
      pc' := pc + 1;
      assert PIV.StutterSuccIs(code, pc, pc');
    }
    assert th'.pc == pc' as int;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc', th'.exit_allowed);
    assert WalkPairLk(rer, qm, code, inp, traw, gm, pc', th'.exit_allowed);
    assert th'.capture_regs == th.capture_regs && th'.look_regs == th.look_regs
        && th'.quant_regs == th.quant_regs;
    assert GmtTieOutside(re, th', gm, S);
    assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th', ncap, nlook, nquant);
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th', ncap, nlook, nquant);

    // active: same (tree, gm) list against the relocated head
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ta == [ta[0]] + ta[1..];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, vms2.active, ncap, nlook, nquant);

    // seen: the escape chain extends by one stutter step
    assert TT.StuttersRE(pc, code);
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    StutterSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea, pc');
    assert PIV.HeadPcOf(vms2.active) == pc';
  }

  /** ACCEPT: the VM records the winner and CUTS the queue; B fires
      `pts_match` — the head canonical tree IS `Match` and its `gm` carries
      exactly the two-sided value tie (`BestTieLk` straight from
      `ThreadRepLkC`'s payload). */
  lemma LiftPreserveAcceptLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                             crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                             bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                             vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Accept)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [], bestmatch := Some(s.active[0]))
    ensures PTL.PikeTreeStepLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    TreeRepLkREAtAccept(rer, qm, code, inp, t, pc, ea);
    assert t == LT.Match;
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepMatch;

    // pts_match
    bst1 := PT.PTS(inp, [], Some((inp, gm)), tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);

    // the value tie for the recorded best — straight from the head's payload
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    assert GmtTieOutside(re, th, gm, S);
    assert GmtTieInside(crv, str, ov, th, gm, S, ncap, nlook, nquant);
    assert BestTieLk(re, crv, str, ov, S, Some((inp, gm)), vms2.bestmatch, ncap, nlook, nquant);

    // bookkeeping: seen grows with the memoized head; active empty both sides
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, [], vms2.active, ncap, nlook, nquant);
  }

  /** (L4 NESTED) clone of `LiftPreserveAcceptLk` — GmtTieInside dropped. */
  lemma LiftPreserveAcceptLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                             crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                             bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                             vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Accept)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [], bestmatch := Some(s.active[0]))
    ensures PTL.PikeTreeStepLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    TreeRepLkREAtAccept(rer, qm, code, inp, t, pc, ea);
    assert t == LT.Match;
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepMatch;

    // pts_match
    bst1 := PT.PTS(inp, [], Some((inp, gm)), tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);

    // the value tie for the recorded best — straight from the head's payload
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    assert GmtTieOutside(re, th, gm, S);
    assert BestTieLkNested(re, crv, str, ov, S, Some((inp, gm)), vms2.bestmatch, ncap, nlook, nquant);

    // bookkeeping: seen grows with the memoized head; active empty both sides
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, [], vms2.active, ncap, nlook, nquant);
  }

  /** DEAD HEAD, shared bookkeeping: the head canonical tree steps to an EMPTY
      `pts_active` (`Mismatch`/`LKFail` — `StepDead() == StepActive([])`), the
      VM drops the thread, B memoizes the dead tree. Every kill case
      (EndLoop/Anchor/gate) reduces to this after pinning the head shape. */
  lemma LiftDropDeadHeadLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                           bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                           vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires |bst.active| > 0
    requires PTL.TreeBfsStepLk(bst.active[0].0, bst.active[0].1, bst.inp) == PT.StepActive([])
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.PikeTreeStepLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // pts_active with an empty successor list: the branch dies on both sides.
    bst1 := PT.PTS(inp, ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert [] + ta[1..] == ta[1..];
    assert PTL.PikeTreeStepLk(bst, bst1);

    // bookkeeping at the successor
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active == s.active[1..];
  }

  /** (L4 NESTED) `LiftDropDeadHeadLk` for `LiftInvNested` — pure predicate swap
      (`LiftInv`→`LiftInvNested`, `ActiveRepLkC`→`ActiveRepLkCNested`,
      `ThreadRepLkC`→`ThreadRepLkCNested`); no `GmtTieInside` obligation exists. */
  lemma LiftDropDeadHeadLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                           bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                           vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires |bst.active| > 0
    requires PTL.TreeBfsStepLk(bst.active[0].0, bst.active[0].1, bst.inp) == PT.StepActive([])
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.PikeTreeStepLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // pts_active with an empty successor list: the branch dies on both sides.
    bst1 := PT.PTS(inp, ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert [] + ta[1..] == ta[1..];
    assert PTL.PikeTreeStepLk(bst, bst1);

    // bookkeeping at the successor
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active == s.active[1..];
  }

  /** `BlockedRepLkC` commutes with appending one paired entry — the snoc
      companion the `Consume` case uses to align the appended B `Read`-child
      with the appended VM blocked pair. Mirror of `PSM.BlockedRepSnocRE`. */
  lemma BlockedRepLkCSnoc(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                          inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                          ov: LOr.OracleView, S: set<LG.GroupId>,
                          tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                          tp: (LT.Tree, LG.GroupMap), p: (AI.Thread, RC.char_expectation),
                          ncap: int, nlook: int, nquant: int)
    requires BlockedRepLkC(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl, bl, ncap, nlook, nquant)
    requires p.0.pc >= 0
    requires TreeRepLkRE(rer, qm, code, nextinp, tp.0, (p.0.pc + 1) as nat, true)
    requires exists traw: LT.Tree ::
      CE.ProgErase(traw) == CE.ProgErase(tp.0)
      && WalkPairLk(rer, qm, code, nextinp, traw, tp.1, (p.0.pc + 1) as nat, true)
    requires GmtTieOutside(re, p.0, tp.1, S)
    requires GmtTieInside(crv, str, ov, p.0, tp.1, S, ncap, nlook, nquant)
    ensures BlockedRepLkC(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl + [tp], bl + [p],
                          ncap, nlook, nquant)
    decreases tl
  {
    if |tl| == 0 {
      assert |bl| == 0;
      assert tl + [tp] == [tp] && bl + [p] == [p];
      assert ([tp])[0] == tp && ([tp])[1..] == [] && ([p])[0] == p && ([p])[1..] == [];
    } else {
      assert |bl| > 0;
      assert (tl + [tp])[0] == tl[0] && (bl + [p])[0] == bl[0];
      assert (tl + [tp])[1..] == tl[1..] + [tp] && (bl + [p])[1..] == bl[1..] + [p];
      BlockedRepLkCSnoc(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                        tp, p, ncap, nlook, nquant);
    }
  }

  /** (L4 NESTED) `BlockedRepLkCSnoc` for the `GmtTieInside`-free pairing — the
      `GmtTieInside` requires is dropped; the snoc structure is unchanged. */
  lemma BlockedRepLkCSnocNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                          inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                          ov: LOr.OracleView, S: set<LG.GroupId>,
                          tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                          tp: (LT.Tree, LG.GroupMap), p: (AI.Thread, RC.char_expectation),
                          ncap: int, nlook: int, nquant: int)
    requires BlockedRepLkCNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl, bl, ncap, nlook, nquant)
    requires p.0.pc >= 0
    requires TreeRepLkRE(rer, qm, code, nextinp, tp.0, (p.0.pc + 1) as nat, true)
    requires exists traw: LT.Tree ::
      CE.ProgErase(traw) == CE.ProgErase(tp.0)
      && WalkPairLk(rer, qm, code, nextinp, traw, tp.1, (p.0.pc + 1) as nat, true)
    requires GmtTieOutside(re, p.0, tp.1, S)
    ensures BlockedRepLkCNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl + [tp], bl + [p],
                          ncap, nlook, nquant)
    decreases tl
  {
    if |tl| == 0 {
      assert |bl| == 0;
      assert tl + [tp] == [tp] && bl + [p] == [p];
      assert ([tp])[0] == tp && ([tp])[1..] == [] && ([p])[0] == p && ([p])[1..] == [];
    } else {
      assert |bl| > 0;
      assert (tl + [tp])[0] == tl[0] && (bl + [p])[0] == bl[0];
      assert (tl + [tp])[1..] == tl[1..] + [tp] && (bl + [p])[1..] == bl[1..] + [p];
      BlockedRepLkCSnocNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                        tp, p, ncap, nlook, nquant);
    }
  }

  /** Fueled `WalkPairLk` core at a `Consume(ce)` pc — the READ, with the full
      carrier: the child walks at the ADVANCED input with the SAME map and
      re-armed flag (`GateAheadClear`/`WalkDefsOk` are input-independent tail
      facts). This is what lets `BlockedRepLkC` store a REACTIVATABLE payload. */
  lemma WalkPairLkAtConsumeCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                acts: LS.Actions, ce: RC.char_expectation)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures tb.Read? || tb == LT.Mismatch
    ensures tb.Read? ==> exists nextinp ::
      AR.ReadCharE(ce, inp) == Some((tb.c, nextinp))
      && WalkPairLk(rer, qm, code, nextinp, tb.t, gm, pc + 1, true)
    ensures tb == LT.Mismatch ==> AR.ReadCharE(ce, inp) == None
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not Consume
    case Aclose(_) =>   // pins SetRegisterToCP — not Consume
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtConsumeCore(rer, qm, code, inp, tb, gm, pc, b, cont, ce);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtConsumeCore(rer, qm, code, inp, tb, gm, pc, b, na, ce);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtConsumeCore(rer, qm, code, inp, tb, gm, pc, b, cont, ce);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsNonConsume(rer, qm, greedy, min, delta, r1, code, pc, pcmid, ce);
        }
      case Character(cd) =>
        assert acts[0] == LS.Areg(L.Character(cd));
        var ce2 :| NR.GetPcRE(code, pc) == Some(RB.Consume(ce2)) && AR.ExpectationMatches(rer, ce2, cd);
        assert ce2 == ce && pcmid == pc + 1;
        AR.ReadAgree(rer, ce, cd, inp);   // ReadCharE(ce, inp) == ReadChar(rer, cd, inp, Forward)
        match LC.ReadChar(rer, cd, inp, WP.Forward) {
          case None =>
            assert tb == LT.Mismatch;
          case Some(pair) =>
            assert tb.Read? && tb.c == pair.0 && EL.BoolTreeLk(rer, cont, pair.1, BS.CanExit, tb.t);
            assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
            GateAheadClearTail(acts, gm);
            WalkDefsOkTail(acts);
            assert WalkPairLk(rer, qm, code, pair.1, tb.t, gm, pc + 1, true) by {
              assert ATR.EaOf(BS.CanExit) == true;
              assert EL.PikeLkActions(cont);
            }
            assert AR.ReadCharE(ce, inp) == Some((tb.c, pair.1));
        }
      case Disjunction(_, _) =>   // pins Fork — not Consume
      case Group(_, _) =>   // pins SetRegisterToCP — not Consume
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Consume
      case AnchorR(_) =>   // pins AnchorAssertion — not Consume
      case Backreference(_) =>   // NfaRepL false
  }

  /** WalkPairLk→WalkPairLk wrapper at a `Consume(ce)`. */
  lemma WalkPairLkAtConsume(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                            tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, ce: RC.char_expectation)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    ensures tb.Read? || tb == LT.Mismatch
    ensures tb.Read? ==> exists nextinp ::
      AR.ReadCharE(ce, inp) == Some((tb.c, nextinp))
      && WalkPairLk(rer, qm, code, nextinp, tb.t, gm, pc + 1, true)
    ensures tb == LT.Mismatch ==> AR.ReadCharE(ce, inp) == None
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtConsumeCore(rer, qm, code, inp, tb, gm, pc, b, acts, ce);
  }

  /** CONSUME, pc not yet blocked: the VM blocks the head unconditionally;
      B blocks a matching `Read` (`pts_blocked`, keeping `BlockedRepLkC`
      aligned through the `MatchingBlocked` filter) or drops a `Mismatch`
      (empty `pts_active` — the doomed blocked thread is invisible to the
      filter). Mirror of `PSM.PreserveConsumeAdd`. */
  lemma LiftPreserveConsumeAddLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                 bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                 ce: RC.char_expectation, vms2: AI.VmState,
                                 ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Consume(ce))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires !AI.pc_mem(s1.isblocked, s.active[0].pc)
    requires vms2 == s1.(blocked := [(s.active[0], ce)] + s1.blocked,
                         isblocked := AI.pc_add(s1.isblocked, s.active[0].pc),
                         active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    TreeRepLkREAtConsume(rer, qm, code, inp, t, pc, ea, ce);

    // shared list bookkeeping
    PSM.ReversePrepend((th, ce), s.blocked);
    PSM.MatchingBlockedSnoc(LC.Reverse(s.blocked), (th, ce), inp);

    // the new isblocked entry pc is covered by the freshly-seen head tree
    assert IsblockedRepLk(rer, qm, code, inp, SS.AddSeenTrees(seen, t), vms2.isblocked) by {
      forall pc0: nat | AI.pc_mem(vms2.isblocked, pc0)
        ensures exists t0: LT.Tree, b0: bool ::
          SS.Inseen(SS.AddSeenTrees(seen, t), t0) && TreeRepLkRE(rer, qm, code, inp, t0, pc0, b0)
      {
        PIV.PcAddMemFwd(s1.isblocked, th.pc, pc0);
        if pc0 == pc {
          SS.InAdd(seen, t, t);
          assert SS.Inseen(SS.AddSeenTrees(seen, t), t) && TreeRepLkRE(rer, qm, code, inp, t, pc0, ea);
        } else {
          assert AI.pc_mem(s.isblocked, pc0);
          var t0: LT.Tree, b0: bool :| SS.Inseen(seen, t0) && TreeRepLkRE(rer, qm, code, inp, t0, pc0, b0);
          SS.InAdd(seen, t0, t);
        }
      }
    }

    if AR.ReadCharE(ce, inp).Some? {
      // MATCHING: pts_blocked pairs the appended entries.
      var (c, nextinp0) := AR.ReadCharE(ce, inp).value;
      assert t.Read? && t.c == c
          && TreeRepLkRE(rer, qm, code, nextinp0, t.t, pc + 1, true);
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepBlocked(t.t);
      bst1 := PT.PTS(inp, ta[1..], best, tb + [(t.t, gm)], SS.AddSeenTrees(seen, t));
      assert PTL.PikeTreeStepLk(bst, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(bst, bst1, bst1);

      // the raw child witness for the blocked pair: the head's raw witness
      // reads the same character (erasure pins the Read root)
      var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
        && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
      assert WalkPairLk(rer, qm, code, inp, traw, gm, pc, ea);
      WalkPairLkAtConsume(rer, qm, code, inp, traw, gm, pc, ea, ce);
      assert traw.Read? by {
        if !traw.Read? {
          assert traw == LT.Mismatch;
          assert CE.ProgErase(traw) == LT.Mismatch;
          assert CE.ProgErase(t).Read?;
          assert false;
        }
      }
      var nextinpw: LC.Input :| AR.ReadCharE(ce, inp) == Some((traw.c, nextinpw))
        && WalkPairLk(rer, qm, code, nextinpw, traw.t, gm, pc + 1, true);
      assert traw.c == c && nextinpw == nextinp0;    // ReadCharE is a function
      assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
        assert CE.ProgErase(traw) == LT.Read(traw.c, CE.ProgErase(traw.t));
        assert CE.ProgErase(t) == LT.Read(t.c, CE.ProgErase(t.t));
      }

      // blocked correspondence: the filter gains exactly the new pair
      forall nextinp | LC.AdvanceInput(inp, WP.Forward) == Some(nextinp)
        ensures BlockedRepLkC(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tb + [(t.t, gm)],
                              PIV.MatchingBlocked(LC.Reverse(vms2.blocked), inp), ncap, nlook, nquant)
      {
        assert nextinp == nextinp0;
        assert PIV.MatchingBlocked(LC.Reverse(vms2.blocked), inp)
            == PIV.MatchingBlocked(LC.Reverse(s.blocked), inp) + [(th, ce)];
        assert GmtTieOutside(re, th, gm, S);
        assert GmtTieInside(crv, str, ov, th, gm, S, ncap, nlook, nquant);
        BlockedRepLkCSnoc(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tb,
                          PIV.MatchingBlocked(LC.Reverse(s.blocked), inp), (t.t, gm), (th, ce),
                          ncap, nlook, nquant);
      }
      assert |inp.next| > 0;                          // ReadCharE Some
      assert LC.AdvanceInput(inp, WP.Forward).Some?;

      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
      assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert vms2.active == s.active[1..];
    } else {
      // MISMATCH: the tree is Mismatch and dies; the doomed blocked thread is
      // invisible to the filter.
      assert t == LT.Mismatch;
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([]);
      bst1 := PT.PTS(inp, ta[1..], best, tb, SS.AddSeenTrees(seen, t));
      assert [] + ta[1..] == ta[1..];
      assert PTL.PikeTreeStepLk(bst, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(bst, bst1, bst1);

      assert PIV.MatchingBlocked(LC.Reverse(vms2.blocked), inp)
          == PIV.MatchingBlocked(LC.Reverse(s.blocked), inp);

      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
      assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert vms2.active == s.active[1..];
    }
  }

  /** (L4 NESTED) clone of `LiftPreserveConsumeAddLk` — GmtTieInside dropped. */
  lemma LiftPreserveConsumeAddLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                 bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                 ce: RC.char_expectation, vms2: AI.VmState,
                                 ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Consume(ce))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires !AI.pc_mem(s1.isblocked, s.active[0].pc)
    requires vms2 == s1.(blocked := [(s.active[0], ce)] + s1.blocked,
                         isblocked := AI.pc_add(s1.isblocked, s.active[0].pc),
                         active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    TreeRepLkREAtConsume(rer, qm, code, inp, t, pc, ea, ce);

    // shared list bookkeeping
    PSM.ReversePrepend((th, ce), s.blocked);
    PSM.MatchingBlockedSnoc(LC.Reverse(s.blocked), (th, ce), inp);

    // the new isblocked entry pc is covered by the freshly-seen head tree
    assert IsblockedRepLk(rer, qm, code, inp, SS.AddSeenTrees(seen, t), vms2.isblocked) by {
      forall pc0: nat | AI.pc_mem(vms2.isblocked, pc0)
        ensures exists t0: LT.Tree, b0: bool ::
          SS.Inseen(SS.AddSeenTrees(seen, t), t0) && TreeRepLkRE(rer, qm, code, inp, t0, pc0, b0)
      {
        PIV.PcAddMemFwd(s1.isblocked, th.pc, pc0);
        if pc0 == pc {
          SS.InAdd(seen, t, t);
          assert SS.Inseen(SS.AddSeenTrees(seen, t), t) && TreeRepLkRE(rer, qm, code, inp, t, pc0, ea);
        } else {
          assert AI.pc_mem(s.isblocked, pc0);
          var t0: LT.Tree, b0: bool :| SS.Inseen(seen, t0) && TreeRepLkRE(rer, qm, code, inp, t0, pc0, b0);
          SS.InAdd(seen, t0, t);
        }
      }
    }

    if AR.ReadCharE(ce, inp).Some? {
      // MATCHING: pts_blocked pairs the appended entries.
      var (c, nextinp0) := AR.ReadCharE(ce, inp).value;
      assert t.Read? && t.c == c
          && TreeRepLkRE(rer, qm, code, nextinp0, t.t, pc + 1, true);
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepBlocked(t.t);
      bst1 := PT.PTS(inp, ta[1..], best, tb + [(t.t, gm)], SS.AddSeenTrees(seen, t));
      assert PTL.PikeTreeStepLk(bst, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(bst, bst1, bst1);

      // the raw child witness for the blocked pair: the head's raw witness
      // reads the same character (erasure pins the Read root)
      var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
        && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
      assert WalkPairLk(rer, qm, code, inp, traw, gm, pc, ea);
      WalkPairLkAtConsume(rer, qm, code, inp, traw, gm, pc, ea, ce);
      assert traw.Read? by {
        if !traw.Read? {
          assert traw == LT.Mismatch;
          assert CE.ProgErase(traw) == LT.Mismatch;
          assert CE.ProgErase(t).Read?;
          assert false;
        }
      }
      var nextinpw: LC.Input :| AR.ReadCharE(ce, inp) == Some((traw.c, nextinpw))
        && WalkPairLk(rer, qm, code, nextinpw, traw.t, gm, pc + 1, true);
      assert traw.c == c && nextinpw == nextinp0;    // ReadCharE is a function
      assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
        assert CE.ProgErase(traw) == LT.Read(traw.c, CE.ProgErase(traw.t));
        assert CE.ProgErase(t) == LT.Read(t.c, CE.ProgErase(t.t));
      }

      // blocked correspondence: the filter gains exactly the new pair
      forall nextinp | LC.AdvanceInput(inp, WP.Forward) == Some(nextinp)
        ensures BlockedRepLkCNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tb + [(t.t, gm)],
                              PIV.MatchingBlocked(LC.Reverse(vms2.blocked), inp), ncap, nlook, nquant)
      {
        assert nextinp == nextinp0;
        assert PIV.MatchingBlocked(LC.Reverse(vms2.blocked), inp)
            == PIV.MatchingBlocked(LC.Reverse(s.blocked), inp) + [(th, ce)];
        assert GmtTieOutside(re, th, gm, S);
        BlockedRepLkCSnocNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tb,
                          PIV.MatchingBlocked(LC.Reverse(s.blocked), inp), (t.t, gm), (th, ce),
                          ncap, nlook, nquant);
      }
      assert |inp.next| > 0;                          // ReadCharE Some
      assert LC.AdvanceInput(inp, WP.Forward).Some?;

      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
      assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert vms2.active == s.active[1..];
    } else {
      // MISMATCH: the tree is Mismatch and dies; the doomed blocked thread is
      // invisible to the filter.
      assert t == LT.Mismatch;
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([]);
      bst1 := PT.PTS(inp, ta[1..], best, tb, SS.AddSeenTrees(seen, t));
      assert [] + ta[1..] == ta[1..];
      assert PTL.PikeTreeStepLk(bst, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(bst, bst1, bst1);

      assert PIV.MatchingBlocked(LC.Reverse(vms2.blocked), inp)
          == PIV.MatchingBlocked(LC.Reverse(s.blocked), inp);

      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
      assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert vms2.active == s.active[1..];
    }
  }

  /** CONSUME, pc already blocked (dedup): the VM drops the head; B fires
      `pts_skip` — `IsblockedRepLk` holds a canonical tree at the `Consume`
      pc, whose rule is flag-independent, so determinism identifies it with
      the head's. Mirror of `PSM.PreserveConsumeDrop`. BODILESS. */
  lemma LiftPreserveConsumeDropLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  ce: RC.char_expectation, vms2: AI.VmState,
                                  ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Consume(ce))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires AI.pc_mem(s1.isblocked, s.active[0].pc)
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // the blocked pc's memoized canonical tree IS the head's — the Consume
    // rules are flag-independent, so the recorded flag transfers.
    assert IsblockedRepLk(rer, qm, code, inp, seen, s.isblocked);
    assert AI.pc_mem(s.isblocked, th.pc) && th.pc == pc as int;
    assert AI.pc_mem(s.isblocked, pc);
    var t': LT.Tree, b': bool :| SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, b');
    TreeRepLkREAtConsume(rer, qm, code, inp, t', pc, b', ce);
    assert TreeRepLkRE(rer, qm, code, inp, t', pc, ea) by {
      match AR.ReadCharE(ce, inp) {
        case None =>
          assert t' == LT.Mismatch;      // tr_readfail — flag-independent
        case Some(pair) =>
          assert t'.Read? && t'.c == pair.0
              && TreeRepLkRE(rer, qm, code, pair.1, t'.t, pc + 1, true);   // tr_read — flag-independent
      }
    }
    TreeRepLkDetermRE(rer, qm, code, inp, t, t', pc, ea);
    assert SS.Inseen(seen, t);

    // pts_skip
    bst1 := PT.PTS(inp, ta[1..], best, tb, seen);
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // bookkeeping: the new processed slot's tree is already memoized
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    SeenAddProcessedSlotRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                              PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active == s.active[1..];
  }

  /** (L4 NESTED) clone of `LiftPreserveConsumeDropLk` — GmtTieInside dropped. */
  lemma LiftPreserveConsumeDropLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  ce: RC.char_expectation, vms2: AI.VmState,
                                  ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Consume(ce))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires AI.pc_mem(s1.isblocked, s.active[0].pc)
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // the blocked pc's memoized canonical tree IS the head's — the Consume
    // rules are flag-independent, so the recorded flag transfers.
    assert IsblockedRepLk(rer, qm, code, inp, seen, s.isblocked);
    assert AI.pc_mem(s.isblocked, th.pc) && th.pc == pc as int;
    assert AI.pc_mem(s.isblocked, pc);
    var t': LT.Tree, b': bool :| SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, b');
    TreeRepLkREAtConsume(rer, qm, code, inp, t', pc, b', ce);
    assert TreeRepLkRE(rer, qm, code, inp, t', pc, ea) by {
      match AR.ReadCharE(ce, inp) {
        case None =>
          assert t' == LT.Mismatch;      // tr_readfail — flag-independent
        case Some(pair) =>
          assert t'.Read? && t'.c == pair.0
              && TreeRepLkRE(rer, qm, code, pair.1, t'.t, pc + 1, true);   // tr_read — flag-independent
      }
    }
    TreeRepLkDetermRE(rer, qm, code, inp, t, t', pc, ea);
    assert SS.Inseen(seen, t);

    // pts_skip
    bst1 := PT.PTS(inp, ta[1..], best, tb, seen);
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // bookkeeping: the new processed slot's tree is already memoized
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    SeenAddProcessedSlotRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                              PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active == s.active[1..];
  }

  /** SETREG (group Open/Close): B steps the `GroupActionT` head, `gmt` moves
      by `GMUpdate` at the current index. The register-level gm effect
      (`GmOfLive` across the write == `GMOpen`/`GMClose`) is a REQUIRES — the
      dispatcher derives it from machine A's head via
      `PSM.OpenStepThreadRE`/`CloseStepThreadRE` (whose heavy positional
      hypotheses live in `PikeInvFullRE`). The written gid is OUTSIDE-look
      (`CaptureWriteIdsOutsideRE`: looks compile to gates, so main-code SetReg
      sites only target `CapIdsOutsideLooks`), hence outside `S`: the
      outside-`S` tie moves pointwise through the same `GMUpdate` on both
      sides, and the inside-`S` tie carries verbatim (look regs unchanged,
      inside groups untouched by the update). */
  lemma LiftPreserveSetRegLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                             crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                             bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                             reg: int, th': AI.Thread, vms2: AI.VmState,
                             ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetRegisterToCP(reg))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(capture_regs := AReg.set_reg(s.active[0].capture_regs, reg, Some(s1.cp), s1.clock),
                                 pc := s.active[0].pc + 1)
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    // the value-tie boundary: SetReg gids are outside-look, hence outside S
    requires S == PIV.CapIdsInLooks(re)
    requires reg >= 0 && 0 <= s1.cp
    // (E3) freshness feed for the look-path carrier (from PikeInvFullRE's BBOf)
    requires s.clock >= 0 && CM.ThreadClocksLE(s.active[0], s.clock)
    // the register-level gm effect, supplied by the dispatcher from machine A's
    // proven step helpers (OpenStepThreadRE/CloseStepThreadRE)
    requires PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
          == (if reg % 2 == 0
              then LG.GMOpen(s1.cp as nat, (reg / 2) as nat,
                             PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                          s.active[0].quant_regs))
              else LG.GMClose(s1.cp as nat, (reg / 2) as nat,
                              PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                           s.active[0].quant_regs)))
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // canonical head: GroupActionT(Open/Close) with canonical child at (pc+1, ea)
    TreeRepLkREAtSetReg(rer, qm, code, inp, t, pc, ea, reg);
    assert t.GroupActionT? && (t.g.Open? || t.g.Close?);
    assert TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);
    var gid: LG.GroupId := t.g.g;

    // position: the B-side update index IS the VM's cp
    assert 0 <= s.cp <= |str| && inp == PIV.InpOfCp(str, s.cp);
    PIV.IdxInpOfCp(str, s.cp);
    var cpn: nat := s1.cp as nat;
    assert LC.Idx(inp) == cpn;
    var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);

    // the written gid is outside-look, hence outside S
    assert pc < endl by {
      TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
      assert pc < |code| == endl + 1;
      if pc == endl {
        assert NR.GetPcRE(code, pc) == Some(RB.Accept);
        assert false;
      }
    }
    var OL := PIV.CapIdsOutsideLooks(re);
    PIV.CaptureWriteIdsOutsideRE(re, code, 0, endl, pc);
    assert reg in PIV.CaptureRegsSet(OL);
    assert gid in OL by {
      if t.g.Open? { assert reg == CP.start_reg(gid as int) == 2 * (gid as int); }
      else { assert reg == CP.end_reg(gid as int) == 2 * (gid as int) + 1; }
      if reg in (set cid: nat | cid in OL :: CP.start_reg(cid)) {
        var cid: nat :| cid in OL && reg == CP.start_reg(cid);
        assert reg == 2 * (cid as int);
        assert t.g.Open?;                              // parity
        assert cid == gid;
      } else {
        var cid: nat :| cid in OL && reg == CP.end_reg(cid);
        assert reg == 2 * (cid as int) + 1;
        assert t.g.Close?;                             // parity
        assert cid == gid;
      }
    }
    PIV.CapIdsLooksDisjoint(re);
    assert gid !in S by {
      if gid in PIV.CapIdsInLooks(re) { assert gid in OL * PIV.CapIdsInLooks(re); }
    }

    // B step: pts_active queues the child with the GMUpdate-moved gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm2)]);
    bst1 := PT.PTS(inp, [(t.t, gm2)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // raw witness: its walk peels the same GroupActionT (same reg pins the
    // same action via the erasure congruence), child walks at gm2
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtSetReg(rer, qm, code, inp, traw, gm, pc, ea, reg);
    assert traw.GroupActionT?;
    assert traw.g == t.g && CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.GroupActionT(traw.g, CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.GroupActionT(t.g, CE.ProgErase(t.t));
    }
    assert WalkPairLk(rer, qm, code, inp, traw.t, gm2, pc + 1, ea);

    // value ties for th': both sides move by the SAME GMUpdate at cpn
    var gml := PIV.GmOfLive(re, th.capture_regs, th.look_regs, th.quant_regs);
    var gml2 := PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs);
    assert gml2 == LG.GMUpdate(t.g, cpn, gml) by {
      if t.g.Open? {
        assert reg == 2 * (gid as int);
        assert reg % 2 == 0 && (reg / 2) as nat == gid;
      } else {
        assert reg == 2 * (gid as int) + 1;
        assert reg % 2 == 1 && (reg / 2) as nat == gid;
      }
    }
    assert gm2 == LG.GMUpdate(t.g, cpn, gm);
    assert GmtTieOutside(re, th, gm, S) && GmtTieInside(crv, str, ov, th, gm, S, ncap, nlook, nquant);

    assert GmtTieOutside(re, th', gm2, S) by {
      forall g: LG.GroupId | g !in S
        ensures (g in gm2 <==> g in gml2) && (g in gm2 ==> gm2[g] == gml2[g])
      {
        assert (g in gm <==> g in gml) && (g in gm ==> gm[g] == gml[g]);
        if g == gid {
          if t.g.Close? {
            // GMClose reads the incoming entry — it agrees on both sides
            assert (gid in gm <==> gid in gml) && (gid in gm ==> gm[gid] == gml[gid]);
          }
        }
        // g != gid: GMUpdate touches only gid, both maps unchanged at g
      }
    }
    assert th'.look_regs == th.look_regs && th'.quant_regs == th.quant_regs;
    assert GmtTieInside(crv, str, ov, th', gm2, S, ncap, nlook, nquant) by {
      forall g: LG.GroupId | g in S && g in gm2
        ensures exists l: int ::
          0 <= l < nlook
          && g in PIV.CapIds(M.VBody(crv, l))
          && M.MatchedPosLA(crv, th'.look_regs, l)
          && var rf := M.FreshBodyMatch(crv, str, l, th'.look_regs, ov, ncap, nlook, nquant);
             rf.Some?
             && var gmb := PIV.GmOfLive(M.VBody(crv, l), rf.value.capture_regs,
                                        rf.value.look_regs, rf.value.quant_regs);
                var looktype := if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead;
                g in gmb && gm2[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb[g]) else gmb[g])
      {
        assert g != gid;
        assert g in gm && gm2[g] == gm[g];             // GMUpdate touches only gid
        var l: int :| 0 <= l < nlook
          && g in PIV.CapIds(M.VBody(crv, l))
          && M.MatchedPosLA(crv, th.look_regs, l)
          && var rf := M.FreshBodyMatch(crv, str, l, th.look_regs, ov, ncap, nlook, nquant);
             rf.Some?
             && var gmb := PIV.GmOfLive(M.VBody(crv, l), rf.value.capture_regs,
                                        rf.value.look_regs, rf.value.quant_regs);
                var looktype := if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead;
                g in gmb && gm[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb[g]) else gmb[g]);
      }
    }
    assert (th.pc + 1) as nat == pc + 1;
    assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm2, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm2)] + ta[1..])[0] == (t.t, gm2) && ([(t.t, gm2)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // ---- (E3) the look-path carrier: fresh cap stamp, no new inside-S group ----
    assert LookNestRepC(re, S, ta, s.active);
    assert LookNestOkT(re, S, gm, th);
    var Bc := s1.clock;
    assert forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= Bc by {
      assert CM.RegsClocksLE(th.quant_regs, s.clock);
    }
    assert forall j: int ::
      AI.get_idx(th'.capture_regs.a_clk, j) == AI.get_idx(th.capture_regs.a_clk, j)
      || (AI.get_idx(th'.capture_regs.a_clk, j) >= 0 && AI.get_idx(th'.capture_regs.a_clk, j) >= Bc)
    by {
      RL.ASetLaws(th.capture_regs, reg, Some(s1.cp), s1.clock);
    }
    assert forall g: LG.GroupId :: g in S && g in gm2 ==> g in gm by {
      forall g: LG.GroupId | g in S && g in gm2 ensures g in gm {
        assert g != gid;
      }
    }
    LookNestOkTFreshCap(re, S, gm, gm2, th, th', Bc);
    assert LookNestRepC(re, S, [(t.t, gm2)] + ta[1..], vms2.active) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestOkT(re, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i])
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // ---- (E4) the converse carrier: look/quant banks untouched, gm grows ----
    assert LookNestBackRepC(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert forall g: LG.GroupId :: g in gm ==> g in gm2;   // GMOpen adds / GMClose keeps domain
    LookNestBackTRegSame(re, crv, str, ov, S, gm, gm2, th, th', ncap, nlook, nquant);
    assert LookNestBackRepC(re, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                            ncap, nlook, nquant) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestBackT(re, crv, str, ov, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i],
                              ncap, nlook, nquant)
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm2)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** (L4 NESTED) clone of `LiftPreserveSetRegLk` — GmtTieInside dropped. */
  lemma LiftPreserveSetRegLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                             crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                             bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                             reg: int, th': AI.Thread, vms2: AI.VmState,
                             ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetRegisterToCP(reg))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(capture_regs := AReg.set_reg(s.active[0].capture_regs, reg, Some(s1.cp), s1.clock),
                                 pc := s.active[0].pc + 1)
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    // the value-tie boundary: SetReg gids are outside-look, hence outside S
    requires S == PIV.CapIdsInLooks(re)
    requires reg >= 0 && 0 <= s1.cp
    // (E3) freshness feed for the look-path carrier (from PikeInvFullRE's BBOf)
    requires s.clock >= 0 && CM.ThreadClocksLE(s.active[0], s.clock)
    // the register-level gm effect, supplied by the dispatcher from machine A's
    // proven step helpers (OpenStepThreadRE/CloseStepThreadRE)
    requires PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
          == (if reg % 2 == 0
              then LG.GMOpen(s1.cp as nat, (reg / 2) as nat,
                             PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                          s.active[0].quant_regs))
              else LG.GMClose(s1.cp as nat, (reg / 2) as nat,
                              PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                           s.active[0].quant_regs)))
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // canonical head: GroupActionT(Open/Close) with canonical child at (pc+1, ea)
    TreeRepLkREAtSetReg(rer, qm, code, inp, t, pc, ea, reg);
    assert t.GroupActionT? && (t.g.Open? || t.g.Close?);
    assert TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);
    var gid: LG.GroupId := t.g.g;

    // position: the B-side update index IS the VM's cp
    assert 0 <= s.cp <= |str| && inp == PIV.InpOfCp(str, s.cp);
    PIV.IdxInpOfCp(str, s.cp);
    var cpn: nat := s1.cp as nat;
    assert LC.Idx(inp) == cpn;
    var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);

    // the written gid is outside-look, hence outside S
    assert pc < endl by {
      TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
      assert pc < |code| == endl + 1;
      if pc == endl {
        assert NR.GetPcRE(code, pc) == Some(RB.Accept);
        assert false;
      }
    }
    var OL := PIV.CapIdsOutsideLooks(re);
    PIV.CaptureWriteIdsOutsideRENested(re, code, 0, endl, pc);
    assert reg in PIV.CaptureRegsSet(OL);
    assert gid in OL by {
      if t.g.Open? { assert reg == CP.start_reg(gid as int) == 2 * (gid as int); }
      else { assert reg == CP.end_reg(gid as int) == 2 * (gid as int) + 1; }
      if reg in (set cid: nat | cid in OL :: CP.start_reg(cid)) {
        var cid: nat :| cid in OL && reg == CP.start_reg(cid);
        assert reg == 2 * (cid as int);
        assert t.g.Open?;                              // parity
        assert cid == gid;
      } else {
        var cid: nat :| cid in OL && reg == CP.end_reg(cid);
        assert reg == 2 * (cid as int) + 1;
        assert t.g.Close?;                             // parity
        assert cid == gid;
      }
    }
    PIV.CapIdsLooksDisjoint(re);
    assert gid !in S by {
      if gid in PIV.CapIdsInLooks(re) { assert gid in OL * PIV.CapIdsInLooks(re); }
    }

    // B step: pts_active queues the child with the GMUpdate-moved gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm2)]);
    bst1 := PT.PTS(inp, [(t.t, gm2)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // raw witness: its walk peels the same GroupActionT (same reg pins the
    // same action via the erasure congruence), child walks at gm2
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtSetReg(rer, qm, code, inp, traw, gm, pc, ea, reg);
    assert traw.GroupActionT?;
    assert traw.g == t.g && CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.GroupActionT(traw.g, CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.GroupActionT(t.g, CE.ProgErase(t.t));
    }
    assert WalkPairLk(rer, qm, code, inp, traw.t, gm2, pc + 1, ea);

    // value ties for th': both sides move by the SAME GMUpdate at cpn
    var gml := PIV.GmOfLive(re, th.capture_regs, th.look_regs, th.quant_regs);
    var gml2 := PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs);
    assert gml2 == LG.GMUpdate(t.g, cpn, gml) by {
      if t.g.Open? {
        assert reg == 2 * (gid as int);
        assert reg % 2 == 0 && (reg / 2) as nat == gid;
      } else {
        assert reg == 2 * (gid as int) + 1;
        assert reg % 2 == 1 && (reg / 2) as nat == gid;
      }
    }
    assert gm2 == LG.GMUpdate(t.g, cpn, gm);
    assert GmtTieOutside(re, th, gm, S);

    assert GmtTieOutside(re, th', gm2, S) by {
      forall g: LG.GroupId | g !in S
        ensures (g in gm2 <==> g in gml2) && (g in gm2 ==> gm2[g] == gml2[g])
      {
        assert (g in gm <==> g in gml) && (g in gm ==> gm[g] == gml[g]);
        if g == gid {
          if t.g.Close? {
            // GMClose reads the incoming entry — it agrees on both sides
            assert (gid in gm <==> gid in gml) && (gid in gm ==> gm[gid] == gml[gid]);
          }
        }
        // g != gid: GMUpdate touches only gid, both maps unchanged at g
      }
    }
    assert th'.look_regs == th.look_regs && th'.quant_regs == th.quant_regs;
    assert (th.pc + 1) as nat == pc + 1;
    assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm2, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm2)] + ta[1..])[0] == (t.t, gm2) && ([(t.t, gm2)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // ---- (E3) the look-path carrier: fresh cap stamp, no new inside-S group ----
    assert LookNestRepC(re, S, ta, s.active);
    assert LookNestOkT(re, S, gm, th);
    var Bc := s1.clock;
    assert forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= Bc by {
      assert CM.RegsClocksLE(th.quant_regs, s.clock);
    }
    assert forall j: int ::
      AI.get_idx(th'.capture_regs.a_clk, j) == AI.get_idx(th.capture_regs.a_clk, j)
      || (AI.get_idx(th'.capture_regs.a_clk, j) >= 0 && AI.get_idx(th'.capture_regs.a_clk, j) >= Bc)
    by {
      RL.ASetLaws(th.capture_regs, reg, Some(s1.cp), s1.clock);
    }
    assert forall g: LG.GroupId :: g in S && g in gm2 ==> g in gm by {
      forall g: LG.GroupId | g in S && g in gm2 ensures g in gm {
        assert g != gid;
      }
    }
    LookNestOkTFreshCap(re, S, gm, gm2, th, th', Bc);
    assert LookNestRepC(re, S, [(t.t, gm2)] + ta[1..], vms2.active) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestOkT(re, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i])
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // ---- (E4) the converse carrier: look/quant banks untouched, gm grows ----
    assert LookNestBackRepC(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert forall g: LG.GroupId :: g in gm ==> g in gm2;   // GMOpen adds / GMClose keeps domain
    LookNestBackTRegSame(re, crv, str, ov, S, gm, gm2, th, th', ncap, nlook, nquant);
    assert LookNestBackRepC(re, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                            ncap, nlook, nquant) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestBackT(re, crv, str, ov, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i],
                              ncap, nlook, nquant)
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm2)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** SETQUANT (the quantifier Reset): B steps the `GroupActionT(Reset)` head;
      both value maps shed the SAME group set (`GMReset(qm.quants[q], ·)` —
      the A-side effect supplied by the dispatcher from
      `PSM.ResetStepThreadRE`), so the outside-`S` tie moves pointwise and the
      inside-`S` witnesses carry verbatim (look regs untouched; surviving
      groups unchanged). The raw layer steps by `WalkPairLkAtSetQuant`
      (forced-copy actions route OR the SQC see-through disjunct). `bq` is
      refuted by the canonical tie (`TreeRepLkREAtSetQuant`: compiled SQC
      sites always write `false`). */
  lemma LiftPreserveSetQuantLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                               crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                               bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                               q: int, bq: bool, th': AI.Thread, vms2: AI.VmState,
                               ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetQuantToClock(q, bq))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(quant_regs := AReg.set_reg(s.active[0].quant_regs, q,
                                                            if bq then Some(s1.cp) else None, s1.clock),
                                 pc := s.active[0].pc + 1)
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    // the register-level gm effect, supplied by the dispatcher from machine A's
    // proven step helper (ResetStepThreadRE); q's table binding rides along
    requires q in qm.quants
    // (E3) look-id uniqueness (cross-lid ownership pinning for the carrier)
    requires LTB.LookUnique(re)
    // (E4) converse-carrier feeds
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires CM.ThreadRegsWf(s.active[0], ncap, nlook, nquant)
    requires s.clock >= 0 && CM.ThreadClocksLE(s.active[0], s.clock)
    requires PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
          == LG.GMReset(qm.quants[q],
                        PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                     s.active[0].quant_regs))
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // canonical head: Reset(qm.quants[q]) with canonical child at (pc+1, ea);
    // pins !bq (compiled SQC sites always write false)
    TreeRepLkREAtSetQuant(rer, qm, code, inp, t, pc, ea, q, bq);
    assert !bq;
    var gidl := qm.quants[q];
    assert t.GroupActionT? && t.g == LG.Reset(gidl);
    assert TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
    assert gm2 == LG.GMReset(gidl, gm);

    // B step: pts_active queues the child with the Reset-moved gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm2)]);
    bst1 := PT.PTS(inp, [(t.t, gm2)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // raw witness: same Reset head via the SetQuant walk wrapper
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtSetQuant(rer, qm, code, inp, traw, gm, pc, ea, q);
    assert traw.GroupActionT? && traw.g == LG.Reset(gidl) == t.g;
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.GroupActionT(traw.g, CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.GroupActionT(t.g, CE.ProgErase(t.t));
    }
    assert WalkPairLk(rer, qm, code, inp, traw.t, gm2, pc + 1, ea);

    // value ties: both maps shed the SAME set(gidl); everything else unchanged
    var gml := PIV.GmOfLive(re, th.capture_regs, th.look_regs, th.quant_regs);
    var gml2 := PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs);
    assert gml2 == LG.GMReset(gidl, gml);
    assert GmtTieOutside(re, th, gm, S) && GmtTieInside(crv, str, ov, th, gm, S, ncap, nlook, nquant);

    assert GmtTieOutside(re, th', gm2, S) by {
      forall g: LG.GroupId | g !in S
        ensures (g in gm2 <==> g in gml2) && (g in gm2 ==> gm2[g] == gml2[g])
      {
        assert (g in gm <==> g in gml) && (g in gm ==> gm[g] == gml[g]);
      }
    }
    assert th'.look_regs == th.look_regs;
    assert GmtTieInside(crv, str, ov, th', gm2, S, ncap, nlook, nquant) by {
      forall g: LG.GroupId | g in S && g in gm2
        ensures exists l2: int ::
          0 <= l2 < nlook
          && g in PIV.CapIds(M.VBody(crv, l2))
          && M.MatchedPosLA(crv, th'.look_regs, l2)
          && var rf := M.FreshBodyMatch(crv, str, l2, th'.look_regs, ov, ncap, nlook, nquant);
             rf.Some?
             && var gmb := PIV.GmOfLive(M.VBody(crv, l2), rf.value.capture_regs,
                                        rf.value.look_regs, rf.value.quant_regs);
                var looktype := if 0 <= l2 < |crv.f_look_types| then crv.f_look_types[l2] else R.Lookahead;
                g in gmb && gm2[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb[g]) else gmb[g])
      {
        assert g in gm && gm2[g] == gm[g];   // survivors of the Reset are unchanged
        var l'': int :| 0 <= l'' < nlook
          && g in PIV.CapIds(M.VBody(crv, l''))
          && M.MatchedPosLA(crv, th.look_regs, l'')
          && var rf'' := M.FreshBodyMatch(crv, str, l'', th.look_regs, ov, ncap, nlook, nquant);
             rf''.Some?
             && var gmb'' := PIV.GmOfLive(M.VBody(crv, l''), rf''.value.capture_regs,
                                          rf''.value.look_regs, rf''.value.quant_regs);
                var looktype := if 0 <= l'' < |crv.f_look_types| then crv.f_look_types[l''] else R.Lookahead;
                g in gmb'' && gm[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb''[g]) else gmb''[g]);
      }
    }
    assert (th.pc + 1) as nat == pc + 1;
    assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm2, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm2)] + ta[1..])[0] == (t.t, gm2) && ([(t.t, gm2)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // ---- (E3) the look-path carrier: the Reset vacates on-path lids ----
    assert LookNestRepC(re, S, ta, s.active);
    assert LookNestOkT(re, S, gm, th);
    assert pc < endl by {
      TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
      assert pc < |code| == endl + 1;
      if pc == endl { assert NR.GetPcRE(code, pc) == Some(RB.Accept); assert false; }
    }
    PIV.QuantWriteIdsRE(re, code, 0, endl, pc);
    assert q >= 0 && (q as nat) in PIV.QuantIds(re);
    var qn: nat := q as nat;
    M.TransWfQidBody(re, qn);
    QmapOkAtQid(re, qm, qn);
    assert gidl == L.DefGroups(T.Translate(PIV.QidBody(re, qn)));
    M.TranslateDefGroupsEqCapIds(PIV.QidBody(re, qn));
    assert forall g: nat :: g in PIV.CapIds(PIV.QidBody(re, qn)) ==> g !in gm2 by {
      forall g: nat | g in PIV.CapIds(PIV.QidBody(re, qn)) ensures g !in gm2 {
        assert g in (set gx | gx in L.DefGroups(T.Translate(PIV.QidBody(re, qn))));
        assert g in gidl;                        // seq membership via the set identity
      }
    }
    assert forall g: LG.GroupId :: g in gm2 ==> g in gm;   // GMReset only removes
    assert forall j: int :: j != q ==>
      AI.get_idx(th'.quant_regs.a_clk, j) == AI.get_idx(th.quant_regs.a_clk, j)
    by { RL.ASetLaws(th.quant_regs, q, if bq then Some(s1.cp) else None, s1.clock); }
    LookNestOkTSetQuant(re, S, gm, gm2, th, th', qn);
    assert LookNestRepC(re, S, [(t.t, gm2)] + ta[1..], vms2.active) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestOkT(re, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i])
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // ---- (E4) converse: on-path dominance breaks; off-path scopes disjoint ----
    assert LookNestBackRepC(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert 0 <= q < nquant by {
      NI.QuantIdsLEMaxQuant(re);
      assert (q as nat) <= R.max_quant(re);
    }
    assert AI.get_idx(th'.quant_regs.a_clk, q) == s1.clock by {
      assert |th.quant_regs.a_clk| == nquant;
      RL.ASetLaws(th.quant_regs, q, if bq then Some(s1.cp) else None, s1.clock);
    }
    assert forall j: int :: AI.get_idx(th.look_regs.a_clk, j) < AI.get_idx(th'.quant_regs.a_clk, q as int) by {
      assert CM.RegsClocksLE(th.look_regs, s.clock);
    }
    assert forall g: LG.GroupId :: g in gm && g !in PIV.CapIds(PIV.QidBody(re, qn)) ==> g in gm2 by {
      forall g: LG.GroupId | g in gm && g !in PIV.CapIds(PIV.QidBody(re, qn))
        ensures g in gm2
      {
        assert g !in (set gx | gx in gidl);
        assert g !in gidl;
      }
    }
    LookNestBackTSetQuant(re, crv, str, ov, S, gm, gm2, th, th', qn, ncap, nlook, nquant);
    assert LookNestBackRepC(re, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                            ncap, nlook, nquant) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestBackT(re, crv, str, ov, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i],
                              ncap, nlook, nquant)
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm2)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** (L4 NESTED) clone of `LiftPreserveSetQuantLk` — GmtTieInside dropped. */
  lemma LiftPreserveSetQuantLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                               crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                               bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                               q: int, bq: bool, th': AI.Thread, vms2: AI.VmState,
                               ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetQuantToClock(q, bq))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(quant_regs := AReg.set_reg(s.active[0].quant_regs, q,
                                                            if bq then Some(s1.cp) else None, s1.clock),
                                 pc := s.active[0].pc + 1)
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    // the register-level gm effect, supplied by the dispatcher from machine A's
    // proven step helper (ResetStepThreadRE); q's table binding rides along
    requires q in qm.quants
    // (E3) look-id uniqueness (cross-lid ownership pinning for the carrier)
    requires LTB.LookUnique(re)
    // (E4) converse-carrier feeds
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires CM.ThreadRegsWf(s.active[0], ncap, nlook, nquant)
    requires s.clock >= 0 && CM.ThreadClocksLE(s.active[0], s.clock)
    requires PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
          == LG.GMReset(qm.quants[q],
                        PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                     s.active[0].quant_regs))
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // canonical head: Reset(qm.quants[q]) with canonical child at (pc+1, ea);
    // pins !bq (compiled SQC sites always write false)
    TreeRepLkREAtSetQuant(rer, qm, code, inp, t, pc, ea, q, bq);
    assert !bq;
    var gidl := qm.quants[q];
    assert t.GroupActionT? && t.g == LG.Reset(gidl);
    assert TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
    assert gm2 == LG.GMReset(gidl, gm);

    // B step: pts_active queues the child with the Reset-moved gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm2)]);
    bst1 := PT.PTS(inp, [(t.t, gm2)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // raw witness: same Reset head via the SetQuant walk wrapper
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtSetQuant(rer, qm, code, inp, traw, gm, pc, ea, q);
    assert traw.GroupActionT? && traw.g == LG.Reset(gidl) == t.g;
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.GroupActionT(traw.g, CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.GroupActionT(t.g, CE.ProgErase(t.t));
    }
    assert WalkPairLk(rer, qm, code, inp, traw.t, gm2, pc + 1, ea);

    // value ties: both maps shed the SAME set(gidl); everything else unchanged
    var gml := PIV.GmOfLive(re, th.capture_regs, th.look_regs, th.quant_regs);
    var gml2 := PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs);
    assert gml2 == LG.GMReset(gidl, gml);
    assert GmtTieOutside(re, th, gm, S);

    assert GmtTieOutside(re, th', gm2, S) by {
      forall g: LG.GroupId | g !in S
        ensures (g in gm2 <==> g in gml2) && (g in gm2 ==> gm2[g] == gml2[g])
      {
        assert (g in gm <==> g in gml) && (g in gm ==> gm[g] == gml[g]);
      }
    }
    assert th'.look_regs == th.look_regs;
    assert (th.pc + 1) as nat == pc + 1;
    assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm2, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm2)] + ta[1..])[0] == (t.t, gm2) && ([(t.t, gm2)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // ---- (E3) the look-path carrier: the Reset vacates on-path lids ----
    assert LookNestRepC(re, S, ta, s.active);
    assert LookNestOkT(re, S, gm, th);
    assert pc < endl by {
      TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
      assert pc < |code| == endl + 1;
      if pc == endl { assert NR.GetPcRE(code, pc) == Some(RB.Accept); assert false; }
    }
    PIV.QuantWriteIdsRENested(re, code, 0, endl, pc);
    assert q >= 0 && (q as nat) in PIV.QuantIds(re);
    var qn: nat := q as nat;
    M.TransWfQidBody(re, qn);
    QmapOkAtQid(re, qm, qn);
    assert gidl == L.DefGroups(T.Translate(PIV.QidBody(re, qn)));
    M.TranslateDefGroupsEqCapIds(PIV.QidBody(re, qn));
    assert forall g: nat :: g in PIV.CapIds(PIV.QidBody(re, qn)) ==> g !in gm2 by {
      forall g: nat | g in PIV.CapIds(PIV.QidBody(re, qn)) ensures g !in gm2 {
        assert g in (set gx | gx in L.DefGroups(T.Translate(PIV.QidBody(re, qn))));
        assert g in gidl;                        // seq membership via the set identity
      }
    }
    assert forall g: LG.GroupId :: g in gm2 ==> g in gm;   // GMReset only removes
    assert forall j: int :: j != q ==>
      AI.get_idx(th'.quant_regs.a_clk, j) == AI.get_idx(th.quant_regs.a_clk, j)
    by { RL.ASetLaws(th.quant_regs, q, if bq then Some(s1.cp) else None, s1.clock); }
    LookNestOkTSetQuant(re, S, gm, gm2, th, th', qn);
    assert LookNestRepC(re, S, [(t.t, gm2)] + ta[1..], vms2.active) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestOkT(re, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i])
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // ---- (E4) converse: on-path dominance breaks; off-path scopes disjoint ----
    assert LookNestBackRepC(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert 0 <= q < nquant by {
      NI.QuantIdsLEMaxQuant(re);
      assert (q as nat) <= R.max_quant(re);
    }
    assert AI.get_idx(th'.quant_regs.a_clk, q) == s1.clock by {
      assert |th.quant_regs.a_clk| == nquant;
      RL.ASetLaws(th.quant_regs, q, if bq then Some(s1.cp) else None, s1.clock);
    }
    assert forall j: int :: AI.get_idx(th.look_regs.a_clk, j) < AI.get_idx(th'.quant_regs.a_clk, q as int) by {
      assert CM.RegsClocksLE(th.look_regs, s.clock);
    }
    assert forall g: LG.GroupId :: g in gm && g !in PIV.CapIds(PIV.QidBody(re, qn)) ==> g in gm2 by {
      forall g: LG.GroupId | g in gm && g !in PIV.CapIds(PIV.QidBody(re, qn))
        ensures g in gm2
      {
        assert g !in (set gx | gx in gidl);
        assert g !in gidl;
      }
    }
    LookNestBackTSetQuantNested(re, crv, str, ov, S, gm, gm2, th, th', qn, ncap, nlook, nquant);
    assert LookNestBackRepC(re, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                            ncap, nlook, nquant) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestBackT(re, crv, str, ov, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i],
                              ncap, nlook, nquant)
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm2)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** FORK: forward = one `pts_active` on the `Choice` head (arms at `x`/`y`
      in VM priority order); backward = TWO B steps (`Progress` unwrap, then
      `Choice` split) per one VM step, `ea` pinned by the dispatcher from
      `EaColdOkRE`. Arms via `WalkPairLkAtForkArms` (erased-Choice witnesses);
      registers unchanged on both arms so the value ties carry verbatim.
      Mirror of `PSM.PreserveForkCase`. */
  lemma LiftPreserveForkLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                           bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                           x: int, y: int, vms2: AI.VmState,
                           ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Fork(x, y))
    // backward-fork flag pin (the dispatcher discharges it from EaColdOkRE)
    requires (x <= s.active[0].pc || y <= s.active[0].pc) ==> s.active[0].exit_allowed
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [AI.Thread(x, s.active[0].capture_regs, s.active[0].look_regs,
                                              s.active[0].quant_regs, s.active[0].exit_allowed),
                                    s.active[0].(pc := y)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tbl, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    TreeRepLkREAtFork(rer, qm, code, inp, t, pc, ea, x, y);
    assert x >= 0 && y >= 0;
    var th1 := AI.Thread(x, th.capture_regs, th.look_regs, th.quant_regs, ea);
    var th2 := th.(pc := y);
    assert vms2.active == [th1, th2] + s.active[1..];

    // raw witness + its arms (erased-Choice existential)
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtForkArms(rer, qm, code, inp, traw, gm, pc, ea, x, y);

    // value ties carry: both arm threads keep th's registers
    assert GmtTieOutside(re, th, gm, S) && GmtTieInside(crv, str, ov, th, gm, S, ncap, nlook, nquant);
    assert th1.capture_regs == th.capture_regs && th1.look_regs == th.look_regs
        && th1.quant_regs == th.quant_regs;
    assert GmtTieOutside(re, th1, gm, S) && GmtTieInside(crv, str, ov, th1, gm, S, ncap, nlook, nquant);
    assert GmtTieOutside(re, th2, gm, S) && GmtTieInside(crv, str, ov, th2, gm, S, ncap, nlook, nquant);

    if x as nat > pc && y as nat > pc {
      // ---- FORWARD: canonical Choice; one B step -------------------------
      assert t.Choice?
          && TreeRepLkRE(rer, qm, code, inp, t.t1, x as nat, ea)
          && TreeRepLkRE(rer, qm, code, inp, t.t2, y as nat, ea);
      assert CE.ProgErase(traw) == LT.Choice(CE.ProgErase(t.t1), CE.ProgErase(t.t2));
      assert CE.ProgErase(traw) != LT.Mismatch;
      var ta1: LT.Tree, ta2: LT.Tree :|
        CE.ProgErase(traw) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
        && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ea)
        && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ea);
      assert CE.ProgErase(ta1) == CE.ProgErase(t.t1) && CE.ProgErase(ta2) == CE.ProgErase(t.t2);
      assert th1.pc >= 0 && th2.pc >= 0;
      assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, ta1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, ta2, gm, th2, ncap, nlook, nquant);
      assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t2, gm, th2, ncap, nlook, nquant);

      var na := [(t.t1, gm), (t.t2, gm)];
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive(na);
      bst1 := PT.PTS(inp, na + ta[1..], best, tbl, SS.AddSeenTrees(seen, t));
      assert PTL.PikeTreeStepLk(bst, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(bst, bst1, bst1);

      assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert (na + ta[1..])[0] == (t.t1, gm) && (na + ta[1..])[1..] == [(t.t2, gm)] + ta[1..];
      assert ([(t.t2, gm)] + ta[1..])[0] == (t.t2, gm) && ([(t.t2, gm)] + ta[1..])[1..] == ta[1..];
      assert vms2.active[0] == th1 && vms2.active[1..] == [th2] + s.active[1..];
      assert ([th2] + s.active[1..])[0] == th2 && ([th2] + s.active[1..])[1..] == s.active[1..];
      assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, na + ta[1..], vms2.active,
                          ncap, nlook, nquant);

      assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(na + ta[1..]), PIV.HeadPcOf(vms2.active));
      IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
    } else {
      // ---- BACKWARD (do-while): ea pinned; TWO B steps -------------------
      assert ea;
      assert t.Progress? && t.t.Choice?
          && TreeRepLkRE(rer, qm, code, inp, t.t.t1, x as nat, true)
          && TreeRepLkRE(rer, qm, code, inp, t.t.t2, y as nat, true);
      assert CE.ProgErase(t) == LT.Choice(CE.ProgErase(t.t.t1), CE.ProgErase(t.t.t2));
      assert CE.ProgErase(traw) != LT.Mismatch;
      var ta1: LT.Tree, ta2: LT.Tree :|
        CE.ProgErase(traw) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
        && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ea)
        && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ea);
      assert CE.ProgErase(ta1) == CE.ProgErase(t.t.t1) && CE.ProgErase(ta2) == CE.ProgErase(t.t.t2);
      assert th1.pc >= 0 && th2.pc >= 0 && th1.exit_allowed && th2.exit_allowed;
      assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, ta1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, ta2, gm, th2, ncap, nlook, nquant);
      assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t.t1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t.t2, gm, th2, ncap, nlook, nquant);

      var mta := [(t.t, gm)] + ta[1..];
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
      var mid := PT.PTS(inp, mta, best, tbl, SS.AddSeenTrees(seen, t));
      assert PTL.PikeTreeStepLk(bst, mid);
      var na := [(t.t.t1, gm), (t.t.t2, gm)];
      assert mta[0] == (t.t, gm) && mta[1..] == ta[1..];
      assert PTL.TreeBfsStepLk(t.t, gm, inp) == PT.StepActive(na);
      bst1 := PT.PTS(inp, na + ta[1..], best, tbl,
                     SS.AddSeenTrees(SS.AddSeenTrees(seen, t), t.t));
      assert PTL.PikeTreeStepLk(mid, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(mid, bst1, bst1);
      TrcLkCons(bst, mid, bst1);

      assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert (na + ta[1..])[0] == (t.t.t1, gm) && (na + ta[1..])[1..] == [(t.t.t2, gm)] + ta[1..];
      assert ([(t.t.t2, gm)] + ta[1..])[0] == (t.t.t2, gm) && ([(t.t.t2, gm)] + ta[1..])[1..] == ta[1..];
      assert vms2.active[0] == th1 && vms2.active[1..] == [th2] + s.active[1..];
      assert ([th2] + s.active[1..])[0] == th2 && ([th2] + s.active[1..])[1..] == s.active[1..];
      assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, na + ta[1..], vms2.active,
                          ncap, nlook, nquant);

      assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(na + ta[1..]), PIV.HeadPcOf(vms2.active));
      SeenGrowSeenRepLk(rer, qm, code, inp, SS.AddSeenTrees(seen, t),
                        AI.bpc_add(s.processed, th.pc, ea), t.t,
                        PIV.HdTreeOf(na + ta[1..]), PIV.HeadPcOf(vms2.active));
      IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
      IsblockedGrowLk(rer, qm, code, inp, SS.AddSeenTrees(seen, t), s.isblocked, t.t);
    }
  }

  /** (L4 NESTED) clone of `LiftPreserveForkLk` — GmtTieInside dropped. */
  lemma LiftPreserveForkLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                           bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                           x: int, y: int, vms2: AI.VmState,
                           ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Fork(x, y))
    // backward-fork flag pin (the dispatcher discharges it from EaColdOkRE)
    requires (x <= s.active[0].pc || y <= s.active[0].pc) ==> s.active[0].exit_allowed
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [AI.Thread(x, s.active[0].capture_regs, s.active[0].look_regs,
                                              s.active[0].quant_regs, s.active[0].exit_allowed),
                                    s.active[0].(pc := y)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tbl, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    TreeRepLkREAtFork(rer, qm, code, inp, t, pc, ea, x, y);
    assert x >= 0 && y >= 0;
    var th1 := AI.Thread(x, th.capture_regs, th.look_regs, th.quant_regs, ea);
    var th2 := th.(pc := y);
    assert vms2.active == [th1, th2] + s.active[1..];

    // raw witness + its arms (erased-Choice existential)
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtForkArms(rer, qm, code, inp, traw, gm, pc, ea, x, y);

    // value ties carry: both arm threads keep th's registers
    assert GmtTieOutside(re, th, gm, S);
    assert th1.capture_regs == th.capture_regs && th1.look_regs == th.look_regs
        && th1.quant_regs == th.quant_regs;
    assert GmtTieOutside(re, th1, gm, S);
    assert GmtTieOutside(re, th2, gm, S);

    if x as nat > pc && y as nat > pc {
      // ---- FORWARD: canonical Choice; one B step -------------------------
      assert t.Choice?
          && TreeRepLkRE(rer, qm, code, inp, t.t1, x as nat, ea)
          && TreeRepLkRE(rer, qm, code, inp, t.t2, y as nat, ea);
      assert CE.ProgErase(traw) == LT.Choice(CE.ProgErase(t.t1), CE.ProgErase(t.t2));
      assert CE.ProgErase(traw) != LT.Mismatch;
      var ta1: LT.Tree, ta2: LT.Tree :|
        CE.ProgErase(traw) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
        && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ea)
        && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ea);
      assert CE.ProgErase(ta1) == CE.ProgErase(t.t1) && CE.ProgErase(ta2) == CE.ProgErase(t.t2);
      assert th1.pc >= 0 && th2.pc >= 0;
      assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, ta1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, ta2, gm, th2, ncap, nlook, nquant);
      assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t2, gm, th2, ncap, nlook, nquant);

      var na := [(t.t1, gm), (t.t2, gm)];
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive(na);
      bst1 := PT.PTS(inp, na + ta[1..], best, tbl, SS.AddSeenTrees(seen, t));
      assert PTL.PikeTreeStepLk(bst, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(bst, bst1, bst1);

      assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert (na + ta[1..])[0] == (t.t1, gm) && (na + ta[1..])[1..] == [(t.t2, gm)] + ta[1..];
      assert ([(t.t2, gm)] + ta[1..])[0] == (t.t2, gm) && ([(t.t2, gm)] + ta[1..])[1..] == ta[1..];
      assert vms2.active[0] == th1 && vms2.active[1..] == [th2] + s.active[1..];
      assert ([th2] + s.active[1..])[0] == th2 && ([th2] + s.active[1..])[1..] == s.active[1..];
      assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, na + ta[1..], vms2.active,
                          ncap, nlook, nquant);

      assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(na + ta[1..]), PIV.HeadPcOf(vms2.active));
      IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
    } else {
      // ---- BACKWARD (do-while): ea pinned; TWO B steps -------------------
      assert ea;
      assert t.Progress? && t.t.Choice?
          && TreeRepLkRE(rer, qm, code, inp, t.t.t1, x as nat, true)
          && TreeRepLkRE(rer, qm, code, inp, t.t.t2, y as nat, true);
      assert CE.ProgErase(t) == LT.Choice(CE.ProgErase(t.t.t1), CE.ProgErase(t.t.t2));
      assert CE.ProgErase(traw) != LT.Mismatch;
      var ta1: LT.Tree, ta2: LT.Tree :|
        CE.ProgErase(traw) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
        && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ea)
        && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ea);
      assert CE.ProgErase(ta1) == CE.ProgErase(t.t.t1) && CE.ProgErase(ta2) == CE.ProgErase(t.t.t2);
      assert th1.pc >= 0 && th2.pc >= 0 && th1.exit_allowed && th2.exit_allowed;
      assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, ta1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, ta2, gm, th2, ncap, nlook, nquant);
      assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t.t1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t.t2, gm, th2, ncap, nlook, nquant);

      var mta := [(t.t, gm)] + ta[1..];
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
      var mid := PT.PTS(inp, mta, best, tbl, SS.AddSeenTrees(seen, t));
      assert PTL.PikeTreeStepLk(bst, mid);
      var na := [(t.t.t1, gm), (t.t.t2, gm)];
      assert mta[0] == (t.t, gm) && mta[1..] == ta[1..];
      assert PTL.TreeBfsStepLk(t.t, gm, inp) == PT.StepActive(na);
      bst1 := PT.PTS(inp, na + ta[1..], best, tbl,
                     SS.AddSeenTrees(SS.AddSeenTrees(seen, t), t.t));
      assert PTL.PikeTreeStepLk(mid, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(mid, bst1, bst1);
      TrcLkCons(bst, mid, bst1);

      assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert (na + ta[1..])[0] == (t.t.t1, gm) && (na + ta[1..])[1..] == [(t.t.t2, gm)] + ta[1..];
      assert ([(t.t.t2, gm)] + ta[1..])[0] == (t.t.t2, gm) && ([(t.t.t2, gm)] + ta[1..])[1..] == ta[1..];
      assert vms2.active[0] == th1 && vms2.active[1..] == [th2] + s.active[1..];
      assert ([th2] + s.active[1..])[0] == th2 && ([th2] + s.active[1..])[1..] == s.active[1..];
      assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, na + ta[1..], vms2.active,
                          ncap, nlook, nquant);

      assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(na + ta[1..]), PIV.HeadPcOf(vms2.active));
      SeenGrowSeenRepLk(rer, qm, code, inp, SS.AddSeenTrees(seen, t),
                        AI.bpc_add(s.processed, th.pc, ea), t.t,
                        PIV.HdTreeOf(na + ta[1..]), PIV.HeadPcOf(vms2.active));
      IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
      IsblockedGrowLk(rer, qm, code, inp, SS.AddSeenTrees(seen, t), s.isblocked, t.t);
    }
  }

  /** The per-lid STATIC look-table package, bundled over `qm.looks`' domain:
      each gated lid has a correct `crv` row whose body is look-free, well-
      translated (`qm.looks[l]` IS the row's translation), compile-static
      (`StaticOkRE`/`SizesOkRE` for the body's own bytecode), value-confined
      (its groups are inside-look groups of `re`), and — for every flavour
      except the capturing `Lookahead` — capture-free. Threaded through
      `LiftStepC`/`LiftAdvanceEpsilon` into the gate-pass case; established
      once at the composite entry from the `FFullCompilation` tables. */
  ghost predicate GateStaticAt(qm: AR.QMap, re: R.regex, crv: CP.FCompiled, l: int,
                               ncap: int, nlook: int, nquant: int) {
    l in qm.looks
    && exists la: R.lookaround, body: R.regex ::
         LTB.LookEntryOk(crv, l, la, body)
         && T.TransWf(body) && NR.LookFreeRE(body)
         && qm.looks[l].0 == T.TrLookaround(la)
         && qm.looks[l].1 == T.Translate(body)
         && (set g: LG.GroupId | g in L.DefGroups(T.Translate(body))) <= PIV.CapIdsInLooks(re)
         && var bodycode := CP.compile_to_bytecode(body);
            |bodycode| >= 1
            && PSM.StaticOkRE(qm, body, bodycode, |bodycode| - 1)
            && PSM.SizesOkRE(body, ncap, nlook, nquant)
         && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body))
  }

  ghost predicate GateStaticsOk(qm: AR.QMap, re: R.regex, crv: CP.FCompiled,
                                ncap: int, nlook: int, nquant: int) {
    forall l: int | l in qm.looks ::
      0 <= l < nlook && GateStaticAt(qm, re, crv, l, ncap, nlook, nquant)
  }

  /** (L4 NESTED) depth-agnostic sibling of `GateStaticAt`: the per-lid look-
      table package with the body cap generalized off the DEPTH-1 look-free leaf.
      `NR.LookFreeRE(body)` becomes `NR.NestedFragmentRE(body)` (arbitrary look
      nesting) qualified by the positive-lookahead-nesting side conditions
      (`NR.NegLooksLookFreeRE(body)` — negative bodies stay look-free; and
      `M.NoPosLookbehindRE(body)` — positive nesting is lookAHEAD-only, matching
      the recursive value keystone `M.LkReplayMatchesSpecNested` and the per-body
      feed `LookNestOkTFromBodyReplay`). The body's compile statics lift from
      `PSM.StaticOkRE` to `PSM.StaticOkNestedRE`. The `DefGroups(body) ⊆
      CapIdsInLooks(re)` confinement + the negative-capture-free clause are
      verbatim. On look-free bodies (`NestDepth(body) == 0`) it coincides with
      `GateStaticAt` (`GateStaticAtFromDepth1`). */
  ghost predicate GateStaticAtNested(qm: AR.QMap, re: R.regex, crv: CP.FCompiled, l: int,
                                     ncap: int, nlook: int, nquant: int) {
    l in qm.looks
    && exists la: R.lookaround, body: R.regex ::
         LTB.LookEntryOk(crv, l, la, body)
         && T.TransWf(body) && NR.NestedFragmentRE(body)
         && NR.NegLooksLookFreeRE(body) && M.NoPosLookbehindRE(body)
         && qm.looks[l].0 == T.TrLookaround(la)
         && qm.looks[l].1 == T.Translate(body)
         && (set g: LG.GroupId | g in L.DefGroups(T.Translate(body))) <= PIV.CapIdsInLooks(re)
         && var bodycode := CP.compile_to_bytecode(body);
            |bodycode| >= 1
            && PSM.StaticOkNestedRE(qm, body, bodycode, |bodycode| - 1)
            && PSM.SizesOkRE(body, ncap, nlook, nquant)
         && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body))
  }

  ghost predicate GateStaticsOkNested(qm: AR.QMap, re: R.regex, crv: CP.FCompiled,
                                      ncap: int, nlook: int, nquant: int) {
    forall l: int | l in qm.looks ::
      0 <= l < nlook && GateStaticAtNested(qm, re, crv, l, ncap, nlook, nquant)
  }

  /** `PlusFragmentRE` is look-free by construction, so it sits inside the
      compile fragment (the two predicates differ only at the lookaround case,
      which `PlusFragmentRE` forbids). */
  lemma PlusFragmentIsLBF(r: R.regex)
    requires NR.PlusFragmentRE(r)
    ensures NR.LookBehindFragmentRE(r)
    decreases r
  {
    match r
    case Re_alt(r1, r2) => PlusFragmentIsLBF(r1); PlusFragmentIsLBF(r2);
    case Re_con(r1, r2) => PlusFragmentIsLBF(r1); PlusFragmentIsLBF(r2);
    case Re_quant(_, _, _, r1) => PlusFragmentIsLBF(r1);
    case Re_capture(_, r1) => PlusFragmentIsLBF(r1);
    case _ =>
  }

  /** A look-free regex owns no lookaround ids. */
  lemma LookFreeNoLids(r: R.regex)
    requires NR.LookFreeRE(r)
    ensures LTB.LookIds(r) == {}
    decreases r
  {
    match r
    case Re_alt(r1, r2) => LookFreeNoLids(r1); LookFreeNoLids(r2);
    case Re_con(r1, r2) => LookFreeNoLids(r1); LookFreeNoLids(r2);
    case Re_quant(_, _, _, r1) => LookFreeNoLids(r1);
    case Re_capture(_, r1) => LookFreeNoLids(r1);
    case _ =>
  }

  /** THE `GateStaticsOk` establishment sweep: every lid of `re` gets its
      per-lid bundle. All the qm/fragment facts descend definitionally to the
      lookaround node; the body's compile statics come from
      `CompileToBytecodeRepLookBehind` + `CompileStutterTameRE` via
      `PlusFragmentIsLBF`. `re0` carries the whole-regex confinement target. */
  lemma GateStaticsSweepRE(qm: AR.QMap, re0: R.regex, re: R.regex, crv: CP.FCompiled,
                           ncap: int, nlook: int, nquant: int)
    requires T.TransWf(re) && AR.QmapOk(re, qm) && AR.LmapOk(re, qm)
    requires NR.LookBehindFragmentRE(re) && PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires PIV.CapIdsInLooks(re) <= PIV.CapIdsInLooks(re0)
    ensures forall l: int :: l >= 0 && (l as nat) in LTB.LookIds(re) ==>
      GateStaticAt(qm, re0, crv, l, ncap, nlook, nquant)
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      GateStaticsSweepRE(qm, re0, r1, crv, ncap, nlook, nquant);
      GateStaticsSweepRE(qm, re0, r2, crv, ncap, nlook, nquant);
    case Re_con(r1, r2) =>
      GateStaticsSweepRE(qm, re0, r1, crv, ncap, nlook, nquant);
      GateStaticsSweepRE(qm, re0, r2, crv, ncap, nlook, nquant);
    case Re_quant(_, _, _, r1) =>
      GateStaticsSweepRE(qm, re0, r1, crv, ncap, nlook, nquant);
    case Re_capture(_, r1) =>
      GateStaticsSweepRE(qm, re0, r1, crv, ncap, nlook, nquant);
    case Re_lookaround(lid, la, body) =>
      LookFreeNoLids(body);
      if lid >= 0 {
        // the node's own bundle
        assert LTB.LookEntryOk(crv, lid, la, body);
        assert T.TransWf(body) && NR.LookFreeRE(body) && NR.PlusFragmentRE(body);
        assert lid in qm.looks && qm.looks[lid] == (T.TrLookaround(la), T.Translate(body));
        // confinement: the body's groups are inside-look groups of re0
        M.TranslateDefGroupsEqCapIds(body);
        assert PIV.CapIdsInLooks(re) == PIV.CapIds(body);
        assert (set g: LG.GroupId | g in L.DefGroups(T.Translate(body))) <= PIV.CapIdsInLooks(re0);
        // compile statics for the body's own bytecode
        PlusFragmentIsLBF(body);
        NR.CompileToBytecodeRepLookBehind(body);
        PIV.CompileStutterTameRE(body);
        var bodycode := CP.compile_to_bytecode(body);
        var next := CP.compile(body, 0, CP.Progress).1;
        assert next >= 0 && |bodycode| == next + 1 && |bodycode| >= 1;
        assert NR.NfaRepRE(body, bodycode, 0, next as nat)
            && NR.GetPcRE(bodycode, next as nat) == Some(RB.Accept);
        assert (next as nat) == |bodycode| - 1;
        assert PSM.StaticOkRE(qm, body, bodycode, |bodycode| - 1);
        assert PSM.SizesOkRE(body, ncap, nlook, nquant);
        assert (la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body);
        assert GateStaticAt(qm, re0, crv, lid, ncap, nlook, nquant);
      }
    case _ =>
  }

  /** TOP-LEVEL establishment: `GateStaticsOk` from the compile tables + qm
      well-formedness (`qm.looks`' domain within `re`'s lids is the caller's
      obligation — true by qm's construction). */
  lemma GateStaticsFromTables(qm: AR.QMap, re: R.regex, crv: CP.FCompiled,
                              ncap: int, nlook: int, nquant: int)
    requires T.TransWf(re) && AR.QmapOk(re, qm) && AR.LmapOk(re, qm)
    requires NR.LookBehindFragmentRE(re) && PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires forall l: int :: l in qm.looks ==>
      l >= 0 && (l as nat) in LTB.LookIds(re) && l < nlook
    ensures GateStaticsOk(qm, re, crv, ncap, nlook, nquant)
  {
    GateStaticsSweepRE(qm, re, re, crv, ncap, nlook, nquant);
  }

  /** (L4 NESTED) `PIV.CompileStutterTameRE` off the depth-1 fragment: the Jmp-
      target tameness of a compiled block depends only on `NfaRepRE(re, code, 0,
      endl)` (which `PIV.CompileJumpsRE` consumes — it takes NO fragment
      hypothesis), so `NR.CompileToBytecodeRepNested` supplies it for any nested
      fragment. Depth-general. */
  lemma CompileStutterTameRENested(re: R.regex)
    requires NR.NestedFragmentRE(re)
    ensures PIV.StutterTameRE(CP.compile_to_bytecode(re))
  {
    var code := CP.compile_to_bytecode(re);
    var endl := CP.compile(re, 0, CP.Progress).1;
    NR.CompileToBytecodeRepNested(re);   // NfaRepRE(re, code, 0, endl), GetPc(endl)==Accept, |code|==endl+1
    forall pc: nat | pc < |code|
      ensures match NR.GetPcRE(code, pc)
              case Some(Jmp(next)) =>
                pc < next
                || (next >= 0 && NR.GetPcRE(code, next as nat).Some? && NR.GetPcRE(code, next as nat).value.Fork?)
              case _ => true
    {
      match NR.GetPcRE(code, pc)
      case Some(Jmp(n)) =>
        assert pc < endl as nat;   // code[endl] == Accept ≠ Jmp, and pc < |code| == endl+1
        PIV.CompileJumpsRE(re, code, 0, endl as nat, pc, n);
      case _ =>
    }
  }

  /** (L4 NESTED) `GateStaticsSweepRENested` — the nested-fragment establishment
      sweep, off `GateStaticsSweepRE`. Two changes: the body-cap facts are the
      NESTED ones (`NestedFragmentRE`/`StaticOkNestedRE` via
      `CompileToBytecodeRepNested`+`CompileStutterTameRENested`), and — crucially —
      the sweep RECURSES INTO each lookaround body (`GateStaticsSweepRE` stopped at
      the leaf because look-free bodies own no lids). Every static fact descends
      DEFINITIONALLY to the body at a `Re_lookaround` node (TransWf/QmapOk/LmapOk/
      CapUnique/QuantUnique/NestedFragmentRE/NegLooksLookFreeRE/NoPosLookbehindRE/
      LookTablesOk/SizesOkRE); the confinement descends via `CapIdsInLooks(body) ⊆
      CapIds(body) == CapIdsInLooks(re) ⊆ CapIdsInLooks(re0)`. `re0` carries the
      whole-regex confinement target. */
  lemma GateStaticsSweepRENested(qm: AR.QMap, re0: R.regex, re: R.regex, crv: CP.FCompiled,
                                 ncap: int, nlook: int, nquant: int)
    requires T.TransWf(re) && AR.QmapOk(re, qm) && AR.LmapOk(re, qm)
    requires NR.NestedFragmentRE(re) && NR.NegLooksLookFreeRE(re) && M.NoPosLookbehindRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires PIV.CapIdsInLooks(re) <= PIV.CapIdsInLooks(re0)
    ensures forall l: int :: l >= 0 && (l as nat) in LTB.LookIds(re) ==>
      GateStaticAtNested(qm, re0, crv, l, ncap, nlook, nquant)
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      GateStaticsSweepRENested(qm, re0, r1, crv, ncap, nlook, nquant);
      GateStaticsSweepRENested(qm, re0, r2, crv, ncap, nlook, nquant);
    case Re_con(r1, r2) =>
      GateStaticsSweepRENested(qm, re0, r1, crv, ncap, nlook, nquant);
      GateStaticsSweepRENested(qm, re0, r2, crv, ncap, nlook, nquant);
    case Re_quant(_, _, _, r1) =>
      GateStaticsSweepRENested(qm, re0, r1, crv, ncap, nlook, nquant);
    case Re_capture(_, r1) =>
      GateStaticsSweepRENested(qm, re0, r1, crv, ncap, nlook, nquant);
    case Re_lookaround(lid, la, body) =>
      // confinement: CapIdsInLooks(body) ⊆ CapIds(body) == CapIdsInLooks(re) ⊆ CapIdsInLooks(re0)
      PIV.CapIdsSplit(body);
      assert PIV.CapIdsInLooks(re) == PIV.CapIds(body);
      assert PIV.CapIdsInLooks(body) <= PIV.CapIdsInLooks(re0);
      // recurse into the body for its OWN inner lids
      GateStaticsSweepRENested(qm, re0, body, crv, ncap, nlook, nquant);
      if lid >= 0 {
        // the node's own bundle
        assert LTB.LookEntryOk(crv, lid, la, body);
        assert T.TransWf(body) && NR.NestedFragmentRE(body)
            && NR.NegLooksLookFreeRE(body) && M.NoPosLookbehindRE(body);
        assert lid in qm.looks && qm.looks[lid] == (T.TrLookaround(la), T.Translate(body));
        // confinement: the body's groups are inside-look groups of re0
        M.TranslateDefGroupsEqCapIds(body);
        assert (set g: LG.GroupId | g in L.DefGroups(T.Translate(body))) <= PIV.CapIdsInLooks(re0);
        // compile statics for the body's own bytecode (NESTED)
        NR.CompileToBytecodeRepNested(body);
        CompileStutterTameRENested(body);
        var bodycode := CP.compile_to_bytecode(body);
        var next := CP.compile(body, 0, CP.Progress).1;
        assert next >= 0 && |bodycode| == next + 1 && |bodycode| >= 1;
        assert NR.NfaRepRE(body, bodycode, 0, next as nat)
            && NR.GetPcRE(bodycode, next as nat) == Some(RB.Accept);
        assert (next as nat) == |bodycode| - 1;
        assert PSM.StaticOkNestedRE(qm, body, bodycode, |bodycode| - 1);
        assert PSM.SizesOkRE(body, ncap, nlook, nquant);
        assert (la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body);
        assert GateStaticAtNested(qm, re0, crv, lid, ncap, nlook, nquant);
      }
    case _ =>
  }

  /** (L4 NESTED) TOP-LEVEL establishment of `GateStaticsOkNested` from the
      compile tables + nested-fragment well-formedness (`M.NoPosLookbehindRE` +
      `NR.NegLooksLookFreeRE` pin the positive-lookahead-nesting scope). Proves
      `GateStaticsOkNested` is DISCHARGEABLE for the nested fragment — the
      "requires-side" of the non-vacuity claim. Off `GateStaticsFromTables`. */
  lemma GateStaticsFromTablesNested(qm: AR.QMap, re: R.regex, crv: CP.FCompiled,
                                    ncap: int, nlook: int, nquant: int)
    requires T.TransWf(re) && AR.QmapOk(re, qm) && AR.LmapOk(re, qm)
    requires NR.NestedFragmentRE(re) && NR.NegLooksLookFreeRE(re) && M.NoPosLookbehindRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires forall l: int :: l in qm.looks ==>
      l >= 0 && (l as nat) in LTB.LookIds(re) && l < nlook
    ensures GateStaticsOkNested(qm, re, crv, ncap, nlook, nquant)
  {
    GateStaticsSweepRENested(qm, re, re, crv, ncap, nlook, nquant);
  }

  /** A look-free regex has no lookaround nodes, so it vacuously has no positive
      lookbehinds (`M.NoPosLookbehindRE` only constrains lookaround leaves). */
  lemma LookFreeNoPosLookbehindRE(re: R.regex)
    requires NR.LookFreeRE(re)
    ensures M.NoPosLookbehindRE(re)
    decreases re
  {
    match re
    case Re_alt(r1, r2) => LookFreeNoPosLookbehindRE(r1); LookFreeNoPosLookbehindRE(r2);
    case Re_con(r1, r2) => LookFreeNoPosLookbehindRE(r1); LookFreeNoPosLookbehindRE(r2);
    case Re_quant(_, _, _, r1) => LookFreeNoPosLookbehindRE(r1);
    case Re_capture(_, r1) => LookFreeNoPosLookbehindRE(r1);
    case _ =>
  }

  /** (L4 NESTED) the depth-1 gate-static package embeds in the nested one:
      `GateStaticAt ⟹ GateStaticAtNested` on look-free bodies. Confirms
      `GateStaticAtNested` is a genuine WEAKENING (every depth-1 caller feeds the
      nested chain) and that the two coincide at `NestDepth(body) == 0`. The
      look-free body's nested facts come from `LookFreePlusIsNestedRE`/
      `LookFreeNegLooksLookFree`/`LookFreeNoPosLookbehindRE`, and its
      `StaticOkNestedRE` from `PSM.StaticOkRENestedFromRE`. */
  lemma GateStaticAtImpliesNested(qm: AR.QMap, re: R.regex, crv: CP.FCompiled, l: int,
                                  ncap: int, nlook: int, nquant: int)
    requires GateStaticAt(qm, re, crv, l, ncap, nlook, nquant)
    ensures GateStaticAtNested(qm, re, crv, l, ncap, nlook, nquant)
  {
    var la: R.lookaround, body: R.regex :|
      LTB.LookEntryOk(crv, l, la, body)
      && T.TransWf(body) && NR.LookFreeRE(body)
      && qm.looks[l].0 == T.TrLookaround(la)
      && qm.looks[l].1 == T.Translate(body)
      && (set g: LG.GroupId | g in L.DefGroups(T.Translate(body))) <= PIV.CapIdsInLooks(re)
      && var bodycode := CP.compile_to_bytecode(body);
         |bodycode| >= 1
         && PSM.StaticOkRE(qm, body, bodycode, |bodycode| - 1)
         && PSM.SizesOkRE(body, ncap, nlook, nquant)
      && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
    var bodycode := CP.compile_to_bytecode(body);
    // look-free body ⟹ the nested-fragment side conditions
    NR.LookFreeIsPlusFragmentRE(body);      // PlusFragmentRE(body) (StaticOkRE ⟹ LookBehindFragmentRE(body))
    NR.LookFreePlusIsNestedRE(body);        // NestedFragmentRE(body)
    NR.LookFreeNegLooksLookFree(body);      // NegLooksLookFreeRE(body)
    LookFreeNoPosLookbehindRE(body);        // NoPosLookbehindRE(body)
    PSM.StaticOkRENestedFromRE(qm, body, bodycode, |bodycode| - 1);  // StaticOkNestedRE(body)
    assert GateStaticAtNested(qm, re, crv, l, ncap, nlook, nquant);
  }

  lemma GateStaticsOkImpliesNested(qm: AR.QMap, re: R.regex, crv: CP.FCompiled,
                                   ncap: int, nlook: int, nquant: int)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)
    ensures GateStaticsOkNested(qm, re, crv, ncap, nlook, nquant)
  {
    forall l: int | l in qm.looks
      ensures 0 <= l < nlook && GateStaticAtNested(qm, re, crv, l, ncap, nlook, nquant)
    {
      GateStaticAtImpliesNested(qm, re, crv, l, ncap, nlook, nquant);
    }
  }

  /** POSITIVE GATE, PASSING: the VM writes `a_cp[l] := cp` and continues; B
      steps the `LK` head, `gmt` merges `LkResult`. Split by the lid's static
      flavour: a capturing `Lookahead` goes through the proven
      `ThreadRepLkStepCheckOracle` (with `GateStepValue` inside); a positive
      `Lookbehind` is CAPTURE-FREE (fragment), so the merge agrees with `gm`
      everywhere (`LkResultAgreeOutside` over an empty group set) and the
      inside-`S` witnesses carry across the `a_cp[l]`-only write (Case B
      pattern). Negative flavours are refuted by the polarity pin. */
  lemma LiftPreserveGatePassLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                               crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                               bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                               l: int, th': AI.Thread, vms2: AI.VmState,
                               ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires |ov| == |str| + 1                                    // L3b: the backward LB gate needs the mirror
    requires S == PIV.CapIdsInLooks(re)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires CM.ThreadRegsWf(s.active[0], ncap, nlook, nquant)
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.CheckOracle(l))
    requires LOr.view_get_oracle(ov, s.cp, l)
    // (E3) carrier feeds: freshness, positional invariant, look uniqueness
    requires s.clock >= 0 && CM.ThreadClocksLE(s.active[0], s.clock)
    requires PSM.ThreadNestRE(re, code, endl, s.active[0].pc, s.active[0])
    requires LTB.LookUnique(re)
    // (E4) the row↔structure tie for the converse coverage
    requires LTB.LookTablesOk(re, crv)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(pc := s.active[0].pc + 1,
                                 look_regs := AReg.set_reg(s.active[0].look_regs, l, Some(s1.cp), s1.clock))
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tbl, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // gate pc interior + polarity pin
    TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
    assert |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept);
    assert pc < endl;
    GatePolarityRE(re, qm, code, 0, endl, pc);
    assert l in qm.looks;
    var lk := qm.looks[l].0;
    var r1 := qm.looks[l].1;
    assert AR.PositiveL(lk) && L.Positivity(lk);

    // position glue
    assert 0 <= s.cp <= |str| && inp == PIV.InpOfCp(str, s.cp);
    var cp: nat := s.cp as nat;
    PIV.IdxInpOfCp(str, cp);
    assert TREP.CpOf(inp) == cp && TR_CpOf(inp) == cp;
    assert LL.OracleOkAt(rer, qm, inp);

    // raw witness at the gate: the walk lemma keys on the (true) oracle bit
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    assert WalkPairLk(rer, qm, code, inp, traw, gm, pc, ea);
    WalkPairLkAtCheckOracle(rer, qm, code, inp, traw, gm, pc, ea, l);
    assert LOr.view_get_oracle(qm.ov, TR_CpOf(inp), l);
    assert traw.LK? && traw.lk == lk;
    assert EL.LkGateOk(rer, lk, r1, inp, traw.tlk, true);
    var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    assert traw.tlk == tlk;                                   // LkGateOk pins tlk functionally
    assert LS.LkResult(lk, tlk, LG.Empty, inp).Some?;
    assert LS.LkResult(lk, tlk, gm, inp).Some?;
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    assert WalkPairLk(rer, qm, code, inp, traw.t, gm2, pc + 1, ea);
    assert forall gg :: gg in L.DefGroups(r1) ==> gg !in gm;  // the gate's own clear instance

    // canonical head: the LK branch of the gate rule (functional verdict Some)
    TreeRepLkREAtCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    assert t.LK? && t.lk == lk && t.tlk == tlk
        && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    // erasure congruence: children tie
    assert CE.ProgErase(traw) == LT.LK(lk, CE.ProgErase(traw.tlk), CE.ProgErase(traw.t));
    assert CE.ProgErase(t) == LT.LK(lk, CE.ProgErase(t.tlk), CE.ProgErase(t.t));
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t);

    // B step on the canonical LK head: pts_active with the merged gm
    assert LS.LkResult(t.lk, t.tlk, gm, inp) == Some(gm2);
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm2)]);
    bst1 := PT.PTS(inp, [(t.t, gm2)] + ta[1..], best, tbl, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the per-lid static package
    var la: R.lookaround, body: R.regex :|
      LTB.LookEntryOk(crv, l, la, body)
      && T.TransWf(body) && NR.LookFreeRE(body)
      && qm.looks[l].0 == T.TrLookaround(la)
      && qm.looks[l].1 == T.Translate(body)
      && (set g: LG.GroupId | g in L.DefGroups(T.Translate(body))) <= PIV.CapIdsInLooks(re)
      && var bodycode := CP.compile_to_bytecode(body);
         |bodycode| >= 1
         && PSM.StaticOkRE(qm, body, bodycode, |bodycode| - 1)
         && PSM.SizesOkRE(body, ncap, nlook, nquant)
      && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
    assert lk == T.TrLookaround(la) && r1 == T.Translate(body);
    assert body == M.VBody(crv, l);
    assert 0 <= l < nlook;

    var clk := s1.clock;
    assert th' == th.(pc := th.pc + 1, look_regs := AReg.set_reg(th.look_regs, l, Some(cp as int), clk));

    // the polarity pin refutes the negative flavours
    assert !la.NegLookahead? && !la.NegLookbehind? by {
      if la.NegLookahead? || la.NegLookbehind? { assert !L.Positivity(lk); }
    }
    M.LkBodyGroupsEqCapIdsInLooks(re);
    assert S == LL.LkBodyGroups(T.Translate(re));

    if la.Lookahead? {
      // ---- capturing-lookahead half: the proven crux core -------------------
      assert crv.f_look_types[l] == la && crv.f_look_types[l].Lookahead?;
      assert AI.capture_type(crv.f_look_types[l]);
      assert L.LkDir(lk) == WP.Forward;
      assert RL.ASize(th.look_regs) == nlook;
      var bodycode := CP.compile_to_bytecode(body);
      assert LT.LK(lk, tlk, traw.t) == traw;
      ThreadRepLkStepCheckOracle(rer, qm, re, code, crv, str, ov, S, lk, r1, tlk, traw.t,
                                 gm, th, l, cp, clk, body, la, bodycode, |bodycode| - 1, 0,
                                 th.quant_regs, ncap, nlook, nquant);
      assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
    } else {
      // ---- capture-free positive look (Lookbehind) --------------------------
      assert la.Lookbehind?;
      if NR.CaptureFreeRE(body) {
      // ---- capture-free positive lookbehind: gm2 == gm, no inside-S groups --------
      assert NR.CaptureFreeRE(body);
      PIV.CaptureFreeNoCapIds(body);
      M.TranslateDefGroupsEqCapIds(body);
      assert (set g | g in L.DefGroups(r1)) == PIV.CapIds(body) == {};
      // the merge over an EMPTY group set agrees with gm everywhere
      EL.TranslateNoLkBr(body);
      LkResultAgreeOutside(rer, lk, r1, inp, tlk, gm);
      assert forall g: LG.GroupId :: (g in gm2 <==> g in gm) && (g in gm2 ==> gm2[g] == gm[g]) by {
        forall g: LG.GroupId ensures (g in gm2 <==> g in gm) && (g in gm2 ==> gm2[g] == gm[g]) {
          assert g !in (set gx | gx in L.DefGroups(r1)) by {
            if g in (set gx | gx in L.DefGroups(r1)) { assert g in PIV.CapIds(body); }
          }
        }
      }

      // outside tie: the gate-crossing frame (works for backward gates too)
      GmtTieOutsideAfterGate(rer, re, str, lk, r1, tlk, gm, th, l, cp, clk, S);
      assert GmtTieOutside(re, th', gm2, S);

      // inside tie: witnesses carry across the l-only look-reg write
      assert GmtTieInside(crv, str, ov, th, gm, S, ncap, nlook, nquant);
      assert GmtTieInside(crv, str, ov, th', gm2, S, ncap, nlook, nquant) by {
        forall g: LG.GroupId | g in S && g in gm2
          ensures exists l2: int ::
            0 <= l2 < nlook
            && g in PIV.CapIds(M.VBody(crv, l2))
            && M.MatchedPosLA(crv, th'.look_regs, l2)
            && var rf := M.FreshBodyMatch(crv, str, l2, th'.look_regs, ov, ncap, nlook, nquant);
               rf.Some?
               && var gmb := PIV.GmOfLive(M.VBody(crv, l2), rf.value.capture_regs,
                                          rf.value.look_regs, rf.value.quant_regs);
                  var looktype := if 0 <= l2 < |crv.f_look_types| then crv.f_look_types[l2] else R.Lookahead;
                  g in gmb && gm2[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb[g]) else gmb[g])
        {
          assert g in gm && gm2[g] == gm[g];
          var l'': int :| 0 <= l'' < nlook
            && g in PIV.CapIds(M.VBody(crv, l''))
            && M.MatchedPosLA(crv, th.look_regs, l'')
            && var rf'' := M.FreshBodyMatch(crv, str, l'', th.look_regs, ov, ncap, nlook, nquant);
               rf''.Some?
               && var gmb'' := PIV.GmOfLive(M.VBody(crv, l''), rf''.value.capture_regs,
                                            rf''.value.look_regs, rf''.value.quant_regs);
                  var looktype := if 0 <= l'' < |crv.f_look_types| then crv.f_look_types[l''] else R.Lookahead;
                  g in gmb'' && gm[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb''[g]) else gmb''[g]);
          // l'' != l: the l-row's body is capture-free, so it owns no groups
          assert l'' != l by {
            if l'' == l { assert g in PIV.CapIds(M.VBody(crv, l)); assert g in PIV.CapIds(body); }
          }
          // th' differs from th only at slot l ⟹ l'' reads the SAME cp on both banks
          RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
          assert AReg.get_cp(th'.look_regs, l'') == AReg.get_cp(th.look_regs, l'');
          assert M.MatchedPosLA(crv, th'.look_regs, l'');
          assert M.FreshBodyMatch(crv, str, l'', th'.look_regs, ov, ncap, nlook, nquant)
              == M.FreshBodyMatch(crv, str, l'', th.look_regs, ov, ncap, nlook, nquant);
        }
      }
      assert (th.pc + 1) as nat == pc + 1;
      assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
      } else {
        // ---- CAPTURING positive lookbehind: keystone-based backward gate ----
        var bodycode := CP.compile_to_bytecode(body);
        assert LT.LK(lk, tlk, traw.t) == traw;
        // ---- the keystone-gate static package for the body ----
        assert PSM.StaticOkRE(qm, body, bodycode, |bodycode| - 1);   // ⟹ CapUnique(body) & QuantUnique(body)
        assert PIV.CapUnique(body) && PIV.QuantUnique(body);
        PIV.LookCheckIdsRE(re, code, 0, endl, pc);                   // (l as nat) in LookIds(re)
        assert (l as nat) in LTB.LookIds(re);
        NI.LookBodyOfTablesTie(re, crv, l as nat);                   // VBody(crv,l) == LookBodyOfRE(re,l)
        NI.LookBodyOfFragment(re, l as nat);                        // PlusFragmentRE(body)
        assert NR.PlusFragmentRE(body);
        OS.TranslateLookFreeGroupOk(body);                         // GroupOkL(Translate(body))
        TranslateDefGroupsNoDup(body);                             // NoDupSeq == CD.NoDupG (same def)
        assert CD.NoDupG(L.DefGroups(T.Translate(body)));
        assert |ov| == |str| + 1;
        ThreadRepLkStepCheckOracleLB(rer, qm, re, code, crv, str, ov, S, lk, r1, tlk, traw.t,
                                     gm, th, l, cp, clk, body, la, bodycode, |bodycode| - 1, 0,
                                     th.quant_regs, ncap, nlook, nquant);
        assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
      }
    }

    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm2, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm2)] + ta[1..])[0] == (t.t, gm2) && ([(t.t, gm2)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // ---- (E3) the look-path carrier: the crossing establishes lid l fresh ----
    assert LookNestRepC(re, S, ta, s.active);
    assert LookNestOkT(re, S, gm, th);
    assert NI.NestInvRE(re, code, 0, endl, pc, th.capture_regs.a_clk, th.quant_regs.a_clk, -1) by {
      assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
      assert pc < endl;
    }
    RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
    assert AI.get_idx(th'.look_regs.a_clk, l) == clk && clk >= 0;
    assert forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= AI.get_idx(th'.look_regs.a_clk, l) by {
      assert CM.RegsClocksLE(th.quant_regs, s.clock);
    }
    assert forall j: int :: j != l ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j);
    // ownership: the fold adds only l-owned groups (LmapOk row + fold confinement)
    PIV.LookCheckIdsRE(re, code, 0, endl, pc);
    assert l >= 0 && (l as nat) in LTB.LookIds(re);
    LmapOkAtLid(re, qm, l as nat);
    var LB := NI.LookBodyOfRE(re, l as nat);
    assert r1 == T.Translate(LB);
    M.TranslateDefGroupsEqCapIds(LB);
    assert (set gx | gx in L.DefGroups(r1)) == PIV.CapIds(LB);
    EL.TranslateNoLkBr(body);
    assert EL.NoLkBrL(r1);
    LkResultAgreeOutside(rer, lk, r1, inp, tlk, gm);
    assert forall g: LG.GroupId :: g in S && g in gm2 && g !in gm ==>
      l >= 0 && (l as nat) in LTB.LookIds(re) && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
    by {
      forall g: LG.GroupId | g in S && g in gm2 && g !in gm
        ensures g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
      {
        if g !in (set gx | gx in L.DefGroups(r1)) {
          assert g in gm;                          // GmAgreeOutside membership
          assert false;
        }
      }
    }
    LookNestOkTGatePass(re, code, endl, S, gm, gm2, th, th', pc, l);
    assert LookNestRepC(re, S, [(t.t, gm2)] + ta[1..], vms2.active) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestOkT(re, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i])
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // ---- (E4) converse: the crossing's coverage from the replay↔spec tie ----
    assert LookNestBackRepC(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    // structural body == row body (both pin f_look_ast[l])
    NI.LookBodyOfTablesTie(re, crv, l as nat);
    var la3: R.lookaround :| LTB.LookEntryOk(crv, l, la3, NI.LookBodyOfRE(re, l as nat));
    assert NI.LookBodyOfRE(re, l as nat) == body;
    // gm only grows across the fold (its S-body keys were CLEAR coming in)
    assert forall g: LG.GroupId :: g in gm ==> g in gm2 by {
      forall g: LG.GroupId | g in gm ensures g in gm2 {
        assert g !in (set gx | gx in L.DefGroups(r1)) by {
          if g in (set gx | gx in L.DefGroups(r1)) { assert g !in gm; }
        }
      }
    }
    // the crossing coverage for l itself
    assert var rfx := M.FreshBodyMatch(crv, str, l, th'.look_regs, ov, ncap, nlook, nquant);
      rfx.Some? ==>
        forall g: LG.GroupId ::
          g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                               rfx.value.look_regs, rfx.value.quant_regs)
          ==> g in gm2
    by {
      var rfx := M.FreshBodyMatch(crv, str, l, th'.look_regs, ov, ncap, nlook, nquant);
      if rfx.Some? {
        if la.Lookahead? {
          M.TranslateDefGroupsEqCapIds(body);
          EL.TranslateNoLkBr(body);
          EL.ComputeTrGmIndepLk(rer, r1, inp, gm, WP.Forward);
          assert tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, gm, WP.Forward);
          assert M.GmAgreeOn(gm, LG.Empty, set gx | gx in L.DefGroups(r1)) by {
            forall g: LG.GroupId | g in (set gx | gx in L.DefGroups(r1))
              ensures (g in gm <==> g in LG.Empty) && (g in gm ==> gm[g] == LG.Empty[g])
            {
              assert g !in gm;
            }
          }
          var bodycode3 := CP.compile_to_bytecode(body);
          assert AReg.get_cp(th'.look_regs, l) == Some(s1.cp) by {
            RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
          }
          M.LkReplayMatchesSpec(rer, qm, body, bodycode3, |bodycode3| - 1, 0, str, cp,
                                AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant),
                                ov, LCdn.compile_cdns(body), la, tlk, gm, ncap, nlook, nquant);
          assert crv.f_look_cdns[l] == LCdn.compile_cdns(body);      // LookEntryOk row
          var rfSpec := AI.FFindMatch(bodycode3, str,
                          AI.FInitState(bodycode3, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                        AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                          ov, LAnc.Forward, LCdn.compile_cdns(body)).0;
          assert rfx == rfSpec;
          assert LS.LkResult(T.TrLookaround(la), tlk, gm, inp).Some?
              && LS.LkResult(T.TrLookaround(la), tlk, gm, inp).value == gm2 by {
            assert lk == T.TrLookaround(la);
          }
          assert M.GmAgreeOn(gm2,
                             PIV.GmOfLive(body, rfSpec.value.capture_regs,
                                          rfSpec.value.look_regs, rfSpec.value.quant_regs),
                             set gx | gx in L.DefGroups(T.Translate(body)));
          forall g: LG.GroupId |
            g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
            && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                                 rfx.value.look_regs, rfx.value.quant_regs)
            ensures g in gm2
          {
            assert g in (set gx | gx in L.DefGroups(T.Translate(body)));
          }
        } else if NR.CaptureFreeRE(body) {
          // capture-free positive lookbehind: nothing to cover
          assert la.Lookbehind? && NR.CaptureFreeRE(body);
          PIV.CaptureFreeNoCapIds(body);
          forall g: LG.GroupId |
            g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
            && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                                 rfx.value.look_regs, rfx.value.quant_regs)
            ensures g in gm2
          {
            assert g in PIV.CapIds(body);
            assert false;
          }
        } else {
          // CAPTURING positive lookbehind: gm2 covers the body's groups via the BACKWARD
          // keystone's key-set (SwapGm preserves keys). Mirrors the lookahead arm above.
          M.TranslateDefGroupsEqCapIds(body);
          EL.TranslateNoLkBr(body);
          EL.ComputeTrGmIndepLk(rer, r1, inp, gm, WP.Backward);
          assert tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, gm, WP.Backward);
          assert M.GmAgreeOn(gm, LG.Empty, set gx | gx in L.DefGroups(r1)) by {
            forall g: LG.GroupId | g in (set gx | gx in L.DefGroups(r1))
              ensures (g in gm <==> g in LG.Empty) && (g in gm ==> gm[g] == LG.Empty[g])
            { assert g !in gm; }
          }
          var bodycode3 := CP.compile_to_bytecode(body);
          assert AReg.get_cp(th'.look_regs, l) == Some(s1.cp) by {
            RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
          }
          // static package for BackFreshBodyGmTie
          NI.LookBodyOfFragment(re, l as nat);                    // PlusFragmentRE(body)
          OS.TranslateLookFreeGroupOk(body);                      // GroupOkL(Translate(body))
          TranslateDefGroupsNoDup(body);                          // NoDupG(DefGroups(Translate(body)))
          assert PIV.CapUnique(body) && PIV.QuantUnique(body);
          // rfx == the backward run raB
          assert CP.capture_regex(crv.f_look_types[l], body) == R.reverse_regex(body);
          assert AI.capture_direction(crv.f_look_types[l]) == LAnc.Backward;
          LBK.BackFreshBodyGmTie(rer, body, str, cp, ov, crv.f_look_cdns[l], la, tlk, gm,
                                 ncap, nlook, nquant, |str|);
          var bcB := CP.compile_to_bytecode(R.reverse_regex(body));
          var raB := AI.FFindMatch(bcB, str,
                       AI.FInitState(bcB, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                     AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                       ov, LAnc.Backward, crv.f_look_cdns[l]).0;
          assert rfx == raB;
          assert LS.LkResult(T.TrLookaround(la), tlk, gm, inp).value == gm2 by {
            assert lk == T.TrLookaround(la);
          }
          // BackFreshBodyGmTie: GmAgreeOn(SwapGm(gm2), GmOfLive(body, raB.caps), Sbody)
          forall g: LG.GroupId |
            g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
            && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                                 rfx.value.look_regs, rfx.value.quant_regs)
            ensures g in gm2
          {
            assert g in (set gx | gx in L.DefGroups(T.Translate(body)));
            assert g in LBV.SwapGm(gm2);                          // GmAgreeOn key-set at g in Sbody
          }
        }
      }
    }
    assert forall j: int :: j != l ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j)
      && AI.get_idx(th'.look_regs.a_cp, j) == AI.get_idx(th.look_regs.a_cp, j)
    by {
      RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
    }
    LookNestBackTGatePass(re, crv, str, ov, S, gm, gm2, th, th', l, ncap, nlook, nquant);
    assert LookNestBackRepC(re, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                            ncap, nlook, nquant) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestBackT(re, crv, str, ov, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i],
                              ncap, nlook, nquant)
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm2)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** (L4 NESTED) clone of `LiftPreserveGatePassLk` — GmtTieInside dropped. */
  lemma LiftPreserveGatePassLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                               crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                               bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                               l: int, th': AI.Thread, vms2: AI.VmState,
                               ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires |ov| == |str| + 1                                    // L3b: the backward LB gate needs the mirror
    requires S == PIV.CapIdsInLooks(re)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires CM.ThreadRegsWf(s.active[0], ncap, nlook, nquant)
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.CheckOracle(l))
    requires LOr.view_get_oracle(ov, s.cp, l)
    // (E3) carrier feeds: freshness, positional invariant, look uniqueness
    requires s.clock >= 0 && CM.ThreadClocksLE(s.active[0], s.clock)
    requires PSM.ThreadNestRE(re, code, endl, s.active[0].pc, s.active[0])
    requires LTB.LookUnique(re)
    // (E4) the row↔structure tie for the converse coverage
    requires LTB.LookTablesOk(re, crv)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(pc := s.active[0].pc + 1,
                                 look_regs := AReg.set_reg(s.active[0].look_regs, l, Some(s1.cp), s1.clock))
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    // (L4 NESTED) NestedFragmentRE(re) is now DIRECT from StaticOkNestedRE
    var PTS(inp, ta, best, tbl, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // gate pc interior + polarity pin
    TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
    assert |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept);
    assert pc < endl;
    GatePolarityRE(re, qm, code, 0, endl, pc);
    assert l in qm.looks;
    var lk := qm.looks[l].0;
    var r1 := qm.looks[l].1;
    assert AR.PositiveL(lk) && L.Positivity(lk);

    // position glue
    assert 0 <= s.cp <= |str| && inp == PIV.InpOfCp(str, s.cp);
    var cp: nat := s.cp as nat;
    PIV.IdxInpOfCp(str, cp);
    assert TREP.CpOf(inp) == cp && TR_CpOf(inp) == cp;
    assert LL.OracleOkAt(rer, qm, inp);

    // raw witness at the gate: the walk lemma keys on the (true) oracle bit
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    assert WalkPairLk(rer, qm, code, inp, traw, gm, pc, ea);
    WalkPairLkAtCheckOracle(rer, qm, code, inp, traw, gm, pc, ea, l);
    assert LOr.view_get_oracle(qm.ov, TR_CpOf(inp), l);
    assert traw.LK? && traw.lk == lk;
    assert EL.LkGateOk(rer, lk, r1, inp, traw.tlk, true);
    var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    assert traw.tlk == tlk;                                   // LkGateOk pins tlk functionally
    assert LS.LkResult(lk, tlk, LG.Empty, inp).Some?;
    assert LS.LkResult(lk, tlk, gm, inp).Some?;
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    assert WalkPairLk(rer, qm, code, inp, traw.t, gm2, pc + 1, ea);
    assert forall gg :: gg in L.DefGroups(r1) ==> gg !in gm;  // the gate's own clear instance

    // canonical head: the LK branch of the gate rule (functional verdict Some)
    TreeRepLkREAtCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    assert t.LK? && t.lk == lk && t.tlk == tlk
        && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    // erasure congruence: children tie
    assert CE.ProgErase(traw) == LT.LK(lk, CE.ProgErase(traw.tlk), CE.ProgErase(traw.t));
    assert CE.ProgErase(t) == LT.LK(lk, CE.ProgErase(t.tlk), CE.ProgErase(t.t));
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t);

    // B step on the canonical LK head: pts_active with the merged gm
    assert LS.LkResult(t.lk, t.tlk, gm, inp) == Some(gm2);
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm2)]);
    bst1 := PT.PTS(inp, [(t.t, gm2)] + ta[1..], best, tbl, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the per-lid static package
    var la: R.lookaround, body: R.regex :|
      LTB.LookEntryOk(crv, l, la, body)
      && T.TransWf(body) && NR.LookFreeRE(body)
      && qm.looks[l].0 == T.TrLookaround(la)
      && qm.looks[l].1 == T.Translate(body)
      && (set g: LG.GroupId | g in L.DefGroups(T.Translate(body))) <= PIV.CapIdsInLooks(re)
      && var bodycode := CP.compile_to_bytecode(body);
         |bodycode| >= 1
         && PSM.StaticOkRE(qm, body, bodycode, |bodycode| - 1)
         && PSM.SizesOkRE(body, ncap, nlook, nquant)
      && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
    assert lk == T.TrLookaround(la) && r1 == T.Translate(body);
    assert body == M.VBody(crv, l);
    assert 0 <= l < nlook;

    var clk := s1.clock;
    assert th' == th.(pc := th.pc + 1, look_regs := AReg.set_reg(th.look_regs, l, Some(cp as int), clk));

    // the polarity pin refutes the negative flavours
    assert !la.NegLookahead? && !la.NegLookbehind? by {
      if la.NegLookahead? || la.NegLookbehind? { assert !L.Positivity(lk); }
    }
    M.LkBodyGroupsEqCapIdsInLooks(re);
    assert S == LL.LkBodyGroups(T.Translate(re));

    if la.Lookahead? {
      // ---- capturing-lookahead half: the proven crux core -------------------
      assert crv.f_look_types[l] == la && crv.f_look_types[l].Lookahead?;
      assert AI.capture_type(crv.f_look_types[l]);
      assert L.LkDir(lk) == WP.Forward;
      assert RL.ASize(th.look_regs) == nlook;
      var bodycode := CP.compile_to_bytecode(body);
      assert LT.LK(lk, tlk, traw.t) == traw;
      // (L4 NESTED) the gate-step lemma wants the body in the positive-nesting
      // sub-fragment; under the depth-1 fragment the body is look-free, so
      // NestedFragmentRE + NegLooksLookFreeRE follow from LookFreeRE+PlusFragmentRE.
      PIV.LookCheckIdsRENested(re, code, 0, endl, pc);
      NI.LookBodyOfTablesTie(re, crv, l as nat);
      assert PSM.StaticOkRE(qm, body, bodycode, |bodycode| - 1);   // (⟹ LookBehindFragmentRE(body))
      NR.LookFreeIsPlusFragmentRE(body);                          // PlusFragmentRE(body)
      NR.LookFreePlusIsNestedRE(body);                            // NestedFragmentRE(body)
      NR.LookFreeNegLooksLookFree(body);                          // NegLooksLookFreeRE(body)
      ThreadRepLkStepCheckOracleNested(rer, qm, re, code, crv, str, ov, S, lk, r1, tlk, traw.t,
                                 gm, th, l, cp, clk, body, la, bodycode, |bodycode| - 1, 0,
                                 th.quant_regs, ncap, nlook, nquant);
      assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
    } else {
      // ---- capture-free positive look (Lookbehind) --------------------------
      assert la.Lookbehind?;
      if NR.CaptureFreeRE(body) {
      // ---- capture-free positive lookbehind: gm2 == gm, no inside-S groups --------
      assert NR.CaptureFreeRE(body);
      PIV.CaptureFreeNoCapIds(body);
      M.TranslateDefGroupsEqCapIds(body);
      assert (set g | g in L.DefGroups(r1)) == PIV.CapIds(body) == {};
      // the merge over an EMPTY group set agrees with gm everywhere
      EL.TranslateNoLkBr(body);
      LkResultAgreeOutside(rer, lk, r1, inp, tlk, gm);
      assert forall g: LG.GroupId :: (g in gm2 <==> g in gm) && (g in gm2 ==> gm2[g] == gm[g]) by {
        forall g: LG.GroupId ensures (g in gm2 <==> g in gm) && (g in gm2 ==> gm2[g] == gm[g]) {
          assert g !in (set gx | gx in L.DefGroups(r1)) by {
            if g in (set gx | gx in L.DefGroups(r1)) { assert g in PIV.CapIds(body); }
          }
        }
      }

      // outside tie: the gate-crossing frame (works for backward gates too);
      // NoLkBrL(r1) (look-free body) ⟹ the recursive PikeLkRegexRec(r1).
      EL.NoLkBrLIsPikeLkRegexRec(r1);
      GmtTieOutsideAfterGateNested(rer, re, str, lk, r1, tlk, gm, th, l, cp, clk, S);
      assert GmtTieOutside(re, th', gm2, S);

      // inside tie: witnesses carry across the l-only look-reg write
      assert (th.pc + 1) as nat == pc + 1;
      assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
      } else {
        // ---- CAPTURING positive lookbehind: keystone-based backward gate ----
        var bodycode := CP.compile_to_bytecode(body);
        assert LT.LK(lk, tlk, traw.t) == traw;
        // ---- the keystone-gate static package for the body ----
        assert PSM.StaticOkRE(qm, body, bodycode, |bodycode| - 1);   // ⟹ CapUnique(body) & QuantUnique(body)
        assert PIV.CapUnique(body) && PIV.QuantUnique(body);
        PIV.LookCheckIdsRENested(re, code, 0, endl, pc);                   // (l as nat) in LookIds(re)
        assert (l as nat) in LTB.LookIds(re);
        NI.LookBodyOfTablesTie(re, crv, l as nat);                   // VBody(crv,l) == LookBodyOfRE(re,l)
        NR.LookFreeIsPlusFragmentRE(body);                         // PlusFragmentRE(body) from StaticOkRE(body)+LookFreeRE(body)
        assert NR.PlusFragmentRE(body);
        NR.LookFreePlusIsNestedRE(body);                           // NestedFragmentRE(body)
        NR.LookFreeNegLooksLookFree(body);                         // NegLooksLookFreeRE(body)
        assert |ov| == |str| + 1;
        ThreadRepLkStepCheckOracleLBNested(rer, qm, re, code, crv, str, ov, S, lk, r1, tlk, traw.t,
                                     gm, th, l, cp, clk, body, la, bodycode, |bodycode| - 1, 0,
                                     th.quant_regs, ncap, nlook, nquant);
        assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
      }
    }

    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm2, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm2)] + ta[1..])[0] == (t.t, gm2) && ([(t.t, gm2)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // ---- (E3) the look-path carrier: the crossing establishes lid l fresh ----
    assert LookNestRepC(re, S, ta, s.active);
    assert LookNestOkT(re, S, gm, th);
    assert NI.NestInvRE(re, code, 0, endl, pc, th.capture_regs.a_clk, th.quant_regs.a_clk, -1) by {
      assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
      assert pc < endl;
    }
    RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
    assert AI.get_idx(th'.look_regs.a_clk, l) == clk && clk >= 0;
    assert forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= AI.get_idx(th'.look_regs.a_clk, l) by {
      assert CM.RegsClocksLE(th.quant_regs, s.clock);
    }
    assert forall j: int :: j != l ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j);
    // ownership: the fold adds only l-owned groups (LmapOk row + fold confinement)
    PIV.LookCheckIdsRENested(re, code, 0, endl, pc);
    assert l >= 0 && (l as nat) in LTB.LookIds(re);
    LmapOkAtLid(re, qm, l as nat);
    var LB := NI.LookBodyOfRE(re, l as nat);
    assert r1 == T.Translate(LB);
    M.TranslateDefGroupsEqCapIds(LB);
    assert (set gx | gx in L.DefGroups(r1)) == PIV.CapIds(LB);
    EL.TranslateNoLkBr(body);
    assert EL.NoLkBrL(r1);
    LkResultAgreeOutside(rer, lk, r1, inp, tlk, gm);
    assert forall g: LG.GroupId :: g in S && g in gm2 && g !in gm ==>
      l >= 0 && (l as nat) in LTB.LookIds(re) && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
    by {
      forall g: LG.GroupId | g in S && g in gm2 && g !in gm
        ensures g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
      {
        if g !in (set gx | gx in L.DefGroups(r1)) {
          assert g in gm;                          // GmAgreeOutside membership
          assert false;
        }
      }
    }
    // (L4 NESTED) the fold sits DIRECTLY in lid l's body, not a nested look:
    // the gate body (GateStaticsOk) is look-free, so CapIdsInLooks(body) == {}.
    NI.LookBodyOfTablesTie(re, crv, l as nat);       // VBody(crv,l) == LookBodyOfRE(re,l) == body
    PIV.LookFreeCapIdsInLooksEmpty(body);            // CapIdsInLooks(body) == {}
    assert PIV.CapIdsInLooks(NI.LookBodyOfRE(re, l as nat)) == {};
    LookNestOkTGatePassNested(re, code, endl, S, gm, gm2, th, th', pc, l);
    assert LookNestRepC(re, S, [(t.t, gm2)] + ta[1..], vms2.active) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestOkT(re, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i])
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // ---- (E4) converse: the crossing's coverage from the replay↔spec tie ----
    assert LookNestBackRepC(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    // structural body == row body (both pin f_look_ast[l])
    NI.LookBodyOfTablesTie(re, crv, l as nat);
    var la3: R.lookaround :| LTB.LookEntryOk(crv, l, la3, NI.LookBodyOfRE(re, l as nat));
    assert NI.LookBodyOfRE(re, l as nat) == body;
    // gm only grows across the fold (its S-body keys were CLEAR coming in)
    assert forall g: LG.GroupId :: g in gm ==> g in gm2 by {
      forall g: LG.GroupId | g in gm ensures g in gm2 {
        assert g !in (set gx | gx in L.DefGroups(r1)) by {
          if g in (set gx | gx in L.DefGroups(r1)) { assert g !in gm; }
        }
      }
    }
    // the crossing coverage for l itself
    assert var rfx := M.FreshBodyMatch(crv, str, l, th'.look_regs, ov, ncap, nlook, nquant);
      rfx.Some? ==>
        forall g: LG.GroupId ::
          g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                               rfx.value.look_regs, rfx.value.quant_regs)
          ==> g in gm2
    by {
      var rfx := M.FreshBodyMatch(crv, str, l, th'.look_regs, ov, ncap, nlook, nquant);
      if rfx.Some? {
        if la.Lookahead? {
          M.TranslateDefGroupsEqCapIds(body);
          EL.TranslateNoLkBr(body);
          EL.ComputeTrGmIndepLk(rer, r1, inp, gm, WP.Forward);
          assert tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, gm, WP.Forward);
          assert M.GmAgreeOn(gm, LG.Empty, set gx | gx in L.DefGroups(r1)) by {
            forall g: LG.GroupId | g in (set gx | gx in L.DefGroups(r1))
              ensures (g in gm <==> g in LG.Empty) && (g in gm ==> gm[g] == LG.Empty[g])
            {
              assert g !in gm;
            }
          }
          var bodycode3 := CP.compile_to_bytecode(body);
          assert AReg.get_cp(th'.look_regs, l) == Some(s1.cp) by {
            RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
          }
          M.LkReplayMatchesSpec(rer, qm, body, bodycode3, |bodycode3| - 1, 0, str, cp,
                                AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant),
                                ov, LCdn.compile_cdns(body), la, tlk, gm, ncap, nlook, nquant);
          assert crv.f_look_cdns[l] == LCdn.compile_cdns(body);      // LookEntryOk row
          var rfSpec := AI.FFindMatch(bodycode3, str,
                          AI.FInitState(bodycode3, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                        AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                          ov, LAnc.Forward, LCdn.compile_cdns(body)).0;
          assert rfx == rfSpec;
          assert LS.LkResult(T.TrLookaround(la), tlk, gm, inp).Some?
              && LS.LkResult(T.TrLookaround(la), tlk, gm, inp).value == gm2 by {
            assert lk == T.TrLookaround(la);
          }
          assert M.GmAgreeOn(gm2,
                             PIV.GmOfLive(body, rfSpec.value.capture_regs,
                                          rfSpec.value.look_regs, rfSpec.value.quant_regs),
                             set gx | gx in L.DefGroups(T.Translate(body)));
          forall g: LG.GroupId |
            g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
            && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                                 rfx.value.look_regs, rfx.value.quant_regs)
            ensures g in gm2
          {
            assert g in (set gx | gx in L.DefGroups(T.Translate(body)));
          }
        } else if NR.CaptureFreeRE(body) {
          // capture-free positive lookbehind: nothing to cover
          assert la.Lookbehind? && NR.CaptureFreeRE(body);
          PIV.CaptureFreeNoCapIds(body);
          forall g: LG.GroupId |
            g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
            && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                                 rfx.value.look_regs, rfx.value.quant_regs)
            ensures g in gm2
          {
            assert g in PIV.CapIds(body);
            assert false;
          }
        } else {
          // CAPTURING positive lookbehind: gm2 covers the body's groups via the BACKWARD
          // keystone's key-set (SwapGm preserves keys). Mirrors the lookahead arm above.
          M.TranslateDefGroupsEqCapIds(body);
          EL.TranslateNoLkBr(body);
          EL.ComputeTrGmIndepLk(rer, r1, inp, gm, WP.Backward);
          assert tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, gm, WP.Backward);
          assert M.GmAgreeOn(gm, LG.Empty, set gx | gx in L.DefGroups(r1)) by {
            forall g: LG.GroupId | g in (set gx | gx in L.DefGroups(r1))
              ensures (g in gm <==> g in LG.Empty) && (g in gm ==> gm[g] == LG.Empty[g])
            { assert g !in gm; }
          }
          var bodycode3 := CP.compile_to_bytecode(body);
          assert AReg.get_cp(th'.look_regs, l) == Some(s1.cp) by {
            RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
          }
          // static package for BackFreshBodyGmTie
          assert PSM.StaticOkRE(qm, body, bodycode3, |bodycode3| - 1);   // (⇒ LookBehindFragmentRE(body))
          NR.LookFreeIsPlusFragmentRE(body);                     // PlusFragmentRE(body)
          OS.TranslateLookFreeGroupOk(body);                      // GroupOkL(Translate(body))
          TranslateDefGroupsNoDup(body);                          // NoDupG(DefGroups(Translate(body)))
          assert PIV.CapUnique(body) && PIV.QuantUnique(body);
          // rfx == the backward run raB
          assert CP.capture_regex(crv.f_look_types[l], body) == R.reverse_regex(body);
          assert AI.capture_direction(crv.f_look_types[l]) == LAnc.Backward;
          LBK.BackFreshBodyGmTie(rer, body, str, cp, ov, crv.f_look_cdns[l], la, tlk, gm,
                                 ncap, nlook, nquant, |str|);
          var bcB := CP.compile_to_bytecode(R.reverse_regex(body));
          var raB := AI.FFindMatch(bcB, str,
                       AI.FInitState(bcB, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                     AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Backward)),
                       ov, LAnc.Backward, crv.f_look_cdns[l]).0;
          assert rfx == raB;
          assert LS.LkResult(T.TrLookaround(la), tlk, gm, inp).value == gm2 by {
            assert lk == T.TrLookaround(la);
          }
          // BackFreshBodyGmTie: GmAgreeOn(SwapGm(gm2), GmOfLive(body, raB.caps), Sbody)
          forall g: LG.GroupId |
            g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
            && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                                 rfx.value.look_regs, rfx.value.quant_regs)
            ensures g in gm2
          {
            assert g in (set gx | gx in L.DefGroups(T.Translate(body)));
            assert g in LBV.SwapGm(gm2);                          // GmAgreeOn key-set at g in Sbody
          }
        }
      }
    }
    assert forall j: int :: j != l ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j)
      && AI.get_idx(th'.look_regs.a_cp, j) == AI.get_idx(th.look_regs.a_cp, j)
    by {
      RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
    }
    LookNestBackTGatePass(re, crv, str, ov, S, gm, gm2, th, th', l, ncap, nlook, nquant);
    assert LookNestBackRepC(re, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                            ncap, nlook, nquant) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestBackT(re, crv, str, ov, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i],
                              ncap, nlook, nquant)
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm2)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** Fueled `WalkPairLk` core at a `NegCheckOracle` pc: the gate head is
      pinned by `ActionRepL`'s polarity split, and the PASSING merge is the
      IDENTITY (`LkResult` of a succeeding negative look returns `Some(gm)`),
      so the continuation's `GateAheadClear`/NoDup come from the plain tail
      bricks — no `AfterMerge` machinery. Keyed on the FUNCTIONAL verdict. */
  lemma WalkPairLkAtNegCheckOracleCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                       tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                       acts: LS.Actions, lid: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.NegCheckOracle(lid))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
      !AR.PositiveL(lk)
      && (LS.LkResult(lk, tlk, LG.Empty, inp).Some? ==>
            tb.LK? && tb.lk == lk && tb.tlk == tlk
            && WalkPairLk(rer, qm, code, inp, tb.t, gm, pc + 1, ATR.EaOf(b)))
      && (LS.LkResult(lk, tlk, LG.Empty, inp).None? ==> tb == LT.LKFail(lk, tlk))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not NegCheckOracle
    case Aclose(_) =>   // pins SetRegisterToCP — not NegCheckOracle
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtNegCheckOracleCore(rer, qm, code, inp, tb, gm, pc, b, cont, lid);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtNegCheckOracleCore(rer, qm, code, inp, tb, gm, pc, b, na, lid);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtNegCheckOracleCore(rer, qm, code, inp, tb, gm, pc, b, cont, lid);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case LookaroundR(lk0, r1) =>
        // ActionRepL's polarity split: a NegCheckOracle pc hosts a NEGATIVE look
        var lid0: int :| NR.GetPcRE(code, pc) == Some(if AR.PositiveL(lk0) then RB.CheckOracle(lid0)
                                                     else RB.NegCheckOracle(lid0))
          && lid0 in qm.looks && qm.looks[lid0] == (lk0, r1);
        assert !AR.PositiveL(lk0) && lid0 == lid;
        assert pcmid == pc + 1;
        M.GateNodeAtInp(rer, acts, inp, b, tb, lk0, r1);   // tb is LK/LKFail with LkGateOk
        var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk0));
        if tb.LK? {
          assert tb.tlk == tlk && LS.LkResult(lk0, tlk, LG.Empty, inp).Some?;   // LkGateOk true
          assert EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          // the passing negative merge is the identity ⟹ plain tail bricks
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          assert EL.PikeLkActions(cont);
          assert WalkPairLk(rer, qm, code, inp, tb.t, gm, pc + 1, g);
        } else {
          assert tb.LKFail? && tb.tlk == tlk;               // LkGateOk false
          assert LS.LkResult(lk0, tlk, LG.Empty, inp).None?;
          assert tb == LT.LKFail(lk0, tlk);
        }
      case Character(_) =>   // pins Consume — not NegCheckOracle
      case Disjunction(_, _) =>   // pins Fork — not NegCheckOracle
      case Group(_, _) =>   // pins SetRegisterToCP — not NegCheckOracle
      case AnchorR(_) =>   // pins AnchorAssertion — not NegCheckOracle
      case Backreference(_) =>   // NfaRepL false
  }

  /** WalkPairLk→WalkPairLk wrapper at a `NegCheckOracle`. */
  lemma WalkPairLkAtNegCheckOracle(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                   tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, lid: int)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.NegCheckOracle(lid))
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
      !AR.PositiveL(lk)
      && (LS.LkResult(lk, tlk, LG.Empty, inp).Some? ==>
            tb.LK? && tb.lk == lk && tb.tlk == tlk
            && WalkPairLk(rer, qm, code, inp, tb.t, gm, pc + 1, ea))
      && (LS.LkResult(lk, tlk, LG.Empty, inp).None? ==> tb == LT.LKFail(lk, tlk))
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtNegCheckOracleCore(rer, qm, code, inp, tb, gm, pc, b, acts, lid);
  }

  /** NEGATIVE GATE, PASSING (clear bit): zero-width, no register write; B
      steps the `LK` head — a succeeding negative look's merge IS the running
      map (`LkResult` returns `Some(gm)`), so every tie transfers verbatim. */
  lemma LiftPreserveNegGatePassLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  l: int, vms2: AI.VmState,
                                  ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires qm.ov == ov
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.NegCheckOracle(l))
    requires !LOr.view_get_oracle(ov, s.cp, l)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [s.active[0].(pc := s.active[0].pc + 1)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    var th' := th.(pc := th.pc + 1);
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // polarity + the bit ⟹ the functional verdict is Some (negative passes)
    TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
    assert |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept);
    assert pc < endl;
    GatePolarityRE(re, qm, code, 0, endl, pc);
    assert l in qm.looks;
    var lk := qm.looks[l].0;
    var r1 := qm.looks[l].1;
    assert AR.PositiveL(lk) == L.Positivity(lk);
    assert !L.Positivity(lk);
    var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    assert LL.OracleOkAt(rer, qm, inp);
    PIV.IdxInpOfCp(str, s.cp as nat);
    assert TREP.CpOf(inp) == s.cp as nat;
    assert qm.looks[l] == (lk, r1);
    assert LOr.view_get_oracle(qm.ov, TREP.CpOf(inp), l)
       <==> LT.TreeRes(tlk, LG.Empty, inp, L.LkDir(lk)).Some?;
    assert LS.LkResult(lk, tlk, LG.Empty, inp).Some?;      // clear bit + negative

    // canonical head: the LK branch of the gate rule
    TreeRepLkREAtNegCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    assert t.LK? && t.lk == lk && t.tlk == tlk
        && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    // B step: the merge at the RUNNING map is Some(gm) — the identity
    EL.LkResultGmIndep(lk, tlk, gm, inp);
    assert LS.LkResult(lk, tlk, gm, inp).Some?;
    assert LS.LkResult(lk, tlk, gm, inp).value == gm;      // negative: Some(gm)
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
    bst1 := PT.PTS(inp, [(t.t, gm)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the child pairing: the raw witness steps by the neg-gate walk core; the
    // erasure tie transports the child
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtNegCheckOracle(rer, qm, code, inp, traw, gm, pc, ea, l);
    assert traw.LK? && WalkPairLk(rer, qm, code, inp, traw.t, gm, pc + 1, ea);
    assert (th.pc + 1) as nat == pc + 1;
    assert GmtTieOutside(re, th', gm, S);
    assert GmtTieInside(crv, str, ov, th', gm, S, ncap, nlook, nquant);
    assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm, th', ncap, nlook, nquant);
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.LK(traw.lk, CE.ProgErase(traw.tlk), CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.LK(t.lk, CE.ProgErase(t.tlk), CE.ProgErase(t.t));
    }
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm)] + ta[1..])[0] == (t.t, gm) && ([(t.t, gm)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** (L4 NESTED) clone of `LiftPreserveNegGatePassLk` — GmtTieInside dropped. */
  lemma LiftPreserveNegGatePassLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  l: int, vms2: AI.VmState,
                                  ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires qm.ov == ov
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.NegCheckOracle(l))
    requires !LOr.view_get_oracle(ov, s.cp, l)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [s.active[0].(pc := s.active[0].pc + 1)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    var th' := th.(pc := th.pc + 1);
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // polarity + the bit ⟹ the functional verdict is Some (negative passes)
    TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
    assert |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept);
    assert pc < endl;
    GatePolarityRE(re, qm, code, 0, endl, pc);
    assert l in qm.looks;
    var lk := qm.looks[l].0;
    var r1 := qm.looks[l].1;
    assert AR.PositiveL(lk) == L.Positivity(lk);
    assert !L.Positivity(lk);
    var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    assert LL.OracleOkAt(rer, qm, inp);
    PIV.IdxInpOfCp(str, s.cp as nat);
    assert TREP.CpOf(inp) == s.cp as nat;
    assert qm.looks[l] == (lk, r1);
    assert LOr.view_get_oracle(qm.ov, TREP.CpOf(inp), l)
       <==> LT.TreeRes(tlk, LG.Empty, inp, L.LkDir(lk)).Some?;
    assert LS.LkResult(lk, tlk, LG.Empty, inp).Some?;      // clear bit + negative

    // canonical head: the LK branch of the gate rule
    TreeRepLkREAtNegCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    assert t.LK? && t.lk == lk && t.tlk == tlk
        && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    // B step: the merge at the RUNNING map is Some(gm) — the identity
    EL.LkResultGmIndep(lk, tlk, gm, inp);
    assert LS.LkResult(lk, tlk, gm, inp).Some?;
    assert LS.LkResult(lk, tlk, gm, inp).value == gm;      // negative: Some(gm)
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
    bst1 := PT.PTS(inp, [(t.t, gm)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the child pairing: the raw witness steps by the neg-gate walk core; the
    // erasure tie transports the child
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtNegCheckOracle(rer, qm, code, inp, traw, gm, pc, ea, l);
    assert traw.LK? && WalkPairLk(rer, qm, code, inp, traw.t, gm, pc + 1, ea);
    assert (th.pc + 1) as nat == pc + 1;
    assert GmtTieOutside(re, th', gm, S);
    assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm, th', ncap, nlook, nquant);
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.LK(traw.lk, CE.ProgErase(traw.tlk), CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.LK(t.lk, CE.ProgErase(t.tlk), CE.ProgErase(t.t));
    }
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm)] + ta[1..])[0] == (t.t, gm) && ([(t.t, gm)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** GATE KILL (either polarity, failing bit): the head canonical tree is
      `LKFail` — the polarity pin (`GatePolarityRE`) + the oracle column
      (`OracleOkAt`) convert the failing BIT into a `None` functional verdict,
      which is exactly the canonical rule's `LKFail` branch. B drops the head
      with an empty `pts_active`. */
  lemma LiftPreserveGateKillLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                               crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                               bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                               l: int, pos: bool, vms2: AI.VmState,
                               ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires qm.ov == ov
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat)
          == Some(if pos then RB.CheckOracle(l) else RB.NegCheckOracle(l))
    requires LOr.view_get_oracle(ov, s.cp, l) != pos
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // the gate pc is interior (endl holds Accept), so the polarity pin applies
    TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
    assert |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept);
    assert pc < endl;
    GatePolarityRE(re, qm, code, 0, endl, pc);
    assert l in qm.looks;
    var lk := qm.looks[l].0;
    var r1 := qm.looks[l].1;
    assert AR.PositiveL(lk) == L.Positivity(lk);
    assert L.Positivity(lk) == pos;

    // the bit at this position IS the body tree's verdict (oracle column)
    var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    assert LL.OracleOkAt(rer, qm, inp);          // inp == inp0 instance of OracleOkSuffix
    PIV.IdxInpOfCp(str, s.cp as nat);
    assert TREP.CpOf(inp) == s.cp as nat;
    assert qm.looks[l] == (lk, r1);
    assert LOr.view_get_oracle(qm.ov, TREP.CpOf(inp), l)
       <==> LT.TreeRes(tlk, LG.Empty, inp, L.LkDir(lk)).Some?;
    // failing bit + polarity ⟹ the functional verdict is None (both flavours)
    assert LS.LkResult(lk, tlk, LG.Empty, inp).None?;

    // canonical head: the LKFail branch of the gate rule
    if pos {
      TreeRepLkREAtCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    } else {
      TreeRepLkREAtNegCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    }
    assert t == LT.LKFail(lk, tlk);
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([]);
    bst1 := LiftDropDeadHeadLk(rer, qm, re, code, endl, crv, str, ov, S,
                               bst, s, s1, vms2, ncap, nlook, nquant);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);
  }

  /** (L4 NESTED) clone of `LiftPreserveGateKillLk` — GmtTieInside dropped. */
  lemma LiftPreserveGateKillLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                               crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                               bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                               l: int, pos: bool, vms2: AI.VmState,
                               ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires qm.ov == ov
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat)
          == Some(if pos then RB.CheckOracle(l) else RB.NegCheckOracle(l))
    requires LOr.view_get_oracle(ov, s.cp, l) != pos
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // the gate pc is interior (endl holds Accept), so the polarity pin applies
    TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
    assert |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept);
    assert pc < endl;
    GatePolarityRE(re, qm, code, 0, endl, pc);
    assert l in qm.looks;
    var lk := qm.looks[l].0;
    var r1 := qm.looks[l].1;
    assert AR.PositiveL(lk) == L.Positivity(lk);
    assert L.Positivity(lk) == pos;

    // the bit at this position IS the body tree's verdict (oracle column)
    var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    assert LL.OracleOkAt(rer, qm, inp);          // inp == inp0 instance of OracleOkSuffix
    PIV.IdxInpOfCp(str, s.cp as nat);
    assert TREP.CpOf(inp) == s.cp as nat;
    assert qm.looks[l] == (lk, r1);
    assert LOr.view_get_oracle(qm.ov, TREP.CpOf(inp), l)
       <==> LT.TreeRes(tlk, LG.Empty, inp, L.LkDir(lk)).Some?;
    // failing bit + polarity ⟹ the functional verdict is None (both flavours)
    assert LS.LkResult(lk, tlk, LG.Empty, inp).None?;

    // canonical head: the LKFail branch of the gate rule
    if pos {
      TreeRepLkREAtCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    } else {
      TreeRepLkREAtNegCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    }
    assert t == LT.LKFail(lk, tlk);
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([]);
    bst1 := LiftDropDeadHeadLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                               bst, s, s1, vms2, ncap, nlook, nquant);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);
  }

  /** Fueled `WalkPairLk` core at an `EndLoop` pc: `TtLkAtEndLoopCore`'s case
      structure with `WalkPairLkAtAnchorCore`'s invariant threading — the
      `Acheck` head is consumed with `gm` UNCHANGED, so the tail bricks give
      the continuation its `GateAheadClear`/NoDup. */
  lemma WalkPairLkAtEndLoopCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                acts: LS.Actions)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.EndLoop)
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures ATR.EaOf(b) ==> tb.Progress? && WalkPairLk(rer, qm, code, inp, tb.t, gm, pc + 1, true)
    ensures !ATR.EaOf(b) ==> tb == LT.Mismatch
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    assert !AR.BackForkAt(code, pc);   // GetPcRE(pc)==EndLoop, not Fork
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(strcheck) =>
      // ActionRepL(Acheck): EndLoop disjunct (BackFork excluded) ⇒ pcmid == pc+1
      assert pcmid == pc + 1;
      if b == BS.CanExit {
        assert g == true;
        assert tb.Progress? && EL.BoolTreeLk(rer, cont, inp, BS.CanExit, tb.t);
        assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
        // gm UNCHANGED across the guard ⟹ tail bricks give the continuation clear.
        GateAheadClearTail(acts, gm);       // GateAheadClear(cont, gm)
        WalkDefsOkTail(acts);             // NoDupSeq(AllDefsActs(cont))
        assert EL.PikeLkActions(cont);
        assert ATR.EaOf(BS.CanExit) == true;
        assert WalkPairLk(rer, qm, code, inp, tb.t, gm, pc + 1, true);
      } else {
        assert b == BS.CannotExit && g == false;
        assert tb == LT.Mismatch;
      }
    case Aclose(_) =>   // pins SetRegisterToCP — not EndLoop
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtEndLoopCore(rer, qm, code, inp, tb, gm, pc, b, cont);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtEndLoopCore(rer, qm, code, inp, tb, gm, pc, b, na);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtEndLoopCore(rer, qm, code, inp, tb, gm, pc, b, cont);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case Character(_) =>   // pins Consume — not EndLoop
      case Disjunction(_, _) =>   // pins Fork — not EndLoop
      case Group(_, _) =>   // pins SetRegisterToCP — not EndLoop
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not EndLoop
      case AnchorR(_) =>   // pins AnchorAssertion — not EndLoop
      case Backreference(_) =>   // NfaRepL false
  }

  /** WalkPairLk→WalkPairLk wrapper at an `EndLoop`. */
  lemma WalkPairLkAtEndLoop(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                            tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.EndLoop)
    ensures ea ==> tb.Progress? && WalkPairLk(rer, qm, code, inp, tb.t, gm, pc + 1, true)
    ensures !ea ==> tb == LT.Mismatch
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtEndLoopCore(rer, qm, code, inp, tb, gm, pc, b, acts);
  }

  /** ENDLOOP, PASSING (`exit_allowed`): B steps the `Progress` head (unwrap,
      same gm, child at `pc+1`/CanExit). `Progress` is erasure-transparent, so
      the raw child witness is just the raw walk's own child. */
  lemma LiftPreserveEndLoopPassLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.EndLoop)
    requires s.active[0].exit_allowed
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [s.active[0].(pc := s.active[0].pc + 1)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    var th' := th.(pc := th.pc + 1);
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // canonical head: Progress with canonical child at (pc+1, true)
    TreeRepLkREAtEndLoop(rer, qm, code, inp, t, pc, ea);
    assert t.Progress? && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, true);

    // B step: pts_active queues the child with the same gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
    bst1 := PT.PTS(inp, [(t.t, gm)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the child pairing: the raw witness unwraps its own Progress; erasure is
    // transparent to the guard on BOTH sides
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtEndLoop(rer, qm, code, inp, traw, gm, pc, ea);
    assert traw.Progress? && WalkPairLk(rer, qm, code, inp, traw.t, gm, pc + 1, true);
    assert (th.pc + 1) as nat == pc + 1;
    assert th'.exit_allowed == true;
    assert GmtTieOutside(re, th', gm, S);
    assert GmtTieInside(crv, str, ov, th', gm, S, ncap, nlook, nquant);
    assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm, th', ncap, nlook, nquant);
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == CE.ProgErase(traw.t);   // Progress transparent
      assert CE.ProgErase(t) == CE.ProgErase(t.t);
    }
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm)] + ta[1..])[0] == (t.t, gm) && ([(t.t, gm)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** (L4 NESTED) clone of `LiftPreserveEndLoopPassLk` — GmtTieInside dropped. */
  lemma LiftPreserveEndLoopPassLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.EndLoop)
    requires s.active[0].exit_allowed
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [s.active[0].(pc := s.active[0].pc + 1)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    var th' := th.(pc := th.pc + 1);
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // canonical head: Progress with canonical child at (pc+1, true)
    TreeRepLkREAtEndLoop(rer, qm, code, inp, t, pc, ea);
    assert t.Progress? && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, true);

    // B step: pts_active queues the child with the same gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
    bst1 := PT.PTS(inp, [(t.t, gm)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the child pairing: the raw witness unwraps its own Progress; erasure is
    // transparent to the guard on BOTH sides
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtEndLoop(rer, qm, code, inp, traw, gm, pc, ea);
    assert traw.Progress? && WalkPairLk(rer, qm, code, inp, traw.t, gm, pc + 1, true);
    assert (th.pc + 1) as nat == pc + 1;
    assert th'.exit_allowed == true;
    assert GmtTieOutside(re, th', gm, S);
    assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm, th', ncap, nlook, nquant);
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == CE.ProgErase(traw.t);   // Progress transparent
      assert CE.ProgErase(t) == CE.ProgErase(t.t);
    }
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm)] + ta[1..])[0] == (t.t, gm) && ([(t.t, gm)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** ENDLOOP, KILLING (`!exit_allowed`): the head canonical tree is
      `Mismatch` (`tr_progressfail`), B drops it. */
  lemma LiftPreserveEndLoopKillLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.EndLoop)
    requires !s.active[0].exit_allowed
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, ta[0].1, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, th.exit_allowed);
    TreeRepLkREAtEndLoop(rer, qm, code, inp, t, pc, th.exit_allowed);
    assert t == LT.Mismatch;
    assert PTL.TreeBfsStepLk(t, ta[0].1, inp) == PT.StepActive([]);
    bst1 := LiftDropDeadHeadLk(rer, qm, re, code, endl, crv, str, ov, S,
                               bst, s, s1, vms2, ncap, nlook, nquant);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);
  }

  /** (L4 NESTED) clone of `LiftPreserveEndLoopKillLk` — GmtTieInside dropped. */
  lemma LiftPreserveEndLoopKillLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.EndLoop)
    requires !s.active[0].exit_allowed
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, ta[0].1, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, th.exit_allowed);
    TreeRepLkREAtEndLoop(rer, qm, code, inp, t, pc, th.exit_allowed);
    assert t == LT.Mismatch;
    assert PTL.TreeBfsStepLk(t, ta[0].1, inp) == PT.StepActive([]);
    bst1 := LiftDropDeadHeadLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                               bst, s, s1, vms2, ncap, nlook, nquant);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);
  }

  /** ANCHOR, PASSING: B steps the `AnchorPass` head (child, same gm); the
      VM/spec branch agreement rides `ContextOkRE` + `AnchorAgreeInput`; the
      erasure tie pins the RAW witness's shape (a `Mismatch` witness would
      erase to `Mismatch`, contradicting the canonical `AnchorPass`). */
  lemma LiftPreserveAnchorPassLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                 bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                 a: R.anchor, vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires !rer.multiline
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.AnchorAssertion(a))
    requires LAnc.is_satisfied(a, s.context, LAnc.Forward)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [s.active[0].(pc := s.active[0].pc + 1)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    var th' := th.(pc := th.pc + 1);
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // the VM-side check IS the spec-side check
    assert PIV.ContextOkRE(str, s.cp, s.context);
    PSM.ContextOkIsCtxOf(str, s.cp as nat);
    assert LAnc.is_satisfied(a, TREP.CtxOf(inp), LAnc.Forward);
    TREP.AnchorAgreeInput(rer, a, inp);
    assert LS.AnchorSatisfied(rer, T.TrAnchor(a), inp);

    // canonical head: AnchorPass with canonical child at (pc+1, ea)
    TreeRepLkREAtAnchor(rer, qm, code, inp, t, pc, ea, a);
    assert t.AnchorPass? && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    // B step: pts_active queues the child with the same gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
    bst1 := PT.PTS(inp, [(t.t, gm)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the child pairing: raw witness steps by the proven Anchor core; the
    // erasure tie transports to the canonical child
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    assert traw.AnchorPass? by {
      if !traw.AnchorPass? {
        var acts: LS.Actions, b: BS.LoopBool :|
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActions(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, traw)
          && GateAheadClear(acts, gm)
          && WalkDefsOk(acts);
        assert TtLk(rer, qm, code, inp, traw, pc, ea);
        TtLkAtAnchor(rer, qm, code, inp, traw, pc, ea, a);
        assert traw == LT.Mismatch;
        assert CE.ProgErase(traw) == LT.Mismatch;
        assert CE.ProgErase(t).AnchorPass?;
        assert false;
      }
    }
    ThreadRepLkStepAnchor(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th,
                          ncap, nlook, nquant, a);
    assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm, th', ncap, nlook, nquant);
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.AnchorPass(traw.a, CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.AnchorPass(t.a, CE.ProgErase(t.t));
    }
    assert (th.pc + 1) as nat == pc + 1;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm)] + ta[1..])[0] == (t.t, gm) && ([(t.t, gm)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** (L4 NESTED) clone of `LiftPreserveAnchorPassLk` — GmtTieInside dropped. */
  lemma LiftPreserveAnchorPassLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                 bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                 a: R.anchor, vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires !rer.multiline
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.AnchorAssertion(a))
    requires LAnc.is_satisfied(a, s.context, LAnc.Forward)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [s.active[0].(pc := s.active[0].pc + 1)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    var th' := th.(pc := th.pc + 1);
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // the VM-side check IS the spec-side check
    assert PIV.ContextOkRE(str, s.cp, s.context);
    PSM.ContextOkIsCtxOf(str, s.cp as nat);
    assert LAnc.is_satisfied(a, TREP.CtxOf(inp), LAnc.Forward);
    TREP.AnchorAgreeInput(rer, a, inp);
    assert LS.AnchorSatisfied(rer, T.TrAnchor(a), inp);

    // canonical head: AnchorPass with canonical child at (pc+1, ea)
    TreeRepLkREAtAnchor(rer, qm, code, inp, t, pc, ea, a);
    assert t.AnchorPass? && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    // B step: pts_active queues the child with the same gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
    bst1 := PT.PTS(inp, [(t.t, gm)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the child pairing: raw witness steps by the proven Anchor core; the
    // erasure tie transports to the canonical child
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    assert traw.AnchorPass? by {
      if !traw.AnchorPass? {
        var acts: LS.Actions, b: BS.LoopBool :|
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActions(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, traw)
          && GateAheadClear(acts, gm)
          && WalkDefsOk(acts);
        assert TtLk(rer, qm, code, inp, traw, pc, ea);
        TtLkAtAnchor(rer, qm, code, inp, traw, pc, ea, a);
        assert traw == LT.Mismatch;
        assert CE.ProgErase(traw) == LT.Mismatch;
        assert CE.ProgErase(t).AnchorPass?;
        assert false;
      }
    }
    ThreadRepLkStepAnchorNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th,
                          ncap, nlook, nquant, a);
    assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm, th', ncap, nlook, nquant);
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.AnchorPass(traw.a, CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.AnchorPass(t.a, CE.ProgErase(t.t));
    }
    assert (th.pc + 1) as nat == pc + 1;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm)] + ta[1..])[0] == (t.t, gm) && ([(t.t, gm)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }

  /** ANCHOR, KILLING: the head canonical tree is `Mismatch`
      (`tr_anchorfail` via `ContextOkRE` + `AnchorAgreeInput`), B drops it. */
  lemma LiftPreserveAnchorKillLk(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                 bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                 a: R.anchor, vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkRE(qm, re, code, endl)
    requires !rer.multiline
    requires bst.PTS?
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.AnchorAssertion(a))
    requires !LAnc.is_satisfied(a, s.context, LAnc.Forward)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, t, ta[0].1, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, th.exit_allowed);

    // the VM-side check IS the spec-side check
    assert PIV.ContextOkRE(str, s.cp, s.context);
    PSM.ContextOkIsCtxOf(str, s.cp as nat);
    assert !LAnc.is_satisfied(a, TREP.CtxOf(inp), LAnc.Forward);
    TREP.AnchorAgreeInput(rer, a, inp);
    assert !LS.AnchorSatisfied(rer, T.TrAnchor(a), inp);

    TreeRepLkREAtAnchor(rer, qm, code, inp, t, pc, th.exit_allowed, a);
    assert t == LT.Mismatch;
    assert PTL.TreeBfsStepLk(t, ta[0].1, inp) == PT.StepActive([]);
    bst1 := LiftDropDeadHeadLk(rer, qm, re, code, endl, crv, str, ov, S,
                               bst, s, s1, vms2, ncap, nlook, nquant);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);
  }

  /** (L4 NESTED) clone of `LiftPreserveAnchorKillLk` — GmtTieInside dropped. */
  lemma LiftPreserveAnchorKillLkNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                 bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                 a: R.anchor, vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires !rer.multiline
    requires bst.PTS?
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.AnchorAssertion(a))
    requires !LAnc.is_satisfied(a, s.context, LAnc.Forward)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, t, ta[0].1, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, th.exit_allowed);

    // the VM-side check IS the spec-side check
    assert PIV.ContextOkRE(str, s.cp, s.context);
    PSM.ContextOkIsCtxOf(str, s.cp as nat);
    assert !LAnc.is_satisfied(a, TREP.CtxOf(inp), LAnc.Forward);
    TREP.AnchorAgreeInput(rer, a, inp);
    assert !LS.AnchorSatisfied(rer, T.TrAnchor(a), inp);

    TreeRepLkREAtAnchor(rer, qm, code, inp, t, pc, th.exit_allowed, a);
    assert t == LT.Mismatch;
    assert PTL.TreeBfsStepLk(t, ta[0].1, inp) == PT.StepActive([]);
    bst1 := LiftDropDeadHeadLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                               bst, s, s1, vms2, ncap, nlook, nquant);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);
  }

  /** Dispatcher helper (VC diet): the SetReg gm effect off machine A's head —
      the `PreserveOpenCase`/`PreserveCloseCase` preamble + `OpenStepThreadRE`/
      `CloseStepThreadRE`, packaged so the dispatcher's own VC stays small. */
  lemma DispatchSetRegEffect(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                             ngroups: nat, str: string, ptsA: PT.PikeTreeState, s: AI.VmState,
                             s1: AI.VmState, reg: int, th': AI.Thread,
                             ncap: int, nlook: int, nquant: int)
    requires !rer.multiline
    requires PSM.StaticOkRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires ptsA.PTS?
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant)
    requires |s.active| > 0 && s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetRegisterToCP(reg))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(capture_regs := AReg.set_reg(s.active[0].capture_regs, reg, Some(s1.cp), s1.clock),
                                 pc := s.active[0].pc + 1)
    ensures reg >= 0 && 0 <= s1.cp
    ensures PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
         == (if reg % 2 == 0
             then LG.GMOpen(s1.cp as nat, (reg / 2) as nat,
                            PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                         s.active[0].quant_regs))
             else LG.GMClose(s1.cp as nat, (reg / 2) as nat,
                             PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                          s.active[0].quant_regs)))
  {
    var th := s.active[0];
    var pc: nat := th.pc as nat;
    var PTS(inpA, taA, bestA, tbA, seenA) := ptsA;
    assert PIV.ActiveRepRE(rer, qm, re, code, inpA, taA, s.active);
    assert |taA| > 0;
    var tA := taA[0].0;
    var gmA := taA[0].1;
    assert TT.TreeThreadRE(rer, qm, code, inpA, tA, pc, th.exit_allowed);
    assert PIV.ThreadTracksGm(re, th, gmA);
    assert th in s.active;
    assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
    assert CM.ThreadClocksLE(th, s.clock) && CM.ThreadRegsWf(th, ncap, nlook, nquant)
        && CM.RegsValsLE(th.capture_regs, s.cp);
    assert PIV.LooksCapUnset(re, th.capture_regs.a_clk);
    assert 0 <= s1.cp;
    if reg % 2 == 0 {
      PSM.OpenStepThreadRE(rer, qm, re, code, endl, inpA, tA, gmA, th, pc, reg, s.cp, s.clock);
      assert tA.GroupActionT? && tA.g.Open? && reg == CP.start_reg(tA.g.g as int);
      assert reg == 2 * (tA.g.g as int) && (reg / 2) as nat == tA.g.g;
    } else {
      PSM.CloseStepThreadRE(rer, qm, re, code, endl, inpA, tA, gmA, th, pc, reg, s.cp, s.clock);
      assert tA.GroupActionT? && tA.g.Close? && reg == CP.end_reg(tA.g.g as int);
      assert reg == 2 * (tA.g.g as int) + 1 && (reg / 2) as nat == tA.g.g;
    }
  }

  /** Dispatcher helper (VC diet): the SetQuant `GMReset` gm effect off machine
      A's head — the `PreserveResetCase` preamble + `ResetStepThreadRE`. `!bq`
      is the caller's obligation (from the B-side canonical inversion). */
  lemma DispatchResetEffect(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                            ngroups: nat, str: string, ptsA: PT.PikeTreeState, s: AI.VmState,
                            s1: AI.VmState, q: int, th': AI.Thread,
                            ncap: int, nlook: int, nquant: int)
    requires !rer.multiline
    requires PSM.StaticOkRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires ptsA.PTS?
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant)
    requires |s.active| > 0 && s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetQuantToClock(q, false))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(quant_regs := AReg.set_reg(s.active[0].quant_regs, q, None, s1.clock),
                                 pc := s.active[0].pc + 1)
    ensures q in qm.quants
    ensures PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
         == LG.GMReset(qm.quants[q],
                       PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                    s.active[0].quant_regs))
  {
    var th := s.active[0];
    var pc: nat := th.pc as nat;
    var PTS(inpA, taA, bestA, tbA, seenA) := ptsA;
    assert PIV.ActiveRepRE(rer, qm, re, code, inpA, taA, s.active);
    assert |taA| > 0;
    var tA := taA[0].0;
    var gmA := taA[0].1;
    assert TT.TreeThreadRE(rer, qm, code, inpA, tA, pc, th.exit_allowed);
    assert PIV.ThreadTracksGm(re, th, gmA);
    assert th in s.active;
    assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
    assert CM.ThreadClocksLE(th, s.clock) && CM.ThreadRegsWf(th, ncap, nlook, nquant);
    assert PIV.LooksCapUnset(re, th.capture_regs.a_clk);
    PSM.ResetStepThreadRE(rer, qm, re, code, endl, inpA, tA, gmA, th, pc, q, s.clock);
    assert tA.GroupActionT? && tA.g.Reset? && qm.quants[q] == tA.g.gl;
  }

  /** (L4 NESTED) clone of `DispatchSetRegEffect` under `StaticOkNestedRE`: the
      Open/Close gm-effect callees are swapped to their nested-fragment
      counterparts (`OpenStepThreadRENested`/`CloseStepThreadRENested`, which
      take `NestedFragmentRE(re)` in place of `LookBehindFragmentRE(re)`). The
      body is otherwise verbatim — every other fact rides `PikeInvFullRE`. */
  lemma DispatchSetRegEffectNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                             ngroups: nat, str: string, ptsA: PT.PikeTreeState, s: AI.VmState,
                             s1: AI.VmState, reg: int, th': AI.Thread,
                             ncap: int, nlook: int, nquant: int)
    requires !rer.multiline
    requires PSM.StaticOkNestedRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires ptsA.PTS?
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant)
    requires |s.active| > 0 && s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetRegisterToCP(reg))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(capture_regs := AReg.set_reg(s.active[0].capture_regs, reg, Some(s1.cp), s1.clock),
                                 pc := s.active[0].pc + 1)
    ensures reg >= 0 && 0 <= s1.cp
    ensures PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
         == (if reg % 2 == 0
             then LG.GMOpen(s1.cp as nat, (reg / 2) as nat,
                            PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                         s.active[0].quant_regs))
             else LG.GMClose(s1.cp as nat, (reg / 2) as nat,
                             PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                          s.active[0].quant_regs)))
  {
    var th := s.active[0];
    var pc: nat := th.pc as nat;
    var PTS(inpA, taA, bestA, tbA, seenA) := ptsA;
    assert PIV.ActiveRepRE(rer, qm, re, code, inpA, taA, s.active);
    assert |taA| > 0;
    var tA := taA[0].0;
    var gmA := taA[0].1;
    assert TT.TreeThreadRE(rer, qm, code, inpA, tA, pc, th.exit_allowed);
    assert PIV.ThreadTracksGm(re, th, gmA);
    assert th in s.active;
    assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
    assert CM.ThreadClocksLE(th, s.clock) && CM.ThreadRegsWf(th, ncap, nlook, nquant)
        && CM.RegsValsLE(th.capture_regs, s.cp);
    assert PIV.LooksCapUnset(re, th.capture_regs.a_clk);
    assert 0 <= s1.cp;
    if reg % 2 == 0 {
      PSM.OpenStepThreadRENested(rer, qm, re, code, endl, inpA, tA, gmA, th, pc, reg, s.cp, s.clock);
      assert tA.GroupActionT? && tA.g.Open? && reg == CP.start_reg(tA.g.g as int);
      assert reg == 2 * (tA.g.g as int) && (reg / 2) as nat == tA.g.g;
    } else {
      PSM.CloseStepThreadRENested(rer, qm, re, code, endl, inpA, tA, gmA, th, pc, reg, s.cp, s.clock);
      assert tA.GroupActionT? && tA.g.Close? && reg == CP.end_reg(tA.g.g as int);
      assert reg == 2 * (tA.g.g as int) + 1 && (reg / 2) as nat == tA.g.g;
    }
  }

  /** (L4 NESTED) clone of `DispatchResetEffect` under `StaticOkNestedRE`: the
      `GMReset` gm-effect callee is `ResetStepThreadRENested`. Body verbatim. */
  lemma DispatchResetEffectNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                            ngroups: nat, str: string, ptsA: PT.PikeTreeState, s: AI.VmState,
                            s1: AI.VmState, q: int, th': AI.Thread,
                            ncap: int, nlook: int, nquant: int)
    requires !rer.multiline
    requires PSM.StaticOkNestedRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires ptsA.PTS?
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant)
    requires |s.active| > 0 && s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetQuantToClock(q, false))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(quant_regs := AReg.set_reg(s.active[0].quant_regs, q, None, s1.clock),
                                 pc := s.active[0].pc + 1)
    ensures q in qm.quants
    ensures PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
         == LG.GMReset(qm.quants[q],
                       PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                    s.active[0].quant_regs))
  {
    var th := s.active[0];
    var pc: nat := th.pc as nat;
    var PTS(inpA, taA, bestA, tbA, seenA) := ptsA;
    assert PIV.ActiveRepRE(rer, qm, re, code, inpA, taA, s.active);
    assert |taA| > 0;
    var tA := taA[0].0;
    var gmA := taA[0].1;
    assert TT.TreeThreadRE(rer, qm, code, inpA, tA, pc, th.exit_allowed);
    assert PIV.ThreadTracksGm(re, th, gmA);
    assert th in s.active;
    assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
    assert CM.ThreadClocksLE(th, s.clock) && CM.ThreadRegsWf(th, ncap, nlook, nquant);
    assert PIV.LooksCapUnset(re, th.capture_regs.a_clk);
    PSM.ResetStepThreadRENested(rer, qm, re, code, endl, inpA, tA, gmA, th, pc, q, s.clock);
    assert tA.GroupActionT? && tA.g.Reset? && qm.quants[q] == tA.g.gl;
  }

  /** (4) The epsilon-phase lift — THE COMPOSITE DISPATCHER (restructured
      2026-08-07 to carry `ptsA`): mirrors `FAdvanceEpsilon`'s worklist
      recursion case-for-case, stepping machine A by the PROVEN
      `PSM.Preserve*Case` lemmas (inheriting `PikeInvFullRE`'s per-thread
      facts — `ThreadNestRE`, the backbones, `LooksCapUnset` — at EVERY
      intermediate state, which the SetReg/gate value cases consume) and
      machine B by the `LiftPreserve*Lk` case tier.
      `WriteOracle`/`CheckNullable`/`Fail` are refuted outright by the
      canonical tie (no `TreeRepLkRE` rule). */
  lemma LiftAdvanceEpsilon(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                           S: set<LG.GroupId>, ptsA: PT.PikeTreeState, s: AI.VmState,
                           bst: PT.PikeTreeState, dir: LAnc.direction,
                           ncap: int, nlook: int, nquant: int)
    returns (ptsA': PT.PikeTreeState, bst1: PT.PikeTreeState)
    requires !rer.multiline && !rer.ignoreCase && qm.ov == ov
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires PSM.StaticOkRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires S == PIV.CapIdsInLooks(re)   // the value-tie boundary (SetReg/gate cases)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)   // per-lid look-table package (gate-pass case)
    requires LTB.LookUnique(re)           // (E3) cross-lid ownership pinning
    requires LTB.LookTablesOk(re, crv)    // (E4) row↔structure tie (gate converse)
    requires dir == LAnc.Forward
    requires ptsA.PTS? && bst.PTS?
    requires |s.processed.true_set| == RB.size(code) && |s.processed.false_set| == RB.size(code)
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant)
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    ensures PSM.TrcRE(ptsA, ptsA')
    ensures ptsA'.PTS?
    ensures PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA',
                              AI.FAdvanceEpsilon(code, s, ov, dir).0, ncap, nlook, nquant)
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?           // the ε-phase never finalizes; pts_final is LiftConsume's
    ensures LiftInv(rer, qm, re, code, crv, str, ov, S, bst1,
                    AI.FAdvanceEpsilon(code, s, ov, dir).0, ncap, nlook, nquant)
    decreases AI.unprocessed(s.processed), |s.active|
  {
    if |s.active| == 0 {
      ptsA' := ptsA;
      bst1 := bst;
      PSM.TrcRefl(ptsA);
      TrcLkRefl(bst);
      return;
    }
    var th := s.active[0];
    var ac := s.active[1..];

    // Head bounds from the canonical tie (machine A used ThreadNestRE here).
    var PTS(inp, ta, best, tb, seen) := bst;
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0 && th.pc >= 0;
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, ta[0].0, ta[0].1, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    assert TreeRepLkRE(rer, qm, code, inp, ta[0].0, pc, th.exit_allowed);
    TreeRepLkREInRange(rer, qm, code, inp, ta[0].0, pc, th.exit_allowed);
    assert pc < |code| && RB.size(code) == |code|;
    var i := RB.get_instr(code, th.pc);
    assert i == code[pc] && NR.GetPcRE(code, pc) == Some(i);

    if AI.bpc_mem(s.processed, th.pc, th.exit_allowed) {
      var bstS := LiftPreserveSkipLk(rer, qm, re, code, endl, crv, str, ov, S, bst, s, ncap, nlook, nquant);
      var ptsS := PSM.PreserveSkipCase(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant);
      var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                            ptsS, s.(active := ac), bstS, dir, ncap, nlook, nquant);
      PSM.TrcCons(ptsA, ptsS, ptsA2);
      TrcLkCons(bst, bstS, bst2);
      ptsA' := ptsA2;
      bst1 := bst2;
      return;
    }

    var s1 := s.(clock := s.clock + 1, processed := AI.bpc_add(s.processed, th.pc, th.exit_allowed));
    assert AI.unprocessed(s1.processed) <= AI.unprocessed(s.processed)
        && (0 <= th.pc < RB.size(code) ==> AI.unprocessed(s1.processed) < AI.unprocessed(s.processed))
      by { AI.UnprocessedAdd(s.processed, th.pc, th.exit_allowed); }
    assert AI.unprocessed(s1.processed) < AI.unprocessed(s.processed);
    assert |s1.processed.true_set| == RB.size(code) && |s1.processed.false_set| == RB.size(code);

    match i {
      case Accept =>
        var vms2 := s1.(active := [], bestmatch := Some(th));
        bst1 := LiftPreserveAcceptLk(rer, qm, re, code, endl, crv, str, ov, S,
                                     bst, s, s1, vms2, ncap, nlook, nquant);
        ptsA' := PSM.PreserveAcceptCase(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                        s1, vms2, ncap, nlook, nquant);
        PSM.TrcRefl(ptsA');
        PSM.TrcCons(ptsA, ptsA', ptsA');
        TrcLkRefl(bst1);
        TrcLkCons(bst, bst1, bst1);
        assert AI.FAdvanceEpsilon(code, s, ov, dir).0 == vms2;
      case Jmp(x) =>
        var th' := th.(pc := x);
        var vms2 := s1.(active := [th'] + ac);
        LiftPreserveStutterLk(rer, qm, re, code, endl, crv, str, ov, S,
                              bst, s, s1, th', vms2, ncap, nlook, nquant);
        PSM.PreserveStutterCase(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                s1, th', vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsA, vms2, bst, dir, ncap, nlook, nquant);
        ptsA' := ptsA2;
        bst1 := bst2;
      case BeginLoop =>
        var th' := th.(exit_allowed := false, pc := th.pc + 1);
        var vms2 := s1.(active := [th'] + ac);
        LiftPreserveStutterLk(rer, qm, re, code, endl, crv, str, ov, S,
                              bst, s, s1, th', vms2, ncap, nlook, nquant);
        PSM.PreserveStutterCase(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                s1, th', vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsA, vms2, bst, dir, ncap, nlook, nquant);
        ptsA' := ptsA2;
        bst1 := bst2;
      case Consume(ce) =>
        var (nb, ni) := AI.add_thread(th, ce, s1.blocked, s1.isblocked);
        if AI.pc_mem(s1.isblocked, th.pc) {
          assert nb == s1.blocked && ni == s1.isblocked;
          var vms2 := s1.(blocked := nb, isblocked := ni, active := ac);
          assert vms2 == s1.(active := ac);
          var bstS := LiftPreserveConsumeDropLk(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, ce, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveConsumeDrop(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                              s1, ce, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          assert nb == [(th, ce)] + s1.blocked && ni == AI.pc_add(s1.isblocked, th.pc);
          var vms2 := s1.(blocked := nb, isblocked := ni, active := ac);
          var bstS := LiftPreserveConsumeAddLk(rer, qm, re, code, endl, crv, str, ov, S,
                                               bst, s, s1, ce, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveConsumeAdd(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, ce, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case Fork(x, y) =>
        var newt := AI.Thread(x, th.capture_regs, th.look_regs, th.quant_regs, th.exit_allowed);
        var vms2 := s1.(active := [newt, th.(pc := y)] + ac);
        // backward-fork flag pin: a false-thread never sits at a Cold pc
        assert (x <= th.pc || y <= th.pc) ==> th.exit_allowed by {
          if (x <= th.pc || y <= th.pc) && !th.exit_allowed {
            assert th in s.active && PSM.EaColdOkRE(code, th);
            assert NI.ColdF(code, pc, 1);
            assert NI.ColdRE(code, pc);
          }
        }
        var bstS := LiftPreserveForkLk(rer, qm, re, code, endl, crv, str, ov, S,
                                       bst, s, s1, x, y, vms2, ncap, nlook, nquant);
        var ptsS := PSM.PreserveForkCase(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                         s1, x, y, vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsS, vms2, bstS, dir, ncap, nlook, nquant);
        PSM.TrcTrans(ptsA, ptsS, ptsA2);
        TrcLkTrans(bst, bstS, bst2);
        ptsA' := ptsA2;
        bst1 := bst2;
      case SetRegisterToCP(reg) =>
        var th' := th.(capture_regs := AReg.set_reg(th.capture_regs, reg, Some(s1.cp), s1.clock),
                       pc := th.pc + 1);
        var vms2 := s1.(active := [th'] + ac);
        // A-side gm effect off ptsA's head (helper keeps the dispatcher VC small)
        DispatchSetRegEffect(rer, qm, re, code, endl, ngroups, str, ptsA, s, s1, reg, th',
                             ncap, nlook, nquant);
        assert th in s.active;
        assert CM.ThreadClocksLE(th, s.clock) && s.clock >= 0;   // PikeInvFullRE backbone
        var bstS := LiftPreserveSetRegLk(rer, qm, re, code, endl, crv, str, ov, S,
                                         bst, s, s1, reg, th', vms2, ncap, nlook, nquant);
        var ptsS: PT.PikeTreeState;
        if reg % 2 == 0 {
          ptsS := PSM.PreserveOpenCase(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                       s1, reg, vms2, ncap, nlook, nquant);
        } else {
          ptsS := PSM.PreserveCloseCase(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                        s1, reg, vms2, ncap, nlook, nquant);
        }
        var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsS, vms2, bstS, dir, ncap, nlook, nquant);
        PSM.TrcCons(ptsA, ptsS, ptsA2);
        TrcLkTrans(bst, bstS, bst2);
        ptsA' := ptsA2;
        bst1 := bst2;
      case SetQuantToClock(q, bq) =>
        var ocp := if bq then Some(s1.cp) else None;
        var th' := th.(quant_regs := AReg.set_reg(th.quant_regs, q, ocp, s1.clock), pc := th.pc + 1);
        var vms2 := s1.(active := [th'] + ac);
        // the canonical tie pins bq == false (compiled SQC sites write false);
        // then the A-side helper yields the GMReset gm effect.
        TreeRepLkREAtSetQuant(rer, qm, code, inp, ta[0].0, pc, th.exit_allowed, q, bq);
        assert !bq && q in qm.quants;
        assert th in s.active;
        assert CM.ThreadRegsWf(th, ncap, nlook, nquant);   // PikeInvFullRE backbone
        assert CM.ThreadClocksLE(th, s.clock) && s.clock >= 0;
        DispatchResetEffect(rer, qm, re, code, endl, ngroups, str, ptsA, s, s1, q, th',
                            ncap, nlook, nquant);
        var bstS := LiftPreserveSetQuantLk(rer, qm, re, code, endl, crv, str, ov, S,
                                           bst, s, s1, q, bq, th', vms2, ncap, nlook, nquant);
        var ptsS := PSM.PreserveResetCase(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                          s1, q, bq, vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsS, vms2, bstS, dir, ncap, nlook, nquant);
        PSM.TrcCons(ptsA, ptsS, ptsA2);
        TrcLkTrans(bst, bstS, bst2);
        ptsA' := ptsA2;
        bst1 := bst2;
      case CheckOracle(l) =>
        if LOr.view_get_oracle(ov, s1.cp, l) {
          var th' := th.(pc := th.pc + 1,
                         look_regs := AReg.set_reg(th.look_regs, l, Some(s1.cp), s1.clock));
          var vms2 := s1.(active := [th'] + ac);
          assert th in s.active;
          assert CM.ThreadRegsWf(th, ncap, nlook, nquant);   // PikeInvFullRE backbone
          assert CM.ThreadClocksLE(th, s.clock) && s.clock >= 0;
          assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
          var bstS := LiftPreserveGatePassLk(rer, qm, re, code, endl, crv, str, ov, S,
                                             bst, s, s1, l, th', vms2, ncap, nlook, nquant);
          PSM.PreserveOraclePass(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                 s1, th', vms2, l, true, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsA, vms2, bstS, dir, ncap, nlook, nquant);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveGateKillLk(rer, qm, re, code, endl, crv, str, ov, S,
                                             bst, s, s1, l, true, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveOracleKill(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, l, true, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case NegCheckOracle(l) =>
        if LOr.view_get_oracle(ov, s1.cp, l) {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveGateKillLk(rer, qm, re, code, endl, crv, str, ov, S,
                                             bst, s, s1, l, false, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveOracleKill(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, l, false, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := [th.(pc := th.pc + 1)] + ac);
          var bstS := LiftPreserveNegGatePassLk(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, l, vms2, ncap, nlook, nquant);
          PSM.PreserveOraclePass(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                 s1, th.(pc := th.pc + 1), vms2, l, false, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsA, vms2, bstS, dir, ncap, nlook, nquant);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case WriteOracle(l) =>
        // no TreeRepLkRE rule at WriteOracle — the canonical head tie is refuted
        assert false;
        ptsA' := ptsA;
        bst1 := bst;
      case EndLoop =>
        if th.exit_allowed {
          var vms2 := s1.(active := [th.(pc := th.pc + 1)] + ac);
          var bstS := LiftPreserveEndLoopPassLk(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveEndLoopPass(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                              s1, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveEndLoopKillLk(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveEndLoopKill(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                              s1, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case CheckNullable(qid) =>
        // no TreeRepLkRE rule at CheckNullable — refuted
        assert false;
        ptsA' := ptsA;
        bst1 := bst;
      case AnchorAssertion(a) =>
        if LAnc.is_satisfied(a, s1.context, dir) {
          var vms2 := s1.(active := [th.(pc := th.pc + 1)] + ac);
          var bstS := LiftPreserveAnchorPassLk(rer, qm, re, code, endl, crv, str, ov, S,
                                               bst, s, s1, a, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveAnchorPass(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, a, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveAnchorKillLk(rer, qm, re, code, endl, crv, str, ov, S,
                                               bst, s, s1, a, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveAnchorKill(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, a, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case Fail =>
        // no TreeRepLkRE rule at Fail — refuted
        assert false;
        ptsA' := ptsA;
        bst1 := bst;
    }
  }

  /** (L4 NESTED) clone of `LiftAdvanceEpsilon` — GmtTieInside dropped. */
  lemma LiftAdvanceEpsilonNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                           S: set<LG.GroupId>, ptsA: PT.PikeTreeState, s: AI.VmState,
                           bst: PT.PikeTreeState, dir: LAnc.direction,
                           ncap: int, nlook: int, nquant: int)
    returns (ptsA': PT.PikeTreeState, bst1: PT.PikeTreeState)
    requires !rer.multiline && !rer.ignoreCase && qm.ov == ov
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires PSM.StaticOkNestedRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires S == PIV.CapIdsInLooks(re)   // the value-tie boundary (SetReg/gate cases)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)   // per-lid look-table package (gate-pass case)
    requires LTB.LookUnique(re)           // (E3) cross-lid ownership pinning
    requires LTB.LookTablesOk(re, crv)    // (E4) row↔structure tie (gate converse)
    requires dir == LAnc.Forward
    requires ptsA.PTS? && bst.PTS?
    requires |s.processed.true_set| == RB.size(code) && |s.processed.false_set| == RB.size(code)
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant)
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    ensures PSM.TrcRE(ptsA, ptsA')
    ensures ptsA'.PTS?
    ensures PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA',
                              AI.FAdvanceEpsilon(code, s, ov, dir).0, ncap, nlook, nquant)
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?           // the ε-phase never finalizes; pts_final is LiftConsume's
    ensures LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1,
                    AI.FAdvanceEpsilon(code, s, ov, dir).0, ncap, nlook, nquant)
    decreases AI.unprocessed(s.processed), |s.active|
  {
    if |s.active| == 0 {
      ptsA' := ptsA;
      bst1 := bst;
      PSM.TrcRefl(ptsA);
      TrcLkRefl(bst);
      return;
    }
    var th := s.active[0];
    var ac := s.active[1..];

    // Head bounds from the canonical tie (machine A used ThreadNestRE here).
    var PTS(inp, ta, best, tb, seen) := bst;
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0 && th.pc >= 0;
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, ta[0].0, ta[0].1, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    assert TreeRepLkRE(rer, qm, code, inp, ta[0].0, pc, th.exit_allowed);
    TreeRepLkREInRange(rer, qm, code, inp, ta[0].0, pc, th.exit_allowed);
    assert pc < |code| && RB.size(code) == |code|;
    var i := RB.get_instr(code, th.pc);
    assert i == code[pc] && NR.GetPcRE(code, pc) == Some(i);

    if AI.bpc_mem(s.processed, th.pc, th.exit_allowed) {
      var bstS := LiftPreserveSkipLkNested(rer, qm, re, code, endl, crv, str, ov, S, bst, s, ncap, nlook, nquant);
      var ptsS := PSM.PreserveSkipCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant);
      var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                            ptsS, s.(active := ac), bstS, dir, ncap, nlook, nquant);
      PSM.TrcCons(ptsA, ptsS, ptsA2);
      TrcLkCons(bst, bstS, bst2);
      ptsA' := ptsA2;
      bst1 := bst2;
      return;
    }

    var s1 := s.(clock := s.clock + 1, processed := AI.bpc_add(s.processed, th.pc, th.exit_allowed));
    assert AI.unprocessed(s1.processed) <= AI.unprocessed(s.processed)
        && (0 <= th.pc < RB.size(code) ==> AI.unprocessed(s1.processed) < AI.unprocessed(s.processed))
      by { AI.UnprocessedAdd(s.processed, th.pc, th.exit_allowed); }
    assert AI.unprocessed(s1.processed) < AI.unprocessed(s.processed);
    assert |s1.processed.true_set| == RB.size(code) && |s1.processed.false_set| == RB.size(code);

    match i {
      case Accept =>
        var vms2 := s1.(active := [], bestmatch := Some(th));
        bst1 := LiftPreserveAcceptLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                     bst, s, s1, vms2, ncap, nlook, nquant);
        ptsA' := PSM.PreserveAcceptCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                        s1, vms2, ncap, nlook, nquant);
        PSM.TrcRefl(ptsA');
        PSM.TrcCons(ptsA, ptsA', ptsA');
        TrcLkRefl(bst1);
        TrcLkCons(bst, bst1, bst1);
        assert AI.FAdvanceEpsilon(code, s, ov, dir).0 == vms2;
      case Jmp(x) =>
        var th' := th.(pc := x);
        var vms2 := s1.(active := [th'] + ac);
        LiftPreserveStutterLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                              bst, s, s1, th', vms2, ncap, nlook, nquant);
        PSM.PreserveStutterCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                s1, th', vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsA, vms2, bst, dir, ncap, nlook, nquant);
        ptsA' := ptsA2;
        bst1 := bst2;
      case BeginLoop =>
        var th' := th.(exit_allowed := false, pc := th.pc + 1);
        var vms2 := s1.(active := [th'] + ac);
        LiftPreserveStutterLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                              bst, s, s1, th', vms2, ncap, nlook, nquant);
        PSM.PreserveStutterCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                s1, th', vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsA, vms2, bst, dir, ncap, nlook, nquant);
        ptsA' := ptsA2;
        bst1 := bst2;
      case Consume(ce) =>
        var (nb, ni) := AI.add_thread(th, ce, s1.blocked, s1.isblocked);
        if AI.pc_mem(s1.isblocked, th.pc) {
          assert nb == s1.blocked && ni == s1.isblocked;
          var vms2 := s1.(blocked := nb, isblocked := ni, active := ac);
          assert vms2 == s1.(active := ac);
          var bstS := LiftPreserveConsumeDropLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, ce, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveConsumeDropNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                              s1, ce, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          assert nb == [(th, ce)] + s1.blocked && ni == AI.pc_add(s1.isblocked, th.pc);
          var vms2 := s1.(blocked := nb, isblocked := ni, active := ac);
          var bstS := LiftPreserveConsumeAddLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                               bst, s, s1, ce, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveConsumeAddNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, ce, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case Fork(x, y) =>
        var newt := AI.Thread(x, th.capture_regs, th.look_regs, th.quant_regs, th.exit_allowed);
        var vms2 := s1.(active := [newt, th.(pc := y)] + ac);
        // backward-fork flag pin: a false-thread never sits at a Cold pc
        assert (x <= th.pc || y <= th.pc) ==> th.exit_allowed by {
          if (x <= th.pc || y <= th.pc) && !th.exit_allowed {
            assert th in s.active && PSM.EaColdOkRE(code, th);
            assert NI.ColdF(code, pc, 1);
            assert NI.ColdRE(code, pc);
          }
        }
        var bstS := LiftPreserveForkLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                       bst, s, s1, x, y, vms2, ncap, nlook, nquant);
        var ptsS := PSM.PreserveForkCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                         s1, x, y, vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsS, vms2, bstS, dir, ncap, nlook, nquant);
        PSM.TrcTrans(ptsA, ptsS, ptsA2);
        TrcLkTrans(bst, bstS, bst2);
        ptsA' := ptsA2;
        bst1 := bst2;
      case SetRegisterToCP(reg) =>
        var th' := th.(capture_regs := AReg.set_reg(th.capture_regs, reg, Some(s1.cp), s1.clock),
                       pc := th.pc + 1);
        var vms2 := s1.(active := [th'] + ac);
        // A-side gm effect off ptsA's head (helper keeps the dispatcher VC small)
        DispatchSetRegEffectNested(rer, qm, re, code, endl, ngroups, str, ptsA, s, s1, reg, th',
                             ncap, nlook, nquant);
        assert th in s.active;
        assert CM.ThreadClocksLE(th, s.clock) && s.clock >= 0;   // PikeInvFullRE backbone
        var bstS := LiftPreserveSetRegLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                         bst, s, s1, reg, th', vms2, ncap, nlook, nquant);
        var ptsS: PT.PikeTreeState;
        if reg % 2 == 0 {
          ptsS := PSM.PreserveOpenCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                       s1, reg, vms2, ncap, nlook, nquant);
        } else {
          ptsS := PSM.PreserveCloseCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                        s1, reg, vms2, ncap, nlook, nquant);
        }
        var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsS, vms2, bstS, dir, ncap, nlook, nquant);
        PSM.TrcCons(ptsA, ptsS, ptsA2);
        TrcLkTrans(bst, bstS, bst2);
        ptsA' := ptsA2;
        bst1 := bst2;
      case SetQuantToClock(q, bq) =>
        var ocp := if bq then Some(s1.cp) else None;
        var th' := th.(quant_regs := AReg.set_reg(th.quant_regs, q, ocp, s1.clock), pc := th.pc + 1);
        var vms2 := s1.(active := [th'] + ac);
        // the canonical tie pins bq == false (compiled SQC sites write false);
        // then the A-side helper yields the GMReset gm effect.
        TreeRepLkREAtSetQuant(rer, qm, code, inp, ta[0].0, pc, th.exit_allowed, q, bq);
        assert !bq && q in qm.quants;
        assert th in s.active;
        assert CM.ThreadRegsWf(th, ncap, nlook, nquant);   // PikeInvFullRE backbone
        assert CM.ThreadClocksLE(th, s.clock) && s.clock >= 0;
        DispatchResetEffectNested(rer, qm, re, code, endl, ngroups, str, ptsA, s, s1, q, th',
                            ncap, nlook, nquant);
        var bstS := LiftPreserveSetQuantLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                           bst, s, s1, q, bq, th', vms2, ncap, nlook, nquant);
        var ptsS := PSM.PreserveResetCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                          s1, q, bq, vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsS, vms2, bstS, dir, ncap, nlook, nquant);
        PSM.TrcCons(ptsA, ptsS, ptsA2);
        TrcLkTrans(bst, bstS, bst2);
        ptsA' := ptsA2;
        bst1 := bst2;
      case CheckOracle(l) =>
        if LOr.view_get_oracle(ov, s1.cp, l) {
          var th' := th.(pc := th.pc + 1,
                         look_regs := AReg.set_reg(th.look_regs, l, Some(s1.cp), s1.clock));
          var vms2 := s1.(active := [th'] + ac);
          assert th in s.active;
          assert CM.ThreadRegsWf(th, ncap, nlook, nquant);   // PikeInvFullRE backbone
          assert CM.ThreadClocksLE(th, s.clock) && s.clock >= 0;
          assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
          var bstS := LiftPreserveGatePassLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                             bst, s, s1, l, th', vms2, ncap, nlook, nquant);
          PSM.PreserveOraclePassNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                 s1, th', vms2, l, true, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsA, vms2, bstS, dir, ncap, nlook, nquant);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveGateKillLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                             bst, s, s1, l, true, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveOracleKillNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, l, true, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case NegCheckOracle(l) =>
        if LOr.view_get_oracle(ov, s1.cp, l) {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveGateKillLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                             bst, s, s1, l, false, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveOracleKillNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, l, false, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := [th.(pc := th.pc + 1)] + ac);
          var bstS := LiftPreserveNegGatePassLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, l, vms2, ncap, nlook, nquant);
          PSM.PreserveOraclePassNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                 s1, th.(pc := th.pc + 1), vms2, l, false, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsA, vms2, bstS, dir, ncap, nlook, nquant);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case WriteOracle(l) =>
        // no TreeRepLkRE rule at WriteOracle — the canonical head tie is refuted
        assert false;
        ptsA' := ptsA;
        bst1 := bst;
      case EndLoop =>
        if th.exit_allowed {
          var vms2 := s1.(active := [th.(pc := th.pc + 1)] + ac);
          var bstS := LiftPreserveEndLoopPassLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveEndLoopPassNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                              s1, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveEndLoopKillLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveEndLoopKillNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                              s1, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case CheckNullable(qid) =>
        // no TreeRepLkRE rule at CheckNullable — refuted
        assert false;
        ptsA' := ptsA;
        bst1 := bst;
      case AnchorAssertion(a) =>
        if LAnc.is_satisfied(a, s1.context, dir) {
          var vms2 := s1.(active := [th.(pc := th.pc + 1)] + ac);
          var bstS := LiftPreserveAnchorPassLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                               bst, s, s1, a, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveAnchorPassNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, a, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveAnchorKillLkNested(rer, qm, re, code, endl, crv, str, ov, S,
                                               bst, s, s1, a, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveAnchorKillNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, a, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case Fail =>
        // no TreeRepLkRE rule at Fail — refuted
        assert false;
        ptsA' := ptsA;
        bst1 := bst;
    }
  }

  // (5)/(6)/(7): the pre-composite LiftConsume / LiftFindMatch / LiftEndpoint
  // scaffolds are SUPERSEDED by the composite spine (LiftInitC -> LiftFindMatchC
  // -> L3aCompositeClose, all PROVEN) and were deleted 2026-08-08.

  // ==========================================================================
  // THE REST OF THE LADDER — the sub-DAG below LiftAdvanceEpsilon, plus the
  // two bridges that reach MainTheorem. With these filled, L3 is:
  //   helpers → LiftAdvanceEpsilon → LiftConsume → LiftFindMatch →
  //   LiftEndpoint → L3aValueBridge → else-branch rewrite → delete
  //   LkBodyGroupsEmpty / FilterUnmoved / L1 LookRowsFromTables → package
  //   verify → repack.
  // Confidence tiers: [SOLID] statement believed exact; [SEAM] shape right,
  // details expected to shift during fill — adjust freely, the consumer is
  // LiftAdvanceEpsilon's matching case.
  // ==========================================================================

  // ---- (H) per-instruction walk inversions: the B-side mirrors of
  //      TT.TtAtJmp / TtAtBeginLoop, one per LiftAdvanceEpsilon case. Each
  //      says what the B head MUST look like at that instruction and where
  //      the walk stands after. FILL from the corresponding
  //      ActionsTreeRepFRE case (it performs exactly this inversion inline).
  //
  // FILL RECIPE (reverse-engineered 2026-08-03 — read before starting):
  //  * TtLk bundles four conjuncts over an EXISTENTIAL (acts, b). Extract them;
  //    the tree-side conclusion (tb.Read? / tb == LT.Match / tb.LK? / ...) is a
  //    ONE-STEP unfold of the `least predicate` EL.BoolTreeLk once acts[0] is
  //    known (the `case _ => false` arms make the shape forced). There are NO
  //    standalone BoolTreeLk-shape inverters yet — unfold inline.
  //  * The walk MOVE (TtLk at nextpc) reuses the SAME (acts, b): only
  //    AR.ActionsRepL must be transferred; WO.WalkOk moves via the matching
  //    destructor (WalkOkJmp/WalkOkEpsilon/WalkOkCharacter/WalkOkAclose/
  //    WalkOkAnchor/WalkOkLookaround/WalkOkSeq/WalkOkGroup/WalkOkAlt/... ,
  //    WalkOk.dfy:162+), PikeLkActions via PikeLkActionsTail, EaOf(b) is inert.
  //  * The ActionsRepL transfer is the WORK, and it is NOT a plain `least
  //    lemma`: cons_bc JUMPS a whole sub-regex (acts[1..] at the sub-regex's
  //    end) whereas BoolTreeLk EXPANDS it ([Areg(r1),Areg(r2)]+cont, etc.), so
  //    reconciling them re-expands `acts` and GROWS it. Mirror
  //    ActionsTreeRepFRE EXACTLY: take `ActionsRepFuelL` (fueled ActionsRepL,
  //    via AR.ActionsRepLToFuel) and `decreases MsizeA(acts), n` — plain
  //    least-recursion is unsound here. Transparent heads (Epsilon, and
  //    Sequences/spent-quants reducing to it) peel in place (pcmid == pc, use
  //    AR.NfaRepIncrL for the span bound); every non-transparent head pins a
  //    GetPcRE instruction that contradicts the inversion's target (⇒ vacuous
  //    `case _`). The stutter set (Jmp/BeginLoop/Accept) bottoms at jump_bc or
  //    empty_bc; the consuming/gate cases pin their instruction directly.
  //  * TtLkAtCheckOracle additionally needs LL.OracleOkAt(rer,qm,inp) to tie
  //    the bit (LOr.view_get_oracle) to LkGateOk's verdict — carry it in TtLk
  //    or thread it as a requires (it is already a LiftInv conjunct via
  //    LL.OracleOkSuffix). This is the ONE inversion that yields tb.LK?/tb.LKFail?.

  /** `NfaRepMinL`'s head: `k==0` is transparent (`em==pc`), `k>0` pins a
      `SetQuantToClock` at `pc`. */
  lemma NfaRepMinLHeadPin(rer: LW.RegExpRecord, qm: AR.QMap, k: nat, r1: L.Regex, code: RB.code, pc: nat, em: nat)
    requires AR.NfaRepMinL(rer, qm, k, r1, code, pc, em)
    ensures k == 0 ==> em == pc
    ensures k > 0 ==> NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.SetQuantToClock?
  {
    if k > 0 {
      var e1: nat :|
        (exists qid: int :: NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                            && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
        && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
        && AR.NfaRepMinL(rer, qm, k - 1, r1, code, e1, em);
    }
  }

  /** `NfaRepOptL`'s head: `k==0` is transparent (`em==pc`), `k>0` pins a `Fork`
      at `pc`. */
  lemma NfaRepOptLHeadPin(rer: LW.RegExpRecord, qm: AR.QMap, k: nat, greedy: bool, r1: L.Regex, code: RB.code, pc: nat, em: nat)
    requires AR.NfaRepOptL(rer, qm, k, greedy, r1, code, pc, em)
    ensures k == 0 ==> em == pc
    ensures k > 0 ==> NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.Fork?
  {
    if k > 0 {
      var e1: nat :|
        NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, em) else RB.Fork(em, pc + 1))
        && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                               && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
        && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
        && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
        && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
        && AR.NfaRepOptL(rer, qm, k - 1, greedy, r1, code, e1 + 1, em);
    }
  }

  /** A regex whose `NfaRepL` span STARTS at a `Jmp` is transparent: the span is
      empty (`pcmid == pc`) and it re-represents empty at any position `x`. Every
      non-transparent shape pins a conflicting instruction at `pc`. */
  lemma NfaRepLAtJmpTransparent(rer: LW.RegExpRecord, qm: AR.QMap, r: L.Regex, code: RB.code,
                                pc: nat, pcmid: nat, x: int)
    requires AR.NfaRepL(rer, qm, r, code, pc, pcmid)
    requires NR.GetPcRE(code, pc) == Some(RB.Jmp(x))
    ensures pcmid == pc
    ensures x >= 0 ==> AR.NfaRepL(rer, qm, r, code, x as nat, x as nat)
    decreases r
  {
    match r
    case Epsilon =>
    case Character(cd) =>
      var ce :| NR.GetPcRE(code, pc) == Some(RB.Consume(ce)) && AR.ExpectationMatches(rer, ce, cd);
    case Disjunction(r1, r2) =>
      var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.Fork(pc + 1, e1 + 1))
        && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
        && NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid))
        && AR.NfaRepL(rer, qm, r2, code, e1 + 1, pcmid);
    case Sequence(r1, r2) =>
      var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
      NfaRepLAtJmpTransparent(rer, qm, r1, code, pc, e1, x);       // e1 == pc
      NfaRepLAtJmpTransparent(rer, qm, r2, code, pc, pcmid, x);    // pcmid == pc
      if x >= 0 {
        assert AR.NfaRepL(rer, qm, r1, code, x as nat, x as nat);
        assert AR.NfaRepL(rer, qm, r2, code, x as nat, x as nat);
      }
    case Quantified(greedy, min, delta, r1) =>
      if min == 0 && delta == LN.Inf {
        // the star: pins Fork at pc (fast path or loop view) — contradiction
        if exists e1: nat ::
             NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
             && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                    && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
             && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
             && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
             && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
             && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
             && pcmid == e1 + 2 {
          var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
        } else {
          var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
        }
      } else {
        match delta
        case Inf =>
          var em: nat, e1: nat :|
            AR.NfaRepMinL(rer, qm, min - 1, r1, code, pc, em)
            && (exists qid: int :: NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                                   && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
            && AR.NfaRepL(rer, qm, r1, code, em + 1, e1)
            && NR.GetPcRE(code, e1) == Some(if greedy then RB.Fork(em, e1 + 1) else RB.Fork(e1 + 1, em))
            && pcmid == e1 + 1;
          NfaRepMinLHeadPin(rer, qm, min - 1, r1, code, pc, em);   // min-1==0 ⇒ em==pc; else Fork/SQC at pc
          // either way GetPcRE(pc) is SetQuantToClock ≠ Jmp
        case NN(kx) =>
          var em: nat :| AR.NfaRepMinL(rer, qm, min, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, min, r1, code, pc, em);
          if min == 0 {
            assert em == pc;
            NfaRepOptLHeadPin(rer, qm, kx, greedy, r1, code, em, pcmid);
            // kx==0 ⇒ pcmid==em==pc (and NfaRepL(...,x,x) via transparent chains);
            // kx>0 ⇒ Fork at pc, contradiction
            if kx == 0 && x >= 0 {
              assert AR.NfaRepMinL(rer, qm, 0, r1, code, x as nat, x as nat);
              assert AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, x as nat, x as nat);
            }
          }
          // min>0 ⇒ SetQuantToClock at pc, contradiction
      }
    case Group(gid, r1) =>
      var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(gid as int)))
        && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
        && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(gid as int)))
        && pcmid == e1 + 1;
    case LookaroundR(lk, r1) =>
      var lid: int :| NR.GetPcRE(code, pc) == Some(if AR.PositiveL(lk) then RB.CheckOracle(lid)
                                                                       else RB.NegCheckOracle(lid))
        && lid in qm.looks && qm.looks[lid] == (lk, r1);
    case AnchorR(la) =>
      var a: R.anchor :| NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a)) && T.TrAnchor(a) == la;
    case Backreference(_) =>
  }

  /** `ActionsRepL` sees THROUGH a `Jmp`: representing at a `Jmp(x)` pc is the
      same as representing at the target `x`. Transparent `Areg` heads are
      relocated intact (`NfaRepLAtJmpTransparent`); every other head pins a
      non-`Jmp` instruction. */
  least lemma ActionsRepLThruJmp(rer: LW.RegExpRecord, qm: AR.QMap, acts: LS.Actions, code: RB.code, pc: nat, x: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires NR.GetPcRE(code, pc) == Some(RB.Jmp(x))
    ensures x >= 0 && AR.ActionsRepL(rer, qm, acts, code, x as nat)
  {
    if |acts| == 0 && NR.GetPcRE(code, pc) == Some(RB.Accept) {
      // Accept != Jmp: contradiction
    } else if |acts| > 0 && exists pcmid: nat :: AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid) {
      var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
      match acts[0]
      case Acheck(_) =>   // pins EndLoop or a backward Fork — not Jmp
      case Aclose(_) =>   // pins SetRegisterToCP — not Jmp
      case Areg(r) =>
        NfaRepLAtJmpTransparent(rer, qm, r, code, pc, pcmid, x);   // pcmid == pc; (x>=0 ⇒ NfaRepL(r,x,x))
        assert pcmid == pc;
        ActionsRepLThruJmp(rer, qm, acts[1..], code, pc, x);       // ⇒ x >= 0 && ActionsRepL(acts[1..], code, x)
        assert AR.ActionRepL(rer, qm, acts[0], code, x as nat, x as nat);
        assert acts == [acts[0]] + acts[1..];
        AR.ActionsRepLCons(rer, qm, acts[0], acts[1..], code, x as nat, x as nat);
    } else {
      var pcstart: nat :| NR.GetPcRE(code, pc) == Some(RB.Jmp(pcstart)) && AR.ActionsRepL(rer, qm, acts, code, pcstart);
      assert pcstart == x;
    }
  }

  /** [SOLID] Jmp is a pure stutter: same tree, walk at the target. */
  lemma TtLkAtJmp(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                  tb: LT.Tree, pc: nat, ea: bool, x: int)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Jmp(x))
    ensures x >= 0 && TtLk(rer, qm, code, inp, tb, x as nat, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    ActionsRepLThruJmp(rer, qm, acts, code, pc, x);   // x >= 0 && ActionsRepL(acts, code, x)
    // same (acts, b) witness TtLk at x — only the pc moved
  }

  /** [SOLID] BeginLoop: a REAL stutter now. `TtLk`'s new first disjunct sees
      through a `BeginLoop` to `pc+1` (mirroring `TreeRepRE.tr_begin`). The
      `ActionsRepL` (second) disjunct is impossible at a `BeginLoop` pc
      (`TT.ActionsRepNotAtBeginLoop`), so `TtLk(pc)` must hold via the stutter,
      which IS `TtLk(pc+1, false)`. This unblocks `LiftAdvanceEpsilon`: the VM
      steps a BeginLoop thread to `pc+1` with `exit_allowed:=false`, and the
      pairing follows it. */
  lemma TtLkAtBeginLoop(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                        tb: LT.Tree, pc: nat, ea: bool)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
    ensures TtLk(rer, qm, code, inp, tb, pc + 1, false)
  {
    // The ActionsRepL disjunct is unsatisfiable at a BeginLoop pc.
    forall acts: LS.Actions, b: BS.LoopBool
      ensures !(AR.ActionsRepL(rer, qm, acts, code, pc)
                && EL.PikeLkActions(acts) && ATR.EaOf(b) == ea
                && EL.BoolTreeLk(rer, acts, inp, b, tb))
    {
      if AR.ActionsRepL(rer, qm, acts, code, pc) {
        TT.ActionsRepNotAtBeginLoop(rer, qm, acts, code, pc);   // ⇒ false
      }
    }
    // So TtLk(pc) holds via the BeginLoop stutter, whose payload is TtLk(pc+1, false).
  }

  /** The `WalkPairLk` analogue of `TtLkAtBeginLoop`: the gated pairing walk also
      sees through a `BeginLoop` (the `ActionsRepL` disjunct is impossible there),
      so the whole per-thread `ThreadRepLk` follows the VM's BeginLoop step. */
  lemma WalkPairLkAtBeginLoop(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                              tb: LT.Tree, gmt: LG.GroupMap, pc: nat, ea: bool)
    requires WalkPairLk(rer, qm, code, inp, tb, gmt, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
    ensures WalkPairLk(rer, qm, code, inp, tb, gmt, pc + 1, false)
  {
    forall acts: LS.Actions, b: BS.LoopBool
      ensures !(AR.ActionsRepL(rer, qm, acts, code, pc)
                && EL.PikeLkActions(acts) && ATR.EaOf(b) == ea
                && EL.BoolTreeLk(rer, acts, inp, b, tb) && GateAheadClear(acts, gmt))
    {
      if AR.ActionsRepL(rer, qm, acts, code, pc) {
        TT.ActionsRepNotAtBeginLoop(rer, qm, acts, code, pc);   // ⇒ false
      }
    }
  }

  /** Per-thread BeginLoop preservation — the reusable core of `LiftAdvanceEpsilon`'s
      BeginLoop case. When the VM steps a thread through `BeginLoop`
      (`exit_allowed:=false, pc:=pc+1`), its whole pairing to `(tb, gmt)` carries:
      the walk sees through via `WalkPairLkAtBeginLoop`, and the value ties are
      frame-invariant (BeginLoop touches only `pc`/`exit_allowed`, not the
      capture/look/quant banks that `GmtTie*` reads). The B-machine does NOT step
      (a `BeginLoop` is absorbed by the walk stutter — the loop shows up in `tb`
      as `Choice` nodes, stepped later). */
  lemma ThreadRepLkStepBeginLoop(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                 inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                 S: set<LG.GroupId>, tb: LT.Tree, gmt: LG.GroupMap, th: AI.Thread,
                                 ncap: int, nlook: int, nquant: int)
    requires ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, tb, gmt, th, ncap, nlook, nquant)
    requires NR.GetPcRE(code, th.pc as nat) == Some(RB.BeginLoop)
    ensures ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, tb, gmt,
                        th.(exit_allowed := false, pc := th.pc + 1), ncap, nlook, nquant)
  {
    WalkPairLkAtBeginLoop(rer, qm, code, inp, tb, gmt, th.pc as nat, th.exit_allowed);
    // th.pc >= 0 (from ThreadRepLk) so (th.pc+1) as nat == (th.pc as nat) + 1.
    assert (th.pc + 1) as nat == (th.pc as nat) + 1;
    // GmtTieOutside/GmtTieInside read only capture/look/quant regs, unchanged by
    // the pc/exit_allowed update, so they transfer verbatim.
  }

  /** Discharges the CheckOracle core's OUTSIDE-`S` frame: crossing a positive gate
      (gm → gm2 = `LkResult` merge, and `a_cp[l]` newly set in `t'`) preserves the
      outside-`S` value tie. Three proven pieces chain: `LkResultAgreeOutside`
      (merge touches only `DefGroups(r1) ⊆ S`), `GmtTieOutside(t)` (the incoming
      tie), and `PIV.GmOfLiveLookIndep` (setting look register `l` cannot change
      any group outside `CapIdsInLooks(re) == S`). */
  lemma GmtTieOutsideAfterGate(rer: LW.RegExpRecord, re: R.regex, str: string, lk: L.Lookaround,
                               r1: L.Regex, tlk: LT.Tree, gm: LG.GroupMap, t: AI.Thread,
                               l: int, cp: nat, clk: int, S: set<LG.GroupId>)
    requires cp <= |str|
    requires NR.LookBehindFragmentRE(re) && T.TransWf(re)
    requires S == LL.LkBodyGroups(T.Translate(re))
    requires (set g | g in L.DefGroups(r1)) <= S
    requires GmtTieOutside(re, t, gm, S)
    requires L.Positivity(lk) && EL.NoLkBrL(r1)
    requires tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], PIV.InpOfCp(str, cp), LG.Empty, L.LkDir(lk))
    requires LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).Some?
    ensures var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
            GmtTieOutside(re, t', LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).value, S)
  {
    var inp := PIV.InpOfCp(str, cp);
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    LkResultAgreeOutside(rer, lk, r1, inp, tlk, gm);      // GmAgreeOutside(gm2, gm, DefGroups(r1))
    M.LkBodyGroupsEqCapIdsInLooks(re);                    // S == CapIdsInLooks(re)
    PIV.GmOfLiveLookIndep(re, t.capture_regs, t.look_regs, t'.look_regs, t.quant_regs);
    forall g: LG.GroupId | g !in S
      ensures (g in gm2 <==> g in PIV.GmOfLive(re, t'.capture_regs, t'.look_regs, t'.quant_regs))
           && (g in gm2 ==> gm2[g] == PIV.GmOfLive(re, t'.capture_regs, t'.look_regs, t'.quant_regs)[g])
    {
      assert g !in (set g': LG.GroupId | g' in L.DefGroups(r1));   // DefGroups(r1) ⊆ S
      assert g !in PIV.CapIdsInLooks(re);                          // S == CapIdsInLooks(re)
      // gm2[g] ~ gm[g] (LkResultAgreeOutside) ~ gml[g] (GmtTieOutside t) ~ gml'[g] (LookIndep).
    }
  }

  /** (L4 NESTED) clone of `GmtTieOutsideAfterGate` — GmtTieInside dropped. */
  lemma GmtTieOutsideAfterGateNested(rer: LW.RegExpRecord, re: R.regex, str: string, lk: L.Lookaround,
                               r1: L.Regex, tlk: LT.Tree, gm: LG.GroupMap, t: AI.Thread,
                               l: int, cp: nat, clk: int, S: set<LG.GroupId>)
    requires cp <= |str|
    requires NR.NestedFragmentRE(re) && T.TransWf(re)
    requires S == LL.LkBodyGroups(T.Translate(re))
    requires (set g | g in L.DefGroups(r1)) <= S
    requires GmtTieOutside(re, t, gm, S)
    requires L.Positivity(lk) && EL.PikeLkRegexRec(r1)
    requires tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], PIV.InpOfCp(str, cp), LG.Empty, L.LkDir(lk))
    requires LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).Some?
    ensures var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
            GmtTieOutside(re, t', LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).value, S)
  {
    var inp := PIV.InpOfCp(str, cp);
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    LkResultAgreeOutsideNested(rer, lk, r1, inp, tlk, gm);      // GmAgreeOutside(gm2, gm, DefGroups(r1))
    M.LkBodyGroupsEqCapIdsInLooks(re);                    // S == CapIdsInLooks(re)
    PIV.GmOfLiveLookIndepNested(re, t.capture_regs, t.look_regs, t'.look_regs, t.quant_regs);
    forall g: LG.GroupId | g !in S
      ensures (g in gm2 <==> g in PIV.GmOfLive(re, t'.capture_regs, t'.look_regs, t'.quant_regs))
           && (g in gm2 ==> gm2[g] == PIV.GmOfLive(re, t'.capture_regs, t'.look_regs, t'.quant_regs)[g])
    {
      assert g !in (set g': LG.GroupId | g' in L.DefGroups(r1));   // DefGroups(r1) ⊆ S
      assert g !in PIV.CapIdsInLooks(re);                          // S == CapIdsInLooks(re)
      // gm2[g] ~ gm[g] (LkResultAgreeOutside) ~ gml[g] (GmtTieOutside t) ~ gml'[g] (LookIndep).
    }
  }

  /** L3b item 4 (task #8) — PROVEN: the BACKWARD-gate twin of
      `ThreadRepLkStepCheckOracle` for a CAPTURING positive lookbehind. It
      establishes `GmtTieInside`'s `SwapRange` form via `GateStepValueLB` (which
      calls the keystone `LBK.LkReplayMatchesSpecLB` at cap=init + `BV.BackwardReplayMirror`),
      with the outside frame / continuation walk direction-generic (as in the
      lookahead twin). The value chain: `FreshBodyMatch(LB)` runs the backward
      capture (= `raB`), the mirror gives `rfF == MirrorThread(raB)`, and the
      keystone yields `SwapRange(gm2[g]) == GmOfLive(body, raB.caps)[g]` for `g in S`. */
  lemma {:isolate_assertions} ThreadRepLkStepCheckOracleLB(
      rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, crv: CP.FCompiled,
      str: string, ov: LOr.OracleView, S: set<LG.GroupId>, lk: L.Lookaround, r1: L.Regex,
      tlk: LT.Tree, tc: LT.Tree, gm: LG.GroupMap, t: AI.Thread, l: int, cp: nat, clk: int,
      body: R.regex, la: R.lookaround, bodycode: RB.code, endl: nat, ngroups: nat,
      qt: AReg.Regs, ncap: int, nlook: int, nquant: int)
    requires qm.ov == ov && !rer.ignoreCase && !rer.multiline
    requires cp <= |str| && t.pc >= 0 && |ov| == |str| + 1
    requires l in qm.looks && qm.looks[l] == (lk, r1)
    requires L.Positivity(lk) && L.LkDir(lk) == WP.Backward
    requires LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).Some?
    requires EL.LkGateOk(rer, lk, r1, PIV.InpOfCp(str, cp), tlk, true)
    requires ThreadRepLk(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S,
                         LT.LK(lk, tlk, tc), gm, t, ncap, nlook, nquant)
    requires forall g :: g in L.DefGroups(r1) ==> g !in gm
    requires T.TransWf(body) && NR.LookFreeRE(body) && la.Lookbehind?
    requires NR.PlusFragmentRE(body) && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires SD.GroupOkL(T.Translate(body)) && CD.NoDupG(L.DefGroups(T.Translate(body)))
    requires r1 == T.Translate(body) && lk == T.TrLookaround(la) && body == M.VBody(crv, l)
    requires bodycode == CP.compile_to_bytecode(body)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires 0 <= l < nlook && l < RL.ASize(t.look_regs)
    requires 0 <= l < |crv.f_look_ast| && 0 <= l < |crv.f_look_cdns| && 0 <= l < |crv.f_look_types|
    requires crv.f_look_types[l].Lookbehind? && AI.capture_type(crv.f_look_types[l])
    requires NR.GetPcRE(code, t.pc as nat) == Some(RB.CheckOracle(l))
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re)
    requires S == LL.LkBodyGroups(T.Translate(re))
    requires (set g | g in L.DefGroups(r1)) <= S
    ensures var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
            var gm2 := LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).value;
            ThreadRepLk(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S, tc, gm2, t',
                        ncap, nlook, nquant)
  {
    var inp := PIV.InpOfCp(str, cp);
    var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    // (1) INSIDE tie: GateStepValueLB lifts GmtTieInside(t,gm) across the BACKWARD gate to (t',gm2).
    assert t' == t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    GateStepValueLB(rer, qm, re, code, crv, str, ov, S, lk, r1, tlk, LT.LK(lk, tlk, tc),
                    gm, t, t', l, cp, body, la, bodycode, endl, ngroups, qt, ncap, nlook, nquant);
    // (2) CONTINUATION walk (direction-generic): from the incoming ThreadRepLk's WalkPairLk.
    assert LL.OracleOkAt(rer, qm, inp);
    assert WalkPairLk(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed);
    WalkPairLkAtCheckOracle(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed, l);
    assert LT.LK(lk, tlk, tc).LK?;        // ⟹ bit true (wrapper: !bit ==> LKFail?)
    assert (t.pc + 1) as nat == (t.pc as nat) + 1 && t'.exit_allowed == t.exit_allowed;
    assert WalkPairLk(rer, qm, code, inp, tc, gm2, (t.pc + 1) as nat, t.exit_allowed);
    // (3) OUTSIDE frame (GmtTieOutsideAfterGate works for backward gates too).
    assert GmtTieOutside(re, t, gm, S);
    EL.TranslateNoLkBr(body);
    GmtTieOutsideAfterGate(rer, re, str, lk, r1, tlk, gm, t, l, cp, clk, S);
  }

  /** (L4 NESTED) clone of `ThreadRepLkStepCheckOracleLB` — GmtTieInside dropped. */
  lemma {:isolate_assertions} ThreadRepLkStepCheckOracleLBNested(
      rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, crv: CP.FCompiled,
      str: string, ov: LOr.OracleView, S: set<LG.GroupId>, lk: L.Lookaround, r1: L.Regex,
      tlk: LT.Tree, tc: LT.Tree, gm: LG.GroupMap, t: AI.Thread, l: int, cp: nat, clk: int,
      body: R.regex, la: R.lookaround, bodycode: RB.code, endl: nat, ngroups: nat,
      qt: AReg.Regs, ncap: int, nlook: int, nquant: int)
    requires qm.ov == ov && !rer.ignoreCase && !rer.multiline
    requires cp <= |str| && t.pc >= 0 && |ov| == |str| + 1
    requires l in qm.looks && qm.looks[l] == (lk, r1)
    requires L.Positivity(lk) && L.LkDir(lk) == WP.Backward
    requires LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).Some?
    requires EL.LkGateOk(rer, lk, r1, PIV.InpOfCp(str, cp), tlk, true)
    requires ThreadRepLkNested(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S,
                         LT.LK(lk, tlk, tc), gm, t, ncap, nlook, nquant)
    requires forall g :: g in L.DefGroups(r1) ==> g !in gm
    // (L4 NESTED) body-fragment weakened to the positive-nesting sub-fragment;
    // the GateStepValueLB backward-replay body package is DROPPED with the call.
    requires T.TransWf(body) && NR.NestedFragmentRE(body) && NR.NegLooksLookFreeRE(body) && la.Lookbehind?
    requires r1 == T.Translate(body) && lk == T.TrLookaround(la)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires 0 <= l < nlook && l < RL.ASize(t.look_regs)
    requires NR.GetPcRE(code, t.pc as nat) == Some(RB.CheckOracle(l))
    requires T.TransWf(re) && NR.NestedFragmentRE(re)
    requires S == LL.LkBodyGroups(T.Translate(re))
    requires (set g | g in L.DefGroups(r1)) <= S
    ensures var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
            var gm2 := LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).value;
            ThreadRepLkNested(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S, tc, gm2, t',
                        ncap, nlook, nquant)
  {
    var inp := PIV.InpOfCp(str, cp);
    var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    // (1) INSIDE tie DROPPED (GmtTieInside is not part of ThreadRepLkNested).
    assert t' == t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    // (2) CONTINUATION walk (direction-generic): from the incoming ThreadRepLk's WalkPairLk.
    assert LL.OracleOkAt(rer, qm, inp);
    assert WalkPairLk(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed);
    WalkPairLkAtCheckOracle(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed, l);
    assert LT.LK(lk, tlk, tc).LK?;        // ⟹ bit true (wrapper: !bit ==> LKFail?)
    assert (t.pc + 1) as nat == (t.pc as nat) + 1 && t'.exit_allowed == t.exit_allowed;
    assert WalkPairLk(rer, qm, code, inp, tc, gm2, (t.pc + 1) as nat, t.exit_allowed);
    // (3) OUTSIDE frame: recursive-body confinement (backward gate, PikeLkRegexRec(r1)).
    assert GmtTieOutside(re, t, gm, S);
    EL.TranslateFragmentPikeLkRec(body);  // PikeLkRegexRec(Translate(body)) == PikeLkRegexRec(r1)
    GmtTieOutsideAfterGateNested(rer, re, str, lk, r1, tlk, gm, t, l, cp, clk, S);
  }

  /** THE CRUX per-instruction core: a thread crossing a PASSING positive-lookahead
      gate (`CheckOracle(l)`, oracle TRUE). The VM records `a_cp[l]:=cp` (t → t');
      the paired B-subtree `LK(lk,tlk,tc)` MERGES `LkResult` into `tc` (gm → gm2).
      The inside-`S` value tie is exactly `GateStepValue` (proven) — this is where
      it plugs in, and the POSITION TIE is automatic (`cp` is both the VM's write
      and the gate's input position). The continuation walk `WalkPairLk(tc,gm2,…)`
      (from the `TtLkAtCheckOracle` inversion + `GateAheadClearAfterMerge`) and the
      outside-`S` frame `GmtTieOutside(t',gm2)` (from `LkResultAgreeOutside` + look-
      register framing) are `requires` — the mechanical parts the caller supplies.
      `GateStepValue`'s static look-table package is threaded verbatim. */
  lemma ThreadRepLkStepCheckOracle(
      rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, crv: CP.FCompiled,
      str: string, ov: LOr.OracleView, S: set<LG.GroupId>, lk: L.Lookaround, r1: L.Regex,
      tlk: LT.Tree, tc: LT.Tree, gm: LG.GroupMap, t: AI.Thread, l: int, cp: nat, clk: int,
      body: R.regex, la: R.lookaround, bodycode: RB.code, endl: nat, ngroups: nat,
      qt: AReg.Regs, ncap: int, nlook: int, nquant: int)
    requires qm.ov == ov && !rer.ignoreCase && !rer.multiline
    requires cp <= |str| && t.pc >= 0
    requires l in qm.looks && qm.looks[l] == (lk, r1)
    requires L.Positivity(lk) && L.LkDir(lk) == WP.Forward
    requires LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).Some?
    requires EL.LkGateOk(rer, lk, r1, PIV.InpOfCp(str, cp), tlk, true)
    // the paired B-subtree at t.pc is the LK gate node (from TtLkAtCheckOracle):
    requires ThreadRepLk(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S,
                         LT.LK(lk, tlk, tc), gm, t, ncap, nlook, nquant)
    requires forall g :: g in L.DefGroups(r1) ==> g !in gm        // GateAheadClear at this gate
    requires T.TransWf(body) && NR.LookFreeRE(body) && la.Lookahead?
    requires r1 == T.Translate(body) && lk == T.TrLookaround(la) && body == M.VBody(crv, l)
    requires bodycode == CP.compile_to_bytecode(body)
    requires PSM.StaticOkRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires |qt.a_cp| == nquant && |qt.a_clk| == nquant
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires 0 <= l < nlook && l < RL.ASize(t.look_regs)
    requires 0 <= l < |crv.f_look_ast| && 0 <= l < |crv.f_look_cdns| && 0 <= l < |crv.f_look_types|
    requires crv.f_look_types[l].Lookahead? && AI.capture_type(crv.f_look_types[l])
    // gate position + outside-frame well-formedness (caller supplies); the
    // continuation walk and outside frame are now DERIVED in the body.
    requires NR.GetPcRE(code, t.pc as nat) == Some(RB.CheckOracle(l))
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re)
    requires S == LL.LkBodyGroups(T.Translate(re))
    requires (set g | g in L.DefGroups(r1)) <= S
    ensures var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
            var gm2 := LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).value;
            ThreadRepLk(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S, tc, gm2, t',
                        ncap, nlook, nquant)
  {
    var inp := PIV.InpOfCp(str, cp);
    var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    // (1) INSIDE tie: GateStepValue lifts GmtTieInside(t,gm) across the gate to (t',gm2).
    assert t' == t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    GateStepValue(rer, qm, re, code, crv, str, ov, S, lk, r1, tlk, LT.LK(lk, tlk, tc),
                  gm, t, t', l, cp, body, la, bodycode, endl, ngroups, qt, ncap, nlook, nquant);
    // (2) CONTINUATION walk: from the incoming ThreadRepLk's WalkPairLk on the LK head.
    assert LL.OracleOkAt(rer, qm, inp);   // OracleOkSuffix instantiated at inp
    assert WalkPairLk(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed);
    WalkPairLkAtCheckOracle(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed, l);
    assert LT.LK(lk, tlk, tc).LK?;        // ⟹ bit true (wrapper: !bit ==> LKFail?)
    assert (t.pc + 1) as nat == (t.pc as nat) + 1 && t'.exit_allowed == t.exit_allowed;
    assert WalkPairLk(rer, qm, code, inp, tc, gm2, (t.pc + 1) as nat, t.exit_allowed);
    // (3) OUTSIDE frame.
    assert GmtTieOutside(re, t, gm, S);   // from the incoming ThreadRepLk(LK, gm, t)
    EL.TranslateNoLkBr(body);             // NoLkBrL(r1)  (r1 == Translate(body))
    GmtTieOutsideAfterGate(rer, re, str, lk, r1, tlk, gm, t, l, cp, clk, S);   // GmtTieOutside(t',gm2,S)
    // ThreadRepLk(tc,gm2,t') = t'.pc>=0 && WalkPairLk (2) && GmtTieOutside (3) && GmtTieInside (1).
  }

  /** (L4 NESTED) clone of `ThreadRepLkStepCheckOracle` — GmtTieInside dropped. */
  lemma ThreadRepLkStepCheckOracleNested(
      rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, crv: CP.FCompiled,
      str: string, ov: LOr.OracleView, S: set<LG.GroupId>, lk: L.Lookaround, r1: L.Regex,
      tlk: LT.Tree, tc: LT.Tree, gm: LG.GroupMap, t: AI.Thread, l: int, cp: nat, clk: int,
      body: R.regex, la: R.lookaround, bodycode: RB.code, endl: nat, ngroups: nat,
      qt: AReg.Regs, ncap: int, nlook: int, nquant: int)
    requires qm.ov == ov && !rer.ignoreCase && !rer.multiline
    requires cp <= |str| && t.pc >= 0
    requires l in qm.looks && qm.looks[l] == (lk, r1)
    requires L.Positivity(lk) && L.LkDir(lk) == WP.Forward
    requires LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).Some?
    requires EL.LkGateOk(rer, lk, r1, PIV.InpOfCp(str, cp), tlk, true)
    // the paired B-subtree at t.pc is the LK gate node (from TtLkAtCheckOracle):
    requires ThreadRepLkNested(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S,
                         LT.LK(lk, tlk, tc), gm, t, ncap, nlook, nquant)
    requires forall g :: g in L.DefGroups(r1) ==> g !in gm        // GateAheadClear at this gate
    // (L4 NESTED) the body may itself contain looks: the depth-1 LookFreeRE(body)
    // is replaced by the positive-nesting sub-fragment (feeds PikeLkRegexRec(r1)
    // for the recursive outside-tie); the GateStepValue body-package requires
    // (StaticOkRE(body)/bodycode/qt/f_look_* rows) are DROPPED with the call.
    requires T.TransWf(body) && NR.NestedFragmentRE(body) && NR.NegLooksLookFreeRE(body) && la.Lookahead?
    requires r1 == T.Translate(body) && lk == T.TrLookaround(la)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires 0 <= l < nlook && l < RL.ASize(t.look_regs)
    // gate position + outside-frame well-formedness (caller supplies); the
    // continuation walk and outside frame are now DERIVED in the body.
    requires NR.GetPcRE(code, t.pc as nat) == Some(RB.CheckOracle(l))
    requires T.TransWf(re) && NR.NestedFragmentRE(re)
    requires S == LL.LkBodyGroups(T.Translate(re))
    requires (set g | g in L.DefGroups(r1)) <= S
    ensures var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
            var gm2 := LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).value;
            ThreadRepLkNested(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S, tc, gm2, t',
                        ncap, nlook, nquant)
  {
    var inp := PIV.InpOfCp(str, cp);
    var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    // (1) INSIDE tie DROPPED (GmtTieInside is not part of ThreadRepLkNested).
    assert t' == t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    // (2) CONTINUATION walk: from the incoming ThreadRepLk's WalkPairLk on the LK head.
    assert LL.OracleOkAt(rer, qm, inp);   // OracleOkSuffix instantiated at inp
    assert WalkPairLk(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed);
    WalkPairLkAtCheckOracle(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed, l);
    assert LT.LK(lk, tlk, tc).LK?;        // ⟹ bit true (wrapper: !bit ==> LKFail?)
    assert (t.pc + 1) as nat == (t.pc as nat) + 1 && t'.exit_allowed == t.exit_allowed;
    assert WalkPairLk(rer, qm, code, inp, tc, gm2, (t.pc + 1) as nat, t.exit_allowed);
    // (3) OUTSIDE frame: recursive-body confinement (PikeLkRegexRec(r1)).
    assert GmtTieOutside(re, t, gm, S);   // from the incoming ThreadRepLkNested(LK, gm, t)
    EL.TranslateFragmentPikeLkRec(body);  // PikeLkRegexRec(Translate(body)) == PikeLkRegexRec(r1)
    GmtTieOutsideAfterGateNested(rer, re, str, lk, r1, tlk, gm, t, l, cp, clk, S);   // GmtTieOutside(t',gm2,S)
  }

  /** Fueled core of `TtLkAtAccept`: at an `Accept` pc every `ActionsRepL` head
      is transparent (Epsilon / a spent `{0}` quantifier / a Sequence of those),
      so `BoolTreeLk` peels — expanding Sequences — down to the empty stack,
      whose tree is `Match`. Every consuming/branching head pins a non-`Accept`
      instruction. `decreases MsizeA(acts)` (Sequence expansion still shrinks it).*/
  lemma TtLkAtAcceptCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Accept)
    ensures tb == LT.Match
    decreases ATR.MsizeA(acts)
  {
    if |acts| == 0 {
      // BoolTreeLk([], inp, b, tb) ⟹ tb == Match
    } else if exists pcmid: nat :: AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid) {
      var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
      EL.PikeLkActionsTail(acts);
      assert acts == [acts[0]] + acts[1..];
      EL.PikeLkActionsConsIff(acts[0], acts[1..]);
      var cont := acts[1..];
      match acts[0]
      case Acheck(_) =>   // pins EndLoop or a backward Fork — not Accept
      case Aclose(_) =>   // pins SetRegisterToCP — not Accept
      case Areg(r) =>
        assert EL.PikeLkRegex(r);
        match r
        case Epsilon =>
          assert pcmid == pc;
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtAcceptCore(rer, qm, code, inp, tb, pc, b, cont);
        case Sequence(r1, r2) =>
          assert acts[0] == LS.Areg(L.Sequence(r1, r2));
          assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);   // == ActionRepL(acts[0],..)
          var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
          var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
          assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
          AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
          AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
          assert AR.ActionsRepL(rer, qm, na, code, pc);
          assert EL.PikeLkActions(na) by {
            EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
            EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
          }
          assert EL.BoolTreeLk(rer, na, inp, b, tb);
          assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
          assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
          assert ATR.MsizeA(na) < ATR.MsizeA(acts);
          TtLkAtAcceptCore(rer, qm, code, inp, tb, pc, b, na);
        case Quantified(greedy, min, delta, r1) =>
          // At an Accept pc the only transparent quantifier is a spent {0}
          // (min==0, delta==NN(0)); every other shape pins Fork/SetQuantToClock.
          if min == 0 && delta == LN.NN(0) {
            assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
            assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
            var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                         && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);              // em == pc
            NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);   // pcmid == em
            assert pcmid == pc;
            assert AR.ActionsRepL(rer, qm, cont, code, pc);
            assert EL.BoolTreeLk(rer, cont, inp, b, tb);   // Quantified NN(0) skip case
            assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
            TtLkAtAcceptCore(rer, qm, code, inp, tb, pc, b, cont);
          } else {
            QuantHeadPinsNonAccept(rer, qm, greedy, min, delta, r1, code, pc, pcmid);   // ⇒ false
          }
        case Character(_) =>   // pins Consume — not Accept
        case Disjunction(_, _) =>   // pins Fork — not Accept
        case Group(_, _) =>   // pins SetRegisterToCP — not Accept
        case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Accept
        case AnchorR(_) =>   // pins AnchorAssertion — not Accept
        case Backreference(_) =>   // NfaRepL false
    } else {
      var pcstart: nat :| NR.GetPcRE(code, pc) == Some(RB.Jmp(pcstart)) && AR.ActionsRepL(rer, qm, acts, code, pcstart);
      // Jmp != Accept: contradiction
    }
  }

  /** RegexSize re-exported (avoids importing Semantics' unqualified name here). */
  function RegSz(r: L.Regex): nat { LS.RegexSize(r) }

  /** A non-spent quantifier head pins a `Fork`/`SetQuantToClock`, never `Accept`. */
  lemma QuantHeadPinsNonAccept(rer: LW.RegExpRecord, qm: AR.QMap, greedy: bool, min: nat, delta: LN.NoI,
                               r1: L.Regex, code: RB.code, pc: nat, pcmid: nat)
    requires AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid)
    requires !(min == 0 && delta == LN.NN(0))
    requires NR.GetPcRE(code, pc) == Some(RB.Accept)
    ensures false
  {
    if min == 0 && delta == LN.Inf {
      if exists e1: nat ::
           NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
           && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                  && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
           && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
           && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
           && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
           && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
           && pcmid == e1 + 2 {
        var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
      } else {
        var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
      }
    } else {
      match delta
      case Inf =>
        var em: nat, e1: nat :|
          AR.NfaRepMinL(rer, qm, min - 1, r1, code, pc, em)
          && (exists qid: int :: NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                                 && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
          && AR.NfaRepL(rer, qm, r1, code, em + 1, e1)
          && NR.GetPcRE(code, e1) == Some(if greedy then RB.Fork(em, e1 + 1) else RB.Fork(e1 + 1, em))
          && pcmid == e1 + 1;
        NfaRepMinLHeadPin(rer, qm, min - 1, r1, code, pc, em);
      case NN(kx) =>
        var em: nat :| AR.NfaRepMinL(rer, qm, min, r1, code, pc, em)
                     && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
        NfaRepMinLHeadPin(rer, qm, min, r1, code, pc, em);
        if min == 0 {
          assert em == pc;
          NfaRepOptLHeadPin(rer, qm, kx, greedy, r1, code, em, pcmid);   // kx>0 ⇒ Fork; kx==0 excluded
        }
    }
  }

  /** [SOLID] At Accept the walk is exhausted: the tree is `Match`. */
  lemma TtLkAtAccept(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                     tb: LT.Tree, pc: nat, ea: bool)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Accept)
    ensures tb == LT.Match
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtAcceptCore(rer, qm, code, inp, tb, pc, b, acts);
  }

  /** Fueled core of `TtLkAtConsume` (the RELOCATING template): peel the
      transparent prefix (carrying `WalkOk` via its destructors), reach the
      `Character` head — the only one whose `NfaRepL` pins `Consume` — then
      `BoolTreeLk` reads off `Read`/`Mismatch` and the continuation `TtLk` walks
      from `pc+1` at the advanced input with the flag re-armed to `CanExit`. */
  lemma TtLkAtConsumeCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, ce: RC.char_expectation)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    ensures tb.Read? || tb == LT.Mismatch
    ensures tb.Read? ==> exists nextinp ::
      AR.ReadCharE(ce, inp) == Some((tb.c, nextinp))
      && TtLk(rer, qm, code, nextinp, tb.t, pc + 1, true)
    ensures tb == LT.Mismatch ==> AR.ReadCharE(ce, inp) == None
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    // empty_bc needs Accept, jump_bc needs Jmp — neither is Consume, so cons_bc.
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not Consume
    case Aclose(_) =>   // pins SetRegisterToCP — not Consume
    case Areg(r) =>
      assert EL.PikeLkRegex(r);
      match r
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtConsumeCore(rer, qm, code, inp, tb, pc, b, cont, ce);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtConsumeCore(rer, qm, code, inp, tb, pc, b, na, ce);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtConsumeCore(rer, qm, code, inp, tb, pc, b, cont, ce);
        } else {
          QuantHeadPinsNonConsume(rer, qm, greedy, min, delta, r1, code, pc, pcmid, ce);
        }
      case Character(cd) =>
        assert acts[0] == LS.Areg(L.Character(cd));
        var ce2 :| NR.GetPcRE(code, pc) == Some(RB.Consume(ce2)) && AR.ExpectationMatches(rer, ce2, cd);
        assert ce2 == ce && pcmid == pc + 1;
        AR.ReadAgree(rer, ce, cd, inp);   // ReadCharE(ce, inp) == ReadChar(rer, cd, inp, Forward)
        match LC.ReadChar(rer, cd, inp, WP.Forward) {
          case None =>
            assert tb == LT.Mismatch;
          case Some(pair) =>
            assert tb.Read? && tb.c == pair.0 && EL.BoolTreeLk(rer, cont, pair.1, BS.CanExit, tb.t);
            assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
            assert TtLk(rer, qm, code, pair.1, tb.t, pc + 1, true) by {
              assert ATR.EaOf(BS.CanExit) == true;
            }
            assert AR.ReadCharE(ce, inp) == Some((tb.c, pair.1));
        }
      case Disjunction(_, _) =>   // pins Fork — not Consume
      case Group(_, _) =>   // pins SetRegisterToCP — not Consume
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Consume
      case AnchorR(_) =>   // pins AnchorAssertion — not Consume
      case Backreference(_) =>   // NfaRepL false
  }

  /** A non-spent quantifier head pins `Fork`/`SetQuantToClock`, never `Consume`. */
  lemma QuantHeadPinsNonConsume(rer: LW.RegExpRecord, qm: AR.QMap, greedy: bool, min: nat, delta: LN.NoI,
                                r1: L.Regex, code: RB.code, pc: nat, pcmid: nat, ce: RC.char_expectation)
    requires AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid)
    requires !(min == 0 && delta == LN.NN(0))
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    ensures false
  {
    if min == 0 && delta == LN.Inf {
      if exists e1: nat ::
           NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
           && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                  && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
           && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
           && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
           && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
           && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
           && pcmid == e1 + 2 {
        var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
      } else {
        var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
      }
    } else {
      match delta
      case Inf =>
        var em: nat, e1: nat :|
          AR.NfaRepMinL(rer, qm, min - 1, r1, code, pc, em)
          && (exists qid: int :: NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                                 && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
          && AR.NfaRepL(rer, qm, r1, code, em + 1, e1)
          && NR.GetPcRE(code, e1) == Some(if greedy then RB.Fork(em, e1 + 1) else RB.Fork(e1 + 1, em))
          && pcmid == e1 + 1;
        NfaRepMinLHeadPin(rer, qm, min - 1, r1, code, pc, em);
      case NN(kx) =>
        var em: nat :| AR.NfaRepMinL(rer, qm, min, r1, code, pc, em)
                     && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
        NfaRepMinLHeadPin(rer, qm, min, r1, code, pc, em);
        if min == 0 {
          assert em == pc;
          NfaRepOptLHeadPin(rer, qm, kx, greedy, r1, code, em, pcmid);
        }
    }
  }

  /** [SOLID] At Consume the tree is a `Read` (char accepted, post-Read walk at
      `pc+1` on the advanced input with the flag re-armed) or `Mismatch`. */
  lemma TtLkAtConsume(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                      tb: LT.Tree, pc: nat, ea: bool, ce: RC.char_expectation)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    ensures tb.Read? || tb == LT.Mismatch
    ensures tb.Read? ==> exists nextinp ::
      AR.ReadCharE(ce, inp) == Some((tb.c, nextinp))
      && TtLk(rer, qm, code, nextinp, tb.t, pc + 1, true)
    ensures tb == LT.Mismatch ==> AR.ReadCharE(ce, inp) == None
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtConsumeCore(rer, qm, code, inp, tb, pc, b, acts, ce);
  }

  /** GENERAL: a non-spent quantifier head always pins a `Fork` or a
      `SetQuantToClock` at `pc` — the one fact every peel-with-expansion
      inversion needs to dismiss the quantifier head at a non-Fork/SQC pc. */
  lemma QuantHeadPinsForkOrSQC(rer: LW.RegExpRecord, qm: AR.QMap, greedy: bool, min: nat, delta: LN.NoI,
                               r1: L.Regex, code: RB.code, pc: nat, pcmid: nat)
    requires AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid)
    requires !(min == 0 && delta == LN.NN(0))
    ensures NR.GetPcRE(code, pc).Some?
            && (NR.GetPcRE(code, pc).value.Fork? || NR.GetPcRE(code, pc).value.SetQuantToClock?)
  {
    if min == 0 && delta == LN.Inf {
      if exists e1: nat ::
           NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
           && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                  && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
           && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
           && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
           && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
           && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
           && pcmid == e1 + 2 {
        var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
      } else {
        var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
      }
    } else {
      match delta
      case Inf =>
        var em: nat, e1: nat :|
          AR.NfaRepMinL(rer, qm, min - 1, r1, code, pc, em)
          && (exists qid: int :: NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                                 && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
          && AR.NfaRepL(rer, qm, r1, code, em + 1, e1)
          && NR.GetPcRE(code, e1) == Some(if greedy then RB.Fork(em, e1 + 1) else RB.Fork(e1 + 1, em))
          && pcmid == e1 + 1;
        NfaRepMinLHeadPin(rer, qm, min - 1, r1, code, pc, em);
        if min - 1 == 0 {
          assert em == pc;
          var qid: int :| NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false));
        }
      case NN(kx) =>
        var em: nat :| AR.NfaRepMinL(rer, qm, min, r1, code, pc, em)
                     && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
        NfaRepMinLHeadPin(rer, qm, min, r1, code, pc, em);
        if min == 0 {
          assert em == pc;
          NfaRepOptLHeadPin(rer, qm, kx, greedy, r1, code, em, pcmid);
        }
    }
  }

  /** Fueled core of `TtLkAtSetReg`: peel the transparent prefix; the real head
      is either an `Aclose(gid)` (a `Close`) or a `Group(gid, r1)` (an `Open`),
      each pinning `SetRegisterToCP` by register parity. */
  lemma TtLkAtSetRegCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, r: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(r))
    ensures tb.GroupActionT?
    ensures (tb.g.Open? && r == CP.start_reg(tb.g.g as int))
         || (tb.g.Close? && r == CP.end_reg(tb.g.g as int))
    ensures TtLk(rer, qm, code, inp, tb.t, pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not SetRegisterToCP
    case Aclose(gid) =>
      // ActionRepL(Aclose(gid)) pins SetRegisterToCP(end_reg(gid)), pcmid == pc+1
      assert pcmid == pc + 1 && r == CP.end_reg(gid as int);
      assert tb.GroupActionT? && tb.g == LG.Close(gid) && EL.BoolTreeLk(rer, cont, inp, b, tb.t);
      assert TtLk(rer, qm, code, inp, tb.t, pc + 1, g);
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtSetRegCore(rer, qm, code, inp, tb, pc, b, cont, r);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtSetRegCore(rer, qm, code, inp, tb, pc, b, na, r);
      case Group(gid, r1) =>
        // ActionRepL(Areg(Group)) pins SetRegisterToCP(start_reg(gid))
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(gid as int)))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(gid as int)))
          && pcmid == e1 + 1;
        assert r == CP.start_reg(gid as int);
        var ga := [LS.Areg(r1), LS.Aclose(gid)] + cont;
        assert ga == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Aclose(gid), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Aclose(gid)] + cont, code, pc + 1, e1);
        assert AR.ActionsRepL(rer, qm, ga, code, pc + 1);
        assert tb.GroupActionT? && tb.g == LG.Open(gid) && EL.BoolTreeLk(rer, ga, inp, b, tb.t);
        assert EL.PikeLkActions(ga) by {
          EL.PikeLkActionsConsIff(LS.Aclose(gid), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Aclose(gid)] + cont);
        }
        assert TtLk(rer, qm, code, inp, tb.t, pc + 1, g);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtSetRegCore(rer, qm, code, inp, tb, pc, b, cont, r);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);   // Fork/SQC ≠ SetReg
        }
      case Character(_) =>   // pins Consume — not SetRegisterToCP
      case Disjunction(_, _) =>   // pins Fork — not SetRegisterToCP
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not SetRegisterToCP
      case AnchorR(_) =>   // pins AnchorAssertion — not SetRegisterToCP
      case Backreference(_) =>   // NfaRepL false
  }

  /** [SOLID] At SetRegisterToCP the tree is a `GroupActionT` whose action is
      `Open`/`Close` by register parity (mirror of tr_open/tr_close). */
  lemma TtLkAtSetReg(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                     tb: LT.Tree, pc: nat, ea: bool, r: int)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(r))
    ensures tb.GroupActionT?
    ensures (tb.g.Open? && r == CP.start_reg(tb.g.g as int))
         || (tb.g.Close? && r == CP.end_reg(tb.g.g as int))
    ensures TtLk(rer, qm, code, inp, tb.t, pc + 1, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtSetRegCore(rer, qm, code, inp, tb, pc, b, acts, r);
  }

  /** THE forced-copy continuation builder: a `min>0` quantifier head crossing
      its first `SetQuantToClock` at `pc` unfolds to `r1` then
      `Quantified(min-1, delta)` — so the walk continuation
      `[Areg(r1), Areg(Quantified(greedy, min-1, delta, r1))] + cont` is
      represented at `pc+1`. NN via `NfaRepLQuantInv`+`Intro`; Inf via
      `NfaRepLPlusInv` (min==1 rebuilds the star's loop-view by hand, min>1 via
      `NfaRepLPlusIntro`). This is the piece the do-while seam blocked while
      `WalkOk` was in `TtLk`; with `WalkOk` gone (no Acheck-mismatch), it closes. */
  lemma QuantForcedContRep(rer: LW.RegExpRecord, qm: AR.QMap, greedy: bool, min: nat, delta: LN.NoI,
                           r1: L.Regex, code: RB.code, pc: nat, pcmid: nat, cont: LS.Actions)
    requires min > 0
    requires AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid)
    requires AR.ActionsRepL(rer, qm, cont, code, pcmid)
    ensures AR.ActionsRepL(rer, qm,
              [LS.Areg(r1), LS.Areg(L.Quantified(greedy, min - 1, delta, r1))] + cont, code, pc + 1)
  {
    match delta
    case NN(kx) =>
      var quant1 := L.Quantified(greedy, min - 1, LN.NN(kx), r1);
      var em := AR.NfaRepLQuantInv(rer, qm, greedy, min, kx, r1, code, pc, pcmid);
      var e_body: nat :|
        (exists qid: int :: NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                            && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
        && AR.NfaRepL(rer, qm, r1, code, pc + 1, e_body)
        && AR.NfaRepMinL(rer, qm, min - 1, r1, code, e_body, em);
      AR.NfaRepLQuantIntro(rer, qm, greedy, min - 1, kx, r1, code, e_body, em, pcmid);
      AR.ActionsRepLCons(rer, qm, LS.Areg(quant1), cont, code, e_body, pcmid);
      assert [LS.Areg(r1), LS.Areg(quant1)] + cont == [LS.Areg(r1)] + ([LS.Areg(quant1)] + cont);
      AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(quant1)] + cont, code, pc + 1, e_body);
    case Inf =>
      var quant1 := L.Quantified(greedy, min - 1, LN.Inf, r1);
      var em, e1 := AR.NfaRepLPlusInv(rer, qm, greedy, min, r1, code, pc, pcmid);
      var qid_em: int :| NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid_em, false))
                       && qid_em in qm.quants && qm.quants[qid_em] == L.DefGroups(r1);
      if min == 1 {
        NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);   // em == pc
        assert em == pc;
        // quant1 == Quantified(greedy, 0, Inf, r1) == the star; build its loop-view NfaRepL at e1.
        AR.NfaRepIncrL(rer, qm, r1, code, pc + 1, e1);   // pc + 1 <= e1, so pc <= e1
        assert pc <= e1;
        assert AR.NfaRepL(rer, qm, quant1, code, e1, e1 + 1) by {
          assert NUL.NonNullableL(r1);
          assert NR.GetPcRE(code, e1) == Some(if greedy then RB.Fork(pc, e1 + 1) else RB.Fork(e1 + 1, pc));
          assert NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid_em, false))
                 && qid_em in qm.quants && qm.quants[qid_em] == L.DefGroups(r1);   // em == pc
          assert AR.NfaRepL(rer, qm, r1, code, pc + 1, e1);
          // the loop-view disjunct holds with witness em2 == pc
          assert NR.GetPcRE(code, e1) == Some(if greedy then RB.Fork(pc, e1 + 1) else RB.Fork(e1 + 1, pc))
            && pc <= e1
            && (exists qid: int :: NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                                   && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
            && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
            && e1 + 1 == e1 + 1;
        }
        AR.ActionsRepLCons(rer, qm, LS.Areg(quant1), cont, code, e1, pcmid);
        assert [LS.Areg(r1), LS.Areg(quant1)] + cont == [LS.Areg(r1)] + ([LS.Areg(quant1)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(quant1)] + cont, code, pc + 1, e1);
      } else {
        var e_body: nat :|
          (exists qid: int :: NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                              && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e_body)
          && AR.NfaRepMinL(rer, qm, min - 2, r1, code, e_body, em);
        AR.NfaRepLPlusIntro(rer, qm, greedy, min - 1, r1, code, e_body, em, e1, pcmid, qid_em);
        AR.ActionsRepLCons(rer, qm, LS.Areg(quant1), cont, code, e_body, pcmid);
        assert [LS.Areg(r1), LS.Areg(quant1)] + cont == [LS.Areg(r1)] + ([LS.Areg(quant1)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(quant1)] + cont, code, pc + 1, e_body);
      }
  }

  /** The forced-copy head's `qm.quants` binding: a `min>0` quantifier block
      opens with `SetQuantToClock(qid, false)` whose `qid` the tables map to
      exactly `DefGroups(r1)` — extracted from the same `NfaRepL` inversions
      `QuantForcedContRep` uses, without building the continuation. */
  lemma QuantHeadSQCPin(rer: LW.RegExpRecord, qm: AR.QMap, greedy: bool, min: nat, delta: LN.NoI,
                        r1: L.Regex, code: RB.code, pc: nat, pcmid: nat)
    requires min > 0
    requires AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid)
    ensures exists qid: int ::
      NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
      && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1)
  {
    match delta
    case NN(kx) =>
      var em := AR.NfaRepLQuantInv(rer, qm, greedy, min, kx, r1, code, pc, pcmid);
      var e_body: nat :|
        (exists qid: int :: NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                            && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
        && AR.NfaRepL(rer, qm, r1, code, pc + 1, e_body)
        && AR.NfaRepMinL(rer, qm, min - 1, r1, code, e_body, em);
    case Inf =>
      var em, e1 := AR.NfaRepLPlusInv(rer, qm, greedy, min, r1, code, pc, pcmid);
      if min == 1 {
        NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
        assert em == pc;
        var qid_em: int :| NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid_em, false))
                         && qid_em in qm.quants && qm.quants[qid_em] == L.DefGroups(r1);
      } else {
        var e_body: nat :|
          (exists qid: int :: NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                              && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e_body)
          && AR.NfaRepMinL(rer, qm, min - 2, r1, code, e_body, em);
      }
  }

  /** Fueled `WalkPairLk` core at a `SetQuantToClock(q, false)` pc — the
      FORCED-COPY (min>0) route: the real head emits the `Reset` stamp
      (payload pinned to `qm.quants[q]` by `QuantHeadSQCPin`), the continuation
      `[Areg r1, Areg(Quantified(min-1))] + cont` is represented at `pc+1`
      (`QuantForcedContRep`) and walks at the RESET-updated map:
      `GateAheadClear` re-established BY the Reset (r1's pending bodies ⊆ the
      reset set; cont's pendings survive the domain shrink), `WalkDefsOk` by
      the unfold brick (`WalkDefsOkUnfold`, mid = []). */
  lemma WalkPairLkAtSetQuantCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                 tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                 acts: LS.Actions, q: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures q in qm.quants
    ensures tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
    ensures WalkPairLk(rer, qm, code, inp, tb.t,
                       LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not SetQuantToClock
    case Aclose(_) =>   // pins SetRegisterToCP — not SetQuantToClock
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtSetQuantCore(rer, qm, code, inp, tb, gm, pc, b, cont, q);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtSetQuantCore(rer, qm, code, inp, tb, gm, pc, b, na, q);
      case Quantified(greedy, min, delta, r1) =>
        assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
        assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
        if min > 0 {
          // THE forced-copy real head.
          var quant1 := L.Quantified(greedy, min - 1, delta, r1);
          var contActs := [LS.Areg(r1), LS.Areg(quant1)] + cont;
          var gidl := L.DefGroups(r1);
          assert tb.GroupActionT? && tb.g == LG.Reset(gidl)
                 && EL.BoolTreeLk(rer, contActs, inp, b, tb.t);
          // the qm.quants binding of THIS instruction's qid
          QuantHeadSQCPin(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
          var qid: int :| NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
            && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1);
          assert qid == q;
          assert q in qm.quants && qm.quants[q] == gidl;
          QuantForcedContRep(rer, qm, greedy, min, delta, r1, code, pc, pcmid, cont);   // ActionsRepL(contActs, pc+1)
          assert EL.PikeLkRegex(r1) && EL.PikeLkRegex(quant1);
          assert EL.PikeLkActions(contActs) by {
            EL.PikeLkActionsConsIff(LS.Areg(quant1), cont);
            EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(quant1)] + cont);
          }
          // gm moves by the Reset
          var gm2 := LG.GMUpdate(LG.Reset(gidl), LC.Idx(inp), gm);
          assert gm2 == LG.GMReset(gidl, gm);
          // GateAheadClear(contActs, gm2): fresh r1-pendings ⊆ the reset set;
          // cont's pendings carry (absent in gm, and Reset only removes keys)
          assert GateAheadClear(contActs, gm2) by {
            forall lk2: L.Lookaround, rr: L.Regex | GatePending(contActs, lk2, rr)
              ensures forall gg :: gg in L.DefGroups(rr) ==> gg !in gm2
            {
              var j :| 0 <= j < |contActs| && contActs[j].Areg? && RegexTopGate(contActs[j].r, lk2, rr);
              if j == 0 {
                assert contActs[0] == LS.Areg(r1) && RegexTopGate(r1, lk2, rr);
                RegexTopGateSubDefs(r1, lk2, rr);
                var SRR := set gx | gx in L.DefGroups(rr);
                var SR1 := set gx | gx in L.DefGroups(r1);
                assert SRR <= SR1;
                forall gg | gg in L.DefGroups(rr) ensures gg !in gm2 {
                  assert gg in SRR;
                  assert gg in SR1;
                  assert gg in L.DefGroups(r1);
                  assert gm2 == gm - (set gx | gx in gidl);
                  assert gg in (set gx | gx in gidl);
                }
              } else if j == 1 {
                assert !RegexTopGate(quant1, lk2, rr);   // Quantified: never pending
                assert false;
              } else {
                assert contActs[j] == cont[j - 2];
                assert GatePending(cont, lk2, rr) by {
                  assert cont[j - 2].Areg? && RegexTopGate(cont[j - 2].r, lk2, rr);
                }
                GatePendingTail(acts, lk2, rr);
                forall gg | gg in L.DefGroups(rr) ensures gg !in gm2 {
                  assert gg !in gm;   // GateAheadClear(acts, gm)
                }
              }
            }
          }
          // WalkDefsOk(contActs): the unfold brick (mid = [])
          WalkDefsOkUnfold(acts, r1, quant1, []);
          assert [LS.Areg(r1)] + [] + [LS.Areg(quant1)] + cont == contActs;
          // pack the existential at pc+1
          assert AR.ActionsRepL(rer, qm, contActs, code, pc + 1)
              && EL.PikeLkActions(contActs)
              && ATR.EaOf(b) == g
              && EL.BoolTreeLk(rer, contActs, inp, b, tb.t)
              && GateAheadClear(contActs, gm2)
              && WalkDefsOk(contActs);
          assert WalkPairLk(rer, qm, code, inp, tb.t, gm2, pc + 1, g);
        } else if delta == LN.NN(0) {
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtSetQuantCore(rer, qm, code, inp, tb, gm, pc, b, cont, q);
        } else {
          // min==0 with Inf or NN(kx>0): pins a Fork at pc, not SetQuantToClock.
          match delta
          case Inf =>
            if exists e1: nat ::
                 NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                 && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                        && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                 && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                 && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                 && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                 && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                 && pcmid == e1 + 2 {
              var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
            } else {
              var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
            }
          case NN(kx) =>
            var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                         && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
            NfaRepOptLHeadPin(rer, qm, kx, greedy, r1, code, em, pcmid);   // kx>0 ⇒ Fork at pc
        }
      case Character(_) =>   // pins Consume — not SetQuantToClock
      case Disjunction(_, _) =>   // pins Fork — not SetQuantToClock
      case Group(_, _) =>   // pins SetRegisterToCP — not SetQuantToClock
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not SetQuantToClock
      case AnchorR(_) =>   // pins AnchorAssertion — not SetQuantToClock
      case Backreference(_) =>   // NfaRepL false
  }

  /** WalkPairLk→WalkPairLk wrapper at a `SetQuantToClock(q, false)`: EITHER
      the walk's actions route (forced-copy head — the Core) OR the SQC
      see-through disjunct (star/backfork iteration arm) — both yield the
      `Reset` head and the child walking at the RESET-updated map. */
  lemma WalkPairLkAtSetQuant(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, q: int)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
    ensures q in qm.quants
    ensures tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
    ensures WalkPairLk(rer, qm, code, inp, tb.t,
                       LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea)
  {
    if (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActions(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb)
          && GateAheadClear(acts, gm)
          && WalkDefsOk(acts)) {
      var acts: LS.Actions, b: BS.LoopBool :|
        AR.ActionsRepL(rer, qm, acts, code, pc)
        && EL.PikeLkActions(acts)
        && ATR.EaOf(b) == ea
        && EL.BoolTreeLk(rer, acts, inp, b, tb)
        && GateAheadClear(acts, gm)
        && WalkDefsOk(acts);
      WalkPairLkAtSetQuantCore(rer, qm, code, inp, tb, gm, pc, b, acts, q);
    } else {
      // the SQC see-through disjunct is the live one
      var q0: int :| NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q0, false))
        && q0 in qm.quants
        && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q0])
        && WalkPairLk(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea);
      assert q0 == q;
    }
  }

  /** THE ONE OUTSTANDING WALK FACT (the do-while flag shield): a
      NonNullable-headed iteration list's tree is flag-INSENSITIVE —
      `BoolTreeLk` reads the flag only at `Acheck` nodes and re-arms it at
      every `Read`, and a NonNullable body Reads on every completing path
      before the guard. TRUE for the fragment (`NfaRepL`'s do-while shapes
      carry `NonNullableL(r1)`); BODILESS pending the structural induction
      (fuel over `MsizeA` with a Read-shielding measure). Consumed only by the
      BACKWARD (loop-view) fork arm, where the iteration thread runs at
      `exit_allowed == true` with no interposed `BeginLoop` to absorb it.
      PROOF: the NonNullable head at index 0 shields EVERY `Acheck` in the
      list (`ShieldedActs`' witness is j == 0 throughout), so the proven
      `CE.BoolFlagLift` applies directly. */
  lemma BoolTreeLkGuardShield(rer: LW.RegExpRecord, r1: L.Regex, rest: LS.Actions,
                              inp: LC.Input, ti: LT.Tree)
    requires NUL.NonNullableL(r1)
    requires EL.PikeLkActions([LS.Areg(r1)] + rest)
    requires EL.BoolTreeLk(rer, [LS.Areg(r1)] + rest, inp, BS.CannotExit, ti)
    ensures EL.BoolTreeLk(rer, [LS.Areg(r1)] + rest, inp, BS.CanExit, ti)
  {
    var acts := [LS.Areg(r1)] + rest;
    assert CE.ShieldedActs(acts) by {
      forall i | 0 <= i < |acts| && acts[i].Acheck?
        ensures exists j :: 0 <= j < i && acts[j].Areg? && NUL.NonNullableL(acts[j].r)
      {
        assert acts[0] == LS.Areg(r1);
        assert i >= 1;
        assert acts[0].Areg? && NUL.NonNullableL(acts[0].r);
      }
    }
    CE.BoolFlagLift(rer, acts, inp, ti);
  }

  /** The star iteration arm's invariants across the unfold: `GateAheadClear`
      by the Reset itself (the fresh body pendings sit inside the reset set;
      the tail's survive the domain shrink), the carrier by `WalkDefsOkUnfold`. */
  lemma StarArmInvariants(acts: LS.Actions, r1: L.Regex, q': L.Regex, chk: LS.Action,
                          gm: LG.GroupMap, gidl: LG.GroupSet)
    requires |acts| > 0 && acts[0].Areg? && acts[0].r.Quantified? && acts[0].r.r1 == r1
    requires q'.Quantified? && q'.r1 == r1
    requires chk.Acheck?
    requires gidl == L.DefGroups(r1)
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures GateAheadClear([LS.Areg(r1), chk, LS.Areg(q')] + acts[1..], LG.GMReset(gidl, gm))
    ensures WalkDefsOk([LS.Areg(r1), chk, LS.Areg(q')] + acts[1..])
  {
    var cont := acts[1..];
    var na := [LS.Areg(r1), chk, LS.Areg(q')] + cont;
    var gm2 := LG.GMReset(gidl, gm);
    WalkDefsOkUnfold(acts, r1, q', [chk]);
    assert [LS.Areg(r1)] + [chk] + [LS.Areg(q')] + cont == na;
    assert GateAheadClear(na, gm2) by {
      forall lk2: L.Lookaround, rr: L.Regex | GatePending(na, lk2, rr)
        ensures forall gg :: gg in L.DefGroups(rr) ==> gg !in gm2
      {
        var j :| 0 <= j < |na| && na[j].Areg? && RegexTopGate(na[j].r, lk2, rr);
        if j == 0 {
          assert na[0] == LS.Areg(r1) && RegexTopGate(r1, lk2, rr);
          RegexTopGateSubDefs(r1, lk2, rr);
          var SRR := set gx | gx in L.DefGroups(rr);
          var SR1 := set gx | gx in L.DefGroups(r1);
          assert SRR <= SR1;
          forall gg | gg in L.DefGroups(rr) ensures gg !in gm2 {
            assert gg in SRR;
            assert gg in SR1;
            assert gg in L.DefGroups(r1);
            assert gm2 == gm - (set gx | gx in gidl);
            assert gg in (set gx | gx in gidl);
          }
        } else if j == 1 {
          assert !na[1].Areg?;
          assert false;
        } else if j == 2 {
          assert na[2] == LS.Areg(q') && !RegexTopGate(q', lk2, rr);
          assert false;
        } else {
          assert na[j] == cont[j - 3];
          assert GatePending(cont, lk2, rr) by {
            assert cont[j - 3].Areg? && RegexTopGate(cont[j - 3].r, lk2, rr);
          }
          GatePendingTail(acts, lk2, rr);
          forall gg | gg in L.DefGroups(rr) ensures gg !in gm2 {
            assert gg !in gm;
          }
        }
      }
    }
  }

  /** The star iteration arm's WALK at its `SetQuantToClock` pc, WITH an
      interposed `BeginLoop` (the FORWARD star / bounded-star layouts): the
      see-through disjunct chains into the BeginLoop stutter (which absorbs
      ANY incoming flag) and lands on the arm list at `CannotExit`. */
  lemma StarIterArmWalkBL(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          gm: LG.GroupMap, sqcpc: nat, ea: bool, qid: int,
                          r1: L.Regex, ti: LT.Tree, armlist: LS.Actions)
    requires NR.GetPcRE(code, sqcpc) == Some(RB.SetQuantToClock(qid, false))
    requires qid in qm.quants && qm.quants[qid] == L.DefGroups(r1)
    requires NR.GetPcRE(code, sqcpc + 1) == Some(RB.BeginLoop)
    requires AR.ActionsRepL(rer, qm, armlist, code, sqcpc + 2)
    requires EL.PikeLkActions(armlist)
    requires EL.BoolTreeLk(rer, armlist, inp, BS.CannotExit, ti)
    requires GateAheadClear(armlist, LG.GMReset(L.DefGroups(r1), gm))
    requires WalkDefsOk(armlist)
    ensures WalkPairLk(rer, qm, code, inp, LT.GroupActionT(LG.Reset(L.DefGroups(r1)), ti),
                       gm, sqcpc, ea)
  {
    var gidl := L.DefGroups(r1);
    var gm2 := LG.GMUpdate(LG.Reset(gidl), LC.Idx(inp), gm);
    assert gm2 == LG.GMReset(gidl, gm);
    assert sqcpc + 1 < RB.size(code);
    assert ATR.EaOf(BS.CannotExit) == false;
    assert WalkPairLk(rer, qm, code, inp, ti, gm2, sqcpc + 2, false);
    assert WalkPairLk(rer, qm, code, inp, ti, gm2, sqcpc + 1, ea);   // BeginLoop absorbs any flag
    assert sqcpc < RB.size(code);
  }

  /** The star iteration arm's WALK at its `SetQuantToClock` pc, with the body
      DIRECTLY following (the do-while LOOP-VIEW): at `ea == true` the arm list
      is entered at `CanExit`, which the NonNullable flag shield licenses. */
  lemma StarIterArmWalkLV(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          gm: LG.GroupMap, sqcpc: nat, ea: bool, qid: int,
                          r1: L.Regex, ti: LT.Tree, rest: LS.Actions)
    requires NR.GetPcRE(code, sqcpc) == Some(RB.SetQuantToClock(qid, false))
    requires qid in qm.quants && qm.quants[qid] == L.DefGroups(r1)
    requires NUL.NonNullableL(r1)
    requires AR.ActionsRepL(rer, qm, [LS.Areg(r1)] + rest, code, sqcpc + 1)
    requires EL.PikeLkActions([LS.Areg(r1)] + rest)
    requires EL.BoolTreeLk(rer, [LS.Areg(r1)] + rest, inp, BS.CannotExit, ti)
    requires GateAheadClear([LS.Areg(r1)] + rest, LG.GMReset(L.DefGroups(r1), gm))
    requires WalkDefsOk([LS.Areg(r1)] + rest)
    ensures WalkPairLk(rer, qm, code, inp, LT.GroupActionT(LG.Reset(L.DefGroups(r1)), ti),
                       gm, sqcpc, ea)
  {
    var gidl := L.DefGroups(r1);
    var gm2 := LG.GMUpdate(LG.Reset(gidl), LC.Idx(inp), gm);
    assert gm2 == LG.GMReset(gidl, gm);
    var b2 := if ea then BS.CanExit else BS.CannotExit;
    if ea { BoolTreeLkGuardShield(rer, r1, rest, inp, ti); }
    assert EL.BoolTreeLk(rer, [LS.Areg(r1)] + rest, inp, b2, ti) && ATR.EaOf(b2) == ea;
    assert WalkPairLk(rer, qm, code, inp, ti, gm2, sqcpc + 1, ea);
    assert sqcpc < RB.size(code);
  }

  /** Fueled `WalkPairLk` core at a `Fork(x, y)` — THE BRANCH PAIRING, shape-
      disjunctive: a `Choice` head pairs its arms at `x`/`y` with the SAME map
      and flag (a star iteration arm pairs AT its `SetQuantToClock` pc via the
      see-through disjunct — the Reset applies when B steps that node); an
      `Acheck` head (backward fork) peels to `Progress` and recurses, arms at
      `true`; `CannotExit` at the guard dies. */
  lemma WalkPairLkAtForkCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                             acts: LS.Actions, x: int, y: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures x >= 0 && y >= 0
    // ERASURE-SHAPED (raw `Progress` guard wrappers can nest at a backfork):
    // dead, or the erased tree is a Choice whose arms have walking witnesses
    // at x/y — always at the OUTER flag (every Acheck peel preserves CanExit).
    ensures CE.ProgErase(tb) == LT.Mismatch
         || exists ta1: LT.Tree, ta2: LT.Tree ::
              CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
              && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
              && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(strcheck) =>
      // EndLoop != Fork ⟹ the BackForkAt disjunct: pcmid == pc.
      assert AR.BackForkAt(code, pc);
      assert x >= 0 && y >= 0;
      if b == BS.CanExit {
        assert tb.Progress? && EL.BoolTreeLk(rer, cont, inp, BS.CanExit, tb.t);
        assert AR.ActionsRepL(rer, qm, cont, code, pc);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        WalkPairLkAtForkCore(rer, qm, code, inp, tb.t, gm, pc, BS.CanExit, cont, x, y);
        // the erased result lifts through the Progress wrapper verbatim
        assert CE.ProgErase(tb) == CE.ProgErase(tb.t);
        assert ATR.EaOf(BS.CanExit) == ATR.EaOf(b);
      } else {
        assert tb == LT.Mismatch;
      }
    case Aclose(_) =>   // pins SetRegisterToCP — not Fork
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtForkCore(rer, qm, code, inp, tb, gm, pc, b, cont, x, y);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtForkCore(rer, qm, code, inp, tb, gm, pc, b, na, x, y);
      case Disjunction(r1, r2) =>
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.Fork(pc + 1, e1 + 1))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid))
          && AR.NfaRepL(rer, qm, r2, code, e1 + 1, pcmid);
        assert x == pc + 1 && y == e1 + 1;
        assert tb.Choice?
            && EL.BoolTreeLk(rer, [LS.Areg(r1)] + cont, inp, b, tb.t1)
            && EL.BoolTreeLk(rer, [LS.Areg(r2)] + cont, inp, b, tb.t2);
        // arm reps: r1's tail rides the mid Jmp; r2's is direct
        assert AR.ActionsRepL(rer, qm, cont, code, e1);   // jump_bc via Jmp(pcmid)
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), cont, code, pc + 1, e1);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1 + 1, pcmid);
        assert EL.PikeLkActions([LS.Areg(r1)] + cont) && EL.PikeLkActions([LS.Areg(r2)] + cont) by {
          EL.PikeLkActionsConsIff(LS.Areg(r1), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
        }
        GateAheadClearDisjArm(acts, r1, r2, r1, gm);
        GateAheadClearDisjArm(acts, r1, r2, r2, gm);
        WalkDefsOkDisjArm(acts, r1, r2, r1);
        WalkDefsOkDisjArm(acts, r1, r2, r2);
        assert WalkPairLk(rer, qm, code, inp, tb.t1, gm, x as nat, g)
            && WalkPairLk(rer, qm, code, inp, tb.t2, gm, y as nat, g);
        assert CE.ProgErase(tb) == LT.Choice(CE.ProgErase(tb.t1), CE.ProgErase(tb.t2));
        assert exists ta1: LT.Tree, ta2: LT.Tree ::
          CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
          && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
          && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b)) by {
          assert WalkPairLk(rer, qm, code, inp, tb.t1, gm, x as nat, ATR.EaOf(b));
          assert WalkPairLk(rer, qm, code, inp, tb.t2, gm, y as nat, ATR.EaOf(b));
        }
      case Quantified(greedy, min, delta, r1) =>
        assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
        assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
        if min == 0 && delta == LN.NN(0) {
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtForkCore(rer, qm, code, inp, tb, gm, pc, b, cont, x, y);
        } else if min > 0 {
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
          assert false;   // min>0 head pins SetQuantToClock, not Fork
        } else {
          // min == 0 with Inf or NN(kx>0): the star fork — tb is the Choice.
          var gidl := L.DefGroups(r1);
          var q' := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
          var itert := if greedy then tb.t1 else tb.t2;
          var skipt := if greedy then tb.t2 else tb.t1;
          assert tb.Choice?
              && itert.GroupActionT? && itert.g == LG.Reset(gidl)
              && EL.BoolTreeLk(rer, [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q')] + cont,
                               inp, BS.CannotExit, itert.t)
              && EL.BoolTreeLk(rer, cont, inp, b, skipt);
          var armlist := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q')] + cont;
          assert EL.PikeLkActions(armlist) by {
            assert EL.PikeLkRegex(r1) && EL.PikeLkRegex(q');
            EL.PikeLkActionsConsIff(LS.Areg(q'), cont);
            EL.PikeLkActionsConsIff(LS.Acheck(inp), [LS.Areg(q')] + cont);
            EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q')] + cont));
            assert [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q')] + cont)) == armlist;
          }
          StarArmInvariants(acts, r1, q', LS.Acheck(inp), gm, gidl);
          // skip arm invariants
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          match delta
          case Inf =>
            assert q' == L.Quantified(greedy, 0, LN.Inf, r1);
            if exists e1: nat ::
                 NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                 && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                        && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                 && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                 && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                 && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                 && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                 && pcmid == e1 + 2 {
              // ---- the LOOP BLOCK: SQC at pc+1, BeginLoop at pc+2 ----------
              var e1: nat :|
                 NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                 && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                        && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                 && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                 && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                 && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                 && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                 && pcmid == e1 + 2;
              var qid: int :| NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1);
              // armlist rep at pc+3: r1; Acheck at EndLoop; q'+cont via the back-jump
              assert AR.ActionsRepL(rer, qm, [LS.Areg(q')] + cont, code, pc) by {
                AR.ActionsRepLCons(rer, qm, LS.Areg(q'), cont, code, pc, pcmid);
              }
              assert AR.ActionsRepL(rer, qm, [LS.Areg(q')] + cont, code, e1 + 1);   // jump_bc
              assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1, e1 + 1);      // EndLoop
              AR.ActionsRepLCons(rer, qm, LS.Acheck(inp), [LS.Areg(q')] + cont, code, e1, e1 + 1);
              AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q')] + cont),
                                 code, pc + 3, e1);
              assert [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q')] + cont)) == armlist;
              assert AR.ActionsRepL(rer, qm, armlist, code, pc + 3);
              StarIterArmWalkBL(rer, qm, code, inp, gm, pc + 1, g, qid, r1, itert.t, armlist);
              assert WalkPairLk(rer, qm, code, inp, itert, gm, pc + 1, g);
              // skip arm at pcmid == e1+2
              assert WalkPairLk(rer, qm, code, inp, skipt, gm, pcmid, g);
              if greedy {
                assert x == pc + 1 && y == e1 + 2;
              } else {
                assert x == e1 + 2 && y == pc + 1;
              }
              assert WalkPairLk(rer, qm, code, inp, tb.t1, gm, x as nat, g)
                        && WalkPairLk(rer, qm, code, inp, tb.t2, gm, y as nat, g);
              assert CE.ProgErase(tb) == LT.Choice(CE.ProgErase(tb.t1), CE.ProgErase(tb.t2));
              assert exists ta1: LT.Tree, ta2: LT.Tree ::
                CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
                      && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
                      && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b)) by {
                assert WalkPairLk(rer, qm, code, inp, tb.t1, gm, x as nat, ATR.EaOf(b));
                assert WalkPairLk(rer, qm, code, inp, tb.t2, gm, y as nat, ATR.EaOf(b));
              }

            } else {
              // ---- the LOOP VIEW: SQC at em (backward), body directly after
              assert NUL.NonNullableL(r1);
              var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em))
                && em <= pc
                && (exists qid: int :: NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                                       && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                && AR.NfaRepL(rer, qm, r1, code, em + 1, pc)
                && pcmid == pc + 1;
              var qid: int :| NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1);
              // armlist rep at em+1: r1 to pc; Acheck dissolves at the back fork; q'+cont at pc
              assert AR.ActionsRepL(rer, qm, [LS.Areg(q')] + cont, code, pc) by {
                AR.ActionsRepLCons(rer, qm, LS.Areg(q'), cont, code, pc, pcmid);
              }
              assert AR.BackForkAt(code, pc);
              assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, pc, pc);
              AR.ActionsRepLCons(rer, qm, LS.Acheck(inp), [LS.Areg(q')] + cont, code, pc, pc);
              AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q')] + cont),
                                 code, em + 1, pc);
              assert [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q')] + cont)) == armlist;
              assert AR.ActionsRepL(rer, qm, armlist, code, em + 1);
              assert armlist == [LS.Areg(r1)] + ([LS.Acheck(inp), LS.Areg(q')] + cont);
              StarIterArmWalkLV(rer, qm, code, inp, gm, em, g, qid, r1, itert.t,
                                [LS.Acheck(inp), LS.Areg(q')] + cont);
              assert WalkPairLk(rer, qm, code, inp, itert, gm, em, g);
              assert WalkPairLk(rer, qm, code, inp, skipt, gm, pc + 1, g);
              if greedy {
                assert x == em && y == pc + 1;
              } else {
                assert x == pc + 1 && y == em;
              }
              assert WalkPairLk(rer, qm, code, inp, tb.t1, gm, x as nat, g)
                        && WalkPairLk(rer, qm, code, inp, tb.t2, gm, y as nat, g);
              assert CE.ProgErase(tb) == LT.Choice(CE.ProgErase(tb.t1), CE.ProgErase(tb.t2));
              assert exists ta1: LT.Tree, ta2: LT.Tree ::
                CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
                      && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
                      && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b)) by {
                assert WalkPairLk(rer, qm, code, inp, tb.t1, gm, x as nat, ATR.EaOf(b));
                assert WalkPairLk(rer, qm, code, inp, tb.t2, gm, y as nat, ATR.EaOf(b));
              }

            }
          case NN(kx) =>
            assert kx > 0;
            assert q' == L.Quantified(greedy, 0, LN.NN(kx - 1), r1);
            var em0: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em0)
                         && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em0, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em0);
            assert em0 == pc;
            var e1x: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, pcmid) else RB.Fork(pcmid, pc + 1))
              && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                     && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
              && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
              && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1x)
              && NR.GetPcRE(code, e1x) == Some(RB.EndLoop)
              && AR.NfaRepOptL(rer, qm, kx - 1, greedy, r1, code, e1x + 1, pcmid);
            var qid: int :| NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
              && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1);
            // q' at e1x+1: zero forced copies + the kx-1 optional layers
            assert AR.NfaRepL(rer, qm, q', code, e1x + 1, pcmid) by {
              assert AR.NfaRepMinL(rer, qm, 0, r1, code, e1x + 1, e1x + 1);
            }
            AR.ActionsRepLCons(rer, qm, LS.Areg(q'), cont, code, e1x + 1, pcmid);
            assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1x, e1x + 1);   // EndLoop
            AR.ActionsRepLCons(rer, qm, LS.Acheck(inp), [LS.Areg(q')] + cont, code, e1x, e1x + 1);
            AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q')] + cont),
                               code, pc + 3, e1x);
            assert [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q')] + cont)) == armlist;
            assert AR.ActionsRepL(rer, qm, armlist, code, pc + 3);
            StarIterArmWalkBL(rer, qm, code, inp, gm, pc + 1, g, qid, r1, itert.t, armlist);
            assert WalkPairLk(rer, qm, code, inp, itert, gm, pc + 1, g);
            assert WalkPairLk(rer, qm, code, inp, skipt, gm, pcmid, g);
            if greedy {
              assert x == pc + 1 && y == pcmid;
            } else {
              assert x == pcmid && y == pc + 1;
            }
            assert WalkPairLk(rer, qm, code, inp, tb.t1, gm, x as nat, g)
                    && WalkPairLk(rer, qm, code, inp, tb.t2, gm, y as nat, g);
            assert CE.ProgErase(tb) == LT.Choice(CE.ProgErase(tb.t1), CE.ProgErase(tb.t2));
            assert exists ta1: LT.Tree, ta2: LT.Tree ::
              CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
                  && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
                  && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b)) by {
              assert WalkPairLk(rer, qm, code, inp, tb.t1, gm, x as nat, ATR.EaOf(b));
              assert WalkPairLk(rer, qm, code, inp, tb.t2, gm, y as nat, ATR.EaOf(b));
            }

        }
      case Character(_) =>   // pins Consume — not Fork
      case Group(_, _) =>   // pins SetRegisterToCP — not Fork
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Fork
      case AnchorR(_) =>   // pins AnchorAssertion — not Fork
      case Backreference(_) =>   // NfaRepL false
  }

  /** WalkPairLk→arms wrapper at a `Fork(x, y)` (the two stutter disjuncts are
      dead at a Fork pc). */
  lemma WalkPairLkAtForkArms(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, x: int, y: int)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    ensures x >= 0 && y >= 0
    ensures CE.ProgErase(tb) == LT.Mismatch
         || exists ta1: LT.Tree, ta2: LT.Tree ::
              CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
              && WalkPairLk(rer, qm, code, inp, ta1, gm, x as nat, ea)
              && WalkPairLk(rer, qm, code, inp, ta2, gm, y as nat, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtForkCore(rer, qm, code, inp, tb, gm, pc, b, acts, x, y);
  }

  /** Fueled core of `TtLkAtSetQuant`: peel the transparent prefix; the real head
      is an `Areg(Quantified(min>0))` whose first `SetQuantToClock` stamps a
      `Reset`, and the continuation `[Areg(r1),Areg(Quantified(min-1))]+cont` is
      represented at `pc+1` by `QuantForcedContRep` (the do-while seam is now
      satisfiable — `WalkOk` was dropped from `TtLk`). */
  lemma TtLkAtSetQuantCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                           tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, q: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
    ensures tb.GroupActionT? && tb.g.Reset?
    ensures TtLk(rer, qm, code, inp, tb.t, pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not SetQuantToClock
    case Aclose(_) =>   // pins SetRegisterToCP — not SetQuantToClock
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtSetQuantCore(rer, qm, code, inp, tb, pc, b, cont, q);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtSetQuantCore(rer, qm, code, inp, tb, pc, b, na, q);
      case Quantified(greedy, min, delta, r1) =>
        assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
        assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
        if min > 0 {
          // THE forced-copy real head: reset stamp + continuation via QuantForcedContRep.
          var quant1 := L.Quantified(greedy, min - 1, delta, r1);
          var contActs := [LS.Areg(r1), LS.Areg(quant1)] + cont;
          assert tb.GroupActionT? && tb.g == LG.Reset(L.DefGroups(r1))
                 && EL.BoolTreeLk(rer, contActs, inp, b, tb.t);
          QuantForcedContRep(rer, qm, greedy, min, delta, r1, code, pc, pcmid, cont);   // ActionsRepL(contActs, pc+1)
          assert EL.PikeLkRegex(r1) && EL.PikeLkRegex(quant1);
          assert EL.PikeLkActions(contActs) by {
            EL.PikeLkActionsConsIff(LS.Areg(quant1), cont);
            EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(quant1)] + cont);
          }
          assert TtLk(rer, qm, code, inp, tb.t, pc + 1, g);
        } else if delta == LN.NN(0) {
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtSetQuantCore(rer, qm, code, inp, tb, pc, b, cont, q);
        } else {
          // min==0 with Inf or NN(kx>0): pins a Fork at pc, not SetQuantToClock.
          match delta
          case Inf =>
            if exists e1: nat ::
                 NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                 && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                        && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                 && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                 && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                 && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                 && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                 && pcmid == e1 + 2 {
              var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
            } else {
              var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
            }
          case NN(kx) =>
            var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                         && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
            NfaRepOptLHeadPin(rer, qm, kx, greedy, r1, code, em, pcmid);   // kx>0 ⇒ Fork at pc
        }
      case Character(_) =>   // pins Consume — not SetQuantToClock
      case Disjunction(_, _) =>   // pins Fork — not SetQuantToClock
      case Group(_, _) =>   // pins SetRegisterToCP — not SetQuantToClock
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not SetQuantToClock
      case AnchorR(_) =>   // pins AnchorAssertion — not SetQuantToClock
      case Backreference(_) =>   // NfaRepL false
  }

  /** [SOLID] At SetQuantToClock the tree is the quantifier's `Reset` stamp
      (payload pinned by `qm.quants`). Resolved by the do-while-seam
      reformulation (WalkOk dropped from TtLk) + `QuantForcedContRep`. */
  lemma TtLkAtSetQuant(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                       tb: LT.Tree, pc: nat, ea: bool, q: int)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
    ensures tb.GroupActionT? && tb.g.Reset?
    ensures TtLk(rer, qm, code, inp, tb.t, pc + 1, ea)
  {
    if (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActions(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb)) {
      var acts: LS.Actions, b: BS.LoopBool :|
        AR.ActionsRepL(rer, qm, acts, code, pc)
        && EL.PikeLkActions(acts)
        && ATR.EaOf(b) == ea
        && EL.BoolTreeLk(rer, acts, inp, b, tb);
      TtLkAtSetQuantCore(rer, qm, code, inp, tb, pc, b, acts, q);
    } else {
      // the SQC see-through disjunct gives the shape + child directly
      var q0: int :| NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q0, false))
        && q0 in qm.quants
        && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q0])
        && TtLk(rer, qm, code, inp, tb.t, pc + 1, ea);
    }
  }

  /** [SOLID] THE GATE, B side: at `CheckOracle(lid)` the tree IS the gate's
      own node — `LK` when the bit is set (and its `LkResult` verdict agrees
      via `OracleOkAt`), `LKFail` when clear; a passing gate's continuation
      walks from `pc+1` at the SAME input. This is `GateNodeAtInp` +
      `GateFiresAtWalkInp` transported into the pairing's vocabulary — the
      point where LiftAdvanceEpsilon's CheckOracle case meets `GateStepValue`. */
  /** Fueled core of `TtLkAtCheckOracle`: peel the transparent prefix (`OracleOkAt`
      is at the same `inp`, so it survives); the real head is a `LookaroundR`
      whose gate node `M.GateNodeAtInp` pins to `LK`/`LKFail`, and `OracleOkAt`
      ties the oracle bit to the `LkGateOk` verdict (positive gate: bit ⟺
      `LkResult.Some?`). */
  lemma TtLkAtCheckOracleCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                              tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, lid: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    requires LL.OracleOkAt(rer, qm, inp)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      (LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
         tb.LK? && tb.lk == lk
         && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, true)
         && TtLk(rer, qm, code, inp, tb.t, pc + 1, ATR.EaOf(b)))
      && (!LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
            tb.LKFail? && tb.lk == lk
            && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, false))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not CheckOracle
    case Aclose(_) =>   // pins SetRegisterToCP — not CheckOracle
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtCheckOracleCore(rer, qm, code, inp, tb, pc, b, cont, lid);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtCheckOracleCore(rer, qm, code, inp, tb, pc, b, na, lid);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtCheckOracleCore(rer, qm, code, inp, tb, pc, b, cont, lid);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case LookaroundR(lk0, r1) =>
        // NfaRepL(LookaroundR) pins CheckOracle(lid0)/NegCheckOracle(lid0); here it is CheckOracle.
        var lid0: int :| NR.GetPcRE(code, pc) == Some(if AR.PositiveL(lk0) then RB.CheckOracle(lid0)
                                                                           else RB.NegCheckOracle(lid0))
          && lid0 in qm.looks && qm.looks[lid0] == (lk0, r1) && pcmid == pc + 1;
        assert AR.PositiveL(lk0) && lid0 == lid;
        assert L.Positivity(lk0);
        assert lid in qm.looks && qm.looks[lid] == (lk0, r1);
        M.GateNodeAtInp(rer, acts, inp, b, tb, lk0, r1);   // tb is LK/LKFail with LkGateOk
        // OracleOkAt at lid: bit ⟺ TreeRes(ComputeTr([Areg(r1)],inp,Empty,LkDir(lk0)),..).Some?
        var bit := LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid);
        if tb.LK? {
          // LkGateOk(..,true) ⇒ LkResult.Some? ⇒ TreeRes.Some? ⇒ bit
          assert EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          assert TtLk(rer, qm, code, inp, tb.t, pc + 1, g);
          assert bit;
        } else {
          assert tb.LKFail?;   // GateNodeAtInp: only LK or LKFail
          // LkGateOk(..,false) ⇒ LkResult.None? ⇒ TreeRes.None? ⇒ !bit
          assert !bit;
        }
      case Character(_) =>   // pins Consume — not CheckOracle
      case Disjunction(_, _) =>   // pins Fork — not CheckOracle
      case Group(_, _) =>   // pins SetRegisterToCP — not CheckOracle
      case AnchorR(_) =>   // pins AnchorAssertion — not CheckOracle
      case Backreference(_) =>   // NfaRepL false
  }

  lemma TtLkAtCheckOracle(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          tb: LT.Tree, pc: nat, ea: bool, lid: int)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    requires LL.OracleOkAt(rer, qm, inp)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      (LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
         tb.LK? && tb.lk == lk
         && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, true)
         && TtLk(rer, qm, code, inp, tb.t, pc + 1, ea))
      && (!LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
            tb.LKFail? && tb.lk == lk
            && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, false))
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtCheckOracleCore(rer, qm, code, inp, tb, pc, b, acts, lid);
  }

  /** `TR.CpOf` re-exported locally (avoids importing TreeRep just for it). */
  function TR_CpOf(inp: LC.Input): nat { |inp.pref| }

  /** A `PikeLk` lookaround head has a `NoLkBrL` body: a POSITIVE look (fwd/bwd)
      gives it directly (widened `PikeLkRegex(LookaroundR)`), the NEGATIVE flavours
      are group-free (⊆ `NoLkBrL`). Reusable at the gate for `LkResultAgreeOutside`. */
  lemma LookBodyNoLkBr(lk: L.Lookaround, r1: L.Regex)
    requires EL.PikeLkRegex(L.LookaroundR(lk, r1))
    ensures EL.NoLkBrL(r1)
  {
    if L.Positivity(lk) {
      // widened PikeLkRegex(LookaroundR) == NoLkBrL(r1) for a positive look.
    } else {
      EL.GroupFreeLNoLkBr(r1);   // requires GroupFreeL(r1), the else-branch of PikeLkRegex
    }
  }

  /** `NoDupSeq(AllDefsActs)` threads to the tail (any head): the head contributes
      a PREFIX of `AllDefsActs`, so the suffix stays dup-free (`NoDupConcat`). */
  lemma NoDupAllDefsTail(acts: LS.Actions)
    requires |acts| > 0 && M.NoDupSeq(M.AllDefsActs(acts))
    ensures M.NoDupSeq(M.AllDefsActs(acts[1..]))
  {
    assert acts == [acts[0]] + acts[1..];
    M.AllDefsActsCons(acts[0], acts[1..]);
    var pre: seq<LG.GroupId> := if acts[0].Areg? then L.DefGroups(acts[0].r) else [];
    assert M.AllDefsActs(acts) == pre + M.AllDefsActs(acts[1..]);
    M.NoDupConcat(pre, M.AllDefsActs(acts[1..]));
  }

  /** THE CheckOracle CONTINUATION WALK (fueled core). Mirrors
      `TtLkAtCheckOracleCore` — same transparent peel to the gate head — but
      carries `GateAheadClear(acts, gm)` and the `NoDupSeq(AllDefsActs(acts))`
      walk-invariant, and at a PASSING positive gate PRODUCES the continuation
      `WalkPairLk(tb.t, gm2, pc+1, ea)` (not a bare `TtLk`): the merged map
      `gm2 = LkResult(lk, tb.tlk, gm, inp).value` is `GateAheadClear` on the
      continuation `cont` via `GateAheadClearAfterMerge`, whose DefGroups-
      disjointness obligation is discharged from `NoDupConcat` on
      `DefGroups(r1) + AllDefsActs(cont)` (the crossed gate's body sits in the
      prefix, every other pending gate's body in the dup-free suffix). This is
      the intricate piece that finishes `ThreadRepLkStepCheckOracle`'s
      continuation-walk `requires`. */
  lemma WalkPairLkAtCheckOracleCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                    tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                    acts: LS.Actions, lid: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    requires LL.OracleOkAt(rer, qm, inp)
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      (LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
         tb.LK? && tb.lk == lk
         && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, true)
         && LS.LkResult(lk, tb.tlk, gm, inp).Some?
         && WalkPairLk(rer, qm, code, inp, tb.t, LS.LkResult(lk, tb.tlk, gm, inp).value,
                       pc + 1, ATR.EaOf(b)))
      && (!LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
            tb.LKFail? && tb.lk == lk
            && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, false))
    // the gate's OWN GateAheadClear instance: it is pending at the real head,
    // so its body groups are absent from the accumulated map (discharges
    // `ThreadRepLkStepCheckOracle`'s absence hypothesis)
    ensures forall gg :: gg in L.DefGroups(qm.looks[lid].1) ==> gg !in gm
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not CheckOracle
    case Aclose(_) =>   // pins SetRegisterToCP — not CheckOracle
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtCheckOracleCore(rer, qm, code, inp, tb, gm, pc, b, cont, lid);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        // NoDupSeq(AllDefsActs(na)) == NoDupSeq(AllDefsActs(acts)) (same sequence).
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtCheckOracleCore(rer, qm, code, inp, tb, gm, pc, b, na, lid);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtCheckOracleCore(rer, qm, code, inp, tb, gm, pc, b, cont, lid);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case LookaroundR(lk0, r1) =>
        var lid0: int :| NR.GetPcRE(code, pc) == Some(if AR.PositiveL(lk0) then RB.CheckOracle(lid0)
                                                                           else RB.NegCheckOracle(lid0))
          && lid0 in qm.looks && qm.looks[lid0] == (lk0, r1) && pcmid == pc + 1;
        assert AR.PositiveL(lk0) && lid0 == lid;
        assert L.Positivity(lk0);
        assert lid in qm.looks && qm.looks[lid] == (lk0, r1);
        // the gate is pending at index 0 ⟹ its body groups are clear NOW
        assert RegexTopGate(L.LookaroundR(lk0, r1), lk0, r1);
        assert GatePending(acts, lk0, r1) by {
          assert acts[0].Areg? && RegexTopGate(acts[0].r, lk0, r1);
        }
        assert forall gg :: gg in L.DefGroups(r1) ==> gg !in gm;
        M.GateNodeAtInp(rer, acts, inp, b, tb, lk0, r1);   // tb is LK/LKFail with LkGateOk
        var bit := LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid);
        if tb.LK? {
          assert EL.LkGateOk(rer, lk0, r1, inp, tb.tlk, true);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          assert bit;
          // ---- gate-frame facts for LkResultAgreeOutside ----
          assert r0 == L.LookaroundR(lk0, r1);
          LookBodyNoLkBr(lk0, r1);                                     // NoLkBrL(r1)
          assert LS.LkResult(lk0, tb.tlk, LG.Empty, inp).Some?;       // LkGateOk true
          EL.LkResultGmIndep(lk0, tb.tlk, gm, inp);
          assert LS.LkResult(lk0, tb.tlk, gm, inp).Some?;
          var gm2 := LS.LkResult(lk0, tb.tlk, gm, inp).value;
          assert tb.tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk0));   // LkGateOk
          LkResultAgreeOutside(rer, lk0, r1, inp, tb.tlk, gm);        // GmAgreeOutside(gm2, gm, Sr1)
          var Sr1 := set gx | gx in L.DefGroups(r1);
          // AfterMerge req (2): gm2 keys ⊆ gm ∪ DefGroups(r1).
          assert forall gg :: gg in gm2 ==> gg in gm || gg in L.DefGroups(r1) by {
            forall gg | gg in gm2 ensures gg in gm || gg in L.DefGroups(r1) {
              if gg !in Sr1 { assert gg in gm2 <==> gg in gm; assert gg in gm; }
              else { assert gg in L.DefGroups(r1); }
            }
          }
          // AfterMerge req (3): pending-in-cont ⟹ pending-in-acts.
          assert forall lk2: L.Lookaround, r2: L.Regex :: GatePending(cont, lk2, r2) ==> GatePending(acts, lk2, r2) by {
            forall lk2: L.Lookaround, r2: L.Regex | GatePending(cont, lk2, r2)
              ensures GatePending(acts, lk2, r2)
            { GatePendingTail(acts, lk2, r2); }
          }
          // AfterMerge req (4): every other pending gate's body disjoint from
          // DefGroups(r1) — from C1 (TopLk NoDup): the head gate contributes
          // DefGroups(r1) as a block, pending bodies in cont sit inside
          // TopLkDefsListActs(cont) (RegexTopGateSubTopLk).
          TopLkDefsListActsCons(acts[0], cont);
          assert TopLkDefsList(L.LookaroundR(lk0, r1)) == L.DefGroups(r1);
          assert TopLkDefsListActs(acts) == L.DefGroups(r1) + TopLkDefsListActs(cont);
          M.NoDupConcat(L.DefGroups(r1), TopLkDefsListActs(cont));
          assert forall lk2: L.Lookaround, r2: L.Regex :: GatePending(cont, lk2, r2) ==>
                   (forall gg :: gg in L.DefGroups(r2) ==> gg !in L.DefGroups(r1)) by {
            forall lk2: L.Lookaround, r2: L.Regex | GatePending(cont, lk2, r2)
              ensures forall gg :: gg in L.DefGroups(r2) ==> gg !in L.DefGroups(r1)
            {
              var j :| 0 <= j < |cont| && cont[j].Areg? && RegexTopGate(cont[j].r, lk2, r2);
              RegexTopGateSubTopLk(cont[j].r, lk2, r2);     // set(DefGroups r2) ⊆ set(TopLk cont[j].r)
              TopLkDefsListMemberSub(cont, j);              // set(TopLk cont[j].r) ⊆ set(TopLkActs cont)
              var SR2 := set gx | gx in L.DefGroups(r2);
              var SCJ := set gx | gx in TopLkDefsList(cont[j].r);
              var SAC := set gx | gx in TopLkDefsListActs(cont);
              var SR1 := set gx | gx in L.DefGroups(r1);
              assert SR2 <= SCJ && SCJ <= SAC;              // the two lemma subsets (named-set form)
              assert SR1 * SAC == {};                       // NoDupConcat disjointness
              forall gg | gg in L.DefGroups(r2) ensures gg !in L.DefGroups(r1) {
                assert gg in SR2;
                assert gg in SAC;                           // via SR2 ⊆ SCJ ⊆ SAC
                if gg in L.DefGroups(r1) {                   // contradiction: SR1 ∩ SAC == {}
                  assert gg in SR1 && gg in SAC;
                  assert gg in SR1 * SAC;
                  assert false;
                }
              }
            }
          }
          GateAheadClearAfterMerge(acts, cont, gm, gm2, lk0, r1);   // GateAheadClear(cont, gm2)
          // Assemble WalkPairLk(tb.t, gm2, pc+1, g) via the existential disjunct.
          assert EL.PikeLkActions(cont);
          WalkDefsOkTail(acts);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1)
              && EL.PikeLkActions(cont)
              && ATR.EaOf(b) == g
              && EL.BoolTreeLk(rer, cont, inp, b, tb.t)
              && GateAheadClear(cont, gm2)
              && WalkDefsOk(cont);
          assert WalkPairLk(rer, qm, code, inp, tb.t, gm2, pc + 1, g);
        } else {
          assert tb.LKFail?;   // GateNodeAtInp: only LK or LKFail
          assert !bit;
        }
      case Character(_) =>   // pins Consume — not CheckOracle
      case Disjunction(_, _) =>   // pins Fork — not CheckOracle
      case Group(_, _) =>   // pins SetRegisterToCP — not CheckOracle
      case AnchorR(_) =>   // pins AnchorAssertion — not CheckOracle
      case Backreference(_) =>   // NfaRepL false
  }

  /** WalkPairLk analogue of `TtLkAtCheckOracle` — the `WalkPairLk`→`WalkPairLk`
      wrapper. At a passing positive gate, the continuation `tc` walk-pairs with
      the merged map `gm2` at `pc+1`. Extracts the walk's `acts` (now carrying
      `GateAheadClear` + `NoDupSeq(AllDefsActs)` from the augmented `WalkPairLk`)
      and applies the fueled Core. DISCHARGES `ThreadRepLkStepCheckOracle`'s
      continuation `requires`. */
  lemma WalkPairLkAtCheckOracle(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, lid: int)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    requires LL.OracleOkAt(rer, qm, inp)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      (LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
         tb.LK? && tb.lk == lk
         && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, true)
         && LS.LkResult(lk, tb.tlk, gm, inp).Some?
         && WalkPairLk(rer, qm, code, inp, tb.t, LS.LkResult(lk, tb.tlk, gm, inp).value, pc + 1, ea))
      && (!LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
            tb.LKFail? && tb.lk == lk
            && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, false))
    ensures forall gg :: gg in L.DefGroups(qm.looks[lid].1) ==> gg !in gm
  {
    // GetPcRE==CheckOracle ≠ BeginLoop kills the stutter disjunct; extract the walk.
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtCheckOracleCore(rer, qm, code, inp, tb, gm, pc, b, acts, lid);
  }

  /** WalkPairLk core at an `AnchorAssertion` — the TEMPLATE for the peel-based
      NON-GATE single-child cases. Mirrors `WalkPairLkAtCheckOracleCore`'s peel
      but the head is `Areg(AnchorR)` and there is NO gate merge: `gm` is
      UNCHANGED, so `GateAheadClear`/`NoDup` transfer to the continuation by the
      plain tail bricks (`GateAheadClearTail`, `NoDupAllDefsTail`). */
  lemma WalkPairLkAtAnchorCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                               tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                               acts: LS.Actions, a: R.anchor)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures tb.AnchorPass? || tb == LT.Mismatch
    ensures tb.AnchorPass? ==> WalkPairLk(rer, qm, code, inp, tb.t, gm, pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not AnchorAssertion
    case Aclose(_) =>   // pins SetRegisterToCP — not AnchorAssertion
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtAnchorCore(rer, qm, code, inp, tb, gm, pc, b, cont, a);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtAnchorCore(rer, qm, code, inp, tb, gm, pc, b, na, a);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtAnchorCore(rer, qm, code, inp, tb, gm, pc, b, cont, a);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case AnchorR(la) =>
        var a2: R.anchor :| NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a2)) && T.TrAnchor(a2) == la;
        assert pcmid == pc + 1;
        if LS.AnchorSatisfied(rer, la, inp) {
          assert tb.AnchorPass? && EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          // gm UNCHANGED across AnchorPass ⟹ tail bricks give the continuation clear.
          GateAheadClearTail(acts, gm);       // GateAheadClear(cont, gm)
          WalkDefsOkTail(acts);             // NoDupSeq(AllDefsActs(cont))
          assert EL.PikeLkActions(cont);
          assert WalkPairLk(rer, qm, code, inp, tb.t, gm, pc + 1, g);
        } else {
          assert tb == LT.Mismatch;
        }
      case Character(_) =>   // pins Consume — not AnchorAssertion
      case Disjunction(_, _) =>   // pins Fork — not AnchorAssertion
      case Group(_, _) =>   // pins SetRegisterToCP — not AnchorAssertion
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not AnchorAssertion
      case Backreference(_) =>   // NfaRepL false
  }

  /** WalkPairLk→WalkPairLk wrapper at an `AnchorAssertion`. */
  lemma WalkPairLkAtAnchor(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                           tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, a: R.anchor)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
    ensures tb.AnchorPass? || tb == LT.Mismatch
    ensures tb.AnchorPass? ==> WalkPairLk(rer, qm, code, inp, tb.t, gm, pc + 1, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtAnchorCore(rer, qm, code, inp, tb, gm, pc, b, acts, a);
  }

  /** Per-thread ANCHOR preservation (a satisfied `AnchorAssertion`): the VM
      steps `t → t.(pc:=pc+1)` with NO register change, so the value ties are
      frame-invariant (like BeginLoop) and the walk relocates via
      `WalkPairLkAtAnchor`. The B-machine steps the `AnchorPass` head to its
      child `tb.t` (same `gm`). */
  lemma ThreadRepLkStepAnchor(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                              inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, tb: LT.Tree, gm: LG.GroupMap, t: AI.Thread,
                              ncap: int, nlook: int, nquant: int, a: R.anchor)
    requires ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, tb, gm, t, ncap, nlook, nquant)
    requires NR.GetPcRE(code, t.pc as nat) == Some(RB.AnchorAssertion(a))
    requires tb.AnchorPass?     // the anchor is satisfied (else the VM drops the thread)
    ensures ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, tb.t, gm,
                        t.(pc := t.pc + 1), ncap, nlook, nquant)
  {
    WalkPairLkAtAnchor(rer, qm, code, inp, tb, gm, t.pc as nat, t.exit_allowed, a);
    assert (t.pc + 1) as nat == (t.pc as nat) + 1;
    // GmtTieOutside/GmtTieInside read only the capture/look/quant regs, unchanged
    // by the pc update, so they transfer verbatim from ThreadRepLk(tb, gm, t).
  }

  /** (L4 NESTED) clone of `ThreadRepLkStepAnchor` — GmtTieInside dropped. */
  lemma ThreadRepLkStepAnchorNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                              inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, tb: LT.Tree, gm: LG.GroupMap, t: AI.Thread,
                              ncap: int, nlook: int, nquant: int, a: R.anchor)
    requires ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, tb, gm, t, ncap, nlook, nquant)
    requires NR.GetPcRE(code, t.pc as nat) == Some(RB.AnchorAssertion(a))
    requires tb.AnchorPass?     // the anchor is satisfied (else the VM drops the thread)
    ensures ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, tb.t, gm,
                        t.(pc := t.pc + 1), ncap, nlook, nquant)
  {
    WalkPairLkAtAnchor(rer, qm, code, inp, tb, gm, t.pc as nat, t.exit_allowed, a);
    assert (t.pc + 1) as nat == (t.pc as nat) + 1;
    // GmtTieOutside/GmtTieInside read only the capture/look/quant regs, unchanged
    // by the pc update, so they transfer verbatim from ThreadRepLkNested(tb, gm, t).
  }

  /** `WalkPairLk` is strictly stronger than `TtLk`: its existential adds
      `GateAheadClear` + `WalkDefsOk`, which we simply drop; the two stutter
      disjuncts (BeginLoop, SQC see-through) map to `TtLk`'s. This bridge lets
      the cases that need only the tree SHAPE (Accept ⟹ Match, the Fork shape,
      and the dying LKFail/Mismatch cases) reuse the proven `TtLkAt*`
      inversions directly, with no `WalkPairLk`-specific core. */
  lemma WalkPairLkImpliesTtLk(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                              tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    ensures TtLk(rer, qm, code, inp, tb, pc, ea)
    decreases RB.size(code) - pc
  {
    if (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc) && EL.PikeLkActions(acts) && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb) && GateAheadClear(acts, gm)
          && WalkDefsOk(acts)) {
      // the existential disjunct: the same (acts, b) satisfy TtLk's exists.
      var acts: LS.Actions, b: BS.LoopBool :|
        AR.ActionsRepL(rer, qm, acts, code, pc) && EL.PikeLkActions(acts) && ATR.EaOf(b) == ea
        && EL.BoolTreeLk(rer, acts, inp, b, tb) && GateAheadClear(acts, gm)
        && WalkDefsOk(acts);
    } else if pc < RB.size(code) && NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
              && WalkPairLk(rer, qm, code, inp, tb, gm, pc + 1, false) {
      // the BeginLoop stutter disjunct; recurse at pc+1.
      WalkPairLkImpliesTtLk(rer, qm, code, inp, tb, gm, pc + 1, false);
    } else {
      // the SQC see-through disjunct: recurse on the child, re-pack TtLk's.
      var q: int :| NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
        && q in qm.quants
        && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
        && WalkPairLk(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea);
      WalkPairLkImpliesTtLk(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea);
      assert TtLk(rer, qm, code, inp, tb.t, pc + 1, ea);
    }
  }

  /** WalkPairLk at an `Accept`: the tree is `Match` (via the `TtLk` bridge). */
  lemma WalkPairLkAtAccept(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                           tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Accept)
    ensures tb == LT.Match
  {
    WalkPairLkImpliesTtLk(rer, qm, code, inp, tb, gm, pc, ea);
    TtLkAtAccept(rer, qm, code, inp, tb, pc, ea);
  }

  // ---- (G+) SetReg bricks: GroupActionT Open/Close preservation --------------

  /** `GateAheadClear` survives ANY domain-shrinking `gm` change (the `Close`
      case: `GMClose` keeps the domain, so nothing new appears). */
  lemma GateAheadClearMono(acts: LS.Actions, gm: LG.GroupMap, gm2: LG.GroupMap)
    requires GateAheadClear(acts, gm)
    requires forall g :: g in gm2 ==> g in gm
    ensures GateAheadClear(acts, gm2)
  {
    forall lk: L.Lookaround, r1: L.Regex | GatePending(acts, lk, r1)
      ensures forall g :: g in L.DefGroups(r1) ==> g !in gm2
    { forall g | g in L.DefGroups(r1) ensures g !in gm2 { assert g !in gm; } }
  }

  /** `GateAheadClear` survives an `Open(gid)` when `gid` is not in any pending
      body (`GMOpen` adds only `gid`). */
  lemma GateAheadClearAfterOpen(acts: LS.Actions, gm: LG.GroupMap, gid: LG.GroupId, idx: nat)
    requires GateAheadClear(acts, gm)
    requires forall lk: L.Lookaround, r1: L.Regex | GatePending(acts, lk, r1) :: gid !in L.DefGroups(r1)
    ensures GateAheadClear(acts, LG.GMUpdate(LG.Open(gid), idx, gm))
  {
    var gm2 := LG.GMUpdate(LG.Open(gid), idx, gm);
    assert gm2 == LG.GMOpen(idx, gid, gm);
    forall lk: L.Lookaround, r1: L.Regex | GatePending(acts, lk, r1)
      ensures forall g :: g in L.DefGroups(r1) ==> g !in gm2
    {
      forall g | g in L.DefGroups(r1) ensures g !in gm2 {
        assert g !in gm;    // GateAheadClear(acts, gm)
        assert g != gid;    // requires
        assert forall gx :: gx in gm2 ==> gx == gid || gx in gm;   // GMOpen adds only gid
      }
    }
  }

  /** A gate pending in the `Group` open-expansion `[Areg r1, Aclose gid]+cont`
      is pending in `[Areg (Group gid r1)]+cont` (head folds into the `Group`
      top-gate; `Aclose` holds no gate; the tail is shared). */
  lemma GatePendingGroupBack(acts: LS.Actions, gid: LG.GroupId, r1: L.Regex, lk: L.Lookaround, rr: L.Regex)
    requires |acts| > 0 && acts[0] == LS.Areg(L.Group(gid, r1))
    requires GatePending([LS.Areg(r1), LS.Aclose(gid)] + acts[1..], lk, rr)
    ensures GatePending(acts, lk, rr)
  {
    var cont := acts[1..];
    var ga := [LS.Areg(r1), LS.Aclose(gid)] + cont;
    var i :| 0 <= i < |ga| && ga[i].Areg? && RegexTopGate(ga[i].r, lk, rr);
    if i == 0 {
      assert ga[0] == LS.Areg(r1) && RegexTopGate(r1, lk, rr);
      assert RegexTopGate(L.Group(gid, r1), lk, rr);              // Group case
      assert acts[0].Areg? && RegexTopGate(acts[0].r, lk, rr);    // witness 0
    } else if i == 1 {
      assert ga[1] == LS.Aclose(gid);   // not Areg — contradicts ga[i].Areg?
    } else {
      assert ga[i] == cont[i - 2] == acts[i - 1];
      assert acts[i - 1].Areg? && RegexTopGate(acts[i - 1].r, lk, rr);   // witness i-1
    }
  }

  /** WalkPairLk core at a `SetRegisterToCP` — the GROUP-ACTION case. Two real
      heads (mirror of `TtLkAtSetRegCore`): `Aclose(gid)` ⟹ `Close`, `Group(gid,r1)`
      ⟹ `Open` (expanding to `[Areg r1, Aclose gid]+cont`). `gm` steps by
      `GMUpdate(tb.g, Idx(inp), gm)`; the continuation stays `GateAheadClear` —
      Close shrinks the domain (`GateAheadClearMono`), Open's `gid` is NoDup-
      disjoint from every pending body (`GateAheadClearAfterOpen`), so NO
      outside/inside invariant is needed. */
  lemma WalkPairLkAtSetRegCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                               tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                               acts: LS.Actions, r: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(r))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures tb.GroupActionT?
    ensures (tb.g.Open? && r == CP.start_reg(tb.g.g as int))
         || (tb.g.Close? && r == CP.end_reg(tb.g.g as int))
    ensures WalkPairLk(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not SetRegisterToCP
    case Aclose(gid) =>
      assert pcmid == pc + 1 && r == CP.end_reg(gid as int);
      assert tb.GroupActionT? && tb.g == LG.Close(gid) && EL.BoolTreeLk(rer, cont, inp, b, tb.t);
      assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
      var gm2 := LG.GMUpdate(LG.Close(gid), LC.Idx(inp), gm);
      assert gm2 == LG.GMClose(LC.Idx(inp), gid, gm);
      GateAheadClearTail(acts, gm);
      GateAheadClearMono(cont, gm, gm2);   // GMClose keeps the domain
      WalkDefsOkTail(acts);
      assert EL.PikeLkActions(cont);
      assert WalkPairLk(rer, qm, code, inp, tb.t, gm2, pc + 1, g);
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtSetRegCore(rer, qm, code, inp, tb, gm, pc, b, cont, r);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtSetRegCore(rer, qm, code, inp, tb, gm, pc, b, na, r);
      case Group(gid, r1) =>
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(gid as int)))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(gid as int)))
          && pcmid == e1 + 1;
        assert r == CP.start_reg(gid as int);
        var ga := [LS.Areg(r1), LS.Aclose(gid)] + cont;
        assert ga == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Aclose(gid), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Aclose(gid)] + cont, code, pc + 1, e1);
        assert AR.ActionsRepL(rer, qm, ga, code, pc + 1);
        assert tb.GroupActionT? && tb.g == LG.Open(gid) && EL.BoolTreeLk(rer, ga, inp, b, tb.t);
        assert EL.PikeLkActions(ga) by {
          EL.PikeLkActionsConsIff(LS.Aclose(gid), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Aclose(gid)] + cont);
        }
        var gm2 := LG.GMUpdate(LG.Open(gid), LC.Idx(inp), gm);
        // carrier across the Group expand; C1 pins gid ∉ TopLk of both parts
        WalkDefsOkGroupExpand(acts, gid, r1);
        TopLkDefsListActsCons(acts[0], cont);
        TopLkDefsListActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont);
        TopLkDefsListActsCons(LS.Aclose(gid), cont);
        assert TopLkDefsList(L.Group(gid, r1)) == [gid] + TopLkDefsList(r1);
        assert TopLkDefsListActs(acts)
            == ([gid] + TopLkDefsList(r1)) + TopLkDefsListActs(cont);
        assert ([gid] + TopLkDefsList(r1)) + TopLkDefsListActs(cont)
            == [gid] + (TopLkDefsList(r1) + TopLkDefsListActs(cont));
        M.NoDupConcat([gid], TopLkDefsList(r1) + TopLkDefsListActs(cont));
        assert TopLkDefsListActs(ga) == TopLkDefsList(r1) + TopLkDefsListActs(cont);
        // GateAheadClear(ga, gm): pending-in-ga ⟹ pending-in-acts.
        assert forall lk2: L.Lookaround, rr: L.Regex :: GatePending(ga, lk2, rr) ==> GatePending(acts, lk2, rr) by {
          forall lk2: L.Lookaround, rr: L.Regex | GatePending(ga, lk2, rr) ensures GatePending(acts, lk2, rr) {
            GatePendingGroupBack(acts, gid, r1, lk2, rr);
          }
        }
        assert GateAheadClear(ga, gm) by {
          forall lk2: L.Lookaround, rr: L.Regex | GatePending(ga, lk2, rr)
            ensures forall gg :: gg in L.DefGroups(rr) ==> gg !in gm
          { GatePendingGroupBack(acts, gid, r1, lk2, rr); }
        }
        // gid ∉ every pending body of ga (via C1: gid ∉ TopLkDefsListActs(ga) ⊇ DefGroups(rr)).
        assert forall lk2: L.Lookaround, rr: L.Regex :: GatePending(ga, lk2, rr) ==> gid !in L.DefGroups(rr) by {
          forall lk2: L.Lookaround, rr: L.Regex | GatePending(ga, lk2, rr) ensures gid !in L.DefGroups(rr) {
            var j :| 0 <= j < |ga| && ga[j].Areg? && RegexTopGate(ga[j].r, lk2, rr);
            RegexTopGateSubTopLk(ga[j].r, lk2, rr);
            TopLkDefsListMemberSub(ga, j);
            var SRR := set gx | gx in L.DefGroups(rr);
            var SGJ := set gx | gx in TopLkDefsList(ga[j].r);
            var SAG := set gx | gx in TopLkDefsListActs(ga);
            assert SRR <= SGJ && SGJ <= SAG;   // the two lemma subsets (named-set form)
            assert (set gx | gx in [gid]) * SAG == {};   // NoDupConcat disjointness
            if gid in L.DefGroups(rr) {
              assert gid in SRR && gid in SAG;           // via SRR ⊆ SGJ ⊆ SAG
              assert gid in (set gx | gx in [gid]);
              assert gid in (set gx | gx in [gid]) * SAG;   // contradicts disjoint
            }
          }
        }
        GateAheadClearAfterOpen(ga, gm, gid, LC.Idx(inp));   // GateAheadClear(ga, gm2)
        assert WalkPairLk(rer, qm, code, inp, tb.t, gm2, pc + 1, g);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtSetRegCore(rer, qm, code, inp, tb, gm, pc, b, cont, r);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case Character(_) =>   // pins Consume — not SetRegisterToCP
      case Disjunction(_, _) =>   // pins Fork — not SetRegisterToCP
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not SetRegisterToCP
      case AnchorR(_) =>   // pins AnchorAssertion — not SetRegisterToCP
      case Backreference(_) =>   // NfaRepL false
  }

  /** WalkPairLk→WalkPairLk wrapper at a `SetRegisterToCP`. */
  lemma WalkPairLkAtSetReg(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                           tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, r: int)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(r))
    ensures tb.GroupActionT?
    ensures (tb.g.Open? && r == CP.start_reg(tb.g.g as int))
         || (tb.g.Close? && r == CP.end_reg(tb.g.g as int))
    ensures WalkPairLk(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtSetRegCore(rer, qm, code, inp, tb, gm, pc, b, acts, r);
  }

  /** WalkPairLk at a `Fork` — SHAPE only (via the `TtLk` bridge): the tree is a
      `Choice` (forward fork), a `Progress` (do-while backward fork's dissolved
      guard), or `Mismatch`. The BRANCH-PAIRING is handled at the `LiftStepC`
      level, mirroring the PROVEN `PSM.PreserveForkCase`:
       - FORWARD fork (both arms `> pc`: Disjunction / free-star initial /
         bounded): `Choice(t1,t2)`, one `pts_active`, arms pair at `x`, `y`.
       - BACKWARD fork (do-while re-entry): `Progress(Choice(t1,t2))`, `ea` forced
         true, TWO tree steps (unwrap guard, then split), arms pair at `x`, `y`.
      SEAM (the one genuine obstacle): the free-star ITERATION arm's `t1` at
      `pc+1` is `GroupActionT(Reset,..)`, which `BoolTreeLk` does NOT represent at
      a `SetQuantToClock` pc (unlike tstar's `TreeRepRE`). RESOLUTION: augment
      `WalkPairLk` with a `SetQuantToClock`-`Reset` disjunct (analog of the
      BeginLoop stutter, but consuming the `Reset` and applying `GMReset` via
      `GateAheadClearAfterReset`), making `WalkPairLk(GroupActionT(Reset,..), pc)`
      satisfiable at a `SetQuantToClock` pc. */
  lemma WalkPairLkAtFork(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, x: int, y: int)
    requires WalkPairLk(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    ensures x >= 0 && y >= 0
    ensures tb.Choice? || tb.Progress? || tb == LT.Mismatch
  {
    WalkPairLkImpliesTtLk(rer, qm, code, inp, tb, gm, pc, ea);
    TtLkAtFork(rer, qm, code, inp, tb, pc, ea, x, y);
  }

  /** Fueled core of `TtLkAtAnchor`: peel the transparent prefix; the real head
      is an `Areg(AnchorR(la))` pinning `AnchorAssertion` — `BoolTreeLk` reads
      off `AnchorPass` (satisfied) or `Mismatch`, and the continuation walks from
      `pc+1` with the flag unchanged. */
  lemma TtLkAtAnchorCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, a: R.anchor)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
    ensures tb.AnchorPass? || tb == LT.Mismatch
    ensures tb.AnchorPass? ==> TtLk(rer, qm, code, inp, tb.t, pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not AnchorAssertion
    case Aclose(_) =>   // pins SetRegisterToCP — not AnchorAssertion
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtAnchorCore(rer, qm, code, inp, tb, pc, b, cont, a);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtAnchorCore(rer, qm, code, inp, tb, pc, b, na, a);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtAnchorCore(rer, qm, code, inp, tb, pc, b, cont, a);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case AnchorR(la) =>
        var a2: R.anchor :| NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a2)) && T.TrAnchor(a2) == la;
        assert pcmid == pc + 1;
        if LS.AnchorSatisfied(rer, la, inp) {
          assert tb.AnchorPass? && EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          assert TtLk(rer, qm, code, inp, tb.t, pc + 1, g);
        } else {
          assert tb == LT.Mismatch;
        }
      case Character(_) =>   // pins Consume — not AnchorAssertion
      case Disjunction(_, _) =>   // pins Fork — not AnchorAssertion
      case Group(_, _) =>   // pins SetRegisterToCP — not AnchorAssertion
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not AnchorAssertion
      case Backreference(_) =>   // NfaRepL false
  }

  /** [SOLID] At an AnchorAssertion the tree is `AnchorPass` (satisfied) or
      `Mismatch` (mirror of tr_anchorpass / tr_anchorfail). */
  lemma TtLkAtAnchor(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                     tb: LT.Tree, pc: nat, ea: bool, a: R.anchor)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
    ensures tb.AnchorPass? || tb == LT.Mismatch
    ensures tb.AnchorPass? ==> TtLk(rer, qm, code, inp, tb.t, pc + 1, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtAnchorCore(rer, qm, code, inp, tb, pc, b, acts, a);
  }

  /** Fueled core of `TtLkAtEndLoop`: peel the transparent prefix; the real head
      is an `Acheck` (RegElk's `EndLoop` falls through) — `BoolTreeLk` gives
      `Progress` (`CanExit`) or `Mismatch` (`CannotExit`), with the passing
      continuation walking from `pc+1` at `CanExit`. */
  lemma TtLkAtEndLoopCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.EndLoop)
    ensures ATR.EaOf(b) ==> tb.Progress? && TtLk(rer, qm, code, inp, tb.t, pc + 1, true)
    ensures !ATR.EaOf(b) ==> tb == LT.Mismatch
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    assert !AR.BackForkAt(code, pc);   // GetPcRE(pc)==EndLoop, not Fork
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(strcheck) =>
      // ActionRepL(Acheck): EndLoop disjunct (BackFork excluded) ⇒ pcmid == pc+1
      assert pcmid == pc + 1;
      if b == BS.CanExit {
        assert g == true;
        assert tb.Progress? && EL.BoolTreeLk(rer, cont, inp, BS.CanExit, tb.t);
        assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
        assert TtLk(rer, qm, code, inp, tb.t, pc + 1, true);
      } else {
        assert b == BS.CannotExit && g == false;
        assert tb == LT.Mismatch;
      }
    case Aclose(_) =>   // pins SetRegisterToCP — not EndLoop
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtEndLoopCore(rer, qm, code, inp, tb, pc, b, cont);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtEndLoopCore(rer, qm, code, inp, tb, pc, b, na);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtEndLoopCore(rer, qm, code, inp, tb, pc, b, cont);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case Character(_) =>   // pins Consume — not EndLoop
      case Disjunction(_, _) =>   // pins Fork — not EndLoop
      case Group(_, _) =>   // pins SetRegisterToCP — not EndLoop
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not EndLoop
      case AnchorR(_) =>   // pins AnchorAssertion — not EndLoop
      case Backreference(_) =>   // NfaRepL false
  }

  /** [SOLID] At EndLoop: with the flag armed the tree is `Progress`
      (tr_progress); with it cold the tree is `Mismatch` (tr_progressfail) and
      the VM drops the thread. */
  lemma TtLkAtEndLoop(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                      tb: LT.Tree, pc: nat, ea: bool)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.EndLoop)
    ensures ea ==> tb.Progress? && TtLk(rer, qm, code, inp, tb.t, pc + 1, true)
    ensures !ea ==> tb == LT.Mismatch
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtEndLoopCore(rer, qm, code, inp, tb, pc, b, acts);
  }

  /** Fueled core of `TtLkAtFork` (SHAPE only). At a `Fork` the head is a
      `Disjunction` / free-star / bounded / loop-view quantifier (all ⇒ `Choice`)
      or an `Acheck` at a backward fork (⇒ `Progress` when `CanExit`, else
      `Mismatch`). `BoolTreeLk` FORCES the shape in every case. */
  lemma TtLkAtForkCore(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                       tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, x: int, y: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActions(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    ensures x >= 0 && y >= 0
    ensures tb.Choice? || tb.Progress? || tb == LT.Mismatch
    decreases ATR.MsizeA(acts)
  {
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(strcheck) =>
      // EndLoop != Fork, so the BackForkAt disjunct: pcmid == pc; BoolTreeLk ⇒ Progress / Mismatch
      assert AR.BackForkAt(code, pc);
      assert x >= 0 && y >= 0;
    case Aclose(_) =>   // pins SetRegisterToCP — not Fork
    case Areg(r0) =>
      assert EL.PikeLkRegex(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtForkCore(rer, qm, code, inp, tb, pc, b, cont, x, y);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActions(na) by {
          EL.PikeLkActionsConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtForkCore(rer, qm, code, inp, tb, pc, b, na, x, y);
      case Disjunction(r1, r2) =>
        // Fork(pc+1, e1+1) ⇒ x,y >= 0; BoolTreeLk ⇒ tb.Choice?
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.Fork(pc + 1, e1 + 1))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid))
          && AR.NfaRepL(rer, qm, r2, code, e1 + 1, pcmid);
        assert x == pc + 1 && y == e1 + 1;
        assert tb.Choice?;
      case Quantified(greedy, min, delta, r1) =>
        assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
        assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
        if min == 0 && delta == LN.NN(0) {
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtForkCore(rer, qm, code, inp, tb, pc, b, cont, x, y);
        } else if min > 0 {
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);   // pins SQC ≠ Fork
        } else {
          // min==0, Inf or NN(kx>0): the star/bounded fork ⇒ tb.Choice?; targets are nats.
          match delta
          case Inf =>
            if exists e1: nat :: NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                         && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                                && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                         && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                         && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                         && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                         && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                         && pcmid == e1 + 2 {
              var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
              assert x >= 0 && y >= 0;
            } else {
              var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
              assert x >= 0 && y >= 0;
            }
            assert tb.Choice?;
          case NN(kx) =>
            var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                         && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
            assert em == pc;
            var e1x: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, pcmid) else RB.Fork(pcmid, pc + 1))
              && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                     && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
              && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
              && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1x)
              && NR.GetPcRE(code, e1x) == Some(RB.EndLoop)
              && AR.NfaRepOptL(rer, qm, kx - 1, greedy, r1, code, e1x + 1, pcmid);
            assert x >= 0 && y >= 0;
            assert tb.Choice?;
        }
      case Character(_) =>   // pins Consume — not Fork
      case Group(_, _) =>   // pins SetRegisterToCP — not Fork
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Fork
      case AnchorR(_) =>   // pins AnchorAssertion — not Fork
      case Backreference(_) =>   // NfaRepL false
  }

  /** At a `Fork` the tree is a `Choice` (Disjunction / quantifier fork), a
      `Progress` (the do-while backward fork's `Acheck` guard when `CanExit`), or
      `Mismatch`. SHAPE-only ensures: `TtLk` cannot pair the free-star fork's
      iteration arm — that arm is `GroupActionT(Reset,...)` at `pc+1`, but `pc+1`
      is `SetQuantToClock` and `pc+2` is `BeginLoop` (which has NO `ActionsRepL`),
      so `ti` lives at `pc+3`. The branch-pairings are `LiftAdvanceEpsilon`'s job
      (it steps through the `SetQuantToClock`/`BeginLoop` setup); a Disjunction
      fork DOES pair `TtLk(t1,x)`/`TtLk(t2,y)` and can be recovered separately. */
  lemma TtLkAtFork(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                   tb: LT.Tree, pc: nat, ea: bool, x: int, y: int)
    requires TtLk(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    ensures x >= 0 && y >= 0
    ensures tb.Choice? || tb.Progress? || tb == LT.Mismatch
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActions(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtForkCore(rer, qm, code, inp, tb, pc, b, acts, x, y);
  }

  // NOTE on CheckNullable / Fail / NegCheckOracle / WriteOracle: the L3a MAIN
  // code should pin each as either absent (WriteOracle — NR.NoWriteInstrRE;
  // likely CheckNullable under NonNullable plus-fragment bodies) or
  // tree-trivial (Fail → Mismatch; NegCheckOracle → the negative gate, whose
  // bodies are capture-free so B's merge is value-empty). FILL: prove the
  // absence from the code shape (NI.CodeShapeAt) where possible instead of an
  // inversion lemma; otherwise mirror TtLkAtCheckOracle.

  // ---- (G) GateAheadClear preservation bricks --------------------------------

  /** [SOLID] A `Reset` only removes groups, so clear-ness survives. */
  lemma GateAheadClearAfterReset(acts: LS.Actions, gmt: LG.GroupMap, gidl: LG.GroupSet, idx: nat)
    requires GateAheadClear(acts, gmt)
    ensures GateAheadClear(acts, LG.GMUpdate(LG.Reset(gidl), idx, gmt))
  {
    var gmt2 := LG.GMUpdate(LG.Reset(gidl), idx, gmt);
    assert gmt2 == LG.GMReset(gidl, gmt);
    forall lk: L.Lookaround, r1: L.Regex | GatePending(acts, lk, r1)
      ensures forall g :: g in L.DefGroups(r1) ==> g !in gmt2
    {
      forall g | g in L.DefGroups(r1) ensures g !in gmt2 {
        // GateAheadClear(acts, gmt) gives g !in gmt; GMReset only removes keys.
        assert g !in gmt;
      }
    }
  }

  /** [SEAM] An outside-S group action cannot populate a pending gate's body
      groups (every pending body's groups sit inside S). */
  lemma GateAheadClearAfterOutside(acts: LS.Actions, gmt: LG.GroupMap, a: LG.GroupAction, idx: nat,
                                   S: set<LG.GroupId>)
    requires GateAheadClear(acts, gmt)
    requires forall lk: L.Lookaround, r1: L.Regex | GatePending(acts, lk, r1) ::
               forall g :: g in L.DefGroups(r1) ==> g in S
    requires a.Open? ==> a.g !in S
    requires a.Close? ==> a.g !in S
    requires a.Reset? ==> true
    ensures GateAheadClear(acts, LG.GMUpdate(a, idx, gmt))
  {
    var gmt2 := LG.GMUpdate(a, idx, gmt);
    forall lk: L.Lookaround, r1: L.Regex | GatePending(acts, lk, r1)
      ensures forall g :: g in L.DefGroups(r1) ==> g !in gmt2
    {
      forall g | g in L.DefGroups(r1) ensures g !in gmt2 {
        assert g !in gmt;   // GateAheadClear(acts, gmt)
        assert g in S;      // the pending body's groups sit inside S
        match a
        case Open(g0) =>
          // gmt2 == gmt[g0 := ...]; g0 !in S so g != g0, and g !in gmt.
          assert g0 !in S;
          assert g != g0;
        case Close(g0) =>
          // GMClose only re-maps g0 (already present) or is the identity;
          // g0 !in S so g != g0 either way.
          assert g0 !in S;
          assert g != g0;
        case Reset(gs) =>
          // GMReset only removes keys.
      }
    }
  }

  /** [SEAM] Crossing gate `(lk, r1)` merges ONLY `r1`'s groups
      (`LmOfBodiesDisjoint`), and the crossed occurrence is consumed from the
      continuation acts — every OTHER pending gate stays clear. FILL alongside
      LiftAdvanceEpsilon's CheckOracle case; the acts-evolution premise below
      is the SEAM to nail down (mirror the walk's gate case: `pcmid == pc+1`,
      `cont == acts[1..]`-shaped). */
  lemma GateAheadClearAfterMerge(acts: LS.Actions, cont: LS.Actions, gmt: LG.GroupMap,
                                 gmerged: LG.GroupMap, lk: L.Lookaround, r1: L.Regex)
    requires GateAheadClear(acts, gmt)
    requires forall g :: g in gmerged ==> g in gmt || g in L.DefGroups(r1)
    // NOTE: `GatePending(acts,·)` alone (dropped the earlier `(lk2!=lk||r2!=r1)`
    // clause — unsatisfiable for duplicate capture-free looks like `(?=a)(?=a)`,
    // and unused: the body drives off `GatePending(acts,·)` + the disjointness).
    requires forall lk2: L.Lookaround, r2: L.Regex | GatePending(cont, lk2, r2) ::
               GatePending(acts, lk2, r2)
    requires forall lk2: L.Lookaround, r2: L.Regex | GatePending(cont, lk2, r2) ::
               forall g :: g in L.DefGroups(r2) ==> g !in L.DefGroups(r1)
    ensures GateAheadClear(cont, gmerged)
  {
    forall lk2: L.Lookaround, r2: L.Regex | GatePending(cont, lk2, r2)
      ensures forall g :: g in L.DefGroups(r2) ==> g !in gmerged
    {
      forall g | g in L.DefGroups(r2) ensures g !in gmerged {
        assert GatePending(acts, lk2, r2);   // pending-in-cont ==> pending-in-acts
        assert g !in gmt;                     // GateAheadClear(acts, gmt) at (lk2, r2)
        assert g !in L.DefGroups(r1);         // disjointness requires
        // gmerged only holds gmt-keys or r1-body groups, and g is in neither.
      }
    }
  }

  // ---- (G+) transparent-peel bricks for the CheckOracle continuation walk ----
  // These carry `GateAheadClear` and the `NoDupSeq(AllDefsActs)` walk-invariant
  // through the SAME transparent peels the tb-pairing walk performs (Epsilon /
  // spent-`{0}` quantifier ⤳ tail; `Sequence` ⤳ two-head expand), and supply the
  // gate-head DefGroups-disjointness `GateAheadClearAfterMerge` needs — all from
  // MainTheorem's already-proven `AllDefsActs`/`NoDupConcat` vocabulary.

  /** A gate pending in the tail is pending in the whole list. */
  lemma GatePendingTail(acts: LS.Actions, lk: L.Lookaround, r1: L.Regex)
    requires |acts| > 0 && GatePending(acts[1..], lk, r1)
    ensures GatePending(acts, lk, r1)
  {
    var i :| 0 <= i < |acts[1..]| && acts[1..][i].Areg? && RegexTopGate(acts[1..][i].r, lk, r1);
    assert acts[1..][i] == acts[i + 1];
    assert acts[i + 1].Areg? && RegexTopGate(acts[i + 1].r, lk, r1);   // witness i+1
  }

  /** `GateAheadClear` threads to the tail (Epsilon / spent-`{0}` quantifier peel). */
  lemma GateAheadClearTail(acts: LS.Actions, gmt: LG.GroupMap)
    requires |acts| > 0 && GateAheadClear(acts, gmt)
    ensures GateAheadClear(acts[1..], gmt)
  {
    forall lk: L.Lookaround, r1: L.Regex | GatePending(acts[1..], lk, r1)
      ensures forall g :: g in L.DefGroups(r1) ==> g !in gmt
    { GatePendingTail(acts, lk, r1); }
  }

  /** A gate pending in the `Sequence`-expanded list `[Areg r1, Areg r2]+cont`
      is pending in `[Areg (Sequence r1 r2)]+cont` (head 0/1 fold into the
      `Sequence` top-gate; the tail is shared). */
  lemma GatePendingSeqBack(acts: LS.Actions, r1: L.Regex, r2: L.Regex, lk: L.Lookaround, rr: L.Regex)
    requires |acts| > 0 && acts[0] == LS.Areg(L.Sequence(r1, r2))
    requires GatePending([LS.Areg(r1), LS.Areg(r2)] + acts[1..], lk, rr)
    ensures GatePending(acts, lk, rr)
  {
    var cont := acts[1..];
    var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
    var i :| 0 <= i < |na| && na[i].Areg? && RegexTopGate(na[i].r, lk, rr);
    if i == 0 {
      assert na[0] == LS.Areg(r1) && RegexTopGate(r1, lk, rr);
      assert RegexTopGate(L.Sequence(r1, r2), lk, rr);            // def: a-arm
      assert acts[0].Areg? && RegexTopGate(acts[0].r, lk, rr);   // witness 0
    } else if i == 1 {
      assert na[1] == LS.Areg(r2) && RegexTopGate(r2, lk, rr);
      assert RegexTopGate(L.Sequence(r1, r2), lk, rr);           // def: b-arm
      assert acts[0].Areg? && RegexTopGate(acts[0].r, lk, rr);   // witness 0
    } else {
      assert na[i] == cont[i - 2] == acts[i - 1];
      assert acts[i - 1].Areg? && RegexTopGate(acts[i - 1].r, lk, rr);   // witness i-1
    }
  }

  /** `GateAheadClear` threads across the `Sequence` two-head expand. */
  lemma GateAheadClearSeqExpand(acts: LS.Actions, r1: L.Regex, r2: L.Regex, gmt: LG.GroupMap)
    requires |acts| > 0 && acts[0] == LS.Areg(L.Sequence(r1, r2)) && GateAheadClear(acts, gmt)
    ensures GateAheadClear([LS.Areg(r1), LS.Areg(r2)] + acts[1..], gmt)
  {
    forall lk: L.Lookaround, rr: L.Regex | GatePending([LS.Areg(r1), LS.Areg(r2)] + acts[1..], lk, rr)
      ensures forall g :: g in L.DefGroups(rr) ==> g !in gmt
    { GatePendingSeqBack(acts, r1, r2, lk, rr); }
  }

  /** A top-level gate's body groups are among the regex's defined groups. */
  lemma RegexTopGateSubDefs(r: L.Regex, lk: L.Lookaround, r1: L.Regex)
    requires RegexTopGate(r, lk, r1)
    ensures (set g | g in L.DefGroups(r1)) <= (set g | g in L.DefGroups(r))
    decreases r
  {
    match r
    case LookaroundR(lk2, rb) =>
      assert rb == r1 && L.DefGroups(r) == L.DefGroups(r1);
    case Sequence(a, b) =>
      assert L.DefGroups(r) == L.DefGroups(a) + L.DefGroups(b);
      if RegexTopGate(a, lk, r1) { RegexTopGateSubDefs(a, lk, r1); }
      else { RegexTopGateSubDefs(b, lk, r1); }
      assert forall g :: g in L.DefGroups(a) || g in L.DefGroups(b) ==> g in L.DefGroups(a) + L.DefGroups(b);
    case Disjunction(a, b) =>
      assert L.DefGroups(r) == L.DefGroups(a) + L.DefGroups(b);
      if RegexTopGate(a, lk, r1) { RegexTopGateSubDefs(a, lk, r1); }
      else { RegexTopGateSubDefs(b, lk, r1); }
      assert forall g :: g in L.DefGroups(a) || g in L.DefGroups(b) ==> g in L.DefGroups(a) + L.DefGroups(b);
    case Group(id, rb) =>
      assert L.DefGroups(r) == [id] + L.DefGroups(rb);
      RegexTopGateSubDefs(rb, lk, r1);
      assert forall g :: g in L.DefGroups(rb) ==> g in [id] + L.DefGroups(rb);
    case Quantified(_, _, _, _) =>   // RegexTopGate false — vacuous
    case Epsilon =>
    case Character(_) =>
    case AnchorR(_) =>
    case Backreference(_) =>
  }

  /** A top-level gate's body groups are among the regex's INSIDE-LOOK groups
      (`LkBodyGroups`). The SET-based analog of `RegexTopGateSubDefs` — needed for
      the quantifier-STABLE disjointness invariant (`LkBodyGroups` is a set, so
      `LkBodyGroups(Quantified(..,r1)) == LkBodyGroups(r1)` absorbs the iteration
      duplication that breaks the seq-based `NoDupSeq(AllDefsActs)`). */
  lemma RegexTopGateSubLkBody(r: L.Regex, lk: L.Lookaround, r1: L.Regex)
    requires RegexTopGate(r, lk, r1)
    ensures (set g | g in L.DefGroups(r1)) <= LL.LkBodyGroups(r)
    decreases r
  {
    match r
    case LookaroundR(lk2, rb) =>
      assert rb == r1;
      assert LL.LkBodyGroups(r) == (set g | g in L.DefGroups(r1)) + LL.LkBodyGroups(r1);
    case Sequence(a, b) =>
      assert LL.LkBodyGroups(r) == LL.LkBodyGroups(a) + LL.LkBodyGroups(b);
      if RegexTopGate(a, lk, r1) { RegexTopGateSubLkBody(a, lk, r1); }
      else { RegexTopGateSubLkBody(b, lk, r1); }
    case Disjunction(a, b) =>
      assert LL.LkBodyGroups(r) == LL.LkBodyGroups(a) + LL.LkBodyGroups(b);
      if RegexTopGate(a, lk, r1) { RegexTopGateSubLkBody(a, lk, r1); }
      else { RegexTopGateSubLkBody(b, lk, r1); }
    case Group(id, rb) =>
      assert LL.LkBodyGroups(r) == LL.LkBodyGroups(rb);
      RegexTopGateSubLkBody(rb, lk, r1);
    case Quantified(_, _, _, _) =>   // RegexTopGate false — vacuous
    case Epsilon =>
    case Character(_) =>
    case AnchorR(_) =>
    case Backreference(_) =>
  }

  // ---- TOP-LEVEL look def-list: the QUANTIFIER-STABLE disjointness carrier -----
  // `AllDefsActs` is a seq and its `NoDupSeq` breaks at a min>0 quantifier unfold
  // (`[Areg r1, Areg (Quantified .. r1)]` duplicates `DefGroups(r1)`). `TopLkDefsList`
  // collects only the def-groups of TOP-LEVEL looks (mirrors `RegexTopGate` — STOPS
  // at `Quantified`), so a re-entrant look under a quantifier contributes nothing
  // and the duplication vanishes. `NoDupSeq(TopLkDefsListActs(acts))` gives the
  // CheckOracle look-vs-look disjointness (crossed body ∩ sibling body == {}) and
  // is the replacement target for the `NoDupSeq(AllDefsActs)` invariant.

  /** TOP-LEVEL def-list of `r` (not under a quantifier): look bodies contribute
      their full `DefGroups`, `Group` prepends its OWN id (session 5: needed so
      the carrier also pins Open-crossing freshness — the opened gid is absent
      from every pending body ahead), quantifiers are OPAQUE. */
  ghost function TopLkDefsList(r: L.Regex): seq<LG.GroupId>
    decreases r
  {
    match r
    case LookaroundR(lk, r1) => L.DefGroups(r1)
    case Sequence(a, b) => TopLkDefsList(a) + TopLkDefsList(b)
    case Disjunction(a, b) => TopLkDefsList(a) + TopLkDefsList(b)
    case Group(gid, r1) => [gid] + TopLkDefsList(r1)
    case Quantified(_, _, _, _) => []   // STOP: re-entrant looks handled by the Reset
    case _ => []
  }

  /** Action-level lift of `TopLkDefsList`. */
  ghost function TopLkDefsListActs(acts: LS.Actions): seq<LG.GroupId>
    decreases |acts|
  {
    if |acts| == 0 then []
    else (if acts[0].Areg? then TopLkDefsList(acts[0].r) else []) + TopLkDefsListActs(acts[1..])
  }

  lemma TopLkDefsListActsCons(x: LS.Action, cont: LS.Actions)
    ensures TopLkDefsListActs([x] + cont)
         == (if x.Areg? then TopLkDefsList(x.r) else []) + TopLkDefsListActs(cont)
  { assert ([x] + cont)[0] == x && ([x] + cont)[1..] == cont; }

  /** A top-level gate's body groups are among `r`'s top-level look def-list. */
  lemma RegexTopGateSubTopLk(r: L.Regex, lk: L.Lookaround, r1: L.Regex)
    requires RegexTopGate(r, lk, r1)
    ensures (set g | g in L.DefGroups(r1)) <= (set g | g in TopLkDefsList(r))
    decreases r
  {
    match r
    case LookaroundR(lk2, rb) =>
      assert rb == r1 && TopLkDefsList(r) == L.DefGroups(r1);
    case Sequence(a, b) =>
      assert TopLkDefsList(r) == TopLkDefsList(a) + TopLkDefsList(b);
      if RegexTopGate(a, lk, r1) { RegexTopGateSubTopLk(a, lk, r1); }
      else { RegexTopGateSubTopLk(b, lk, r1); }
    case Disjunction(a, b) =>
      assert TopLkDefsList(r) == TopLkDefsList(a) + TopLkDefsList(b);
      if RegexTopGate(a, lk, r1) { RegexTopGateSubTopLk(a, lk, r1); }
      else { RegexTopGateSubTopLk(b, lk, r1); }
    case Group(id, rb) =>
      assert TopLkDefsList(r) == [id] + TopLkDefsList(rb);
      RegexTopGateSubTopLk(rb, lk, r1);
      assert forall g :: g in TopLkDefsList(rb) ==> g in TopLkDefsList(r);
    case Quantified(_, _, _, _) =>
    case Epsilon =>
    case Character(_) =>
    case AnchorR(_) =>
    case Backreference(_) =>
  }

  /** An `Areg` member's top-level look def-list is within the acts' `TopLkDefsListActs`. */
  lemma TopLkDefsListMemberSub(acts: LS.Actions, i: nat)
    requires 0 <= i < |acts| && acts[i].Areg?
    ensures (set g | g in TopLkDefsList(acts[i].r)) <= (set g | g in TopLkDefsListActs(acts))
    decreases |acts|
  {
    assert acts == [acts[0]] + acts[1..];
    TopLkDefsListActsCons(acts[0], acts[1..]);
    if i == 0 {
      assert forall g :: g in TopLkDefsList(acts[0].r) ==> g in TopLkDefsListActs(acts);
    } else {
      TopLkDefsListMemberSub(acts[1..], i - 1);
      assert acts[1..][i - 1] == acts[i];
      assert forall g :: g in TopLkDefsListActs(acts[1..]) ==> g in TopLkDefsListActs(acts);
    }
  }

  /** `NoDupSeq(TopLkDefsListActs)` threads to the tail. */
  lemma NoDupTopLkTail(acts: LS.Actions)
    requires |acts| > 0 && M.NoDupSeq(TopLkDefsListActs(acts))
    ensures M.NoDupSeq(TopLkDefsListActs(acts[1..]))
  {
    assert acts == [acts[0]] + acts[1..];
    TopLkDefsListActsCons(acts[0], acts[1..]);
    var pre: seq<LG.GroupId> := if acts[0].Areg? then TopLkDefsList(acts[0].r) else [];
    assert TopLkDefsListActs(acts) == pre + TopLkDefsListActs(acts[1..]);
    M.NoDupConcat(pre, TopLkDefsListActs(acts[1..]));
  }

  /** A regex's top-level look def-list is a SUBSEQUENCE of its full `DefGroups`
      (top-level looks contribute `DefGroups(body)`, which is among `DefGroups(r)`;
      `Group` prepends only its own id, `Quantified` drops to `[]`). Membership form. */
  lemma TopLkDefsListSubDefGroups(r: L.Regex)
    ensures forall g :: g in TopLkDefsList(r) ==> g in L.DefGroups(r)
    decreases r
  {
    match r
    case LookaroundR(lk, r1) =>
    case Sequence(a, b) =>
      TopLkDefsListSubDefGroups(a); TopLkDefsListSubDefGroups(b);
    case Disjunction(a, b) =>
      TopLkDefsListSubDefGroups(a); TopLkDefsListSubDefGroups(b);
    case Group(id, r1) =>
      TopLkDefsListSubDefGroups(r1);
    case Quantified(_, _, _, _) =>
    case Epsilon =>
    case Character(_) =>
    case AnchorR(_) =>
    case Backreference(_) =>
  }

  /** WITHIN one regex: `DefGroups` no-dup ⟹ its top-level look def-list is
      no-dup (since the latter is a subsequence). The per-`Areg` half of the
      structural NoDup. */
  lemma TopLkNoDupFromDefGroups(r: L.Regex)
    requires M.NoDupSeq(L.DefGroups(r))
    ensures M.NoDupSeq(TopLkDefsList(r))
    decreases r
  {
    match r
    case LookaroundR(lk, r1) =>
      assert TopLkDefsList(r) == L.DefGroups(r1) == L.DefGroups(r);
    case Sequence(a, b) =>
      assert L.DefGroups(r) == L.DefGroups(a) + L.DefGroups(b);
      M.NoDupConcat(L.DefGroups(a), L.DefGroups(b));
      var SA := set gx | gx in L.DefGroups(a);
      var SB := set gx | gx in L.DefGroups(b);
      assert SA * SB == {};
      TopLkNoDupFromDefGroups(a); TopLkNoDupFromDefGroups(b);
      TopLkDefsListSubDefGroups(a); TopLkDefsListSubDefGroups(b);
      forall i, j | 0 <= i < |TopLkDefsList(a)| && 0 <= j < |TopLkDefsList(b)|
        ensures TopLkDefsList(a)[i] != TopLkDefsList(b)[j]
      {
        if TopLkDefsList(a)[i] == TopLkDefsList(b)[j] {
          var g := TopLkDefsList(a)[i];
          assert g in TopLkDefsList(a) && g in TopLkDefsList(b);
          assert g in L.DefGroups(a) && g in L.DefGroups(b);
          assert g in SA && g in SB && g in SA * SB;
          assert false;
        }
      }
      M.NoDupFromDisjoint(TopLkDefsList(a), TopLkDefsList(b));
      assert TopLkDefsList(r) == TopLkDefsList(a) + TopLkDefsList(b);
    case Disjunction(a, b) =>
      assert L.DefGroups(r) == L.DefGroups(a) + L.DefGroups(b);
      M.NoDupConcat(L.DefGroups(a), L.DefGroups(b));
      var SA := set gx | gx in L.DefGroups(a);
      var SB := set gx | gx in L.DefGroups(b);
      assert SA * SB == {};
      TopLkNoDupFromDefGroups(a); TopLkNoDupFromDefGroups(b);
      TopLkDefsListSubDefGroups(a); TopLkDefsListSubDefGroups(b);
      forall i, j | 0 <= i < |TopLkDefsList(a)| && 0 <= j < |TopLkDefsList(b)|
        ensures TopLkDefsList(a)[i] != TopLkDefsList(b)[j]
      {
        if TopLkDefsList(a)[i] == TopLkDefsList(b)[j] {
          var g := TopLkDefsList(a)[i];
          assert g in TopLkDefsList(a) && g in TopLkDefsList(b);
          assert g in L.DefGroups(a) && g in L.DefGroups(b);
          assert g in SA && g in SB && g in SA * SB;
          assert false;
        }
      }
      M.NoDupFromDisjoint(TopLkDefsList(a), TopLkDefsList(b));
      assert TopLkDefsList(r) == TopLkDefsList(a) + TopLkDefsList(b);
    case Group(id, r1) =>
      assert L.DefGroups(r) == [id] + L.DefGroups(r1);
      M.NoDupConcat([id], L.DefGroups(r1));
      TopLkNoDupFromDefGroups(r1);
      TopLkDefsListSubDefGroups(r1);
      forall i, j | 0 <= i < |[id]| && 0 <= j < |TopLkDefsList(r1)|
        ensures [id][i] != TopLkDefsList(r1)[j]
      {
        if [id][i] == TopLkDefsList(r1)[j] {
          assert id in TopLkDefsList(r1);
          assert id in L.DefGroups(r1);
          assert id in (set gx | gx in [id]) * (set gx | gx in L.DefGroups(r1));
        }
      }
      M.NoDupFromDisjoint([id], TopLkDefsList(r1));
      assert TopLkDefsList(r) == [id] + TopLkDefsList(r1);
    case Quantified(_, _, _, _) =>
    case Epsilon =>
    case Character(_) =>
    case AnchorR(_) =>
    case Backreference(_) =>
  }

  /** Action-level: top-level look groups are a subset of ALL defined groups
      (per-`Areg` subsequence, lifted). Membership form. */
  lemma TopLkDefsListActsSubAllDefs(acts: LS.Actions)
    ensures forall g :: g in TopLkDefsListActs(acts) ==> g in M.AllDefsActs(acts)
    decreases |acts|
  {
    if |acts| == 0 { return; }
    assert acts == [acts[0]] + acts[1..];
    TopLkDefsListActsCons(acts[0], acts[1..]);
    M.AllDefsActsCons(acts[0], acts[1..]);
    TopLkDefsListActsSubAllDefs(acts[1..]);
    if acts[0].Areg? { TopLkDefsListSubDefGroups(acts[0].r); }
  }

  /** ACROSS the whole action list: `AllDefsActs` no-dup ⟹ `TopLkDefsListActs`
      no-dup (the latter is a per-`Areg` subsequence of the former). This is the
      converter used at a quantifier unfold: the pre-unfold `NoDupSeq(AllDefsActs)`
      establishes the post-unfold `NoDupSeq(TopLkDefsListActs)` (which the
      re-entrant `Quantified` residual no longer breaks). */
  lemma TopLkNoDupFromAllDefs(acts: LS.Actions)
    requires M.NoDupSeq(M.AllDefsActs(acts))
    ensures M.NoDupSeq(TopLkDefsListActs(acts))
    decreases |acts|
  {
    if |acts| == 0 { return; }
    assert acts == [acts[0]] + acts[1..];
    var cont := acts[1..];
    M.AllDefsActsCons(acts[0], cont);
    TopLkDefsListActsCons(acts[0], cont);
    var headAll: seq<LG.GroupId> := if acts[0].Areg? then L.DefGroups(acts[0].r) else [];
    var headTop: seq<LG.GroupId> := if acts[0].Areg? then TopLkDefsList(acts[0].r) else [];
    assert M.AllDefsActs(acts) == headAll + M.AllDefsActs(cont);
    assert TopLkDefsListActs(acts) == headTop + TopLkDefsListActs(cont);
    M.NoDupConcat(headAll, M.AllDefsActs(cont));
    var SH := set gx | gx in headAll;
    var SC := set gx | gx in M.AllDefsActs(cont);
    assert SH * SC == {};
    // head no-dup
    if acts[0].Areg? { TopLkNoDupFromDefGroups(acts[0].r); TopLkDefsListSubDefGroups(acts[0].r); }
    // tail no-dup
    TopLkNoDupFromAllDefs(cont);
    TopLkDefsListActsSubAllDefs(cont);
    // cross-disjoint: headTop ⊆ headAll, TopLkDefsListActs(cont) ⊆ AllDefsActs(cont), disjoint
    forall i, j | 0 <= i < |headTop| && 0 <= j < |TopLkDefsListActs(cont)|
      ensures headTop[i] != TopLkDefsListActs(cont)[j]
    {
      if headTop[i] == TopLkDefsListActs(cont)[j] {
        var g := headTop[i];
        assert g in headTop && g in TopLkDefsListActs(cont);
        assert g in headAll;                          // TopLkDefsListSubDefGroups / [] case
        assert g in M.AllDefsActs(cont);              // TopLkDefsListActsSubAllDefs
        assert g in SH && g in SC && g in SH * SC;
        assert false;
      }
    }
    M.NoDupFromDisjoint(headTop, TopLkDefsListActs(cont));
  }

  /** SetQuant-unfold converter: the PRE-unfold `NoDupSeq(DefGroups(r1) +
      AllDefsActs(cont))` (= `NoDupSeq(AllDefsActs([Areg(Quantified(..,r1))]+cont))`,
      since `DefGroups(Quantified(..,r1)) == DefGroups(r1)`) establishes the
      POST-unfold `NoDupSeq(TopLkDefsListActs([Areg(r1), Areg(q')]+cont))`. The
      re-entrant residual `q'=Quantified(..,r1)` contributes `[]` to
      `TopLkDefsListActs` (STOPS at Quantified), so its duplicate of
      `DefGroups(r1)` — which breaks `AllDefsActs` NoDup post-unfold — is invisible
      to `TopLkDefsListActs`. Closes the (non-nested) quantifier body-copy case. */
  lemma QuantUnfoldTopLkNoDup(r1: L.Regex, q': L.Regex, cont: LS.Actions)
    requires q'.Quantified? && q'.r1 == r1
    requires M.NoDupSeq(L.DefGroups(r1) + M.AllDefsActs(cont))
    ensures M.NoDupSeq(TopLkDefsListActs([LS.Areg(r1), LS.Areg(q')] + cont))
  {
    var acts1 := [LS.Areg(r1), LS.Areg(q')] + cont;
    assert acts1 == [LS.Areg(r1)] + ([LS.Areg(q')] + cont);
    TopLkDefsListActsCons(LS.Areg(r1), [LS.Areg(q')] + cont);
    TopLkDefsListActsCons(LS.Areg(q'), cont);
    assert TopLkDefsList(q') == [];                                  // Quantified → []
    assert TopLkDefsListActs(acts1) == TopLkDefsList(r1) + TopLkDefsListActs(cont);
    M.NoDupConcat(L.DefGroups(r1), M.AllDefsActs(cont));
    var SR := set gx | gx in L.DefGroups(r1);
    var SC := set gx | gx in M.AllDefsActs(cont);
    assert SR * SC == {};
    TopLkNoDupFromDefGroups(r1); TopLkDefsListSubDefGroups(r1);       // NoDup(TopLk r1), ⊆ DefGroups(r1)
    TopLkNoDupFromAllDefs(cont); TopLkDefsListActsSubAllDefs(cont);   // NoDup(TopLk cont), ⊆ AllDefsActs(cont)
    forall i, j | 0 <= i < |TopLkDefsList(r1)| && 0 <= j < |TopLkDefsListActs(cont)|
      ensures TopLkDefsList(r1)[i] != TopLkDefsListActs(cont)[j]
    {
      if TopLkDefsList(r1)[i] == TopLkDefsListActs(cont)[j] {
        var g := TopLkDefsList(r1)[i];
        assert g in TopLkDefsList(r1) && g in TopLkDefsListActs(cont);
        assert g in L.DefGroups(r1) && g in M.AllDefsActs(cont);
        assert g in SR && g in SC && g in SR * SC;
        assert false;
      }
    }
    M.NoDupFromDisjoint(TopLkDefsList(r1), TopLkDefsListActs(cont));
  }

  // ---- THE (C1,C2,C3) WALK-DEFS CARRIER (2026-08-07 session 5) ---------------
  // Replaces `NoDupSeq(AllDefsActs(acts))` in `WalkPairLk`/`TtLk`'s actions
  // disjunct — which is FALSE after any quantifier unfold (`[Areg r1, ...,
  // Areg(Quantified(..,r1))]` duplicates `DefGroups(r1)`, so the old carrier
  // made the invariant vacuous for grouped quantifiers). C1 is the CheckOracle
  // merge consumer (pending-vs-merged disjointness via `RegexTopGateSubTopLk`);
  // C2 the per-action structural NoDup; C3 the rightward quantifier freshness
  // that makes the UNFOLD self-maintaining: the unfolding `Quantified`'s OWN C3
  // clause is exactly the freshness of its body against the tail's top-level
  // looks, and `QuantsRightClearFromNoDup` re-establishes C3 for the copy.

  ghost function TopLkSetActs(acts: LS.Actions): set<LG.GroupId> {
    set g | g in TopLkDefsListActs(acts)
  }

  /** C3, per-regex: every top-level `Quantified` body's groups avoid `R` (the
      top-level look groups of the RIGHT context); `Sequence` widens `R` for its
      left arm by the right arm's contribution; `Disjunction` arms are
      alternatives (same `R`); STOPS at `Quantified` (inner quantifiers are
      re-established at their own unfold) and `LookaroundR` (look bodies never
      enter the walk). */
  ghost predicate QuantsRightClear(r: L.Regex, R: set<LG.GroupId>)
    decreases r
  {
    match r
    case Sequence(a, b) =>
      QuantsRightClear(a, (set g | g in TopLkDefsList(b)) + R) && QuantsRightClear(b, R)
    case Disjunction(a, b) => QuantsRightClear(a, R) && QuantsRightClear(b, R)
    case Group(_, rb) => QuantsRightClear(rb, R)
    case Quantified(_, _, _, r1) => forall g :: g in L.DefGroups(r1) ==> g !in R
    case _ => true
  }

  /** C3, per-list: each action against the top-level look groups to its right. */
  ghost predicate QuantsClearActs(acts: LS.Actions) {
    forall i | 0 <= i < |acts| && acts[i].Areg? ::
      QuantsRightClear(acts[i].r, TopLkSetActs(acts[i + 1..]))
  }

  /** THE CARRIER. */
  ghost predicate WalkDefsOk(acts: LS.Actions) {
    M.NoDupSeq(TopLkDefsListActs(acts))                                        // C1
    && (forall i | 0 <= i < |acts| && acts[i].Areg? ::
          M.NoDupSeq(L.DefGroups(acts[i].r)))                                  // C2
    && QuantsClearActs(acts)                                                   // C3
  }

  lemma QuantsRightClearMono(r: L.Regex, R: set<LG.GroupId>, R2: set<LG.GroupId>)
    requires QuantsRightClear(r, R) && R2 <= R
    ensures QuantsRightClear(r, R2)
    decreases r
  {
    match r
    case Sequence(a, b) =>
      QuantsRightClearMono(a, (set g | g in TopLkDefsList(b)) + R,
                           (set g | g in TopLkDefsList(b)) + R2);
      QuantsRightClearMono(b, R, R2);
    case Disjunction(a, b) =>
      QuantsRightClearMono(a, R, R2); QuantsRightClearMono(b, R, R2);
    case Group(_, rb) => QuantsRightClearMono(rb, R, R2);
    case Quantified(_, _, _, _) =>
    case _ =>
  }

  /** C3 from structural NoDup + body-freshness — the unfold's re-establishment
      workhorse: a dup-free-defs regex whose groups avoid `R` is
      `QuantsRightClear` at `R`. */
  lemma QuantsRightClearFromNoDup(r: L.Regex, R: set<LG.GroupId>)
    requires M.NoDupSeq(L.DefGroups(r))
    requires forall g :: g in L.DefGroups(r) ==> g !in R
    ensures QuantsRightClear(r, R)
    decreases r
  {
    match r
    case Sequence(a, b) =>
      assert L.DefGroups(r) == L.DefGroups(a) + L.DefGroups(b);
      M.NoDupConcat(L.DefGroups(a), L.DefGroups(b));
      TopLkDefsListSubDefGroups(b);
      var Rb := (set g | g in TopLkDefsList(b)) + R;
      forall g | g in L.DefGroups(a) ensures g !in Rb {
        assert g in L.DefGroups(r);
        if g in TopLkDefsList(b) {
          assert g in L.DefGroups(b);
          assert g in (set gx | gx in L.DefGroups(a)) * (set gx | gx in L.DefGroups(b));
        }
      }
      QuantsRightClearFromNoDup(a, Rb);
      forall g | g in L.DefGroups(b) ensures g !in R { assert g in L.DefGroups(r); }
      QuantsRightClearFromNoDup(b, R);
    case Disjunction(a, b) =>
      assert L.DefGroups(r) == L.DefGroups(a) + L.DefGroups(b);
      M.NoDupConcat(L.DefGroups(a), L.DefGroups(b));
      forall g | g in L.DefGroups(a) ensures g !in R { assert g in L.DefGroups(r); }
      QuantsRightClearFromNoDup(a, R);
      forall g | g in L.DefGroups(b) ensures g !in R { assert g in L.DefGroups(r); }
      QuantsRightClearFromNoDup(b, R);
    case Group(id, rb) =>
      assert L.DefGroups(r) == [id] + L.DefGroups(rb);
      M.NoDupConcat([id], L.DefGroups(rb));
      forall g | g in L.DefGroups(rb) ensures g !in R { assert g in L.DefGroups(r); }
      QuantsRightClearFromNoDup(rb, R);
    case Quantified(_, _, _, r1) =>
      assert L.DefGroups(r) == L.DefGroups(r1);
    case _ =>
  }

  /** Carrier tail: drop the head. */
  lemma WalkDefsOkTail(acts: LS.Actions)
    requires |acts| > 0 && WalkDefsOk(acts)
    ensures WalkDefsOk(acts[1..])
  {
    NoDupTopLkTail(acts);
    forall i | 0 <= i < |acts[1..]| && acts[1..][i].Areg?
      ensures M.NoDupSeq(L.DefGroups(acts[1..][i].r))
              && QuantsRightClear(acts[1..][i].r, TopLkSetActs(acts[1..][i + 1..]))
    {
      assert acts[1..][i] == acts[i + 1];
      assert acts[1..][i + 1..] == acts[i + 2..];
    }
  }

  /** Carrier across the `Sequence` two-head expand: the TopLk list is the SAME
      sequence, the head's C3 clause unfolds DEFINITIONALLY into the two new
      heads' clauses. */
  lemma WalkDefsOkSeqExpand(acts: LS.Actions, r1: L.Regex, r2: L.Regex)
    requires |acts| > 0 && acts[0] == LS.Areg(L.Sequence(r1, r2))
    requires WalkDefsOk(acts)
    ensures WalkDefsOk([LS.Areg(r1), LS.Areg(r2)] + acts[1..])
  {
    var cont := acts[1..];
    var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
    assert acts == [acts[0]] + cont;
    // C1: same TopLk sequence
    TopLkDefsListActsCons(acts[0], cont);
    TopLkDefsListActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
    TopLkDefsListActsCons(LS.Areg(r2), cont);
    assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
    assert TopLkDefsList(L.Sequence(r1, r2)) == TopLkDefsList(r1) + TopLkDefsList(r2);
    assert TopLkDefsListActs(na)
        == TopLkDefsList(r1) + (TopLkDefsList(r2) + TopLkDefsListActs(cont));
    assert TopLkDefsList(r1) + (TopLkDefsList(r2) + TopLkDefsListActs(cont))
        == (TopLkDefsList(r1) + TopLkDefsList(r2)) + TopLkDefsListActs(cont);
    assert TopLkDefsListActs(na) == TopLkDefsListActs(acts);
    // C2: split the head's NoDup
    assert M.NoDupSeq(L.DefGroups(L.Sequence(r1, r2)));
    assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
    M.NoDupConcat(L.DefGroups(r1), L.DefGroups(r2));
    // C3
    assert QuantsRightClear(L.Sequence(r1, r2), TopLkSetActs(cont));
    assert TopLkSetActs([LS.Areg(r2)] + cont)
        == (set g | g in TopLkDefsList(r2)) + TopLkSetActs(cont) by {
      forall g ensures g in TopLkSetActs([LS.Areg(r2)] + cont)
                   <==> g in ((set gx | gx in TopLkDefsList(r2)) + TopLkSetActs(cont)) {
      }
    }
    forall i | 0 <= i < |na| && na[i].Areg?
      ensures M.NoDupSeq(L.DefGroups(na[i].r))
              && QuantsRightClear(na[i].r, TopLkSetActs(na[i + 1..]))
    {
      if i == 0 {
        assert na[0] == LS.Areg(r1) && na[1..] == [LS.Areg(r2)] + cont;
      } else if i == 1 {
        assert na[1] == LS.Areg(r2) && na[2..] == cont;
      } else {
        assert na[i] == cont[i - 2] == acts[i - 1];
        assert na[i + 1..] == cont[i - 1..] == acts[i..];
      }
    }
  }

  /** Carrier across the `Group` expand (`[Areg rb, Aclose gid] + cont`). */
  lemma WalkDefsOkGroupExpand(acts: LS.Actions, gid: LG.GroupId, rb: L.Regex)
    requires |acts| > 0 && acts[0] == LS.Areg(L.Group(gid, rb))
    requires WalkDefsOk(acts)
    ensures WalkDefsOk([LS.Areg(rb), LS.Aclose(gid)] + acts[1..])
  {
    var cont := acts[1..];
    var na := [LS.Areg(rb), LS.Aclose(gid)] + cont;
    assert acts == [acts[0]] + cont;
    // C1: Group is TopLk-transparent, Aclose contributes []
    TopLkDefsListActsCons(acts[0], cont);
    TopLkDefsListActsCons(LS.Areg(rb), [LS.Aclose(gid)] + cont);
    TopLkDefsListActsCons(LS.Aclose(gid), cont);
    assert na == [LS.Areg(rb)] + ([LS.Aclose(gid)] + cont);
    assert TopLkDefsList(L.Group(gid, rb)) == [gid] + TopLkDefsList(rb);
    assert TopLkDefsListActs(acts)
        == ([gid] + TopLkDefsList(rb)) + TopLkDefsListActs(cont);
    assert ([gid] + TopLkDefsList(rb)) + TopLkDefsListActs(cont)
        == [gid] + (TopLkDefsList(rb) + TopLkDefsListActs(cont));
    M.NoDupConcat([gid], TopLkDefsList(rb) + TopLkDefsListActs(cont));
    assert TopLkDefsListActs(na) == TopLkDefsList(rb) + TopLkDefsListActs(cont);
    // C2
    assert M.NoDupSeq(L.DefGroups(L.Group(gid, rb)));
    assert L.DefGroups(L.Group(gid, rb)) == [gid] + L.DefGroups(rb);
    M.NoDupConcat([gid], L.DefGroups(rb));
    // C3
    assert QuantsRightClear(L.Group(gid, rb), TopLkSetActs(cont));
    assert TopLkSetActs([LS.Aclose(gid)] + cont) == TopLkSetActs(cont) by {
      forall g ensures g in TopLkSetActs([LS.Aclose(gid)] + cont) <==> g in TopLkSetActs(cont) {
      }
    }
    forall i | 0 <= i < |na| && na[i].Areg?
      ensures M.NoDupSeq(L.DefGroups(na[i].r))
              && QuantsRightClear(na[i].r, TopLkSetActs(na[i + 1..]))
    {
      if i == 0 {
        assert na[0] == LS.Areg(rb) && na[1..] == [LS.Aclose(gid)] + cont;
      } else if i == 1 {
      } else {
        assert na[i] == cont[i - 2] == acts[i - 1];
        assert na[i + 1..] == cont[i - 1..] == acts[i..];
      }
    }
  }

  /** Carrier at the single-action entry (`[Areg rex]`). */
  lemma WalkDefsOkEntry(rex: L.Regex)
    requires M.NoDupSeq(L.DefGroups(rex))
    ensures WalkDefsOk([LS.Areg(rex)])
  {
    var acts := [LS.Areg(rex)];
    TopLkDefsListActsCons(LS.Areg(rex), []);
    assert TopLkDefsListActs(acts) == TopLkDefsList(rex) + [] == TopLkDefsList(rex);
    TopLkNoDupFromDefGroups(rex);
    assert acts[1..] == [];
    assert TopLkSetActs([]) == {};
    QuantsRightClearFromNoDup(rex, {});
  }

  /** THE UNFOLD: carrier across a quantifier body-copy expansion
      `[Areg(Quantified(.., r1))] + cont  ⟶  [Areg r1] ++ mid ++ [Areg q'] + cont`
      stated for the two shapes the walk produces (`mid` = `[]` for the min>0
      forced copy, `[Acheck(inp0)]` for the star/backfork iteration arm). The
      unfolding node's OWN C3 clause supplies the body-vs-tail freshness; C2
      supplies the body's structural NoDup; the residual `q'` is TopLk-opaque. */
  lemma WalkDefsOkUnfold(acts: LS.Actions, r1: L.Regex, q': L.Regex, mid: LS.Actions)
    requires |acts| > 0 && acts[0].Areg? && acts[0].r.Quantified? && acts[0].r.r1 == r1
    requires q'.Quantified? && q'.r1 == r1
    requires mid == [] || (|mid| == 1 && mid[0].Acheck?)
    requires WalkDefsOk(acts)
    ensures WalkDefsOk([LS.Areg(r1)] + mid + [LS.Areg(q')] + acts[1..])
  {
    var cont := acts[1..];
    var na := [LS.Areg(r1)] + mid + [LS.Areg(q')] + cont;
    assert acts == [acts[0]] + cont;
    // structural facts from the folded head
    assert M.NoDupSeq(L.DefGroups(acts[0].r));
    assert L.DefGroups(acts[0].r) == L.DefGroups(r1);
    assert QuantsRightClear(acts[0].r, TopLkSetActs(cont));
    assert forall g :: g in L.DefGroups(r1) ==> g !in TopLkSetActs(cont);
    // the TopLk view of the unfolded list: TopLk(r1) ++ TopLk(cont)
    var tail1 := mid + [LS.Areg(q')] + cont;
    var tail2 := [LS.Areg(q')] + cont;
    assert na == [LS.Areg(r1)] + tail1;
    TopLkDefsListActsCons(LS.Areg(r1), tail1);
    TopLkDefsListActsCons(LS.Areg(q'), cont);
    assert TopLkDefsList(q') == [];
    assert TopLkDefsListActs(tail2) == TopLkDefsListActs(cont);
    if |mid| == 1 {
      assert tail1 == [mid[0]] + tail2;
      TopLkDefsListActsCons(mid[0], tail2);
      assert TopLkDefsListActs(tail1) == TopLkDefsListActs(tail2);
    } else {
      assert tail1 == tail2;
    }
    assert TopLkDefsListActs(na) == TopLkDefsList(r1) + TopLkDefsListActs(cont);
    // C1: NoDup(TopLk(r1)) structural + disjoint from TopLk(cont) via the C3 clause
    TopLkNoDupFromDefGroups(r1);
    TopLkDefsListSubDefGroups(r1);
    NoDupTopLkTail(acts);
    forall i, j | 0 <= i < |TopLkDefsList(r1)| && 0 <= j < |TopLkDefsListActs(cont)|
      ensures TopLkDefsList(r1)[i] != TopLkDefsListActs(cont)[j]
    {
      if TopLkDefsList(r1)[i] == TopLkDefsListActs(cont)[j] {
        var g := TopLkDefsList(r1)[i];
        assert g in L.DefGroups(r1);
        assert g in TopLkSetActs(cont);
        assert false;
      }
    }
    M.NoDupFromDisjoint(TopLkDefsList(r1), TopLkDefsListActs(cont));
    // C2 + C3 per index
    var koff := |mid| + 2;   // na[koff + k] == cont[k]
    forall i | 0 <= i < |na| && na[i].Areg?
      ensures M.NoDupSeq(L.DefGroups(na[i].r))
              && QuantsRightClear(na[i].r, TopLkSetActs(na[i + 1..]))
    {
      if i == 0 {
        assert na[0] == LS.Areg(r1) && na[1..] == tail1;
        assert TopLkSetActs(tail1) == TopLkSetActs(cont) by {
          forall g ensures g in TopLkSetActs(tail1) <==> g in TopLkSetActs(cont) {}
        }
        QuantsRightClearFromNoDup(r1, TopLkSetActs(cont));
      } else if i < koff - 1 {
        // mid slot (Acheck): not Areg — vacuous
        assert na[i] == mid[i - 1];
      } else if i == koff - 1 {
        assert na[i] == LS.Areg(q') && na[i + 1..] == cont;
        assert L.DefGroups(q') == L.DefGroups(r1);
        forall g | g in L.DefGroups(q') ensures g !in TopLkSetActs(cont) {}
      } else {
        assert na[i] == cont[i - koff] == acts[i - koff + 1];
        assert na[i + 1..] == cont[i - koff + 1..] == acts[i - koff + 2..];
      }
    }
  }

  /** A gate pending in a chosen `Disjunction` arm's list is pending in the
      folded list (the arm folds into the `Disjunction` top-gate; tail shared). */
  lemma GatePendingDisjBack(acts: LS.Actions, r1: L.Regex, r2: L.Regex, arm: L.Regex,
                            lk: L.Lookaround, rr: L.Regex)
    requires |acts| > 0 && acts[0] == LS.Areg(L.Disjunction(r1, r2))
    requires arm == r1 || arm == r2
    requires GatePending([LS.Areg(arm)] + acts[1..], lk, rr)
    ensures GatePending(acts, lk, rr)
  {
    var na := [LS.Areg(arm)] + acts[1..];
    var i :| 0 <= i < |na| && na[i].Areg? && RegexTopGate(na[i].r, lk, rr);
    if i == 0 {
      assert RegexTopGate(L.Disjunction(r1, r2), lk, rr);
      assert acts[0].Areg? && RegexTopGate(acts[0].r, lk, rr);
    } else {
      assert na[i] == acts[1..][i - 1] == acts[i];
      assert acts[i].Areg? && RegexTopGate(acts[i].r, lk, rr);
    }
  }

  /** `GateAheadClear` across a `Disjunction` arm choice. */
  lemma GateAheadClearDisjArm(acts: LS.Actions, r1: L.Regex, r2: L.Regex, arm: L.Regex,
                              gmt: LG.GroupMap)
    requires |acts| > 0 && acts[0] == LS.Areg(L.Disjunction(r1, r2)) && GateAheadClear(acts, gmt)
    requires arm == r1 || arm == r2
    ensures GateAheadClear([LS.Areg(arm)] + acts[1..], gmt)
  {
    forall lk: L.Lookaround, rr: L.Regex | GatePending([LS.Areg(arm)] + acts[1..], lk, rr)
      ensures forall g :: g in L.DefGroups(rr) ==> g !in gmt
    { GatePendingDisjBack(acts, r1, r2, arm, lk, rr); }
  }

  /** Carrier across a `Disjunction` arm choice: the other arm's TopLk block is
      DROPPED (a sub-concat of the C1 NoDup); C2/C3 select the arm's halves. */
  lemma WalkDefsOkDisjArm(acts: LS.Actions, r1: L.Regex, r2: L.Regex, arm: L.Regex)
    requires |acts| > 0 && acts[0] == LS.Areg(L.Disjunction(r1, r2))
    requires WalkDefsOk(acts)
    requires arm == r1 || arm == r2
    ensures WalkDefsOk([LS.Areg(arm)] + acts[1..])
  {
    var cont := acts[1..];
    var na := [LS.Areg(arm)] + cont;
    assert acts == [acts[0]] + cont;
    TopLkDefsListActsCons(acts[0], cont);
    TopLkDefsListActsCons(LS.Areg(arm), cont);
    var A1 := TopLkDefsList(r1);
    var A2 := TopLkDefsList(r2);
    var C := TopLkDefsListActs(cont);
    assert TopLkDefsList(L.Disjunction(r1, r2)) == A1 + A2;
    assert TopLkDefsListActs(acts) == (A1 + A2) + C;
    assert (A1 + A2) + C == A1 + (A2 + C);
    M.NoDupConcat(A1, A2 + C);
    M.NoDupConcat(A2, C);
    var AA := TopLkDefsList(arm);
    assert TopLkDefsListActs(na) == AA + C;
    // C1: NoDup(AA + C) — AA is one of A1/A2; disjointness from C in both cases
    forall i, j | 0 <= i < |AA| && 0 <= j < |C| ensures AA[i] != C[j] {
      if AA[i] == C[j] {
        var g := AA[i];
        if arm == r1 {
          assert g in A1 && g in (A2 + C);
          assert g in (set gx | gx in A1) * (set gx | gx in A2 + C);
        } else {
          assert g in A2 && g in C;
          assert g in (set gx | gx in A2) * (set gx | gx in C);
        }
      }
    }
    M.NoDupFromDisjoint(AA, C);
    // C2: split the head's DefGroups NoDup
    assert M.NoDupSeq(L.DefGroups(L.Disjunction(r1, r2)));
    assert L.DefGroups(L.Disjunction(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
    M.NoDupConcat(L.DefGroups(r1), L.DefGroups(r2));
    // C3: the head clause's arm conjunct (Disjunction arms share R); shifts
    assert QuantsRightClear(L.Disjunction(r1, r2), TopLkSetActs(cont));
    forall i | 0 <= i < |na| && na[i].Areg?
      ensures M.NoDupSeq(L.DefGroups(na[i].r))
              && QuantsRightClear(na[i].r, TopLkSetActs(na[i + 1..]))
    {
      if i == 0 {
        assert na[0] == LS.Areg(arm) && na[1..] == cont;
      } else {
        assert na[i] == cont[i - 1] == acts[i];
        assert na[i + 1..] == cont[i..] == acts[i + 1..];
      }
    }
  }

  /** An `Areg` member's body groups are among the action list's `AllDefsActs`. */
  lemma AllDefsActsMemberSub(acts: LS.Actions, i: nat)
    requires 0 <= i < |acts| && acts[i].Areg?
    ensures (set g | g in L.DefGroups(acts[i].r)) <= (set g | g in M.AllDefsActs(acts))
    decreases |acts|
  {
    assert acts == [acts[0]] + acts[1..];
    M.AllDefsActsCons(acts[0], acts[1..]);   // AllDefsActs(acts) == DefGroups(acts[0].r) + AllDefsActs(acts[1..])
    if i == 0 {
      assert forall g :: g in L.DefGroups(acts[0].r) ==> g in M.AllDefsActs(acts);
    } else {
      AllDefsActsMemberSub(acts[1..], i - 1);
      assert acts[1..][i - 1] == acts[i];
      assert forall g :: g in M.AllDefsActs(acts[1..]) ==> g in M.AllDefsActs(acts);
    }
  }

  /** Two dup-free translated `DefGroups` sequences over CAP-DISJOINT `R.regex`
      concatenate dup-free — the alt/con step of `TranslateDefGroupsNoDup`. */
  lemma NoDupAltCon(r1: R.regex, r2: R.regex)
    requires T.TransWf(r1) && T.TransWf(r2)
    requires M.NoDupSeq(L.DefGroups(T.Translate(r1))) && M.NoDupSeq(L.DefGroups(T.Translate(r2)))
    requires (set g | g in L.DefGroups(T.Translate(r1))) == PIV.CapIds(r1)
    requires (set g | g in L.DefGroups(T.Translate(r2))) == PIV.CapIds(r2)
    requires PIV.CapIds(r1) * PIV.CapIds(r2) == {}
    ensures M.NoDupSeq(L.DefGroups(T.Translate(r1)) + L.DefGroups(T.Translate(r2)))
  {
    var a := L.DefGroups(T.Translate(r1));
    var b := L.DefGroups(T.Translate(r2));
    assert forall i, j :: 0 <= i < |a| && 0 <= j < |b| ==> a[i] != b[j] by {
      forall i, j | 0 <= i < |a| && 0 <= j < |b| ensures a[i] != b[j] {
        assert a[i] in (set g | g in a) && a[i] in PIV.CapIds(r1);
        assert b[j] in (set g | g in b) && b[j] in PIV.CapIds(r2);
        if a[i] == b[j] { assert a[i] in PIV.CapIds(r1) * PIV.CapIds(r2); }   // contradicts disjoint
      }
    }
    M.NoDupFromDisjoint(a, b);
  }

  /** The translated regex's `DefGroups` sequence has NO DUPLICATES: sibling
      subtrees get disjoint cap ids (`CapUnique`), a capture's own id is fresh
      (`cid ∉ CapIds(body)`). The seq-level companion of
      `M.TranslateDefGroupsEqCapIds` (which gives only the set). This is what feeds
      the `NoDupSeq(AllDefsActs)` walk-invariant at the entry (`LiftInit`). */
  lemma TranslateDefGroupsNoDup(r: R.regex)
    requires T.TransWf(r) && PIV.CapUnique(r)
    ensures M.NoDupSeq(L.DefGroups(T.Translate(r)))
    decreases r
  {
    match r
    case Re_empty =>
    case Re_character(_) =>
    case Re_anchor(_) =>
    case Re_alt(r1, r2) =>
      TranslateDefGroupsNoDup(r1); TranslateDefGroupsNoDup(r2);
      M.TranslateDefGroupsEqCapIds(r1); M.TranslateDefGroupsEqCapIds(r2);
      assert L.DefGroups(T.Translate(r)) == L.DefGroups(T.Translate(r1)) + L.DefGroups(T.Translate(r2));
      NoDupAltCon(r1, r2);
    case Re_con(r1, r2) =>
      TranslateDefGroupsNoDup(r1); TranslateDefGroupsNoDup(r2);
      M.TranslateDefGroupsEqCapIds(r1); M.TranslateDefGroupsEqCapIds(r2);
      assert L.DefGroups(T.Translate(r)) == L.DefGroups(T.Translate(r1)) + L.DefGroups(T.Translate(r2));
      NoDupAltCon(r1, r2);
    case Re_quant(_, _, q, r1) =>
      TranslateDefGroupsNoDup(r1);
      assert L.DefGroups(T.Translate(r)) == L.DefGroups(T.Translate(r1));
    case Re_capture(cid, r1) =>
      TranslateDefGroupsNoDup(r1);
      M.TranslateDefGroupsEqCapIds(r1);   // set(DefGroups(Translate(r1))) == CapIds(r1)
      assert L.DefGroups(T.Translate(r)) == [cid as nat] + L.DefGroups(T.Translate(r1));
      assert (cid as nat) !in PIV.CapIds(r1);   // CapUnique(capture)
      assert forall j :: 0 <= j < |L.DefGroups(T.Translate(r1))| ==> L.DefGroups(T.Translate(r1))[j] != cid as nat by {
        forall j | 0 <= j < |L.DefGroups(T.Translate(r1))| ensures L.DefGroups(T.Translate(r1))[j] != cid as nat {
          assert L.DefGroups(T.Translate(r1))[j] in (set g | g in L.DefGroups(T.Translate(r1)));
        }
      }
      M.NoDupPrepend(cid as nat, L.DefGroups(T.Translate(r1)));
    case Re_lookaround(_, lk, r1) =>
      TranslateDefGroupsNoDup(r1);
      assert L.DefGroups(T.Translate(r)) == L.DefGroups(T.Translate(r1));
  }

  // ---- (C) the ComputeTr shape fact -----------------------------------------

  /** No `Backreference` anywhere in a Linden regex (including inside lookaround
      bodies). `Translate` NEVER emits a `Backreference`, so every translated
      regex satisfies this — which is exactly what keeps `ReadBackRef` (the one
      shape `PikeSubtreeLk` forbids) out of the computed tree. */
  predicate NoBackrefRegex(r: L.Regex)
    decreases r
  {
    match r
    case Epsilon => true
    case Character(_) => true
    case Disjunction(r1, r2) => NoBackrefRegex(r1) && NoBackrefRegex(r2)
    case Sequence(r1, r2) => NoBackrefRegex(r1) && NoBackrefRegex(r2)
    case Quantified(_, _, _, r1) => NoBackrefRegex(r1)
    case Group(_, r1) => NoBackrefRegex(r1)
    case LookaroundR(_, r1) => NoBackrefRegex(r1)
    case AnchorR(_) => true
    case Backreference(_) => false
  }

  predicate NoBackrefAction(a: LS.Action) {
    match a case Areg(r) => NoBackrefRegex(r) case Aclose(_) => true case Acheck(_) => true
  }

  predicate NoBackrefActions(acts: LS.Actions) {
    forall i :: 0 <= i < |acts| ==> NoBackrefAction(acts[i])
  }

  lemma NoBackrefActionsTail(act: LS.Actions)
    requires |act| > 0 && NoBackrefActions(act)
    ensures NoBackrefActions(act[1..])
  {
    forall i | 0 <= i < |act[1..]| ensures NoBackrefAction(act[1..][i]) { assert act[1..][i] == act[i + 1]; }
  }

  lemma NoBackrefActionsCons(a: LS.Action, cont: LS.Actions)
    ensures NoBackrefActions([a] + cont) <==> (NoBackrefAction(a) && NoBackrefActions(cont))
  {
    if NoBackrefAction(a) && NoBackrefActions(cont) {
      forall i | 0 <= i < |[a] + cont| ensures NoBackrefAction(([a] + cont)[i]) {
        if i == 0 {} else { assert ([a] + cont)[i] == cont[i - 1]; }
      }
    } else if NoBackrefActions([a] + cont) {
      assert ([a] + cont)[0] == a;
      forall i | 0 <= i < |cont| ensures NoBackrefAction(cont[i]) { assert cont[i] == ([a] + cont)[i + 1]; }
    }
  }

  /** `Translate` produces a backreference-free Linden regex. */
  lemma TranslateNoBackref(re: R.regex)
    requires T.TransWf(re)
    ensures NoBackrefRegex(T.Translate(re))
    decreases re
  {
    match re
    case Re_empty =>
    case Re_character(c) =>
    case Re_alt(r1, r2) => TranslateNoBackref(r1); TranslateNoBackref(r2);
    case Re_con(r1, r2) => TranslateNoBackref(r1); TranslateNoBackref(r2);
    case Re_quant(_, _, q, r1) => TranslateNoBackref(r1);
    case Re_capture(cid, r1) => TranslateNoBackref(r1);
    case Re_lookaround(_, lk, r1) => TranslateNoBackref(r1);
    case Re_anchor(a) =>
  }

  /** Fuel-induction workhorse (LK-aware mirror of `PS.ComputePikeSubtree`):
      running `ComputeTree` on a backref-free action stack yields a
      `PikeSubtreeLk` tree — the only forbidden shape (`ReadBackRef`) comes
      solely from `Backreference`, which `NoBackrefActions` rules out. The
      LK/LKFail cases are now PRODUCED (not contradictions); the lookaround BODY
      is never recursed into (`PikeSubtreeLk` leaves it unconstrained), only the
      continuation. */
  lemma ComputePikeSubtreeLk(rer: LW.RegExpRecord, act: LS.Actions, inp: LC.Input,
                             gm: LG.GroupMap, dir: WP.Direction, fuel: nat, t: LT.Tree)
    requires NoBackrefActions(act)
    requires FS.ComputeTree(rer, act, inp, gm, dir, fuel) == Some(t)
    ensures PTL.PikeSubtreeLk(t)
    decreases fuel
  {
    var f := fuel - 1;
    if |act| == 0 {
    } else {
      var cont := act[1..];
      NoBackrefActionsTail(act);            // NoBackrefActions(cont)
      assert act == [act[0]] + cont;
      NoBackrefActionsCons(act[0], cont);   // NoBackrefAction(act[0])
      match act[0]
      case Acheck(strcheck) =>
        if SSx.IsStrictSuffix(inp, strcheck, dir) {
          var sub := FS.ComputeTree(rer, cont, inp, gm, dir, f);
          if sub.Some? { ComputePikeSubtreeLk(rer, cont, inp, gm, dir, f, sub.value); }
        }
      case Aclose(gid) =>
        var gm' := LG.GMClose(LC.Idx(inp), gid, gm);
        var sub := FS.ComputeTree(rer, cont, inp, gm', dir, f);
        if sub.Some? { ComputePikeSubtreeLk(rer, cont, inp, gm', dir, f, sub.value); }
      case Areg(r) =>
        assert NoBackrefRegex(r);
        match r
        case Epsilon =>
          ComputePikeSubtreeLk(rer, cont, inp, gm, dir, f, t);
        case Character(cd) =>
          match LC.ReadChar(rer, cd, inp, dir) {
            case None =>
            case Some(pair) =>
              var sub := FS.ComputeTree(rer, cont, pair.1, gm, dir, f);
              if sub.Some? { ComputePikeSubtreeLk(rer, cont, pair.1, gm, dir, f, sub.value); }
          }
        case Disjunction(r1, r2) =>
          NoBackrefActionsCons(LS.Areg(r1), cont);
          NoBackrefActionsCons(LS.Areg(r2), cont);
          var s1 := FS.ComputeTree(rer, [LS.Areg(r1)] + cont, inp, gm, dir, f);
          var s2 := FS.ComputeTree(rer, [LS.Areg(r2)] + cont, inp, gm, dir, f);
          if s1.Some? { ComputePikeSubtreeLk(rer, [LS.Areg(r1)] + cont, inp, gm, dir, f, s1.value); }
          if s2.Some? { ComputePikeSubtreeLk(rer, [LS.Areg(r2)] + cont, inp, gm, dir, f, s2.value); }
        case Sequence(r1, r2) =>
          var na := LS.SeqList(r1, r2, dir) + cont;
          assert NoBackrefActions(na) by {
            match dir
            case Forward =>
              assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
              NoBackrefActionsCons(LS.Areg(r2), cont);
              NoBackrefActionsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
            case Backward =>
              assert na == [LS.Areg(r2)] + ([LS.Areg(r1)] + cont);
              NoBackrefActionsCons(LS.Areg(r1), cont);
              NoBackrefActionsCons(LS.Areg(r2), [LS.Areg(r1)] + cont);
          }
          var sub := FS.ComputeTree(rer, na, inp, gm, dir, f);
          if sub.Some? { ComputePikeSubtreeLk(rer, na, inp, gm, dir, f, sub.value); }
        case Quantified(greedy, min, delta, r1) =>
          var gidl := L.DefGroups(r1);
          if min > 0 {
            var quant := L.Quantified(greedy, min - 1, delta, r1);
            var na := [LS.Areg(r1), LS.Areg(quant)] + cont;
            var gm' := LG.GMReset(gidl, gm);
            assert NoBackrefActions(na) by {
              assert na == [LS.Areg(r1)] + ([LS.Areg(quant)] + cont);
              NoBackrefActionsCons(LS.Areg(quant), cont);
              NoBackrefActionsCons(LS.Areg(r1), [LS.Areg(quant)] + cont);
            }
            var sub := FS.ComputeTree(rer, na, inp, gm', dir, f);
            if sub.Some? { ComputePikeSubtreeLk(rer, na, inp, gm', dir, f, sub.value); }
          } else if delta == LN.NN(0) {
            var sub := FS.ComputeTree(rer, cont, inp, gm, dir, f);
            if sub.Some? { ComputePikeSubtreeLk(rer, cont, inp, gm, dir, f, sub.value); }
          } else {
            var quant := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
            var na := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont;
            var gm' := LG.GMReset(gidl, gm);
            assert NoBackrefActions(na) by {
              assert na == [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
              NoBackrefActionsCons(LS.Areg(quant), cont);
              NoBackrefActionsCons(LS.Acheck(inp), [LS.Areg(quant)] + cont);
              NoBackrefActionsCons(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
            }
            var siter := FS.ComputeTree(rer, na, inp, gm', dir, f);
            var sskip := FS.ComputeTree(rer, cont, inp, gm, dir, f);
            if siter.Some? { ComputePikeSubtreeLk(rer, na, inp, gm', dir, f, siter.value); }
            if sskip.Some? { ComputePikeSubtreeLk(rer, cont, inp, gm, dir, f, sskip.value); }
          }
        case Group(gid, r1) =>
          var na := [LS.Areg(r1), LS.Aclose(gid)] + cont;
          var gm' := LG.GMOpen(LC.Idx(inp), gid, gm);
          assert NoBackrefActions(na) by {
            assert na == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
            NoBackrefActionsCons(LS.Aclose(gid), cont);
            NoBackrefActionsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont);
          }
          var sub := FS.ComputeTree(rer, na, inp, gm', dir, f);
          if sub.Some? { ComputePikeSubtreeLk(rer, na, inp, gm', dir, f, sub.value); }
        case LookaroundR(lk, r1) =>
          // THE LK/LKFail case: the body treelk is NOT recursed into
          // (PikeSubtreeLk leaves it unconstrained); only the continuation.
          var slk := FS.ComputeTree(rer, [LS.Areg(r1)], inp, gm, L.LkDir(lk), f);
          match slk {
            case None =>
            case Some(treelk) =>
              match LS.LkResult(lk, treelk, gm, inp) {
                case Some(gmlk) =>
                  var sc := FS.ComputeTree(rer, cont, inp, gmlk, dir, f);
                  if sc.Some? { ComputePikeSubtreeLk(rer, cont, inp, gmlk, dir, f, sc.value); }
                case None =>   // t == LKFail(lk, treelk); PikeSubtreeLk trivially
              }
          }
        case AnchorR(a) =>
          if LS.AnchorSatisfied(rer, a, inp) {
            var sub := FS.ComputeTree(rer, cont, inp, gm, dir, f);
            if sub.Some? { ComputePikeSubtreeLk(rer, cont, inp, gm, dir, f, sub.value); }
          }
        case Backreference(gid) =>   // NoBackrefRegex(r) is false here — vacuous
    }
  }

  /** [SOLID] The spec tree builder only produces machine-B-explorable shapes
      (no `ReadBackRef` in the fragment; LK bodies are unconstrained). */
  lemma PikeSubtreeLkComputeTr(rer: LW.RegExpRecord, re: R.regex, str: string)
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re)
    ensures PTL.PikeSubtreeLk(
      LFU.ComputeTr(rer, [LS.Areg(T.Translate(re))], LC.InitInput(str), LG.Empty, WP.Forward))
  {
    var act := [LS.Areg(T.Translate(re))];
    var inp := LC.InitInput(str);
    TranslateNoBackref(re);
    assert NoBackrefActions(act) by {
      assert act[0] == LS.Areg(T.Translate(re));
    }
    var fuel := FS.ActionsFuel(act, inp, WP.Forward) + 1;
    LFU.SubComputeTr(rer, act, inp, LG.Empty, WP.Forward, fuel);
    var t := LFU.ComputeTr(rer, act, inp, LG.Empty, WP.Forward);
    assert FS.ComputeTree(rer, act, inp, LG.Empty, WP.Forward, fuel) == Some(t);
    ComputePikeSubtreeLk(rer, act, inp, LG.Empty, WP.Forward, fuel, t);
  }

  // ---- (V) the value bridge into MainExtraction ------------------------------

  /** The FREE half of the winning leaf's value tie: OUTSIDE `S`, the leaf gm
      equals the winning thread's live denotation — no sim, no (E) path-presence.
      It is pure machine-A + leaf agreement: `BestMatchRE` gives the tstar first
      leaf's gm IS `GmOfLive(re, th.caps)`, and `FirstLeafAgreeOutside` gives that
      same gm agrees with the t-side leaf `leafgm` outside `S`. `GmAgreeOutside`
      is symmetric in the value clause, so it flips to `GmtTieOutside`'s shape
      (leaf-keyed). This is the exact `GmtTieOutside` hypothesis `L3aValueBridge`
      consumes for its outside-`S` branch, discharged from already-proven facts. */
  // ==========================================================================
  // (E3) THE LOOK-PATH CARRIER (per-thread). For every lid owning a present
  // inside-S group in gmt, the thread's OWN clocks witness the outer path to
  // lid's node plus the look-stamp dominance pair — the coupled fact "the look
  // was crossed AFTER the last enclosing-quant re-stamp" that no engine-only
  // invariant can see (g surviving in gmt IS its tracker: the B-side Reset
  // removes look-body groups at every SetQuantToClock). Established at gate
  // pass (NI.GateCrossLookNest), vacated at SetQuantToClock (NI.LookBodyCaps-
  // UnderQid), monotone elsewhere. Carried at LiftInv level — ThreadRepLk and
  // the per-instruction case lemmas are untouched.
  // ==========================================================================
  ghost predicate LookNestOkT(re: R.regex, S: set<LG.GroupId>, gmt: LG.GroupMap, th: AI.Thread) {
    forall lid: nat | lid in LTB.LookIds(re) ::
      (exists g: LG.GroupId :: g in S && g in gmt && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))) ==>
        NI.LookPathPresent(re, th.capture_regs.a_clk, th.quant_regs.a_clk, -1, lid)
        && AI.get_idx(th.look_regs.a_clk, lid as int) >= 0
        && AI.get_idx(th.look_regs.a_clk, lid as int)
             >= NI.MxAtLidLk(re, th.quant_regs.a_clk, -1, lid)
  }

  /** The carrier, index-wise over the ACTIVE pairing (deliberately a plain
      forall, not a cons-recursion: list surgery reduces to index shifts). */
  ghost predicate LookNestRepC(re: R.regex, S: set<LG.GroupId>,
                               tl: seq<(LT.Tree, LG.GroupMap)>, vl: seq<AI.Thread>) {
    |tl| == |vl| && forall i | 0 <= i < |tl| :: LookNestOkT(re, S, tl[i].1, vl[i])
  }

  /** The converse carrier, index-wise over both pairings. */
  ghost predicate LookNestBackRepC(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                   S: set<LG.GroupId>, tl: seq<(LT.Tree, LG.GroupMap)>,
                                   vl: seq<AI.Thread>, ncap: int, nlook: int, nquant: int) {
    |tl| == |vl|
    && forall i | 0 <= i < |tl| ::
         LookNestBackT(re, crv, str, ov, S, tl[i].1, vl[i], ncap, nlook, nquant)
  }

  ghost predicate LookNestBackRepB(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                   S: set<LG.GroupId>, tl: seq<(LT.Tree, LG.GroupMap)>,
                                   bl: seq<(AI.Thread, RC.char_expectation)>,
                                   ncap: int, nlook: int, nquant: int) {
    |tl| == |bl|
    && forall i | 0 <= i < |tl| ::
         LookNestBackT(re, crv, str, ov, S, tl[i].1, bl[i].0, ncap, nlook, nquant)
  }

  /** `PSM.ResumeAll` element-wise: same length, each thread re-armed at pc+1
      with REGISTERS UNCHANGED — the carrier crosses the consume for free. */
  lemma ResumeAllLen(bl: seq<(AI.Thread, RC.char_expectation)>)
    ensures |PSM.ResumeAll(bl)| == |bl|
    decreases bl
  {
    if |bl| > 0 { ResumeAllLen(bl[1..]); }
  }

  lemma ResumeAllIndex(bl: seq<(AI.Thread, RC.char_expectation)>, i: int)
    requires 0 <= i < |bl|
    ensures |PSM.ResumeAll(bl)| == |bl|
    ensures PSM.ResumeAll(bl)[i] == bl[i].0.(exit_allowed := true, pc := bl[i].0.pc + 1)
    decreases bl
  {
    ResumeAllLen(bl);
    if i > 0 { ResumeAllIndex(bl[1..], i - 1); }
  }

  /** The carrier over the BLOCKED pairing (same matching filter as
      `BlockedRepLkC`). */
  ghost predicate LookNestRepB(re: R.regex, S: set<LG.GroupId>,
                               tl: seq<(LT.Tree, LG.GroupMap)>,
                               bl: seq<(AI.Thread, RC.char_expectation)>) {
    |tl| == |bl| && forall i | 0 <= i < |tl| :: LookNestOkT(re, S, tl[i].1, bl[i].0)
  }

  /** `QmapOk`'s entry at a specific quant id IS the def-groups of that id's
      body subtree — the per-qid extraction the SetQuant carrier case needs
      (`QidBody`'s descent matches `QmapOk`'s recursion, so no uniqueness is
      required). */
  lemma QmapOkAtQid(re: R.regex, qm: AR.QMap, qid: nat)
    requires T.TransWf(re) && AR.QmapOk(re, qm)
    requires qid in PIV.QuantIds(re)
    ensures (qid as int) in qm.quants
    ensures T.TransWf(PIV.QidBody(re, qid))
    ensures qm.quants[qid as int] == L.DefGroups(T.Translate(PIV.QidBody(re, qid)))
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if qid in PIV.QuantIds(r1) { QmapOkAtQid(r1, qm, qid); } else { QmapOkAtQid(r2, qm, qid); }
    case Re_con(r1, r2) =>
      if qid in PIV.QuantIds(r1) { QmapOkAtQid(r1, qm, qid); } else { QmapOkAtQid(r2, qm, qid); }
    case Re_quant(nul, qid0, cq, r1) =>
      if qid0 >= 0 && (qid0 as nat) == qid {
      } else {
        QmapOkAtQid(r1, qm, qid);
      }
    case Re_capture(_, r1) => QmapOkAtQid(r1, qm, qid);
    case Re_lookaround(_, _, r1) => QmapOkAtQid(r1, qm, qid);
  }

  /** `LmapOk`'s entry at a specific look id IS that node's translated flavour
      and body — the per-lid extraction the gate carrier case needs (the
      descent matches `LookBodyOfRE`'s, so no uniqueness is required). */
  lemma LmapOkAtLid(re: R.regex, qm: AR.QMap, lid: nat)
    requires T.TransWf(re) && AR.LmapOk(re, qm)
    requires lid in LTB.LookIds(re)
    ensures (lid as int) in qm.looks
    ensures T.TransWf(NI.LookBodyOfRE(re, lid))
    ensures qm.looks[lid as int].1 == T.Translate(NI.LookBodyOfRE(re, lid))
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if lid in LTB.LookIds(r1) { LmapOkAtLid(r1, qm, lid); } else { LmapOkAtLid(r2, qm, lid); }
    case Re_con(r1, r2) =>
      if lid in LTB.LookIds(r1) { LmapOkAtLid(r1, qm, lid); } else { LmapOkAtLid(r2, qm, lid); }
    case Re_quant(_, _, _, r1) => LmapOkAtLid(r1, qm, lid);
    case Re_capture(_, r1) => LmapOkAtLid(r1, qm, lid);
    case Re_lookaround(lid0, la0, r1) =>
      if lid0 >= 0 && (lid0 as nat) == lid {
      } else {
        LmapOkAtLid(r1, qm, lid);
      }
  }

  // ==========================================================================
  // (E4) THE CONVERSE CARRIER: dominance ⟹ the fresh match's inside-S groups
  // SURVIVE in gmt. "The look stamp beats every path-quant clock" means no
  // enclosing quantifier re-stamped (hence no Reset fired on the look's
  // groups) since the last crossing — so what the crossing folded is still
  // there. This is the reverse value tie's missing half: presence in the
  // RECONSTRUCTED bank exhibits dominance (FilterPresenceExtractLk), and
  // dominance here forces leaf membership.
  // ==========================================================================
  ghost predicate LookNestBackT(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                S: set<LG.GroupId>, gmt: LG.GroupMap, th: AI.Thread,
                                ncap: int, nlook: int, nquant: int) {
    forall lid: nat | lid in LTB.LookIds(re) ::
      (M.MatchedPosLA(crv, th.look_regs, lid as int)
       && NI.LookPathDom(re, AI.get_idx(th.look_regs.a_clk, lid as int), th.quant_regs.a_clk, lid))
      ==>
      var rf := M.FreshBodyMatch(crv, str, lid as int, th.look_regs, ov, ncap, nlook, nquant);
      rf.Some? ==>
        forall g: LG.GroupId ::
          g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                               rf.value.look_regs, rf.value.quant_regs)
          ==> g in gmt
  }

  // ==========================================================================
  // (D3) TOP-LEVEL-RESTRICTED CARRIERS. The `*Top` variants quantify over
  // `NI.TopLookIds(re)` (the looks whose gate sits in the MAIN code) instead of
  // `LTB.LookIds(re)`. At a nested gate the main thread stamps ONLY top-level
  // looks (inner looks have no main-code CheckOracle), so the inner-lid
  // obligations of `LookNestOkT`/`LookNestBackT` are UNSATISFIABLE at depth >= 2;
  // restricting to `TopLookIds` DROPS them. `TopLookIds == LookIds` at depth 1,
  // so `*Top` is a strict weakening of the full carrier (`NI.TopLookIdsIn`).
  // ==========================================================================
  ghost predicate LookNestOkTTop(re: R.regex, S: set<LG.GroupId>, gmt: LG.GroupMap, th: AI.Thread) {
    forall lid: nat | lid in NI.TopLookIds(re) ::
      (exists g: LG.GroupId :: g in S && g in gmt && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))) ==>
        NI.LookPathPresent(re, th.capture_regs.a_clk, th.quant_regs.a_clk, -1, lid)
        && AI.get_idx(th.look_regs.a_clk, lid as int) >= 0
        && AI.get_idx(th.look_regs.a_clk, lid as int)
             >= NI.MxAtLidLk(re, th.quant_regs.a_clk, -1, lid)
  }

  ghost predicate LookNestBackTTop(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                S: set<LG.GroupId>, gmt: LG.GroupMap, th: AI.Thread,
                                ncap: int, nlook: int, nquant: int) {
    forall lid: nat | lid in NI.TopLookIds(re) ::
      (M.MatchedPosLA(crv, th.look_regs, lid as int)
       && NI.LookPathDom(re, AI.get_idx(th.look_regs.a_clk, lid as int), th.quant_regs.a_clk, lid))
      ==>
      var rf := M.FreshBodyMatch(crv, str, lid as int, th.look_regs, ov, ncap, nlook, nquant);
      rf.Some? ==>
        forall g: LG.GroupId ::
          g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                               rf.value.look_regs, rf.value.quant_regs)
          ==> g in gmt
  }

  ghost predicate LookNestRepCTop(re: R.regex, S: set<LG.GroupId>,
                               tl: seq<(LT.Tree, LG.GroupMap)>, vl: seq<AI.Thread>) {
    |tl| == |vl| && forall i | 0 <= i < |tl| :: LookNestOkTTop(re, S, tl[i].1, vl[i])
  }

  ghost predicate LookNestBackRepCTop(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                   S: set<LG.GroupId>, tl: seq<(LT.Tree, LG.GroupMap)>,
                                   vl: seq<AI.Thread>, ncap: int, nlook: int, nquant: int) {
    |tl| == |vl|
    && forall i | 0 <= i < |tl| ::
         LookNestBackTTop(re, crv, str, ov, S, tl[i].1, vl[i], ncap, nlook, nquant)
  }

  ghost predicate LookNestRepBTop(re: R.regex, S: set<LG.GroupId>,
                               tl: seq<(LT.Tree, LG.GroupMap)>,
                               bl: seq<(AI.Thread, RC.char_expectation)>) {
    |tl| == |bl| && forall i | 0 <= i < |tl| :: LookNestOkTTop(re, S, tl[i].1, bl[i].0)
  }

  ghost predicate LookNestBackRepBTop(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                   S: set<LG.GroupId>, tl: seq<(LT.Tree, LG.GroupMap)>,
                                   bl: seq<(AI.Thread, RC.char_expectation)>,
                                   ncap: int, nlook: int, nquant: int) {
    |tl| == |bl|
    && forall i | 0 <= i < |tl| ::
         LookNestBackTTop(re, crv, str, ov, S, tl[i].1, bl[i].0, ncap, nlook, nquant)
  }

  /** Converse effect — REGISTER-INERT steps (SetReg and every stutter): the
      look and quant banks are untouched and the gm only grows. */
  lemma LookNestBackTRegSame(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                             S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                             th: AI.Thread, th': AI.Thread,
                             ncap: int, nlook: int, nquant: int)
    requires LookNestBackT(re, crv, str, ov, S, gmt, th, ncap, nlook, nquant)
    requires th'.look_regs == th.look_regs && th'.quant_regs == th.quant_regs
    requires forall g: LG.GroupId :: g in gmt ==> g in gmt'
    ensures LookNestBackT(re, crv, str, ov, S, gmt', th', ncap, nlook, nquant)
  {
  }

  /** Converse effect — QUANT RE-STAMP: on-path lids lose dominance outright
      (the fresh stamp beats their look stamp); off-path lids keep dominance
      by congruence and their groups survive the Reset by scope disjointness. */
  lemma LookNestBackTSetQuant(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                              th: AI.Thread, th': AI.Thread, qn: nat,
                              ncap: int, nlook: int, nquant: int)
    requires NR.LookBehindFragmentRE(re) && PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires LTB.LookUnique(re)
    requires LookNestBackT(re, crv, str, ov, S, gmt, th, ncap, nlook, nquant)
    requires qn in PIV.QuantIds(re) && qn in PIV.QuantIdsOutsideLooks(re)
    requires th'.look_regs == th.look_regs
    requires forall j: int :: j != qn as int ==>
      AI.get_idx(th'.quant_regs.a_clk, j) == AI.get_idx(th.quant_regs.a_clk, j)
    // the fresh stamp beats every stored look stamp
    requires forall j: int ::
      AI.get_idx(th.look_regs.a_clk, j) < AI.get_idx(th'.quant_regs.a_clk, qn as int)
    // the Reset removes only qn's scope
    requires forall g: LG.GroupId :: g in gmt && g !in PIV.CapIds(PIV.QidBody(re, qn)) ==> g in gmt'
    ensures LookNestBackT(re, crv, str, ov, S, gmt', th', ncap, nlook, nquant)
  {
    forall lid: nat | lid in LTB.LookIds(re)
      && M.MatchedPosLA(crv, th'.look_regs, lid as int)
      && NI.LookPathDom(re, AI.get_idx(th'.look_regs.a_clk, lid as int), th'.quant_regs.a_clk, lid)
      ensures var rf := M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant);
              rf.Some? ==>
                forall g: LG.GroupId ::
                  g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
                  && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                                       rf.value.look_regs, rf.value.quant_regs)
                  ==> g in gmt'
    {
      var L := AI.get_idx(th.look_regs.a_clk, lid as int);
      if lid in LTB.LookIds(PIV.QidBody(re, qn)) {
        // ON path: the fresh stamp broke dominance — hypothesis impossible.
        assert AI.get_idx(th'.quant_regs.a_clk, qn as int) > L;
        NI.LookPathDomOnPathBreaks(re, L, th'.quant_regs.a_clk, lid, qn);
        assert false;
      } else {
        NI.LookPathDomQuantOffPath(re, L, th.quant_regs.a_clk, th'.quant_regs.a_clk, lid, qn);
        assert NI.LookPathDom(re, L, th.quant_regs.a_clk, lid);
        NI.LookBodyQidBodyDisjoint(re, qn, lid);
        var rf := M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant);
        forall g: LG.GroupId |
          rf.Some? && g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                               rf.value.look_regs, rf.value.quant_regs)
          ensures g in gmt'
        {
          assert g in gmt;
          assert g !in PIV.CapIds(PIV.QidBody(re, qn)) by {
            if g in PIV.CapIds(PIV.QidBody(re, qn)) {
              assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid)) * PIV.CapIds(PIV.QidBody(re, qn));
            }
          }
        }
      }
    }
  }

  /** (L4 NESTED) clone of `LookNestBackTSetQuant` under `NestedFragmentRE`: the
      on-path dominance-break appeals to the nested `LookPathDomOnPathBreaksNested`
      (its lookaround case recurses into the body). Body otherwise verbatim. */
  lemma LookNestBackTSetQuantNested(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                              th: AI.Thread, th': AI.Thread, qn: nat,
                              ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(re) && PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires LTB.LookUnique(re)
    requires LookNestBackT(re, crv, str, ov, S, gmt, th, ncap, nlook, nquant)
    requires qn in PIV.QuantIds(re) && qn in PIV.QuantIdsOutsideLooks(re)
    requires th'.look_regs == th.look_regs
    requires forall j: int :: j != qn as int ==>
      AI.get_idx(th'.quant_regs.a_clk, j) == AI.get_idx(th.quant_regs.a_clk, j)
    // the fresh stamp beats every stored look stamp
    requires forall j: int ::
      AI.get_idx(th.look_regs.a_clk, j) < AI.get_idx(th'.quant_regs.a_clk, qn as int)
    // the Reset removes only qn's scope
    requires forall g: LG.GroupId :: g in gmt && g !in PIV.CapIds(PIV.QidBody(re, qn)) ==> g in gmt'
    ensures LookNestBackT(re, crv, str, ov, S, gmt', th', ncap, nlook, nquant)
  {
    forall lid: nat | lid in LTB.LookIds(re)
      && M.MatchedPosLA(crv, th'.look_regs, lid as int)
      && NI.LookPathDom(re, AI.get_idx(th'.look_regs.a_clk, lid as int), th'.quant_regs.a_clk, lid)
      ensures var rf := M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant);
              rf.Some? ==>
                forall g: LG.GroupId ::
                  g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
                  && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                                       rf.value.look_regs, rf.value.quant_regs)
                  ==> g in gmt'
    {
      var L := AI.get_idx(th.look_regs.a_clk, lid as int);
      if lid in LTB.LookIds(PIV.QidBody(re, qn)) {
        // ON path: the fresh stamp broke dominance — hypothesis impossible.
        assert AI.get_idx(th'.quant_regs.a_clk, qn as int) > L;
        NI.LookPathDomOnPathBreaksNested(re, L, th'.quant_regs.a_clk, lid, qn);
        assert false;
      } else {
        NI.LookPathDomQuantOffPath(re, L, th.quant_regs.a_clk, th'.quant_regs.a_clk, lid, qn);
        assert NI.LookPathDom(re, L, th.quant_regs.a_clk, lid);
        NI.LookBodyQidBodyDisjoint(re, qn, lid);
        var rf := M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant);
        forall g: LG.GroupId |
          rf.Some? && g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                               rf.value.look_regs, rf.value.quant_regs)
          ensures g in gmt'
        {
          assert g in gmt;
          assert g !in PIV.CapIds(PIV.QidBody(re, qn)) by {
            if g in PIV.CapIds(PIV.QidBody(re, qn)) {
              assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid)) * PIV.CapIds(PIV.QidBody(re, qn));
            }
          }
        }
      }
    }
  }

  /** Converse effect — GATE PASS at `l0`: the crossing's own coverage is the
      caller's (from the replay↔spec agreement); every other lid keeps its
      stamp, dominance, fresh match, and old witnesses. */
  lemma LookNestBackTGatePass(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                              th: AI.Thread, th': AI.Thread, l0: int,
                              ncap: int, nlook: int, nquant: int)
    requires LookNestBackT(re, crv, str, ov, S, gmt, th, ncap, nlook, nquant)
    requires th'.quant_regs == th.quant_regs
    requires forall j: int :: j != l0 ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j)
      && AI.get_idx(th'.look_regs.a_cp, j) == AI.get_idx(th.look_regs.a_cp, j)
    requires forall g: LG.GroupId :: g in gmt ==> g in gmt'
    // the crossing coverage for l0 itself, paid by the gate case
    requires l0 >= 0 && (l0 as nat) in LTB.LookIds(re) ==>
      var rf := M.FreshBodyMatch(crv, str, l0, th'.look_regs, ov, ncap, nlook, nquant);
      rf.Some? ==>
        forall g: LG.GroupId ::
          g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l0 as nat))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l0 as nat), rf.value.capture_regs,
                               rf.value.look_regs, rf.value.quant_regs)
          ==> g in gmt'
    ensures LookNestBackT(re, crv, str, ov, S, gmt', th', ncap, nlook, nquant)
  {
    forall lid: nat | lid in LTB.LookIds(re)
      && M.MatchedPosLA(crv, th'.look_regs, lid as int)
      && NI.LookPathDom(re, AI.get_idx(th'.look_regs.a_clk, lid as int), th'.quant_regs.a_clk, lid)
      ensures var rf := M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant);
              rf.Some? ==>
                forall g: LG.GroupId ::
                  g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
                  && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                                       rf.value.look_regs, rf.value.quant_regs)
                  ==> g in gmt'
    {
      if lid as int == l0 {
        // covered by the caller's crossing coverage
      } else {
        // untouched lid: same cp (so MatchedPosLA and the SAME fresh match),
        // same stamp, same quant bank ⟹ old hypothesis + old conclusion.
        assert AI.get_idx(th'.look_regs.a_clk, lid as int) == AI.get_idx(th.look_regs.a_clk, lid as int);
        assert M.MatchedPosLA(crv, th.look_regs, lid as int) by {
          assert AReg.get_cp(th'.look_regs, lid as int) == AReg.get_cp(th.look_regs, lid as int);
        }
        assert M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant)
            == M.FreshBodyMatch(crv, str, lid as int, th.look_regs, ov, ncap, nlook, nquant) by {
          assert AReg.get_cp(th'.look_regs, lid as int) == AReg.get_cp(th.look_regs, lid as int);
        }
      }
    }
  }

  /** Carrier effect — FRESH CAPTURE STAMP (the SetReg case): the look and
      quant banks are untouched, every capture-clock slot either keeps its
      value or takes a stamp `>= B` beating every stored quant clock, and the
      gm gains no inside-S group. */
  lemma LookNestOkTFreshCap(re: R.regex, S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                            th: AI.Thread, th': AI.Thread, B: int)
    requires LookNestOkT(re, S, gmt, th)
    requires th'.look_regs == th.look_regs && th'.quant_regs == th.quant_regs
    requires -1 <= B
    requires forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= B
    requires forall j: int ::
      AI.get_idx(th'.capture_regs.a_clk, j) == AI.get_idx(th.capture_regs.a_clk, j)
      || (AI.get_idx(th'.capture_regs.a_clk, j) >= 0 && AI.get_idx(th'.capture_regs.a_clk, j) >= B)
    requires forall g: LG.GroupId :: g in S && g in gmt' ==> g in gmt
    ensures LookNestOkT(re, S, gmt', th')
  {
    forall lid: nat | lid in LTB.LookIds(re)
      && (exists g: LG.GroupId :: g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid)))
      ensures NI.LookPathPresent(re, th'.capture_regs.a_clk, th'.quant_regs.a_clk, -1, lid)
           && AI.get_idx(th'.look_regs.a_clk, lid as int) >= 0
           && AI.get_idx(th'.look_regs.a_clk, lid as int)
                >= NI.MxAtLidLk(re, th'.quant_regs.a_clk, -1, lid)
    {
      var g: LG.GroupId :| g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid));
      assert g in gmt;
      NI.LookPathPresentFreshCap(re, th.capture_regs.a_clk, th'.capture_regs.a_clk,
                                 th.quant_regs.a_clk, -1, lid, B);
    }
  }

  /** Carrier effect — QUANT RE-STAMP (the SetQuantToClock case): the B-side
      `Reset` clears `qid`'s whole reset scope from the gm, so lids INSIDE
      `qid`'s body are vacated (`NI.LookBodyCapsUnderQid`); for lids OUTSIDE,
      `qid` is off their path and the re-stamp is invisible
      (`NI.LookPathPresentQuantOffPath`). */
  lemma LookNestOkTSetQuant(re: R.regex, S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                            th: AI.Thread, th': AI.Thread, qid: nat)
    requires PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LookNestOkT(re, S, gmt, th)
    requires qid in PIV.QuantIds(re)
    requires th'.capture_regs == th.capture_regs && th'.look_regs == th.look_regs
    requires forall j: int :: j != qid as int ==>
      AI.get_idx(th'.quant_regs.a_clk, j) == AI.get_idx(th.quant_regs.a_clk, j)
    requires forall g: nat :: g in PIV.CapIds(PIV.QidBody(re, qid)) ==> g !in gmt'
    requires forall g: LG.GroupId :: g in gmt' ==> g in gmt
    ensures LookNestOkT(re, S, gmt', th')
  {
    forall lid: nat | lid in LTB.LookIds(re)
      && (exists g: LG.GroupId :: g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid)))
      ensures NI.LookPathPresent(re, th'.capture_regs.a_clk, th'.quant_regs.a_clk, -1, lid)
           && AI.get_idx(th'.look_regs.a_clk, lid as int) >= 0
           && AI.get_idx(th'.look_regs.a_clk, lid as int)
                >= NI.MxAtLidLk(re, th'.quant_regs.a_clk, -1, lid)
    {
      var g: LG.GroupId :| g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid));
      if lid in LTB.LookIds(PIV.QidBody(re, qid)) {
        // ON path: Reset removed lid's whole ownership — no witness survives.
        NI.LookBodyCapsUnderQid(re, qid, lid);
        assert g in PIV.CapIds(PIV.QidBody(re, qid));
        assert false;
      } else {
        assert g in gmt;
        NI.LookPathPresentQuantOffPath(re, th.capture_regs.a_clk, th.quant_regs.a_clk,
                                       th'.quant_regs.a_clk, -1, lid, qid);
      }
    }
  }

  /** Carrier effect — GATE PASS (the CheckOracle case): the crossing thread's
      positional invariant plus the FRESH look stamp establish the fact for
      `lid0` outright (`NI.GateCrossLookNest`); groups folded in are owned by
      `lid0` alone, so other lids keep their old witnesses and unchanged
      registers (`NI.LookBodiesCapsDisjoint` kills cross-ownership). */
  lemma LookNestOkTGatePass(re: R.regex, code: RB.code, endl: nat, S: set<LG.GroupId>,
                            gmt: LG.GroupMap, gmt': LG.GroupMap,
                            th: AI.Thread, th': AI.Thread, pc: nat, lid0: int)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires NR.LookBehindFragmentRE(re) && LTB.LookUnique(re) && PIV.CapUnique(re)
    requires LookNestOkT(re, S, gmt, th)
    requires pc < endl && NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid0))
    requires NI.NestInvRE(re, code, 0, endl, pc, th.capture_regs.a_clk, th.quant_regs.a_clk, -1)
    requires th'.capture_regs == th.capture_regs && th'.quant_regs == th.quant_regs
    requires forall j: int :: j != lid0 ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j)
    requires AI.get_idx(th'.look_regs.a_clk, lid0) >= 0
    requires forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= AI.get_idx(th'.look_regs.a_clk, lid0)
    requires forall g: LG.GroupId :: g in S && g in gmt' && g !in gmt ==>
      lid0 >= 0 && (lid0 as nat) in LTB.LookIds(re)
      && g in PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat))
    ensures LookNestOkT(re, S, gmt', th')
  {
    NI.GateCrossLookNest(re, code, endl, pc, th.capture_regs.a_clk, th.quant_regs.a_clk,
                         th'.look_regs.a_clk, lid0);
    forall lid: nat | lid in LTB.LookIds(re)
      && (exists g: LG.GroupId :: g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid)))
      ensures NI.LookPathPresent(re, th'.capture_regs.a_clk, th'.quant_regs.a_clk, -1, lid)
           && AI.get_idx(th'.look_regs.a_clk, lid as int) >= 0
           && AI.get_idx(th'.look_regs.a_clk, lid as int)
                >= NI.MxAtLidLk(re, th'.quant_regs.a_clk, -1, lid)
    {
      var g: LG.GroupId :| g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid));
      if lid == lid0 as nat {
        // established fresh at the crossing (caps/quant banks unchanged)
      } else {
        if g in gmt {
          assert AI.get_idx(th'.look_regs.a_clk, lid as int)
              == AI.get_idx(th.look_regs.a_clk, lid as int) by {
            assert lid as int != lid0;
          }
        } else {
          assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat));
          NI.LookBodiesCapsDisjoint(re, lid, lid0 as nat);
          assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
                   * PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat));
          assert false;
        }
      }
    }
  }

  /** (L4 NESTED) `LookNestOkTGatePass` under `NestedFragmentRE`. Two rewires
      versus the depth-1 form:
        (i)  `NI.GateCrossLookNest` → `NI.GateCrossLookNestNested` (the gate-site
             extraction under the full nested fragment; a pure fragment swap);
        (ii) `NI.LookBodiesCapsDisjoint` (FALSE at depth ≥ 2) → the trichotomy
             `NI.LookBodiesCapsDisjointOrNested`, whose "one nests the other"
             arms are BOTH ruled out for a FRESH fold:

      The fold-ownership hypothesis is STRENGTHENED to DIRECT ownership — a
      freshly-folded `g` sits DIRECTLY in `lid0`'s body, `g !in
      CapIdsInLooks(body(lid0))` (at a top-level gate the endpoint folds only
      `lid0`'s direct groups; inner-look groups are closed post-hoc). Then for
      `lid != lid0` with `g` fresh and `g in CapIds(body(lid))`:
        · disjoint arm  → `g` in an empty intersection, contradiction;
        · `lid` nested in `lid0` → `LookBodyCompose`+`LookBodyCapsIn` put `g` in
          `CapIdsInLooks(body(lid0))`, contradicting DIRECT;
        · `lid0` nested in `lid` → IMPOSSIBLE: `lid0`'s `CheckOracle` is in the
          MAIN code, so `lid0` is TOP-LEVEL (`NI.LookSiteTopNested`), hence sits
          in no look body (`NI.TopLookNotNested`), contradicting the arm.
      So a cross-lid fresh fold is vacuous exactly as at depth 1; only the
      argument that kills it changed. */
  lemma LookNestOkTGatePassNested(re: R.regex, code: RB.code, endl: nat, S: set<LG.GroupId>,
                                  gmt: LG.GroupMap, gmt': LG.GroupMap,
                                  th: AI.Thread, th': AI.Thread, pc: nat, lid0: int)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re) && PIV.CapUnique(re)
    requires LookNestOkT(re, S, gmt, th)
    requires pc < endl && NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid0))
    requires NI.NestInvRE(re, code, 0, endl, pc, th.capture_regs.a_clk, th.quant_regs.a_clk, -1)
    requires th'.capture_regs == th.capture_regs && th'.quant_regs == th.quant_regs
    requires forall j: int :: j != lid0 ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j)
    requires AI.get_idx(th'.look_regs.a_clk, lid0) >= 0
    requires forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= AI.get_idx(th'.look_regs.a_clk, lid0)
    // DIRECT ownership: a fresh fold sits directly in lid0's body, not buried in
    // a nested look (the endpoint's top-level-gate fold; inner groups post-hoc).
    requires forall g: LG.GroupId :: g in S && g in gmt' && g !in gmt ==>
      lid0 >= 0 && (lid0 as nat) in LTB.LookIds(re)
      && g in PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat))
      && g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, lid0 as nat))
    ensures LookNestOkT(re, S, gmt', th')
  {
    NI.GateCrossLookNestNested(re, code, endl, pc, th.capture_regs.a_clk, th.quant_regs.a_clk,
                               th'.look_regs.a_clk, lid0);
    // lid0's CheckOracle is in the MAIN code ⟹ lid0 is a TOP-LEVEL look.
    NI.LookSiteTopNested(re, code, 0, endl, pc);
    assert lid0 >= 0 && (lid0 as nat) in NI.TopLookIds(re);
    forall lid: nat | lid in LTB.LookIds(re)
      && (exists g: LG.GroupId :: g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid)))
      ensures NI.LookPathPresent(re, th'.capture_regs.a_clk, th'.quant_regs.a_clk, -1, lid)
           && AI.get_idx(th'.look_regs.a_clk, lid as int) >= 0
           && AI.get_idx(th'.look_regs.a_clk, lid as int)
                >= NI.MxAtLidLk(re, th'.quant_regs.a_clk, -1, lid)
    {
      var g: LG.GroupId :| g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid));
      if lid == lid0 as nat {
        // established fresh at the crossing (caps/quant banks unchanged)
      } else {
        if g in gmt {
          assert AI.get_idx(th'.look_regs.a_clk, lid as int)
              == AI.get_idx(th.look_regs.a_clk, lid as int) by {
            assert lid as int != lid0;
          }
        } else {
          // FRESH fold: g is DIRECT in lid0's body.
          assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat));
          assert g !in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, lid0 as nat));
          NI.LookBodiesCapsDisjointOrNested(re, lid, lid0 as nat);
          if PIV.CapIds(NI.LookBodyOfRE(re, lid)) * PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat)) == {} {
            assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
                     * PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat));
            assert false;
          } else if lid0 as nat in LTB.LookIds(NI.LookBodyOfRE(re, lid))
                    && PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat))
                         <= PIV.CapIds(NI.LookBodyOfRE(re, lid)) {
            // lid0 nested in lid — impossible: lid0 is top-level.
            NI.TopLookNotNested(re, lid0 as nat, lid);
            assert lid0 as nat !in LTB.LookIds(NI.LookBodyOfRE(re, lid));
            assert false;
          } else {
            // lid nested in lid0 — g would then be in CapIdsInLooks(body(lid0)).
            assert lid in LTB.LookIds(NI.LookBodyOfRE(re, lid0 as nat));
            NI.LookBodyCompose(re, lid0 as nat, lid);
            assert NI.LookBodyOfRE(re, lid)
                == NI.LookBodyOfRE(NI.LookBodyOfRE(re, lid0 as nat), lid);
            NI.LookBodyCapsIn(NI.LookBodyOfRE(re, lid0 as nat), lid);
            assert g in PIV.CapIdsInLooks(NI.LookBodyOfRE(re, lid0 as nat));
            assert false;
          }
        }
      }
    }
  }

  // ==========================================================================
  // (D3) TOP-LEVEL carrier EFFECT lemmas. Each is the `*Top`-carrier sibling of
  // the corresponding full-carrier effect lemma: the quantifier iterates
  // `NI.TopLookIds(re)` (via `NI.TopLookIdsIn` for the `lid in LookIds` facts the
  // inner navigation needs), the requires/ensures carriers are the `*Top`
  // variants. For every step but the gate-pass the argument is verbatim — a
  // strict weakening. At the gate pass the DIRECT-ownership hypothesis is DROPPED
  // (inner-look folds no longer create obligations) and a cross-lid fresh fold is
  // killed by TOP-LEVEL disjointness (`NI.TopLookNotNested` rules out BOTH nesting
  // arms, since lid and lid0 are both top-level).
  // ==========================================================================

  lemma LookNestBackTRegSameTop(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                             S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                             th: AI.Thread, th': AI.Thread,
                             ncap: int, nlook: int, nquant: int)
    requires LookNestBackTTop(re, crv, str, ov, S, gmt, th, ncap, nlook, nquant)
    requires th'.look_regs == th.look_regs && th'.quant_regs == th.quant_regs
    requires forall g: LG.GroupId :: g in gmt ==> g in gmt'
    ensures LookNestBackTTop(re, crv, str, ov, S, gmt', th', ncap, nlook, nquant)
  {
  }

  lemma LookNestOkTFreshCapTop(re: R.regex, S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                            th: AI.Thread, th': AI.Thread, B: int)
    requires LookNestOkTTop(re, S, gmt, th)
    requires th'.look_regs == th.look_regs && th'.quant_regs == th.quant_regs
    requires -1 <= B
    requires forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= B
    requires forall j: int ::
      AI.get_idx(th'.capture_regs.a_clk, j) == AI.get_idx(th.capture_regs.a_clk, j)
      || (AI.get_idx(th'.capture_regs.a_clk, j) >= 0 && AI.get_idx(th'.capture_regs.a_clk, j) >= B)
    requires forall g: LG.GroupId :: g in S && g in gmt' ==> g in gmt
    ensures LookNestOkTTop(re, S, gmt', th')
  {
    NI.TopLookIdsIn(re);
    forall lid: nat | lid in NI.TopLookIds(re)
      && (exists g: LG.GroupId :: g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid)))
      ensures NI.LookPathPresent(re, th'.capture_regs.a_clk, th'.quant_regs.a_clk, -1, lid)
           && AI.get_idx(th'.look_regs.a_clk, lid as int) >= 0
           && AI.get_idx(th'.look_regs.a_clk, lid as int)
                >= NI.MxAtLidLk(re, th'.quant_regs.a_clk, -1, lid)
    {
      var g: LG.GroupId :| g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid));
      assert g in gmt;
      NI.LookPathPresentFreshCap(re, th.capture_regs.a_clk, th'.capture_regs.a_clk,
                                 th.quant_regs.a_clk, -1, lid, B);
    }
  }

  lemma LookNestOkTSetQuantTop(re: R.regex, S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                            th: AI.Thread, th': AI.Thread, qid: nat)
    requires PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires LookNestOkTTop(re, S, gmt, th)
    requires qid in PIV.QuantIds(re)
    requires th'.capture_regs == th.capture_regs && th'.look_regs == th.look_regs
    requires forall j: int :: j != qid as int ==>
      AI.get_idx(th'.quant_regs.a_clk, j) == AI.get_idx(th.quant_regs.a_clk, j)
    requires forall g: nat :: g in PIV.CapIds(PIV.QidBody(re, qid)) ==> g !in gmt'
    requires forall g: LG.GroupId :: g in gmt' ==> g in gmt
    ensures LookNestOkTTop(re, S, gmt', th')
  {
    NI.TopLookIdsIn(re);
    forall lid: nat | lid in NI.TopLookIds(re)
      && (exists g: LG.GroupId :: g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid)))
      ensures NI.LookPathPresent(re, th'.capture_regs.a_clk, th'.quant_regs.a_clk, -1, lid)
           && AI.get_idx(th'.look_regs.a_clk, lid as int) >= 0
           && AI.get_idx(th'.look_regs.a_clk, lid as int)
                >= NI.MxAtLidLk(re, th'.quant_regs.a_clk, -1, lid)
    {
      var g: LG.GroupId :| g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid));
      if lid in LTB.LookIds(PIV.QidBody(re, qid)) {
        NI.LookBodyCapsUnderQid(re, qid, lid);
        assert g in PIV.CapIds(PIV.QidBody(re, qid));
        assert false;
      } else {
        assert g in gmt;
        NI.LookPathPresentQuantOffPath(re, th.capture_regs.a_clk, th.quant_regs.a_clk,
                                       th'.quant_regs.a_clk, -1, lid, qid);
      }
    }
  }

  lemma LookNestBackTSetQuantNestedTop(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                              th: AI.Thread, th': AI.Thread, qn: nat,
                              ncap: int, nlook: int, nquant: int)
    requires NR.NestedFragmentRE(re) && PIV.CapUnique(re) && PIV.QuantUnique(re)
    requires LTB.LookUnique(re)
    requires LookNestBackTTop(re, crv, str, ov, S, gmt, th, ncap, nlook, nquant)
    requires qn in PIV.QuantIds(re) && qn in PIV.QuantIdsOutsideLooks(re)
    requires th'.look_regs == th.look_regs
    requires forall j: int :: j != qn as int ==>
      AI.get_idx(th'.quant_regs.a_clk, j) == AI.get_idx(th.quant_regs.a_clk, j)
    requires forall j: int ::
      AI.get_idx(th.look_regs.a_clk, j) < AI.get_idx(th'.quant_regs.a_clk, qn as int)
    requires forall g: LG.GroupId :: g in gmt && g !in PIV.CapIds(PIV.QidBody(re, qn)) ==> g in gmt'
    ensures LookNestBackTTop(re, crv, str, ov, S, gmt', th', ncap, nlook, nquant)
  {
    NI.TopLookIdsIn(re);
    forall lid: nat | lid in NI.TopLookIds(re)
      && M.MatchedPosLA(crv, th'.look_regs, lid as int)
      && NI.LookPathDom(re, AI.get_idx(th'.look_regs.a_clk, lid as int), th'.quant_regs.a_clk, lid)
      ensures var rf := M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant);
              rf.Some? ==>
                forall g: LG.GroupId ::
                  g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
                  && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                                       rf.value.look_regs, rf.value.quant_regs)
                  ==> g in gmt'
    {
      var L := AI.get_idx(th.look_regs.a_clk, lid as int);
      if lid in LTB.LookIds(PIV.QidBody(re, qn)) {
        assert AI.get_idx(th'.quant_regs.a_clk, qn as int) > L;
        NI.LookPathDomOnPathBreaksNested(re, L, th'.quant_regs.a_clk, lid, qn);
        assert false;
      } else {
        NI.LookPathDomQuantOffPath(re, L, th.quant_regs.a_clk, th'.quant_regs.a_clk, lid, qn);
        assert NI.LookPathDom(re, L, th.quant_regs.a_clk, lid);
        NI.LookBodyQidBodyDisjoint(re, qn, lid);
        var rf := M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant);
        forall g: LG.GroupId |
          rf.Some? && g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                               rf.value.look_regs, rf.value.quant_regs)
          ensures g in gmt'
        {
          assert g in gmt;
          assert g !in PIV.CapIds(PIV.QidBody(re, qn)) by {
            if g in PIV.CapIds(PIV.QidBody(re, qn)) {
              assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid)) * PIV.CapIds(PIV.QidBody(re, qn));
            }
          }
        }
      }
    }
  }

  lemma LookNestBackTGatePassTop(re: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, gmt: LG.GroupMap, gmt': LG.GroupMap,
                              th: AI.Thread, th': AI.Thread, l0: int,
                              ncap: int, nlook: int, nquant: int)
    requires LookNestBackTTop(re, crv, str, ov, S, gmt, th, ncap, nlook, nquant)
    requires th'.quant_regs == th.quant_regs
    requires forall j: int :: j != l0 ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j)
      && AI.get_idx(th'.look_regs.a_cp, j) == AI.get_idx(th.look_regs.a_cp, j)
    requires forall g: LG.GroupId :: g in gmt ==> g in gmt'
    requires l0 >= 0 && (l0 as nat) in LTB.LookIds(re) ==>
      var rf := M.FreshBodyMatch(crv, str, l0, th'.look_regs, ov, ncap, nlook, nquant);
      rf.Some? ==>
        forall g: LG.GroupId ::
          g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l0 as nat))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l0 as nat), rf.value.capture_regs,
                               rf.value.look_regs, rf.value.quant_regs)
          ==> g in gmt'
    ensures LookNestBackTTop(re, crv, str, ov, S, gmt', th', ncap, nlook, nquant)
  {
    NI.TopLookIdsIn(re);
    forall lid: nat | lid in NI.TopLookIds(re)
      && M.MatchedPosLA(crv, th'.look_regs, lid as int)
      && NI.LookPathDom(re, AI.get_idx(th'.look_regs.a_clk, lid as int), th'.quant_regs.a_clk, lid)
      ensures var rf := M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant);
              rf.Some? ==>
                forall g: LG.GroupId ::
                  g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
                  && g in PIV.GmOfLive(NI.LookBodyOfRE(re, lid), rf.value.capture_regs,
                                       rf.value.look_regs, rf.value.quant_regs)
                  ==> g in gmt'
    {
      if lid as int == l0 {
      } else {
        assert AI.get_idx(th'.look_regs.a_clk, lid as int) == AI.get_idx(th.look_regs.a_clk, lid as int);
        assert M.MatchedPosLA(crv, th.look_regs, lid as int) by {
          assert AReg.get_cp(th'.look_regs, lid as int) == AReg.get_cp(th.look_regs, lid as int);
        }
        assert M.FreshBodyMatch(crv, str, lid as int, th'.look_regs, ov, ncap, nlook, nquant)
            == M.FreshBodyMatch(crv, str, lid as int, th.look_regs, ov, ncap, nlook, nquant) by {
          assert AReg.get_cp(th'.look_regs, lid as int) == AReg.get_cp(th.look_regs, lid as int);
        }
      }
    }
  }

  /** (D3) `LookNestOkTGatePassNested` on the `*Top` carrier. The DIRECT-ownership
      hypothesis (`g !in CapIdsInLooks(body(lid0))`) is DROPPED — a fresh fold may
      land an inner-look group, but inner looks are NOT in `TopLookIds`, so they
      raise no obligation. A cross-lid fresh fold (`lid != lid0`, both top-level)
      is impossible: `NI.LookBodiesCapsDisjointOrNested`'s two nesting arms are
      BOTH ruled out by `NI.TopLookNotNested` (a top-level look sits in no look
      body), leaving disjointness that contradicts the shared `g`. */
  lemma LookNestOkTGatePassNestedTop(re: R.regex, code: RB.code, endl: nat, S: set<LG.GroupId>,
                                  gmt: LG.GroupMap, gmt': LG.GroupMap,
                                  th: AI.Thread, th': AI.Thread, pc: nat, lid0: int)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re) && PIV.CapUnique(re)
    requires LookNestOkTTop(re, S, gmt, th)
    requires pc < endl && NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid0))
    requires NI.NestInvRE(re, code, 0, endl, pc, th.capture_regs.a_clk, th.quant_regs.a_clk, -1)
    requires th'.capture_regs == th.capture_regs && th'.quant_regs == th.quant_regs
    requires forall j: int :: j != lid0 ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j)
    requires AI.get_idx(th'.look_regs.a_clk, lid0) >= 0
    requires forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= AI.get_idx(th'.look_regs.a_clk, lid0)
    // fresh folds sit in lid0's body (nested-look groups allowed — dropped the DIRECT clause).
    requires forall g: LG.GroupId :: g in S && g in gmt' && g !in gmt ==>
      lid0 >= 0 && (lid0 as nat) in LTB.LookIds(re)
      && g in PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat))
    ensures LookNestOkTTop(re, S, gmt', th')
  {
    NI.GateCrossLookNestNested(re, code, endl, pc, th.capture_regs.a_clk, th.quant_regs.a_clk,
                               th'.look_regs.a_clk, lid0);
    NI.LookSiteTopNested(re, code, 0, endl, pc);
    assert lid0 >= 0 && (lid0 as nat) in NI.TopLookIds(re);
    NI.TopLookIdsIn(re);
    forall lid: nat | lid in NI.TopLookIds(re)
      && (exists g: LG.GroupId :: g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid)))
      ensures NI.LookPathPresent(re, th'.capture_regs.a_clk, th'.quant_regs.a_clk, -1, lid)
           && AI.get_idx(th'.look_regs.a_clk, lid as int) >= 0
           && AI.get_idx(th'.look_regs.a_clk, lid as int)
                >= NI.MxAtLidLk(re, th'.quant_regs.a_clk, -1, lid)
    {
      var g: LG.GroupId :| g in S && g in gmt' && g in PIV.CapIds(NI.LookBodyOfRE(re, lid));
      if lid == lid0 as nat {
        // established fresh at the crossing (caps/quant banks unchanged)
      } else {
        if g in gmt {
          assert AI.get_idx(th'.look_regs.a_clk, lid as int)
              == AI.get_idx(th.look_regs.a_clk, lid as int) by {
            assert lid as int != lid0;
          }
        } else {
          // FRESH cross-lid fold: g in body(lid0) AND g in body(lid), lid != lid0
          // both TOP-LEVEL — impossible.
          assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat));
          NI.LookBodiesCapsDisjointOrNested(re, lid, lid0 as nat);
          if PIV.CapIds(NI.LookBodyOfRE(re, lid)) * PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat)) == {} {
            assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
                     * PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat));
            assert false;
          } else if lid0 as nat in LTB.LookIds(NI.LookBodyOfRE(re, lid))
                    && PIV.CapIds(NI.LookBodyOfRE(re, lid0 as nat))
                         <= PIV.CapIds(NI.LookBodyOfRE(re, lid)) {
            // lid0 nested in lid — impossible: lid0 is top-level.
            NI.TopLookNotNested(re, lid0 as nat, lid);
            assert lid0 as nat !in LTB.LookIds(NI.LookBodyOfRE(re, lid));
            assert false;
          } else {
            // lid nested in lid0 — impossible: lid is ALSO top-level.
            assert lid in LTB.LookIds(NI.LookBodyOfRE(re, lid0 as nat));
            NI.TopLookNotNested(re, lid, lid0 as nat);
            assert lid !in LTB.LookIds(NI.LookBodyOfRE(re, lid0 as nat));
            assert false;
          }
        }
      }
    }
  }

  lemma WinningGmtTieOutside(re: R.regex, th: AI.Thread, leafgm: LG.GroupMap,
                             ftstar: LG.GroupMap, S: set<LG.GroupId>)
    requires ftstar == PIV.GmOfLive(re, th.capture_regs, th.look_regs, th.quant_regs)
    requires LL.GmAgreeOutside(ftstar, leafgm, S)
    ensures GmtTieOutside(re, th, leafgm, S)
  {
    // GmtTieOutside's internal `gml` unfolds to exactly `ftstar` (the requires).
    forall g: LG.GroupId | g !in S
      ensures (g in leafgm <==> g in ftstar) && (g in leafgm ==> leafgm[g] == ftstar[g])
    {
      // GmAgreeOutside(ftstar, leafgm, S): g in ftstar <==> g in leafgm, and
      // g in ftstar ==> ftstar[g] == leafgm[g]. The membership clause is
      // symmetric; for the value, g in leafgm ==> g in ftstar (flip) ==>
      // ftstar[g] == leafgm[g] ==> leafgm[g] == ftstar[g].
    }
  }

  /** The fresh body match at a recorded look cp is `CapRegWf` — straight from
      `M.FreshMatchWf` (`ThreadRegsWf ⟹ CapRegWf`, since `FreshBodyMatch` IS the
      `FFindMatch`-from-fresh-registers form `FreshMatchWf` covers). This is the
      thread-wf `InsidePresentResBridge` needs: clock and value are set together,
      so `BodyPathPresentLk`'s clock-set yields the value-set at `g` that
      `GmOfLiveInsideLookPresentEq` requires. The cp-validity `requires`
      (`0<=cp<=|str|`, context match) are the caller's look-table facts. */
  lemma FreshBodyMatchCapWf(crv: CP.FCompiled, str: string, l: int, lk: AReg.Regs,
                            ov: LOr.OracleView, ncap: int, nlook: int, nquant: int, body: R.regex)
    requires body == M.VBody(crv, l)
    requires NR.LookBehindFragmentRE(body) && NR.PlusFragmentRE(body)
          && PIV.CapUnique(body) && PIV.QuantUnique(body)
    requires M.MatchedPosLA(crv, lk, l)   // POSITIVE look: rules out the capture-free negatives
    requires ncap >= 0 && nlook >= 0 && nquant >= 0
    requires var cp := if AReg.get_cp(lk, l).Some? then AReg.get_cp(lk, l).value else 0;
             0 <= cp <= |str| && AI.cp_context(cp, str, LAnc.Forward).nextchar == AI.get_char(str, cp)
    ensures var rf := M.FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
            rf.Some? ==> PIV.CapRegWf(rf.value.capture_regs)
  {
    var cp := if AReg.get_cp(lk, l).Some? then AReg.get_cp(lk, l).value else 0;
    var looktype := if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead;
    var cdn := if 0 <= l < |crv.f_look_cdns| then crv.f_look_cdns[l] else [];
    // MatchedPosLA => looktype is Lookahead or Lookbehind. FreshBodyMatch runs the
    // look's CAPTURE direction over `capture_regex(looktype, body)`: for a lookAHEAD
    // that is `body` FORWARD (FreshMatchWf); for a lookBEHIND `reverse_regex(body)`
    // BACKWARD (FreshMatchWfLB). Either yields `ThreadRegsWf`, whose first conjunct
    // is `CapRegWf(capture_regs)`. The backward context fact is definitional.
    if looktype.Lookbehind? {
      var bc := CP.compile_to_bytecode(R.reverse_regex(body));
      assert AI.cp_context(cp, str, LAnc.Backward).nextchar == AI.get_char(str, cp - 1);
      M.FreshMatchWfLB(bc, str, cp, ov, cdn, body, ncap, nlook, nquant);
    } else {
      assert looktype.Lookahead?;
      var bc := CP.compile_to_bytecode(body);
      M.FreshMatchWf(bc, str, cp, ov, cdn, body, ncap, nlook, nquant);
    }
  }

  /** INSIDE `S`, PRESENT case — the crux value equality, modulo the (E)
      RE-side path hypothesis. For a present inside-look group `g` captured by
      look `l`, the winning leaf's value `leafgm[g]` equals the reconstructed
      `GmOfLive(re, res0)[g]`. Chain: `GmtTieInside` (content passed as the
      `gmb` requires) gives `leafgm[g] == gmb[g]` where `gmb = GmOfLive(body,
      rf)`; `M.FLookLoopValueOk` (the `RegsAgreeInside` requires) ties `res0` to
      the fresh match `rf` on `CaptureRegs(body)`; `PIV.BodyPathPresentLk`
      discharges the BODY-side path hypotheses of `GmOfLiveInsideLookPresentEq`,
      which then equates `GmOfLive(re, res0)[g]` with `gmb[g]`. The `rf` thread-
      wf facts (value-set at `g` + clock-consistency, from `FreshMatchWf`) and
      the (E) RE-side `PathPresentLk(re, res0)` + clock-dominance (the winning-
      thread outer-path fact, coupled to the sim/position gate) are `requires` —
      the caller pays them. This is the inside-`S` companion of the free
      `WinningGmtTieOutside`; together they are `L3aValueBridge`'s two branches. */
  lemma InsidePresentResBridge(
      re: R.regex, body: R.regex, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
      th: AI.Thread, leafgm: LG.GroupMap, res0: AReg.Regs, res2: AReg.Regs, l: int,
      ncap: int, nlook: int, nquant: int, g: LG.GroupId)
    requires NR.LookBehindFragmentRE(re) && PIV.CapUnique(re)
    requires NR.LookBehindFragmentRE(body) && NR.LookFreeRE(body) && PIV.CapUnique(body)
    requires body == M.VBody(crv, l)
    requires g in PIV.CapIds(re)     // (from CapIds(body) <= CapIdsInLooks(re) <= CapIds(re), caller-side)
    requires 0 <= l < nlook && g in PIV.CapIds(body) && M.MatchedPosLA(crv, th.look_regs, l)
    // GmtTieInside content at (g, l): fresh match present, leaf value == its value.
    requires var rf := M.FreshBodyMatch(crv, str, l, th.look_regs, ov, ncap, nlook, nquant);
             rf.Some?
             && var gmb := PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs);
                var looktype := if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead;
                g in gmb && g in leafgm && leafgm[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb[g]) else gmb[g])
    // FLookLoopValueOk relation at l: res0 agrees with the fresh match on body regs.
    requires var rf := M.FreshBodyMatch(crv, str, l, th.look_regs, ov, ncap, nlook, nquant);
             rf.Some? ==> CM.RegsAgreeInside(res0, rf.value.capture_regs, PIV.CaptureRegs(body))
    // rf thread-wf: clock and value are set together on the body's capture regs
    // (`CapRegWf`, from `FreshBodyMatchCapWf`). This supplies BodyPathPresentLk's
    // clock-consistency and, via its clock-set output, the value-set at g.
    requires var rf := M.FreshBodyMatch(crv, str, l, th.look_regs, ov, ncap, nlook, nquant);
             rf.Some? ==> PIV.CapRegWf(rf.value.capture_regs)
    // (E) RE-side path-presence at g for the reconstructed (res0, res2) state
    // (the sim-coupled gap, paid by caller; res2 is the reconstructed quant that
    // carries the look bodies' clocks — th.quant leaves those unset).
    requires PIV.PathPresentLk(re, AReg.as_arrays(res0).1, AReg.as_arrays(th.look_regs).1,
                               AReg.as_arrays(res2).1, -1, g)
    requires AI.get_idx(AReg.as_arrays(res0).1, CP.start_reg(g))
               >= PIV.MxAtGidLk(re, AReg.as_arrays(res0).1, AReg.as_arrays(th.look_regs).1,
                                AReg.as_arrays(res2).1, -1, g)
    ensures g in leafgm && g in PIV.GmOfLive(re, res0, th.look_regs, res2)
    // L3b: for a LOOKBEHIND lid the reconstructed engine value is the REVERSED span
    // (item-0 quirk); the ordered leaf value is its SWAP. NormalizeArr absorbs this
    // at the top. NO-OP for lookaheads (forward) and capture-free lookbehinds.
    ensures var looktype := if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead;
            leafgm[g] == (if looktype.Lookbehind?
                          then LBV.SwapRange(PIV.GmOfLive(re, res0, th.look_regs, res2)[g])
                          else PIV.GmOfLive(re, res0, th.look_regs, res2)[g])
  {
    var rf := M.FreshBodyMatch(crv, str, l, th.look_regs, ov, ncap, nlook, nquant);
    var gmb := PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs);
    // Body-side path hypotheses of GmOfLiveInsideLookPresentEq.
    PIV.BodyPathPresentLk(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs, g);
    // The value equality: GmOfLive(re, res0, _, res2)[g] == GmOfLive(body, rf)[g] == gmb[g].
    M.GmOfLiveInsideLookPresentEq(re, body, res0, th.look_regs, res2,
                                  rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs, g);
  }

  /** [SEAM — THE LAST GLUE] From the endpoint's leaf ties and the engine's
      FLookLoop facts, conclude MainExtraction's precondition: the leaf gm IS
      the live denotation of the RECONSTRUCTED registers.

      FILL ingredients (this is where the remaining (E) work lives):
      - inside S, present: `GmtTieInside` gives the fresh-replay value;
        `M.FLookLoopValueOk` gives the same value in `res.0`;
        `PIV.GmOfLiveInsideLookPresentEq` + `PIV.BodyPathPresentLk` turn
        register agreement into GmOfLive agreement — their RE-side outer-path
        hypothesis (`PathPresentLk`'s outer ancestors + `lc >= mx`) is the ONE
        (E) piece not yet banked: derive the outer-capture presence from the
        t-side leaf (an inside-look g present in the leaf forces its ancestors'
        opens on the same path — a FirstLeaf structural fact), and `lc >= 0`
        from `M.MainMatchLookClkSet`.
      - inside S, absent: `PIV.GmOfLiveInsideLookAbsentEq`.
      - outside S: `GmtTieOutside` + `M.FLookLoopCaptureFrame` (the fold only
        writes inside `CaptureRegsSet(CapIdsInLooks)`) + `FLookLoopQuantFrame`.
      Statement uses the fold over the FULL lid range as the else branch calls
      it (`lid == 0`, `maxlook == R.max_lookaround(ast)`). */

  /** Convert `InsidePresentResBridge`'s LOOK-TYPE swap into the POSITIONAL
      `NormRange`, using leaf-orderedness. For a lookbehind `lr == SwapRange(rg)`
      and `lr` ordered ⟹ `rg` reversed ⟹ `NormRange(rg) == SwapRange(rg) == lr`;
      for a lookahead `lr == rg` ordered ⟹ `NormRange(rg) == rg == lr`. So no
      separate "LB ⟺ reversed" lemma is needed — it falls out of `lr` ordered. */
  lemma NormRangeFromSwap(rg: LG.Range, lr: LG.Range, isLB: bool)
    requires lr == (if isLB then LBV.SwapRange(rg) else rg)
    requires lr.endIdx.Some? ==> lr.startIdx <= lr.endIdx.value          // lr ordered
    ensures lr == PIV.NormRange(rg)
  {
    if isLB {
      match rg.endIdx {
        case None =>            // SwapRange / NormRange both identity on an open range
        case Some(e) =>
          assert lr == LG.Range(e, Some(rg.startIdx));                   // SwapRange def
          assert e <= rg.startIdx;                                       // lr ordered
      }
    } else {
      PIV.NormRangeOrdered(rg);
    }
  }

  lemma L3aValueBridge(re: R.regex, th: AI.Thread, leafgm: LG.GroupMap,
                       res0: AReg.Regs, res2: AReg.Regs, S: set<LG.GroupId>)
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re) && PIV.CapUnique(re)
    requires S == PIV.CapIdsInLooks(re)
    // L3b: the leaf value is ORDERED (spec GMClose ordering); this lets NormRange
    // collapse to the identity on the outside/forward groups.
    requires M.OrderedGm(leafgm)
    // OUTSIDE S: the winning-thread tie + FLookLoop frame conclusions.
    requires GmtTieOutside(re, th, leafgm, S)
    requires forall k: int :: k !in PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)) ==>
               AI.get_idx(AReg.as_arrays(res0).0, k) == AI.get_idx(AReg.as_arrays(th.capture_regs).0, k)
               && AI.get_idx(AReg.as_arrays(res0).1, k) == AI.get_idx(AReg.as_arrays(th.capture_regs).1, k)
    requires forall q: nat :: q in PIV.QuantIdsOutsideLooks(re) ==>
               AI.get_idx(AReg.as_arrays(res2).1, q) == AI.get_idx(AReg.as_arrays(th.quant_regs).1, q)
    // INSIDE S, present: the leaf value is the POSITIONAL normalization of the
    // reconstructed value (aggregated per-g from `InsidePresentResBridge`; the
    // reversed lookbehind span is swapped, forward looks are unchanged).
    requires forall g: LG.GroupId :: g in S && g in leafgm ==>
               g in PIV.GmOfLive(re, res0, th.look_regs, res2)
               && leafgm[g] == PIV.NormRange(PIV.GmOfLive(re, res0, th.look_regs, res2)[g])
    // INSIDE S, absent (reverse tie): the reconstruction invents no S-group the
    // leaf lacks — the other half of the key-set equality.
    requires forall g: LG.GroupId :: g in S
               && g in PIV.GmOfLive(re, res0, th.look_regs, res2) ==> g in leafgm
    ensures leafgm == PIV.NormGm(PIV.GmOfLive(re, res0, th.look_regs, res2))
  {
    var gml := PIV.GmOfLive(re, res0, th.look_regs, res2);
    var ngml := PIV.NormGm(gml);
    var gmBest := PIV.GmOfLive(re, th.capture_regs, th.look_regs, th.quant_regs);
    // S == LkBodyGroups(Translate(re)) so GmtTieOutside feeds OutsideLookValueBridge.
    M.LkBodyGroupsEqCapIdsInLooks(re);
    M.OutsideLookValueBridge(re, th.capture_regs, res0, th.look_regs, th.quant_regs, res2, gmBest, leafgm);
    forall g: LG.GroupId
      ensures (g in leafgm <==> g in ngml) && (g in leafgm ==> leafgm[g] == ngml[g])
    {
      assert (g in ngml) <==> (g in gml);              // NormGm preserves keys
      if g in leafgm {
        if g in S {
          // present ⟹ (requires) leafgm[g] == NormRange(gml[g]) == ngml[g].
        } else {
          // OutsideLookValueBridge: leafgm[g] == gml[g] off S; leafgm ORDERED ⟹
          // gml[g] ordered ⟹ NormRange is identity.
          PIV.NormRangeOrdered(gml[g]);
        }
      }
    }
    assert leafgm == ngml;
  }

  /** (L4 NESTED) Structure-agnostic clone of `L3aValueBridge`. The depth-1
      original derives the OUTSIDE-`S` leaf/reconstruction agreement internally
      from register frames via `M.OutsideLookValueBridge`, which requires
      `LookBehindFragmentRE(re)` (FALSE under nesting). Here that outside-`S`
      agreement is taken as a DIRECT premise (the endpoint supplies it via the
      nested outside frame), so the assembly carries NO fragment hypothesis and
      is entirely depth-agnostic. The INSIDE-`S` present/absent premises keep
      their EXACT shape (C4 supplies them from the 3-component chain). */
  lemma L3aValueBridgeNested(re: R.regex, th: AI.Thread, leafgm: LG.GroupMap,
                             res0: AReg.Regs, res2: AReg.Regs, S: set<LG.GroupId>)
    requires S == PIV.CapIdsInLooks(re)
    // L3b: the leaf value is ORDERED (spec GMClose ordering); this lets NormRange
    // collapse to the identity on the outside/forward groups.
    requires M.OrderedGm(leafgm)
    // OUTSIDE S: leaf agrees with the reconstructed GmOfLive (membership + value)
    // — supplied by the caller (endpoint) via the nested outside frame.
    requires forall g: LG.GroupId :: g !in S ==>
               (g in leafgm <==> g in PIV.GmOfLive(re, res0, th.look_regs, res2))
               && (g in leafgm ==> leafgm[g] == PIV.GmOfLive(re, res0, th.look_regs, res2)[g])
    // INSIDE S, present: the leaf value is the POSITIONAL normalization of the
    // reconstructed value (aggregated per-g from the 3-component chain).
    requires forall g: LG.GroupId :: g in S && g in leafgm ==>
               g in PIV.GmOfLive(re, res0, th.look_regs, res2)
               && leafgm[g] == PIV.NormRange(PIV.GmOfLive(re, res0, th.look_regs, res2)[g])
    // INSIDE S, absent (reverse tie): the reconstruction invents no S-group the
    // leaf lacks — the other half of the key-set equality.
    requires forall g: LG.GroupId :: g in S
               && g in PIV.GmOfLive(re, res0, th.look_regs, res2) ==> g in leafgm
    ensures leafgm == PIV.NormGm(PIV.GmOfLive(re, res0, th.look_regs, res2))
  {
    var gml := PIV.GmOfLive(re, res0, th.look_regs, res2);
    var ngml := PIV.NormGm(gml);
    forall g: LG.GroupId
      ensures (g in leafgm <==> g in ngml) && (g in leafgm ==> leafgm[g] == ngml[g])
    {
      assert (g in ngml) <==> (g in gml);              // NormGm preserves keys
      if g in leafgm {
        if g in S {
          // present ⟹ (requires) leafgm[g] == NormRange(gml[g]) == ngml[g].
        } else {
          // outside: leafgm[g] == gml[g] (direct premise); leafgm ORDERED ⟹
          // gml[g] ordered ⟹ NormRange is identity.
          PIV.NormRangeOrdered(gml[g]);
        }
      }
    }
    assert leafgm == ngml;
  }

  /** (L4 NESTED) `M.OutsideLookValueBridge` under `NestedFragmentRE`. The depth-1
      original goes through `PIV.GmOfLiveFrameOutside`, whose `LookBehindFragmentRE`
      requirement is FALSE under nesting. But the underlying combined cap+quant
      frame `PIV.FilterFrameOutside` is FRAGMENT-FREE (it recurses purely on the
      register-layout W-set, handling `Re_lookaround` via `FilterCaptureAgreeOutsideOwn`),
      so the nested outside frame is a SINGLE `FilterFrameOutside` call — no
      fragment hypothesis anywhere. Feeds the endpoint's outside-`S` half. */
  lemma OutsideLookValueBridgeNested(re: R.regex, capT: AReg.Regs, capR: AReg.Regs, look: AReg.Regs,
                                     quantT: AReg.Regs, quantR: AReg.Regs, gmBest: LG.GroupMap, ft: LG.GroupMap)
    requires T.TransWf(re) && NR.NestedFragmentRE(re) && PIV.CapUnique(re)
    requires gmBest == PIV.GmOfLive(re, capT, look, quantT)
    requires forall g: nat :: g !in LL.LkBodyGroups(T.Translate(re)) ==>
      (g in ft <==> g in gmBest) && (g in ft ==> ft[g] == gmBest[g])
    requires forall k: int :: k !in PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)) ==>
      AI.get_idx(AReg.as_arrays(capR).0, k) == AI.get_idx(AReg.as_arrays(capT).0, k)
      && AI.get_idx(AReg.as_arrays(capR).1, k) == AI.get_idx(AReg.as_arrays(capT).1, k)
    requires forall q: nat :: q in PIV.QuantIdsOutsideLooks(re) ==>
      AI.get_idx(AReg.as_arrays(quantR).1, q) == AI.get_idx(AReg.as_arrays(quantT).1, q)
    ensures forall g: nat :: g !in PIV.CapIdsInLooks(re) ==>
      (g in ft <==> g in PIV.GmOfLive(re, capR, look, quantR))
      && (g in ft ==> ft[g] == PIV.GmOfLive(re, capR, look, quantR)[g])
  {
    M.LkBodyGroupsEqCapIdsInLooks(re);                 // LkBodyGroups(Translate(re)) == CapIdsInLooks(re)
    var W := PIV.CaptureRegsSet(PIV.CapIdsInLooks(re));
    var crA := AReg.as_arrays(capT).0;  var ccA := AReg.as_arrays(capT).1;
    var crB := AReg.as_arrays(capR).0;  var ccB := AReg.as_arrays(capR).1;
    var lc := AReg.as_arrays(look).1;
    var qcA := AReg.as_arrays(quantT).1; var qcB := AReg.as_arrays(quantR).1;

    // structural requires of FilterFrameOutside (mirrors GmOfLiveFrameOutside)
    PIV.CapIdsLooksDisjoint(re);
    assert forall g: nat :: g in PIV.CapIdsInLooks(re) ==> CP.start_reg(g) in W by {
      forall g: nat | g in PIV.CapIdsInLooks(re) ensures CP.start_reg(g) in W { PIV.StartRegInCaptureRegsSet(PIV.CapIdsInLooks(re), g); }
    }
    assert forall g: nat :: g in PIV.CapIdsOutsideLooks(re) ==> CP.start_reg(g) !in W by {
      forall g: nat | g in PIV.CapIdsOutsideLooks(re) ensures CP.start_reg(g) !in W {
        assert g !in PIV.CapIdsInLooks(re) by { if g in PIV.CapIdsInLooks(re) { assert g in PIV.CapIdsOutsideLooks(re) * PIV.CapIdsInLooks(re); } }
        PIV.StartRegInCaptureRegsSet(PIV.CapIdsInLooks(re), g);
      }
    }
    assert forall x: int :: x in W ==> x >= 0 by {
      forall x: int | x in W ensures x >= 0 {}
    }
    // single combined cap+quant swap outside W (FRAGMENT-FREE).
    PIV.FilterFrameOutside(re, crA, crB, ccA, ccB, lc, qcA, qcB, -1, W);

    var f1 := AI.filter_reset(re, capT, look, quantT, -1);
    var f2 := AI.filter_reset(re, capR, look, quantR, -1);
    assert f1 == AI.filter_capture(re, crA, ccA, lc, qcA, -1);
    assert f2 == AI.filter_capture(re, crB, ccB, lc, qcB, -1);

    forall g: nat | g !in PIV.CapIdsInLooks(re)
      ensures (g in ft <==> g in PIV.GmOfLive(re, capR, look, quantR))
           && (g in ft ==> ft[g] == PIV.GmOfLive(re, capR, look, quantR)[g])
    {
      assert g !in LL.LkBodyGroups(T.Translate(re));       // set identity
      PIV.StartRegInCaptureRegsSet(PIV.CapIdsInLooks(re), g);
      PIV.EndRegInCaptureRegsSet(PIV.CapIdsInLooks(re), g);
      assert CP.start_reg(g) !in W && CP.end_reg(g) !in W;
      assert AI.get_idx(f1, CP.start_reg(g)) == AI.get_idx(f2, CP.start_reg(g));
      assert AI.get_idx(f1, CP.end_reg(g)) == AI.get_idx(f2, CP.end_reg(g));
      assert AI.get_idx(ccA, CP.start_reg(g)) == AI.get_idx(ccB, CP.start_reg(g));
      assert AI.get_idx(ccA, CP.end_reg(g)) == AI.get_idx(ccB, CP.end_reg(g));
    }
  }

  // ==========================================================================
  // ---- (K) THE COMPOSITE SIM (thread-anchored — audit 2026-08-03) ------------
  //
  // ARCHITECTURE (settled by the #5 engine-connection audit): ride the PROVEN
  // machine-A simulation `PSM.PikeInvFullRE` for ALL VM mechanics (queue,
  // priority, seen, blocked, loop/BeginLoop via its `TreeRepRE` `tr_begin`), and
  // carry the LK-machine `ptsB` (`PTL.PikeTreeStepLk`, on the spec tree `t`)
  // ALONGSIDE — its trees paired to the VM THREADS via the standalone
  // `ThreadRepLk`/`ActiveRepLk`, NOT to the tstar trees.
  //
  // WHY THREAD-ANCHORED (not the dead §K tree↔tree route): `ActionsTreeRepFRE`
  // erases the LK head when building tstar, so `ta` (tstar) can NEVER recover
  // `tb` (LK) via `LeavesAgreeAtOutside` — that pairing is dead. BUT both
  // `PIV.ActiveRepRE(ta, vms.active)` (inside `PikeInvFullRE`) and
  // `ActiveRepLk(tb, vms.active)` are INDEX-WISE over the SAME `vms.active`, so
  // the VM thread is the shared anchor: carry PikeInvFullRE(ptsA,vms) AND
  // ThreadRepLk(tb,thread) as independent companions of one VM — no ta↔tb link.
  //
  // KEY STRUCTURAL FACTS:
  //  * `PikeInvFullRE(ptsA, vms)` relates the VM to `ptsA` (gate-transparent
  //    tstar), index-wise `vms.active[i]` ↔ `ptsA.active[i]` via `TreeRepRE`.
  //  * `PTL.PikeTreeStepLk` has the SAME case shape (skip/final/nextchar/active/
  //    match/blocked) as the tstar `PikeTreeStep` — so ptsA and ptsB step in
  //    LOCKSTEP with the same VM worklist. `LiftStepC` mirrors the PROVEN
  //    `PSM.InvariantPreservationRE` (ptsA side) with the per-instruction tb
  //    cores (ptsB side); `L3aCompositeClose` mirrors `PSM.FindMatchSimRE`.
  //  * `GateStepValue` (verified) preserves `GmtTieInside` across a passing gate
  //    (the crux; `ThreadRepLkStepCheckOracle` integrates it). Position tie is
  //    automatic — `ptsA.inp == ptsB.inp == InpOfCp(str, vms.cp)`.
  //  * Endpoint: `PTL.PikeTreeLkComputesFirstLeaf` ⟹ ptsB.best == FirstLeaf(t)
  //    (inside tie via `BestTieLk`); `PIV.BestMatchRE` gives the outside tie.

  // (K-pairing) DELETED `LiftPairC`/`ActivePairC` — the tstar-tree↔LK-tree
  // `LeavesAgreeAtOutside` pairing (the DEAD §K route: `ActionsTreeRepFRE` erases
  // the LK head, so `ta` can't recover `tb`). The composite now uses the THREAD-
  // anchored `ThreadRepLk`/`ActiveRepLk` directly (see `LiftInvC`): each ptsB tree
  // pairs with the VM thread, never with the tstar tree, so no ta↔tb link is
  // needed. Position tie stays automatic — `LiftInvC` pins `ptsA.inp == ptsB.inp
  // == InpOfCp(str, vms.cp)`, so the VM's `a_cp[l] := cp` at `CheckOracle(l)` IS
  // the gate's input position that `GateStepValue` consumes.

  // ---- (c′) the CANONICAL pairing layer (2026-08-07) -----------------------
  //
  // Machine B RUNS the PLANTED canonical tree `tcan` (built at entry by
  // `ActionsTreeRepLkRE`): unique per `(pc, ea)` by `TreeRepLkDetermRE` — the
  // skip-lockstep key — and stutter-discriminating, so `PikeTreeLk`'s
  // exact-tree memo works unchanged. The VALUE layer (all the proven
  // `ThreadRepLkStep*`/`WalkPairLkAt*` cores, on raw `BoolTreeLk` trees)
  // pairs the SAME thread through an ERASURE EXISTENTIAL: a raw witness
  // `traw` with `ProgErase(traw) == ProgErase(tcan)`. The planted guards are
  // leaf- and gm-transparent (`ProgEraseLeavesEq`; `Progress` is a pure
  // stutter in `TreeBfsStepLk`), so the raw walk's value conclusions
  // transport to `tcan` verbatim.
  //
  // WHY the existential (and NOT `WalkPairLk(tcan)` directly): `tcan` is NOT
  // `BoolTreeLk`-representable in general — `BoolTreeLk`'s forced-copy rule
  // (`Quantified min>0`) fixes the guardless continuation
  // `[Areg(r1), Areg(Quantified(min-1,..))]+cont`, so the planted
  // first-arrival `Progress` at a do-while's backward fork (e.g. in `a+`)
  // exists under NO action stack. Erasure is exactly the quotient on which
  // the two layers agree.

  /** Canonical per-thread pairing: the B-side tree `tcan` is the planted
      canonical tree at the thread's `(pc, exit_allowed)`, and the thread's
      value pairing rides a raw erasure-witness. */
  ghost predicate ThreadRepLkC(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                               inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                               S: set<LG.GroupId>, tcan: LT.Tree, gmt: LG.GroupMap, th: AI.Thread,
                               ncap: int, nlook: int, nquant: int) {
    th.pc >= 0
    && TreeRepLkRE(rer, qm, code, inp, tcan, th.pc as nat, th.exit_allowed)
    && exists traw: LT.Tree ::
         CE.ProgErase(traw) == CE.ProgErase(tcan)
         && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, traw, gmt, th, ncap, nlook, nquant)
  }

  /** (L4 NESTED) Canonical per-thread pairing riding the `*Nested` payload:
      identical to `ThreadRepLkC` but the erasure-witnessed raw pairing is
      `ThreadRepLkNested` (the `GmtTieInside`-free form). */
  ghost predicate ThreadRepLkCNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                     inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                     S: set<LG.GroupId>, tcan: LT.Tree, gmt: LG.GroupMap, th: AI.Thread,
                                     ncap: int, nlook: int, nquant: int) {
    th.pc >= 0
    && TreeRepLkRE(rer, qm, code, inp, tcan, th.pc as nat, th.exit_allowed)
    && exists traw: LT.Tree ::
         CE.ProgErase(traw) == CE.ProgErase(tcan)
         && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, traw, gmt, th, ncap, nlook, nquant)
  }

  /** Canonical active-list pairing (index-wise, priority positional) —
      `ActiveRepLk`'s shape with `ThreadRepLkC`. */
  ghost predicate ActiveRepLkC(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                               inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                               S: set<LG.GroupId>, tl: seq<(LT.Tree, LG.GroupMap)>, vl: seq<AI.Thread>,
                               ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |vl| == 0)
    || (|tl| > 0 && |vl| > 0
        && ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, tl[0].0, tl[0].1, vl[0],
                        ncap, nlook, nquant)
        && ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, tl[1..], vl[1..],
                        ncap, nlook, nquant))
  }

  /** (L4 NESTED) Canonical active-list pairing riding `ThreadRepLkCNested`
      (the `GmtTieInside`-free per-thread tie). */
  ghost predicate ActiveRepLkCNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                               inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                               S: set<LG.GroupId>, tl: seq<(LT.Tree, LG.GroupMap)>, vl: seq<AI.Thread>,
                               ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |vl| == 0)
    || (|tl| > 0 && |vl| > 0
        && ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, tl[0].0, tl[0].1, vl[0],
                        ncap, nlook, nquant)
        && ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, tl[1..], vl[1..],
                        ncap, nlook, nquant))
  }

  /** Canonical blocked-list pairing — `BlockedRepLk`'s shape with the
      canonical tie at `(pc+1, CanExit)` over `nextinp` plus the erasure
      existential to a raw `TtLk` witness. */
  ghost predicate BlockedRepLkC(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                                ov: LOr.OracleView, S: set<LG.GroupId>,
                                tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                                ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |bl| == 0)
    || (|tl| > 0 && |bl| > 0
        && bl[0].0.pc >= 0
        && TreeRepLkRE(rer, qm, code, nextinp, tl[0].0, (bl[0].0.pc + 1) as nat, true)
        && (exists traw: LT.Tree ::
              CE.ProgErase(traw) == CE.ProgErase(tl[0].0)
              && WalkPairLk(rer, qm, code, nextinp, traw, tl[0].1, (bl[0].0.pc + 1) as nat, true))
        && GmtTieOutside(re, bl[0].0, tl[0].1, S)
        && GmtTieInside(crv, str, ov, bl[0].0, tl[0].1, S, ncap, nlook, nquant)
        && BlockedRepLkC(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                         ncap, nlook, nquant))
  }

  /** (L4 NESTED) Canonical blocked-list pairing with the depth-1-hardwired
      `GmtTieInside` conjunct DROPPED (see `ThreadRepLkNested`). Canonical tie
      + raw-`WalkPairLk` erasure witness + outside value tie kept verbatim. */
  ghost predicate BlockedRepLkCNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                      inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                                      ov: LOr.OracleView, S: set<LG.GroupId>,
                                      tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                                      ncap: int, nlook: int, nquant: int)
    decreases tl
  {
    (|tl| == 0 && |bl| == 0)
    || (|tl| > 0 && |bl| > 0
        && bl[0].0.pc >= 0
        && TreeRepLkRE(rer, qm, code, nextinp, tl[0].0, (bl[0].0.pc + 1) as nat, true)
        && (exists traw: LT.Tree ::
              CE.ProgErase(traw) == CE.ProgErase(tl[0].0)
              && WalkPairLk(rer, qm, code, nextinp, traw, tl[0].1, (bl[0].0.pc + 1) as nat, true))
        && GmtTieOutside(re, bl[0].0, tl[0].1, S)
        && BlockedRepLkCNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                               ncap, nlook, nquant))
  }

  /** THE COMPOSITE INVARIANT: machine-A sim (VM↔tstar, PROVEN) PLUS the
      machine-A↔machine-B tree pairing + value payload. `ptsA` is the tstar
      (gate-transparent) PikeTree state driven by `PikeInvFullRE`; `ptsB` is the
      `tcan` (LK-aware, planted-canonical) PikeTree state driven by
      `PTL.PikeTreeStepLk`. */
  ghost predicate LiftInvC(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                           endl: nat, ngroups: nat, crv: CP.FCompiled, str: string,
                           ov: LOr.OracleView, S: set<LG.GroupId>,
                           ptsA: PT.PikeTreeState, ptsB: PT.PikeTreeState, vms: AI.VmState,
                           ncap: int, nlook: int, nquant: int)
    requires NR.NfaRepRE(re, code, 0, endl)
  {
    PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, vms, ncap, nlook, nquant)
    // THREAD-ANCHORED pairing (audit 2026-08-03): each ptsB tree pairs with
    // the VM thread via ThreadRepLkC (canonical tie + raw erasure witness),
    // NOT with the tstar tree — so no ta↔tb link is needed (that was the
    // dead §K route). ptsA is carried only for PikeInvFullRE's VM backbone;
    // the whole B side IS the (canonical-keyed) standalone `LiftInv`.
    && (ptsB.PTS? ==> ptsA.PTS? && ptsA.inp == ptsB.inp)
    && LiftInv(rer, qm, re, code, crv, str, ov, S, ptsB, vms, ncap, nlook, nquant)
  }

  /** (L4 NESTED) The composite invariant carrying the `GmtTieInside`-free
      standalone `LiftInvNested`. The machine-A backbone (`PikeInvFullRE`) and
      the ptsA↔ptsB `inp` link are depth-agnostic and kept verbatim. */
  ghost predicate LiftInvCNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                           endl: nat, ngroups: nat, crv: CP.FCompiled, str: string,
                           ov: LOr.OracleView, S: set<LG.GroupId>,
                           ptsA: PT.PikeTreeState, ptsB: PT.PikeTreeState, vms: AI.VmState,
                           ncap: int, nlook: int, nquant: int)
    requires NR.NfaRepRE(re, code, 0, endl)
  {
    PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, vms, ncap, nlook, nquant)
    && (ptsB.PTS? ==> ptsA.PTS? && ptsA.inp == ptsB.inp)
    && LiftInvNested(rer, qm, re, code, crv, str, ov, S, ptsB, vms, ncap, nlook, nquant)
  }

  /** (K-init) The composite holds at the start: `PSM.InitialPikeInvFullRE` gives
      the machine-A half; machine B starts on the PLANTED CANONICAL tree `tcan`
      (constructed here by `ActionsTreeRepLkRE` from the entry walk, with
      `WkE.WalkOkEntry` supplying the walk carrier), erasure-tied to the spec
      walk tree `t` — the endpoint glue is `FirstLeaf(tcan) == FirstLeaf(t)`
      via `ProgEraseLeavesEq`. The single active pair `(tcan, init_thread)`
      ties via `ThreadRepLkC` with raw witness `t` + a VACUOUS payload
      (init thread's live map is `LG.Empty`, no `g in S`). */
  lemma LiftInitC(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                  endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                  S: set<LG.GroupId>, tstar: LT.Tree, t: LT.Tree, inp: LC.Input, vms: AI.VmState,
                  ncap: int, nlook: int, nquant: int)
    returns (tcan: LT.Tree)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires code == CP.compile_to_bytecode(re)               // WalkOkEntry's carrier
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str,
                               PT.PikeTreeInitialState(tstar, inp), vms, ncap, nlook, nquant)
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re) && PIV.CapUnique(re)
    requires AR.ActionsRepL(rer, qm, [LS.Areg(T.Translate(re))], code, 0)
    requires EL.BoolTreeLk(rer, [LS.Areg(T.Translate(re))], inp, BS.CannotExit, t)
    requires LL.OracleOkSuffix(rer, qm, inp)
    requires inp == PIV.InpOfCp(str, vms.cp) && 0 <= vms.cp <= |str|
    requires vms.active == [AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant))]
    requires vms.bestmatch.None?
    requires vms.blocked == []                                // genuine start: nothing blocked yet
    requires vms.processed == AI.init_bpcset(RB.size(code))   // genuine start: nothing processed yet
    requires vms.isblocked == AI.init_pcset(RB.size(code))
    requires PIV.ContextOkRE(str, vms.cp, vms.context)
    ensures TreeRepLkRE(rer, qm, code, inp, tcan, 0, false)
    ensures CE.ProgErase(tcan) == CE.ProgErase(t)             // endpoint glue: FirstLeaf(tcan) == FirstLeaf(t)
    ensures LiftInvC(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                     PT.PikeTreeInitialState(tstar, inp), PT.PikeTreeInitialState(tcan, inp), vms,
                     ncap, nlook, nquant)
  {
    // The single active pair (t, init_thread) ties via ThreadRepLk (THREAD-
    // anchored — no tstar↔t tree link); the payload is vacuous because a fresh
    // thread denotes Empty. PikeInvFullRE(ptsA, vms) is the hypothesis.
    PIV.GmOfLiveInit(re, ncap, nlook, nquant);        // GmOfLive(re, init...) == Empty
    var it := AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant));
    var acts := [LS.Areg(T.Translate(re))];
    assert it.pc == 0 && it.exit_allowed == false;
    assert it.capture_regs == AReg.init_regs(ncap)
        && it.look_regs == AReg.init_regs(nlook) && it.quant_regs == AReg.init_regs(nquant);
    EL.TranslateFragmentPikeLk(re);                     // PikeLkRegex(Translate(re))
    EL.PikeLkActionsConsIff(LS.Areg(T.Translate(re)), []);
    assert EL.PikeLkActions(acts);
    assert GateAheadClear(acts, LG.Empty);              // Empty has no keys
    TranslateDefGroupsNoDup(re);                        // NoDupSeq(DefGroups(Translate(re)))
    WalkDefsOkEntry(T.Translate(re));
    M.AllDefsActsCons(LS.Areg(T.Translate(re)), []);
    assert M.AllDefsActs(acts) == L.DefGroups(T.Translate(re));   // AllDefsActs([]) == []
    assert WalkPairLk(rer, qm, code, inp, t, LG.Empty, it.pc as nat, it.exit_allowed) by {
      assert it.pc as nat == 0;
      assert AR.ActionsRepL(rer, qm, acts, code, 0);
      assert ATR.EaOf(BS.CannotExit) == it.exit_allowed;   // both false
      assert EL.BoolTreeLk(rer, acts, inp, BS.CannotExit, t);
      assert exists actsw: LS.Actions, bw: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, actsw, code, it.pc as nat)
          && EL.PikeLkActions(actsw)
          && ATR.EaOf(bw) == it.exit_allowed
          && EL.BoolTreeLk(rer, actsw, inp, bw, t)
          && GateAheadClear(actsw, LG.Empty)
          && WalkDefsOk(actsw);
    }
    assert GmtTieOutside(re, it, LG.Empty, S);          // gml == Empty, agrees with Empty
    assert GmtTieInside(crv, str, ov, it, LG.Empty, S, ncap, nlook, nquant);  // no g in Empty
    assert ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, t, LG.Empty, it, ncap, nlook, nquant);
    // Construct machine B's PLANTED CANONICAL entry tree; the raw walk tree
    // `t` is its value-layer erasure witness.
    WkE.WalkOkEntry(re);
    assert WO.WalkOk(acts, code, 0, false);
    assert ATR.EaOf(BS.CannotExit) == false;
    tcan := ActionsTreeRepLkRE(rer, qm, acts, code, 0, inp, BS.CannotExit, t);
    assert ThreadRepLkC(rer, qm, re, code, inp, crv, str, ov, S, tcan, LG.Empty, it,
                        ncap, nlook, nquant) by {
      assert TreeRepLkRE(rer, qm, code, inp, tcan, it.pc as nat, it.exit_allowed);
      assert CE.ProgErase(t) == CE.ProgErase(tcan)
          && ThreadRepLk(rer, qm, re, code, inp, crv, str, ov, S, t, LG.Empty, it, ncap, nlook, nquant);
    }
    assert ActiveRepLkC(rer, qm, re, code, inp, crv, str, ov, S, [(tcan, LG.Empty)], [it], ncap, nlook, nquant);
    // ptsB = PTS(inp, [(tcan, Empty)], None, [], InitialSeenTrees); best None both sides.
    assert PT.PikeTreeInitialState(tcan, inp) == PT.PTS(inp, [(tcan, LG.Empty)], None, [], SS.InitialSeenTrees);
    assert PT.PikeTreeInitialState(tstar, inp).PTS? && PT.PikeTreeInitialState(tstar, inp).inp == inp;
    assert BestTieLk(re, crv, str, ov, S, None, vms.bestmatch, ncap, nlook, nquant);
    // Blocked: genuine start — both sides empty.
    assert PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp) == [];
    forall nextinp | LC.AdvanceInput(inp, WP.Forward) == Some(nextinp)
      ensures BlockedRepLkC(rer, qm, re, code, inp, nextinp, crv, str, ov, S, [],
                            PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant)
    { }
    // B-side seen ↔ processed: at the genuine start nothing is processed, so
    // `SeenRepLk` holds vacuously (mirror of `PIV.InitialInclusionRE`).
    InitialSeenRepLk(rer, qm, code, inp,
                     PIV.HdTreeOf([(tcan, LG.Empty)]), PIV.HeadPcOf([it]), RB.size(code));
  }

  /** (L4 NESTED) clone of `LiftInitC` — GmtTieInside dropped. */
  lemma LiftInitCNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                  endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                  S: set<LG.GroupId>, tstar: LT.Tree, t: LT.Tree, inp: LC.Input, vms: AI.VmState,
                  ncap: int, nlook: int, nquant: int)
    returns (tcan: LT.Tree)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires code == CP.compile_to_bytecode(re)               // WalkOkEntry's carrier
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str,
                               PT.PikeTreeInitialState(tstar, inp), vms, ncap, nlook, nquant)
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re) && PIV.CapUnique(re)
    requires AR.ActionsRepL(rer, qm, [LS.Areg(T.Translate(re))], code, 0)
    requires EL.BoolTreeLk(rer, [LS.Areg(T.Translate(re))], inp, BS.CannotExit, t)
    requires LL.OracleOkSuffix(rer, qm, inp)
    requires inp == PIV.InpOfCp(str, vms.cp) && 0 <= vms.cp <= |str|
    requires vms.active == [AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant))]
    requires vms.bestmatch.None?
    requires vms.blocked == []                                // genuine start: nothing blocked yet
    requires vms.processed == AI.init_bpcset(RB.size(code))   // genuine start: nothing processed yet
    requires vms.isblocked == AI.init_pcset(RB.size(code))
    requires PIV.ContextOkRE(str, vms.cp, vms.context)
    ensures TreeRepLkRE(rer, qm, code, inp, tcan, 0, false)
    ensures CE.ProgErase(tcan) == CE.ProgErase(t)             // endpoint glue: FirstLeaf(tcan) == FirstLeaf(t)
    ensures LiftInvCNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                     PT.PikeTreeInitialState(tstar, inp), PT.PikeTreeInitialState(tcan, inp), vms,
                     ncap, nlook, nquant)
  {
    // The single active pair (t, init_thread) ties via ThreadRepLk (THREAD-
    // anchored — no tstar↔t tree link); the payload is vacuous because a fresh
    // thread denotes Empty. PikeInvFullRE(ptsA, vms) is the hypothesis.
    PIV.GmOfLiveInit(re, ncap, nlook, nquant);        // GmOfLive(re, init...) == Empty
    var it := AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant));
    var acts := [LS.Areg(T.Translate(re))];
    assert it.pc == 0 && it.exit_allowed == false;
    assert it.capture_regs == AReg.init_regs(ncap)
        && it.look_regs == AReg.init_regs(nlook) && it.quant_regs == AReg.init_regs(nquant);
    EL.TranslateFragmentPikeLk(re);                     // PikeLkRegex(Translate(re))
    EL.PikeLkActionsConsIff(LS.Areg(T.Translate(re)), []);
    assert EL.PikeLkActions(acts);
    assert GateAheadClear(acts, LG.Empty);              // Empty has no keys
    TranslateDefGroupsNoDup(re);                        // NoDupSeq(DefGroups(Translate(re)))
    WalkDefsOkEntry(T.Translate(re));
    M.AllDefsActsCons(LS.Areg(T.Translate(re)), []);
    assert M.AllDefsActs(acts) == L.DefGroups(T.Translate(re));   // AllDefsActs([]) == []
    assert WalkPairLk(rer, qm, code, inp, t, LG.Empty, it.pc as nat, it.exit_allowed) by {
      assert it.pc as nat == 0;
      assert AR.ActionsRepL(rer, qm, acts, code, 0);
      assert ATR.EaOf(BS.CannotExit) == it.exit_allowed;   // both false
      assert EL.BoolTreeLk(rer, acts, inp, BS.CannotExit, t);
      assert exists actsw: LS.Actions, bw: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, actsw, code, it.pc as nat)
          && EL.PikeLkActions(actsw)
          && ATR.EaOf(bw) == it.exit_allowed
          && EL.BoolTreeLk(rer, actsw, inp, bw, t)
          && GateAheadClear(actsw, LG.Empty)
          && WalkDefsOk(actsw);
    }
    assert GmtTieOutside(re, it, LG.Empty, S);          // gml == Empty, agrees with Empty
    assert ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, t, LG.Empty, it, ncap, nlook, nquant);
    // Construct machine B's PLANTED CANONICAL entry tree; the raw walk tree
    // `t` is its value-layer erasure witness.
    WkE.WalkOkEntry(re);
    assert WO.WalkOk(acts, code, 0, false);
    assert ATR.EaOf(BS.CannotExit) == false;
    tcan := ActionsTreeRepLkRE(rer, qm, acts, code, 0, inp, BS.CannotExit, t);
    assert ThreadRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, tcan, LG.Empty, it,
                        ncap, nlook, nquant) by {
      assert TreeRepLkRE(rer, qm, code, inp, tcan, it.pc as nat, it.exit_allowed);
      assert CE.ProgErase(t) == CE.ProgErase(tcan)
          && ThreadRepLkNested(rer, qm, re, code, inp, crv, str, ov, S, t, LG.Empty, it, ncap, nlook, nquant);
    }
    assert ActiveRepLkCNested(rer, qm, re, code, inp, crv, str, ov, S, [(tcan, LG.Empty)], [it], ncap, nlook, nquant);
    // ptsB = PTS(inp, [(tcan, Empty)], None, [], InitialSeenTrees); best None both sides.
    assert PT.PikeTreeInitialState(tcan, inp) == PT.PTS(inp, [(tcan, LG.Empty)], None, [], SS.InitialSeenTrees);
    assert PT.PikeTreeInitialState(tstar, inp).PTS? && PT.PikeTreeInitialState(tstar, inp).inp == inp;
    assert BestTieLkNested(re, crv, str, ov, S, None, vms.bestmatch, ncap, nlook, nquant);
    // Blocked: genuine start — both sides empty.
    assert PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp) == [];
    forall nextinp | LC.AdvanceInput(inp, WP.Forward) == Some(nextinp)
      ensures BlockedRepLkCNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, [],
                            PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant)
    { }
    // B-side seen ↔ processed: at the genuine start nothing is processed, so
    // `SeenRepLk` holds vacuously (mirror of `PIV.InitialInclusionRE`).
    InitialSeenRepLk(rer, qm, code, inp,
                     PIV.HdTreeOf([(tcan, LG.Empty)]), PIV.HeadPcOf([it]), RB.size(code));
  }

  /** (K-step) The composite is preserved across ONE ε-phase. Machine A
      advances by the PROVEN `PSM.InvariantPreservationRE` (a whole-phase
      `TrcRE` — queue/priority/loop mechanics inherited, never re-proved);
      machine B advances by `LiftAdvanceEpsilon` (the B-side worklist
      recursion over the SAME VM steps). The two sides never link directly:
      each pins its `inp` to `InpOfCp(str, cp)` through its own invariant. */
  lemma LiftStepC(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                  endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                  S: set<LG.GroupId>, ptsA: PT.PikeTreeState, ptsB: PT.PikeTreeState, vms: AI.VmState,
                  ncap: int, nlook: int, nquant: int)
    returns (ptsA': PT.PikeTreeState, ptsB': PT.PikeTreeState)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires PSM.StaticOkRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires S == PIV.CapIdsInLooks(re)   // the value-tie boundary (SetReg/gate cases)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)   // per-lid look-table package (gate-pass case)
    requires LTB.LookUnique(re)           // (E3) cross-lid ownership pinning
    requires LTB.LookTablesOk(re, crv)    // (E4) row↔structure tie (gate converse)
    requires ptsA.PTS? && ptsB.PTS?
    requires |vms.processed.true_set| == RB.size(code) && |vms.processed.false_set| == RB.size(code)
    requires LiftInvC(rer, qm, re, code, endl, ngroups, crv, str, ov, S, ptsA, ptsB, vms, ncap, nlook, nquant)
    ensures PTL.TrcPikeTreeLk(ptsB, ptsB')
    ensures ptsA'.PTS? && ptsB'.PTS?
    ensures LiftInvC(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                     ptsA', ptsB', AI.FAdvanceEpsilon(code, vms, ov, LAnc.Forward).0, ncap, nlook, nquant)
  {
    var vms' := AI.FAdvanceEpsilon(code, vms, ov, LAnc.Forward).0;
    // ONE call: the composite dispatcher steps machine A per-case by the
    // proven Preserve*Case lemmas and machine B by the LiftPreserve*Lk tier.
    ptsA', ptsB' := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                       ptsA, vms, ptsB, LAnc.Forward, ncap, nlook, nquant);
    // the inp link: both sides pin their inp to InpOfCp(str, vms'.cp)
    assert PIV.PikeInvRE(rer, qm, re, code, ngroups, str, ptsA', vms');
    assert ptsA'.inp == PIV.InpOfCp(str, vms'.cp);
    assert ptsB'.inp == PIV.InpOfCp(str, vms'.cp);
  }

  /** (L4 NESTED) clone of `LiftStepC` — GmtTieInside dropped. */
  lemma LiftStepCNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                  endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                  S: set<LG.GroupId>, ptsA: PT.PikeTreeState, ptsB: PT.PikeTreeState, vms: AI.VmState,
                  ncap: int, nlook: int, nquant: int)
    returns (ptsA': PT.PikeTreeState, ptsB': PT.PikeTreeState)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires PSM.StaticOkNestedRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires S == PIV.CapIdsInLooks(re)   // the value-tie boundary (SetReg/gate cases)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)   // per-lid look-table package (gate-pass case)
    requires LTB.LookUnique(re)           // (E3) cross-lid ownership pinning
    requires LTB.LookTablesOk(re, crv)    // (E4) row↔structure tie (gate converse)
    requires ptsA.PTS? && ptsB.PTS?
    requires |vms.processed.true_set| == RB.size(code) && |vms.processed.false_set| == RB.size(code)
    requires LiftInvCNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S, ptsA, ptsB, vms, ncap, nlook, nquant)
    ensures PTL.TrcPikeTreeLk(ptsB, ptsB')
    ensures ptsA'.PTS? && ptsB'.PTS?
    ensures LiftInvCNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                     ptsA', ptsB', AI.FAdvanceEpsilon(code, vms, ov, LAnc.Forward).0, ncap, nlook, nquant)
  {
    var vms' := AI.FAdvanceEpsilon(code, vms, ov, LAnc.Forward).0;
    // ONE call: the composite dispatcher steps machine A per-case by the
    // proven Preserve*Case lemmas and machine B by the LiftPreserve*Lk tier.
    ptsA', ptsB' := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                       ptsA, vms, ptsB, LAnc.Forward, ncap, nlook, nquant);
    // the inp link: both sides pin their inp to InpOfCp(str, vms'.cp)
    assert PIV.PikeInvRE(rer, qm, re, code, ngroups, str, ptsA', vms');
    assert ptsA'.inp == PIV.InpOfCp(str, vms'.cp);
    assert ptsB'.inp == PIV.InpOfCp(str, vms'.cp);
  }

  /** (K-close) TOP-LEVEL: the winning VM thread and the spec tree's FIRST LEAF
      satisfy the two-sided value tie (`BestTieLk` = `GmtTieOutside` +
      `GmtTieInside`). Drives `LiftInitC` → `LiftStepC*` → the `PTS_final` case,
      mirroring `FindMatchSimRE` on the machine-A side and `PTL.TrcPikeTreeLk` +
      `PTL.PikeTreeLkComputesFirstLeaf` on the machine-B side. This is the SINGLE
      remaining sim output; it feeds `WinningGmtTieOutside` (already banked) and,
      per-`g`, `InsidePresentResBridge` → `L3aValueBridge`. BODILESS — this is
      where the (E) path-presence, the reverse tie, and the position tie
      (`a_cp[l]` == the LK node's first-leaf position) are discharged. */
  /** `PikeSubtreeLk` transfers across erasure-equality: erasure drops only
      `Progress` wrappers and maps every other constructor (incl. the
      unconstrained LK bodies) in place, so `ReadBackRef`-freeness is
      erasure-invariant. Lets the FirstLeaf theorem run on `tcan` from the raw
      entry tree's shape fact. */
  lemma PikeSubtreeLkEraseIff(x: LT.Tree)
    ensures PTL.PikeSubtreeLk(x) <==> PTL.PikeSubtreeLk(CE.ProgErase(x))
    decreases x
  {
    match x
    case Choice(t1, t2) => PikeSubtreeLkEraseIff(t1); PikeSubtreeLkEraseIff(t2);
    case Read(_, t1) => PikeSubtreeLkEraseIff(t1);
    case ReadBackRef(_, t1) =>
    case Progress(t1) => PikeSubtreeLkEraseIff(t1);
    case AnchorPass(_, t1) => PikeSubtreeLkEraseIff(t1);
    case GroupActionT(_, t1) => PikeSubtreeLkEraseIff(t1);
    case LK(_, _, t1) => PikeSubtreeLkEraseIff(t1);
    case _ =>
  }

  /** BLOCKED → ACTIVE at the consume: each stored pair reactivates into the
      resumed thread (`pc+1`, flag re-armed, registers unchanged) — the
      canonical tie and the strengthened `WalkPairLk` witness were stored at
      exactly that shape, and the value ties read only the registers. */
  lemma BlockedToActiveLkC(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                           inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                           ov: LOr.OracleView, S: set<LG.GroupId>,
                           tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                           ncap: int, nlook: int, nquant: int)
    requires BlockedRepLkC(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl, bl, ncap, nlook, nquant)
    ensures ActiveRepLkC(rer, qm, re, code, nextinp, crv, str, ov, S, tl, PSM.ResumeAll(bl),
                         ncap, nlook, nquant)
    decreases tl
  {
    if |tl| == 0 {
      assert |bl| == 0;
    } else {
      assert |bl| > 0;
      var th := bl[0].0;
      var rth := th.(exit_allowed := true, pc := th.pc + 1);
      assert PSM.ResumeAll(bl) == [rth] + PSM.ResumeAll(bl[1..]);
      assert rth.pc >= 0 && (rth.pc as nat) == (th.pc + 1) as nat;
      assert TreeRepLkRE(rer, qm, code, nextinp, tl[0].0, rth.pc as nat, rth.exit_allowed);
      var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(tl[0].0)
        && WalkPairLk(rer, qm, code, nextinp, traw, tl[0].1, (th.pc + 1) as nat, true);
      assert rth.capture_regs == th.capture_regs && rth.look_regs == th.look_regs
          && rth.quant_regs == th.quant_regs;
      assert GmtTieOutside(re, rth, tl[0].1, S)
          && GmtTieInside(crv, str, ov, rth, tl[0].1, S, ncap, nlook, nquant);
      assert ThreadRepLk(rer, qm, re, code, nextinp, crv, str, ov, S, traw, tl[0].1, rth,
                         ncap, nlook, nquant);
      assert ThreadRepLkC(rer, qm, re, code, nextinp, crv, str, ov, S, tl[0].0, tl[0].1, rth,
                          ncap, nlook, nquant);
      BlockedToActiveLkC(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                         ncap, nlook, nquant);
      assert ([rth] + PSM.ResumeAll(bl[1..]))[0] == rth
          && ([rth] + PSM.ResumeAll(bl[1..]))[1..] == PSM.ResumeAll(bl[1..]);
    }
  }

  /** (L4 NESTED) clone of `BlockedToActiveLkC` — GmtTieInside dropped. */
  lemma BlockedToActiveLkCNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                           inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                           ov: LOr.OracleView, S: set<LG.GroupId>,
                           tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                           ncap: int, nlook: int, nquant: int)
    requires BlockedRepLkCNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl, bl, ncap, nlook, nquant)
    ensures ActiveRepLkCNested(rer, qm, re, code, nextinp, crv, str, ov, S, tl, PSM.ResumeAll(bl),
                         ncap, nlook, nquant)
    decreases tl
  {
    if |tl| == 0 {
      assert |bl| == 0;
    } else {
      assert |bl| > 0;
      var th := bl[0].0;
      var rth := th.(exit_allowed := true, pc := th.pc + 1);
      assert PSM.ResumeAll(bl) == [rth] + PSM.ResumeAll(bl[1..]);
      assert rth.pc >= 0 && (rth.pc as nat) == (th.pc + 1) as nat;
      assert TreeRepLkRE(rer, qm, code, nextinp, tl[0].0, rth.pc as nat, rth.exit_allowed);
      var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(tl[0].0)
        && WalkPairLk(rer, qm, code, nextinp, traw, tl[0].1, (th.pc + 1) as nat, true);
      assert rth.capture_regs == th.capture_regs && rth.look_regs == th.look_regs
          && rth.quant_regs == th.quant_regs;
      assert GmtTieOutside(re, rth, tl[0].1, S)
         ;
      assert ThreadRepLkNested(rer, qm, re, code, nextinp, crv, str, ov, S, traw, tl[0].1, rth,
                         ncap, nlook, nquant);
      assert ThreadRepLkCNested(rer, qm, re, code, nextinp, crv, str, ov, S, tl[0].0, tl[0].1, rth,
                          ncap, nlook, nquant);
      BlockedToActiveLkCNested(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                         ncap, nlook, nquant);
      assert ([rth] + PSM.ResumeAll(bl[1..]))[0] == rth
          && ([rth] + PSM.ResumeAll(bl[1..]))[1..] == PSM.ResumeAll(bl[1..]);
    }
  }

  /** THE WHOLE-SEARCH COMPOSITE (mirror of `PSM.FindMatchSimRE`, both
      machines in lockstep): `FFindMatch` from a paired state drives machine B
      to `PTS_final(bestT)` with `bestT` tied to the VM's result. The consume
      phase reactivates the blocked pairing (`BlockedToActiveLkC`) and
      re-establishes both invariants at the advanced position. */
  lemma LiftFindMatchC(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                       endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                       S: set<LG.GroupId>, ptsA: PT.PikeTreeState, bst: PT.PikeTreeState,
                       vms: AI.VmState, cdn: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires S == PIV.CapIdsInLooks(re)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)
    requires LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires ptsA.PTS? && bst.PTS?
    requires |vms.processed.true_set| == RB.size(code) && |vms.processed.false_set| == RB.size(code)
    requires vms.context.nextchar == AI.get_char(str, vms.cp)
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, vms, ncap, nlook, nquant)
    requires LiftInv(rer, qm, re, code, crv, str, ov, S, bst, vms, ncap, nlook, nquant)
    ensures PTL.TrcPikeTreeLk(bst, PT.PTS_final(bestT))
    ensures BestTieLk(re, crv, str, ov, S, bestT,
                      AI.FFindMatch(code, str, vms, ov, LAnc.Forward, cdn).0, ncap, nlook, nquant)
    decreases |str| - vms.cp
  {
    var dir := LAnc.Forward;
    var s0 := vms.(cdn := LCdn.build_cdn_v(cdn, vms.cp, ov, vms.context, dir));
    // Neither invariant reads cdn.
    assert PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s0, ncap, nlook, nquant);
    assert LiftInv(rer, qm, re, code, crv, str, ov, S, bst, s0, ncap, nlook, nquant);
    var ptsA1, bst1 := LiftAdvanceEpsilon(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                          ptsA, s0, bst, dir, ncap, nlook, nquant);
    var (s1, ov1) := AI.FAdvanceEpsilon(code, s0, ov, dir);
    PSM.StaticOkNoWrite(qm, re, code, endl);
    CM.FAdvanceEpsilonOvStable(code, s0, ov, dir);
    assert ov1 == ov;
    PSM.FAdvanceEpsilonActiveEmpty(code, s0, ov, dir);
    assert s1.active == [] && s1.cp == s0.cp == vms.cp && s1.context == vms.context;
    assert PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA1, s1, ncap, nlook, nquant);
    assert LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, s1, ncap, nlook, nquant);

    assert bst1.PTS?;
    var PTS(inp1, ta1, best1, tb1, seen1) := bst1;
    assert ActiveRepLkC(rer, qm, re, code, inp1, crv, str, ov, S, ta1, s1.active, ncap, nlook, nquant);
    assert ta1 == [];
    assert inp1 == PIV.InpOfCp(str, s1.cp) && 0 <= s1.cp <= |str|;
    assert BestTieLk(re, crv, str, ov, S, best1, s1.bestmatch, ncap, nlook, nquant);

    if |s1.blocked| == 0 {
      assert LC.Reverse(s1.blocked) == [];
      assert tb1 == [] by {
        if LC.AdvanceInput(inp1, WP.Forward).Some? {
          var nx :| LC.AdvanceInput(inp1, WP.Forward) == Some(nx);
          assert BlockedRepLkC(rer, qm, re, code, inp1, nx, crv, str, ov, S, tb1,
                               PIV.MatchingBlocked(LC.Reverse(s1.blocked), inp1), ncap, nlook, nquant);
          assert PIV.MatchingBlocked([], inp1) == [];
        }
      }
      bestT := best1;
      assert PTL.PikeTreeStepLk(bst1, PT.PTS_final(best1));
      TrcLkRefl(PT.PTS_final(best1));
      TrcLkCons(bst1, PT.PTS_final(best1), PT.PTS_final(best1));
      TrcLkTrans(bst, bst1, PT.PTS_final(best1));
      assert AI.FFindMatch(code, str, vms, ov, dir, cdn).0 == s1.bestmatch;
    } else if s1.context.nextchar.None? {
      assert AI.get_char(str, vms.cp).None?;
      assert vms.cp >= |str| && s1.cp == |str|;
      assert inp1.next == str[s1.cp..] == [];
      assert LC.AdvanceInput(inp1, WP.Forward).None?;
      assert tb1 == [];
      bestT := best1;
      assert PTL.PikeTreeStepLk(bst1, PT.PTS_final(best1));
      TrcLkRefl(PT.PTS_final(best1));
      TrcLkCons(bst1, PT.PTS_final(best1), PT.PTS_final(best1));
      TrcLkTrans(bst, bst1, PT.PTS_final(best1));
      assert AI.FFindMatch(code, str, vms, ov, dir, cdn).0 == s1.bestmatch;
    } else {
      // A real character remains: consume it (the FFindMatch else-branch).
      assert AI.get_char(str, vms.cp).Some?;
      assert vms.cp < |str|;
      assert inp1.next == str[s1.cp..] && |inp1.next| > 0;
      assert s1.context.nextchar == Some(inp1.next[0]);
      PSM.FConsumeResumes(s1, inp1);
      var s2 := AI.FConsume(s1);
      var filter := PIV.MatchingBlocked(LC.Reverse(s1.blocked), inp1);
      assert PSM.ResumeAll(filter) + s1.active == PSM.ResumeAll(filter);
      assert s2 == s1.(active := PSM.ResumeAll(filter), blocked := []);
      var s3 := s2.(processed := AI.init_bpcset(RB.size(code)),
                    isblocked := AI.init_pcset(RB.size(code)),
                    cdn := LCdn.init_cdn(), cp := AI.incr_cp(s2.cp, dir));
      var newchar := AI.get_char(str, s3.cp - AI.cp_offset(dir));
      var s4 := s3.(context := LAnc.update_context(s3.context, newchar));
      assert s4.cp == vms.cp + 1;
      assert s4.context.nextchar == AI.get_char(str, s4.cp);
      assert AI.FFindMatch(code, str, vms, ov, dir, cdn)
          == AI.FFindMatch(code, str, s4, ov1, dir, cdn);

      PSM.AdvanceInpOfCpBridge(str, vms.cp);
      var nextinp := PT.NextInp(inp1);
      assert nextinp == PIV.InpOfCp(str, vms.cp + 1);
      assert LC.AdvanceInput(inp1, WP.Forward) == Some(nextinp);
      assert BlockedRepLkC(rer, qm, re, code, inp1, nextinp, crv, str, ov, S, tb1, filter,
                           ncap, nlook, nquant);

      if |tb1| == 0 {
        assert |filter| == 0;
        assert s4.active == [] && s4.blocked == [];
        PSM.FFindMatchInert(code, str, s4, ov1, dir, cdn);
        assert AI.FFindMatch(code, str, s4, ov1, dir, cdn).0 == s4.bestmatch == s1.bestmatch;
        bestT := best1;
        assert PTL.PikeTreeStepLk(bst1, PT.PTS_final(best1));
        TrcLkRefl(PT.PTS_final(best1));
        TrcLkCons(bst1, PT.PTS_final(best1), PT.PTS_final(best1));
        TrcLkTrans(bst, bst1, PT.PTS_final(best1));
      } else {
        // B: pts_nextchar — the blocked pairs become the next position's actives.
        var bst2 := PT.PTS(nextinp, tb1, best1, [], SS.InitialSeenTrees);
        assert PTL.PikeTreeStepLk(bst1, bst2);

        // ---- machine A: re-establish PikeInvFullRE at (ptsA2, s4) — the
        // FindMatchSimRE consume-phase block, verbatim.
        assert ptsA1.PTS?;
        var PTS(inpA1, taA1, bestA1, tbA1, seenA1) := ptsA1;
        assert PIV.ActiveRepRE(rer, qm, re, code, inpA1, taA1, s1.active);
        assert taA1 == [] && inpA1 == PIV.InpOfCp(str, s1.cp);
        assert PIV.BlockedRepRE(rer, qm, re, code, inpA1, nextinp, tbA1, filter);
        var ptsA2 := PT.PTS(nextinp, tbA1, bestA1, [], SS.InitialSeenTrees);
        PSM.BlockedToActiveRE(rer, qm, re, code, inpA1, nextinp, tbA1, filter);
        assert PIV.ActiveRepRE(rer, qm, re, code, nextinp, tbA1, s4.active);
        CM.FConsumeClocksLE(s1);
        CM.FConsumeRegsWf(s1, ncap, nlook, nquant);
        CM.FConsumeCapsLE(s1);
        assert CM.VmClocksLE(s4) by {
          assert s4.active == s2.active && s4.blocked == s2.blocked
              && s4.bestmatch == s2.bestmatch && s4.clock == s2.clock;
        }
        assert CM.VmRegsWf(s4, ncap, nlook, nquant) by {
          assert s4.active == s2.active && s4.blocked == s2.blocked && s4.bestmatch == s2.bestmatch;
        }
        assert CM.VmCapsLE(s4) by { CM.VmCapsLEAdvance(s2, s4); }
        assert forall t2 | t2 in s4.active :: PSM.ThreadNestRE(re, code, endl, t2.pc, t2) by {
          forall p | p in filter ensures PSM.ThreadNestRE(re, code, endl, p.0.pc + 1, p.0) {
            PSM.MatchingBlockedSubset(LC.Reverse(s1.blocked), inp1, p);
            PSM.ReverseMembership(s1.blocked, p);
            assert p in s1.blocked;
          }
          PSM.ResumeAllNest(re, code, endl, filter);
        }
        PIV.InitialInclusionRE(rer, qm, code, nextinp, PIV.HdTreeOf(tbA1),
                               PIV.HeadPcOf(s4.active), RB.size(code));
        assert PSM.IsblockedInclusionRE(rer, qm, code, nextinp, SS.InitialSeenTrees, s4.isblocked) by {
          forall pc0: nat | AI.pc_mem(s4.isblocked, pc0)
            ensures exists t0: LT.Tree, b0: bool ::
              SS.Inseen(SS.InitialSeenTrees, t0) && TT.TreeThreadRE(rer, qm, code, nextinp, t0, pc0, b0)
          {
            assert s4.isblocked[pc0] == false;
            assert false;
          }
        }
        assert forall t2 | t2 in s4.active :: PSM.EaColdOkRE(code, t2) by {
          PSM.ResumeAllEa(filter);
          assert s4.active == PSM.ResumeAll(filter);
        }
        assert forall t2 | t2 in s4.active :: PIV.LooksCapUnset(re, t2.capture_regs.a_clk) by {
          forall p | p in filter ensures PIV.LooksCapUnset(re, p.0.capture_regs.a_clk) {
            PSM.MatchingBlockedSubset(LC.Reverse(s1.blocked), inp1, p);
            PSM.ReverseMembership(s1.blocked, p);
            assert p in s1.blocked;
          }
          PSM.ResumeAllCapUnset(re, filter);
          assert s4.active == PSM.ResumeAll(filter);
        }
        assert PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA2, s4, ncap, nlook, nquant);

        // ---- machine B: LiftInv at (bst2, s4).
        BlockedToActiveLkC(rer, qm, re, code, inp1, nextinp, crv, str, ov, S, tb1, filter,
                           ncap, nlook, nquant);
        assert ActiveRepLkC(rer, qm, re, code, nextinp, crv, str, ov, S, tb1, s4.active,
                            ncap, nlook, nquant);
        assert PIV.ContextOkRE(str, s4.cp, s4.context);
        forall nx2 | LC.AdvanceInput(nextinp, WP.Forward) == Some(nx2)
          ensures BlockedRepLkC(rer, qm, re, code, nextinp, nx2, crv, str, ov, S, [],
                                PIV.MatchingBlocked(LC.Reverse(s4.blocked), nextinp), ncap, nlook, nquant)
        {
          assert LC.Reverse(s4.blocked) == [];
          assert PIV.MatchingBlocked([], nextinp) == [];
        }
        InitialSeenRepLk(rer, qm, code, nextinp, PIV.HdTreeOf(tb1), PIV.HeadPcOf(s4.active),
                         RB.size(code));
        assert IsblockedRepLk(rer, qm, code, nextinp, SS.InitialSeenTrees, s4.isblocked) by {
          forall pc0: nat | AI.pc_mem(s4.isblocked, pc0)
            ensures exists t0: LT.Tree, b0: bool ::
              SS.Inseen(SS.InitialSeenTrees, t0) && TreeRepLkRE(rer, qm, code, nextinp, t0, pc0, b0)
          {
            assert s4.isblocked[pc0] == false;
            assert false;
          }
        }
        assert SSx.IsStrictSuffix(nextinp, inp1, WP.Forward);
        LL.OracleOkSuffixStep(rer, qm, inp1, nextinp);

        // ---- (E3) the carrier crosses the consume: reactivation keeps registers ----
        assert LookNestRepB(re, S, tb1, filter) by {
          assert LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, s1, ncap, nlook, nquant);
          assert bst1 == PT.PTS(inp1, ta1, best1, tb1, seen1);
          assert LC.AdvanceInput(inp1, WP.Forward).Some?;
          assert filter == PIV.MatchingBlocked(LC.Reverse(s1.blocked), inp1);
        }
        assert LookNestRepC(re, S, tb1, s4.active) by {
          assert |tb1| == |filter|;                        // LookNestRepB lengths
          assert s4.active == PSM.ResumeAll(filter);
          ResumeAllLen(filter);
          forall i | 0 <= i < |tb1|
            ensures LookNestOkT(re, S, tb1[i].1, s4.active[i])
          {
            assert LookNestOkT(re, S, tb1[i].1, filter[i].0);
            ResumeAllIndex(filter, i);
            assert s4.active[i] == filter[i].0.(exit_allowed := true, pc := filter[i].0.pc + 1);
            assert s4.active[i].capture_regs == filter[i].0.capture_regs
                && s4.active[i].look_regs == filter[i].0.look_regs
                && s4.active[i].quant_regs == filter[i].0.quant_regs;
          }
        }
        assert LC.AdvanceInput(nextinp, WP.Forward).Some? ==>
          LookNestRepB(re, S, [], PIV.MatchingBlocked(LC.Reverse(s4.blocked), nextinp)) by {
          assert LC.Reverse(s4.blocked) == [];
          assert PIV.MatchingBlocked([], nextinp) == [];
        }
        assert LookNestBackRepB(re, crv, str, ov, S, tb1, filter, ncap, nlook, nquant) by {
          assert LiftInv(rer, qm, re, code, crv, str, ov, S, bst1, s1, ncap, nlook, nquant);
          assert bst1 == PT.PTS(inp1, ta1, best1, tb1, seen1);
          assert LC.AdvanceInput(inp1, WP.Forward).Some?;
        }
        assert LookNestBackRepC(re, crv, str, ov, S, tb1, s4.active, ncap, nlook, nquant) by {
          assert s4.active == PSM.ResumeAll(filter);
          ResumeAllLen(filter);
          forall i | 0 <= i < |tb1|
            ensures LookNestBackT(re, crv, str, ov, S, tb1[i].1, s4.active[i], ncap, nlook, nquant)
          {
            assert LookNestBackT(re, crv, str, ov, S, tb1[i].1, filter[i].0, ncap, nlook, nquant);
            ResumeAllIndex(filter, i);
            assert s4.active[i] == filter[i].0.(exit_allowed := true, pc := filter[i].0.pc + 1);
            assert s4.active[i].look_regs == filter[i].0.look_regs
                && s4.active[i].quant_regs == filter[i].0.quant_regs;
            LookNestBackTRegSame(re, crv, str, ov, S, tb1[i].1, tb1[i].1, filter[i].0, s4.active[i],
                                 ncap, nlook, nquant);
          }
        }
        assert LC.AdvanceInput(nextinp, WP.Forward).Some? ==>
          LookNestBackRepB(re, crv, str, ov, S, [],
                           PIV.MatchingBlocked(LC.Reverse(s4.blocked), nextinp), ncap, nlook, nquant) by {
          assert LC.Reverse(s4.blocked) == [];
          assert PIV.MatchingBlocked([], nextinp) == [];
        }
        assert LiftInv(rer, qm, re, code, crv, str, ov, S, bst2, s4, ncap, nlook, nquant);

        // recurse and chain.
        bestT := LiftFindMatchC(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                ptsA2, bst2, s4, cdn, ncap, nlook, nquant);
        TrcLkCons(bst1, bst2, PT.PTS_final(bestT));
        TrcLkTrans(bst, bst1, PT.PTS_final(bestT));
        assert AI.FFindMatch(code, str, s4, ov1, dir, cdn).0
            == AI.FFindMatch(code, str, vms, ov, dir, cdn).0;
      }
    }
  }

  /** (L4 NESTED) clone of `LiftFindMatchC` — GmtTieInside dropped. */
  lemma LiftFindMatchCNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                       endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                       S: set<LG.GroupId>, ptsA: PT.PikeTreeState, bst: PT.PikeTreeState,
                       vms: AI.VmState, cdn: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkNestedRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires S == PIV.CapIdsInLooks(re)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)
    requires LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires ptsA.PTS? && bst.PTS?
    requires |vms.processed.true_set| == RB.size(code) && |vms.processed.false_set| == RB.size(code)
    requires vms.context.nextchar == AI.get_char(str, vms.cp)
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, vms, ncap, nlook, nquant)
    requires LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, vms, ncap, nlook, nquant)
    ensures PTL.TrcPikeTreeLk(bst, PT.PTS_final(bestT))
    ensures BestTieLkNested(re, crv, str, ov, S, bestT,
                      AI.FFindMatch(code, str, vms, ov, LAnc.Forward, cdn).0, ncap, nlook, nquant)
    decreases |str| - vms.cp
  {
    var dir := LAnc.Forward;
    var s0 := vms.(cdn := LCdn.build_cdn_v(cdn, vms.cp, ov, vms.context, dir));
    // Neither invariant reads cdn.
    assert PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s0, ncap, nlook, nquant);
    assert LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst, s0, ncap, nlook, nquant);
    var ptsA1, bst1 := LiftAdvanceEpsilonNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                          ptsA, s0, bst, dir, ncap, nlook, nquant);
    var (s1, ov1) := AI.FAdvanceEpsilon(code, s0, ov, dir);
    PSM.StaticOkNoWriteNested(qm, re, code, endl);
    CM.FAdvanceEpsilonOvStable(code, s0, ov, dir);
    assert ov1 == ov;
    PSM.FAdvanceEpsilonActiveEmpty(code, s0, ov, dir);
    assert s1.active == [] && s1.cp == s0.cp == vms.cp && s1.context == vms.context;
    assert PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA1, s1, ncap, nlook, nquant);
    assert LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, s1, ncap, nlook, nquant);

    assert bst1.PTS?;
    var PTS(inp1, ta1, best1, tb1, seen1) := bst1;
    assert ActiveRepLkCNested(rer, qm, re, code, inp1, crv, str, ov, S, ta1, s1.active, ncap, nlook, nquant);
    assert ta1 == [];
    assert inp1 == PIV.InpOfCp(str, s1.cp) && 0 <= s1.cp <= |str|;
    assert BestTieLkNested(re, crv, str, ov, S, best1, s1.bestmatch, ncap, nlook, nquant);

    if |s1.blocked| == 0 {
      assert LC.Reverse(s1.blocked) == [];
      assert tb1 == [] by {
        if LC.AdvanceInput(inp1, WP.Forward).Some? {
          var nx :| LC.AdvanceInput(inp1, WP.Forward) == Some(nx);
          assert BlockedRepLkCNested(rer, qm, re, code, inp1, nx, crv, str, ov, S, tb1,
                               PIV.MatchingBlocked(LC.Reverse(s1.blocked), inp1), ncap, nlook, nquant);
          assert PIV.MatchingBlocked([], inp1) == [];
        }
      }
      bestT := best1;
      assert PTL.PikeTreeStepLk(bst1, PT.PTS_final(best1));
      TrcLkRefl(PT.PTS_final(best1));
      TrcLkCons(bst1, PT.PTS_final(best1), PT.PTS_final(best1));
      TrcLkTrans(bst, bst1, PT.PTS_final(best1));
      assert AI.FFindMatch(code, str, vms, ov, dir, cdn).0 == s1.bestmatch;
    } else if s1.context.nextchar.None? {
      assert AI.get_char(str, vms.cp).None?;
      assert vms.cp >= |str| && s1.cp == |str|;
      assert inp1.next == str[s1.cp..] == [];
      assert LC.AdvanceInput(inp1, WP.Forward).None?;
      assert tb1 == [];
      bestT := best1;
      assert PTL.PikeTreeStepLk(bst1, PT.PTS_final(best1));
      TrcLkRefl(PT.PTS_final(best1));
      TrcLkCons(bst1, PT.PTS_final(best1), PT.PTS_final(best1));
      TrcLkTrans(bst, bst1, PT.PTS_final(best1));
      assert AI.FFindMatch(code, str, vms, ov, dir, cdn).0 == s1.bestmatch;
    } else {
      // A real character remains: consume it (the FFindMatch else-branch).
      assert AI.get_char(str, vms.cp).Some?;
      assert vms.cp < |str|;
      assert inp1.next == str[s1.cp..] && |inp1.next| > 0;
      assert s1.context.nextchar == Some(inp1.next[0]);
      PSM.FConsumeResumes(s1, inp1);
      var s2 := AI.FConsume(s1);
      var filter := PIV.MatchingBlocked(LC.Reverse(s1.blocked), inp1);
      assert PSM.ResumeAll(filter) + s1.active == PSM.ResumeAll(filter);
      assert s2 == s1.(active := PSM.ResumeAll(filter), blocked := []);
      var s3 := s2.(processed := AI.init_bpcset(RB.size(code)),
                    isblocked := AI.init_pcset(RB.size(code)),
                    cdn := LCdn.init_cdn(), cp := AI.incr_cp(s2.cp, dir));
      var newchar := AI.get_char(str, s3.cp - AI.cp_offset(dir));
      var s4 := s3.(context := LAnc.update_context(s3.context, newchar));
      assert s4.cp == vms.cp + 1;
      assert s4.context.nextchar == AI.get_char(str, s4.cp);
      assert AI.FFindMatch(code, str, vms, ov, dir, cdn)
          == AI.FFindMatch(code, str, s4, ov1, dir, cdn);

      PSM.AdvanceInpOfCpBridge(str, vms.cp);
      var nextinp := PT.NextInp(inp1);
      assert nextinp == PIV.InpOfCp(str, vms.cp + 1);
      assert LC.AdvanceInput(inp1, WP.Forward) == Some(nextinp);
      assert BlockedRepLkCNested(rer, qm, re, code, inp1, nextinp, crv, str, ov, S, tb1, filter,
                           ncap, nlook, nquant);

      if |tb1| == 0 {
        assert |filter| == 0;
        assert s4.active == [] && s4.blocked == [];
        PSM.FFindMatchInert(code, str, s4, ov1, dir, cdn);
        assert AI.FFindMatch(code, str, s4, ov1, dir, cdn).0 == s4.bestmatch == s1.bestmatch;
        bestT := best1;
        assert PTL.PikeTreeStepLk(bst1, PT.PTS_final(best1));
        TrcLkRefl(PT.PTS_final(best1));
        TrcLkCons(bst1, PT.PTS_final(best1), PT.PTS_final(best1));
        TrcLkTrans(bst, bst1, PT.PTS_final(best1));
      } else {
        // B: pts_nextchar — the blocked pairs become the next position's actives.
        var bst2 := PT.PTS(nextinp, tb1, best1, [], SS.InitialSeenTrees);
        assert PTL.PikeTreeStepLk(bst1, bst2);

        // ---- machine A: re-establish PikeInvFullRE at (ptsA2, s4) — the
        // FindMatchSimRE consume-phase block, verbatim.
        assert ptsA1.PTS?;
        var PTS(inpA1, taA1, bestA1, tbA1, seenA1) := ptsA1;
        assert PIV.ActiveRepRE(rer, qm, re, code, inpA1, taA1, s1.active);
        assert taA1 == [] && inpA1 == PIV.InpOfCp(str, s1.cp);
        assert PIV.BlockedRepRE(rer, qm, re, code, inpA1, nextinp, tbA1, filter);
        var ptsA2 := PT.PTS(nextinp, tbA1, bestA1, [], SS.InitialSeenTrees);
        PSM.BlockedToActiveRE(rer, qm, re, code, inpA1, nextinp, tbA1, filter);
        assert PIV.ActiveRepRE(rer, qm, re, code, nextinp, tbA1, s4.active);
        CM.FConsumeClocksLE(s1);
        CM.FConsumeRegsWf(s1, ncap, nlook, nquant);
        CM.FConsumeCapsLE(s1);
        assert CM.VmClocksLE(s4) by {
          assert s4.active == s2.active && s4.blocked == s2.blocked
              && s4.bestmatch == s2.bestmatch && s4.clock == s2.clock;
        }
        assert CM.VmRegsWf(s4, ncap, nlook, nquant) by {
          assert s4.active == s2.active && s4.blocked == s2.blocked && s4.bestmatch == s2.bestmatch;
        }
        assert CM.VmCapsLE(s4) by { CM.VmCapsLEAdvance(s2, s4); }
        assert forall t2 | t2 in s4.active :: PSM.ThreadNestRE(re, code, endl, t2.pc, t2) by {
          forall p | p in filter ensures PSM.ThreadNestRE(re, code, endl, p.0.pc + 1, p.0) {
            PSM.MatchingBlockedSubset(LC.Reverse(s1.blocked), inp1, p);
            PSM.ReverseMembership(s1.blocked, p);
            assert p in s1.blocked;
          }
          PSM.ResumeAllNest(re, code, endl, filter);
        }
        PIV.InitialInclusionRE(rer, qm, code, nextinp, PIV.HdTreeOf(tbA1),
                               PIV.HeadPcOf(s4.active), RB.size(code));
        assert PSM.IsblockedInclusionRE(rer, qm, code, nextinp, SS.InitialSeenTrees, s4.isblocked) by {
          forall pc0: nat | AI.pc_mem(s4.isblocked, pc0)
            ensures exists t0: LT.Tree, b0: bool ::
              SS.Inseen(SS.InitialSeenTrees, t0) && TT.TreeThreadRE(rer, qm, code, nextinp, t0, pc0, b0)
          {
            assert s4.isblocked[pc0] == false;
            assert false;
          }
        }
        assert forall t2 | t2 in s4.active :: PSM.EaColdOkRE(code, t2) by {
          PSM.ResumeAllEa(filter);
          assert s4.active == PSM.ResumeAll(filter);
        }
        assert forall t2 | t2 in s4.active :: PIV.LooksCapUnset(re, t2.capture_regs.a_clk) by {
          forall p | p in filter ensures PIV.LooksCapUnset(re, p.0.capture_regs.a_clk) {
            PSM.MatchingBlockedSubset(LC.Reverse(s1.blocked), inp1, p);
            PSM.ReverseMembership(s1.blocked, p);
            assert p in s1.blocked;
          }
          PSM.ResumeAllCapUnset(re, filter);
          assert s4.active == PSM.ResumeAll(filter);
        }
        assert PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA2, s4, ncap, nlook, nquant);

        // ---- machine B: LiftInv at (bst2, s4).
        BlockedToActiveLkCNested(rer, qm, re, code, inp1, nextinp, crv, str, ov, S, tb1, filter,
                           ncap, nlook, nquant);
        assert ActiveRepLkCNested(rer, qm, re, code, nextinp, crv, str, ov, S, tb1, s4.active,
                            ncap, nlook, nquant);
        assert PIV.ContextOkRE(str, s4.cp, s4.context);
        forall nx2 | LC.AdvanceInput(nextinp, WP.Forward) == Some(nx2)
          ensures BlockedRepLkCNested(rer, qm, re, code, nextinp, nx2, crv, str, ov, S, [],
                                PIV.MatchingBlocked(LC.Reverse(s4.blocked), nextinp), ncap, nlook, nquant)
        {
          assert LC.Reverse(s4.blocked) == [];
          assert PIV.MatchingBlocked([], nextinp) == [];
        }
        InitialSeenRepLk(rer, qm, code, nextinp, PIV.HdTreeOf(tb1), PIV.HeadPcOf(s4.active),
                         RB.size(code));
        assert IsblockedRepLk(rer, qm, code, nextinp, SS.InitialSeenTrees, s4.isblocked) by {
          forall pc0: nat | AI.pc_mem(s4.isblocked, pc0)
            ensures exists t0: LT.Tree, b0: bool ::
              SS.Inseen(SS.InitialSeenTrees, t0) && TreeRepLkRE(rer, qm, code, nextinp, t0, pc0, b0)
          {
            assert s4.isblocked[pc0] == false;
            assert false;
          }
        }
        assert SSx.IsStrictSuffix(nextinp, inp1, WP.Forward);
        LL.OracleOkSuffixStep(rer, qm, inp1, nextinp);

        // ---- (E3) the carrier crosses the consume: reactivation keeps registers ----
        assert LookNestRepB(re, S, tb1, filter) by {
          assert LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, s1, ncap, nlook, nquant);
          assert bst1 == PT.PTS(inp1, ta1, best1, tb1, seen1);
          assert LC.AdvanceInput(inp1, WP.Forward).Some?;
          assert filter == PIV.MatchingBlocked(LC.Reverse(s1.blocked), inp1);
        }
        assert LookNestRepC(re, S, tb1, s4.active) by {
          assert |tb1| == |filter|;                        // LookNestRepB lengths
          assert s4.active == PSM.ResumeAll(filter);
          ResumeAllLen(filter);
          forall i | 0 <= i < |tb1|
            ensures LookNestOkT(re, S, tb1[i].1, s4.active[i])
          {
            assert LookNestOkT(re, S, tb1[i].1, filter[i].0);
            ResumeAllIndex(filter, i);
            assert s4.active[i] == filter[i].0.(exit_allowed := true, pc := filter[i].0.pc + 1);
            assert s4.active[i].capture_regs == filter[i].0.capture_regs
                && s4.active[i].look_regs == filter[i].0.look_regs
                && s4.active[i].quant_regs == filter[i].0.quant_regs;
          }
        }
        assert LC.AdvanceInput(nextinp, WP.Forward).Some? ==>
          LookNestRepB(re, S, [], PIV.MatchingBlocked(LC.Reverse(s4.blocked), nextinp)) by {
          assert LC.Reverse(s4.blocked) == [];
          assert PIV.MatchingBlocked([], nextinp) == [];
        }
        assert LookNestBackRepB(re, crv, str, ov, S, tb1, filter, ncap, nlook, nquant) by {
          assert LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst1, s1, ncap, nlook, nquant);
          assert bst1 == PT.PTS(inp1, ta1, best1, tb1, seen1);
          assert LC.AdvanceInput(inp1, WP.Forward).Some?;
        }
        assert LookNestBackRepC(re, crv, str, ov, S, tb1, s4.active, ncap, nlook, nquant) by {
          assert s4.active == PSM.ResumeAll(filter);
          ResumeAllLen(filter);
          forall i | 0 <= i < |tb1|
            ensures LookNestBackT(re, crv, str, ov, S, tb1[i].1, s4.active[i], ncap, nlook, nquant)
          {
            assert LookNestBackT(re, crv, str, ov, S, tb1[i].1, filter[i].0, ncap, nlook, nquant);
            ResumeAllIndex(filter, i);
            assert s4.active[i] == filter[i].0.(exit_allowed := true, pc := filter[i].0.pc + 1);
            assert s4.active[i].look_regs == filter[i].0.look_regs
                && s4.active[i].quant_regs == filter[i].0.quant_regs;
            LookNestBackTRegSame(re, crv, str, ov, S, tb1[i].1, tb1[i].1, filter[i].0, s4.active[i],
                                 ncap, nlook, nquant);
          }
        }
        assert LC.AdvanceInput(nextinp, WP.Forward).Some? ==>
          LookNestBackRepB(re, crv, str, ov, S, [],
                           PIV.MatchingBlocked(LC.Reverse(s4.blocked), nextinp), ncap, nlook, nquant) by {
          assert LC.Reverse(s4.blocked) == [];
          assert PIV.MatchingBlocked([], nextinp) == [];
        }
        assert LiftInvNested(rer, qm, re, code, crv, str, ov, S, bst2, s4, ncap, nlook, nquant);

        // recurse and chain.
        bestT := LiftFindMatchCNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                ptsA2, bst2, s4, cdn, ncap, nlook, nquant);
        TrcLkCons(bst1, bst2, PT.PTS_final(bestT));
        TrcLkTrans(bst, bst1, PT.PTS_final(bestT));
        assert AI.FFindMatch(code, str, s4, ov1, dir, cdn).0
            == AI.FFindMatch(code, str, vms, ov, dir, cdn).0;
      }
    }
  }

  lemma L3aCompositeClose(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                          endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                          S: set<LG.GroupId>, tstar: LT.Tree, t: LT.Tree, inp: LC.Input,
                          vms: AI.VmState, cdn: LCdn.cdns, result: Option<AI.Thread>,
                          ncap: int, nlook: int, nquant: int)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires PSM.StaticOkRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires qm.ov == ov && !rer.multiline
    requires !rer.ignoreCase
    requires S == PIV.CapIdsInLooks(re)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)
    requires LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires code == CP.compile_to_bytecode(re)
    requires vms.blocked == []
    requires vms.processed == AI.init_bpcset(RB.size(code))
    requires vms.isblocked == AI.init_pcset(RB.size(code))
    requires PIV.ContextOkRE(str, vms.cp, vms.context)
    // Thread-anchored entry facts (feed LiftInitC) — replace the dead
    // LeavesAgreeAtOutside(tstar, t) tree link.
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re)
    requires AR.ActionsRepL(rer, qm, [LS.Areg(T.Translate(re))], code, 0)
    requires EL.BoolTreeLk(rer, [LS.Areg(T.Translate(re))], inp, BS.CannotExit, t)
    requires PTL.PikeSubtreeLk(t)
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str,
                               PT.PikeTreeInitialState(tstar, inp), vms, ncap, nlook, nquant)
    requires LL.OracleOkSuffix(rer, qm, inp)
    requires inp == PIV.InpOfCp(str, vms.cp) && 0 <= vms.cp <= |str|
    requires vms.active == [AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant))]
    requires vms.bestmatch.None?
    requires |vms.processed.true_set| == RB.size(code) && |vms.processed.false_set| == RB.size(code)
    requires vms.context.nextchar == AI.get_char(str, vms.cp)
    requires result == AI.FFindMatch(code, str, vms, ov, LAnc.Forward, cdn).0
    ensures BestTieLk(re, crv, str, ov, S, LT.FirstLeaf(t, inp), result, ncap, nlook, nquant)
  {
    var tcan := LiftInitC(rer, qm, re, code, endl, ngroups, crv, str, ov, S, tstar, t, inp, vms,
                          ncap, nlook, nquant);
    assert LiftInv(rer, qm, re, code, crv, str, ov, S,
                   PT.PikeTreeInitialState(tcan, inp), vms, ncap, nlook, nquant);
    var bestT := LiftFindMatchC(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                PT.PikeTreeInitialState(tstar, inp),
                                PT.PikeTreeInitialState(tcan, inp),
                                vms, cdn, ncap, nlook, nquant);
    // bestT IS the canonical tree's first leaf ...
    PikeSubtreeLkEraseIff(t);
    PikeSubtreeLkEraseIff(tcan);
    assert PTL.PikeSubtreeLk(tcan);
    PTL.PikeTreeLkComputesFirstLeaf(tcan, inp, bestT);
    assert bestT == LT.FirstLeaf(tcan, inp);
    // ... which is the RAW entry tree's first leaf (Progress is leaf-transparent)
    assert CE.LeavesAgree(tcan, t) by {
      forall gm: LG.GroupMap, xinp: LC.Input, dr: WP.Direction
        ensures LT.TreeLeaves(tcan, gm, xinp, dr) == LT.TreeLeaves(t, gm, xinp, dr)
      {
        ProgEraseLeavesEq(tcan, gm, xinp, dr);
        ProgEraseLeavesEq(t, gm, xinp, dr);
      }
    }
    CE.LAFirstLeaf(tcan, t, inp);
    assert LT.FirstLeaf(t, inp) == bestT;
  }

  /** (L4 NESTED) clone of `L3aCompositeClose` — GmtTieInside dropped. */
  lemma L3aCompositeCloseNested(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                          endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                          S: set<LG.GroupId>, tstar: LT.Tree, t: LT.Tree, inp: LC.Input,
                          vms: AI.VmState, cdn: LCdn.cdns, result: Option<AI.Thread>,
                          ncap: int, nlook: int, nquant: int)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires PSM.StaticOkRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires qm.ov == ov && !rer.multiline
    requires !rer.ignoreCase
    requires S == PIV.CapIdsInLooks(re)
    requires GateStaticsOk(qm, re, crv, ncap, nlook, nquant)
    requires LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires code == CP.compile_to_bytecode(re)
    requires vms.blocked == []
    requires vms.processed == AI.init_bpcset(RB.size(code))
    requires vms.isblocked == AI.init_pcset(RB.size(code))
    requires PIV.ContextOkRE(str, vms.cp, vms.context)
    // Thread-anchored entry facts (feed LiftInitC) — replace the dead
    // LeavesAgreeAtOutside(tstar, t) tree link.
    requires T.TransWf(re) && NR.LookBehindFragmentRE(re)
    requires AR.ActionsRepL(rer, qm, [LS.Areg(T.Translate(re))], code, 0)
    requires EL.BoolTreeLk(rer, [LS.Areg(T.Translate(re))], inp, BS.CannotExit, t)
    requires PTL.PikeSubtreeLk(t)
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str,
                               PT.PikeTreeInitialState(tstar, inp), vms, ncap, nlook, nquant)
    requires LL.OracleOkSuffix(rer, qm, inp)
    requires inp == PIV.InpOfCp(str, vms.cp) && 0 <= vms.cp <= |str|
    requires vms.active == [AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant))]
    requires vms.bestmatch.None?
    requires |vms.processed.true_set| == RB.size(code) && |vms.processed.false_set| == RB.size(code)
    requires vms.context.nextchar == AI.get_char(str, vms.cp)
    requires result == AI.FFindMatch(code, str, vms, ov, LAnc.Forward, cdn).0
    ensures BestTieLkNested(re, crv, str, ov, S, LT.FirstLeaf(t, inp), result, ncap, nlook, nquant)
  {
    var tcan := LiftInitCNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S, tstar, t, inp, vms,
                          ncap, nlook, nquant);
    assert LiftInvNested(rer, qm, re, code, crv, str, ov, S,
                   PT.PikeTreeInitialState(tcan, inp), vms, ncap, nlook, nquant);
    // (L4 NESTED) the preservation/consume chain is genuinely nested-typed; the
    // depth-1 STATIC package embeds into it. The ENTRY (LiftInitCNested) remains
    // depth-1 — its `WalkPairLk` uses the depth-1 `EL.PikeLkActions` (positive
    // look bodies must be look-free); a recursive walk tower is the residual
    // sub-brick, so this endpoint keeps `StaticOkRE` and bridges for the sweep.
    PSM.StaticOkRENestedFromRE(qm, re, code, endl);
    var bestT := LiftFindMatchCNested(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                PT.PikeTreeInitialState(tstar, inp),
                                PT.PikeTreeInitialState(tcan, inp),
                                vms, cdn, ncap, nlook, nquant);
    // bestT IS the canonical tree's first leaf ...
    PikeSubtreeLkEraseIff(t);
    PikeSubtreeLkEraseIff(tcan);
    assert PTL.PikeSubtreeLk(tcan);
    PTL.PikeTreeLkComputesFirstLeaf(tcan, inp, bestT);
    assert bestT == LT.FirstLeaf(tcan, inp);
    // ... which is the RAW entry tree's first leaf (Progress is leaf-transparent)
    assert CE.LeavesAgree(tcan, t) by {
      forall gm: LG.GroupMap, xinp: LC.Input, dr: WP.Direction
        ensures LT.TreeLeaves(tcan, gm, xinp, dr) == LT.TreeLeaves(t, gm, xinp, dr)
      {
        ProgEraseLeavesEq(tcan, gm, xinp, dr);
        ProgEraseLeavesEq(t, gm, xinp, dr);
      }
    }
    CE.LAFirstLeaf(tcan, t, inp);
    assert LT.FirstLeaf(t, inp) == bestT;
  }

  // ---- (F) final assembly (no scaffold lemma — a recipe) ---------------------
  //
  // The else-branch rewrite of MainTheorem, once (H)/(G)/(C)/(V) and the seven
  // lift lemmas are green:
  //   1. Replace `LkBodyGroupsEmpty(re); assert S == {}` with
  //      `PikeSubtreeLkComputeTr` + `LiftEndpoint` (feeding the entry facts it
  //      requires — all are already established in the surrounding body).
  //   2. Replace the L1 `FBuildCaptureUnfold` chain's leaf identification with
  //      `L3aValueBridge`, then feed the SYNTHETIC thread carrying
  //      `res.0/res.1/res.2` into the EXISTING `MainExtraction`
  //      (`ReplayThreadWfLA`/`FreshMatchWf` supply its ThreadRegsWf +
  //      QuantRegsFinal, per handoff §3).
  //   3. Delete `LkBodyGroupsEmpty`, `FilterUnmoved`, and the L1
  //      `LookRowsFromTables`; whole-package verify; repack (blocked on the
  //      lem 10-minute wall until Lemmata's Native.cs is fixed).

  // ==========================================================================
  // (E4) THE ENDPOINT ASSEMBLY — from `BestTieLk`'s four tie directions and
  // the genuine-start engine facts, the winning leaf's gm IS the live
  // denotation of the FLookLoop-reconstructed registers, and the synthetic
  // thread carrying them is well-formed. The last lemma before the theorem.
  // ==========================================================================
  lemma {:isolate_assertions} L3aEndpointAssembly(
      ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, endl: nat,
      str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
      thread: AI.Thread, leaf: LT.Leaf,
      inits: AI.VmState, cap: AReg.Regs, look: AReg.Regs, quant: AReg.Regs, cdn: LCdn.cdns,
      ncap: int, nlook: int, nquant: int)
    requires T.TransWf(ast) && T.TransWf(re) && re == R.lazy_prefix(ast)
    requires NR.LookBehindFragmentRE(re) && LTB.LookUnique(re)
    requires PIV.QuantUnique(re) && PIV.CapUnique(re)
    requires crv == CP.FFullCompilation(ast)
    requires LTB.LookTablesOk(re, crv)
    requires code == CP.compile_to_bytecode(re)
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1
    requires NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires forall pc: nat, q: int, b: bool ::
      NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, b)) ==> !b
    requires S == PIV.CapIdsInLooks(re)
    requires forall lx: nat :: lx in LTB.LookIds(re) ==> 1 <= lx
    requires ncap == 2 * R.max_group(ast) + 2 && ncap == 2 * R.max_group(re) + 2
    requires nlook == R.max_lookaround(ast) + 1 && nlook == R.max_lookaround(re) + 1
    requires nquant == R.max_quant(ast) + 1 && nquant == R.max_quant(re) + 1
    requires cap == AReg.init_regs(ncap) && look == AReg.init_regs(nlook) && quant == AReg.init_regs(nquant)
    requires inits == AI.FInitState(code, 0, cap, look, quant, 0, AI.cp_context(0, str, LAnc.Forward))
    requires AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0 == Some(thread)
    requires BestTieLk(re, crv, str, ov, S, Some(leaf), Some(thread), ncap, nlook, nquant)
    // L3b: the leaf value is ORDERED (spec GMClose ordering) — supplied by the
    // caller via FirstLeafOrdered; lets the NormRange conversion collapse.
    requires M.OrderedGm(leaf.1)
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                    thread.capture_regs, thread.look_regs, thread.quant_regs, ov);
      res.1 == thread.look_regs
      && leaf.1 == PIV.NormGm(PIV.GmOfLive(re, res.0, thread.look_regs, res.2))
      && CM.ThreadRegsWf(AI.Thread(thread.pc, res.0, res.1, res.2, thread.exit_allowed),
                         ncap, nlook, nquant)
      && M.QuantRegsFinal(AI.Thread(thread.pc, res.0, res.1, res.2, thread.exit_allowed))
  {
    var maxlook := R.max_lookaround(ast);
    var lk := thread.look_regs;
    var leafgm := leaf.1;
    var result := AI.FFindMatch(code, str, inits, ov, LAnc.Forward, cdn).0;
    var ctx0 := AI.cp_context(0, str, LAnc.Forward);
    assert inits.context.nextchar == AI.get_char(str, 0) && inits.cp == 0;
    assert |inits.processed.true_set| == RB.size(code) && |inits.processed.false_set| == RB.size(code);
    assert inits.active == [AI.init_thread(cap, look, quant)]
        && inits.blocked == [] && inits.bestmatch.None?;

    // ---- winning-thread wf + genuine-start engine facts -------------------
    CM.RegsClocksLEInit(ncap, 0);
    CM.RegsClocksLEInit(nlook, 0);
    CM.RegsClocksLEInit(nquant, 0);
    CM.FInitStateClocksLE(code, 0, cap, look, quant, 0, ctx0);
    CM.FInitStateRegsWf(code, 0, ncap, nlook, nquant, 0, ctx0);
    assert M.VmQuantFinal(inits) by {
      var th0 := AI.init_thread(cap, look, quant);
      assert M.QuantRegsFinal(th0) by {
        forall k ensures AI.get_idx(quant.a_cp, k) < 0 && AI.get_idx(quant.a_clk, k) >= -1 {
          if 0 <= k < |quant.a_cp| { assert quant.a_cp[k] == -1; }
          if 0 <= k < |quant.a_clk| { assert quant.a_clk[k] == -1; }
        }
      }
      forall t2 | t2 in inits.active ensures M.QuantRegsFinal(t2) { assert t2 == th0; }
    }
    M.FFindMatchThreadFacts(code, str, inits, ov, LAnc.Forward, cdn, ncap, nlook, nquant);
    assert CM.ThreadRegsWf(thread, ncap, nlook, nquant) && M.QuantRegsFinal(thread);

    // rows / cp-context / stamps / init frames
    M.LookRowsFromTablesL3a(ast, re, crv, code, str, ov, cdn, inits, cap, look, quant,
                            nlook, endl, result);
    M.MainMatchCpCtxOk(crv, code, str, inits, cap, look, quant, nlook, ov, cdn, result);
    M.MainMatchLookClkSet(code, str, inits, cap, look, quant, nlook, ov, cdn, result);
    M.MainMatchBodyQuantsInit(re, code, endl, str, inits, cap, look, quant, ov, cdn, result);
    M.MainMatchInsideCapsInit(re, code, endl, str, inits, cap, look, quant, ov, cdn, result);
    var SqOut := set q: nat | q in PIV.QuantIdsOutsideLooks(re) :: q as int;
    var ScOut := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(re));
    assert CM.RegsAgreeOutside(thread.quant_regs, quant, SqOut);
    assert CM.RegsAgreeOutside(thread.capture_regs, cap, ScOut);

    // set splits + prefix invisibility
    PIV.CapIdsSplit(re); PIV.QuantIdsSplit(re);
    PIV.CapIdsLooksDisjoint(re); PIV.QuantIdsLooksDisjoint(re);
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false), R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert PIV.CapIdsInLooks(re) == PIV.CapIdsInLooks(ast);
    assert PIV.QuantIdsInLooks(re) == PIV.QuantIdsInLooks(ast);
    var Sreg := PIV.CaptureRegsSet(PIV.CapIdsInLooks(ast));
    var Sq := set q: nat | q in PIV.QuantIdsInLooks(ast) :: q as int;
    LTB.LookIdsLeMax(re);
    assert forall lx: nat :: lx in LTB.LookIds(re) ==> 1 <= lx <= maxlook;

    // inside-look slots are never outside-look slots (parity + disjointness)
    assert forall c: nat :: c in PIV.CapIdsInLooks(re) ==>
      CP.start_reg(c as int) !in ScOut && CP.end_reg(c as int) !in ScOut
    by {
      forall c: nat | c in PIV.CapIdsInLooks(re)
        ensures CP.start_reg(c as int) !in ScOut && CP.end_reg(c as int) !in ScOut
      {
        if CP.start_reg(c as int) in ScOut {
          if CP.start_reg(c as int) in (set cid | cid in PIV.CapIdsOutsideLooks(re) :: CP.start_reg(cid as int)) {
            var cid: nat :| cid in PIV.CapIdsOutsideLooks(re) && CP.start_reg(cid as int) == CP.start_reg(c as int);
            assert cid == c;
            assert c in PIV.CapIdsOutsideLooks(re) * PIV.CapIdsInLooks(re);
          } else {
            var cid: nat :| cid in PIV.CapIdsOutsideLooks(re) && CP.end_reg(cid as int) == CP.start_reg(c as int);
            assert 2 * (cid as int) + 1 == 2 * (c as int);
          }
          assert false;
        }
        if CP.end_reg(c as int) in ScOut {
          if CP.end_reg(c as int) in (set cid | cid in PIV.CapIdsOutsideLooks(re) :: CP.end_reg(cid as int)) {
            var cid: nat :| cid in PIV.CapIdsOutsideLooks(re) && CP.end_reg(cid as int) == CP.end_reg(c as int);
            assert cid == c;
            assert c in PIV.CapIdsOutsideLooks(re) * PIV.CapIdsInLooks(re);
          } else {
            var cid: nat :| cid in PIV.CapIdsOutsideLooks(re) && CP.start_reg(cid as int) == CP.end_reg(c as int);
            assert 2 * (cid as int) == 2 * (c as int) + 1;
          }
          assert false;
        }
      }
    }
    // hence: the winning thread's inside-look capture slots are exactly INIT
    assert forall c: nat :: c in PIV.CapIdsInLooks(ast) ==>
      AI.get_idx(thread.capture_regs.a_cp, CP.start_reg(c as int)) == -1
      && AI.get_idx(thread.capture_regs.a_clk, CP.start_reg(c as int)) == -1
      && AI.get_idx(thread.capture_regs.a_cp, CP.end_reg(c as int)) == -1
      && AI.get_idx(thread.capture_regs.a_clk, CP.end_reg(c as int)) == -1
    by {
      forall c: nat | c in PIV.CapIdsInLooks(ast)
        ensures AI.get_idx(thread.capture_regs.a_cp, CP.start_reg(c as int)) == -1
             && AI.get_idx(thread.capture_regs.a_clk, CP.start_reg(c as int)) == -1
             && AI.get_idx(thread.capture_regs.a_cp, CP.end_reg(c as int)) == -1
             && AI.get_idx(thread.capture_regs.a_clk, CP.end_reg(c as int)) == -1
      {
        assert c in PIV.CapIdsInLooks(re);
        RL.AInitLaws(ncap);
      }
    }

    // per-body unset entries for the value lifts
    assert forall l: int :: 1 <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
      CM.RegsAgreeInside(thread.capture_regs, AReg.init_regs(ncap), PIV.CaptureRegs(M.VBody(crv, l)))
    by {
      forall l: int | 1 <= l <= maxlook && AReg.get_cp(lk, l).Some?
        ensures CM.RegsAgreeInside(thread.capture_regs, AReg.init_regs(ncap), PIV.CaptureRegs(M.VBody(crv, l)))
      {
        var la: R.lookaround, body: R.regex :|
          LTB.LookEntryOk(crv, l, la, body)
          && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
          && PIV.CapUnique(body) && PIV.QuantUnique(body)
          && PIV.CaptureRegs(body) <= Sreg
          && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(ast))
          && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
        assert body == M.VBody(crv, l);
        forall k: int | k in PIV.CaptureRegs(body)
          ensures AI.get_idx(thread.capture_regs.a_cp, k) == AI.get_idx(AReg.init_regs(ncap).a_cp, k)
               && AI.get_idx(thread.capture_regs.a_clk, k) == AI.get_idx(AReg.init_regs(ncap).a_clk, k)
        {
          var c: nat :| c in PIV.CapIds(body)
            && (k == CP.start_reg(c as int) || k == CP.end_reg(c as int));
          assert c in PIV.CapIdsInLooks(ast) by {
            assert CP.start_reg(c as int) in PIV.CaptureRegs(body);
            assert CP.start_reg(c as int) in Sreg;
            if CP.start_reg(c as int) in (set cid | cid in PIV.CapIdsInLooks(ast) :: CP.start_reg(cid as int)) {
              var cid: nat :| cid in PIV.CapIdsInLooks(ast) && CP.start_reg(cid as int) == CP.start_reg(c as int);
              assert cid == c;
            } else {
              var cid: nat :| cid in PIV.CapIdsInLooks(ast) && CP.end_reg(cid as int) == CP.start_reg(c as int);
              assert 2 * (cid as int) + 1 == 2 * (c as int);
              assert false;
            }
          }
          RL.AInitLaws(ncap);
        }
      }
    }
    assert forall l: int :: 1 <= l <= maxlook && AReg.get_cp(lk, l).Some? ==>
      CM.RegsAgreeInside(thread.quant_regs, AReg.init_regs(nquant), LKC.QIdsInt(M.VBody(crv, l)))
    by {
      forall l: int | 1 <= l <= maxlook && AReg.get_cp(lk, l).Some?
        ensures CM.RegsAgreeInside(thread.quant_regs, AReg.init_regs(nquant), LKC.QIdsInt(M.VBody(crv, l)))
      {
        var la: R.lookaround, body: R.regex :|
          LTB.LookEntryOk(crv, l, la, body)
          && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
          && PIV.CapUnique(body) && PIV.QuantUnique(body)
          && PIV.CaptureRegs(body) <= Sreg
          && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(ast))
          && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
        assert body == M.VBody(crv, l);
        forall k: int | k in LKC.QIdsInt(body)
          ensures AI.get_idx(thread.quant_regs.a_cp, k) == AI.get_idx(AReg.init_regs(nquant).a_cp, k)
               && AI.get_idx(thread.quant_regs.a_clk, k) == AI.get_idx(AReg.init_regs(nquant).a_clk, k)
        {
          assert k >= 0 && (k as nat) in PIV.QuantIds(body);
          assert (k as nat) in PIV.QuantIdsInLooks(ast);
          assert k !in SqOut by {
            if k in SqOut {
              var q2: nat :| q2 in PIV.QuantIdsOutsideLooks(re) && q2 as int == k;
              assert q2 in PIV.QuantIdsOutsideLooks(re) * PIV.QuantIdsInLooks(re);
            }
          }
          RL.AInitLaws(nquant);
        }
      }
    }
    // pairwise quant disjointness across matched lids
    assert forall l1: int, l2: int ::
      1 <= l1 <= maxlook && 1 <= l2 <= maxlook && l1 != l2
      && AReg.get_cp(lk, l1).Some? && AReg.get_cp(lk, l2).Some? ==>
      LKC.QIdsInt(M.VBody(crv, l1)) * LKC.QIdsInt(M.VBody(crv, l2)) == {}
    by {
      forall l1: int, l2: int |
        1 <= l1 <= maxlook && 1 <= l2 <= maxlook && l1 != l2
        && AReg.get_cp(lk, l1).Some? && AReg.get_cp(lk, l2).Some?
        ensures LKC.QIdsInt(M.VBody(crv, l1)) * LKC.QIdsInt(M.VBody(crv, l2)) == {}
      {
        assert (l1 as nat) in LTB.LookIds(re) && (l2 as nat) in LTB.LookIds(re);
        OE.LmOfDom(re);
        assert l1 in OE.LmOf(re) && l2 in OE.LmOf(re);
        var la1, b1, la2, b2 := M.LmOfBodiesDisjoint(re, crv, l1, l2);
        assert b1 == M.VBody(crv, l1) && b2 == M.VBody(crv, l2);
        forall k: int | k in LKC.QIdsInt(b1) * LKC.QIdsInt(b2) ensures false {
          assert (k as nat) in PIV.QuantIds(b1) * PIV.QuantIds(b2);
        }
      }
    }

    // ---- run the lifts and frames ----------------------------------------
    var qtF := thread.quant_regs;
    assert (forall k :: AI.get_idx(qtF.a_cp, k) < 0) && (forall k :: AI.get_idx(qtF.a_clk, k) >= -1);
    M.FLookLoopValueLift(crv, str, 1, maxlook, thread.capture_regs, lk, qtF, ov,
                         ast, Sreg, ncap, nlook, nquant);
    M.FLookLoopQuantValueLift(crv, str, 1, maxlook, thread.capture_regs, lk, qtF, ov,
                              ast, Sq, ncap, nlook, nquant);
    M.FLookLoopCaptureFrame(crv, str, 1, maxlook, thread.capture_regs, lk, qtF, ov, ast, Sreg);
    M.FLookLoopQuantFrame(crv, str, 1, maxlook, thread.capture_regs, lk, qtF, ov, ast, Sq);
    var res := AI.FLookLoop(crv, str, 1, maxlook, thread.capture_regs, lk, qtF, ov);
    var res0 := res.0;
    var res2 := res.2;
    assert res.1 == lk;
    assert CM.RegsAgreeOutside(res0, thread.capture_regs, Sreg);
    assert CM.RegsAgreeOutside(res2, qtF, Sq);
    assert M.FLookLoopValueOk(crv, str, res0, 1, maxlook, lk, ov, ncap, nlook, nquant);
    assert M.FLookLoopQuantValueOk(crv, str, res2, 1, maxlook, lk, ov, ncap, nlook, nquant);
    assert PIV.CapRegWf(res0) && |res0.a_cp| == ncap && |res0.a_clk| == ncap;
    assert |res2.a_cp| == nquant && |res2.a_clk| == nquant;
    assert (forall k :: AI.get_idx(res2.a_cp, k) < 0) && (forall k :: AI.get_idx(res2.a_clk, k) >= -1);

    // outside-look agreements (for the transports and the value bridge)
    assert forall c: nat :: c in PIV.CapIdsOutsideLooks(re) ==>
      AI.get_idx(res0.a_cp, CP.start_reg(c as int)) == AI.get_idx(thread.capture_regs.a_cp, CP.start_reg(c as int))
      && AI.get_idx(res0.a_clk, CP.start_reg(c as int)) == AI.get_idx(thread.capture_regs.a_clk, CP.start_reg(c as int))
    by {
      forall c: nat | c in PIV.CapIdsOutsideLooks(re)
        ensures AI.get_idx(res0.a_cp, CP.start_reg(c as int)) == AI.get_idx(thread.capture_regs.a_cp, CP.start_reg(c as int))
             && AI.get_idx(res0.a_clk, CP.start_reg(c as int)) == AI.get_idx(thread.capture_regs.a_clk, CP.start_reg(c as int))
      {
        assert CP.start_reg(c as int) !in Sreg by {
          if CP.start_reg(c as int) in Sreg {
            if CP.start_reg(c as int) in (set cid | cid in PIV.CapIdsInLooks(ast) :: CP.start_reg(cid as int)) {
              var cid: nat :| cid in PIV.CapIdsInLooks(ast) && CP.start_reg(cid as int) == CP.start_reg(c as int);
              assert cid == c;
              assert c in PIV.CapIdsOutsideLooks(re) * PIV.CapIdsInLooks(re);
            } else {
              var cid: nat :| cid in PIV.CapIdsInLooks(ast) && CP.end_reg(cid as int) == CP.start_reg(c as int);
              assert 2 * (cid as int) + 1 == 2 * (c as int);
            }
            assert false;
          }
        }
      }
    }
    assert forall q: nat :: q in PIV.QuantIdsOutsideLooks(re) ==>
      AI.get_idx(res2.a_clk, q as int) == AI.get_idx(qtF.a_clk, q as int)
    by {
      forall q: nat | q in PIV.QuantIdsOutsideLooks(re)
        ensures AI.get_idx(res2.a_clk, q as int) == AI.get_idx(qtF.a_clk, q as int)
      {
        assert (q as int) !in Sq by {
          if (q as int) in Sq {
            var q2: nat :| q2 in PIV.QuantIdsInLooks(ast) && q2 as int == q as int;
            assert q2 == q;
            assert q in PIV.QuantIdsOutsideLooks(re) * PIV.QuantIdsInLooks(re);
          }
        }
      }
    }

    // ---- FORWARD: every leaf-present inside-S group is reconstructed ------
    assert GmtTieInside(crv, str, ov, thread, leafgm, S, ncap, nlook, nquant);
    assert LookNestOkT(re, S, leafgm, thread);
    assert LookNestBackT(re, crv, str, ov, S, leafgm, thread, ncap, nlook, nquant);
    forall g: LG.GroupId | g in S && g in leafgm
      ensures g in PIV.GmOfLive(re, res0, lk, res2)
           && leafgm[g] == PIV.NormRange(PIV.GmOfLive(re, res0, lk, res2)[g])
    {
      var l: int :| 0 <= l < nlook
        && g in PIV.CapIds(M.VBody(crv, l))
        && M.MatchedPosLA(crv, lk, l)
        && var rf0 := M.FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
           rf0.Some?
           && var gmb := PIV.GmOfLive(M.VBody(crv, l), rf0.value.capture_regs,
                                      rf0.value.look_regs, rf0.value.quant_regs);
              var looktype := if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead;
              g in gmb && leafgm[g] == (if looktype.Lookbehind? then LBV.SwapRange(gmb[g]) else gmb[g]);
      var rf := M.FreshBodyMatch(crv, str, l, lk, ov, ncap, nlook, nquant);
      assert AReg.get_cp(lk, l).Some?;
      assert l >= 0 && (l as nat) in LTB.LookIds(re);
      assert 1 <= l <= maxlook;
      var la: R.lookaround, body: R.regex :|
        LTB.LookEntryOk(crv, l, la, body)
        && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
        && PIV.CapUnique(body) && PIV.QuantUnique(body)
        && PIV.CaptureRegs(body) <= Sreg
        && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(ast))
        && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
      assert body == M.VBody(crv, l);
      NI.LookBodyOfTablesTie(re, crv, l as nat);
      var la2: R.lookaround :| LTB.LookEntryOk(crv, l, la2, NI.LookBodyOfRE(re, l as nat));
      assert NI.LookBodyOfRE(re, l as nat) == body;
      NR.PlusIsLookBehindFragmentRE(body);
      assert g in PIV.CapIds(re);
      assert M.cp_ctx_ok(crv, str, lk, l);
      FreshBodyMatchCapWf(crv, str, l, lk, ov, ncap, nlook, nquant, body);
      // carrier forward at l
      assert NI.LookPathPresent(re, thread.capture_regs.a_clk, qtF.a_clk, -1, l as nat)
          && AI.get_idx(lk.a_clk, l) >= 0
          && AI.get_idx(lk.a_clk, l) >= NI.MxAtLidLk(re, qtF.a_clk, -1, l as nat) by {
        assert g in S && g in leafgm && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat));
      }
      // outer transport to the reconstructed banks
      NI.LookPathPresentAgree(re, thread.capture_regs.a_clk, qtF.a_clk,
                              res0.a_clk, res2.a_clk, -1, l as nat);
      assert NI.LookPathPresent(re, res0.a_clk, res2.a_clk, -1, l as nat);
      assert AI.get_idx(lk.a_clk, l) >= NI.MxAtLidLk(re, res2.a_clk, -1, l as nat);
      // body side on the fresh banks, transported to the reconstructed banks
      assert CM.RegsAgreeInside(res0, rf.value.capture_regs, PIV.CaptureRegs(body));
      PIV.BodyPathPresentLk(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs, g);
      assert CM.RegsAgreeInside(res2, rf.value.quant_regs, LKC.QIdsInt(body));
      NI.LookFreeNoLookIdsN(body);
      assert forall c: nat :: c in PIV.CapIds(body) ==>
        AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(c as int))
          == AI.get_idx(res0.a_clk, CP.start_reg(c as int)) by {
        forall c: nat | c in PIV.CapIds(body)
          ensures AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(c as int))
               == AI.get_idx(res0.a_clk, CP.start_reg(c as int))
        {
          assert CP.start_reg(c as int) in PIV.CaptureRegs(body);
        }
      }
      assert forall q: nat :: q in PIV.QuantIds(body) ==>
        AI.get_idx(AReg.as_arrays(rf.value.quant_regs).1, q as int)
          == AI.get_idx(res2.a_clk, q as int) by {
        forall q: nat | q in PIV.QuantIds(body)
          ensures AI.get_idx(AReg.as_arrays(rf.value.quant_regs).1, q as int)
               == AI.get_idx(res2.a_clk, q as int)
        {
          assert (q as int) in LKC.QIdsInt(body);
        }
      }
      NI.PathPresentLkAgree(body,
        AReg.as_arrays(rf.value.capture_regs).1, AReg.as_arrays(rf.value.look_regs).1,
        AReg.as_arrays(rf.value.quant_regs).1,
        res0.a_clk, lk.a_clk, res2.a_clk, -1, g);
      assert PIV.PathPresentLk(body, res0.a_clk, lk.a_clk, res2.a_clk, -1, g);
      NI.LookPathCompose(re, body, res0.a_clk, lk.a_clk, res2.a_clk, -1, l as nat, g);
      assert PIV.PathPresentLk(re, res0.a_clk, lk.a_clk, res2.a_clk, -1, g);
      assert PIV.MxAtGidLk(re, res0.a_clk, lk.a_clk, res2.a_clk, -1, g)
          == PIV.MxAtGidLk(body, res0.a_clk, lk.a_clk, res2.a_clk, -1, g);
      assert AI.get_idx(res0.a_clk, CP.start_reg(g as int))
          == AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(g as int)) by {
        assert CP.start_reg(g as int) in PIV.CaptureRegs(body);
      }
      assert AI.get_idx(res0.a_clk, CP.start_reg(g as int))
          >= PIV.MxAtGidLk(re, res0.a_clk, lk.a_clk, res2.a_clk, -1, g) by {
        assert PIV.MxAtGidLk(body,
                 AReg.as_arrays(rf.value.capture_regs).1, AReg.as_arrays(rf.value.look_regs).1,
                 AReg.as_arrays(rf.value.quant_regs).1, -1, g)
            == PIV.MxAtGidLk(body, res0.a_clk, lk.a_clk, res2.a_clk, -1, g);
      }
      assert AReg.as_arrays(res0).1 == res0.a_clk && AReg.as_arrays(lk).1 == lk.a_clk
          && AReg.as_arrays(res2).1 == res2.a_clk;
      InsidePresentResBridge(re, body, crv, str, ov, thread, leafgm, res0, res2, l,
                             ncap, nlook, nquant, g);
      // InsidePresentResBridge gives the LOOK-TYPE swap; leaf-orderedness turns it
      // into the POSITIONAL NormRange.
      var looktype := if 0 <= l < |crv.f_look_types| then crv.f_look_types[l] else R.Lookahead;
      assert leafgm[g].endIdx.Some? ==> leafgm[g].startIdx <= leafgm[g].endIdx.value;  // OrderedGm
      NormRangeFromSwap(PIV.GmOfLive(re, res0, lk, res2)[g], leafgm[g], looktype.Lookbehind?);
    }

    // ---- REVERSE: the reconstruction invents no group the leaf lacks ------
    forall g: LG.GroupId | g in S && g in PIV.GmOfLive(re, res0, lk, res2)
      ensures g in leafgm
    {
      NI.CapIdsInLooksHasOwner(re, g);
      var lid: nat :| lid in LTB.LookIds(re) && g in PIV.CapIds(NI.LookBodyOfRE(re, lid));
      var LB := NI.LookBodyOfRE(re, lid);
      NI.LookBodyOfTablesTie(re, crv, lid);
      var laT: R.lookaround :| LTB.LookEntryOk(crv, lid as int, laT, LB);
      assert M.VBody(crv, lid as int) == LB;
      assert 1 <= lid <= maxlook;
      NI.LookBodyOfFragment(re, lid);
      NR.PlusIsLookBehindFragmentRE(LB);
      assert g in PIV.CapIds(re);
      if AReg.get_cp(lk, lid as int).None? {
        // untouched owner: the slot is still INIT, so g cannot be present
        var SpM := set lm: int, k: int |
          1 <= lm <= maxlook && AReg.get_cp(lk, lm).Some? && k in PIV.CaptureRegs(M.VBody(crv, lm)) :: k;
        M.FLookLoopCaptureFrame(crv, str, 1, maxlook, thread.capture_regs, lk, qtF, ov, ast, SpM);
        assert CM.RegsAgreeOutside(res0, thread.capture_regs, SpM);
        assert CP.start_reg(g as int) !in SpM by {
          if CP.start_reg(g as int) in SpM {
            var lm: int :| 1 <= lm <= maxlook && AReg.get_cp(lk, lm).Some?
              && CP.start_reg(g as int) in PIV.CaptureRegs(M.VBody(crv, lm));
            assert (lm as nat) in LTB.LookIds(re);
            NI.LookBodyOfTablesTie(re, crv, lm as nat);
            var laM: R.lookaround :| LTB.LookEntryOk(crv, lm, laM, NI.LookBodyOfRE(re, lm as nat));
            assert M.VBody(crv, lm) == NI.LookBodyOfRE(re, lm as nat);
            var c: nat :| c in PIV.CapIds(M.VBody(crv, lm))
              && (CP.start_reg(g as int) == CP.start_reg(c as int)
                  || CP.start_reg(g as int) == CP.end_reg(c as int));
            assert c == g by {
              if CP.start_reg(g as int) == CP.end_reg(c as int) {
                assert 2 * (g as int) == 2 * (c as int) + 1;
              }
            }
            assert (lm as nat) == lid by {
              if (lm as nat) != lid {
                NI.LookBodiesCapsDisjoint(re, lid, lm as nat);
                assert g in PIV.CapIds(NI.LookBodyOfRE(re, lid))
                         * PIV.CapIds(NI.LookBodyOfRE(re, lm as nat));
              }
            }
            assert AReg.get_cp(lk, lid as int).Some?;
            assert false;
          }
        }
        assert AI.get_idx(res0.a_cp, CP.start_reg(g as int))
            == AI.get_idx(thread.capture_regs.a_cp, CP.start_reg(g as int));
        assert g in PIV.CapIdsInLooks(ast);
        assert AI.get_idx(res0.a_cp, CP.start_reg(g as int)) == -1;
        assert AReg.as_arrays(res0).0 == res0.a_cp;
        M.GmOfLiveInsideLookAbsentEq(re, LB, res0, lk, res2, res0, lk, res2, g);
        assert false;
      } else {
        var la: R.lookaround, body: R.regex :|
          LTB.LookEntryOk(crv, lid as int, la, body)
          && NR.LookFreeRE(body) && NR.PlusFragmentRE(body)
          && PIV.CapUnique(body) && PIV.QuantUnique(body)
          && PIV.CaptureRegs(body) <= Sreg
          && (forall q: nat :: q in PIV.QuantIds(body) ==> q in PIV.QuantIdsInLooks(ast))
          && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
        assert body == LB;
        // L3b: the matched lid is a POSITIVE capturing look — lookAHEAD or lookBEHIND
        // (negatives are capture-free, so g in CapIds(body) refutes them). This pin keeps
        // the MatchedPosLA VC cheap; without it the SMT search blows up (2 timeouts).
        assert la.Lookahead? || la.Lookbehind? by {
          if !(la.Lookahead? || la.Lookbehind?) {
            assert NR.CaptureFreeRE(body);
            PIV.CaptureFreeNoCapIds(body);
            assert g in PIV.CapIds(body);
          }
        }
        assert M.MatchedPosLA(crv, lk, lid as int) by {
          assert 0 <= (lid as int) < |crv.f_look_types|;
          assert crv.f_look_types[lid as int] == la;
          assert AReg.get_cp(lk, lid as int).Some?;
          assert la.Lookahead? || la.Lookbehind?;
        }
        assert forall c: nat :: c in PIV.CapIds(re) && AI.get_idx(res0.a_clk, CP.start_reg(c as int)) < 0
                               ==> AI.get_idx(res0.a_cp, CP.start_reg(c as int)) < 0;
        PIV.GmOfLivePresenceExtractLk(re, res0, lk, res2, g);
        assert AReg.as_arrays(res0).1 == res0.a_clk && AReg.as_arrays(lk).1 == lk.a_clk
            && AReg.as_arrays(res2).1 == res2.a_clk && AReg.as_arrays(res0).0 == res0.a_cp;
        assert PIV.PathPresentLk(re, res0.a_clk, lk.a_clk, res2.a_clk, -1, g);
        NI.LookPathDecompose(re, LB, res0.a_clk, lk.a_clk, res2.a_clk, -1, lid, g);
        assert NI.LookPathPresent(re, res0.a_clk, res2.a_clk, -1, lid);
        var lcv := AI.get_idx(lk.a_clk, lid as int);
        assert lcv >= 0 && lcv >= NI.MxAtLidLk(re, res2.a_clk, -1, lid);
        NI.LookPathPresentAgree(re, res0.a_clk, res2.a_clk,
                                thread.capture_regs.a_clk, qtF.a_clk, -1, lid);
        assert NI.LookPathPresent(re, thread.capture_regs.a_clk, qtF.a_clk, -1, lid);
        assert lcv >= NI.MxAtLidLk(re, qtF.a_clk, -1, lid);
        NI.LookPathDomIntro(re, thread.capture_regs.a_clk, qtF.a_clk, -1, lid, lcv);
        assert NI.LookPathDom(re, lcv, qtF.a_clk, lid);
        var rf := M.FreshBodyMatch(crv, str, lid as int, lk, ov, ncap, nlook, nquant);
        assert rf.Some? by {
          if rf.None? {
            assert CM.RegsAgreeInside(res0, AReg.init_regs(ncap), PIV.CaptureRegs(LB));
            assert CP.start_reg(g as int) in PIV.CaptureRegs(LB);
            RL.AInitLaws(ncap);
            assert AI.get_idx(res0.a_cp, CP.start_reg(g as int)) == -1;
            assert AI.get_idx(res0.a_cp, CP.start_reg(g as int)) >= 0;
          }
        }
        assert CM.RegsAgreeInside(res0, rf.value.capture_regs, PIV.CaptureRegs(LB));
        assert CM.RegsAgreeInside(res2, rf.value.quant_regs, LKC.QIdsInt(LB));
        NI.LookFreeNoLookIdsN(LB);
        assert forall c: nat :: c in PIV.CapIds(LB) ==>
          AI.get_idx(res0.a_clk, CP.start_reg(c as int))
            == AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(c as int)) by {
          forall c: nat | c in PIV.CapIds(LB)
            ensures AI.get_idx(res0.a_clk, CP.start_reg(c as int))
                 == AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(c as int))
          {
            assert CP.start_reg(c as int) in PIV.CaptureRegs(LB);
          }
        }
        assert forall q: nat :: q in PIV.QuantIds(LB) ==>
          AI.get_idx(res2.a_clk, q as int)
            == AI.get_idx(AReg.as_arrays(rf.value.quant_regs).1, q as int) by {
          forall q: nat | q in PIV.QuantIds(LB)
            ensures AI.get_idx(res2.a_clk, q as int)
                 == AI.get_idx(AReg.as_arrays(rf.value.quant_regs).1, q as int)
          {
            assert (q as int) in LKC.QIdsInt(LB);
          }
        }
        NI.PathPresentLkAgree(LB, res0.a_clk, lk.a_clk, res2.a_clk,
          AReg.as_arrays(rf.value.capture_regs).1, AReg.as_arrays(rf.value.look_regs).1,
          AReg.as_arrays(rf.value.quant_regs).1, -1, g);
        assert PIV.PathPresentLk(LB,
          AReg.as_arrays(rf.value.capture_regs).1, AReg.as_arrays(rf.value.look_regs).1,
          AReg.as_arrays(rf.value.quant_regs).1, -1, g);
        assert CP.start_reg(g as int) in PIV.CaptureRegs(LB);
        assert AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(g as int))
            == AI.get_idx(res0.a_clk, CP.start_reg(g as int));
        assert AI.get_idx(AReg.as_arrays(rf.value.capture_regs).0, CP.start_reg(g as int))
            == AI.get_idx(res0.a_cp, CP.start_reg(g as int));
        assert AI.get_idx(res0.a_cp, CP.start_reg(g as int)) >= 0;
        assert AI.get_idx(AReg.as_arrays(rf.value.capture_regs).1, CP.start_reg(g as int))
            >= PIV.MxAtGidLk(LB,
                 AReg.as_arrays(rf.value.capture_regs).1, AReg.as_arrays(rf.value.look_regs).1,
                 AReg.as_arrays(rf.value.quant_regs).1, -1, g) by {
          assert AI.get_idx(res0.a_clk, CP.start_reg(g as int))
              >= PIV.MxAtGidLk(re, res0.a_clk, lk.a_clk, res2.a_clk, -1, g);
          assert PIV.MxAtGidLk(re, res0.a_clk, lk.a_clk, res2.a_clk, -1, g)
              == PIV.MxAtGidLk(LB, res0.a_clk, lk.a_clk, res2.a_clk, -1, g);
          assert PIV.MxAtGidLk(LB, res0.a_clk, lk.a_clk, res2.a_clk, -1, g)
              == PIV.MxAtGidLk(LB,
                   AReg.as_arrays(rf.value.capture_regs).1, AReg.as_arrays(rf.value.look_regs).1,
                   AReg.as_arrays(rf.value.quant_regs).1, -1, g);
        }
        PIV.GmOfLiveKeepsPresentLk(LB, rf.value.capture_regs, rf.value.look_regs,
                                   rf.value.quant_regs, g);
        assert g in PIV.GmOfLive(LB, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs);
        assert g in leafgm by {
          assert M.MatchedPosLA(crv, lk, lid as int)
              && NI.LookPathDom(re, AI.get_idx(lk.a_clk, lid as int), qtF.a_clk, lid);
        }
      }
    }

    // ---- assemble ---------------------------------------------------------
    WinningGmtTieOutside(re, thread, leafgm,
      PIV.GmOfLive(re, thread.capture_regs, thread.look_regs, thread.quant_regs), S);
    assert forall k: int :: k !in PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)) ==>
      AI.get_idx(AReg.as_arrays(res0).0, k) == AI.get_idx(AReg.as_arrays(thread.capture_regs).0, k)
      && AI.get_idx(AReg.as_arrays(res0).1, k) == AI.get_idx(AReg.as_arrays(thread.capture_regs).1, k)
    by {
      assert PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)) == Sreg;
    }
    assert forall q: nat :: q in PIV.QuantIdsOutsideLooks(re) ==>
      AI.get_idx(AReg.as_arrays(res2).1, q as int) == AI.get_idx(AReg.as_arrays(thread.quant_regs).1, q as int);
    L3aValueBridge(re, thread, leafgm, res0, res2, S);
    assert leafgm == PIV.NormGm(PIV.GmOfLive(re, res0, lk, res2));
    assert CM.ThreadRegsWf(AI.Thread(thread.pc, res0, res.1, res2, thread.exit_allowed),
                           ncap, nlook, nquant);
    assert M.QuantRegsFinal(AI.Thread(thread.pc, res0, res.1, res2, thread.exit_allowed));
  }

  // ==========================================================================
  // (E4 NESTED) THE ENDPOINT ASSEMBLY under look NESTING. Consumes the nested
  // best-tie `BestTieLkNested` (which DROPS `GmtTieInside`) and closes the
  // whole-regex value theorem `leaf.1 == NormGm(GmOfLive(re, res.0, res.1, res.2))`.
  //
  // KEY RETARGET vs. the depth-1 endpoint: the value reads the RECONSTRUCTED look
  // bank `res.1` (NOT `thread.look_regs`) — under nesting `FLookLoop` writes the
  // inner-look banks, so `res.1 != thread.look_regs` inside `LookIdSet(re)`. On
  // OUTSIDE-`S` groups the two coincide (`PIV.GmOfLiveLookIndepNested`), which is
  // how the outside half still rides the winning-thread's `GmtTieOutside`.
  //
  // WHAT IS DERIVED GREEN HERE: the entire OUTSIDE-`S` half —
  //   BestTieLkNested ⟹ GmtTieOutside(re, thread, leafgm, S)
  //     --[GmOfLiveLookIndepNested: thread.look_regs ~ res.1 outside S]-->
  //   leafgm ~ GmOfLive(re, thread.cap, res.1, thread.quant) outside S
  //     --[OutsideLookValueBridgeNested: cap/quant frame res.0/res.2 ~ thread]-->
  //   leafgm ~ GmOfLive(re, res.0, res.1, res.2) outside S
  //   --[L3aValueBridgeNested]--> leaf.1 == NormGm(GmOfLive(re, res.0, res.1, res.2)).
  //
  // WHAT REMAINS (TODO C4 — the genuinely-novel INSIDE glue + nested FLookLoop
  // plumbing), stated as the residual `requires`:
  //  (a) recon_outer cap frame + quant frame + synthetic-`res` well-formedness —
  //      the nested FLookLoop scaffolding (`M.FLookLoopFullCoversFromTables`
  //      supplies recon_outer/recon_inner; the quant frame + `CapRegWf(res.0)` +
  //      `QuantRegsFinal` need the nested `FLookLoopQuantFrame`/`FLookLoopValueLiftFull`
  //      table-side-condition preamble — mechanical but large).
  //  (b) INSIDE-`S` FORWARD value: `leaf.1[g] == NormRange(GmOfLive(re,res0,res1,res2)[g])`.
  //      The 3-component chain (`FLookLoopFullCoversFromTables` -> `res.0` carries `g`
  //      at its innermost owner's fresh value; `OuterLeafInnerGEqOwnerBody` -> `leaf[g]`
  //      == owner-body spec sub-result; `LkReplayMatchesSpecNested` -> owner-fresh ==
  //      owner-sub-result). This chain needs (i) the SPEC tree `t` with `leaf ==
  //      FirstLeaf(t, inp)` threaded in — `BestTieLkNested` does NOT carry it (unlike
  //      the depth-1 `GmtTieInside`); and (ii) nested `LookPath*` ownership lemmas
  //      (`LookPathCompose/Decompose/PresentAgree`), which currently exist only for
  //      `LookBehindFragmentRE` in `NestInv.dfy`.
  //  (c) INSIDE-`S` REVERSE: `g in GmOfLive(re,res0,res1,res2) ==> g in leaf.1`, fed
  //      by the KEPT carrier `LookNestBackT` (in `BestTieLkNested`) — but the depth-1
  //      reverse block routes through `LookPathDecompose`/`LookPathDomIntro`/
  //      `LookFreeNoLookIdsN`, all `LookBehindFragmentRE`-gated; nested twins pending.
  // ==========================================================================
  lemma {:isolate_assertions} L3aEndpointAssemblyNested(
      ast: R.regex, re: R.regex, crv: CP.FCompiled, code: RB.code, endl: nat,
      str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
      thread: AI.Thread, leaf: LT.Leaf, ncap: int, nlook: int, nquant: int)
    requires T.TransWf(re) && NR.NestedFragmentRE(re) && NR.NegLooksLookFreeRE(re)
    requires PIV.CapUnique(re) && PIV.QuantUnique(re) && LTB.LookUnique(re)
    requires S == PIV.CapIdsInLooks(re)
    requires R.max_lookaround(re) == R.max_lookaround(ast)
    // L3b: the leaf value is ORDERED (spec GMClose ordering) — lets the NormRange
    // conversion collapse on the outside/forward groups.
    requires M.OrderedGm(leaf.1)
    // the nested best-match tie (GmtTieInside dropped; GmtTieOutside + the two
    // LookNest carriers kept).
    requires BestTieLkNested(re, crv, str, ov, S, Some(leaf), Some(thread), ncap, nlook, nquant)
    // ---- the depth-general FLookLoop reconstruction + residual (TODO C4) ----
    requires var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                     thread.capture_regs, thread.look_regs, thread.quant_regs, ov);
      // (a) recon_outer cap frame — FLookLoop writes captures only inside look bodies
      //     (supplied by M.FLookLoopFullCoversFromTables).
      (forall k: int :: k !in PIV.CaptureRegsSet(PIV.CapIdsInLooks(re)) ==>
         AI.get_idx(AReg.as_arrays(res.0).0, k) == AI.get_idx(AReg.as_arrays(thread.capture_regs).0, k)
         && AI.get_idx(AReg.as_arrays(res.0).1, k) == AI.get_idx(AReg.as_arrays(thread.capture_regs).1, k))
      // (a) quant frame outside looks (nested FLookLoopQuantFrame).
      && (forall q: nat :: q in PIV.QuantIdsOutsideLooks(re) ==>
         AI.get_idx(AReg.as_arrays(res.2).1, q as int) == AI.get_idx(AReg.as_arrays(thread.quant_regs).1, q as int))
      // (b) INSIDE-S FORWARD value chain (spec tree + nested LookPath* + Range↔GmOfLive).
      && (forall g: LG.GroupId :: g in S && g in leaf.1 ==>
           g in PIV.GmOfLive(re, res.0, res.1, res.2)
           && leaf.1[g] == PIV.NormRange(PIV.GmOfLive(re, res.0, res.1, res.2)[g]))
      // (c) INSIDE-S REVERSE (LookNestBackT + nested LookPathDecompose/DomIntro).
      && (forall g: LG.GroupId :: g in S
           && g in PIV.GmOfLive(re, res.0, res.1, res.2) ==> g in leaf.1)
      // (a) synthetic-res well-formedness (nested FLookLoopValueLiftFull).
      && CM.ThreadRegsWf(AI.Thread(thread.pc, res.0, res.1, res.2, thread.exit_allowed), ncap, nlook, nquant)
      && M.QuantRegsFinal(AI.Thread(thread.pc, res.0, res.1, res.2, thread.exit_allowed))
    ensures var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                                    thread.capture_regs, thread.look_regs, thread.quant_regs, ov);
      leaf.1 == PIV.NormGm(PIV.GmOfLive(re, res.0, res.1, res.2))
      && CM.ThreadRegsWf(AI.Thread(thread.pc, res.0, res.1, res.2, thread.exit_allowed), ncap, nlook, nquant)
      && M.QuantRegsFinal(AI.Thread(thread.pc, res.0, res.1, res.2, thread.exit_allowed))
  {
    var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                            thread.capture_regs, thread.look_regs, thread.quant_regs, ov);
    var leafgm := leaf.1;
    var synthetic := AI.Thread(thread.pc, res.0, res.1, res.2, thread.exit_allowed);

    // ---- OUTSIDE S (derived green) ----------------------------------------
    // BestTieLkNested ⟹ GmtTieOutside(re, thread, leafgm, S).
    assert GmtTieOutside(re, thread, leafgm, S);
    var gmThread := PIV.GmOfLive(re, thread.capture_regs, thread.look_regs, thread.quant_regs);
    var gmBest := PIV.GmOfLive(re, thread.capture_regs, res.1, thread.quant_regs);
    // look-bank independence OUTSIDE CapIdsInLooks(re): move thread.look_regs -> res.1.
    PIV.GmOfLiveLookIndepNested(re, thread.capture_regs, thread.look_regs, res.1, thread.quant_regs);
    M.LkBodyGroupsEqCapIdsInLooks(re);                     // LkBodyGroups(Translate(re)) == S
    assert forall g: nat :: g !in LL.LkBodyGroups(T.Translate(re)) ==>
      (g in leafgm <==> g in gmBest) && (g in leafgm ==> leafgm[g] == gmBest[g])
    by {
      forall g: nat | g !in LL.LkBodyGroups(T.Translate(re))
        ensures (g in leafgm <==> g in gmBest) && (g in leafgm ==> leafgm[g] == gmBest[g])
      {
        assert g !in S;
        // GmtTieOutside: leafgm ~ gmThread off S; LookIndep: gmThread ~ gmBest off S.
        assert (g in leafgm <==> g in gmThread) && (g in leafgm ==> leafgm[g] == gmThread[g]);
        assert (g in gmThread <==> g in gmBest) && (g in gmThread ==> gmThread[g] == gmBest[g]);
      }
    }
    OutsideLookValueBridgeNested(re, thread.capture_regs, res.0, res.1, thread.quant_regs, res.2,
                                 gmBest, leafgm);
    assert forall g: LG.GroupId :: g !in S ==>
      (g in leafgm <==> g in PIV.GmOfLive(re, res.0, res.1, res.2))
      && (g in leafgm ==> leafgm[g] == PIV.GmOfLive(re, res.0, res.1, res.2)[g]);

    // ---- assemble (outside frame + the TODO-C4 inside premises) -----------
    assert synthetic.look_regs == res.1;
    L3aValueBridgeNested(re, synthetic, leafgm, res.0, res.2, S);
    assert leafgm == PIV.NormGm(PIV.GmOfLive(re, res.0, res.1, res.2));
  }

  // ==========================================================================
  // THE MAIN THEOREM, L3a: capturing positive lookaheads included. The
  // engine's full pipeline output IS the Linden tree-semantics answer, for
  // the whole lookbehind fragment with capturing forward lookaheads. This is
  // the (F) integration: the composite lockstep simulation delivers the leaf
  // ties, the endpoint assembly converts them into the reconstructed-register
  // denotation, and the existing extraction finishes.
  // ==========================================================================
  lemma {:isolate_assertions} MainTheoremL3(raw: R.raw_regex, str: string)
    requires NR.LookBehindFragmentRaw(raw)
    requires T.Latin1Wf(raw)
    ensures LES.MatcherSpec(raw, str, LES.Normalize(AI.FFullMatch(raw, str)))
  {
    var ast := R.annotate(raw);
    var re := R.lazy_prefix(ast);
    var rer := LES.TheRer(raw);
    var inp := LC.InitInput(str);
    var ngroups := LES.NGroups(raw);
    assert !rer.multiline && !rer.ignoreCase;

    // ---- static packages -------------------------------------------------
    T.AnnotateWf(raw);                     // TransWf(ast) && TransWf(re)
    NR.SpecRegexLookBehindFragment(raw);   // LookBehindFragmentRE(re)
    LTB.SpecRegexLookUnique(raw);          // unique lids, all >= 1
    assert NR.LookBehindFragmentRE(ast);
    PIV.SpecRegexCapUnique(raw);           // CapUnique(re)
    PIV.SpecRegexQuantUnique(raw);         // QuantUnique(re)
    var qm := AR.QMap(M.QmOfRE(re), OE.LmOf(re), AI.FBuildOracle(CP.FFullCompilation(ast), str));
    M.LookStaticPackage(raw, str, qm);

    NR.CompileToBytecodeRepLookBehind(re);
    var code := CP.compile_to_bytecode(re);
    var next := CP.compile(re, 0, CP.Progress).1;
    var endl: nat := next as nat;
    assert NR.NfaRepRE(re, code, 0, endl)
        && NR.GetPcRE(code, endl) == Some(RB.Accept) && |code| == endl + 1;
    PIV.CompileStutterTameRE(re);
    assert PSM.StaticOkRE(qm, re, code, endl);

    var maxcap := R.max_group(ast);
    var maxquant := R.max_quant(ast);
    assert R.max_group(re) == maxcap;
    assert R.max_quant(re) == R.imax(0, maxquant) == maxquant;
    var ncap := 2 * maxcap + 2;
    var nlook := R.max_lookaround(ast) + 1;
    var nquant := maxquant + 1;
    assert PSM.SizesOkRE(re, ncap, nlook, nquant);
    assert ngroups == (maxcap + 1) as nat;
    assert R.max_lookaround(re) == R.max_lookaround(ast) by {
      var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false), R.Re_character(R.Dot));
      assert re == R.Re_con(pre, ast);
    }

    // fragment code shape: every SetQuantToClock has b == false.
    forall pc: nat, q: int, b: bool | NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, b))
      ensures !b
    {
      if pc < endl {
        NI.CodeShapeAt(re, code, 0, endl, pc);
      } else if pc == endl {
      } else {
        assert pc >= |code|;
      }
    }

    // ---- the spec tree ---------------------------------------------------
    LFU.ComputeTrIsTree(rer, [LS.Areg(T.Translate(re))], inp, LG.Empty, WP.Forward);
    var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(re))], inp, LG.Empty, WP.Forward);
    assert LS.IsTree(rer, [LS.Areg(T.Translate(re))], inp, LG.Empty, WP.Forward, t);
    assert LES.SpecRegex(raw) == T.Translate(re);
    EL.TranslateFragmentPikeLk(re);
    EL.BooleanCorrectLk(rer, T.Translate(re), inp, t);
    assert forall i :: 0 <= i < |[LS.Areg(T.Translate(re))]| ==> ![LS.Areg(T.Translate(re))][i].Acheck?;
    M.BoolTreeLbIrrel(rer, [LS.Areg(T.Translate(re))], inp, BS.CanExit, BS.CannotExit, t);
    assert EL.BoolTreeLk(rer, [LS.Areg(T.Translate(re))], inp, BS.CannotExit, t);
    TranslateNoBackref(re);
    assert NoBackrefActions([LS.Areg(T.Translate(re))]);
    var fuel0 := FS.ActionsFuel([LS.Areg(T.Translate(re))], inp, WP.Forward) + 1;
    assert FS.ComputeTree(rer, [LS.Areg(T.Translate(re))], inp, LG.Empty, WP.Forward, fuel0) == Some(t);
    ComputePikeSubtreeLk(rer, [LS.Areg(T.Translate(re))], inp, LG.Empty, WP.Forward, fuel0, t);
    assert PTL.PikeSubtreeLk(t);

    // ---- the CHECKED tree (machine A's carrier) ---------------------------
    WOE.WalkOkEntry(re);
    assert EL.PikeLkActions([LS.Areg(T.Translate(re))]) by {
      assert [LS.Areg(T.Translate(re))] == [LS.Areg(T.Translate(re))] + [];
      assert EL.PikeLkActions([]);
      EL.PikeLkActionsConsIff(LS.Areg(T.Translate(re)), []);
    }
    assert LL.OracleOkSuffix(rer, qm, inp);
    var S := PIV.CapIdsInLooks(re);
    M.LkBodyGroupsEqCapIdsInLooks(re);
    assert S == LL.LkBodyGroups(T.Translate(re));
    assert LL.LkActsInS([LS.Areg(T.Translate(re))], S) by {
      LL.LkBodyGroupsConfines(T.Translate(re), S);
      assert LL.LkBodiesInS(T.Translate(re), S);
    }
    LL.ComputeTrLkConfined(rer, [LS.Areg(T.Translate(re))], inp, LG.Empty, WP.Forward, S);
    var tstar := ATR.ActionsTreeRepRE(rer, qm, [LS.Areg(T.Translate(re))], code, 0, inp, BS.CannotExit, t, S);
    assert TREP.TreeRepRE(qm, tstar, code, 0, inp, false);

    // ---- the engine pipeline ---------------------------------------------
    var crv := CP.FFullCompilation(ast);
    M.FFullCompilationFacts(ast);
    assert crv.f_main_ast == ast && crv.f_main_bc == code && crv.f_main_cdns == LCdn.compile_cdns(ast);
    var ov := AI.FBuildOracle(crv, str);
    OB.FBuildOracleViewLen(crv, str);                     // |ov| == |str| + 1 (for the backward LB gate)
    var capture := AReg.init_regs(ncap);
    var look := AReg.init_regs(nlook);
    var quant := AReg.init_regs(nquant);
    var ctx := AI.cp_context(0, str, LAnc.Forward);
    var inits := AI.FInitState(code, 0, capture, look, quant, 0, ctx);
    var fmres := AI.FFindMatch(code, str, inits, ov, LAnc.Forward, crv.f_main_cdns);
    var result := fmres.0;
    assert AI.FFindMatchPlus(code, ast, crv.f_plus_bc, str, ov, LAnc.Forward, 0,
                             capture, look, quant, 0, crv.f_main_cdns).0
        == (match result
            case None => None
            case Some(thread) => Some(AI.FReconstructPlus(thread, ast, crv.f_plus_bc, str, fmres.1, LAnc.Forward).0));

    // ---- gate statics + look tables ---------------------------------------
    LTB.FFullCompilationLookOk(ast);
    assert LTB.LookTablesOk(re, crv) by {
      var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false), R.Re_character(R.Dot));
      assert re == R.Re_con(pre, ast);
      assert LTB.LookTablesOk(pre, crv);
      assert LTB.LookTablesOk(ast, crv);
    }
    OE.LmOfDom(re);
    LTB.LookIdsLeMax(re);
    assert forall l: int :: l in qm.looks ==>
      l >= 0 && (l as nat) in LTB.LookIds(re) && l < nlook;
    GateStaticsFromTables(qm, re, crv, ncap, nlook, nquant);
    assert GateStaticsOk(qm, re, crv, ncap, nlook, nquant);

    // ---- the composite lockstep (both machines) ---------------------------
    PSM.InitialPikeInvFullRE(rer, qm, re, code, endl, ngroups, str, tstar, inits, ncap, nlook, nquant);
    assert ctx.nextchar == AI.get_char(str, 0);
    assert PIV.ContextOkRE(str, inits.cp, inits.context);
    assert qm.ov == ov;
    L3aCompositeClose(rer, qm, re, code, endl, ngroups, crv, str, ov, S, tstar, t, inp,
                      inits, crv.f_main_cdns, result, ncap, nlook, nquant);
    assert BestTieLk(re, crv, str, ov, S, LT.FirstLeaf(t, inp), result, ncap, nlook, nquant);

    // ---- stage the engine answer ------------------------------------------
    var bc := AI.FBuildCapture(crv, str, ov);
    assert AI.FMatcher(crv, str) == bc.0;
    assert AI.FFullMatch(raw, str) == bc.0;
    var fmp := AI.FFindMatchPlus(crv.f_main_bc, crv.f_main_ast, crv.f_plus_bc, str, ov,
                                 LAnc.Forward, 0, capture, look, quant, 0, crv.f_main_cdns);
    assert fmp == AI.FFindMatchPlus(code, ast, crv.f_plus_bc, str, ov,
                                    LAnc.Forward, 0, capture, look, quant, 0, crv.f_main_cdns);
    assert AI.FInitState(crv.f_main_bc, 0, capture, look, quant, 0,
                         AI.cp_context(0, str, LAnc.Forward)) == inits;
    assert fmp.0 == (match result
                     case None => None
                     case Some(thread) =>
                       Some(AI.FReconstructPlus(thread, ast, crv.f_plus_bc, str, fmres.1, LAnc.Forward).0));
    assert R.max_group(crv.f_main_ast) == maxcap && R.max_quant(crv.f_main_ast) == maxquant;
    assert ncap == 2 * R.max_group(crv.f_main_ast) + 2;
    assert nquant == R.max_quant(crv.f_main_ast) + 1;

    if result.None? {
      assert fmp.0 == None;
      M.FBuildCaptureUnfoldL3a(crv, str, ov, ncap, nlook, nquant, capture, look, quant, fmp);
      assert bc.0 == None;
      assert LT.FirstLeaf(t, inp) == None;
      assert LES.Normalize(AI.FFullMatch(raw, str)) == None;
      assert LES.MatcherSpec(raw, str, None);
    } else {
      var thread := result.value;
      // winning-thread wf (mirrors the endpoint's own derivation, needed here
      // for the reconstruct identity)
      CM.RegsClocksLEInit(ncap, 0);
      CM.RegsClocksLEInit(nlook, 0);
      CM.RegsClocksLEInit(nquant, 0);
      CM.FInitStateClocksLE(code, 0, capture, look, quant, 0, ctx);
      CM.FInitStateRegsWf(code, 0, ncap, nlook, nquant, 0, ctx);
      assert M.VmQuantFinal(inits) by {
        var th0 := AI.init_thread(capture, look, quant);
        assert M.QuantRegsFinal(th0) by {
          forall k ensures AI.get_idx(quant.a_cp, k) < 0 && AI.get_idx(quant.a_clk, k) >= -1 {
            if 0 <= k < |quant.a_cp| { assert quant.a_cp[k] == -1; }
            if 0 <= k < |quant.a_clk| { assert quant.a_clk[k] == -1; }
          }
        }
        forall t2 | t2 in inits.active ensures M.QuantRegsFinal(t2) { assert t2 == th0; }
      }
      M.FFindMatchThreadFacts(code, str, inits, ov, LAnc.Forward, crv.f_main_cdns, ncap, nlook, nquant);
      assert CM.ThreadRegsWf(thread, ncap, nlook, nquant) && M.QuantRegsFinal(thread);
      M.FNulledPlusIdentity(ast, thread.capture_regs, thread.look_regs, thread.quant_regs,
                            crv.f_plus_bc, str, fmres.1, LAnc.Forward);
      assert AI.FReconstructPlus(thread, ast, crv.f_plus_bc, str, fmres.1, LAnc.Forward).0 == thread;
      assert fmp.0 == Some(thread);

      // the oracle is stable through the whole pipeline: fmp.1 == ov
      PSM.StaticOkNoWrite(qm, re, code, endl);
      CM.FFindMatchOvStable(code, str, inits, ov, LAnc.Forward, crv.f_main_cdns);
      assert fmres.1 == ov;
      assert fmp.1 == ov by {
        assert fmp == (Some(AI.FReconstructPlus(thread, ast, crv.f_plus_bc, str, ov, LAnc.Forward).0),
                       AI.FReconstructPlus(thread, ast, crv.f_plus_bc, str, ov, LAnc.Forward).1);
        M.FNulledPlusIdentity(ast, thread.capture_regs, thread.look_regs, thread.quant_regs,
                              crv.f_plus_bc, str, ov, LAnc.Forward);
      }

      // the leaf + the endpoint assembly
      assert LT.FirstLeaf(t, inp).Some?;
      var leaf := LT.FirstLeaf(t, inp).value;
      assert BestTieLk(re, crv, str, ov, S, Some(leaf), Some(thread), ncap, nlook, nquant);
      assert forall lx: nat :: lx in LTB.LookIds(re) ==> 1 <= lx;
      M.FirstLeafOrdered(t, inp, leaf);                     // leaf.1 ORDERED (item 0)
      L3aEndpointAssembly(ast, re, crv, code, endl, str, ov, S, thread, leaf,
                          inits, capture, look, quant, crv.f_main_cdns, ncap, nlook, nquant);
      var res := AI.FLookLoop(crv, str, 1, R.max_lookaround(ast),
                              thread.capture_regs, thread.look_regs, thread.quant_regs, ov);
      var synthetic := AI.Thread(thread.pc, res.0, res.1, res.2, thread.exit_allowed);
      assert leaf.1 == PIV.NormGm(PIV.GmOfLive(re, res.0, thread.look_regs, res.2));
      assert res.1 == thread.look_regs;
      assert CM.ThreadRegsWf(synthetic, ncap, nlook, nquant) && M.QuantRegsFinal(synthetic);

      // the engine answer via the L3a unfold, at the SAME res
      M.FBuildCaptureUnfoldL3a(crv, str, ov, ncap, nlook, nquant, capture, look, quant, fmp);
      assert bc.0 == Some(AI.filter_reset(crv.f_main_ast, res.0, res.1, res.2, -1)) by {
        assert fmp.0.value == thread;
        assert AI.FLookLoop(crv, str, 1, R.max_lookaround(crv.f_main_ast),
                            thread.capture_regs, thread.look_regs, thread.quant_regs, fmp.1) == res;
      }
      assert AI.FFullMatch(raw, str)
          == Some(AI.filter_reset(ast, synthetic.capture_regs, synthetic.look_regs,
                                  synthetic.quant_regs, -1));

      // ---- extraction (the L1 discipline: restate + hide) ------------------
      assert EL.BoolTreeLk(LES.TheRer(raw), [LS.Areg(LES.SpecRegex(raw))], LC.InitInput(str), BS.CannotExit, t);
      assert LS.IsTree(LES.TheRer(raw), [LS.Areg(LES.SpecRegex(raw))], LC.InitInput(str), LG.Empty, WP.Forward, t);
      assert CM.ThreadRegsWf(synthetic, 2 * R.max_group(R.annotate(raw)) + 2,
                             R.max_lookaround(R.annotate(raw)) + 1,
                             R.max_quant(R.annotate(raw)) + 1) by {
        hide *;
        assert ast == R.annotate(raw);
        assert R.max_lookaround(ast) + 1 == nlook;
        assert CM.ThreadRegsWf(synthetic, ncap, nlook, nquant);
      }
      assert M.QuantRegsFinal(synthetic);
      assert leaf.1 == PIV.NormGm(PIV.GmOfLive(R.lazy_prefix(R.annotate(raw)), synthetic.capture_regs,
                                    synthetic.look_regs, synthetic.quant_regs)) by {
        hide *;
        assert ast == R.annotate(raw) && re == R.lazy_prefix(ast);
        assert synthetic.capture_regs == res.0 && synthetic.look_regs == res.1 == thread.look_regs
            && synthetic.quant_regs == res.2;
        assert leaf.1 == PIV.NormGm(PIV.GmOfLive(re, res.0, thread.look_regs, res.2));
      }
      assert LT.FirstLeaf(t, LC.InitInput(str)) == Some(leaf);
      assert AI.FFullMatch(raw, str)
          == Some(AI.filter_reset(R.annotate(raw), synthetic.capture_regs, synthetic.look_regs,
                                  synthetic.quant_regs, -1));
      { hide *; M.MainExtraction(raw, str, t, synthetic, leaf); }
    }
  }

  lemma WalkPairLkAtJmpRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                        tb: LT.Tree, gmt: LG.GroupMap, pc: nat, ea: bool, x: int)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gmt, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Jmp(x))
    ensures x >= 0 && WalkPairLkRec(rer, qm, code, inp, tb, gmt, x as nat, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gmt)
      && WalkDefsOk(acts);
    ActionsRepLThruJmp(rer, qm, acts, code, pc, x);
  }

  lemma WalkPairLkAtConsumeCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                acts: LS.Actions, ce: RC.char_expectation)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures tb.Read? || tb == LT.Mismatch
    ensures tb.Read? ==> exists nextinp ::
      AR.ReadCharE(ce, inp) == Some((tb.c, nextinp))
      && WalkPairLkRec(rer, qm, code, nextinp, tb.t, gm, pc + 1, true)
    ensures tb == LT.Mismatch ==> AR.ReadCharE(ce, inp) == None
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not Consume
    case Aclose(_) =>   // pins SetRegisterToCP — not Consume
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtConsumeCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, ce);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtConsumeCoreRec(rer, qm, code, inp, tb, gm, pc, b, na, ce);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtConsumeCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, ce);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsNonConsume(rer, qm, greedy, min, delta, r1, code, pc, pcmid, ce);
        }
      case Character(cd) =>
        assert acts[0] == LS.Areg(L.Character(cd));
        var ce2 :| NR.GetPcRE(code, pc) == Some(RB.Consume(ce2)) && AR.ExpectationMatches(rer, ce2, cd);
        assert ce2 == ce && pcmid == pc + 1;
        AR.ReadAgree(rer, ce, cd, inp);   // ReadCharE(ce, inp) == ReadChar(rer, cd, inp, Forward)
        match LC.ReadChar(rer, cd, inp, WP.Forward) {
          case None =>
            assert tb == LT.Mismatch;
          case Some(pair) =>
            assert tb.Read? && tb.c == pair.0 && EL.BoolTreeLk(rer, cont, pair.1, BS.CanExit, tb.t);
            assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
            GateAheadClearTail(acts, gm);
            WalkDefsOkTail(acts);
            assert WalkPairLkRec(rer, qm, code, pair.1, tb.t, gm, pc + 1, true) by {
              assert ATR.EaOf(BS.CanExit) == true;
              assert EL.PikeLkActionsRec(cont);
            }
            assert AR.ReadCharE(ce, inp) == Some((tb.c, pair.1));
        }
      case Disjunction(_, _) =>   // pins Fork — not Consume
      case Group(_, _) =>   // pins SetRegisterToCP — not Consume
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Consume
      case AnchorR(_) =>   // pins AnchorAssertion — not Consume
      case Backreference(_) =>   // NfaRepL false
  }

  lemma WalkPairLkAtConsumeRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                            tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, ce: RC.char_expectation)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    ensures tb.Read? || tb == LT.Mismatch
    ensures tb.Read? ==> exists nextinp ::
      AR.ReadCharE(ce, inp) == Some((tb.c, nextinp))
      && WalkPairLkRec(rer, qm, code, nextinp, tb.t, gm, pc + 1, true)
    ensures tb == LT.Mismatch ==> AR.ReadCharE(ce, inp) == None
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtConsumeCoreRec(rer, qm, code, inp, tb, gm, pc, b, acts, ce);
  }

  lemma WalkPairLkAtNegCheckOracleCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                       tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                       acts: LS.Actions, lid: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.NegCheckOracle(lid))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
      !AR.PositiveL(lk)
      && (LS.LkResult(lk, tlk, LG.Empty, inp).Some? ==>
            tb.LK? && tb.lk == lk && tb.tlk == tlk
            && WalkPairLkRec(rer, qm, code, inp, tb.t, gm, pc + 1, ATR.EaOf(b)))
      && (LS.LkResult(lk, tlk, LG.Empty, inp).None? ==> tb == LT.LKFail(lk, tlk))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not NegCheckOracle
    case Aclose(_) =>   // pins SetRegisterToCP — not NegCheckOracle
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtNegCheckOracleCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, lid);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtNegCheckOracleCoreRec(rer, qm, code, inp, tb, gm, pc, b, na, lid);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtNegCheckOracleCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, lid);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case LookaroundR(lk0, r1) =>
        // ActionRepL's polarity split: a NegCheckOracle pc hosts a NEGATIVE look
        var lid0: int :| NR.GetPcRE(code, pc) == Some(if AR.PositiveL(lk0) then RB.CheckOracle(lid0)
                                                     else RB.NegCheckOracle(lid0))
          && lid0 in qm.looks && qm.looks[lid0] == (lk0, r1);
        assert !AR.PositiveL(lk0) && lid0 == lid;
        assert pcmid == pc + 1;
        M.GateNodeAtInp(rer, acts, inp, b, tb, lk0, r1);   // tb is LK/LKFail with LkGateOk
        var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk0));
        if tb.LK? {
          assert tb.tlk == tlk && LS.LkResult(lk0, tlk, LG.Empty, inp).Some?;   // LkGateOk true
          assert EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          // the passing negative merge is the identity ⟹ plain tail bricks
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          assert EL.PikeLkActionsRec(cont);
          assert WalkPairLkRec(rer, qm, code, inp, tb.t, gm, pc + 1, g);
        } else {
          assert tb.LKFail? && tb.tlk == tlk;               // LkGateOk false
          assert LS.LkResult(lk0, tlk, LG.Empty, inp).None?;
          assert tb == LT.LKFail(lk0, tlk);
        }
      case Character(_) =>   // pins Consume — not NegCheckOracle
      case Disjunction(_, _) =>   // pins Fork — not NegCheckOracle
      case Group(_, _) =>   // pins SetRegisterToCP — not NegCheckOracle
      case AnchorR(_) =>   // pins AnchorAssertion — not NegCheckOracle
      case Backreference(_) =>   // NfaRepL false
  }

  lemma WalkPairLkAtNegCheckOracleRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                   tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, lid: int)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.NegCheckOracle(lid))
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
      !AR.PositiveL(lk)
      && (LS.LkResult(lk, tlk, LG.Empty, inp).Some? ==>
            tb.LK? && tb.lk == lk && tb.tlk == tlk
            && WalkPairLkRec(rer, qm, code, inp, tb.t, gm, pc + 1, ea))
      && (LS.LkResult(lk, tlk, LG.Empty, inp).None? ==> tb == LT.LKFail(lk, tlk))
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtNegCheckOracleCoreRec(rer, qm, code, inp, tb, gm, pc, b, acts, lid);
  }

  lemma WalkPairLkAtEndLoopCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                acts: LS.Actions)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.EndLoop)
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures ATR.EaOf(b) ==> tb.Progress? && WalkPairLkRec(rer, qm, code, inp, tb.t, gm, pc + 1, true)
    ensures !ATR.EaOf(b) ==> tb == LT.Mismatch
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    assert !AR.BackForkAt(code, pc);   // GetPcRE(pc)==EndLoop, not Fork
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(strcheck) =>
      // ActionRepL(Acheck): EndLoop disjunct (BackFork excluded) ⇒ pcmid == pc+1
      assert pcmid == pc + 1;
      if b == BS.CanExit {
        assert g == true;
        assert tb.Progress? && EL.BoolTreeLk(rer, cont, inp, BS.CanExit, tb.t);
        assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
        // gm UNCHANGED across the guard ⟹ tail bricks give the continuation clear.
        GateAheadClearTail(acts, gm);       // GateAheadClear(cont, gm)
        WalkDefsOkTail(acts);             // NoDupSeq(AllDefsActs(cont))
        assert EL.PikeLkActionsRec(cont);
        assert ATR.EaOf(BS.CanExit) == true;
        assert WalkPairLkRec(rer, qm, code, inp, tb.t, gm, pc + 1, true);
      } else {
        assert b == BS.CannotExit && g == false;
        assert tb == LT.Mismatch;
      }
    case Aclose(_) =>   // pins SetRegisterToCP — not EndLoop
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtEndLoopCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtEndLoopCoreRec(rer, qm, code, inp, tb, gm, pc, b, na);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtEndLoopCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case Character(_) =>   // pins Consume — not EndLoop
      case Disjunction(_, _) =>   // pins Fork — not EndLoop
      case Group(_, _) =>   // pins SetRegisterToCP — not EndLoop
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not EndLoop
      case AnchorR(_) =>   // pins AnchorAssertion — not EndLoop
      case Backreference(_) =>   // NfaRepL false
  }

  lemma WalkPairLkAtEndLoopRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                            tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.EndLoop)
    ensures ea ==> tb.Progress? && WalkPairLkRec(rer, qm, code, inp, tb.t, gm, pc + 1, true)
    ensures !ea ==> tb == LT.Mismatch
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtEndLoopCoreRec(rer, qm, code, inp, tb, gm, pc, b, acts);
  }

  lemma WalkPairLkAtBeginLoopRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                              tb: LT.Tree, gmt: LG.GroupMap, pc: nat, ea: bool)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gmt, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
    ensures WalkPairLkRec(rer, qm, code, inp, tb, gmt, pc + 1, false)
  {
    forall acts: LS.Actions, b: BS.LoopBool
      ensures !(AR.ActionsRepL(rer, qm, acts, code, pc)
                && EL.PikeLkActionsRec(acts) && ATR.EaOf(b) == ea
                && EL.BoolTreeLk(rer, acts, inp, b, tb) && GateAheadClear(acts, gmt))
    {
      if AR.ActionsRepL(rer, qm, acts, code, pc) {
        TT.ActionsRepNotAtBeginLoop(rer, qm, acts, code, pc);   // ⇒ false
      }
    }
  }

  lemma WalkPairLkAtSetQuantCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                 tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                 acts: LS.Actions, q: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures q in qm.quants
    ensures tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
    ensures WalkPairLkRec(rer, qm, code, inp, tb.t,
                       LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not SetQuantToClock
    case Aclose(_) =>   // pins SetRegisterToCP — not SetQuantToClock
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtSetQuantCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, q);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtSetQuantCoreRec(rer, qm, code, inp, tb, gm, pc, b, na, q);
      case Quantified(greedy, min, delta, r1) =>
        assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
        assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
        if min > 0 {
          // THE forced-copy real head.
          var quant1 := L.Quantified(greedy, min - 1, delta, r1);
          var contActs := [LS.Areg(r1), LS.Areg(quant1)] + cont;
          var gidl := L.DefGroups(r1);
          assert tb.GroupActionT? && tb.g == LG.Reset(gidl)
                 && EL.BoolTreeLk(rer, contActs, inp, b, tb.t);
          // the qm.quants binding of THIS instruction's qid
          QuantHeadSQCPin(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
          var qid: int :| NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
            && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1);
          assert qid == q;
          assert q in qm.quants && qm.quants[q] == gidl;
          QuantForcedContRep(rer, qm, greedy, min, delta, r1, code, pc, pcmid, cont);   // ActionsRepL(contActs, pc+1)
          assert EL.PikeLkRegexRec(r1) && EL.PikeLkRegexRec(quant1);
          assert EL.PikeLkActionsRec(contActs) by {
            EL.PikeLkActionsRecConsIff(LS.Areg(quant1), cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(quant1)] + cont);
          }
          // gm moves by the Reset
          var gm2 := LG.GMUpdate(LG.Reset(gidl), LC.Idx(inp), gm);
          assert gm2 == LG.GMReset(gidl, gm);
          // GateAheadClear(contActs, gm2): fresh r1-pendings ⊆ the reset set;
          // cont's pendings carry (absent in gm, and Reset only removes keys)
          assert GateAheadClear(contActs, gm2) by {
            forall lk2: L.Lookaround, rr: L.Regex | GatePending(contActs, lk2, rr)
              ensures forall gg :: gg in L.DefGroups(rr) ==> gg !in gm2
            {
              var j :| 0 <= j < |contActs| && contActs[j].Areg? && RegexTopGate(contActs[j].r, lk2, rr);
              if j == 0 {
                assert contActs[0] == LS.Areg(r1) && RegexTopGate(r1, lk2, rr);
                RegexTopGateSubDefs(r1, lk2, rr);
                var SRR := set gx | gx in L.DefGroups(rr);
                var SR1 := set gx | gx in L.DefGroups(r1);
                assert SRR <= SR1;
                forall gg | gg in L.DefGroups(rr) ensures gg !in gm2 {
                  assert gg in SRR;
                  assert gg in SR1;
                  assert gg in L.DefGroups(r1);
                  assert gm2 == gm - (set gx | gx in gidl);
                  assert gg in (set gx | gx in gidl);
                }
              } else if j == 1 {
                assert !RegexTopGate(quant1, lk2, rr);   // Quantified: never pending
                assert false;
              } else {
                assert contActs[j] == cont[j - 2];
                assert GatePending(cont, lk2, rr) by {
                  assert cont[j - 2].Areg? && RegexTopGate(cont[j - 2].r, lk2, rr);
                }
                GatePendingTail(acts, lk2, rr);
                forall gg | gg in L.DefGroups(rr) ensures gg !in gm2 {
                  assert gg !in gm;   // GateAheadClear(acts, gm)
                }
              }
            }
          }
          // WalkDefsOk(contActs): the unfold brick (mid = [])
          WalkDefsOkUnfold(acts, r1, quant1, []);
          assert [LS.Areg(r1)] + [] + [LS.Areg(quant1)] + cont == contActs;
          // pack the existential at pc+1
          assert AR.ActionsRepL(rer, qm, contActs, code, pc + 1)
              && EL.PikeLkActionsRec(contActs)
              && ATR.EaOf(b) == g
              && EL.BoolTreeLk(rer, contActs, inp, b, tb.t)
              && GateAheadClear(contActs, gm2)
              && WalkDefsOk(contActs);
          assert WalkPairLkRec(rer, qm, code, inp, tb.t, gm2, pc + 1, g);
        } else if delta == LN.NN(0) {
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtSetQuantCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, q);
        } else {
          // min==0 with Inf or NN(kx>0): pins a Fork at pc, not SetQuantToClock.
          match delta
          case Inf =>
            if exists e1: nat ::
                 NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                 && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                        && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                 && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                 && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                 && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                 && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                 && pcmid == e1 + 2 {
              var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
            } else {
              var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
            }
          case NN(kx) =>
            var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                         && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
            NfaRepOptLHeadPin(rer, qm, kx, greedy, r1, code, em, pcmid);   // kx>0 ⇒ Fork at pc
        }
      case Character(_) =>   // pins Consume — not SetQuantToClock
      case Disjunction(_, _) =>   // pins Fork — not SetQuantToClock
      case Group(_, _) =>   // pins SetRegisterToCP — not SetQuantToClock
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not SetQuantToClock
      case AnchorR(_) =>   // pins AnchorAssertion — not SetQuantToClock
      case Backreference(_) =>   // NfaRepL false
  }

  lemma WalkPairLkAtSetQuantRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, q: int)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
    ensures q in qm.quants
    ensures tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
    ensures WalkPairLkRec(rer, qm, code, inp, tb.t,
                       LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea)
  {
    if (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActionsRec(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb)
          && GateAheadClear(acts, gm)
          && WalkDefsOk(acts)) {
      var acts: LS.Actions, b: BS.LoopBool :|
        AR.ActionsRepL(rer, qm, acts, code, pc)
        && EL.PikeLkActionsRec(acts)
        && ATR.EaOf(b) == ea
        && EL.BoolTreeLk(rer, acts, inp, b, tb)
        && GateAheadClear(acts, gm)
        && WalkDefsOk(acts);
      WalkPairLkAtSetQuantCoreRec(rer, qm, code, inp, tb, gm, pc, b, acts, q);
    } else {
      // the SQC see-through disjunct is the live one
      var q0: int :| NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q0, false))
        && q0 in qm.quants
        && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q0])
        && WalkPairLkRec(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea);
      assert q0 == q;
    }
  }

  lemma WalkPairLkAtForkCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                             acts: LS.Actions, x: int, y: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures x >= 0 && y >= 0
    // ERASURE-SHAPED (raw `Progress` guard wrappers can nest at a backfork):
    // dead, or the erased tree is a Choice whose arms have walking witnesses
    // at x/y — always at the OUTER flag (every Acheck peel preserves CanExit).
    ensures CE.ProgErase(tb) == LT.Mismatch
         || exists ta1: LT.Tree, ta2: LT.Tree ::
              CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
              && WalkPairLkRec(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
              && WalkPairLkRec(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(strcheck) =>
      // EndLoop != Fork ⟹ the BackForkAt disjunct: pcmid == pc.
      assert AR.BackForkAt(code, pc);
      assert x >= 0 && y >= 0;
      if b == BS.CanExit {
        assert tb.Progress? && EL.BoolTreeLk(rer, cont, inp, BS.CanExit, tb.t);
        assert AR.ActionsRepL(rer, qm, cont, code, pc);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        WalkPairLkAtForkCoreRec(rer, qm, code, inp, tb.t, gm, pc, BS.CanExit, cont, x, y);
        // the erased result lifts through the Progress wrapper verbatim
        assert CE.ProgErase(tb) == CE.ProgErase(tb.t);
        assert ATR.EaOf(BS.CanExit) == ATR.EaOf(b);
      } else {
        assert tb == LT.Mismatch;
      }
    case Aclose(_) =>   // pins SetRegisterToCP — not Fork
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtForkCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, x, y);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtForkCoreRec(rer, qm, code, inp, tb, gm, pc, b, na, x, y);
      case Disjunction(r1, r2) =>
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.Fork(pc + 1, e1 + 1))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid))
          && AR.NfaRepL(rer, qm, r2, code, e1 + 1, pcmid);
        assert x == pc + 1 && y == e1 + 1;
        assert tb.Choice?
            && EL.BoolTreeLk(rer, [LS.Areg(r1)] + cont, inp, b, tb.t1)
            && EL.BoolTreeLk(rer, [LS.Areg(r2)] + cont, inp, b, tb.t2);
        // arm reps: r1's tail rides the mid Jmp; r2's is direct
        assert AR.ActionsRepL(rer, qm, cont, code, e1);   // jump_bc via Jmp(pcmid)
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), cont, code, pc + 1, e1);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1 + 1, pcmid);
        assert EL.PikeLkActionsRec([LS.Areg(r1)] + cont) && EL.PikeLkActionsRec([LS.Areg(r2)] + cont) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
        }
        GateAheadClearDisjArm(acts, r1, r2, r1, gm);
        GateAheadClearDisjArm(acts, r1, r2, r2, gm);
        WalkDefsOkDisjArm(acts, r1, r2, r1);
        WalkDefsOkDisjArm(acts, r1, r2, r2);
        assert WalkPairLkRec(rer, qm, code, inp, tb.t1, gm, x as nat, g)
            && WalkPairLkRec(rer, qm, code, inp, tb.t2, gm, y as nat, g);
        assert CE.ProgErase(tb) == LT.Choice(CE.ProgErase(tb.t1), CE.ProgErase(tb.t2));
        assert exists ta1: LT.Tree, ta2: LT.Tree ::
          CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
          && WalkPairLkRec(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
          && WalkPairLkRec(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b)) by {
          assert WalkPairLkRec(rer, qm, code, inp, tb.t1, gm, x as nat, ATR.EaOf(b));
          assert WalkPairLkRec(rer, qm, code, inp, tb.t2, gm, y as nat, ATR.EaOf(b));
        }
      case Quantified(greedy, min, delta, r1) =>
        assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
        assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
        if min == 0 && delta == LN.NN(0) {
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtForkCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, x, y);
        } else if min > 0 {
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
          assert false;   // min>0 head pins SetQuantToClock, not Fork
        } else {
          // min == 0 with Inf or NN(kx>0): the star fork — tb is the Choice.
          var gidl := L.DefGroups(r1);
          var q' := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
          var itert := if greedy then tb.t1 else tb.t2;
          var skipt := if greedy then tb.t2 else tb.t1;
          assert tb.Choice?
              && itert.GroupActionT? && itert.g == LG.Reset(gidl)
              && EL.BoolTreeLk(rer, [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q')] + cont,
                               inp, BS.CannotExit, itert.t)
              && EL.BoolTreeLk(rer, cont, inp, b, skipt);
          var armlist := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q')] + cont;
          assert EL.PikeLkActionsRec(armlist) by {
            assert EL.PikeLkRegexRec(r1) && EL.PikeLkRegexRec(q');
            EL.PikeLkActionsRecConsIff(LS.Areg(q'), cont);
            EL.PikeLkActionsRecConsIff(LS.Acheck(inp), [LS.Areg(q')] + cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q')] + cont));
            assert [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q')] + cont)) == armlist;
          }
          StarArmInvariants(acts, r1, q', LS.Acheck(inp), gm, gidl);
          // skip arm invariants
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          match delta
          case Inf =>
            assert q' == L.Quantified(greedy, 0, LN.Inf, r1);
            if exists e1: nat ::
                 NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                 && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                        && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                 && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                 && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                 && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                 && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                 && pcmid == e1 + 2 {
              // ---- the LOOP BLOCK: SQC at pc+1, BeginLoop at pc+2 ----------
              var e1: nat :|
                 NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                 && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                        && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                 && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                 && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                 && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                 && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                 && pcmid == e1 + 2;
              var qid: int :| NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1);
              // armlist rep at pc+3: r1; Acheck at EndLoop; q'+cont via the back-jump
              assert AR.ActionsRepL(rer, qm, [LS.Areg(q')] + cont, code, pc) by {
                AR.ActionsRepLCons(rer, qm, LS.Areg(q'), cont, code, pc, pcmid);
              }
              assert AR.ActionsRepL(rer, qm, [LS.Areg(q')] + cont, code, e1 + 1);   // jump_bc
              assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1, e1 + 1);      // EndLoop
              AR.ActionsRepLCons(rer, qm, LS.Acheck(inp), [LS.Areg(q')] + cont, code, e1, e1 + 1);
              AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q')] + cont),
                                 code, pc + 3, e1);
              assert [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q')] + cont)) == armlist;
              assert AR.ActionsRepL(rer, qm, armlist, code, pc + 3);
              StarIterArmWalkBLRec(rer, qm, code, inp, gm, pc + 1, g, qid, r1, itert.t, armlist);
              assert WalkPairLkRec(rer, qm, code, inp, itert, gm, pc + 1, g);
              // skip arm at pcmid == e1+2
              assert WalkPairLkRec(rer, qm, code, inp, skipt, gm, pcmid, g);
              if greedy {
                assert x == pc + 1 && y == e1 + 2;
              } else {
                assert x == e1 + 2 && y == pc + 1;
              }
              assert WalkPairLkRec(rer, qm, code, inp, tb.t1, gm, x as nat, g)
                        && WalkPairLkRec(rer, qm, code, inp, tb.t2, gm, y as nat, g);
              assert CE.ProgErase(tb) == LT.Choice(CE.ProgErase(tb.t1), CE.ProgErase(tb.t2));
              assert exists ta1: LT.Tree, ta2: LT.Tree ::
                CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
                      && WalkPairLkRec(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
                      && WalkPairLkRec(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b)) by {
                assert WalkPairLkRec(rer, qm, code, inp, tb.t1, gm, x as nat, ATR.EaOf(b));
                assert WalkPairLkRec(rer, qm, code, inp, tb.t2, gm, y as nat, ATR.EaOf(b));
              }

            } else {
              // ---- the LOOP VIEW: SQC at em (backward), body directly after
              assert NUL.NonNullableL(r1);
              var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em))
                && em <= pc
                && (exists qid: int :: NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                                       && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                && AR.NfaRepL(rer, qm, r1, code, em + 1, pc)
                && pcmid == pc + 1;
              var qid: int :| NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1);
              // armlist rep at em+1: r1 to pc; Acheck dissolves at the back fork; q'+cont at pc
              assert AR.ActionsRepL(rer, qm, [LS.Areg(q')] + cont, code, pc) by {
                AR.ActionsRepLCons(rer, qm, LS.Areg(q'), cont, code, pc, pcmid);
              }
              assert AR.BackForkAt(code, pc);
              assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, pc, pc);
              AR.ActionsRepLCons(rer, qm, LS.Acheck(inp), [LS.Areg(q')] + cont, code, pc, pc);
              AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q')] + cont),
                                 code, em + 1, pc);
              assert [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q')] + cont)) == armlist;
              assert AR.ActionsRepL(rer, qm, armlist, code, em + 1);
              assert armlist == [LS.Areg(r1)] + ([LS.Acheck(inp), LS.Areg(q')] + cont);
              StarIterArmWalkLVRec(rer, qm, code, inp, gm, em, g, qid, r1, itert.t,
                                [LS.Acheck(inp), LS.Areg(q')] + cont);
              assert WalkPairLkRec(rer, qm, code, inp, itert, gm, em, g);
              assert WalkPairLkRec(rer, qm, code, inp, skipt, gm, pc + 1, g);
              if greedy {
                assert x == em && y == pc + 1;
              } else {
                assert x == pc + 1 && y == em;
              }
              assert WalkPairLkRec(rer, qm, code, inp, tb.t1, gm, x as nat, g)
                        && WalkPairLkRec(rer, qm, code, inp, tb.t2, gm, y as nat, g);
              assert CE.ProgErase(tb) == LT.Choice(CE.ProgErase(tb.t1), CE.ProgErase(tb.t2));
              assert exists ta1: LT.Tree, ta2: LT.Tree ::
                CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
                      && WalkPairLkRec(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
                      && WalkPairLkRec(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b)) by {
                assert WalkPairLkRec(rer, qm, code, inp, tb.t1, gm, x as nat, ATR.EaOf(b));
                assert WalkPairLkRec(rer, qm, code, inp, tb.t2, gm, y as nat, ATR.EaOf(b));
              }

            }
          case NN(kx) =>
            assert kx > 0;
            assert q' == L.Quantified(greedy, 0, LN.NN(kx - 1), r1);
            var em0: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em0)
                         && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em0, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em0);
            assert em0 == pc;
            var e1x: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, pcmid) else RB.Fork(pcmid, pc + 1))
              && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                     && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
              && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
              && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1x)
              && NR.GetPcRE(code, e1x) == Some(RB.EndLoop)
              && AR.NfaRepOptL(rer, qm, kx - 1, greedy, r1, code, e1x + 1, pcmid);
            var qid: int :| NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
              && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1);
            // q' at e1x+1: zero forced copies + the kx-1 optional layers
            assert AR.NfaRepL(rer, qm, q', code, e1x + 1, pcmid) by {
              assert AR.NfaRepMinL(rer, qm, 0, r1, code, e1x + 1, e1x + 1);
            }
            AR.ActionsRepLCons(rer, qm, LS.Areg(q'), cont, code, e1x + 1, pcmid);
            assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1x, e1x + 1);   // EndLoop
            AR.ActionsRepLCons(rer, qm, LS.Acheck(inp), [LS.Areg(q')] + cont, code, e1x, e1x + 1);
            AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q')] + cont),
                               code, pc + 3, e1x);
            assert [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q')] + cont)) == armlist;
            assert AR.ActionsRepL(rer, qm, armlist, code, pc + 3);
            StarIterArmWalkBLRec(rer, qm, code, inp, gm, pc + 1, g, qid, r1, itert.t, armlist);
            assert WalkPairLkRec(rer, qm, code, inp, itert, gm, pc + 1, g);
            assert WalkPairLkRec(rer, qm, code, inp, skipt, gm, pcmid, g);
            if greedy {
              assert x == pc + 1 && y == pcmid;
            } else {
              assert x == pcmid && y == pc + 1;
            }
            assert WalkPairLkRec(rer, qm, code, inp, tb.t1, gm, x as nat, g)
                    && WalkPairLkRec(rer, qm, code, inp, tb.t2, gm, y as nat, g);
            assert CE.ProgErase(tb) == LT.Choice(CE.ProgErase(tb.t1), CE.ProgErase(tb.t2));
            assert exists ta1: LT.Tree, ta2: LT.Tree ::
              CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
                  && WalkPairLkRec(rer, qm, code, inp, ta1, gm, x as nat, ATR.EaOf(b))
                  && WalkPairLkRec(rer, qm, code, inp, ta2, gm, y as nat, ATR.EaOf(b)) by {
              assert WalkPairLkRec(rer, qm, code, inp, tb.t1, gm, x as nat, ATR.EaOf(b));
              assert WalkPairLkRec(rer, qm, code, inp, tb.t2, gm, y as nat, ATR.EaOf(b));
            }

        }
      case Character(_) =>   // pins Consume — not Fork
      case Group(_, _) =>   // pins SetRegisterToCP — not Fork
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Fork
      case AnchorR(_) =>   // pins AnchorAssertion — not Fork
      case Backreference(_) =>   // NfaRepL false
  }

  lemma WalkPairLkAtForkArmsRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                             tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, x: int, y: int)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    ensures x >= 0 && y >= 0
    ensures CE.ProgErase(tb) == LT.Mismatch
         || exists ta1: LT.Tree, ta2: LT.Tree ::
              CE.ProgErase(tb) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
              && WalkPairLkRec(rer, qm, code, inp, ta1, gm, x as nat, ea)
              && WalkPairLkRec(rer, qm, code, inp, ta2, gm, y as nat, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtForkCoreRec(rer, qm, code, inp, tb, gm, pc, b, acts, x, y);
  }

  lemma WalkPairLkAtForkRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, x: int, y: int)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    ensures x >= 0 && y >= 0
    ensures tb.Choice? || tb.Progress? || tb == LT.Mismatch
  {
    WalkPairLkImpliesTtLkRec(rer, qm, code, inp, tb, gm, pc, ea);
    TtLkAtForkRec(rer, qm, code, inp, tb, pc, ea, x, y);
  }

  lemma WalkPairLkAtCheckOracleCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                    tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                                    acts: LS.Actions, lid: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    requires LL.OracleOkAt(rer, qm, inp)
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      (LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
         tb.LK? && tb.lk == lk
         && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, true)
         && LS.LkResult(lk, tb.tlk, gm, inp).Some?
         && WalkPairLkRec(rer, qm, code, inp, tb.t, LS.LkResult(lk, tb.tlk, gm, inp).value,
                       pc + 1, ATR.EaOf(b)))
      && (!LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
            tb.LKFail? && tb.lk == lk
            && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, false))
    // the gate's OWN GateAheadClear instance: it is pending at the real head,
    // so its body groups are absent from the accumulated map (discharges
    // `ThreadRepLkStepCheckOracle`'s absence hypothesis)
    ensures forall gg :: gg in L.DefGroups(qm.looks[lid].1) ==> gg !in gm
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not CheckOracle
    case Aclose(_) =>   // pins SetRegisterToCP — not CheckOracle
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtCheckOracleCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, lid);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        // NoDupSeq(AllDefsActs(na)) == NoDupSeq(AllDefsActs(acts)) (same sequence).
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtCheckOracleCoreRec(rer, qm, code, inp, tb, gm, pc, b, na, lid);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtCheckOracleCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, lid);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case LookaroundR(lk0, r1) =>
        var lid0: int :| NR.GetPcRE(code, pc) == Some(if AR.PositiveL(lk0) then RB.CheckOracle(lid0)
                                                                           else RB.NegCheckOracle(lid0))
          && lid0 in qm.looks && qm.looks[lid0] == (lk0, r1) && pcmid == pc + 1;
        assert AR.PositiveL(lk0) && lid0 == lid;
        assert L.Positivity(lk0);
        assert lid in qm.looks && qm.looks[lid] == (lk0, r1);
        // the gate is pending at index 0 ⟹ its body groups are clear NOW
        assert RegexTopGate(L.LookaroundR(lk0, r1), lk0, r1);
        assert GatePending(acts, lk0, r1) by {
          assert acts[0].Areg? && RegexTopGate(acts[0].r, lk0, r1);
        }
        assert forall gg :: gg in L.DefGroups(r1) ==> gg !in gm;
        M.GateNodeAtInp(rer, acts, inp, b, tb, lk0, r1);   // tb is LK/LKFail with LkGateOk
        var bit := LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid);
        if tb.LK? {
          assert EL.LkGateOk(rer, lk0, r1, inp, tb.tlk, true);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          assert bit;
          // ---- gate-frame facts for LkResultAgreeOutsideNested ----
          assert r0 == L.LookaroundR(lk0, r1);
          assert EL.PikeLkRegexRec(r1);                                     // NoLkBrL(r1)
          assert LS.LkResult(lk0, tb.tlk, LG.Empty, inp).Some?;       // LkGateOk true
          EL.LkResultGmIndep(lk0, tb.tlk, gm, inp);
          assert LS.LkResult(lk0, tb.tlk, gm, inp).Some?;
          var gm2 := LS.LkResult(lk0, tb.tlk, gm, inp).value;
          assert tb.tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk0));   // LkGateOk
          LkResultAgreeOutsideNested(rer, lk0, r1, inp, tb.tlk, gm);        // GmAgreeOutside(gm2, gm, Sr1)
          var Sr1 := set gx | gx in L.DefGroups(r1);
          // AfterMerge req (2): gm2 keys ⊆ gm ∪ DefGroups(r1).
          assert forall gg :: gg in gm2 ==> gg in gm || gg in L.DefGroups(r1) by {
            forall gg | gg in gm2 ensures gg in gm || gg in L.DefGroups(r1) {
              if gg !in Sr1 { assert gg in gm2 <==> gg in gm; assert gg in gm; }
              else { assert gg in L.DefGroups(r1); }
            }
          }
          // AfterMerge req (3): pending-in-cont ⟹ pending-in-acts.
          assert forall lk2: L.Lookaround, r2: L.Regex :: GatePending(cont, lk2, r2) ==> GatePending(acts, lk2, r2) by {
            forall lk2: L.Lookaround, r2: L.Regex | GatePending(cont, lk2, r2)
              ensures GatePending(acts, lk2, r2)
            { GatePendingTail(acts, lk2, r2); }
          }
          // AfterMerge req (4): every other pending gate's body disjoint from
          // DefGroups(r1) — from C1 (TopLk NoDup): the head gate contributes
          // DefGroups(r1) as a block, pending bodies in cont sit inside
          // TopLkDefsListActs(cont) (RegexTopGateSubTopLk).
          TopLkDefsListActsCons(acts[0], cont);
          assert TopLkDefsList(L.LookaroundR(lk0, r1)) == L.DefGroups(r1);
          assert TopLkDefsListActs(acts) == L.DefGroups(r1) + TopLkDefsListActs(cont);
          M.NoDupConcat(L.DefGroups(r1), TopLkDefsListActs(cont));
          assert forall lk2: L.Lookaround, r2: L.Regex :: GatePending(cont, lk2, r2) ==>
                   (forall gg :: gg in L.DefGroups(r2) ==> gg !in L.DefGroups(r1)) by {
            forall lk2: L.Lookaround, r2: L.Regex | GatePending(cont, lk2, r2)
              ensures forall gg :: gg in L.DefGroups(r2) ==> gg !in L.DefGroups(r1)
            {
              var j :| 0 <= j < |cont| && cont[j].Areg? && RegexTopGate(cont[j].r, lk2, r2);
              RegexTopGateSubTopLk(cont[j].r, lk2, r2);     // set(DefGroups r2) ⊆ set(TopLk cont[j].r)
              TopLkDefsListMemberSub(cont, j);              // set(TopLk cont[j].r) ⊆ set(TopLkActs cont)
              var SR2 := set gx | gx in L.DefGroups(r2);
              var SCJ := set gx | gx in TopLkDefsList(cont[j].r);
              var SAC := set gx | gx in TopLkDefsListActs(cont);
              var SR1 := set gx | gx in L.DefGroups(r1);
              assert SR2 <= SCJ && SCJ <= SAC;              // the two lemma subsets (named-set form)
              assert SR1 * SAC == {};                       // NoDupConcat disjointness
              forall gg | gg in L.DefGroups(r2) ensures gg !in L.DefGroups(r1) {
                assert gg in SR2;
                assert gg in SAC;                           // via SR2 ⊆ SCJ ⊆ SAC
                if gg in L.DefGroups(r1) {                   // contradiction: SR1 ∩ SAC == {}
                  assert gg in SR1 && gg in SAC;
                  assert gg in SR1 * SAC;
                  assert false;
                }
              }
            }
          }
          GateAheadClearAfterMerge(acts, cont, gm, gm2, lk0, r1);   // GateAheadClear(cont, gm2)
          // Assemble WalkPairLkRec(tb.t, gm2, pc+1, g) via the existential disjunct.
          assert EL.PikeLkActionsRec(cont);
          WalkDefsOkTail(acts);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1)
              && EL.PikeLkActionsRec(cont)
              && ATR.EaOf(b) == g
              && EL.BoolTreeLk(rer, cont, inp, b, tb.t)
              && GateAheadClear(cont, gm2)
              && WalkDefsOk(cont);
          assert WalkPairLkRec(rer, qm, code, inp, tb.t, gm2, pc + 1, g);
        } else {
          assert tb.LKFail?;   // GateNodeAtInp: only LK or LKFail
          assert !bit;
        }
      case Character(_) =>   // pins Consume — not CheckOracle
      case Disjunction(_, _) =>   // pins Fork — not CheckOracle
      case Group(_, _) =>   // pins SetRegisterToCP — not CheckOracle
      case AnchorR(_) =>   // pins AnchorAssertion — not CheckOracle
      case Backreference(_) =>   // NfaRepL false
  }

  lemma WalkPairLkAtCheckOracleRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                                tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, lid: int)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    requires LL.OracleOkAt(rer, qm, inp)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      (LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
         tb.LK? && tb.lk == lk
         && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, true)
         && LS.LkResult(lk, tb.tlk, gm, inp).Some?
         && WalkPairLkRec(rer, qm, code, inp, tb.t, LS.LkResult(lk, tb.tlk, gm, inp).value, pc + 1, ea))
      && (!LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
            tb.LKFail? && tb.lk == lk
            && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, false))
    ensures forall gg :: gg in L.DefGroups(qm.looks[lid].1) ==> gg !in gm
  {
    // GetPcRE==CheckOracle ≠ BeginLoop kills the stutter disjunct; extract the walk.
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtCheckOracleCoreRec(rer, qm, code, inp, tb, gm, pc, b, acts, lid);
  }

  lemma WalkPairLkAtAnchorCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                               tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                               acts: LS.Actions, a: R.anchor)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures tb.AnchorPass? || tb == LT.Mismatch
    ensures tb.AnchorPass? ==> WalkPairLkRec(rer, qm, code, inp, tb.t, gm, pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not AnchorAssertion
    case Aclose(_) =>   // pins SetRegisterToCP — not AnchorAssertion
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtAnchorCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, a);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtAnchorCoreRec(rer, qm, code, inp, tb, gm, pc, b, na, a);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtAnchorCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, a);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case AnchorR(la) =>
        var a2: R.anchor :| NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a2)) && T.TrAnchor(a2) == la;
        assert pcmid == pc + 1;
        if LS.AnchorSatisfied(rer, la, inp) {
          assert tb.AnchorPass? && EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          // gm UNCHANGED across AnchorPass ⟹ tail bricks give the continuation clear.
          GateAheadClearTail(acts, gm);       // GateAheadClear(cont, gm)
          WalkDefsOkTail(acts);             // NoDupSeq(AllDefsActs(cont))
          assert EL.PikeLkActionsRec(cont);
          assert WalkPairLkRec(rer, qm, code, inp, tb.t, gm, pc + 1, g);
        } else {
          assert tb == LT.Mismatch;
        }
      case Character(_) =>   // pins Consume — not AnchorAssertion
      case Disjunction(_, _) =>   // pins Fork — not AnchorAssertion
      case Group(_, _) =>   // pins SetRegisterToCP — not AnchorAssertion
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not AnchorAssertion
      case Backreference(_) =>   // NfaRepL false
  }

  lemma WalkPairLkAtAnchorRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                           tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, a: R.anchor)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
    ensures tb.AnchorPass? || tb == LT.Mismatch
    ensures tb.AnchorPass? ==> WalkPairLkRec(rer, qm, code, inp, tb.t, gm, pc + 1, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtAnchorCoreRec(rer, qm, code, inp, tb, gm, pc, b, acts, a);
  }

  lemma WalkPairLkAtSetRegCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                               tb: LT.Tree, gm: LG.GroupMap, pc: nat, b: BS.LoopBool,
                               acts: LS.Actions, r: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(r))
    requires GateAheadClear(acts, gm)
    requires WalkDefsOk(acts)
    ensures tb.GroupActionT?
    ensures (tb.g.Open? && r == CP.start_reg(tb.g.g as int))
         || (tb.g.Close? && r == CP.end_reg(tb.g.g as int))
    ensures WalkPairLkRec(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not SetRegisterToCP
    case Aclose(gid) =>
      assert pcmid == pc + 1 && r == CP.end_reg(gid as int);
      assert tb.GroupActionT? && tb.g == LG.Close(gid) && EL.BoolTreeLk(rer, cont, inp, b, tb.t);
      assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
      var gm2 := LG.GMUpdate(LG.Close(gid), LC.Idx(inp), gm);
      assert gm2 == LG.GMClose(LC.Idx(inp), gid, gm);
      GateAheadClearTail(acts, gm);
      GateAheadClearMono(cont, gm, gm2);   // GMClose keeps the domain
      WalkDefsOkTail(acts);
      assert EL.PikeLkActionsRec(cont);
      assert WalkPairLkRec(rer, qm, code, inp, tb.t, gm2, pc + 1, g);
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        GateAheadClearTail(acts, gm);
        WalkDefsOkTail(acts);
        WalkPairLkAtSetRegCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, r);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        GateAheadClearSeqExpand(acts, r1, r2, gm);
        M.AllDefsActsCons(acts[0], cont);
        M.AllDefsActsCons(LS.Areg(r1), [LS.Areg(r2)] + cont);
        M.AllDefsActsCons(LS.Areg(r2), cont);
        assert L.DefGroups(L.Sequence(r1, r2)) == L.DefGroups(r1) + L.DefGroups(r2);
        assert L.DefGroups(r1) + (L.DefGroups(r2) + M.AllDefsActs(cont))
            == (L.DefGroups(r1) + L.DefGroups(r2)) + M.AllDefsActs(cont);
        assert M.AllDefsActs(na) == M.AllDefsActs(acts);
        WalkDefsOkSeqExpand(acts, r1, r2);
        WalkPairLkAtSetRegCoreRec(rer, qm, code, inp, tb, gm, pc, b, na, r);
      case Group(gid, r1) =>
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(gid as int)))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(gid as int)))
          && pcmid == e1 + 1;
        assert r == CP.start_reg(gid as int);
        var ga := [LS.Areg(r1), LS.Aclose(gid)] + cont;
        assert ga == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Aclose(gid), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Aclose(gid)] + cont, code, pc + 1, e1);
        assert AR.ActionsRepL(rer, qm, ga, code, pc + 1);
        assert tb.GroupActionT? && tb.g == LG.Open(gid) && EL.BoolTreeLk(rer, ga, inp, b, tb.t);
        assert EL.PikeLkActionsRec(ga) by {
          EL.PikeLkActionsRecConsIff(LS.Aclose(gid), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Aclose(gid)] + cont);
        }
        var gm2 := LG.GMUpdate(LG.Open(gid), LC.Idx(inp), gm);
        // carrier across the Group expand; C1 pins gid ∉ TopLk of both parts
        WalkDefsOkGroupExpand(acts, gid, r1);
        TopLkDefsListActsCons(acts[0], cont);
        TopLkDefsListActsCons(LS.Areg(r1), [LS.Aclose(gid)] + cont);
        TopLkDefsListActsCons(LS.Aclose(gid), cont);
        assert TopLkDefsList(L.Group(gid, r1)) == [gid] + TopLkDefsList(r1);
        assert TopLkDefsListActs(acts)
            == ([gid] + TopLkDefsList(r1)) + TopLkDefsListActs(cont);
        assert ([gid] + TopLkDefsList(r1)) + TopLkDefsListActs(cont)
            == [gid] + (TopLkDefsList(r1) + TopLkDefsListActs(cont));
        M.NoDupConcat([gid], TopLkDefsList(r1) + TopLkDefsListActs(cont));
        assert TopLkDefsListActs(ga) == TopLkDefsList(r1) + TopLkDefsListActs(cont);
        // GateAheadClear(ga, gm): pending-in-ga ⟹ pending-in-acts.
        assert forall lk2: L.Lookaround, rr: L.Regex :: GatePending(ga, lk2, rr) ==> GatePending(acts, lk2, rr) by {
          forall lk2: L.Lookaround, rr: L.Regex | GatePending(ga, lk2, rr) ensures GatePending(acts, lk2, rr) {
            GatePendingGroupBack(acts, gid, r1, lk2, rr);
          }
        }
        assert GateAheadClear(ga, gm) by {
          forall lk2: L.Lookaround, rr: L.Regex | GatePending(ga, lk2, rr)
            ensures forall gg :: gg in L.DefGroups(rr) ==> gg !in gm
          { GatePendingGroupBack(acts, gid, r1, lk2, rr); }
        }
        // gid ∉ every pending body of ga (via C1: gid ∉ TopLkDefsListActs(ga) ⊇ DefGroups(rr)).
        assert forall lk2: L.Lookaround, rr: L.Regex :: GatePending(ga, lk2, rr) ==> gid !in L.DefGroups(rr) by {
          forall lk2: L.Lookaround, rr: L.Regex | GatePending(ga, lk2, rr) ensures gid !in L.DefGroups(rr) {
            var j :| 0 <= j < |ga| && ga[j].Areg? && RegexTopGate(ga[j].r, lk2, rr);
            RegexTopGateSubTopLk(ga[j].r, lk2, rr);
            TopLkDefsListMemberSub(ga, j);
            var SRR := set gx | gx in L.DefGroups(rr);
            var SGJ := set gx | gx in TopLkDefsList(ga[j].r);
            var SAG := set gx | gx in TopLkDefsListActs(ga);
            assert SRR <= SGJ && SGJ <= SAG;   // the two lemma subsets (named-set form)
            assert (set gx | gx in [gid]) * SAG == {};   // NoDupConcat disjointness
            if gid in L.DefGroups(rr) {
              assert gid in SRR && gid in SAG;           // via SRR ⊆ SGJ ⊆ SAG
              assert gid in (set gx | gx in [gid]);
              assert gid in (set gx | gx in [gid]) * SAG;   // contradicts disjoint
            }
          }
        }
        GateAheadClearAfterOpen(ga, gm, gid, LC.Idx(inp));   // GateAheadClear(ga, gm2)
        assert WalkPairLkRec(rer, qm, code, inp, tb.t, gm2, pc + 1, g);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          GateAheadClearTail(acts, gm);
          WalkDefsOkTail(acts);
          WalkPairLkAtSetRegCoreRec(rer, qm, code, inp, tb, gm, pc, b, cont, r);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case Character(_) =>   // pins Consume — not SetRegisterToCP
      case Disjunction(_, _) =>   // pins Fork — not SetRegisterToCP
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not SetRegisterToCP
      case AnchorR(_) =>   // pins AnchorAssertion — not SetRegisterToCP
      case Backreference(_) =>   // NfaRepL false
  }

  lemma WalkPairLkAtSetRegRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                           tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool, r: int)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(r))
    ensures tb.GroupActionT?
    ensures (tb.g.Open? && r == CP.start_reg(tb.g.g as int))
         || (tb.g.Close? && r == CP.end_reg(tb.g.g as int))
    ensures WalkPairLkRec(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb)
      && GateAheadClear(acts, gm)
      && WalkDefsOk(acts);
    WalkPairLkAtSetRegCoreRec(rer, qm, code, inp, tb, gm, pc, b, acts, r);
  }

  lemma WalkPairLkAtAcceptRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                           tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Accept)
    ensures tb == LT.Match
  {
    WalkPairLkImpliesTtLkRec(rer, qm, code, inp, tb, gm, pc, ea);
    TtLkAtAcceptRec(rer, qm, code, inp, tb, pc, ea);
  }

  lemma WalkPairLkImpliesTtLkRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                              tb: LT.Tree, gm: LG.GroupMap, pc: nat, ea: bool)
    requires WalkPairLkRec(rer, qm, code, inp, tb, gm, pc, ea)
    ensures TtLkRec(rer, qm, code, inp, tb, pc, ea)
    decreases RB.size(code) - pc
  {
    if (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc) && EL.PikeLkActionsRec(acts) && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb) && GateAheadClear(acts, gm)
          && WalkDefsOk(acts)) {
      // the existential disjunct: the same (acts, b) satisfy TtLkRec's exists.
      var acts: LS.Actions, b: BS.LoopBool :|
        AR.ActionsRepL(rer, qm, acts, code, pc) && EL.PikeLkActionsRec(acts) && ATR.EaOf(b) == ea
        && EL.BoolTreeLk(rer, acts, inp, b, tb) && GateAheadClear(acts, gm)
        && WalkDefsOk(acts);
    } else if pc < RB.size(code) && NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
              && WalkPairLkRec(rer, qm, code, inp, tb, gm, pc + 1, false) {
      // the BeginLoop stutter disjunct; recurse at pc+1.
      WalkPairLkImpliesTtLkRec(rer, qm, code, inp, tb, gm, pc + 1, false);
    } else {
      // the SQC see-through disjunct: recurse on the child, re-pack TtLkRec's.
      var q: int :| NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
        && q in qm.quants
        && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q])
        && WalkPairLkRec(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea);
      WalkPairLkImpliesTtLkRec(rer, qm, code, inp, tb.t, LG.GMUpdate(tb.g, LC.Idx(inp), gm), pc + 1, ea);
      assert TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ea);
    }
  }

  lemma TtLkAtJmpRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                  tb: LT.Tree, pc: nat, ea: bool, x: int)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Jmp(x))
    ensures x >= 0 && TtLkRec(rer, qm, code, inp, tb, x as nat, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    ActionsRepLThruJmp(rer, qm, acts, code, pc, x);   // x >= 0 && ActionsRepL(acts, code, x)
    // same (acts, b) witness TtLkRec at x — only the pc moved
  }

  lemma TtLkAtBeginLoopRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                        tb: LT.Tree, pc: nat, ea: bool)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.BeginLoop)
    ensures TtLkRec(rer, qm, code, inp, tb, pc + 1, false)
  {
    // The ActionsRepL disjunct is unsatisfiable at a BeginLoop pc.
    forall acts: LS.Actions, b: BS.LoopBool
      ensures !(AR.ActionsRepL(rer, qm, acts, code, pc)
                && EL.PikeLkActionsRec(acts) && ATR.EaOf(b) == ea
                && EL.BoolTreeLk(rer, acts, inp, b, tb))
    {
      if AR.ActionsRepL(rer, qm, acts, code, pc) {
        TT.ActionsRepNotAtBeginLoop(rer, qm, acts, code, pc);   // ⇒ false
      }
    }
    // So TtLkRec(pc) holds via the BeginLoop stutter, whose payload is TtLkRec(pc+1, false).
  }

  lemma TtLkAtAcceptCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Accept)
    ensures tb == LT.Match
    decreases ATR.MsizeA(acts)
  {
    if |acts| == 0 {
      // BoolTreeLk([], inp, b, tb) ⟹ tb == Match
    } else if exists pcmid: nat :: AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid) {
      var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
      EL.PikeLkActionsRecTail(acts);
      assert acts == [acts[0]] + acts[1..];
      EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
      var cont := acts[1..];
      match acts[0]
      case Acheck(_) =>   // pins EndLoop or a backward Fork — not Accept
      case Aclose(_) =>   // pins SetRegisterToCP — not Accept
      case Areg(r) =>
        assert EL.PikeLkRegexRec(r);
        match r
        case Epsilon =>
          assert pcmid == pc;
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtAcceptCoreRec(rer, qm, code, inp, tb, pc, b, cont);
        case Sequence(r1, r2) =>
          assert acts[0] == LS.Areg(L.Sequence(r1, r2));
          assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);   // == ActionRepL(acts[0],..)
          var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
          var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
          assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
          AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
          AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
          assert AR.ActionsRepL(rer, qm, na, code, pc);
          assert EL.PikeLkActionsRec(na) by {
            EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
          }
          assert EL.BoolTreeLk(rer, na, inp, b, tb);
          assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
          assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
          assert ATR.MsizeA(na) < ATR.MsizeA(acts);
          TtLkAtAcceptCoreRec(rer, qm, code, inp, tb, pc, b, na);
        case Quantified(greedy, min, delta, r1) =>
          // At an Accept pc the only transparent quantifier is a spent {0}
          // (min==0, delta==NN(0)); every other shape pins Fork/SetQuantToClock.
          if min == 0 && delta == LN.NN(0) {
            assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
            assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
            var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                         && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);              // em == pc
            NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);   // pcmid == em
            assert pcmid == pc;
            assert AR.ActionsRepL(rer, qm, cont, code, pc);
            assert EL.BoolTreeLk(rer, cont, inp, b, tb);   // Quantified NN(0) skip case
            assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
            TtLkAtAcceptCoreRec(rer, qm, code, inp, tb, pc, b, cont);
          } else {
            QuantHeadPinsNonAccept(rer, qm, greedy, min, delta, r1, code, pc, pcmid);   // ⇒ false
          }
        case Character(_) =>   // pins Consume — not Accept
        case Disjunction(_, _) =>   // pins Fork — not Accept
        case Group(_, _) =>   // pins SetRegisterToCP — not Accept
        case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Accept
        case AnchorR(_) =>   // pins AnchorAssertion — not Accept
        case Backreference(_) =>   // NfaRepL false
    } else {
      var pcstart: nat :| NR.GetPcRE(code, pc) == Some(RB.Jmp(pcstart)) && AR.ActionsRepL(rer, qm, acts, code, pcstart);
      // Jmp != Accept: contradiction
    }
  }

  lemma TtLkAtAcceptRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                     tb: LT.Tree, pc: nat, ea: bool)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Accept)
    ensures tb == LT.Match
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtAcceptCoreRec(rer, qm, code, inp, tb, pc, b, acts);
  }

  lemma TtLkAtConsumeCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, ce: RC.char_expectation)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    ensures tb.Read? || tb == LT.Mismatch
    ensures tb.Read? ==> exists nextinp ::
      AR.ReadCharE(ce, inp) == Some((tb.c, nextinp))
      && TtLkRec(rer, qm, code, nextinp, tb.t, pc + 1, true)
    ensures tb == LT.Mismatch ==> AR.ReadCharE(ce, inp) == None
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    // empty_bc needs Accept, jump_bc needs Jmp — neither is Consume, so cons_bc.
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not Consume
    case Aclose(_) =>   // pins SetRegisterToCP — not Consume
    case Areg(r) =>
      assert EL.PikeLkRegexRec(r);
      match r
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtConsumeCoreRec(rer, qm, code, inp, tb, pc, b, cont, ce);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtConsumeCoreRec(rer, qm, code, inp, tb, pc, b, na, ce);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtConsumeCoreRec(rer, qm, code, inp, tb, pc, b, cont, ce);
        } else {
          QuantHeadPinsNonConsume(rer, qm, greedy, min, delta, r1, code, pc, pcmid, ce);
        }
      case Character(cd) =>
        assert acts[0] == LS.Areg(L.Character(cd));
        var ce2 :| NR.GetPcRE(code, pc) == Some(RB.Consume(ce2)) && AR.ExpectationMatches(rer, ce2, cd);
        assert ce2 == ce && pcmid == pc + 1;
        AR.ReadAgree(rer, ce, cd, inp);   // ReadCharE(ce, inp) == ReadChar(rer, cd, inp, Forward)
        match LC.ReadChar(rer, cd, inp, WP.Forward) {
          case None =>
            assert tb == LT.Mismatch;
          case Some(pair) =>
            assert tb.Read? && tb.c == pair.0 && EL.BoolTreeLk(rer, cont, pair.1, BS.CanExit, tb.t);
            assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
            assert TtLkRec(rer, qm, code, pair.1, tb.t, pc + 1, true) by {
              assert ATR.EaOf(BS.CanExit) == true;
            }
            assert AR.ReadCharE(ce, inp) == Some((tb.c, pair.1));
        }
      case Disjunction(_, _) =>   // pins Fork — not Consume
      case Group(_, _) =>   // pins SetRegisterToCP — not Consume
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Consume
      case AnchorR(_) =>   // pins AnchorAssertion — not Consume
      case Backreference(_) =>   // NfaRepL false
  }

  lemma TtLkAtConsumeRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                      tb: LT.Tree, pc: nat, ea: bool, ce: RC.char_expectation)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Consume(ce))
    ensures tb.Read? || tb == LT.Mismatch
    ensures tb.Read? ==> exists nextinp ::
      AR.ReadCharE(ce, inp) == Some((tb.c, nextinp))
      && TtLkRec(rer, qm, code, nextinp, tb.t, pc + 1, true)
    ensures tb == LT.Mismatch ==> AR.ReadCharE(ce, inp) == None
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtConsumeCoreRec(rer, qm, code, inp, tb, pc, b, acts, ce);
  }

  lemma TtLkAtSetRegCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, r: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(r))
    ensures tb.GroupActionT?
    ensures (tb.g.Open? && r == CP.start_reg(tb.g.g as int))
         || (tb.g.Close? && r == CP.end_reg(tb.g.g as int))
    ensures TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not SetRegisterToCP
    case Aclose(gid) =>
      // ActionRepL(Aclose(gid)) pins SetRegisterToCP(end_reg(gid)), pcmid == pc+1
      assert pcmid == pc + 1 && r == CP.end_reg(gid as int);
      assert tb.GroupActionT? && tb.g == LG.Close(gid) && EL.BoolTreeLk(rer, cont, inp, b, tb.t);
      assert TtLkRec(rer, qm, code, inp, tb.t, pc + 1, g);
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtSetRegCoreRec(rer, qm, code, inp, tb, pc, b, cont, r);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtSetRegCoreRec(rer, qm, code, inp, tb, pc, b, na, r);
      case Group(gid, r1) =>
        // ActionRepL(Areg(Group)) pins SetRegisterToCP(start_reg(gid))
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(gid as int)))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(gid as int)))
          && pcmid == e1 + 1;
        assert r == CP.start_reg(gid as int);
        var ga := [LS.Areg(r1), LS.Aclose(gid)] + cont;
        assert ga == [LS.Areg(r1)] + ([LS.Aclose(gid)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Aclose(gid), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Aclose(gid)] + cont, code, pc + 1, e1);
        assert AR.ActionsRepL(rer, qm, ga, code, pc + 1);
        assert tb.GroupActionT? && tb.g == LG.Open(gid) && EL.BoolTreeLk(rer, ga, inp, b, tb.t);
        assert EL.PikeLkActionsRec(ga) by {
          EL.PikeLkActionsRecConsIff(LS.Aclose(gid), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Aclose(gid)] + cont);
        }
        assert TtLkRec(rer, qm, code, inp, tb.t, pc + 1, g);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtSetRegCoreRec(rer, qm, code, inp, tb, pc, b, cont, r);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);   // Fork/SQC ≠ SetReg
        }
      case Character(_) =>   // pins Consume — not SetRegisterToCP
      case Disjunction(_, _) =>   // pins Fork — not SetRegisterToCP
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not SetRegisterToCP
      case AnchorR(_) =>   // pins AnchorAssertion — not SetRegisterToCP
      case Backreference(_) =>   // NfaRepL false
  }

  lemma TtLkAtSetRegRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                     tb: LT.Tree, pc: nat, ea: bool, r: int)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(r))
    ensures tb.GroupActionT?
    ensures (tb.g.Open? && r == CP.start_reg(tb.g.g as int))
         || (tb.g.Close? && r == CP.end_reg(tb.g.g as int))
    ensures TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtSetRegCoreRec(rer, qm, code, inp, tb, pc, b, acts, r);
  }

  lemma TtLkAtSetQuantCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                           tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, q: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
    ensures tb.GroupActionT? && tb.g.Reset?
    ensures TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not SetQuantToClock
    case Aclose(_) =>   // pins SetRegisterToCP — not SetQuantToClock
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtSetQuantCoreRec(rer, qm, code, inp, tb, pc, b, cont, q);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtSetQuantCoreRec(rer, qm, code, inp, tb, pc, b, na, q);
      case Quantified(greedy, min, delta, r1) =>
        assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
        assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
        if min > 0 {
          // THE forced-copy real head: reset stamp + continuation via QuantForcedContRep.
          var quant1 := L.Quantified(greedy, min - 1, delta, r1);
          var contActs := [LS.Areg(r1), LS.Areg(quant1)] + cont;
          assert tb.GroupActionT? && tb.g == LG.Reset(L.DefGroups(r1))
                 && EL.BoolTreeLk(rer, contActs, inp, b, tb.t);
          QuantForcedContRep(rer, qm, greedy, min, delta, r1, code, pc, pcmid, cont);   // ActionsRepL(contActs, pc+1)
          assert EL.PikeLkRegexRec(r1) && EL.PikeLkRegexRec(quant1);
          assert EL.PikeLkActionsRec(contActs) by {
            EL.PikeLkActionsRecConsIff(LS.Areg(quant1), cont);
            EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(quant1)] + cont);
          }
          assert TtLkRec(rer, qm, code, inp, tb.t, pc + 1, g);
        } else if delta == LN.NN(0) {
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtSetQuantCoreRec(rer, qm, code, inp, tb, pc, b, cont, q);
        } else {
          // min==0 with Inf or NN(kx>0): pins a Fork at pc, not SetQuantToClock.
          match delta
          case Inf =>
            if exists e1: nat ::
                 NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                 && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                        && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                 && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                 && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                 && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                 && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                 && pcmid == e1 + 2 {
              var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
            } else {
              var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
            }
          case NN(kx) =>
            var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                         && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
            NfaRepOptLHeadPin(rer, qm, kx, greedy, r1, code, em, pcmid);   // kx>0 ⇒ Fork at pc
        }
      case Character(_) =>   // pins Consume — not SetQuantToClock
      case Disjunction(_, _) =>   // pins Fork — not SetQuantToClock
      case Group(_, _) =>   // pins SetRegisterToCP — not SetQuantToClock
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not SetQuantToClock
      case AnchorR(_) =>   // pins AnchorAssertion — not SetQuantToClock
      case Backreference(_) =>   // NfaRepL false
  }

  lemma TtLkAtSetQuantRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                       tb: LT.Tree, pc: nat, ea: bool, q: int)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q, false))
    ensures tb.GroupActionT? && tb.g.Reset?
    ensures TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ea)
  {
    if (exists acts: LS.Actions, b: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActionsRec(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, tb)) {
      var acts: LS.Actions, b: BS.LoopBool :|
        AR.ActionsRepL(rer, qm, acts, code, pc)
        && EL.PikeLkActionsRec(acts)
        && ATR.EaOf(b) == ea
        && EL.BoolTreeLk(rer, acts, inp, b, tb);
      TtLkAtSetQuantCoreRec(rer, qm, code, inp, tb, pc, b, acts, q);
    } else {
      // the SQC see-through disjunct gives the shape + child directly
      var q0: int :| NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(q0, false))
        && q0 in qm.quants
        && tb.GroupActionT? && tb.g == LG.Reset(qm.quants[q0])
        && TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ea);
    }
  }

  lemma TtLkAtCheckOracleCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                              tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, lid: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    requires LL.OracleOkAt(rer, qm, inp)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      (LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
         tb.LK? && tb.lk == lk
         && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, true)
         && TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ATR.EaOf(b)))
      && (!LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
            tb.LKFail? && tb.lk == lk
            && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, false))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not CheckOracle
    case Aclose(_) =>   // pins SetRegisterToCP — not CheckOracle
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtCheckOracleCoreRec(rer, qm, code, inp, tb, pc, b, cont, lid);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtCheckOracleCoreRec(rer, qm, code, inp, tb, pc, b, na, lid);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtCheckOracleCoreRec(rer, qm, code, inp, tb, pc, b, cont, lid);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case LookaroundR(lk0, r1) =>
        // NfaRepL(LookaroundR) pins CheckOracle(lid0)/NegCheckOracle(lid0); here it is CheckOracle.
        var lid0: int :| NR.GetPcRE(code, pc) == Some(if AR.PositiveL(lk0) then RB.CheckOracle(lid0)
                                                                           else RB.NegCheckOracle(lid0))
          && lid0 in qm.looks && qm.looks[lid0] == (lk0, r1) && pcmid == pc + 1;
        assert AR.PositiveL(lk0) && lid0 == lid;
        assert L.Positivity(lk0);
        assert lid in qm.looks && qm.looks[lid] == (lk0, r1);
        M.GateNodeAtInp(rer, acts, inp, b, tb, lk0, r1);   // tb is LK/LKFail with LkGateOk
        // OracleOkAt at lid: bit ⟺ TreeRes(ComputeTr([Areg(r1)],inp,Empty,LkDir(lk0)),..).Some?
        var bit := LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid);
        if tb.LK? {
          // LkGateOk(..,true) ⇒ LkResult.Some? ⇒ TreeRes.Some? ⇒ bit
          assert EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          assert TtLkRec(rer, qm, code, inp, tb.t, pc + 1, g);
          assert bit;
        } else {
          assert tb.LKFail?;   // GateNodeAtInp: only LK or LKFail
          // LkGateOk(..,false) ⇒ LkResult.None? ⇒ TreeRes.None? ⇒ !bit
          assert !bit;
        }
      case Character(_) =>   // pins Consume — not CheckOracle
      case Disjunction(_, _) =>   // pins Fork — not CheckOracle
      case Group(_, _) =>   // pins SetRegisterToCP — not CheckOracle
      case AnchorR(_) =>   // pins AnchorAssertion — not CheckOracle
      case Backreference(_) =>   // NfaRepL false
  }

  lemma TtLkAtCheckOracleRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          tb: LT.Tree, pc: nat, ea: bool, lid: int)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.CheckOracle(lid))
    requires LL.OracleOkAt(rer, qm, inp)
    ensures lid in qm.looks
    ensures var (lk, r1) := qm.looks[lid];
      (LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
         tb.LK? && tb.lk == lk
         && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, true)
         && TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ea))
      && (!LOr.view_get_oracle(qm.ov, TR_CpOf(inp), lid) ==>
            tb.LKFail? && tb.lk == lk
            && EL.LkGateOk(rer, lk, r1, inp, tb.tlk, false))
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtCheckOracleCoreRec(rer, qm, code, inp, tb, pc, b, acts, lid);
  }

  lemma TtLkAtAnchorCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                         tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, a: R.anchor)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
    ensures tb.AnchorPass? || tb == LT.Mismatch
    ensures tb.AnchorPass? ==> TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ATR.EaOf(b))
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(_) =>   // pins EndLoop / backward Fork — not AnchorAssertion
    case Aclose(_) =>   // pins SetRegisterToCP — not AnchorAssertion
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtAnchorCoreRec(rer, qm, code, inp, tb, pc, b, cont, a);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtAnchorCoreRec(rer, qm, code, inp, tb, pc, b, na, a);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtAnchorCoreRec(rer, qm, code, inp, tb, pc, b, cont, a);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case AnchorR(la) =>
        var a2: R.anchor :| NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a2)) && T.TrAnchor(a2) == la;
        assert pcmid == pc + 1;
        if LS.AnchorSatisfied(rer, la, inp) {
          assert tb.AnchorPass? && EL.BoolTreeLk(rer, cont, inp, b, tb.t);
          assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
          assert TtLkRec(rer, qm, code, inp, tb.t, pc + 1, g);
        } else {
          assert tb == LT.Mismatch;
        }
      case Character(_) =>   // pins Consume — not AnchorAssertion
      case Disjunction(_, _) =>   // pins Fork — not AnchorAssertion
      case Group(_, _) =>   // pins SetRegisterToCP — not AnchorAssertion
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not AnchorAssertion
      case Backreference(_) =>   // NfaRepL false
  }

  lemma TtLkAtAnchorRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                     tb: LT.Tree, pc: nat, ea: bool, a: R.anchor)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(a))
    ensures tb.AnchorPass? || tb == LT.Mismatch
    ensures tb.AnchorPass? ==> TtLkRec(rer, qm, code, inp, tb.t, pc + 1, ea)
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtAnchorCoreRec(rer, qm, code, inp, tb, pc, b, acts, a);
  }

  lemma TtLkAtEndLoopCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.EndLoop)
    ensures ATR.EaOf(b) ==> tb.Progress? && TtLkRec(rer, qm, code, inp, tb.t, pc + 1, true)
    ensures !ATR.EaOf(b) ==> tb == LT.Mismatch
    decreases ATR.MsizeA(acts)
  {
    var g := ATR.EaOf(b);
    assert !AR.BackForkAt(code, pc);   // GetPcRE(pc)==EndLoop, not Fork
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(strcheck) =>
      // ActionRepL(Acheck): EndLoop disjunct (BackFork excluded) ⇒ pcmid == pc+1
      assert pcmid == pc + 1;
      if b == BS.CanExit {
        assert g == true;
        assert tb.Progress? && EL.BoolTreeLk(rer, cont, inp, BS.CanExit, tb.t);
        assert AR.ActionsRepL(rer, qm, cont, code, pc + 1);
        assert TtLkRec(rer, qm, code, inp, tb.t, pc + 1, true);
      } else {
        assert b == BS.CannotExit && g == false;
        assert tb == LT.Mismatch;
      }
    case Aclose(_) =>   // pins SetRegisterToCP — not EndLoop
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtEndLoopCoreRec(rer, qm, code, inp, tb, pc, b, cont);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtEndLoopCoreRec(rer, qm, code, inp, tb, pc, b, na);
      case Quantified(greedy, min, delta, r1) =>
        if min == 0 && delta == LN.NN(0) {
          assert acts[0] == LS.Areg(L.Quantified(greedy, 0, LN.NN(0), r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, 0, LN.NN(0), r1), code, pc, pcmid);
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtEndLoopCoreRec(rer, qm, code, inp, tb, pc, b, cont);
        } else {
          assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
          assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);
        }
      case Character(_) =>   // pins Consume — not EndLoop
      case Disjunction(_, _) =>   // pins Fork — not EndLoop
      case Group(_, _) =>   // pins SetRegisterToCP — not EndLoop
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not EndLoop
      case AnchorR(_) =>   // pins AnchorAssertion — not EndLoop
      case Backreference(_) =>   // NfaRepL false
  }

  lemma TtLkAtEndLoopRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                      tb: LT.Tree, pc: nat, ea: bool)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.EndLoop)
    ensures ea ==> tb.Progress? && TtLkRec(rer, qm, code, inp, tb.t, pc + 1, true)
    ensures !ea ==> tb == LT.Mismatch
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtEndLoopCoreRec(rer, qm, code, inp, tb, pc, b, acts);
  }

  lemma TtLkAtForkCoreRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                       tb: LT.Tree, pc: nat, b: BS.LoopBool, acts: LS.Actions, x: int, y: int)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires EL.PikeLkActionsRec(acts)
    requires EL.BoolTreeLk(rer, acts, inp, b, tb)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    ensures x >= 0 && y >= 0
    ensures tb.Choice? || tb.Progress? || tb == LT.Mismatch
    decreases ATR.MsizeA(acts)
  {
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid) && AR.ActionsRepL(rer, qm, acts[1..], code, pcmid);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + acts[1..];
    EL.PikeLkActionsRecConsIff(acts[0], acts[1..]);
    var cont := acts[1..];
    match acts[0]
    case Acheck(strcheck) =>
      // EndLoop != Fork, so the BackForkAt disjunct: pcmid == pc; BoolTreeLk ⇒ Progress / Mismatch
      assert AR.BackForkAt(code, pc);
      assert x >= 0 && y >= 0;
    case Aclose(_) =>   // pins SetRegisterToCP — not Fork
    case Areg(r0) =>
      assert EL.PikeLkRegexRec(r0);
      match r0
      case Epsilon =>
        assert pcmid == pc;
        assert EL.BoolTreeLk(rer, cont, inp, b, tb);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        TtLkAtForkCoreRec(rer, qm, code, inp, tb, pc, b, cont, x, y);
      case Sequence(r1, r2) =>
        assert acts[0] == LS.Areg(L.Sequence(r1, r2));
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r2), cont, code, e1, pcmid);
        AR.ActionsRepLCons(rer, qm, LS.Areg(r1), [LS.Areg(r2)] + cont, code, pc, e1);
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert EL.PikeLkActionsRec(na) by {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        }
        assert EL.BoolTreeLk(rer, na, inp, b, tb);
        assert LS.ActionsRegexSize(acts) == RegSz(r1) + RegSz(r2) + 1 + LS.ActionsRegexSize(cont);
        assert LS.ActionsRegexSize(na) == RegSz(r1) + RegSz(r2) + LS.ActionsRegexSize(cont);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        TtLkAtForkCoreRec(rer, qm, code, inp, tb, pc, b, na, x, y);
      case Disjunction(r1, r2) =>
        // Fork(pc+1, e1+1) ⇒ x,y >= 0; BoolTreeLk ⇒ tb.Choice?
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.Fork(pc + 1, e1 + 1))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid))
          && AR.NfaRepL(rer, qm, r2, code, e1 + 1, pcmid);
        assert x == pc + 1 && y == e1 + 1;
        assert tb.Choice?;
      case Quantified(greedy, min, delta, r1) =>
        assert acts[0] == LS.Areg(L.Quantified(greedy, min, delta, r1));
        assert AR.NfaRepL(rer, qm, L.Quantified(greedy, min, delta, r1), code, pc, pcmid);
        if min == 0 && delta == LN.NN(0) {
          var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                       && AR.NfaRepOptL(rer, qm, 0, greedy, r1, code, em, pcmid);
          NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
          NfaRepOptLHeadPin(rer, qm, 0, greedy, r1, code, em, pcmid);
          assert pcmid == pc;
          assert AR.ActionsRepL(rer, qm, cont, code, pc);
          assert EL.BoolTreeLk(rer, cont, inp, b, tb);
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          TtLkAtForkCoreRec(rer, qm, code, inp, tb, pc, b, cont, x, y);
        } else if min > 0 {
          QuantHeadPinsForkOrSQC(rer, qm, greedy, min, delta, r1, code, pc, pcmid);   // pins SQC ≠ Fork
        } else {
          // min==0, Inf or NN(kx>0): the star/bounded fork ⇒ tb.Choice?; targets are nats.
          match delta
          case Inf =>
            if exists e1: nat :: NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                         && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                                && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
                         && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                         && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                         && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                         && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                         && pcmid == e1 + 2 {
              var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1));
              assert x >= 0 && y >= 0;
            } else {
              var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em));
              assert x >= 0 && y >= 0;
            }
            assert tb.Choice?;
          case NN(kx) =>
            var em: nat :| AR.NfaRepMinL(rer, qm, 0, r1, code, pc, em)
                         && AR.NfaRepOptL(rer, qm, kx, greedy, r1, code, em, pcmid);
            NfaRepMinLHeadPin(rer, qm, 0, r1, code, pc, em);
            assert em == pc;
            var e1x: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, pcmid) else RB.Fork(pcmid, pc + 1))
              && (exists qid: int :: NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                                     && qid in qm.quants && qm.quants[qid] == L.DefGroups(r1))
              && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
              && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1x)
              && NR.GetPcRE(code, e1x) == Some(RB.EndLoop)
              && AR.NfaRepOptL(rer, qm, kx - 1, greedy, r1, code, e1x + 1, pcmid);
            assert x >= 0 && y >= 0;
            assert tb.Choice?;
        }
      case Character(_) =>   // pins Consume — not Fork
      case Group(_, _) =>   // pins SetRegisterToCP — not Fork
      case LookaroundR(_, _) =>   // pins CheckOracle/NegCheckOracle — not Fork
      case AnchorR(_) =>   // pins AnchorAssertion — not Fork
      case Backreference(_) =>   // NfaRepL false
  }

  lemma TtLkAtForkRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                   tb: LT.Tree, pc: nat, ea: bool, x: int, y: int)
    requires TtLkRec(rer, qm, code, inp, tb, pc, ea)
    requires NR.GetPcRE(code, pc) == Some(RB.Fork(x, y))
    ensures x >= 0 && y >= 0
    ensures tb.Choice? || tb.Progress? || tb == LT.Mismatch
  {
    var acts: LS.Actions, b: BS.LoopBool :|
      AR.ActionsRepL(rer, qm, acts, code, pc)
      && EL.PikeLkActionsRec(acts)
      && ATR.EaOf(b) == ea
      && EL.BoolTreeLk(rer, acts, inp, b, tb);
    TtLkAtForkCoreRec(rer, qm, code, inp, tb, pc, b, acts, x, y);
  }

  lemma TtLkSameTreeRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                     t1: LT.Tree, t2: LT.Tree, pc: nat, ea: bool)
    requires !rer.multiline
    requires TtLkRec(rer, qm, code, inp, t1, pc, ea)
    requires TtLkRec(rer, qm, code, inp, t2, pc, ea)
    ensures CE.ProgErase(t1) == CE.ProgErase(t2)

  lemma ThreadRepLkStepBeginLoopRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                                 inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                                 S: set<LG.GroupId>, tb: LT.Tree, gmt: LG.GroupMap, th: AI.Thread,
                                 ncap: int, nlook: int, nquant: int)
    requires ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, tb, gmt, th, ncap, nlook, nquant)
    requires NR.GetPcRE(code, th.pc as nat) == Some(RB.BeginLoop)
    ensures ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, tb, gmt,
                        th.(exit_allowed := false, pc := th.pc + 1), ncap, nlook, nquant)
  {
    WalkPairLkAtBeginLoopRec(rer, qm, code, inp, tb, gmt, th.pc as nat, th.exit_allowed);
    // th.pc >= 0 (from ThreadRepLk) so (th.pc+1) as nat == (th.pc as nat) + 1.
    assert (th.pc + 1) as nat == (th.pc as nat) + 1;
    // GmtTieOutside/GmtTieInside read only capture/look/quant regs, unchanged by
    // the pc/exit_allowed update, so they transfer verbatim.
  }

  lemma StarIterArmWalkBLRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          gm: LG.GroupMap, sqcpc: nat, ea: bool, qid: int,
                          r1: L.Regex, ti: LT.Tree, armlist: LS.Actions)
    requires NR.GetPcRE(code, sqcpc) == Some(RB.SetQuantToClock(qid, false))
    requires qid in qm.quants && qm.quants[qid] == L.DefGroups(r1)
    requires NR.GetPcRE(code, sqcpc + 1) == Some(RB.BeginLoop)
    requires AR.ActionsRepL(rer, qm, armlist, code, sqcpc + 2)
    requires EL.PikeLkActionsRec(armlist)
    requires EL.BoolTreeLk(rer, armlist, inp, BS.CannotExit, ti)
    requires GateAheadClear(armlist, LG.GMReset(L.DefGroups(r1), gm))
    requires WalkDefsOk(armlist)
    ensures WalkPairLkRec(rer, qm, code, inp, LT.GroupActionT(LG.Reset(L.DefGroups(r1)), ti),
                       gm, sqcpc, ea)
  {
    var gidl := L.DefGroups(r1);
    var gm2 := LG.GMUpdate(LG.Reset(gidl), LC.Idx(inp), gm);
    assert gm2 == LG.GMReset(gidl, gm);
    assert sqcpc + 1 < RB.size(code);
    assert ATR.EaOf(BS.CannotExit) == false;
    assert WalkPairLkRec(rer, qm, code, inp, ti, gm2, sqcpc + 2, false);
    assert WalkPairLkRec(rer, qm, code, inp, ti, gm2, sqcpc + 1, ea);   // BeginLoop absorbs any flag
    assert sqcpc < RB.size(code);
  }

  lemma StarIterArmWalkLVRec(rer: LW.RegExpRecord, qm: AR.QMap, code: RB.code, inp: LC.Input,
                          gm: LG.GroupMap, sqcpc: nat, ea: bool, qid: int,
                          r1: L.Regex, ti: LT.Tree, rest: LS.Actions)
    requires NR.GetPcRE(code, sqcpc) == Some(RB.SetQuantToClock(qid, false))
    requires qid in qm.quants && qm.quants[qid] == L.DefGroups(r1)
    requires NUL.NonNullableL(r1)
    requires AR.ActionsRepL(rer, qm, [LS.Areg(r1)] + rest, code, sqcpc + 1)
    requires EL.PikeLkActionsRec([LS.Areg(r1)] + rest)
    requires EL.BoolTreeLk(rer, [LS.Areg(r1)] + rest, inp, BS.CannotExit, ti)
    requires GateAheadClear([LS.Areg(r1)] + rest, LG.GMReset(L.DefGroups(r1), gm))
    requires WalkDefsOk([LS.Areg(r1)] + rest)
    ensures WalkPairLkRec(rer, qm, code, inp, LT.GroupActionT(LG.Reset(L.DefGroups(r1)), ti),
                       gm, sqcpc, ea)
  {
    var gidl := L.DefGroups(r1);
    var gm2 := LG.GMUpdate(LG.Reset(gidl), LC.Idx(inp), gm);
    assert gm2 == LG.GMReset(gidl, gm);
    var b2 := if ea then BS.CanExit else BS.CannotExit;
    if ea { BoolTreeLkGuardShieldRec(rer, r1, rest, inp, ti); }
    assert EL.BoolTreeLk(rer, [LS.Areg(r1)] + rest, inp, b2, ti) && ATR.EaOf(b2) == ea;
    assert WalkPairLkRec(rer, qm, code, inp, ti, gm2, sqcpc + 1, ea);
    assert sqcpc < RB.size(code);
  }

  lemma BoolTreeLkGuardShieldRec(rer: LW.RegExpRecord, r1: L.Regex, rest: LS.Actions,
                              inp: LC.Input, ti: LT.Tree)
    requires NUL.NonNullableL(r1)
    requires EL.PikeLkActionsRec([LS.Areg(r1)] + rest)
    requires EL.BoolTreeLk(rer, [LS.Areg(r1)] + rest, inp, BS.CannotExit, ti)
    ensures EL.BoolTreeLk(rer, [LS.Areg(r1)] + rest, inp, BS.CanExit, ti)
  {
    var acts := [LS.Areg(r1)] + rest;
    assert CE.ShieldedActs(acts) by {
      forall i | 0 <= i < |acts| && acts[i].Acheck?
        ensures exists j :: 0 <= j < i && acts[j].Areg? && NUL.NonNullableL(acts[j].r)
      {
        assert acts[0] == LS.Areg(r1);
        assert i >= 1;
        assert acts[0].Areg? && NUL.NonNullableL(acts[0].r);
      }
    }
    CE.BoolFlagLiftRec(rer, acts, inp, ti);
  }

  lemma {:isolate_assertions} ActionsTreeRepLkFRec(rer: LW.RegExpRecord, qm: AR.QMap, acts: LS.Actions,
                                                code: RB.code, pc: nat, inp: LC.Input,
                                                b: BS.LoopBool, t: LT.Tree, n: nat)
    returns (tcan: LT.Tree)
    requires EL.PikeLkActionsRec(acts)
    requires ATR.ActionsRepFuelL(rer, qm, acts, code, pc, n)
    requires WO.WalkOk(acts, code, pc, ATR.EaOf(b))
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    ensures TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b))
    ensures CE.ProgErase(tcan) == CE.ProgErase(t)
    decreases CE.PSize(t), ATR.MsizeA(acts), n, 1
  {
    if |acts| == 0 && NR.GetPcRE(code, pc) == Some(RB.Accept) {
      assert t == LT.Match;
      tcan := LT.Match;
      // tr_match
    } else if exists pcstart: nat :: NR.GetPcRE(code, pc) == Some(RB.Jmp(pcstart))
                && ATR.ActionsRepFuelL(rer, qm, acts, code, pcstart, n - 1) {
      var pcstart: nat :| NR.GetPcRE(code, pc) == Some(RB.Jmp(pcstart))
        && ATR.ActionsRepFuelL(rer, qm, acts, code, pcstart, n - 1);
      WO.WalkOkJmp(acts, code, pc, ATR.EaOf(b), pcstart);
      tcan := ActionsTreeRepLkFRec(rer, qm, acts, code, pcstart, inp, b, t, n - 1);
      // tr_jmp
      assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
    } else {
      var cont := acts[1..];
      var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid)
        && ATR.ActionsRepFuelL(rer, qm, cont, code, pcmid, n - 1);
      EL.PikeLkActionsRecTail(acts);
      assert acts == [acts[0]] + cont;
      EL.PikeLkActionsRecConsIff(acts[0], cont);
      match acts[0]
      case Acheck(strcheck) =>
        assert LS.ActionsRegexSize(acts) == LS.ActionsRegexSize(cont);
        if NR.GetPcRE(code, pc) == Some(RB.EndLoop) {
          assert pcmid == pc + 1;
          if b == BS.CanExit {
            match t {
              case Progress(tc) =>
                WO.WalkOkAcheckEndLoop(acts, code, pc, ATR.EaOf(b));
                var sub := ActionsTreeRepLkFRec(rer, qm, cont, code, pc + 1, inp, BS.CanExit, tc, n - 1);
                tcan := LT.Progress(sub);
                // tr_progress (fall-through EndLoop)
                assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, true);
              case _ =>
            }
          } else {
            // t == Mismatch: tr_progressfail
            tcan := LT.Mismatch;
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, false);
          }
        } else {
          // the zero-width check at the do-while's backward fork
          assert AR.BackForkAt(code, pc) && pcmid == pc;
          if b == BS.CanExit {
            match t {
              case Progress(tc) =>
                WO.WalkOkAcheckBackFork(acts, code, pc, ATR.EaOf(b));
                var sub := AtBackForkTreeLkFRec(rer, qm, cont, code, pc, inp, tc, n - 1);
                tcan := LT.Progress(sub);
                // the companion's ensures IS tr_plus for Progress(sub)
                assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, true);
              case _ =>
            }
          } else {
            // t == Mismatch: tr_plusfail
            var fx: int, fy: int :| NR.GetPcRE(code, pc) == Some(RB.Fork(fx, fy))
              && fx >= 0 && fy >= 0 && (fx as nat <= pc || fy as nat <= pc);
            tcan := LT.Mismatch;
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, false);
          }
        }
      case Aclose(gid) =>
        match t {
          case GroupActionT(g, tc) =>
            assert g == LG.Close(gid);
            WO.WalkOkAclose(acts, code, pc, ATR.EaOf(b));
            assert CE.PSize(tc) < CE.PSize(t);
            var sub := ActionsTreeRepLkFRec(rer, qm, cont, code, pc + 1, inp, b, tc, n - 1);
            tcan := LT.GroupActionT(g, sub);
            // tr_close
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
          case _ =>
        }
      case Areg(r) =>
        assert EL.PikeLkRegexRec(r);
        match r
        case Epsilon =>
          assert pcmid == pc;
          WO.WalkOkEpsilon(acts, code, pc, ATR.EaOf(b));
          assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
          tcan := ActionsTreeRepLkFRec(rer, qm, cont, code, pc, inp, b, t, n - 1);
        case Character(cd) => {
          var ce :| NR.GetPcRE(code, pc) == Some(RB.Consume(ce)) && AR.ExpectationMatches(rer, ce, cd);
          AR.ReadAgree(rer, ce, cd, inp);
          match LC.ReadChar(rer, cd, inp, WP.Forward) {
            case None =>
              // t == Mismatch; tr_readfail (ReadCharE == None by ReadAgree)
              tcan := LT.Mismatch;
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case Some(pair) =>
              match t {
                case Read(c, tc) =>
                  assert c == pair.0;
                  WO.WalkOkCharacter(acts, code, pc, ATR.EaOf(b));
                  assert CE.PSize(tc) < CE.PSize(t);
                  var sub := ActionsTreeRepLkFRec(rer, qm, cont, code, pc + 1, pair.1, BS.CanExit, tc, n - 1);
                  tcan := LT.Read(c, sub);
                  // tr_read with witness (ce, pair.1)
                  assert AR.ReadCharE(ce, inp) == Some((c, pair.1));
                  assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                case _ =>
              }
          }
        }
        case Disjunction(r1, r2) => {
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.Fork(pc + 1, e1 + 1))
                       && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid))
                       && AR.NfaRepL(rer, qm, r2, code, e1 + 1, pcmid);
          AR.NfaRepIncrL(rer, qm, r1, code, pc + 1, e1);
          match t {
            case Choice(ta, tb) =>
              WO.WalkOkAlt(acts, code, pc, ATR.EaOf(b), r1, r2, pc + 1, e1 + 1);
              // left branch: [Areg r1]+cont at pc+1 (cont reached via Jmp(e1 -> pcmid))
              var la := [LS.Areg(r1)] + cont;
              assert AR.ActionsRepL(rer, qm, cont, code, e1) by {
                ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                assert NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid));
              }
              assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, e1);
              assert la[0] == LS.Areg(r1) && la[1..] == cont;
              assert AR.ActionsRepL(rer, qm, la, code, pc + 1);
              ATR.ActionsRepLToFuel(rer, qm, la, code, pc + 1);
              var na: nat :| ATR.ActionsRepFuelL(rer, qm, la, code, pc + 1, na);
              assert CE.PSize(ta) < CE.PSize(t);
              var suba := ActionsTreeRepLkFRec(rer, qm, la, code, pc + 1, inp, b, ta, na);
              // right branch: [Areg r2]+cont at e1+1
              var lb := [LS.Areg(r2)] + cont;
              ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
              assert AR.ActionRepL(rer, qm, LS.Areg(r2), code, e1 + 1, pcmid);
              assert lb[0] == LS.Areg(r2) && lb[1..] == cont;
              assert AR.ActionsRepL(rer, qm, lb, code, e1 + 1);
              ATR.ActionsRepLToFuel(rer, qm, lb, code, e1 + 1);
              var nb: nat :| ATR.ActionsRepFuelL(rer, qm, lb, code, e1 + 1, nb);
              assert CE.PSize(tb) < CE.PSize(t);
              var subb := ActionsTreeRepLkFRec(rer, qm, lb, code, e1 + 1, inp, b, tb, nb);
              tcan := LT.Choice(suba, subb);
              // tr_choice with the forward Fork(pc+1, e1+1): e1 >= pc+1 by NfaRepIncrL
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case _ =>
          }
        }
        case Sequence(r1, r2) => {
          EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
          assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
          var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
          var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
          assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
          assert AR.ActionRepL(rer, qm, LS.Areg(r2), code, e1, pcmid);
          assert ([LS.Areg(r2)] + cont)[0] == LS.Areg(r2) && ([LS.Areg(r2)] + cont)[1..] == cont;
          ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
          assert AR.ActionsRepL(rer, qm, [LS.Areg(r2)] + cont, code, e1);
          assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc, e1);
          assert na[0] == LS.Areg(r1) && na[1..] == [LS.Areg(r2)] + cont;
          assert AR.ActionsRepL(rer, qm, na, code, pc);
          assert LS.ActionsRegexSize(na) < LS.ActionsRegexSize(acts);
          assert ATR.MsizeA(na) < ATR.MsizeA(acts);
          ATR.ActionsRepLToFuel(rer, qm, na, code, pc);
          var nn: nat :| ATR.ActionsRepFuelL(rer, qm, na, code, pc, nn);
          WO.WalkOkSeq(acts, code, pc, ATR.EaOf(b), r1, r2);
          tcan := ActionsTreeRepLkFRec(rer, qm, na, code, pc, inp, b, t, nn);
        }
        case Quantified(greedy, min, delta, r1) => {
          var gidl := L.DefGroups(r1);
          if min > 0 {
            match delta {
              case Inf =>
                var em, e1x := AR.NfaRepLPlusInv(rer, qm, greedy, min, r1, code, pc, pcmid);
                assert NUL.NonNullableL(r1);
                var qid: int :| NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                  && qid in qm.quants && qm.quants[qid] == gidl;
                AR.NfaRepIncrL(rer, qm, r1, code, em + 1, e1x);
                if min > 1 {
                  var quant1 := L.Quantified(greedy, min - 1, LN.Inf, r1);
                  var eb: nat :| (exists qid2: int ::
                        NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid2, false))
                        && qid2 in qm.quants && qm.quants[qid2] == gidl)
                    && AR.NfaRepL(rer, qm, r1, code, pc + 1, eb)
                    && AR.NfaRepMinL(rer, qm, min - 2, r1, code, eb, em);
                  AR.NfaRepLPlusIntro(rer, qm, greedy, min - 1, r1, code, eb, em, e1x, pcmid, qid);
                  assert AR.NfaRepL(rer, qm, quant1, code, eb, pcmid);
                  match t {
                    case GroupActionT(g, tc) =>
                      assert g == LG.Reset(gidl);
                      EL.PikeLkActionsRecConsIff(LS.Areg(quant1), cont);
                      EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(quant1)] + cont);
                      ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                      assert AR.ActionRepL(rer, qm, LS.Areg(quant1), code, eb, pcmid);
                      var lq1 := [LS.Areg(quant1)] + cont;
                      assert lq1[0] == LS.Areg(quant1) && lq1[1..] == cont;
                      assert AR.ActionsRepL(rer, qm, lq1, code, eb);
                      var ia := [LS.Areg(r1)] + lq1;
                      assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, eb);
                      assert ia[0] == LS.Areg(r1) && ia[1..] == lq1;
                      assert AR.ActionsRepL(rer, qm, ia, code, pc + 1);
                      assert ia == [LS.Areg(r1), LS.Areg(quant1)] + cont;
                      ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 1);
                      var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 1, ni);
                      WO.WalkOkQuantForced(acts, code, pc, ATR.EaOf(b), greedy, min, delta, r1);
                      assert CE.PSize(tc) < CE.PSize(t);
                      var sub := ActionsTreeRepLkFRec(rer, qm, ia, code, pc + 1, inp, b, tc, ni);
                      tcan := LT.GroupActionT(g, sub);
                      // tr_reset at pc (the copy's clock-mark carries the Reset)
                      assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                    case _ =>
                  }
                } else {
                  // min == 1: THE SEAM. Insert the check; erasure makes the
                  // insertion invisible (BoolCheckInsert's ProgErase ensures).
                  assert em == pc;
                  var q0 := L.Quantified(greedy, 0, LN.Inf, r1);
                  match t {
                    case GroupActionT(g, tc) =>
                      assert g == LG.Reset(gidl);
                      assert EL.BoolTreeLk(rer, [LS.Areg(r1), LS.Areg(q0)] + cont, inp, b, tc);
                      var pre := [LS.Areg(r1)];
                      var rest := [LS.Areg(q0)] + cont;
                      EL.PikeLkActionsRecConsIff(LS.Areg(q0), cont);
                      EL.PikeLkActionsRecConsIff(LS.Areg(r1), rest);
                      assert EL.PikeLkActionsRec(pre) by {
                        assert pre == [LS.Areg(r1)] + [];
                        EL.PikeLkActionsRecConsIff(LS.Areg(r1), []);
                      }
                      assert pre + rest == [LS.Areg(r1), LS.Areg(q0)] + cont;
                      assert CE.ConsumesBeforeAreg(pre) by {
                        assert pre[0].Areg? && NUL.NonNullableL(pre[0].r);
                      }
                      var t1ck := CE.BoolCheckInsert(rer, pre, inp, rest, inp, b, tc);
                      assert CE.ProgErase(t1ck) == CE.ProgErase(tc);
                      var ia := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q0)] + cont;
                      assert ia == pre + [LS.Acheck(inp)] + rest;
                      assert EL.BoolTreeLk(rer, ia, inp, b, t1ck);
                      assert AR.BackForkAt(code, e1x) by {
                        assert NR.GetPcRE(code, e1x)
                            == Some(if greedy then RB.Fork(em, e1x + 1) else RB.Fork(e1x + 1, em));
                        assert em <= e1x;
                      }
                      assert AR.NfaRepL(rer, qm, q0, code, e1x, e1x + 1) by {
                        assert NUL.NonNullableL(r1)
                          && NR.GetPcRE(code, e1x)
                             == Some(if greedy then RB.Fork(em, e1x + 1) else RB.Fork(e1x + 1, em))
                          && em <= e1x
                          && (exists qid2: int ::
                                NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid2, false))
                                && qid2 in qm.quants && qm.quants[qid2] == L.DefGroups(r1))
                          && AR.NfaRepL(rer, qm, r1, code, em + 1, e1x);
                      }
                      ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                      var lq := [LS.Areg(q0)] + cont;
                      assert AR.ActionRepL(rer, qm, LS.Areg(q0), code, e1x, e1x + 1);
                      assert lq[0] == LS.Areg(q0) && lq[1..] == cont;
                      assert AR.ActionsRepL(rer, qm, lq, code, e1x);
                      var lc := [LS.Acheck(inp)] + lq;
                      EL.PikeLkActionsRecConsIff(LS.Acheck(inp), lq);
                      assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1x, e1x);
                      assert lc[0] == LS.Acheck(inp) && lc[1..] == lq;
                      assert AR.ActionsRepL(rer, qm, lc, code, e1x);
                      assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, e1x);
                      assert ia == [LS.Areg(r1)] + lc;
                      assert ia[0] == LS.Areg(r1) && ia[1..] == lc;
                      assert AR.ActionsRepL(rer, qm, ia, code, pc + 1);
                      EL.PikeLkActionsRecConsIff(LS.Areg(r1), lc);
                      assert EL.PikeLkActionsRec(ia);
                      ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 1);
                      var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 1, ni);
                      WO.WalkOkQuantSeam(acts, code, pc, ATR.EaOf(b), greedy, r1, inp);
                      assert CE.PSize(t1ck) == CE.PSize(tc);
                      assert CE.PSize(t1ck) < CE.PSize(t);
                      var sub := ActionsTreeRepLkFRec(rer, qm, ia, code, pc + 1, inp, b, t1ck, ni);
                      tcan := LT.GroupActionT(g, sub);
                      // erasure: ProgErase(sub) == ProgErase(t1ck) == ProgErase(tc)
                      // (BoolCheckInsert's insertion is Progress-only); tr_reset at pc
                      assert CE.ProgErase(sub) == CE.ProgErase(tc);
                      assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                    case _ =>
                  }
                }
              case NN(kx) =>
                var em := AR.NfaRepLQuantInv(rer, qm, greedy, min, kx, r1, code, pc, pcmid);
                var quant1 := L.Quantified(greedy, min - 1, delta, r1);
                var eb: nat :| (exists qid: int ::
                      NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                      && qid in qm.quants && qm.quants[qid] == gidl)
                  && AR.NfaRepL(rer, qm, r1, code, pc + 1, eb)
                  && AR.NfaRepMinL(rer, qm, min - 1, r1, code, eb, em);
                AR.NfaRepLQuantIntro(rer, qm, greedy, min - 1, kx, r1, code, eb, em, pcmid);
                assert AR.NfaRepL(rer, qm, quant1, code, eb, pcmid);
                match t {
                  case GroupActionT(g, tc) =>
                    assert g == LG.Reset(gidl);
                    EL.PikeLkActionsRecConsIff(LS.Areg(quant1), cont);
                    EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(quant1)] + cont);
                    ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                    assert AR.ActionRepL(rer, qm, LS.Areg(quant1), code, eb, pcmid);
                    var lq1 := [LS.Areg(quant1)] + cont;
                    assert lq1[0] == LS.Areg(quant1) && lq1[1..] == cont;
                    assert AR.ActionsRepL(rer, qm, lq1, code, eb);
                    var ia := [LS.Areg(r1)] + lq1;
                    assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, eb);
                    assert ia[0] == LS.Areg(r1) && ia[1..] == lq1;
                    assert AR.ActionsRepL(rer, qm, ia, code, pc + 1);
                    assert ia == [LS.Areg(r1), LS.Areg(quant1)] + cont;
                    ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 1);
                    var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 1, ni);
                    WO.WalkOkQuantForced(acts, code, pc, ATR.EaOf(b), greedy, min, delta, r1);
                    assert CE.PSize(tc) < CE.PSize(t);
                    var sub := ActionsTreeRepLkFRec(rer, qm, ia, code, pc + 1, inp, b, tc, ni);
                    tcan := LT.GroupActionT(g, sub);
                    // tr_reset at pc
                    assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                  case _ =>
                }
            }
            return;
          }
          if delta.NN? {
            var k := delta.n;
            var em := AR.NfaRepLQuantInv(rer, qm, greedy, 0, k, r1, code, pc, pcmid);
            assert em == pc;
            if k == 0 {
              // spent quantifier: transparent, peel
              assert pc == pcmid;
              WO.WalkOkQuantSpent(acts, code, pc, ATR.EaOf(b), greedy, r1);
              assert LS.ActionsRegexSize(cont) < LS.ActionsRegexSize(acts);
              assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
              tcan := ActionsTreeRepLkFRec(rer, qm, cont, code, pcmid, inp, b, t, n - 1);
            } else {
              // one bounded layer: the fork skips to the common end pcmid
              var quant := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
              assert quant == L.Quantified(greedy, 0, LN.NN(k - 1), r1);
              var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, pcmid) else RB.Fork(pcmid, pc + 1))
                && (exists qid: int ::
                      NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                      && qid in qm.quants && qm.quants[qid] == gidl)
                && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                && AR.NfaRepOptL(rer, qm, k - 1, greedy, r1, code, e1 + 1, pcmid);
              AR.NfaRepIncrL(rer, qm, r1, code, pc + 3, e1);
              AR.NfaRepIncrOptL(rer, qm, k - 1, greedy, r1, code, e1 + 1, pcmid);
              match t {
                case Choice(ta, tb) =>
                  var itert := if greedy then ta else tb;
                  var skipt := if greedy then tb else ta;
                  match itert {
                    case GroupActionT(g, ti) =>
                      assert g == LG.Reset(gidl);
                      WO.WalkOkQuantLayer(acts, code, pc, ATR.EaOf(b), greedy, delta, r1,
                                          if greedy then pc + 1 else pcmid,
                                          if greedy then pcmid else pc + 1, inp);
                      // skip branch: cont at the common end pcmid
                      assert CE.PSize(skipt) < CE.PSize(t);
                      var subs := ActionsTreeRepLkFRec(rer, qm, cont, code, pcmid, inp, b, skipt, n - 1);
                      // iteration branch at pc+3 with the NN(k-1) continuation at e1+1
                      EL.PikeLkActionsRecConsIff(LS.Areg(quant), cont);
                      EL.PikeLkActionsRecConsIff(LS.Acheck(inp), [LS.Areg(quant)] + cont);
                      EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
                      ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                      var lq := [LS.Areg(quant)] + cont;
                      assert AR.NfaRepMinL(rer, qm, 0, r1, code, e1 + 1, e1 + 1);
                      AR.NfaRepLQuantIntro(rer, qm, greedy, 0, k - 1, r1, code, e1 + 1, e1 + 1, pcmid);
                      assert AR.ActionRepL(rer, qm, LS.Areg(quant), code, e1 + 1, pcmid);
                      assert lq[0] == LS.Areg(quant) && lq[1..] == cont;
                      assert AR.ActionsRepL(rer, qm, lq, code, e1 + 1);
                      var lc := [LS.Acheck(inp)] + lq;
                      assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1, e1 + 1);
                      assert lc[0] == LS.Acheck(inp) && lc[1..] == lq;
                      assert AR.ActionsRepL(rer, qm, lc, code, e1);
                      var ia := [LS.Areg(r1)] + lc;
                      assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 3, e1);
                      assert ia[0] == LS.Areg(r1) && ia[1..] == lc;
                      assert AR.ActionsRepL(rer, qm, ia, code, pc + 3);
                      assert ia == [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont;
                      ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 3);
                      var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 3, ni);
                      assert CE.PSize(ti) < CE.PSize(t);
                      var subi := ActionsTreeRepLkFRec(rer, qm, ia, code, pc + 3, inp, BS.CannotExit, ti, ni);
                      // assemble: subi at pc+3 (false) -> tr_begin at pc+2 ->
                      // tr_reset at pc+1 -> tr_choice with the skip at pcmid
                      assert TreeRepLkRE(rer, qm, code, inp, subi, pc + 3, false);
                      assert TreeRepLkRE(rer, qm, code, inp, subi, pc + 2, ATR.EaOf(b));
                      var iterstar := LT.GroupActionT(g, subi);
                      assert TreeRepLkRE(rer, qm, code, inp, iterstar, pc + 1, ATR.EaOf(b));
                      tcan := if greedy then LT.Choice(iterstar, subs) else LT.Choice(subs, iterstar);
                      assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                      assert CE.ProgErase(iterstar) == CE.ProgErase(itert);
                      assert CE.ProgErase(tcan) == CE.ProgErase(t);
                    case _ =>
                  }
                case _ =>
              }
            }
            return;
          }
          assert min == 0 && delta == LN.Inf;
          var quant := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
          assert quant == L.Quantified(greedy, 0, LN.Inf, r1) == L.Quantified(greedy, min, delta, r1);
          if exists e1: nat :: NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                       && (exists qid: int ::
                             NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                             && qid in qm.quants && qm.quants[qid] == gidl)
                       && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                       && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                       && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                       && pcmid == e1 + 2 {
            // the star FAST PATH (forward decision point)
            var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                         && (exists qid: int ::
                               NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                               && qid in qm.quants && qm.quants[qid] == gidl)
                         && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                         && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                         && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                         && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                         && pcmid == e1 + 2;
            AR.NfaRepIncrL(rer, qm, r1, code, pc + 3, e1);
            match t {
              case Choice(ta, tb) =>
                var itert := if greedy then ta else tb;
                var skipt := if greedy then tb else ta;
                match itert {
                  case GroupActionT(g, ti) =>
                    assert g == LG.Reset(gidl);
                    WO.WalkOkQuantLayer(acts, code, pc, ATR.EaOf(b), greedy, delta, r1,
                                        if greedy then pc + 1 else pcmid,
                                        if greedy then pcmid else pc + 1, inp);
                    // skip branch at pcmid == e1+2
                    assert CE.PSize(skipt) < CE.PSize(t);
                    var subs := ActionsTreeRepLkFRec(rer, qm, cont, code, pcmid, inp, b, skipt, n - 1);
                    // iteration branch: [Areg r1, Acheck inp, Areg quant] + cont at pc+3
                    EL.PikeLkActionsRecConsIff(LS.Areg(quant), cont);
                    EL.PikeLkActionsRecConsIff(LS.Acheck(inp), [LS.Areg(quant)] + cont);
                    EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(quant)] + cont));
                    ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                    var lq := [LS.Areg(quant)] + cont;
                    assert AR.ActionRepL(rer, qm, LS.Areg(quant), code, pc, pcmid);
                    assert lq[0] == LS.Areg(quant) && lq[1..] == cont;
                    assert AR.ActionsRepL(rer, qm, lq, code, pc);
                    AR.ActionsRepLJmp(rer, qm, lq, code, e1 + 1, pc);
                    var lc := [LS.Acheck(inp)] + lq;
                    assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, e1, e1 + 1);
                    assert lc[0] == LS.Acheck(inp) && lc[1..] == lq;
                    assert AR.ActionsRepL(rer, qm, lc, code, e1);
                    var ia := [LS.Areg(r1)] + lc;
                    assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 3, e1);
                    assert ia[0] == LS.Areg(r1) && ia[1..] == lc;
                    assert AR.ActionsRepL(rer, qm, ia, code, pc + 3);
                    assert ia == [LS.Areg(r1), LS.Acheck(inp), LS.Areg(quant)] + cont;
                    ATR.ActionsRepLToFuel(rer, qm, ia, code, pc + 3);
                    var ni: nat :| ATR.ActionsRepFuelL(rer, qm, ia, code, pc + 3, ni);
                    assert CE.PSize(ti) < CE.PSize(t);
                    var subi := ActionsTreeRepLkFRec(rer, qm, ia, code, pc + 3, inp, BS.CannotExit, ti, ni);
                    // assemble: tr_begin at pc+2, tr_reset at pc+1, tr_choice at pc
                    assert TreeRepLkRE(rer, qm, code, inp, subi, pc + 3, false);
                    assert TreeRepLkRE(rer, qm, code, inp, subi, pc + 2, ATR.EaOf(b));
                    var iterstar := LT.GroupActionT(g, subi);
                    assert TreeRepLkRE(rer, qm, code, inp, iterstar, pc + 1, ATR.EaOf(b));
                    tcan := if greedy then LT.Choice(iterstar, subs) else LT.Choice(subs, iterstar);
                    assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
                    assert CE.ProgErase(iterstar) == CE.ProgErase(itert);
                    assert CE.ProgErase(tcan) == CE.ProgErase(t);
                  case _ =>
                }
              case _ =>
            }
          } else {
            // the LOOP VIEW: a bare star at the do-while's backward fork.
            // WalkOk pins the flag to CanExit; the fused fork lemma builds the
            // Choice and tr_plus consumes the PLANTED Progress with the fork.
            assert NUL.NonNullableL(r1);
            var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em))
              && em <= pc
              && (exists qid: int ::
                    NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                    && qid in qm.quants && qm.quants[qid] == gidl)
              && AR.NfaRepL(rer, qm, r1, code, em + 1, pc)
              && pcmid == pc + 1;
            WO.WalkOkLoopView(acts, code, pc, ATR.EaOf(b), greedy, LN.Inf, r1,
                              if greedy then em else pc + 1,
                              if greedy then pc + 1 else em, inp);
            assert ATR.EaOf(b) == true;
            assert b == BS.CanExit;
            assert AR.BackForkAt(code, pc);
            var sub := AtBackForkTreeLkFRec(rer, qm, acts, code, pc, inp, t, n);
            tcan := LT.Progress(sub);
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
          }
        }
        case Group(gid, r1) => {
          EL.PikeLkActionsRecConsIff(LS.Aclose(gid), cont);
          EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Aclose(gid)] + cont);
          var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(gid as int)))
                       && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(gid as int)))
                       && pcmid == e1 + 1;
          match t {
            case GroupActionT(g, tc) =>
              assert g == LG.Open(gid);
              WO.WalkOkGroup(acts, code, pc, ATR.EaOf(b), gid, r1);
              var lc := [LS.Aclose(gid)] + cont;
              assert AR.ActionRepL(rer, qm, LS.Aclose(gid), code, e1, e1 + 1);
              assert lc[0] == LS.Aclose(gid) && lc[1..] == cont;
              ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
              assert AR.ActionsRepL(rer, qm, lc, code, e1);
              var ga := [LS.Areg(r1)] + lc;
              assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc + 1, e1);
              assert ga[0] == LS.Areg(r1) && ga[1..] == lc;
              assert AR.ActionsRepL(rer, qm, ga, code, pc + 1);
              assert ga == [LS.Areg(r1), LS.Aclose(gid)] + cont;
              ATR.ActionsRepLToFuel(rer, qm, ga, code, pc + 1);
              var ng: nat :| ATR.ActionsRepFuelL(rer, qm, ga, code, pc + 1, ng);
              assert CE.PSize(tc) < CE.PSize(t);
              var sub := ActionsTreeRepLkFRec(rer, qm, ga, code, pc + 1, inp, b, tc, ng);
              tcan := LT.GroupActionT(g, sub);
              // tr_open
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case _ =>
          }
        }
        case AnchorR(la) => {
          var ra: R.anchor :| NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(ra))
                              && T.TrAnchor(ra) == la;
          if LS.AnchorSatisfied(rer, la, inp) {
            match t {
              case AnchorPass(la2, tc) =>
                assert la2 == la;
                WO.WalkOkAnchor(acts, code, pc, ATR.EaOf(b));
                assert CE.PSize(tc) < CE.PSize(t);
                var sub := ActionsTreeRepLkFRec(rer, qm, cont, code, pc + 1, inp, b, tc, n - 1);
                tcan := LT.AnchorPass(la2, sub);
                // tr_anchorpass (Linden-side satisfaction, anchor pinned via ra)
                assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
              case _ =>
            }
          } else {
            // t == Mismatch; tr_anchorfail via ra
            tcan := LT.Mismatch;
            assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
          }
        }
        case LookaroundR(lk, r1) => {
          // THE GATE. NfaRepL pins the oracle instruction + the looks-table
          // row; TreeRepLkRE's gate rule is decided by the same FUNCTIONAL
          // verdict BoolTreeLk's LkGateOk used — no oracle bit involved. The
          // node is KEPT with the RAW functional body.
          var lid: int :| NR.GetPcRE(code, pc)
                            == Some(if AR.PositiveL(lk) then RB.CheckOracle(lid)
                                                        else RB.NegCheckOracle(lid))
                          && lid in qm.looks && qm.looks[lid] == (lk, r1);
          assert pcmid == pc + 1;
          var tlkc := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
          match t {
            case LK(lk2, tlk, tc) =>
              assert lk2 == lk && tlk == tlkc && LS.LkResult(lk, tlk, LG.Empty, inp).Some?;
              WO.WalkOkLookaround(acts, code, pc, ATR.EaOf(b));
              assert CE.PSize(tc) < CE.PSize(t);
              var sub := ActionsTreeRepLkFRec(rer, qm, cont, code, pc + 1, inp, b, tc, n - 1);
              tcan := LT.LK(lk, tlkc, sub);
              // tr_lk
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case LKFail(lk2, tlk) =>
              assert lk2 == lk && tlk == tlkc && LS.LkResult(lk, tlk, LG.Empty, inp).None?;
              // tr_lkfail: direct, no recursion
              tcan := LT.LKFail(lk, tlkc);
              assert TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b));
            case _ =>
          }
        }
        case Backreference(gid) =>   // not pike
    }
  }

  lemma AtBackForkTreeLkFRec(rer: LW.RegExpRecord, qm: AR.QMap, acts: LS.Actions, code: RB.code,
                          pc: nat, inp: LC.Input, tc: LT.Tree, n: nat)
    returns (tcstar: LT.Tree)
    requires EL.PikeLkActionsRec(acts)
    requires ATR.ActionsRepFuelL(rer, qm, acts, code, pc, n)
    requires WO.WalkOk(acts, code, pc, true)
    requires EL.BoolTreeLk(rer, acts, inp, BS.CanExit, tc)
    requires AR.BackForkAt(code, pc)
    ensures TreeRepLkRE(rer, qm, code, inp, LT.Progress(tcstar), pc, true)
    ensures CE.ProgErase(tcstar) == CE.ProgErase(tc)
    decreases CE.PSize(tc), ATR.MsizeA(acts), n, 0
  {
    var fx: int, fy: int :| NR.GetPcRE(code, pc) == Some(RB.Fork(fx, fy))
      && fx >= 0 && fy >= 0 && (fx as nat <= pc || fy as nat <= pc);
    assert |acts| > 0;
    var cont := acts[1..];
    var pcmid: nat :| AR.ActionRepL(rer, qm, acts[0], code, pc, pcmid)
      && ATR.ActionsRepFuelL(rer, qm, cont, code, pcmid, n - 1);
    EL.PikeLkActionsRecTail(acts);
    assert acts == [acts[0]] + cont;
    EL.PikeLkActionsRecConsIff(acts[0], cont);
    match acts[0]
    case Acheck(strcheck) =>
      // a stacked check: zero-width at the fork; its Progress collapses into
      // the single planted guard
      assert pcmid == pc;
      assert LS.ActionsRegexSize(acts) == LS.ActionsRegexSize(cont);
      match tc {
        case Progress(tc2) =>
          WO.WalkOkAcheckBackFork(acts, code, pc, true);
          tcstar := AtBackForkTreeLkFRec(rer, qm, cont, code, pc, inp, tc2, n - 1);
          assert CE.ProgErase(tc) == CE.ProgErase(tc2);
        case _ =>
      }
    case Aclose(gid) =>
      assert false;   // SetRegisterToCP != Fork
    case Areg(r) =>
      assert EL.PikeLkRegexRec(r);
      match r
      case Epsilon =>
        assert pcmid == pc;
        WO.WalkOkEpsilon(acts, code, pc, true);
        assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
        tcstar := AtBackForkTreeLkFRec(rer, qm, cont, code, pc, inp, tc, n - 1);
      case Character(cd) =>
        var ce :| NR.GetPcRE(code, pc) == Some(RB.Consume(ce)) && AR.ExpectationMatches(rer, ce, cd);
        assert false;   // Consume != Fork
      case AnchorR(la) =>
        var ra: R.anchor :| NR.GetPcRE(code, pc) == Some(RB.AnchorAssertion(ra)) && T.TrAnchor(ra) == la;
        assert false;   // AnchorAssertion != Fork
      case Disjunction(r1, r2) =>
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.Fork(pc + 1, e1 + 1))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.Jmp(pcmid))
          && AR.NfaRepL(rer, qm, r2, code, e1 + 1, pcmid);
        AR.NfaRepIncrL(rer, qm, r1, code, pc + 1, e1);
        assert false;   // both arms forward: contradicts the backward arm
      case Sequence(r1, r2) =>
        EL.PikeLkActionsRecConsIff(LS.Areg(r2), cont);
        EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Areg(r2)] + cont);
        assert AR.NfaRepL(rer, qm, L.Sequence(r1, r2), code, pc, pcmid);
        var e1: nat :| AR.NfaRepL(rer, qm, r1, code, pc, e1) && AR.NfaRepL(rer, qm, r2, code, e1, pcmid);
        var na := [LS.Areg(r1), LS.Areg(r2)] + cont;
        assert na == [LS.Areg(r1)] + ([LS.Areg(r2)] + cont);
        assert AR.ActionRepL(rer, qm, LS.Areg(r2), code, e1, pcmid);
        assert ([LS.Areg(r2)] + cont)[0] == LS.Areg(r2) && ([LS.Areg(r2)] + cont)[1..] == cont;
        ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
        assert AR.ActionsRepL(rer, qm, [LS.Areg(r2)] + cont, code, e1);
        assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, pc, e1);
        assert na[0] == LS.Areg(r1) && na[1..] == [LS.Areg(r2)] + cont;
        assert AR.ActionsRepL(rer, qm, na, code, pc);
        assert LS.ActionsRegexSize(na) < LS.ActionsRegexSize(acts);
        assert ATR.MsizeA(na) < ATR.MsizeA(acts);
        ATR.ActionsRepLToFuel(rer, qm, na, code, pc);
        var nn: nat :| ATR.ActionsRepFuelL(rer, qm, na, code, pc, nn);
        WO.WalkOkSeq(acts, code, pc, true, r1, r2);
        tcstar := AtBackForkTreeLkFRec(rer, qm, na, code, pc, inp, tc, nn);
      case Quantified(greedy, min, delta, r1) =>
        var gidl := L.DefGroups(r1);
        if min > 0 {
          match delta {
            case Inf =>
              var em, e1x := AR.NfaRepLPlusInv(rer, qm, greedy, min, r1, code, pc, pcmid);
              if em == pc {
                assert false;    // SetQuantToClock != Fork
              } else {
                var eb: nat :| (exists qid: int ::
                      NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                      && qid in qm.quants && qm.quants[qid] == gidl)
                  && AR.NfaRepL(rer, qm, r1, code, pc + 1, eb)
                  && AR.NfaRepMinL(rer, qm, min - 2, r1, code, eb, em);
                assert false;    // SetQuantToClock != Fork
              }
            case NN(kx) =>
              var em := AR.NfaRepLQuantInv(rer, qm, greedy, min, kx, r1, code, pc, pcmid);
              var eb: nat :| (exists qid: int ::
                    NR.GetPcRE(code, pc) == Some(RB.SetQuantToClock(qid, false))
                    && qid in qm.quants && qm.quants[qid] == gidl)
                && AR.NfaRepL(rer, qm, r1, code, pc + 1, eb)
                && AR.NfaRepMinL(rer, qm, min - 1, r1, code, eb, em);
              assert false;      // SetQuantToClock != Fork
          }
        } else if delta.NN? {
          var k := delta.n;
          var em := AR.NfaRepLQuantInv(rer, qm, greedy, 0, k, r1, code, pc, pcmid);
          assert em == pc;
          if k == 0 {
            assert pc == pcmid;
            WO.WalkOkQuantSpent(acts, code, pc, true, greedy, r1);
            assert LS.ActionsRegexSize(cont) < LS.ActionsRegexSize(acts);
            assert ATR.MsizeA(cont) < ATR.MsizeA(acts);
            tcstar := AtBackForkTreeLkFRec(rer, qm, cont, code, pc, inp, tc, n - 1);
          } else {
            var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, pcmid) else RB.Fork(pcmid, pc + 1))
              && (exists qid: int ::
                    NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                    && qid in qm.quants && qm.quants[qid] == gidl)
              && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
              && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
              && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
              && AR.NfaRepOptL(rer, qm, k - 1, greedy, r1, code, e1 + 1, pcmid);
            AR.NfaRepIncrL(rer, qm, r1, code, pc + 3, e1);
            AR.NfaRepIncrOptL(rer, qm, k - 1, greedy, r1, code, e1 + 1, pcmid);
            assert false;   // a bounded layer pins a FORWARD fork
          }
        } else {
          assert min == 0 && delta == LN.Inf;
          if exists e1: nat :: NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
                       && (exists qid: int ::
                             NR.GetPcRE(code, pc + 1) == Some(RB.SetQuantToClock(qid, false))
                             && qid in qm.quants && qm.quants[qid] == gidl)
                       && NR.GetPcRE(code, pc + 2) == Some(RB.BeginLoop)
                       && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
                       && NR.GetPcRE(code, e1) == Some(RB.EndLoop)
                       && NR.GetPcRE(code, e1 + 1) == Some(RB.Jmp(pc))
                       && pcmid == e1 + 2 {
            var e1: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(pc + 1, e1 + 2) else RB.Fork(e1 + 2, pc + 1))
              && AR.NfaRepL(rer, qm, r1, code, pc + 3, e1)
              && pcmid == e1 + 2;
            AR.NfaRepIncrL(rer, qm, r1, code, pc + 3, e1);
            assert false;   // the fast path pins a forward fork
          } else {
            // THE LOOP VIEW: the star seen from the fork itself
            assert NUL.NonNullableL(r1);
            var em: nat :| NR.GetPcRE(code, pc) == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em))
              && em <= pc
              && (exists qid: int ::
                    NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
                    && qid in qm.quants && qm.quants[qid] == gidl)
              && AR.NfaRepL(rer, qm, r1, code, em + 1, pc)
              && pcmid == pc + 1;
            var qid: int :| NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid, false))
              && qid in qm.quants && qm.quants[qid] == gidl;
            var q0 := L.Quantified(greedy, 0, FS.NoiPred(delta), r1);
            assert q0 == L.Quantified(greedy, 0, LN.Inf, r1) == r;
            WO.WalkOkLoopView(acts, code, pc, true, greedy, LN.Inf, r1,
                              if greedy then em else pc + 1,
                              if greedy then pc + 1 else em, inp);
            match tc {
              case Choice(cta, ctb) =>
                var itert := if greedy then cta else ctb;
                var skipt := if greedy then ctb else cta;
                match itert {
                  case GroupActionT(g, ti) =>
                    assert g == LG.Reset(gidl);
                    var il := [LS.Areg(r1), LS.Acheck(inp), LS.Areg(q0)] + cont;
                    assert EL.BoolTreeLk(rer, il, inp, BS.CannotExit, ti);
                    // skip branch: the general construction at the exit arm
                    assert CE.PSize(skipt) < CE.PSize(tc);
                    var subs := ActionsTreeRepLkFRec(rer, qm, cont, code, pc + 1, inp, BS.CanExit, skipt, n - 1);
                    // iteration branch: lift to CanExit, then bridge
                    EL.PikeLkActionsRecConsIff(LS.Areg(q0), cont);
                    EL.PikeLkActionsRecConsIff(LS.Acheck(inp), [LS.Areg(q0)] + cont);
                    EL.PikeLkActionsRecConsIff(LS.Areg(r1), [LS.Acheck(inp)] + ([LS.Areg(q0)] + cont));
                    assert il == [LS.Areg(r1)] + ([LS.Acheck(inp)] + ([LS.Areg(q0)] + cont));
                    assert EL.PikeLkActionsRec(il);
                    assert CE.ShieldedActs(il) by {
                      forall i | 0 <= i < |il| && il[i].Acheck?
                        ensures exists j :: 0 <= j < i && il[j].Areg? && NUL.NonNullableL(il[j].r)
                      {
                        assert il[0] == LS.Areg(r1);
                        assert i > 0;
                        assert il[0].Areg? && NUL.NonNullableL(il[0].r);
                      }
                    }
                    CE.BoolFlagLiftRec(rer, il, inp, ti);
                    assert EL.BoolTreeLk(rer, il, inp, BS.CanExit, ti);
                    // representation of the iteration list at em+1
                    ATR.FuelToActionsRepL(rer, qm, cont, code, pcmid, n - 1);
                    var lq := [LS.Areg(q0)] + cont;
                    assert AR.NfaRepL(rer, qm, q0, code, pc, pc + 1) by {
                      assert NUL.NonNullableL(r1)
                        && NR.GetPcRE(code, pc)
                           == Some(if greedy then RB.Fork(em, pc + 1) else RB.Fork(pc + 1, em))
                        && em <= pc
                        && (exists qid2: int ::
                              NR.GetPcRE(code, em) == Some(RB.SetQuantToClock(qid2, false))
                              && qid2 in qm.quants && qm.quants[qid2] == L.DefGroups(r1))
                        && AR.NfaRepL(rer, qm, r1, code, em + 1, pc);
                    }
                    assert AR.ActionRepL(rer, qm, LS.Areg(q0), code, pc, pc + 1);
                    assert lq[0] == LS.Areg(q0) && lq[1..] == cont;
                    assert AR.ActionsRepL(rer, qm, lq, code, pc);
                    var lc := [LS.Acheck(inp)] + lq;
                    assert AR.ActionRepL(rer, qm, LS.Acheck(inp), code, pc, pc);
                    assert lc[0] == LS.Acheck(inp) && lc[1..] == lq;
                    assert AR.ActionsRepL(rer, qm, lc, code, pc);
                    assert AR.ActionRepL(rer, qm, LS.Areg(r1), code, em + 1, pc);
                    assert il == [LS.Areg(r1)] + lc;
                    assert il[0] == LS.Areg(r1) && il[1..] == lc;
                    assert AR.ActionsRepL(rer, qm, il, code, em + 1);
                    ATR.ActionsRepLToFuel(rer, qm, il, code, em + 1);
                    var ni: nat :| ATR.ActionsRepFuelL(rer, qm, il, code, em + 1, ni);
                    assert CE.PSize(ti) < CE.PSize(tc);
                    var subi := ActionsTreeRepLkFRec(rer, qm, il, code, em + 1, inp, BS.CanExit, ti, ni);
                    // assemble: tr_reset at the stamp, then tr_plus at the
                    // fork — arms at (em, true)/(pc+1, true), the planted
                    // Progress consumed with the Choice
                    assert TreeRepLkRE(rer, qm, code, inp, subi, em + 1, true);
                    var iterstar := LT.GroupActionT(g, subi);
                    assert TreeRepLkRE(rer, qm, code, inp, iterstar, em, true);
                    tcstar := if greedy then LT.Choice(iterstar, subs) else LT.Choice(subs, iterstar);
                    assert TreeRepLkRE(rer, qm, code, inp, LT.Progress(tcstar), pc, true);
                    assert CE.ProgErase(iterstar) == CE.ProgErase(itert);
                    assert CE.ProgErase(tcstar) == CE.ProgErase(tc);
                  case _ =>
                }
              case _ =>
            }
          }
        }
      case Group(gid, r1) =>
        var e1: nat :| NR.GetPcRE(code, pc) == Some(RB.SetRegisterToCP(CP.start_reg(gid as int)))
          && AR.NfaRepL(rer, qm, r1, code, pc + 1, e1)
          && NR.GetPcRE(code, e1) == Some(RB.SetRegisterToCP(CP.end_reg(gid as int)))
          && pcmid == e1 + 1;
        assert false;   // SetRegisterToCP != Fork
      case LookaroundR(lk, r1) =>
        var lid: int :| NR.GetPcRE(code, pc)
                          == Some(if AR.PositiveL(lk) then RB.CheckOracle(lid)
                                                      else RB.NegCheckOracle(lid))
                        && lid in qm.looks && qm.looks[lid] == (lk, r1);
        assert false;   // CheckOracle/NegCheckOracle != Fork
      case Backreference(_) =>     // not pike
  }

  lemma ActionsTreeRepLkRERec(rer: LW.RegExpRecord, qm: AR.QMap, acts: LS.Actions, code: RB.code,
                           pc: nat, inp: LC.Input, b: BS.LoopBool, t: LT.Tree)
    returns (tcan: LT.Tree)
    requires EL.PikeLkActionsRec(acts)
    requires AR.ActionsRepL(rer, qm, acts, code, pc)
    requires WO.WalkOk(acts, code, pc, ATR.EaOf(b))
    requires EL.BoolTreeLk(rer, acts, inp, b, t)
    ensures TreeRepLkRE(rer, qm, code, inp, tcan, pc, ATR.EaOf(b))
    ensures CE.ProgErase(tcan) == CE.ProgErase(t)
  {
    ATR.ActionsRepLToFuel(rer, qm, acts, code, pc);
    var n: nat :| ATR.ActionsRepFuelL(rer, qm, acts, code, pc, n);
    tcan := ActionsTreeRepLkFRec(rer, qm, acts, code, pc, inp, b, t, n);
  }



  lemma BlockedRepLkCSnocRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                          inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                          ov: LOr.OracleView, S: set<LG.GroupId>,
                          tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                          tp: (LT.Tree, LG.GroupMap), p: (AI.Thread, RC.char_expectation),
                          ncap: int, nlook: int, nquant: int)
    requires BlockedRepLkCRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl, bl, ncap, nlook, nquant)
    requires p.0.pc >= 0
    requires TreeRepLkRE(rer, qm, code, nextinp, tp.0, (p.0.pc + 1) as nat, true)
    requires exists traw: LT.Tree ::
      CE.ProgErase(traw) == CE.ProgErase(tp.0)
      && WalkPairLkRec(rer, qm, code, nextinp, traw, tp.1, (p.0.pc + 1) as nat, true)
    requires GmtTieOutside(re, p.0, tp.1, S)
    ensures BlockedRepLkCRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl + [tp], bl + [p],
                          ncap, nlook, nquant)
    decreases tl
  {
    if |tl| == 0 {
      assert |bl| == 0;
      assert tl + [tp] == [tp] && bl + [p] == [p];
      assert ([tp])[0] == tp && ([tp])[1..] == [] && ([p])[0] == p && ([p])[1..] == [];
    } else {
      assert |bl| > 0;
      assert (tl + [tp])[0] == tl[0] && (bl + [p])[0] == bl[0];
      assert (tl + [tp])[1..] == tl[1..] + [tp] && (bl + [p])[1..] == bl[1..] + [p];
      BlockedRepLkCSnocRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                        tp, p, ncap, nlook, nquant);
    }
  }


  lemma LiftDropDeadHeadLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                           bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                           vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires |bst.active| > 0
    requires PTL.TreeBfsStepLk(bst.active[0].0, bst.active[0].1, bst.inp) == PT.StepActive([])
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.PikeTreeStepLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // pts_active with an empty successor list: the branch dies on both sides.
    bst1 := PT.PTS(inp, ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert [] + ta[1..] == ta[1..];
    assert PTL.PikeTreeStepLk(bst, bst1);

    // bookkeeping at the successor
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active == s.active[1..];
  }


  lemma ThreadRepLkStepAnchorRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                              inp: LC.Input, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                              S: set<LG.GroupId>, tb: LT.Tree, gm: LG.GroupMap, t: AI.Thread,
                              ncap: int, nlook: int, nquant: int, a: R.anchor)
    requires ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, tb, gm, t, ncap, nlook, nquant)
    requires NR.GetPcRE(code, t.pc as nat) == Some(RB.AnchorAssertion(a))
    requires tb.AnchorPass?     // the anchor is satisfied (else the VM drops the thread)
    ensures ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, tb.t, gm,
                        t.(pc := t.pc + 1), ncap, nlook, nquant)
  {
    WalkPairLkAtAnchorRec(rer, qm, code, inp, tb, gm, t.pc as nat, t.exit_allowed, a);
    assert (t.pc + 1) as nat == (t.pc as nat) + 1;
    // GmtTieOutside/GmtTieInside read only the capture/look/quant regs, unchanged
    // by the pc update, so they transfer verbatim from ThreadRepLkRec(tb, gm, t).
  }


  lemma {:isolate_assertions} ThreadRepLkStepCheckOracleLBRec(
      rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, crv: CP.FCompiled,
      str: string, ov: LOr.OracleView, S: set<LG.GroupId>, lk: L.Lookaround, r1: L.Regex,
      tlk: LT.Tree, tc: LT.Tree, gm: LG.GroupMap, t: AI.Thread, l: int, cp: nat, clk: int,
      body: R.regex, la: R.lookaround, bodycode: RB.code, endl: nat, ngroups: nat,
      qt: AReg.Regs, ncap: int, nlook: int, nquant: int)
    requires qm.ov == ov && !rer.ignoreCase && !rer.multiline
    requires cp <= |str| && t.pc >= 0 && |ov| == |str| + 1
    requires l in qm.looks && qm.looks[l] == (lk, r1)
    requires L.Positivity(lk) && L.LkDir(lk) == WP.Backward
    requires LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).Some?
    requires EL.LkGateOk(rer, lk, r1, PIV.InpOfCp(str, cp), tlk, true)
    requires ThreadRepLkRec(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S,
                         LT.LK(lk, tlk, tc), gm, t, ncap, nlook, nquant)
    requires forall g :: g in L.DefGroups(r1) ==> g !in gm
    // (L4 NESTED) body-fragment weakened to the positive-nesting sub-fragment;
    // the GateStepValueLB backward-replay body package is DROPPED with the call.
    requires T.TransWf(body) && NR.NestedFragmentRE(body) && NR.NegLooksLookFreeRE(body) && la.Lookbehind?
    requires r1 == T.Translate(body) && lk == T.TrLookaround(la)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires 0 <= l < nlook && l < RL.ASize(t.look_regs)
    requires NR.GetPcRE(code, t.pc as nat) == Some(RB.CheckOracle(l))
    requires T.TransWf(re) && NR.NestedFragmentRE(re)
    requires S == LL.LkBodyGroups(T.Translate(re))
    requires (set g | g in L.DefGroups(r1)) <= S
    ensures var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
            var gm2 := LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).value;
            ThreadRepLkRec(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S, tc, gm2, t',
                        ncap, nlook, nquant)
  {
    var inp := PIV.InpOfCp(str, cp);
    var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    // (1) INSIDE tie DROPPED (GmtTieInside is not part of ThreadRepLkRec).
    assert t' == t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    // (2) CONTINUATION walk (direction-generic): from the incoming ThreadRepLk's WalkPairLkRec.
    assert LL.OracleOkAt(rer, qm, inp);
    assert WalkPairLkRec(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed);
    WalkPairLkAtCheckOracleRec(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed, l);
    assert LT.LK(lk, tlk, tc).LK?;        // ⟹ bit true (wrapper: !bit ==> LKFail?)
    assert (t.pc + 1) as nat == (t.pc as nat) + 1 && t'.exit_allowed == t.exit_allowed;
    assert WalkPairLkRec(rer, qm, code, inp, tc, gm2, (t.pc + 1) as nat, t.exit_allowed);
    // (3) OUTSIDE frame: recursive-body confinement (backward gate, PikeLkRegexRec(r1)).
    assert GmtTieOutside(re, t, gm, S);
    EL.TranslateFragmentPikeLkRec(body);  // PikeLkRegexRec(Translate(body)) == PikeLkRegexRec(r1)
    GmtTieOutsideAfterGateNested(rer, re, str, lk, r1, tlk, gm, t, l, cp, clk, S);
  }


  lemma ThreadRepLkStepCheckOracleRec(
      rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, crv: CP.FCompiled,
      str: string, ov: LOr.OracleView, S: set<LG.GroupId>, lk: L.Lookaround, r1: L.Regex,
      tlk: LT.Tree, tc: LT.Tree, gm: LG.GroupMap, t: AI.Thread, l: int, cp: nat, clk: int,
      body: R.regex, la: R.lookaround, bodycode: RB.code, endl: nat, ngroups: nat,
      qt: AReg.Regs, ncap: int, nlook: int, nquant: int)
    requires qm.ov == ov && !rer.ignoreCase && !rer.multiline
    requires cp <= |str| && t.pc >= 0
    requires l in qm.looks && qm.looks[l] == (lk, r1)
    requires L.Positivity(lk) && L.LkDir(lk) == WP.Forward
    requires LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).Some?
    requires EL.LkGateOk(rer, lk, r1, PIV.InpOfCp(str, cp), tlk, true)
    // the paired B-subtree at t.pc is the LK gate node (from TtLkAtCheckOracleRec):
    requires ThreadRepLkRec(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S,
                         LT.LK(lk, tlk, tc), gm, t, ncap, nlook, nquant)
    requires forall g :: g in L.DefGroups(r1) ==> g !in gm        // GateAheadClear at this gate
    // (L4 NESTED) the body may itself contain looks: the depth-1 LookFreeRE(body)
    // is replaced by the positive-nesting sub-fragment (feeds PikeLkRegexRec(r1)
    // for the recursive outside-tie); the GateStepValue body-package requires
    // (StaticOkRE(body)/bodycode/qt/f_look_* rows) are DROPPED with the call.
    requires T.TransWf(body) && NR.NestedFragmentRE(body) && NR.NegLooksLookFreeRE(body) && la.Lookahead?
    requires r1 == T.Translate(body) && lk == T.TrLookaround(la)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires 0 <= l < nlook && l < RL.ASize(t.look_regs)
    // gate position + outside-frame well-formedness (caller supplies); the
    // continuation walk and outside frame are now DERIVED in the body.
    requires NR.GetPcRE(code, t.pc as nat) == Some(RB.CheckOracle(l))
    requires T.TransWf(re) && NR.NestedFragmentRE(re)
    requires S == LL.LkBodyGroups(T.Translate(re))
    requires (set g | g in L.DefGroups(r1)) <= S
    ensures var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
            var gm2 := LS.LkResult(lk, tlk, gm, PIV.InpOfCp(str, cp)).value;
            ThreadRepLkRec(rer, qm, re, code, PIV.InpOfCp(str, cp), crv, str, ov, S, tc, gm2, t',
                        ncap, nlook, nquant)
  {
    var inp := PIV.InpOfCp(str, cp);
    var t' := t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    // (1) INSIDE tie DROPPED (GmtTieInside is not part of ThreadRepLkRec).
    assert t' == t.(pc := t.pc + 1, look_regs := AReg.set_reg(t.look_regs, l, Some(cp as int), clk));
    // (2) CONTINUATION walk: from the incoming ThreadRepLk's WalkPairLkRec on the LK head.
    assert LL.OracleOkAt(rer, qm, inp);   // OracleOkSuffix instantiated at inp
    assert WalkPairLkRec(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed);
    WalkPairLkAtCheckOracleRec(rer, qm, code, inp, LT.LK(lk, tlk, tc), gm, t.pc as nat, t.exit_allowed, l);
    assert LT.LK(lk, tlk, tc).LK?;        // ⟹ bit true (wrapper: !bit ==> LKFail?)
    assert (t.pc + 1) as nat == (t.pc as nat) + 1 && t'.exit_allowed == t.exit_allowed;
    assert WalkPairLkRec(rer, qm, code, inp, tc, gm2, (t.pc + 1) as nat, t.exit_allowed);
    // (3) OUTSIDE frame: recursive-body confinement (PikeLkRegexRec(r1)).
    assert GmtTieOutside(re, t, gm, S);   // from the incoming ThreadRepLkRec(LK, gm, t)
    EL.TranslateFragmentPikeLkRec(body);  // PikeLkRegexRec(Translate(body)) == PikeLkRegexRec(r1)
    GmtTieOutsideAfterGateNested(rer, re, str, lk, r1, tlk, gm, t, l, cp, clk, S);   // GmtTieOutside(t',gm2,S)
  }


  lemma LiftPreserveSkipLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                           bst: PT.PikeTreeState, s: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    ensures PTL.PikeTreeStepLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, s.(active := s.active[1..]),
                    ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;

    // The processed slot resolves LEFT: the stutter escape would need
    // StutterChainTo(pc, pc), impossible in tame code.
    assert AI.bpc_mem(s.processed, pc, ea);
    assert (exists t': LT.Tree :: SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, ea))
        || (TT.StuttersRE(pc, code)
            && exists t': LT.Tree ::
                 PIV.StutterChainTo(code, pc, pc) && Some(t) == Some(t')
                 && TreeRepLkRE(rer, qm, code, inp, t', pc, ea));
    if !(exists t': LT.Tree :: SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, ea)) {
      PIV.NoStutterCycle(code, pc);
      assert false;
    }
    var t': LT.Tree :| SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, ea);
    TreeRepLkDetermRE(rer, qm, code, inp, t, t', pc, ea);
    assert SS.Inseen(seen, t);

    // pts_skip
    bst1 := PT.PTS(inp, ta[1..], best, tb, seen);
    assert PTL.PikeTreeStepLk(bst, bst1);

    // invariant at the successor
    SkipSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc,
                  PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(s.active[1..]));
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
  }


  lemma LiftPreserveStutterLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                              crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                              bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState, th': AI.Thread,
                              vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires (exists x: int ::
                NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Jmp(x))
                && th' == s.active[0].(pc := x))
          || (NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.BeginLoop)
              && th' == s.active[0].(exit_allowed := false, pc := s.active[0].pc + 1))
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);

    // the relocated head pairing
    var pc': nat;
    if exists x: int :: NR.GetPcRE(code, pc) == Some(RB.Jmp(x)) && th' == th.(pc := x) {
      var x: int :| NR.GetPcRE(code, pc) == Some(RB.Jmp(x)) && th' == th.(pc := x);
      TreeRepLkREAtJmp(rer, qm, code, inp, t, pc, ea, x);
      WalkPairLkAtJmpRec(rer, qm, code, inp, traw, gm, pc, ea, x);
      pc' := x as nat;
      assert PIV.StutterSuccIs(code, pc, pc');
    } else {
      TreeRepLkREAtBeginLoop(rer, qm, code, inp, t, pc, ea);
      WalkPairLkAtBeginLoopRec(rer, qm, code, inp, traw, gm, pc, ea);
      pc' := pc + 1;
      assert PIV.StutterSuccIs(code, pc, pc');
    }
    assert th'.pc == pc' as int;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc', th'.exit_allowed);
    assert WalkPairLkRec(rer, qm, code, inp, traw, gm, pc', th'.exit_allowed);
    assert th'.capture_regs == th.capture_regs && th'.look_regs == th.look_regs
        && th'.quant_regs == th.quant_regs;
    assert GmtTieOutside(re, th', gm, S);
    assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th', ncap, nlook, nquant);
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th', ncap, nlook, nquant);

    // active: same (tree, gm) list against the relocated head
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ta == [ta[0]] + ta[1..];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, vms2.active, ncap, nlook, nquant);

    // seen: the escape chain extends by one stutter step
    assert TT.StuttersRE(pc, code);
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    StutterSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea, pc');
    assert PIV.HeadPcOf(vms2.active) == pc';
  }


  lemma LiftPreserveAcceptLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                             crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                             bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                             vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Accept)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [], bestmatch := Some(s.active[0]))
    ensures PTL.PikeTreeStepLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    TreeRepLkREAtAccept(rer, qm, code, inp, t, pc, ea);
    assert t == LT.Match;
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepMatch;

    // pts_match
    bst1 := PT.PTS(inp, [], Some((inp, gm)), tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);

    // the value tie for the recorded best — straight from the head's payload
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    assert GmtTieOutside(re, th, gm, S);
    // (D3) the head's `*Top` carriers feed the best-match tie's `*Top` conjuncts.
    assert LookNestRepCTop(re, S, ta, s.active);
    assert LookNestBackRepCTop(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert LookNestOkTTop(re, S, gm, th);
    assert LookNestBackTTop(re, crv, str, ov, S, gm, th, ncap, nlook, nquant);
    assert BestTieLkNestedTop(re, crv, str, ov, S, Some((inp, gm)), vms2.bestmatch, ncap, nlook, nquant);

    // bookkeeping: seen grows with the memoized head; active empty both sides
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, [], vms2.active, ncap, nlook, nquant);
  }


  lemma LiftPreserveConsumeAddLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                 bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                 ce: RC.char_expectation, vms2: AI.VmState,
                                 ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Consume(ce))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires !AI.pc_mem(s1.isblocked, s.active[0].pc)
    requires vms2 == s1.(blocked := [(s.active[0], ce)] + s1.blocked,
                         isblocked := AI.pc_add(s1.isblocked, s.active[0].pc),
                         active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    TreeRepLkREAtConsume(rer, qm, code, inp, t, pc, ea, ce);

    // shared list bookkeeping
    PSM.ReversePrepend((th, ce), s.blocked);
    PSM.MatchingBlockedSnoc(LC.Reverse(s.blocked), (th, ce), inp);

    // the new isblocked entry pc is covered by the freshly-seen head tree
    assert IsblockedRepLk(rer, qm, code, inp, SS.AddSeenTrees(seen, t), vms2.isblocked) by {
      forall pc0: nat | AI.pc_mem(vms2.isblocked, pc0)
        ensures exists t0: LT.Tree, b0: bool ::
          SS.Inseen(SS.AddSeenTrees(seen, t), t0) && TreeRepLkRE(rer, qm, code, inp, t0, pc0, b0)
      {
        PIV.PcAddMemFwd(s1.isblocked, th.pc, pc0);
        if pc0 == pc {
          SS.InAdd(seen, t, t);
          assert SS.Inseen(SS.AddSeenTrees(seen, t), t) && TreeRepLkRE(rer, qm, code, inp, t, pc0, ea);
        } else {
          assert AI.pc_mem(s.isblocked, pc0);
          var t0: LT.Tree, b0: bool :| SS.Inseen(seen, t0) && TreeRepLkRE(rer, qm, code, inp, t0, pc0, b0);
          SS.InAdd(seen, t0, t);
        }
      }
    }

    if AR.ReadCharE(ce, inp).Some? {
      // MATCHING: pts_blocked pairs the appended entries.
      var (c, nextinp0) := AR.ReadCharE(ce, inp).value;
      assert t.Read? && t.c == c
          && TreeRepLkRE(rer, qm, code, nextinp0, t.t, pc + 1, true);
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepBlocked(t.t);
      bst1 := PT.PTS(inp, ta[1..], best, tb + [(t.t, gm)], SS.AddSeenTrees(seen, t));
      assert PTL.PikeTreeStepLk(bst, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(bst, bst1, bst1);

      // the raw child witness for the blocked pair: the head's raw witness
      // reads the same character (erasure pins the Read root)
      var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
        && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
      assert WalkPairLkRec(rer, qm, code, inp, traw, gm, pc, ea);
      WalkPairLkAtConsumeRec(rer, qm, code, inp, traw, gm, pc, ea, ce);
      assert traw.Read? by {
        if !traw.Read? {
          assert traw == LT.Mismatch;
          assert CE.ProgErase(traw) == LT.Mismatch;
          assert CE.ProgErase(t).Read?;
          assert false;
        }
      }
      var nextinpw: LC.Input :| AR.ReadCharE(ce, inp) == Some((traw.c, nextinpw))
        && WalkPairLkRec(rer, qm, code, nextinpw, traw.t, gm, pc + 1, true);
      assert traw.c == c && nextinpw == nextinp0;    // ReadCharE is a function
      assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
        assert CE.ProgErase(traw) == LT.Read(traw.c, CE.ProgErase(traw.t));
        assert CE.ProgErase(t) == LT.Read(t.c, CE.ProgErase(t.t));
      }

      // blocked correspondence: the filter gains exactly the new pair
      forall nextinp | LC.AdvanceInput(inp, WP.Forward) == Some(nextinp)
        ensures BlockedRepLkCRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tb + [(t.t, gm)],
                              PIV.MatchingBlocked(LC.Reverse(vms2.blocked), inp), ncap, nlook, nquant)
      {
        assert nextinp == nextinp0;
        assert PIV.MatchingBlocked(LC.Reverse(vms2.blocked), inp)
            == PIV.MatchingBlocked(LC.Reverse(s.blocked), inp) + [(th, ce)];
        assert GmtTieOutside(re, th, gm, S);
        BlockedRepLkCSnocRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tb,
                          PIV.MatchingBlocked(LC.Reverse(s.blocked), inp), (t.t, gm), (th, ce),
                          ncap, nlook, nquant);
      }
      assert |inp.next| > 0;                          // ReadCharE Some
      assert LC.AdvanceInput(inp, WP.Forward).Some?;

      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
      assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert vms2.active == s.active[1..];
    } else {
      // MISMATCH: the tree is Mismatch and dies; the doomed blocked thread is
      // invisible to the filter.
      assert t == LT.Mismatch;
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([]);
      bst1 := PT.PTS(inp, ta[1..], best, tb, SS.AddSeenTrees(seen, t));
      assert [] + ta[1..] == ta[1..];
      assert PTL.PikeTreeStepLk(bst, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(bst, bst1, bst1);

      assert PIV.MatchingBlocked(LC.Reverse(vms2.blocked), inp)
          == PIV.MatchingBlocked(LC.Reverse(s.blocked), inp);

      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
      assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert vms2.active == s.active[1..];
    }
  }


  lemma LiftPreserveConsumeDropLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  ce: RC.char_expectation, vms2: AI.VmState,
                                  ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Consume(ce))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires AI.pc_mem(s1.isblocked, s.active[0].pc)
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // the blocked pc's memoized canonical tree IS the head's — the Consume
    // rules are flag-independent, so the recorded flag transfers.
    assert IsblockedRepLk(rer, qm, code, inp, seen, s.isblocked);
    assert AI.pc_mem(s.isblocked, th.pc) && th.pc == pc as int;
    assert AI.pc_mem(s.isblocked, pc);
    var t': LT.Tree, b': bool :| SS.Inseen(seen, t') && TreeRepLkRE(rer, qm, code, inp, t', pc, b');
    TreeRepLkREAtConsume(rer, qm, code, inp, t', pc, b', ce);
    assert TreeRepLkRE(rer, qm, code, inp, t', pc, ea) by {
      match AR.ReadCharE(ce, inp) {
        case None =>
          assert t' == LT.Mismatch;      // tr_readfail — flag-independent
        case Some(pair) =>
          assert t'.Read? && t'.c == pair.0
              && TreeRepLkRE(rer, qm, code, pair.1, t'.t, pc + 1, true);   // tr_read — flag-independent
      }
    }
    TreeRepLkDetermRE(rer, qm, code, inp, t, t', pc, ea);
    assert SS.Inseen(seen, t);

    // pts_skip
    bst1 := PT.PTS(inp, ta[1..], best, tb, seen);
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // bookkeeping: the new processed slot's tree is already memoized
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    SeenAddProcessedSlotRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                              PIV.HdTreeOf(ta[1..]), PIV.HeadPcOf(vms2.active));
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active == s.active[1..];
  }


  lemma LiftPreserveSetRegLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                             crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                             bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                             reg: int, th': AI.Thread, vms2: AI.VmState,
                             ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetRegisterToCP(reg))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(capture_regs := AReg.set_reg(s.active[0].capture_regs, reg, Some(s1.cp), s1.clock),
                                 pc := s.active[0].pc + 1)
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    // the value-tie boundary: SetReg gids are outside-look, hence outside S
    requires S == PIV.CapIdsInLooks(re)
    requires reg >= 0 && 0 <= s1.cp
    // (E3) freshness feed for the look-path carrier (from PikeInvFullRE's BBOf)
    requires s.clock >= 0 && CM.ThreadClocksLE(s.active[0], s.clock)
    // the register-level gm effect, supplied by the dispatcher from machine A's
    // proven step helpers (OpenStepThreadRE/CloseStepThreadRE)
    requires PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
          == (if reg % 2 == 0
              then LG.GMOpen(s1.cp as nat, (reg / 2) as nat,
                             PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                          s.active[0].quant_regs))
              else LG.GMClose(s1.cp as nat, (reg / 2) as nat,
                              PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                           s.active[0].quant_regs)))
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // canonical head: GroupActionT(Open/Close) with canonical child at (pc+1, ea)
    TreeRepLkREAtSetReg(rer, qm, code, inp, t, pc, ea, reg);
    assert t.GroupActionT? && (t.g.Open? || t.g.Close?);
    assert TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);
    var gid: LG.GroupId := t.g.g;

    // position: the B-side update index IS the VM's cp
    assert 0 <= s.cp <= |str| && inp == PIV.InpOfCp(str, s.cp);
    PIV.IdxInpOfCp(str, s.cp);
    var cpn: nat := s1.cp as nat;
    assert LC.Idx(inp) == cpn;
    var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);

    // the written gid is outside-look, hence outside S
    assert pc < endl by {
      TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
      assert pc < |code| == endl + 1;
      if pc == endl {
        assert NR.GetPcRE(code, pc) == Some(RB.Accept);
        assert false;
      }
    }
    var OL := PIV.CapIdsOutsideLooks(re);
    PIV.CaptureWriteIdsOutsideRENested(re, code, 0, endl, pc);
    assert reg in PIV.CaptureRegsSet(OL);
    assert gid in OL by {
      if t.g.Open? { assert reg == CP.start_reg(gid as int) == 2 * (gid as int); }
      else { assert reg == CP.end_reg(gid as int) == 2 * (gid as int) + 1; }
      if reg in (set cid: nat | cid in OL :: CP.start_reg(cid)) {
        var cid: nat :| cid in OL && reg == CP.start_reg(cid);
        assert reg == 2 * (cid as int);
        assert t.g.Open?;                              // parity
        assert cid == gid;
      } else {
        var cid: nat :| cid in OL && reg == CP.end_reg(cid);
        assert reg == 2 * (cid as int) + 1;
        assert t.g.Close?;                             // parity
        assert cid == gid;
      }
    }
    PIV.CapIdsLooksDisjoint(re);
    assert gid !in S by {
      if gid in PIV.CapIdsInLooks(re) { assert gid in OL * PIV.CapIdsInLooks(re); }
    }

    // B step: pts_active queues the child with the GMUpdate-moved gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm2)]);
    bst1 := PT.PTS(inp, [(t.t, gm2)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // raw witness: its walk peels the same GroupActionT (same reg pins the
    // same action via the erasure congruence), child walks at gm2
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtSetRegRec(rer, qm, code, inp, traw, gm, pc, ea, reg);
    assert traw.GroupActionT?;
    assert traw.g == t.g && CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.GroupActionT(traw.g, CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.GroupActionT(t.g, CE.ProgErase(t.t));
    }
    assert WalkPairLkRec(rer, qm, code, inp, traw.t, gm2, pc + 1, ea);

    // value ties for th': both sides move by the SAME GMUpdate at cpn
    var gml := PIV.GmOfLive(re, th.capture_regs, th.look_regs, th.quant_regs);
    var gml2 := PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs);
    assert gml2 == LG.GMUpdate(t.g, cpn, gml) by {
      if t.g.Open? {
        assert reg == 2 * (gid as int);
        assert reg % 2 == 0 && (reg / 2) as nat == gid;
      } else {
        assert reg == 2 * (gid as int) + 1;
        assert reg % 2 == 1 && (reg / 2) as nat == gid;
      }
    }
    assert gm2 == LG.GMUpdate(t.g, cpn, gm);
    assert GmtTieOutside(re, th, gm, S);

    assert GmtTieOutside(re, th', gm2, S) by {
      forall g: LG.GroupId | g !in S
        ensures (g in gm2 <==> g in gml2) && (g in gm2 ==> gm2[g] == gml2[g])
      {
        assert (g in gm <==> g in gml) && (g in gm ==> gm[g] == gml[g]);
        if g == gid {
          if t.g.Close? {
            // GMClose reads the incoming entry — it agrees on both sides
            assert (gid in gm <==> gid in gml) && (gid in gm ==> gm[gid] == gml[gid]);
          }
        }
        // g != gid: GMUpdate touches only gid, both maps unchanged at g
      }
    }
    assert th'.look_regs == th.look_regs && th'.quant_regs == th.quant_regs;
    assert (th.pc + 1) as nat == pc + 1;
    assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm2, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm2)] + ta[1..])[0] == (t.t, gm2) && ([(t.t, gm2)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // ---- (E3) the look-path carrier: fresh cap stamp, no new inside-S group ----
    assert LookNestRepCTop(re, S, ta, s.active);
    assert LookNestOkTTop(re, S, gm, th);
    var Bc := s1.clock;
    assert forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= Bc by {
      assert CM.RegsClocksLE(th.quant_regs, s.clock);
    }
    assert forall j: int ::
      AI.get_idx(th'.capture_regs.a_clk, j) == AI.get_idx(th.capture_regs.a_clk, j)
      || (AI.get_idx(th'.capture_regs.a_clk, j) >= 0 && AI.get_idx(th'.capture_regs.a_clk, j) >= Bc)
    by {
      RL.ASetLaws(th.capture_regs, reg, Some(s1.cp), s1.clock);
    }
    assert forall g: LG.GroupId :: g in S && g in gm2 ==> g in gm by {
      forall g: LG.GroupId | g in S && g in gm2 ensures g in gm {
        assert g != gid;
      }
    }
    LookNestOkTFreshCapTop(re, S, gm, gm2, th, th', Bc);
    assert LookNestRepCTop(re, S, [(t.t, gm2)] + ta[1..], vms2.active) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestOkTTop(re, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i])
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // ---- (E4) the converse carrier: look/quant banks untouched, gm grows ----
    assert LookNestBackRepCTop(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert forall g: LG.GroupId :: g in gm ==> g in gm2;   // GMOpen adds / GMClose keeps domain
    LookNestBackTRegSameTop(re, crv, str, ov, S, gm, gm2, th, th', ncap, nlook, nquant);
    assert LookNestBackRepCTop(re, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                            ncap, nlook, nquant) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestBackTTop(re, crv, str, ov, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i],
                              ncap, nlook, nquant)
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm2)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }


  lemma LiftPreserveSetQuantLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                               crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                               bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                               q: int, bq: bool, th': AI.Thread, vms2: AI.VmState,
                               ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.SetQuantToClock(q, bq))
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(quant_regs := AReg.set_reg(s.active[0].quant_regs, q,
                                                            if bq then Some(s1.cp) else None, s1.clock),
                                 pc := s.active[0].pc + 1)
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    // the register-level gm effect, supplied by the dispatcher from machine A's
    // proven step helper (ResetStepThreadRE); q's table binding rides along
    requires q in qm.quants
    // (E3) look-id uniqueness (cross-lid ownership pinning for the carrier)
    requires LTB.LookUnique(re)
    // (E4) converse-carrier feeds
    requires PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires CM.ThreadRegsWf(s.active[0], ncap, nlook, nquant)
    requires s.clock >= 0 && CM.ThreadClocksLE(s.active[0], s.clock)
    requires PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs)
          == LG.GMReset(qm.quants[q],
                        PIV.GmOfLive(re, s.active[0].capture_regs, s.active[0].look_regs,
                                     s.active[0].quant_regs))
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // canonical head: Reset(qm.quants[q]) with canonical child at (pc+1, ea);
    // pins !bq (compiled SQC sites always write false)
    TreeRepLkREAtSetQuant(rer, qm, code, inp, t, pc, ea, q, bq);
    assert !bq;
    var gidl := qm.quants[q];
    assert t.GroupActionT? && t.g == LG.Reset(gidl);
    assert TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    var gm2 := LG.GMUpdate(t.g, LC.Idx(inp), gm);
    assert gm2 == LG.GMReset(gidl, gm);

    // B step: pts_active queues the child with the Reset-moved gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm2)]);
    bst1 := PT.PTS(inp, [(t.t, gm2)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // raw witness: same Reset head via the SetQuant walk wrapper
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtSetQuantRec(rer, qm, code, inp, traw, gm, pc, ea, q);
    assert traw.GroupActionT? && traw.g == LG.Reset(gidl) == t.g;
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.GroupActionT(traw.g, CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.GroupActionT(t.g, CE.ProgErase(t.t));
    }
    assert WalkPairLkRec(rer, qm, code, inp, traw.t, gm2, pc + 1, ea);

    // value ties: both maps shed the SAME set(gidl); everything else unchanged
    var gml := PIV.GmOfLive(re, th.capture_regs, th.look_regs, th.quant_regs);
    var gml2 := PIV.GmOfLive(re, th'.capture_regs, th'.look_regs, th'.quant_regs);
    assert gml2 == LG.GMReset(gidl, gml);
    assert GmtTieOutside(re, th, gm, S);

    assert GmtTieOutside(re, th', gm2, S) by {
      forall g: LG.GroupId | g !in S
        ensures (g in gm2 <==> g in gml2) && (g in gm2 ==> gm2[g] == gml2[g])
      {
        assert (g in gm <==> g in gml) && (g in gm ==> gm[g] == gml[g]);
      }
    }
    assert th'.look_regs == th.look_regs;
    assert (th.pc + 1) as nat == pc + 1;
    assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm2, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm2)] + ta[1..])[0] == (t.t, gm2) && ([(t.t, gm2)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // ---- (E3) the look-path carrier: the Reset vacates on-path lids ----
    assert LookNestRepCTop(re, S, ta, s.active);
    assert LookNestOkTTop(re, S, gm, th);
    assert pc < endl by {
      TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
      assert pc < |code| == endl + 1;
      if pc == endl { assert NR.GetPcRE(code, pc) == Some(RB.Accept); assert false; }
    }
    PIV.QuantWriteIdsRENested(re, code, 0, endl, pc);
    assert q >= 0 && (q as nat) in PIV.QuantIds(re);
    var qn: nat := q as nat;
    M.TransWfQidBody(re, qn);
    QmapOkAtQid(re, qm, qn);
    assert gidl == L.DefGroups(T.Translate(PIV.QidBody(re, qn)));
    M.TranslateDefGroupsEqCapIds(PIV.QidBody(re, qn));
    assert forall g: nat :: g in PIV.CapIds(PIV.QidBody(re, qn)) ==> g !in gm2 by {
      forall g: nat | g in PIV.CapIds(PIV.QidBody(re, qn)) ensures g !in gm2 {
        assert g in (set gx | gx in L.DefGroups(T.Translate(PIV.QidBody(re, qn))));
        assert g in gidl;                        // seq membership via the set identity
      }
    }
    assert forall g: LG.GroupId :: g in gm2 ==> g in gm;   // GMReset only removes
    assert forall j: int :: j != q ==>
      AI.get_idx(th'.quant_regs.a_clk, j) == AI.get_idx(th.quant_regs.a_clk, j)
    by { RL.ASetLaws(th.quant_regs, q, if bq then Some(s1.cp) else None, s1.clock); }
    LookNestOkTSetQuantTop(re, S, gm, gm2, th, th', qn);
    assert LookNestRepCTop(re, S, [(t.t, gm2)] + ta[1..], vms2.active) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestOkTTop(re, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i])
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // ---- (E4) converse: on-path dominance breaks; off-path scopes disjoint ----
    assert LookNestBackRepCTop(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert 0 <= q < nquant by {
      NI.QuantIdsLEMaxQuant(re);
      assert (q as nat) <= R.max_quant(re);
    }
    assert AI.get_idx(th'.quant_regs.a_clk, q) == s1.clock by {
      assert |th.quant_regs.a_clk| == nquant;
      RL.ASetLaws(th.quant_regs, q, if bq then Some(s1.cp) else None, s1.clock);
    }
    assert forall j: int :: AI.get_idx(th.look_regs.a_clk, j) < AI.get_idx(th'.quant_regs.a_clk, q as int) by {
      assert CM.RegsClocksLE(th.look_regs, s.clock);
    }
    assert forall g: LG.GroupId :: g in gm && g !in PIV.CapIds(PIV.QidBody(re, qn)) ==> g in gm2 by {
      forall g: LG.GroupId | g in gm && g !in PIV.CapIds(PIV.QidBody(re, qn))
        ensures g in gm2
      {
        assert g !in (set gx | gx in gidl);
        assert g !in gidl;
      }
    }
    LookNestBackTSetQuantNestedTop(re, crv, str, ov, S, gm, gm2, th, th', qn, ncap, nlook, nquant);
    assert LookNestBackRepCTop(re, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                            ncap, nlook, nquant) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestBackTTop(re, crv, str, ov, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i],
                              ncap, nlook, nquant)
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm2)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }


  lemma LiftPreserveForkLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                           bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                           x: int, y: int, vms2: AI.VmState,
                           ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.Fork(x, y))
    // backward-fork flag pin (the dispatcher discharges it from EaColdOkRE)
    requires (x <= s.active[0].pc || y <= s.active[0].pc) ==> s.active[0].exit_allowed
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [AI.Thread(x, s.active[0].capture_regs, s.active[0].look_regs,
                                              s.active[0].quant_regs, s.active[0].exit_allowed),
                                    s.active[0].(pc := y)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tbl, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);
    TreeRepLkREAtFork(rer, qm, code, inp, t, pc, ea, x, y);
    assert x >= 0 && y >= 0;
    var th1 := AI.Thread(x, th.capture_regs, th.look_regs, th.quant_regs, ea);
    var th2 := th.(pc := y);
    assert vms2.active == [th1, th2] + s.active[1..];

    // raw witness + its arms (erased-Choice existential)
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtForkArmsRec(rer, qm, code, inp, traw, gm, pc, ea, x, y);

    // value ties carry: both arm threads keep th's registers
    assert GmtTieOutside(re, th, gm, S);
    assert th1.capture_regs == th.capture_regs && th1.look_regs == th.look_regs
        && th1.quant_regs == th.quant_regs;
    assert GmtTieOutside(re, th1, gm, S);
    assert GmtTieOutside(re, th2, gm, S);

    if x as nat > pc && y as nat > pc {
      // ---- FORWARD: canonical Choice; one B step -------------------------
      assert t.Choice?
          && TreeRepLkRE(rer, qm, code, inp, t.t1, x as nat, ea)
          && TreeRepLkRE(rer, qm, code, inp, t.t2, y as nat, ea);
      assert CE.ProgErase(traw) == LT.Choice(CE.ProgErase(t.t1), CE.ProgErase(t.t2));
      assert CE.ProgErase(traw) != LT.Mismatch;
      var ta1: LT.Tree, ta2: LT.Tree :|
        CE.ProgErase(traw) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
        && WalkPairLkRec(rer, qm, code, inp, ta1, gm, x as nat, ea)
        && WalkPairLkRec(rer, qm, code, inp, ta2, gm, y as nat, ea);
      assert CE.ProgErase(ta1) == CE.ProgErase(t.t1) && CE.ProgErase(ta2) == CE.ProgErase(t.t2);
      assert th1.pc >= 0 && th2.pc >= 0;
      assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, ta1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, ta2, gm, th2, ncap, nlook, nquant);
      assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t2, gm, th2, ncap, nlook, nquant);

      var na := [(t.t1, gm), (t.t2, gm)];
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive(na);
      bst1 := PT.PTS(inp, na + ta[1..], best, tbl, SS.AddSeenTrees(seen, t));
      assert PTL.PikeTreeStepLk(bst, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(bst, bst1, bst1);

      assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert (na + ta[1..])[0] == (t.t1, gm) && (na + ta[1..])[1..] == [(t.t2, gm)] + ta[1..];
      assert ([(t.t2, gm)] + ta[1..])[0] == (t.t2, gm) && ([(t.t2, gm)] + ta[1..])[1..] == ta[1..];
      assert vms2.active[0] == th1 && vms2.active[1..] == [th2] + s.active[1..];
      assert ([th2] + s.active[1..])[0] == th2 && ([th2] + s.active[1..])[1..] == s.active[1..];
      assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, na + ta[1..], vms2.active,
                          ncap, nlook, nquant);

      assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(na + ta[1..]), PIV.HeadPcOf(vms2.active));
      IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
    } else {
      // ---- BACKWARD (do-while): ea pinned; TWO B steps -------------------
      assert ea;
      assert t.Progress? && t.t.Choice?
          && TreeRepLkRE(rer, qm, code, inp, t.t.t1, x as nat, true)
          && TreeRepLkRE(rer, qm, code, inp, t.t.t2, y as nat, true);
      assert CE.ProgErase(t) == LT.Choice(CE.ProgErase(t.t.t1), CE.ProgErase(t.t.t2));
      assert CE.ProgErase(traw) != LT.Mismatch;
      var ta1: LT.Tree, ta2: LT.Tree :|
        CE.ProgErase(traw) == LT.Choice(CE.ProgErase(ta1), CE.ProgErase(ta2))
        && WalkPairLkRec(rer, qm, code, inp, ta1, gm, x as nat, ea)
        && WalkPairLkRec(rer, qm, code, inp, ta2, gm, y as nat, ea);
      assert CE.ProgErase(ta1) == CE.ProgErase(t.t.t1) && CE.ProgErase(ta2) == CE.ProgErase(t.t.t2);
      assert th1.pc >= 0 && th2.pc >= 0 && th1.exit_allowed && th2.exit_allowed;
      assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, ta1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, ta2, gm, th2, ncap, nlook, nquant);
      assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t.t1, gm, th1, ncap, nlook, nquant);
      assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t.t2, gm, th2, ncap, nlook, nquant);

      var mta := [(t.t, gm)] + ta[1..];
      assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
      var mid := PT.PTS(inp, mta, best, tbl, SS.AddSeenTrees(seen, t));
      assert PTL.PikeTreeStepLk(bst, mid);
      var na := [(t.t.t1, gm), (t.t.t2, gm)];
      assert mta[0] == (t.t, gm) && mta[1..] == ta[1..];
      assert PTL.TreeBfsStepLk(t.t, gm, inp) == PT.StepActive(na);
      bst1 := PT.PTS(inp, na + ta[1..], best, tbl,
                     SS.AddSeenTrees(SS.AddSeenTrees(seen, t), t.t));
      assert PTL.PikeTreeStepLk(mid, bst1);
      TrcLkRefl(bst1);
      TrcLkCons(mid, bst1, bst1);
      TrcLkCons(bst, mid, bst1);

      assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                          ncap, nlook, nquant);
      assert (na + ta[1..])[0] == (t.t.t1, gm) && (na + ta[1..])[1..] == [(t.t.t2, gm)] + ta[1..];
      assert ([(t.t.t2, gm)] + ta[1..])[0] == (t.t.t2, gm) && ([(t.t.t2, gm)] + ta[1..])[1..] == ta[1..];
      assert vms2.active[0] == th1 && vms2.active[1..] == [th2] + s.active[1..];
      assert ([th2] + s.active[1..])[0] == th2 && ([th2] + s.active[1..])[1..] == s.active[1..];
      assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, na + ta[1..], vms2.active,
                          ncap, nlook, nquant);

      assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
      AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                   PIV.HdTreeOf(na + ta[1..]), PIV.HeadPcOf(vms2.active));
      SeenGrowSeenRepLk(rer, qm, code, inp, SS.AddSeenTrees(seen, t),
                        AI.bpc_add(s.processed, th.pc, ea), t.t,
                        PIV.HdTreeOf(na + ta[1..]), PIV.HeadPcOf(vms2.active));
      IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
      IsblockedGrowLk(rer, qm, code, inp, SS.AddSeenTrees(seen, t), s.isblocked, t.t);
    }
  }


  /** (BRICK D5) The (E4) INSIDE-look coverage VACATOR for the gate-pass preserver.
      The FRESH body match of a nested positive-lookAHEAD body records NONE of its
      INNER-look capture groups (a lookaround compiles to a single `CheckOracle`
      leaf, so the body's MAIN pass never writes inner-look captures), so those
      groups are ABSENT from `GmOfLive(body, rf)`. Proof: the body's main pass
      writes only OUTSIDE-look capture registers (`M.MainMatchInsideCapsInitNested`),
      leaving the inside-look start clocks at their `-1` init (`PIV.LooksCapUnset`,
      via the outside/inside register PARITY), and `PIV.GmOfLiveInsideLookAbsent`
      then drops each such group. The `FInitState` preconditions of
      `M.FFindMatchThreadFacts` (for `CapRegWf`) + `M.MainMatchInsideCapsInitNested`
      are discharged verbatim off the fresh-entry VM (mirror
      `LookNestOkTFromBodyReplay` / `L3aEndpointAssembly`). This complements
      `M.LkReplayMatchesSpecNested` (which covers the OUTER groups
      `DefGroups(tr) \ LkBodyGroups(tr)`) to close the WHOLE `CapIds(body)` in the
      backward (E4) crossing arm. */
  lemma FreshBodyMatchGmOuter(
      qm: AR.QMap, body: R.regex, bodycode: RB.code, endl: nat,
      str: string, cp: nat, ov: LOr.OracleView, cdn: LCdn.cdns,
      ncap: int, nlook: int, nquant: int)
    requires PSM.StaticOkNestedRE(qm, body, bodycode, endl)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    ensures
      var rf := AI.FFindMatch(bodycode, str,
                  AI.FInitState(bodycode, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                  ov, LAnc.Forward, cdn).0;
      rf.Some? ==>
        forall g: nat :: g in PIV.CapIdsInLooks(body) ==>
          g !in PIV.GmOfLive(body, rf.value.capture_regs, rf.value.look_regs, rf.value.quant_regs)
  {
    var ctx := AI.cp_context(cp, str, LAnc.Forward);
    var capture := AReg.init_regs(ncap);
    var look := AReg.init_regs(nlook);
    var quant := AReg.init_regs(nquant);
    var vms := AI.FInitState(bodycode, cp, capture, look, quant, 0, ctx);
    assert ctx.nextchar == AI.get_char(str, cp);

    // code shape: every SetQuantToClock has b == false (mirror LookNestOkTFromBodyReplay)
    forall pc: nat, q: int, b: bool | NR.GetPcRE(bodycode, pc) == Some(RB.SetQuantToClock(q, b))
      ensures !b
    {
      if pc < endl {
        NI.CodeShapeAt(body, bodycode, 0, endl, pc);
      } else if pc == endl {
      } else {
        assert pc >= |bodycode|;
      }
    }

    // fresh-entry engine facts: winning-thread register wf + quant-final.
    CM.RegsClocksLEInit(ncap, 0);
    CM.RegsClocksLEInit(nlook, 0);
    CM.RegsClocksLEInit(nquant, 0);
    CM.FInitStateClocksLE(bodycode, cp, capture, look, quant, 0, ctx);
    CM.FInitStateRegsWf(bodycode, cp, ncap, nlook, nquant, 0, ctx);
    assert M.VmQuantFinal(vms) by {
      var th0 := AI.init_thread(capture, look, quant);
      assert M.QuantRegsFinal(th0) by {
        forall k ensures AI.get_idx(quant.a_cp, k) < 0 && AI.get_idx(quant.a_clk, k) >= -1 {
          if 0 <= k < |quant.a_cp| { assert quant.a_cp[k] == -1; }
          if 0 <= k < |quant.a_clk| { assert quant.a_clk[k] == -1; }
        }
      }
      forall t2 | t2 in vms.active ensures M.QuantRegsFinal(t2) { assert t2 == th0; }
    }

    var rf := AI.FFindMatch(bodycode, str, vms, ov, LAnc.Forward, cdn).0;
    M.FFindMatchThreadFacts(bodycode, str, vms, ov, LAnc.Forward, cdn, ncap, nlook, nquant);
    M.MainMatchInsideCapsInitNested(body, bodycode, endl, str, vms, capture, look, quant, ov, cdn, rf);

    if rf.Some? {
      var caps := rf.value.capture_regs;
      var Sc := PIV.CaptureRegsSet(PIV.CapIdsOutsideLooks(body));
      assert CM.RegsAgreeOutside(caps, capture, Sc);         // MainMatchInsideCapsInitNested
      assert CM.ThreadRegsWf(rf.value, ncap, nlook, nquant);  // FFindMatchThreadFacts
      assert PIV.CapRegWf(caps);
      PIV.CapIdsLooksDisjoint(body);

      // inside-look start slots are OUTSIDE `Sc` (parity + disjointness), so they
      // remain at their -1 init: LooksCapUnset(body, caps.a_clk).
      assert PIV.LooksCapUnset(body, caps.a_clk) by {
        forall c: nat | c in PIV.CapIdsInLooks(body)
          ensures AI.get_idx(caps.a_clk, CP.start_reg(c)) < 0
        {
          assert CP.start_reg(c as int) !in Sc by {
            if CP.start_reg(c as int) in Sc {
              if CP.start_reg(c as int) in (set cid | cid in PIV.CapIdsOutsideLooks(body) :: CP.start_reg(cid as int)) {
                var cid: nat :| cid in PIV.CapIdsOutsideLooks(body) && CP.start_reg(cid as int) == CP.start_reg(c as int);
                assert cid == c;
                assert c in PIV.CapIdsOutsideLooks(body) * PIV.CapIdsInLooks(body);
              } else {
                var cid: nat :| cid in PIV.CapIdsOutsideLooks(body) && CP.end_reg(cid as int) == CP.start_reg(c as int);
                assert 2 * (cid as int) + 1 == 2 * (c as int);
              }
              assert false;
            }
          }
          assert AI.get_idx(caps.a_clk, CP.start_reg(c as int))
              == AI.get_idx(capture.a_clk, CP.start_reg(c as int));   // RegsAgreeOutside off Sc
          RL.AInitLaws(ncap);                                          // init clock == -1
        }
      }

      forall g: nat | g in PIV.CapIdsInLooks(body)
        ensures g !in PIV.GmOfLive(body, caps, rf.value.look_regs, rf.value.quant_regs)
      {
        PIV.GmOfLiveInsideLookAbsent(body, caps, rf.value.look_regs, rf.value.quant_regs, g);
      }
    }
  }


  lemma {:isolate_assertions} LiftPreserveGatePassLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                               crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                               bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                               l: int, th': AI.Thread, vms2: AI.VmState,
                               ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires |ov| == |str| + 1                                    // L3b: the backward LB gate needs the mirror
    requires S == PIV.CapIdsInLooks(re)
    // (BRICK D5) NON-VACUITY FLIP: the driver's per-lid static package is the
    // depth-AGNOSTIC `GateStaticsOkNested` (nested gate bodies), qualified by the
    // positive-lookahead-nesting scope `M.NoPosLookbehindRE(re)` — the composite
    // sim is now non-vacuous at nesting depth >= 2.
    requires GateStaticsOkNested(qm, re, crv, ncap, nlook, nquant)
    requires M.NoPosLookbehindRE(re)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires CM.ThreadRegsWf(s.active[0], ncap, nlook, nquant)
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.CheckOracle(l))
    requires LOr.view_get_oracle(ov, s.cp, l)
    // (E3) carrier feeds: freshness, positional invariant, look uniqueness
    requires s.clock >= 0 && CM.ThreadClocksLE(s.active[0], s.clock)
    requires PSM.ThreadNestRE(re, code, endl, s.active[0].pc, s.active[0])
    requires LTB.LookUnique(re)
    // (E4) the row↔structure tie for the converse coverage
    requires LTB.LookTablesOk(re, crv)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires th' == s.active[0].(pc := s.active[0].pc + 1,
                                 look_regs := AReg.set_reg(s.active[0].look_regs, l, Some(s1.cp), s1.clock))
    requires vms2 == s1.(active := [th'] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    // (L4 NESTED) NestedFragmentRE(re) is now DIRECT from StaticOkNestedRE
    var PTS(inp, ta, best, tbl, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // gate pc interior + polarity pin
    TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
    assert |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept);
    assert pc < endl;
    GatePolarityRE(re, qm, code, 0, endl, pc);
    assert l in qm.looks;
    var lk := qm.looks[l].0;
    var r1 := qm.looks[l].1;
    assert AR.PositiveL(lk) && L.Positivity(lk);

    // position glue
    assert 0 <= s.cp <= |str| && inp == PIV.InpOfCp(str, s.cp);
    var cp: nat := s.cp as nat;
    PIV.IdxInpOfCp(str, cp);
    assert TREP.CpOf(inp) == cp && TR_CpOf(inp) == cp;
    assert LL.OracleOkAt(rer, qm, inp);

    // raw witness at the gate: the walk lemma keys on the (true) oracle bit
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    assert WalkPairLkRec(rer, qm, code, inp, traw, gm, pc, ea);
    WalkPairLkAtCheckOracleRec(rer, qm, code, inp, traw, gm, pc, ea, l);
    assert LOr.view_get_oracle(qm.ov, TR_CpOf(inp), l);
    assert traw.LK? && traw.lk == lk;
    assert EL.LkGateOk(rer, lk, r1, inp, traw.tlk, true);
    var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    assert traw.tlk == tlk;                                   // LkGateOk pins tlk functionally
    assert LS.LkResult(lk, tlk, LG.Empty, inp).Some?;
    assert LS.LkResult(lk, tlk, gm, inp).Some?;
    var gm2 := LS.LkResult(lk, tlk, gm, inp).value;
    assert WalkPairLkRec(rer, qm, code, inp, traw.t, gm2, pc + 1, ea);
    assert forall gg :: gg in L.DefGroups(r1) ==> gg !in gm;  // the gate's own clear instance

    // canonical head: the LK branch of the gate rule (functional verdict Some)
    TreeRepLkREAtCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    assert t.LK? && t.lk == lk && t.tlk == tlk
        && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    // erasure congruence: children tie
    assert CE.ProgErase(traw) == LT.LK(lk, CE.ProgErase(traw.tlk), CE.ProgErase(traw.t));
    assert CE.ProgErase(t) == LT.LK(lk, CE.ProgErase(t.tlk), CE.ProgErase(t.t));
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t);

    // B step on the canonical LK head: pts_active with the merged gm
    assert LS.LkResult(t.lk, t.tlk, gm, inp) == Some(gm2);
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm2)]);
    bst1 := PT.PTS(inp, [(t.t, gm2)] + ta[1..], best, tbl, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // (BRICK D5) the per-lid NESTED static package (off `GateStaticsOkNested`):
    // the gate body may nest positive looks to ANY depth (negative bodies stay
    // look-free, `NR.NegLooksLookFreeRE`; positive nesting is lookAHEAD-only,
    // `M.NoPosLookbehindRE`), with the body's compile statics as `StaticOkNestedRE`.
    assert GateStaticAtNested(qm, re, crv, l, ncap, nlook, nquant);
    var la: R.lookaround, body: R.regex :|
      LTB.LookEntryOk(crv, l, la, body)
      && T.TransWf(body) && NR.NestedFragmentRE(body)
      && NR.NegLooksLookFreeRE(body) && M.NoPosLookbehindRE(body)
      && qm.looks[l].0 == T.TrLookaround(la)
      && qm.looks[l].1 == T.Translate(body)
      && (set g: LG.GroupId | g in L.DefGroups(T.Translate(body))) <= PIV.CapIdsInLooks(re)
      && var bodycode := CP.compile_to_bytecode(body);
         |bodycode| >= 1
         && PSM.StaticOkNestedRE(qm, body, bodycode, |bodycode| - 1)
         && PSM.SizesOkRE(body, ncap, nlook, nquant)
      && ((la.NegLookbehind? || la.NegLookahead?) ==> NR.CaptureFreeRE(body));
    assert lk == T.TrLookaround(la) && r1 == T.Translate(body);
    assert body == M.VBody(crv, l);
    assert 0 <= l < nlook;

    var clk := s1.clock;
    assert th' == th.(pc := th.pc + 1, look_regs := AReg.set_reg(th.look_regs, l, Some(cp as int), clk));

    // the polarity pin refutes the negative flavours
    assert !la.NegLookahead? && !la.NegLookbehind? by {
      if la.NegLookahead? || la.NegLookbehind? { assert !L.Positivity(lk); }
    }
    // (BRICK D5) `M.NoPosLookbehindRE(re)` forbids a positive LOOKBEHIND at lid l:
    // the functional row (`LTB.LookEntryOk` pins `la == crv.f_look_types[l]`)
    // matches `M.LookBodyFactsNested`'s `!la0.Lookbehind?`. Combined with the
    // polarity pin this leaves ONLY the capturing lookAHEAD arm live.
    PIV.LookCheckIdsRENested(re, code, 0, endl, pc);
    assert l >= 0 && (l as nat) in LTB.LookIds(re);
    NI.LookBodyOfTablesTie(re, crv, l as nat);
    assert body == NI.LookBodyOfRE(re, l as nat);
    assert !la.Lookbehind? by {
      M.LookBodyFactsNested(re, crv, l as nat);
      var la0: R.lookaround :| LTB.LookEntryOk(crv, l as int, la0, NI.LookBodyOfRE(re, l as nat))
                            && !la0.Lookbehind?;
      assert la0 == crv.f_look_types[l] == la;   // LookEntryOk pins f_look_types[l]
    }
    M.LkBodyGroupsEqCapIdsInLooks(re);
    assert S == LL.LkBodyGroups(T.Translate(re));

    if la.Lookahead? {
      // ---- capturing-lookahead half: the proven crux core -------------------
      assert crv.f_look_types[l] == la && crv.f_look_types[l].Lookahead?;
      assert AI.capture_type(crv.f_look_types[l]);
      assert L.LkDir(lk) == WP.Forward;
      assert RL.ASize(th.look_regs) == nlook;
      var bodycode := CP.compile_to_bytecode(body);
      assert LT.LK(lk, tlk, traw.t) == traw;
      // (BRICK D5) the gate-step lemma takes the body in the positive-nesting
      // sub-fragment DIRECTLY from the nested package: `NestedFragmentRE(body)` +
      // `NegLooksLookFreeRE(body)` are hypotheses of the package (no LookFree
      // conversions), and the value body-package requires are DROPPED with the call.
      ThreadRepLkStepCheckOracleRec(rer, qm, re, code, crv, str, ov, S, lk, r1, tlk, traw.t,
                                 gm, th, l, cp, clk, body, la, bodycode, |bodycode| - 1, 0,
                                 th.quant_regs, ncap, nlook, nquant);
      assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm2, th', ncap, nlook, nquant);
    } else {
      // (BRICK D5) DEAD arm: `!la.Lookahead?` together with the polarity pin
      // (`!la.NegLookahead? && !la.NegLookbehind?`) and `!la.Lookbehind?` (no
      // positive lookbehind survives `M.NoPosLookbehindRE(re)`) is impossible.
      assert false;
    }

    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm2, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm2)] + ta[1..])[0] == (t.t, gm2) && ([(t.t, gm2)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // ---- (E3) the look-path carrier: the crossing establishes lid l fresh ----
    // (D3) `*Top` carrier: only the TOP-LEVEL gate lid l fires an obligation.
    assert LookNestRepCTop(re, S, ta, s.active);   // (BRICK D5) Rec/Top carrier anchor
    assert LookNestOkTTop(re, S, gm, th);
    assert NI.NestInvRE(re, code, 0, endl, pc, th.capture_regs.a_clk, th.quant_regs.a_clk, -1) by {
      assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
      assert pc < endl;
    }
    RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
    assert AI.get_idx(th'.look_regs.a_clk, l) == clk && clk >= 0;
    assert forall k :: AI.get_idx(th.quant_regs.a_clk, k) <= AI.get_idx(th'.look_regs.a_clk, l) by {
      assert CM.RegsClocksLE(th.quant_regs, s.clock);
    }
    assert forall j: int :: j != l ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j);
    // ownership: the fold adds only l-owned groups (LmapOk row + fold confinement)
    PIV.LookCheckIdsRENested(re, code, 0, endl, pc);
    assert l >= 0 && (l as nat) in LTB.LookIds(re);
    LmapOkAtLid(re, qm, l as nat);
    var LB := NI.LookBodyOfRE(re, l as nat);
    assert r1 == T.Translate(LB);
    M.TranslateDefGroupsEqCapIds(LB);
    assert (set gx | gx in L.DefGroups(r1)) == PIV.CapIds(LB);
    // (BRICK D5) the gate body may nest looks: the DEPTH-K outside-S agreement
    // (`LkResultAgreeOutsideNested` on the recursive `PikeLkRegexRec(r1)`) replaces
    // the depth-1 look-free `NoLkBrL(r1)` frame. The fold still writes only
    // `DefGroups(r1)`, so any newly-set S-group of gm2 lies in the gate body.
    EL.TranslateFragmentPikeLkRec(body);
    assert EL.PikeLkRegexRec(r1);
    LkResultAgreeOutsideNested(rer, lk, r1, inp, tlk, gm);
    assert forall g: LG.GroupId :: g in S && g in gm2 && g !in gm ==>
      l >= 0 && (l as nat) in LTB.LookIds(re) && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
    by {
      forall g: LG.GroupId | g in S && g in gm2 && g !in gm
        ensures g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
      {
        if g !in (set gx | gx in L.DefGroups(r1)) {
          assert g in gm;                          // GmAgreeOutside membership
          assert false;
        }
      }
    }
    // (D3) fresh folds may land inner-look groups of l's body, but inner looks
    // are NOT in TopLookIds — no obligation. `LookNestOkTGatePassNestedTop` DROPS
    // the DIRECT-ownership hypothesis (cross-lid folds killed by top-level
    // disjointness), so the gate body need NOT be look-free.
    NI.LookBodyOfTablesTie(re, crv, l as nat);       // VBody(crv,l) == LookBodyOfRE(re,l) == body
    LookNestOkTGatePassNestedTop(re, code, endl, S, gm, gm2, th, th', pc, l);
    assert LookNestRepCTop(re, S, [(t.t, gm2)] + ta[1..], vms2.active) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestOkTTop(re, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i])
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // ---- (E4) converse: the crossing's coverage from the replay↔spec tie ----
    assert LookNestBackRepCTop(re, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    // structural body == row body (both pin f_look_ast[l])
    NI.LookBodyOfTablesTie(re, crv, l as nat);
    var la3: R.lookaround :| LTB.LookEntryOk(crv, l, la3, NI.LookBodyOfRE(re, l as nat));
    assert NI.LookBodyOfRE(re, l as nat) == body;
    // gm only grows across the fold (its S-body keys were CLEAR coming in)
    assert forall g: LG.GroupId :: g in gm ==> g in gm2 by {
      forall g: LG.GroupId | g in gm ensures g in gm2 {
        assert g !in (set gx | gx in L.DefGroups(r1)) by {
          if g in (set gx | gx in L.DefGroups(r1)) { assert g !in gm; }
        }
      }
    }
    // the crossing coverage for l itself
    assert var rfx := M.FreshBodyMatch(crv, str, l, th'.look_regs, ov, ncap, nlook, nquant);
      rfx.Some? ==>
        forall g: LG.GroupId ::
          g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
          && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                               rfx.value.look_regs, rfx.value.quant_regs)
          ==> g in gm2
    by {
      var rfx := M.FreshBodyMatch(crv, str, l, th'.look_regs, ov, ncap, nlook, nquant);
      if rfx.Some? {
        if la.Lookahead? {
          M.TranslateDefGroupsEqCapIds(body);
          M.LkBodyGroupsEqCapIdsInLooks(body);
          PIV.CapIdsLooksDisjoint(body);
          // (BRICK D5) depth-k gm-independence (recursive PikeLkRegexRec body).
          EL.TranslateFragmentPikeLkRec(body);
          EL.ComputeTrGmIndepLkRec(rer, r1, inp, gm, WP.Forward);
          assert tlk == LFU.ComputeTr(rer, [LS.Areg(r1)], inp, gm, WP.Forward);
          assert M.GmAgreeOn(gm, LG.Empty, set gx | gx in L.DefGroups(r1)) by {
            forall g: LG.GroupId | g in (set gx | gx in L.DefGroups(r1))
              ensures (g in gm <==> g in LG.Empty) && (g in gm ==> gm[g] == LG.Empty[g])
            {
              assert g !in gm;
            }
          }
          var bodycode3 := CP.compile_to_bytecode(body);
          assert AReg.get_cp(th'.look_regs, l) == Some(s1.cp) by {
            RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
          }
          // (BRICK D5) the NESTED value keystone: agreement on the OUTER groups
          // `Sout = DefGroups(tr) \ LkBodyGroups(tr)` (fresh cap == cap here).
          M.LkReplayMatchesSpecNested(rer, qm, body, bodycode3, |bodycode3| - 1, 0, str, cp,
                                AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant),
                                ov, LCdn.compile_cdns(body), la, tlk, gm, ncap, nlook, nquant);
          assert crv.f_look_cdns[l] == LCdn.compile_cdns(body);      // LookEntryOk row
          var rfSpec := AI.FFindMatch(bodycode3, str,
                          AI.FInitState(bodycode3, cp, AReg.init_regs(ncap), AReg.init_regs(nlook),
                                        AReg.init_regs(nquant), 0, AI.cp_context(cp, str, LAnc.Forward)),
                          ov, LAnc.Forward, LCdn.compile_cdns(body)).0;
          assert rfx == rfSpec;
          assert LS.LkResult(T.TrLookaround(la), tlk, gm, inp).Some?
              && LS.LkResult(T.TrLookaround(la), tlk, gm, inp).value == gm2 by {
            assert lk == T.TrLookaround(la);
          }
          var Sout := set gx | gx in L.DefGroups(T.Translate(body))
                             && gx !in LL.LkBodyGroups(T.Translate(body));
          assert M.GmAgreeOn(gm2,
                             PIV.GmOfLive(body, rfSpec.value.capture_regs,
                                          rfSpec.value.look_regs, rfSpec.value.quant_regs),
                             Sout);
          // (BRICK D5) the INNER groups (`LkBodyGroups(tr) == CapIdsInLooks(body)`)
          // are ABSENT from the fresh body match's live denotation — a lookaround
          // compiles to a single CheckOracle leaf, so the fresh match records none
          // of them (`FreshBodyMatchGmOuter`). So the (E4) coverage reduces to the
          // OUTER groups, discharged by `LkReplayMatchesSpecNested`.
          FreshBodyMatchGmOuter(qm, body, bodycode3, |bodycode3| - 1, str, cp, ov,
                                LCdn.compile_cdns(body), ncap, nlook, nquant);
          forall g: LG.GroupId |
            g in S && g in PIV.CapIds(NI.LookBodyOfRE(re, l as nat))
            && g in PIV.GmOfLive(NI.LookBodyOfRE(re, l as nat), rfx.value.capture_regs,
                                 rfx.value.look_regs, rfx.value.quant_regs)
            ensures g in gm2
          {
            assert g in PIV.CapIds(body);                                  // body == LookBodyOfRE(re,l)
            assert g in PIV.GmOfLive(body, rfSpec.value.capture_regs,
                                     rfSpec.value.look_regs, rfSpec.value.quant_regs);  // rfx == rfSpec
            assert g in (set gx | gx in L.DefGroups(T.Translate(body)));   // TranslateDefGroupsEqCapIds
            if g in PIV.CapIdsInLooks(body) {
              // fresh match records no inner-look captures ⇒ contradicts g live
              assert g !in PIV.GmOfLive(body, rfSpec.value.capture_regs,
                                        rfSpec.value.look_regs, rfSpec.value.quant_regs);
              assert false;
            }
            assert g !in LL.LkBodyGroups(T.Translate(body));   // == CapIdsInLooks(body)
            assert g in Sout;                                  // hence g in the OUTER set
          }
        } else {
          // (BRICK D5) DEAD arm: `!la.Lookahead?` is impossible under the polarity
          // pin + `!la.Lookbehind?` (no positive lookbehind survives
          // `M.NoPosLookbehindRE(re)`).
          assert false;
        }
      }
    }
    assert forall j: int :: j != l ==>
      AI.get_idx(th'.look_regs.a_clk, j) == AI.get_idx(th.look_regs.a_clk, j)
      && AI.get_idx(th'.look_regs.a_cp, j) == AI.get_idx(th.look_regs.a_cp, j)
    by {
      RL.ASetLaws(th.look_regs, l, Some(cp as int), clk);
    }
    LookNestBackTGatePassTop(re, crv, str, ov, S, gm, gm2, th, th', l, ncap, nlook, nquant);
    assert LookNestBackRepCTop(re, crv, str, ov, S, [(t.t, gm2)] + ta[1..], vms2.active,
                            ncap, nlook, nquant) by {
      forall i | 0 <= i < |[(t.t, gm2)] + ta[1..]|
        ensures LookNestBackTTop(re, crv, str, ov, S, ([(t.t, gm2)] + ta[1..])[i].1, vms2.active[i],
                              ncap, nlook, nquant)
      {
        if i == 0 {
        } else {
          assert ([(t.t, gm2)] + ta[1..])[i] == ta[i];
          assert vms2.active[i] == s.active[i];
        }
      }
    }

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm2)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }


  lemma LiftPreserveNegGatePassLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  l: int, vms2: AI.VmState,
                                  ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires qm.ov == ov
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.NegCheckOracle(l))
    requires !LOr.view_get_oracle(ov, s.cp, l)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [s.active[0].(pc := s.active[0].pc + 1)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    var th' := th.(pc := th.pc + 1);
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // polarity + the bit ⟹ the functional verdict is Some (negative passes)
    TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
    assert |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept);
    assert pc < endl;
    GatePolarityRE(re, qm, code, 0, endl, pc);
    assert l in qm.looks;
    var lk := qm.looks[l].0;
    var r1 := qm.looks[l].1;
    assert AR.PositiveL(lk) == L.Positivity(lk);
    assert !L.Positivity(lk);
    var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    assert LL.OracleOkAt(rer, qm, inp);
    PIV.IdxInpOfCp(str, s.cp as nat);
    assert TREP.CpOf(inp) == s.cp as nat;
    assert qm.looks[l] == (lk, r1);
    assert LOr.view_get_oracle(qm.ov, TREP.CpOf(inp), l)
       <==> LT.TreeRes(tlk, LG.Empty, inp, L.LkDir(lk)).Some?;
    assert LS.LkResult(lk, tlk, LG.Empty, inp).Some?;      // clear bit + negative

    // canonical head: the LK branch of the gate rule
    TreeRepLkREAtNegCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    assert t.LK? && t.lk == lk && t.tlk == tlk
        && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    // B step: the merge at the RUNNING map is Some(gm) — the identity
    EL.LkResultGmIndep(lk, tlk, gm, inp);
    assert LS.LkResult(lk, tlk, gm, inp).Some?;
    assert LS.LkResult(lk, tlk, gm, inp).value == gm;      // negative: Some(gm)
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
    bst1 := PT.PTS(inp, [(t.t, gm)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the child pairing: the raw witness steps by the neg-gate walk core; the
    // erasure tie transports the child
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtNegCheckOracleRec(rer, qm, code, inp, traw, gm, pc, ea, l);
    assert traw.LK? && WalkPairLkRec(rer, qm, code, inp, traw.t, gm, pc + 1, ea);
    assert (th.pc + 1) as nat == pc + 1;
    assert GmtTieOutside(re, th', gm, S);
    assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm, th', ncap, nlook, nquant);
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.LK(traw.lk, CE.ProgErase(traw.tlk), CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.LK(t.lk, CE.ProgErase(t.tlk), CE.ProgErase(t.t));
    }
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm)] + ta[1..])[0] == (t.t, gm) && ([(t.t, gm)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }


  lemma LiftPreserveGateKillLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                               crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                               bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                               l: int, pos: bool, vms2: AI.VmState,
                               ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires qm.ov == ov
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat)
          == Some(if pos then RB.CheckOracle(l) else RB.NegCheckOracle(l))
    requires LOr.view_get_oracle(ov, s.cp, l) != pos
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // the gate pc is interior (endl holds Accept), so the polarity pin applies
    TreeRepLkREInRange(rer, qm, code, inp, t, pc, ea);
    assert |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept);
    assert pc < endl;
    GatePolarityRE(re, qm, code, 0, endl, pc);
    assert l in qm.looks;
    var lk := qm.looks[l].0;
    var r1 := qm.looks[l].1;
    assert AR.PositiveL(lk) == L.Positivity(lk);
    assert L.Positivity(lk) == pos;

    // the bit at this position IS the body tree's verdict (oracle column)
    var tlk := LFU.ComputeTr(rer, [LS.Areg(r1)], inp, LG.Empty, L.LkDir(lk));
    assert LL.OracleOkAt(rer, qm, inp);          // inp == inp0 instance of OracleOkSuffix
    PIV.IdxInpOfCp(str, s.cp as nat);
    assert TREP.CpOf(inp) == s.cp as nat;
    assert qm.looks[l] == (lk, r1);
    assert LOr.view_get_oracle(qm.ov, TREP.CpOf(inp), l)
       <==> LT.TreeRes(tlk, LG.Empty, inp, L.LkDir(lk)).Some?;
    // failing bit + polarity ⟹ the functional verdict is None (both flavours)
    assert LS.LkResult(lk, tlk, LG.Empty, inp).None?;

    // canonical head: the LKFail branch of the gate rule
    if pos {
      TreeRepLkREAtCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    } else {
      TreeRepLkREAtNegCheckOracle(rer, qm, code, inp, t, pc, ea, l);
    }
    assert t == LT.LKFail(lk, tlk);
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([]);
    bst1 := LiftDropDeadHeadLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                               bst, s, s1, vms2, ncap, nlook, nquant);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);
  }


  lemma LiftPreserveEndLoopPassLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.EndLoop)
    requires s.active[0].exit_allowed
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [s.active[0].(pc := s.active[0].pc + 1)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    var th' := th.(pc := th.pc + 1);
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // canonical head: Progress with canonical child at (pc+1, true)
    TreeRepLkREAtEndLoop(rer, qm, code, inp, t, pc, ea);
    assert t.Progress? && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, true);

    // B step: pts_active queues the child with the same gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
    bst1 := PT.PTS(inp, [(t.t, gm)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the child pairing: the raw witness unwraps its own Progress; erasure is
    // transparent to the guard on BOTH sides
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    WalkPairLkAtEndLoopRec(rer, qm, code, inp, traw, gm, pc, ea);
    assert traw.Progress? && WalkPairLkRec(rer, qm, code, inp, traw.t, gm, pc + 1, true);
    assert (th.pc + 1) as nat == pc + 1;
    assert th'.exit_allowed == true;
    assert GmtTieOutside(re, th', gm, S);
    assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm, th', ncap, nlook, nquant);
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == CE.ProgErase(traw.t);   // Progress transparent
      assert CE.ProgErase(t) == CE.ProgErase(t.t);
    }
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm)] + ta[1..])[0] == (t.t, gm) && ([(t.t, gm)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }


  lemma LiftPreserveEndLoopKillLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                  crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                  bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                  vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.EndLoop)
    requires !s.active[0].exit_allowed
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, ta[0].1, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, th.exit_allowed);
    TreeRepLkREAtEndLoop(rer, qm, code, inp, t, pc, th.exit_allowed);
    assert t == LT.Mismatch;
    assert PTL.TreeBfsStepLk(t, ta[0].1, inp) == PT.StepActive([]);
    bst1 := LiftDropDeadHeadLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                               bst, s, s1, vms2, ncap, nlook, nquant);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);
  }


  lemma LiftPreserveAnchorPassLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                 bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                 a: R.anchor, vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires !rer.multiline
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.AnchorAssertion(a))
    requires LAnc.is_satisfied(a, s.context, LAnc.Forward)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := [s.active[0].(pc := s.active[0].pc + 1)] + s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    var th' := th.(pc := th.pc + 1);
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    var gm := ta[0].1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, gm, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    var ea := th.exit_allowed;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, ea);

    // the VM-side check IS the spec-side check
    assert PIV.ContextOkRE(str, s.cp, s.context);
    PSM.ContextOkIsCtxOf(str, s.cp as nat);
    assert LAnc.is_satisfied(a, TREP.CtxOf(inp), LAnc.Forward);
    TREP.AnchorAgreeInput(rer, a, inp);
    assert LS.AnchorSatisfied(rer, T.TrAnchor(a), inp);

    // canonical head: AnchorPass with canonical child at (pc+1, ea)
    TreeRepLkREAtAnchor(rer, qm, code, inp, t, pc, ea, a);
    assert t.AnchorPass? && TreeRepLkRE(rer, qm, code, inp, t.t, pc + 1, ea);

    // B step: pts_active queues the child with the same gm
    assert PTL.TreeBfsStepLk(t, gm, inp) == PT.StepActive([(t.t, gm)]);
    bst1 := PT.PTS(inp, [(t.t, gm)] + ta[1..], best, tb, SS.AddSeenTrees(seen, t));
    assert PTL.PikeTreeStepLk(bst, bst1);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);

    // the child pairing: raw witness steps by the proven Anchor core; the
    // erasure tie transports to the canonical child
    var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(t)
      && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th, ncap, nlook, nquant);
    assert traw.AnchorPass? by {
      if !traw.AnchorPass? {
        var acts: LS.Actions, b: BS.LoopBool :|
          AR.ActionsRepL(rer, qm, acts, code, pc)
          && EL.PikeLkActionsRec(acts)
          && ATR.EaOf(b) == ea
          && EL.BoolTreeLk(rer, acts, inp, b, traw)
          && GateAheadClear(acts, gm)
          && WalkDefsOk(acts);
        assert TtLkRec(rer, qm, code, inp, traw, pc, ea);
        TtLkAtAnchorRec(rer, qm, code, inp, traw, pc, ea, a);
        assert traw == LT.Mismatch;
        assert CE.ProgErase(traw) == LT.Mismatch;
        assert CE.ProgErase(t).AnchorPass?;
        assert false;
      }
    }
    ThreadRepLkStepAnchorRec(rer, qm, re, code, inp, crv, str, ov, S, traw, gm, th,
                          ncap, nlook, nquant, a);
    assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, traw.t, gm, th', ncap, nlook, nquant);
    assert CE.ProgErase(traw.t) == CE.ProgErase(t.t) by {
      assert CE.ProgErase(traw) == LT.AnchorPass(traw.a, CE.ProgErase(traw.t));
      assert CE.ProgErase(t) == LT.AnchorPass(t.a, CE.ProgErase(t.t));
    }
    assert (th.pc + 1) as nat == pc + 1;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t.t, gm, th', ncap, nlook, nquant);

    // list bookkeeping
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[1..], s.active[1..],
                        ncap, nlook, nquant);
    assert vms2.active[0] == th' && vms2.active[1..] == s.active[1..];
    assert ([(t.t, gm)] + ta[1..])[0] == (t.t, gm) && ([(t.t, gm)] + ta[1..])[1..] == ta[1..];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, [(t.t, gm)] + ta[1..], vms2.active,
                        ncap, nlook, nquant);

    // seen + isblocked bookkeeping
    assert PIV.HdTreeOf(ta) == Some(t) && PIV.HeadPcOf(s.active) == pc;
    AddSeenRepLk(rer, qm, code, inp, seen, s.processed, t, pc, ea,
                 PIV.HdTreeOf([(t.t, gm)] + ta[1..]), PIV.HeadPcOf(vms2.active));
    IsblockedGrowLk(rer, qm, code, inp, seen, s.isblocked, t);
  }


  lemma LiftPreserveAnchorKillLkRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                                 crv: CP.FCompiled, str: string, ov: LOr.OracleView, S: set<LG.GroupId>,
                                 bst: PT.PikeTreeState, s: AI.VmState, s1: AI.VmState,
                                 a: R.anchor, vms2: AI.VmState, ncap: int, nlook: int, nquant: int)
    returns (bst1: PT.PikeTreeState)
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires !rer.multiline
    requires bst.PTS?
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    requires |s.active| > 0
    requires !AI.bpc_mem(s.processed, s.active[0].pc, s.active[0].exit_allowed)
    requires s.active[0].pc >= 0
    requires NR.GetPcRE(code, s.active[0].pc as nat) == Some(RB.AnchorAssertion(a))
    requires !LAnc.is_satisfied(a, s.context, LAnc.Forward)
    requires s1 == s.(clock := s.clock + 1,
                      processed := AI.bpc_add(s.processed, s.active[0].pc, s.active[0].exit_allowed))
    requires vms2 == s1.(active := s1.active[1..])
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, vms2, ncap, nlook, nquant)
  {
    var PTS(inp, ta, best, tb, seen) := bst;
    var th := s.active[0];
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0;
    var t := ta[0].0;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, t, ta[0].1, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    assert TreeRepLkRE(rer, qm, code, inp, t, pc, th.exit_allowed);

    // the VM-side check IS the spec-side check
    assert PIV.ContextOkRE(str, s.cp, s.context);
    PSM.ContextOkIsCtxOf(str, s.cp as nat);
    assert !LAnc.is_satisfied(a, TREP.CtxOf(inp), LAnc.Forward);
    TREP.AnchorAgreeInput(rer, a, inp);
    assert !LS.AnchorSatisfied(rer, T.TrAnchor(a), inp);

    TreeRepLkREAtAnchor(rer, qm, code, inp, t, pc, th.exit_allowed, a);
    assert t == LT.Mismatch;
    assert PTL.TreeBfsStepLk(t, ta[0].1, inp) == PT.StepActive([]);
    bst1 := LiftDropDeadHeadLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                               bst, s, s1, vms2, ncap, nlook, nquant);
    TrcLkRefl(bst1);
    TrcLkCons(bst, bst1, bst1);
  }


  lemma LiftAdvanceEpsilonRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code, endl: nat,
                           ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                           S: set<LG.GroupId>, ptsA: PT.PikeTreeState, s: AI.VmState,
                           bst: PT.PikeTreeState, dir: LAnc.direction,
                           ncap: int, nlook: int, nquant: int)
    returns (ptsA': PT.PikeTreeState, bst1: PT.PikeTreeState)
    requires !rer.multiline && !rer.ignoreCase && qm.ov == ov
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires PSM.StaticOkNestedRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires S == PIV.CapIdsInLooks(re)   // the value-tie boundary (SetReg/gate cases)
    requires GateStaticsOkNested(qm, re, crv, ncap, nlook, nquant)   // (BRICK D5) NESTED per-lid package
    requires M.NoPosLookbehindRE(re)      // (BRICK D5) positive-lookahead-nesting scope
    requires LTB.LookUnique(re)           // (E3) cross-lid ownership pinning
    requires LTB.LookTablesOk(re, crv)    // (E4) row↔structure tie (gate converse)
    requires dir == LAnc.Forward
    requires ptsA.PTS? && bst.PTS?
    requires |s.processed.true_set| == RB.size(code) && |s.processed.false_set| == RB.size(code)
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant)
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s, ncap, nlook, nquant)
    ensures PSM.TrcRE(ptsA, ptsA')
    ensures ptsA'.PTS?
    ensures PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA',
                              AI.FAdvanceEpsilon(code, s, ov, dir).0, ncap, nlook, nquant)
    ensures PTL.TrcPikeTreeLk(bst, bst1)
    ensures bst1.PTS?           // the ε-phase never finalizes; pts_final is LiftConsume's
    ensures LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1,
                    AI.FAdvanceEpsilon(code, s, ov, dir).0, ncap, nlook, nquant)
    decreases AI.unprocessed(s.processed), |s.active|
  {
    if |s.active| == 0 {
      ptsA' := ptsA;
      bst1 := bst;
      PSM.TrcRefl(ptsA);
      TrcLkRefl(bst);
      return;
    }
    var th := s.active[0];
    var ac := s.active[1..];

    // Head bounds from the canonical tie (machine A used ThreadNestRE here).
    var PTS(inp, ta, best, tb, seen) := bst;
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta, s.active, ncap, nlook, nquant);
    assert |ta| > 0 && th.pc >= 0;
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, ta[0].0, ta[0].1, th, ncap, nlook, nquant);
    var pc: nat := th.pc as nat;
    assert TreeRepLkRE(rer, qm, code, inp, ta[0].0, pc, th.exit_allowed);
    TreeRepLkREInRange(rer, qm, code, inp, ta[0].0, pc, th.exit_allowed);
    assert pc < |code| && RB.size(code) == |code|;
    var i := RB.get_instr(code, th.pc);
    assert i == code[pc] && NR.GetPcRE(code, pc) == Some(i);

    if AI.bpc_mem(s.processed, th.pc, th.exit_allowed) {
      var bstS := LiftPreserveSkipLkRec(rer, qm, re, code, endl, crv, str, ov, S, bst, s, ncap, nlook, nquant);
      var ptsS := PSM.PreserveSkipCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s, ncap, nlook, nquant);
      var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                            ptsS, s.(active := ac), bstS, dir, ncap, nlook, nquant);
      PSM.TrcCons(ptsA, ptsS, ptsA2);
      TrcLkCons(bst, bstS, bst2);
      ptsA' := ptsA2;
      bst1 := bst2;
      return;
    }

    var s1 := s.(clock := s.clock + 1, processed := AI.bpc_add(s.processed, th.pc, th.exit_allowed));
    assert AI.unprocessed(s1.processed) <= AI.unprocessed(s.processed)
        && (0 <= th.pc < RB.size(code) ==> AI.unprocessed(s1.processed) < AI.unprocessed(s.processed))
      by { AI.UnprocessedAdd(s.processed, th.pc, th.exit_allowed); }
    assert AI.unprocessed(s1.processed) < AI.unprocessed(s.processed);
    assert |s1.processed.true_set| == RB.size(code) && |s1.processed.false_set| == RB.size(code);

    match i {
      case Accept =>
        var vms2 := s1.(active := [], bestmatch := Some(th));
        bst1 := LiftPreserveAcceptLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                     bst, s, s1, vms2, ncap, nlook, nquant);
        ptsA' := PSM.PreserveAcceptCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                        s1, vms2, ncap, nlook, nquant);
        PSM.TrcRefl(ptsA');
        PSM.TrcCons(ptsA, ptsA', ptsA');
        TrcLkRefl(bst1);
        TrcLkCons(bst, bst1, bst1);
        assert AI.FAdvanceEpsilon(code, s, ov, dir).0 == vms2;
      case Jmp(x) =>
        var th' := th.(pc := x);
        var vms2 := s1.(active := [th'] + ac);
        LiftPreserveStutterLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                              bst, s, s1, th', vms2, ncap, nlook, nquant);
        PSM.PreserveStutterCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                s1, th', vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsA, vms2, bst, dir, ncap, nlook, nquant);
        ptsA' := ptsA2;
        bst1 := bst2;
      case BeginLoop =>
        var th' := th.(exit_allowed := false, pc := th.pc + 1);
        var vms2 := s1.(active := [th'] + ac);
        LiftPreserveStutterLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                              bst, s, s1, th', vms2, ncap, nlook, nquant);
        PSM.PreserveStutterCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                s1, th', vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsA, vms2, bst, dir, ncap, nlook, nquant);
        ptsA' := ptsA2;
        bst1 := bst2;
      case Consume(ce) =>
        var (nb, ni) := AI.add_thread(th, ce, s1.blocked, s1.isblocked);
        if AI.pc_mem(s1.isblocked, th.pc) {
          assert nb == s1.blocked && ni == s1.isblocked;
          var vms2 := s1.(blocked := nb, isblocked := ni, active := ac);
          assert vms2 == s1.(active := ac);
          var bstS := LiftPreserveConsumeDropLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, ce, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveConsumeDropNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                              s1, ce, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          assert nb == [(th, ce)] + s1.blocked && ni == AI.pc_add(s1.isblocked, th.pc);
          var vms2 := s1.(blocked := nb, isblocked := ni, active := ac);
          var bstS := LiftPreserveConsumeAddLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                               bst, s, s1, ce, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveConsumeAddNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, ce, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case Fork(x, y) =>
        var newt := AI.Thread(x, th.capture_regs, th.look_regs, th.quant_regs, th.exit_allowed);
        var vms2 := s1.(active := [newt, th.(pc := y)] + ac);
        // backward-fork flag pin: a false-thread never sits at a Cold pc
        assert (x <= th.pc || y <= th.pc) ==> th.exit_allowed by {
          if (x <= th.pc || y <= th.pc) && !th.exit_allowed {
            assert th in s.active && PSM.EaColdOkRE(code, th);
            assert NI.ColdF(code, pc, 1);
            assert NI.ColdRE(code, pc);
          }
        }
        var bstS := LiftPreserveForkLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                       bst, s, s1, x, y, vms2, ncap, nlook, nquant);
        var ptsS := PSM.PreserveForkCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                         s1, x, y, vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsS, vms2, bstS, dir, ncap, nlook, nquant);
        PSM.TrcTrans(ptsA, ptsS, ptsA2);
        TrcLkTrans(bst, bstS, bst2);
        ptsA' := ptsA2;
        bst1 := bst2;
      case SetRegisterToCP(reg) =>
        var th' := th.(capture_regs := AReg.set_reg(th.capture_regs, reg, Some(s1.cp), s1.clock),
                       pc := th.pc + 1);
        var vms2 := s1.(active := [th'] + ac);
        // A-side gm effect off ptsA's head (helper keeps the dispatcher VC small)
        DispatchSetRegEffectNested(rer, qm, re, code, endl, ngroups, str, ptsA, s, s1, reg, th',
                             ncap, nlook, nquant);
        assert th in s.active;
        assert CM.ThreadClocksLE(th, s.clock) && s.clock >= 0;   // PikeInvFullRE backbone
        var bstS := LiftPreserveSetRegLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                         bst, s, s1, reg, th', vms2, ncap, nlook, nquant);
        var ptsS: PT.PikeTreeState;
        if reg % 2 == 0 {
          ptsS := PSM.PreserveOpenCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                       s1, reg, vms2, ncap, nlook, nquant);
        } else {
          ptsS := PSM.PreserveCloseCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                        s1, reg, vms2, ncap, nlook, nquant);
        }
        var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsS, vms2, bstS, dir, ncap, nlook, nquant);
        PSM.TrcCons(ptsA, ptsS, ptsA2);
        TrcLkTrans(bst, bstS, bst2);
        ptsA' := ptsA2;
        bst1 := bst2;
      case SetQuantToClock(q, bq) =>
        var ocp := if bq then Some(s1.cp) else None;
        var th' := th.(quant_regs := AReg.set_reg(th.quant_regs, q, ocp, s1.clock), pc := th.pc + 1);
        var vms2 := s1.(active := [th'] + ac);
        // the canonical tie pins bq == false (compiled SQC sites write false);
        // then the A-side helper yields the GMReset gm effect.
        TreeRepLkREAtSetQuant(rer, qm, code, inp, ta[0].0, pc, th.exit_allowed, q, bq);
        assert !bq && q in qm.quants;
        assert th in s.active;
        assert CM.ThreadRegsWf(th, ncap, nlook, nquant);   // PikeInvFullRE backbone
        assert CM.ThreadClocksLE(th, s.clock) && s.clock >= 0;
        DispatchResetEffectNested(rer, qm, re, code, endl, ngroups, str, ptsA, s, s1, q, th',
                            ncap, nlook, nquant);
        var bstS := LiftPreserveSetQuantLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                           bst, s, s1, q, bq, th', vms2, ncap, nlook, nquant);
        var ptsS := PSM.PreserveResetCaseNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                          s1, q, bq, vms2, ncap, nlook, nquant);
        var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                              ptsS, vms2, bstS, dir, ncap, nlook, nquant);
        PSM.TrcCons(ptsA, ptsS, ptsA2);
        TrcLkTrans(bst, bstS, bst2);
        ptsA' := ptsA2;
        bst1 := bst2;
      case CheckOracle(l) =>
        if LOr.view_get_oracle(ov, s1.cp, l) {
          var th' := th.(pc := th.pc + 1,
                         look_regs := AReg.set_reg(th.look_regs, l, Some(s1.cp), s1.clock));
          var vms2 := s1.(active := [th'] + ac);
          assert th in s.active;
          assert CM.ThreadRegsWf(th, ncap, nlook, nquant);   // PikeInvFullRE backbone
          assert CM.ThreadClocksLE(th, s.clock) && s.clock >= 0;
          assert PSM.ThreadNestRE(re, code, endl, th.pc, th);
          var bstS := LiftPreserveGatePassLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                             bst, s, s1, l, th', vms2, ncap, nlook, nquant);
          PSM.PreserveOraclePassNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                 s1, th', vms2, l, true, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsA, vms2, bstS, dir, ncap, nlook, nquant);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveGateKillLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                             bst, s, s1, l, true, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveOracleKillNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, l, true, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case NegCheckOracle(l) =>
        if LOr.view_get_oracle(ov, s1.cp, l) {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveGateKillLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                             bst, s, s1, l, false, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveOracleKillNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, l, false, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := [th.(pc := th.pc + 1)] + ac);
          var bstS := LiftPreserveNegGatePassLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, l, vms2, ncap, nlook, nquant);
          PSM.PreserveOraclePassNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                 s1, th.(pc := th.pc + 1), vms2, l, false, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsA, vms2, bstS, dir, ncap, nlook, nquant);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case WriteOracle(l) =>
        // no TreeRepLkRE rule at WriteOracle — the canonical head tie is refuted
        assert false;
        ptsA' := ptsA;
        bst1 := bst;
      case EndLoop =>
        if th.exit_allowed {
          var vms2 := s1.(active := [th.(pc := th.pc + 1)] + ac);
          var bstS := LiftPreserveEndLoopPassLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveEndLoopPassNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                              s1, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveEndLoopKillLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                                bst, s, s1, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveEndLoopKillNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                              s1, vms2, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case CheckNullable(qid) =>
        // no TreeRepLkRE rule at CheckNullable — refuted
        assert false;
        ptsA' := ptsA;
        bst1 := bst;
      case AnchorAssertion(a) =>
        if LAnc.is_satisfied(a, s1.context, dir) {
          var vms2 := s1.(active := [th.(pc := th.pc + 1)] + ac);
          var bstS := LiftPreserveAnchorPassLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                               bst, s, s1, a, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveAnchorPassNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, a, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        } else {
          var vms2 := s1.(active := ac);
          var bstS := LiftPreserveAnchorKillLkRec(rer, qm, re, code, endl, crv, str, ov, S,
                                               bst, s, s1, a, vms2, ncap, nlook, nquant);
          var ptsS := PSM.PreserveAnchorKillNested(rer, qm, re, code, endl, ngroups, str, ptsA, s,
                                             s1, vms2, a, ncap, nlook, nquant);
          var ptsA2, bst2 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                                ptsS, vms2, bstS, dir, ncap, nlook, nquant);
          PSM.TrcCons(ptsA, ptsS, ptsA2);
          TrcLkTrans(bst, bstS, bst2);
          ptsA' := ptsA2;
          bst1 := bst2;
        }
      case Fail =>
        // no TreeRepLkRE rule at Fail — refuted
        assert false;
        ptsA' := ptsA;
        bst1 := bst;
    }
  }


  lemma LiftStepCRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                  endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                  S: set<LG.GroupId>, ptsA: PT.PikeTreeState, ptsB: PT.PikeTreeState, vms: AI.VmState,
                  ncap: int, nlook: int, nquant: int)
    returns (ptsA': PT.PikeTreeState, ptsB': PT.PikeTreeState)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires PSM.StaticOkNestedRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires S == PIV.CapIdsInLooks(re)   // the value-tie boundary (SetReg/gate cases)
    requires GateStaticsOkNested(qm, re, crv, ncap, nlook, nquant)   // (BRICK D5) NESTED per-lid package
    requires M.NoPosLookbehindRE(re)      // (BRICK D5) positive-lookahead-nesting scope
    requires LTB.LookUnique(re)           // (E3) cross-lid ownership pinning
    requires LTB.LookTablesOk(re, crv)    // (E4) row↔structure tie (gate converse)
    requires ptsA.PTS? && ptsB.PTS?
    requires |vms.processed.true_set| == RB.size(code) && |vms.processed.false_set| == RB.size(code)
    requires LiftInvCRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S, ptsA, ptsB, vms, ncap, nlook, nquant)
    ensures PTL.TrcPikeTreeLk(ptsB, ptsB')
    ensures ptsA'.PTS? && ptsB'.PTS?
    ensures LiftInvCRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                     ptsA', ptsB', AI.FAdvanceEpsilon(code, vms, ov, LAnc.Forward).0, ncap, nlook, nquant)
  {
    var vms' := AI.FAdvanceEpsilon(code, vms, ov, LAnc.Forward).0;
    // ONE call: the composite dispatcher steps machine A per-case by the
    // proven Preserve*Case lemmas and machine B by the LiftPreserve*Lk tier.
    ptsA', ptsB' := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                       ptsA, vms, ptsB, LAnc.Forward, ncap, nlook, nquant);
    // the inp link: both sides pin their inp to InpOfCp(str, vms'.cp)
    assert PIV.PikeInvRE(rer, qm, re, code, ngroups, str, ptsA', vms');
    assert ptsA'.inp == PIV.InpOfCp(str, vms'.cp);
    assert ptsB'.inp == PIV.InpOfCp(str, vms'.cp);
  }


  lemma BlockedToActiveLkCRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                           inp: LC.Input, nextinp: LC.Input, crv: CP.FCompiled, str: string,
                           ov: LOr.OracleView, S: set<LG.GroupId>,
                           tl: seq<(LT.Tree, LG.GroupMap)>, bl: seq<(AI.Thread, RC.char_expectation)>,
                           ncap: int, nlook: int, nquant: int)
    requires BlockedRepLkCRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl, bl, ncap, nlook, nquant)
    ensures ActiveRepLkCRec(rer, qm, re, code, nextinp, crv, str, ov, S, tl, PSM.ResumeAll(bl),
                         ncap, nlook, nquant)
    decreases tl
  {
    if |tl| == 0 {
      assert |bl| == 0;
    } else {
      assert |bl| > 0;
      var th := bl[0].0;
      var rth := th.(exit_allowed := true, pc := th.pc + 1);
      assert PSM.ResumeAll(bl) == [rth] + PSM.ResumeAll(bl[1..]);
      assert rth.pc >= 0 && (rth.pc as nat) == (th.pc + 1) as nat;
      assert TreeRepLkRE(rer, qm, code, nextinp, tl[0].0, rth.pc as nat, rth.exit_allowed);
      var traw: LT.Tree :| CE.ProgErase(traw) == CE.ProgErase(tl[0].0)
        && WalkPairLkRec(rer, qm, code, nextinp, traw, tl[0].1, (th.pc + 1) as nat, true);
      assert rth.capture_regs == th.capture_regs && rth.look_regs == th.look_regs
          && rth.quant_regs == th.quant_regs;
      assert GmtTieOutside(re, rth, tl[0].1, S)
         ;
      assert ThreadRepLkRec(rer, qm, re, code, nextinp, crv, str, ov, S, traw, tl[0].1, rth,
                         ncap, nlook, nquant);
      assert ThreadRepLkCRec(rer, qm, re, code, nextinp, crv, str, ov, S, tl[0].0, tl[0].1, rth,
                          ncap, nlook, nquant);
      BlockedToActiveLkCRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, tl[1..], bl[1..],
                         ncap, nlook, nquant);
      assert ([rth] + PSM.ResumeAll(bl[1..]))[0] == rth
          && ([rth] + PSM.ResumeAll(bl[1..]))[1..] == PSM.ResumeAll(bl[1..]);
    }
  }


  lemma LiftFindMatchCRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                       endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                       S: set<LG.GroupId>, ptsA: PT.PikeTreeState, bst: PT.PikeTreeState,
                       vms: AI.VmState, cdn: LCdn.cdns, ncap: int, nlook: int, nquant: int)
    returns (bestT: Option<LT.Leaf>)
    requires PSM.StaticOkNestedRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires S == PIV.CapIdsInLooks(re)
    requires GateStaticsOkNested(qm, re, crv, ncap, nlook, nquant)   // (BRICK D5) NESTED per-lid package
    requires M.NoPosLookbehindRE(re)                                 // (BRICK D5) positive-nesting scope
    requires LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires ptsA.PTS? && bst.PTS?
    requires |vms.processed.true_set| == RB.size(code) && |vms.processed.false_set| == RB.size(code)
    requires vms.context.nextchar == AI.get_char(str, vms.cp)
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, vms, ncap, nlook, nquant)
    requires LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, vms, ncap, nlook, nquant)
    ensures PTL.TrcPikeTreeLk(bst, PT.PTS_final(bestT))
    ensures BestTieLkNestedTop(re, crv, str, ov, S, bestT,
                      AI.FFindMatch(code, str, vms, ov, LAnc.Forward, cdn).0, ncap, nlook, nquant)
    decreases |str| - vms.cp
  {
    var dir := LAnc.Forward;
    var s0 := vms.(cdn := LCdn.build_cdn_v(cdn, vms.cp, ov, vms.context, dir));
    // Neither invariant reads cdn.
    assert PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA, s0, ncap, nlook, nquant);
    assert LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst, s0, ncap, nlook, nquant);
    var ptsA1, bst1 := LiftAdvanceEpsilonRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                          ptsA, s0, bst, dir, ncap, nlook, nquant);
    var (s1, ov1) := AI.FAdvanceEpsilon(code, s0, ov, dir);
    PSM.StaticOkNoWriteNested(qm, re, code, endl);
    CM.FAdvanceEpsilonOvStable(code, s0, ov, dir);
    assert ov1 == ov;
    PSM.FAdvanceEpsilonActiveEmpty(code, s0, ov, dir);
    assert s1.active == [] && s1.cp == s0.cp == vms.cp && s1.context == vms.context;
    assert PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA1, s1, ncap, nlook, nquant);
    assert LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, s1, ncap, nlook, nquant);

    assert bst1.PTS?;
    var PTS(inp1, ta1, best1, tb1, seen1) := bst1;
    assert ActiveRepLkCRec(rer, qm, re, code, inp1, crv, str, ov, S, ta1, s1.active, ncap, nlook, nquant);
    assert ta1 == [];
    assert inp1 == PIV.InpOfCp(str, s1.cp) && 0 <= s1.cp <= |str|;
    assert BestTieLkNestedTop(re, crv, str, ov, S, best1, s1.bestmatch, ncap, nlook, nquant);

    if |s1.blocked| == 0 {
      assert LC.Reverse(s1.blocked) == [];
      assert tb1 == [] by {
        if LC.AdvanceInput(inp1, WP.Forward).Some? {
          var nx :| LC.AdvanceInput(inp1, WP.Forward) == Some(nx);
          assert BlockedRepLkCRec(rer, qm, re, code, inp1, nx, crv, str, ov, S, tb1,
                               PIV.MatchingBlocked(LC.Reverse(s1.blocked), inp1), ncap, nlook, nquant);
          assert PIV.MatchingBlocked([], inp1) == [];
        }
      }
      bestT := best1;
      assert PTL.PikeTreeStepLk(bst1, PT.PTS_final(best1));
      TrcLkRefl(PT.PTS_final(best1));
      TrcLkCons(bst1, PT.PTS_final(best1), PT.PTS_final(best1));
      TrcLkTrans(bst, bst1, PT.PTS_final(best1));
      assert AI.FFindMatch(code, str, vms, ov, dir, cdn).0 == s1.bestmatch;
    } else if s1.context.nextchar.None? {
      assert AI.get_char(str, vms.cp).None?;
      assert vms.cp >= |str| && s1.cp == |str|;
      assert inp1.next == str[s1.cp..] == [];
      assert LC.AdvanceInput(inp1, WP.Forward).None?;
      assert tb1 == [];
      bestT := best1;
      assert PTL.PikeTreeStepLk(bst1, PT.PTS_final(best1));
      TrcLkRefl(PT.PTS_final(best1));
      TrcLkCons(bst1, PT.PTS_final(best1), PT.PTS_final(best1));
      TrcLkTrans(bst, bst1, PT.PTS_final(best1));
      assert AI.FFindMatch(code, str, vms, ov, dir, cdn).0 == s1.bestmatch;
    } else {
      // A real character remains: consume it (the FFindMatch else-branch).
      assert AI.get_char(str, vms.cp).Some?;
      assert vms.cp < |str|;
      assert inp1.next == str[s1.cp..] && |inp1.next| > 0;
      assert s1.context.nextchar == Some(inp1.next[0]);
      PSM.FConsumeResumes(s1, inp1);
      var s2 := AI.FConsume(s1);
      var filter := PIV.MatchingBlocked(LC.Reverse(s1.blocked), inp1);
      assert PSM.ResumeAll(filter) + s1.active == PSM.ResumeAll(filter);
      assert s2 == s1.(active := PSM.ResumeAll(filter), blocked := []);
      var s3 := s2.(processed := AI.init_bpcset(RB.size(code)),
                    isblocked := AI.init_pcset(RB.size(code)),
                    cdn := LCdn.init_cdn(), cp := AI.incr_cp(s2.cp, dir));
      var newchar := AI.get_char(str, s3.cp - AI.cp_offset(dir));
      var s4 := s3.(context := LAnc.update_context(s3.context, newchar));
      assert s4.cp == vms.cp + 1;
      assert s4.context.nextchar == AI.get_char(str, s4.cp);
      assert AI.FFindMatch(code, str, vms, ov, dir, cdn)
          == AI.FFindMatch(code, str, s4, ov1, dir, cdn);

      PSM.AdvanceInpOfCpBridge(str, vms.cp);
      var nextinp := PT.NextInp(inp1);
      assert nextinp == PIV.InpOfCp(str, vms.cp + 1);
      assert LC.AdvanceInput(inp1, WP.Forward) == Some(nextinp);
      assert BlockedRepLkCRec(rer, qm, re, code, inp1, nextinp, crv, str, ov, S, tb1, filter,
                           ncap, nlook, nquant);

      if |tb1| == 0 {
        assert |filter| == 0;
        assert s4.active == [] && s4.blocked == [];
        PSM.FFindMatchInert(code, str, s4, ov1, dir, cdn);
        assert AI.FFindMatch(code, str, s4, ov1, dir, cdn).0 == s4.bestmatch == s1.bestmatch;
        bestT := best1;
        assert PTL.PikeTreeStepLk(bst1, PT.PTS_final(best1));
        TrcLkRefl(PT.PTS_final(best1));
        TrcLkCons(bst1, PT.PTS_final(best1), PT.PTS_final(best1));
        TrcLkTrans(bst, bst1, PT.PTS_final(best1));
      } else {
        // B: pts_nextchar — the blocked pairs become the next position's actives.
        var bst2 := PT.PTS(nextinp, tb1, best1, [], SS.InitialSeenTrees);
        assert PTL.PikeTreeStepLk(bst1, bst2);

        // ---- machine A: re-establish PikeInvFullRE at (ptsA2, s4) — the
        // FindMatchSimRE consume-phase block, verbatim.
        assert ptsA1.PTS?;
        var PTS(inpA1, taA1, bestA1, tbA1, seenA1) := ptsA1;
        assert PIV.ActiveRepRE(rer, qm, re, code, inpA1, taA1, s1.active);
        assert taA1 == [] && inpA1 == PIV.InpOfCp(str, s1.cp);
        assert PIV.BlockedRepRE(rer, qm, re, code, inpA1, nextinp, tbA1, filter);
        var ptsA2 := PT.PTS(nextinp, tbA1, bestA1, [], SS.InitialSeenTrees);
        PSM.BlockedToActiveRE(rer, qm, re, code, inpA1, nextinp, tbA1, filter);
        assert PIV.ActiveRepRE(rer, qm, re, code, nextinp, tbA1, s4.active);
        CM.FConsumeClocksLE(s1);
        CM.FConsumeRegsWf(s1, ncap, nlook, nquant);
        CM.FConsumeCapsLE(s1);
        assert CM.VmClocksLE(s4) by {
          assert s4.active == s2.active && s4.blocked == s2.blocked
              && s4.bestmatch == s2.bestmatch && s4.clock == s2.clock;
        }
        assert CM.VmRegsWf(s4, ncap, nlook, nquant) by {
          assert s4.active == s2.active && s4.blocked == s2.blocked && s4.bestmatch == s2.bestmatch;
        }
        assert CM.VmCapsLE(s4) by { CM.VmCapsLEAdvance(s2, s4); }
        assert forall t2 | t2 in s4.active :: PSM.ThreadNestRE(re, code, endl, t2.pc, t2) by {
          forall p | p in filter ensures PSM.ThreadNestRE(re, code, endl, p.0.pc + 1, p.0) {
            PSM.MatchingBlockedSubset(LC.Reverse(s1.blocked), inp1, p);
            PSM.ReverseMembership(s1.blocked, p);
            assert p in s1.blocked;
          }
          PSM.ResumeAllNest(re, code, endl, filter);
        }
        PIV.InitialInclusionRE(rer, qm, code, nextinp, PIV.HdTreeOf(tbA1),
                               PIV.HeadPcOf(s4.active), RB.size(code));
        assert PSM.IsblockedInclusionRE(rer, qm, code, nextinp, SS.InitialSeenTrees, s4.isblocked) by {
          forall pc0: nat | AI.pc_mem(s4.isblocked, pc0)
            ensures exists t0: LT.Tree, b0: bool ::
              SS.Inseen(SS.InitialSeenTrees, t0) && TT.TreeThreadRE(rer, qm, code, nextinp, t0, pc0, b0)
          {
            assert s4.isblocked[pc0] == false;
            assert false;
          }
        }
        assert forall t2 | t2 in s4.active :: PSM.EaColdOkRE(code, t2) by {
          PSM.ResumeAllEa(filter);
          assert s4.active == PSM.ResumeAll(filter);
        }
        assert forall t2 | t2 in s4.active :: PIV.LooksCapUnset(re, t2.capture_regs.a_clk) by {
          forall p | p in filter ensures PIV.LooksCapUnset(re, p.0.capture_regs.a_clk) {
            PSM.MatchingBlockedSubset(LC.Reverse(s1.blocked), inp1, p);
            PSM.ReverseMembership(s1.blocked, p);
            assert p in s1.blocked;
          }
          PSM.ResumeAllCapUnset(re, filter);
          assert s4.active == PSM.ResumeAll(filter);
        }
        assert PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str, ptsA2, s4, ncap, nlook, nquant);

        // ---- machine B: LiftInv at (bst2, s4).
        BlockedToActiveLkCRec(rer, qm, re, code, inp1, nextinp, crv, str, ov, S, tb1, filter,
                           ncap, nlook, nquant);
        assert ActiveRepLkCRec(rer, qm, re, code, nextinp, crv, str, ov, S, tb1, s4.active,
                            ncap, nlook, nquant);
        assert PIV.ContextOkRE(str, s4.cp, s4.context);
        forall nx2 | LC.AdvanceInput(nextinp, WP.Forward) == Some(nx2)
          ensures BlockedRepLkCRec(rer, qm, re, code, nextinp, nx2, crv, str, ov, S, [],
                                PIV.MatchingBlocked(LC.Reverse(s4.blocked), nextinp), ncap, nlook, nquant)
        {
          assert LC.Reverse(s4.blocked) == [];
          assert PIV.MatchingBlocked([], nextinp) == [];
        }
        InitialSeenRepLk(rer, qm, code, nextinp, PIV.HdTreeOf(tb1), PIV.HeadPcOf(s4.active),
                         RB.size(code));
        assert IsblockedRepLk(rer, qm, code, nextinp, SS.InitialSeenTrees, s4.isblocked) by {
          forall pc0: nat | AI.pc_mem(s4.isblocked, pc0)
            ensures exists t0: LT.Tree, b0: bool ::
              SS.Inseen(SS.InitialSeenTrees, t0) && TreeRepLkRE(rer, qm, code, nextinp, t0, pc0, b0)
          {
            assert s4.isblocked[pc0] == false;
            assert false;
          }
        }
        assert SSx.IsStrictSuffix(nextinp, inp1, WP.Forward);
        LL.OracleOkSuffixStep(rer, qm, inp1, nextinp);

        // ---- (E3) the carrier crosses the consume: reactivation keeps registers ----
        // (D3) `*Top` carriers throughout.
        assert LookNestRepBTop(re, S, tb1, filter) by {
          assert LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, s1, ncap, nlook, nquant);
          assert bst1 == PT.PTS(inp1, ta1, best1, tb1, seen1);
          assert LC.AdvanceInput(inp1, WP.Forward).Some?;
          assert filter == PIV.MatchingBlocked(LC.Reverse(s1.blocked), inp1);
        }
        assert LookNestRepCTop(re, S, tb1, s4.active) by {
          assert |tb1| == |filter|;                        // LookNestRepBTop lengths
          assert s4.active == PSM.ResumeAll(filter);
          ResumeAllLen(filter);
          forall i | 0 <= i < |tb1|
            ensures LookNestOkTTop(re, S, tb1[i].1, s4.active[i])
          {
            assert LookNestOkTTop(re, S, tb1[i].1, filter[i].0);
            ResumeAllIndex(filter, i);
            assert s4.active[i] == filter[i].0.(exit_allowed := true, pc := filter[i].0.pc + 1);
            assert s4.active[i].capture_regs == filter[i].0.capture_regs
                && s4.active[i].look_regs == filter[i].0.look_regs
                && s4.active[i].quant_regs == filter[i].0.quant_regs;
          }
        }
        assert LC.AdvanceInput(nextinp, WP.Forward).Some? ==>
          LookNestRepBTop(re, S, [], PIV.MatchingBlocked(LC.Reverse(s4.blocked), nextinp)) by {
          assert LC.Reverse(s4.blocked) == [];
          assert PIV.MatchingBlocked([], nextinp) == [];
        }
        assert LookNestBackRepBTop(re, crv, str, ov, S, tb1, filter, ncap, nlook, nquant) by {
          assert LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst1, s1, ncap, nlook, nquant);
          assert bst1 == PT.PTS(inp1, ta1, best1, tb1, seen1);
          assert LC.AdvanceInput(inp1, WP.Forward).Some?;
        }
        assert LookNestBackRepCTop(re, crv, str, ov, S, tb1, s4.active, ncap, nlook, nquant) by {
          assert s4.active == PSM.ResumeAll(filter);
          ResumeAllLen(filter);
          forall i | 0 <= i < |tb1|
            ensures LookNestBackTTop(re, crv, str, ov, S, tb1[i].1, s4.active[i], ncap, nlook, nquant)
          {
            assert LookNestBackTTop(re, crv, str, ov, S, tb1[i].1, filter[i].0, ncap, nlook, nquant);
            ResumeAllIndex(filter, i);
            assert s4.active[i] == filter[i].0.(exit_allowed := true, pc := filter[i].0.pc + 1);
            assert s4.active[i].look_regs == filter[i].0.look_regs
                && s4.active[i].quant_regs == filter[i].0.quant_regs;
            LookNestBackTRegSameTop(re, crv, str, ov, S, tb1[i].1, tb1[i].1, filter[i].0, s4.active[i],
                                 ncap, nlook, nquant);
          }
        }
        assert LC.AdvanceInput(nextinp, WP.Forward).Some? ==>
          LookNestBackRepBTop(re, crv, str, ov, S, [],
                           PIV.MatchingBlocked(LC.Reverse(s4.blocked), nextinp), ncap, nlook, nquant) by {
          assert LC.Reverse(s4.blocked) == [];
          assert PIV.MatchingBlocked([], nextinp) == [];
        }
        assert LiftInvRec(rer, qm, re, code, crv, str, ov, S, bst2, s4, ncap, nlook, nquant);

        // recurse and chain.
        bestT := LiftFindMatchCRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                ptsA2, bst2, s4, cdn, ncap, nlook, nquant);
        TrcLkCons(bst1, bst2, PT.PTS_final(bestT));
        TrcLkTrans(bst, bst1, PT.PTS_final(bestT));
        assert AI.FFindMatch(code, str, s4, ov1, dir, cdn).0
            == AI.FFindMatch(code, str, vms, ov, dir, cdn).0;
      }
    }
  }


  lemma LiftInitCRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                  endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                  S: set<LG.GroupId>, tstar: LT.Tree, t: LT.Tree, inp: LC.Input, vms: AI.VmState,
                  ncap: int, nlook: int, nquant: int)
    returns (tcan: LT.Tree)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires code == CP.compile_to_bytecode(re)               // WalkOkEntry's carrier
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str,
                               PT.PikeTreeInitialState(tstar, inp), vms, ncap, nlook, nquant)
    // (L4 NESTED ENTRY) the recursive fragment replaces the depth-1
    // LookBehindFragmentRE: NestedFragmentRE + TransWf + CapUnique come from
    // StaticOkNestedRE, and NegLooksLookFreeRE is the extra hypothesis that
    // lets `TranslateFragmentPikeLkRec` establish PikeLkRegexRec(Translate(re)).
    requires PSM.StaticOkNestedRE(qm, re, code, endl)
    requires NR.NegLooksLookFreeRE(re)
    requires AR.ActionsRepL(rer, qm, [LS.Areg(T.Translate(re))], code, 0)
    requires EL.BoolTreeLk(rer, [LS.Areg(T.Translate(re))], inp, BS.CannotExit, t)
    requires LL.OracleOkSuffix(rer, qm, inp)
    requires inp == PIV.InpOfCp(str, vms.cp) && 0 <= vms.cp <= |str|
    requires vms.active == [AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant))]
    requires vms.bestmatch.None?
    requires vms.blocked == []                                // genuine start: nothing blocked yet
    requires vms.processed == AI.init_bpcset(RB.size(code))   // genuine start: nothing processed yet
    requires vms.isblocked == AI.init_pcset(RB.size(code))
    requires PIV.ContextOkRE(str, vms.cp, vms.context)
    ensures TreeRepLkRE(rer, qm, code, inp, tcan, 0, false)
    ensures CE.ProgErase(tcan) == CE.ProgErase(t)             // endpoint glue: FirstLeaf(tcan) == FirstLeaf(t)
    ensures LiftInvCRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                     PT.PikeTreeInitialState(tstar, inp), PT.PikeTreeInitialState(tcan, inp), vms,
                     ncap, nlook, nquant)
  {
    // The single active pair (t, init_thread) ties via ThreadRepLk (THREAD-
    // anchored — no tstar↔t tree link); the payload is vacuous because a fresh
    // thread denotes Empty. PikeInvFullRE(ptsA, vms) is the hypothesis.
    PIV.GmOfLiveInit(re, ncap, nlook, nquant);        // GmOfLive(re, init...) == Empty
    var it := AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant));
    var acts := [LS.Areg(T.Translate(re))];
    assert it.pc == 0 && it.exit_allowed == false;
    assert it.capture_regs == AReg.init_regs(ncap)
        && it.look_regs == AReg.init_regs(nlook) && it.quant_regs == AReg.init_regs(nquant);
    EL.TranslateFragmentPikeLkRec(re);                     // PikeLkRegex(Translate(re))
    EL.PikeLkActionsRecConsIff(LS.Areg(T.Translate(re)), []);
    assert EL.PikeLkActionsRec(acts);
    assert GateAheadClear(acts, LG.Empty);              // Empty has no keys
    TranslateDefGroupsNoDup(re);                        // NoDupSeq(DefGroups(Translate(re)))
    WalkDefsOkEntry(T.Translate(re));
    M.AllDefsActsCons(LS.Areg(T.Translate(re)), []);
    assert M.AllDefsActs(acts) == L.DefGroups(T.Translate(re));   // AllDefsActs([]) == []
    assert WalkPairLkRec(rer, qm, code, inp, t, LG.Empty, it.pc as nat, it.exit_allowed) by {
      assert it.pc as nat == 0;
      assert AR.ActionsRepL(rer, qm, acts, code, 0);
      assert ATR.EaOf(BS.CannotExit) == it.exit_allowed;   // both false
      assert EL.BoolTreeLk(rer, acts, inp, BS.CannotExit, t);
      assert exists actsw: LS.Actions, bw: BS.LoopBool ::
          AR.ActionsRepL(rer, qm, actsw, code, it.pc as nat)
          && EL.PikeLkActionsRec(actsw)
          && ATR.EaOf(bw) == it.exit_allowed
          && EL.BoolTreeLk(rer, actsw, inp, bw, t)
          && GateAheadClear(actsw, LG.Empty)
          && WalkDefsOk(actsw);
    }
    assert GmtTieOutside(re, it, LG.Empty, S);          // gml == Empty, agrees with Empty
    assert ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, t, LG.Empty, it, ncap, nlook, nquant);
    // Construct machine B's PLANTED CANONICAL entry tree; the raw walk tree
    // `t` is its value-layer erasure witness.
    WkE.WalkOkEntryNested(re);
    assert WO.WalkOk(acts, code, 0, false);
    assert ATR.EaOf(BS.CannotExit) == false;
    tcan := ActionsTreeRepLkRERec(rer, qm, acts, code, 0, inp, BS.CannotExit, t);
    assert ThreadRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, tcan, LG.Empty, it,
                        ncap, nlook, nquant) by {
      assert TreeRepLkRE(rer, qm, code, inp, tcan, it.pc as nat, it.exit_allowed);
      assert CE.ProgErase(t) == CE.ProgErase(tcan)
          && ThreadRepLkRec(rer, qm, re, code, inp, crv, str, ov, S, t, LG.Empty, it, ncap, nlook, nquant);
    }
    assert ActiveRepLkCRec(rer, qm, re, code, inp, crv, str, ov, S, [(tcan, LG.Empty)], [it], ncap, nlook, nquant);
    // ptsB = PTS(inp, [(tcan, Empty)], None, [], InitialSeenTrees); best None both sides.
    assert PT.PikeTreeInitialState(tcan, inp) == PT.PTS(inp, [(tcan, LG.Empty)], None, [], SS.InitialSeenTrees);
    assert PT.PikeTreeInitialState(tstar, inp).PTS? && PT.PikeTreeInitialState(tstar, inp).inp == inp;
    assert BestTieLkNestedTop(re, crv, str, ov, S, None, vms.bestmatch, ncap, nlook, nquant);
    // Blocked: genuine start — both sides empty.
    assert PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp) == [];
    forall nextinp | LC.AdvanceInput(inp, WP.Forward) == Some(nextinp)
      ensures BlockedRepLkCRec(rer, qm, re, code, inp, nextinp, crv, str, ov, S, [],
                            PIV.MatchingBlocked(LC.Reverse(vms.blocked), inp), ncap, nlook, nquant)
    { }
    // B-side seen ↔ processed: at the genuine start nothing is processed, so
    // `SeenRepLk` holds vacuously (mirror of `PIV.InitialInclusionRE`).
    InitialSeenRepLk(rer, qm, code, inp,
                     PIV.HdTreeOf([(tcan, LG.Empty)]), PIV.HeadPcOf([it]), RB.size(code));
  }


  lemma L3aCompositeCloseRec(rer: LW.RegExpRecord, qm: AR.QMap, re: R.regex, code: RB.code,
                          endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, ov: LOr.OracleView,
                          S: set<LG.GroupId>, tstar: LT.Tree, t: LT.Tree, inp: LC.Input,
                          vms: AI.VmState, cdn: LCdn.cdns, result: Option<AI.Thread>,
                          ncap: int, nlook: int, nquant: int)
    requires NR.NfaRepRE(re, code, 0, endl)
    requires |ov| == |str| + 1                                    // L3b: propagate to the backward LB gate
    requires PSM.StaticOkNestedRE(qm, re, code, endl) && PSM.SizesOkRE(re, ncap, nlook, nquant)
    requires qm.ov == ov && !rer.multiline
    requires !rer.ignoreCase
    requires S == PIV.CapIdsInLooks(re)
    // (BRICK D5) NON-VACUITY: the composite sim's per-lid static package is the
    // depth-AGNOSTIC `GateStaticsOkNested` (nested gate bodies) under the positive-
    // lookahead-nesting scope `M.NoPosLookbehindRE(re)` — this driver is now
    // NON-VACUOUS at nesting depth >= 2.
    requires GateStaticsOkNested(qm, re, crv, ncap, nlook, nquant)
    requires M.NoPosLookbehindRE(re)
    requires LTB.LookUnique(re)
    requires LTB.LookTablesOk(re, crv)
    requires code == CP.compile_to_bytecode(re)
    requires vms.blocked == []
    requires vms.processed == AI.init_bpcset(RB.size(code))
    requires vms.isblocked == AI.init_pcset(RB.size(code))
    requires PIV.ContextOkRE(str, vms.cp, vms.context)
    // Thread-anchored entry facts (feed LiftInitC) — replace the dead
    // LeavesAgreeAtOutside(tstar, t) tree link.
    requires T.TransWf(re) && NR.NegLooksLookFreeRE(re)
    requires AR.ActionsRepL(rer, qm, [LS.Areg(T.Translate(re))], code, 0)
    requires EL.BoolTreeLk(rer, [LS.Areg(T.Translate(re))], inp, BS.CannotExit, t)
    requires PTL.PikeSubtreeLk(t)
    requires PSM.PikeInvFullRE(rer, qm, re, code, endl, ngroups, str,
                               PT.PikeTreeInitialState(tstar, inp), vms, ncap, nlook, nquant)
    requires LL.OracleOkSuffix(rer, qm, inp)
    requires inp == PIV.InpOfCp(str, vms.cp) && 0 <= vms.cp <= |str|
    requires vms.active == [AI.init_thread(AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant))]
    requires vms.bestmatch.None?
    requires |vms.processed.true_set| == RB.size(code) && |vms.processed.false_set| == RB.size(code)
    requires vms.context.nextchar == AI.get_char(str, vms.cp)
    requires result == AI.FFindMatch(code, str, vms, ov, LAnc.Forward, cdn).0
    ensures BestTieLkNestedTop(re, crv, str, ov, S, LT.FirstLeaf(t, inp), result, ncap, nlook, nquant)
  {
    var tcan := LiftInitCRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S, tstar, t, inp, vms,
                          ncap, nlook, nquant);
    assert LiftInvRec(rer, qm, re, code, crv, str, ov, S,
                   PT.PikeTreeInitialState(tcan, inp), vms, ncap, nlook, nquant);
    // (L4 GENUINELY NESTED) the whole chain is nested-typed and driven by the
    // RECURSIVE walk: the entry (LiftInitCRec) builds WalkPairLkRec directly, so
    // no StaticOkRE bridge is needed -- StaticOkNestedRE feeds the tier as-is.
    var bestT := LiftFindMatchCRec(rer, qm, re, code, endl, ngroups, crv, str, ov, S,
                                PT.PikeTreeInitialState(tstar, inp),
                                PT.PikeTreeInitialState(tcan, inp),
                                vms, cdn, ncap, nlook, nquant);
    // bestT IS the canonical tree's first leaf ...
    PikeSubtreeLkEraseIff(t);
    PikeSubtreeLkEraseIff(tcan);
    assert PTL.PikeSubtreeLk(tcan);
    PTL.PikeTreeLkComputesFirstLeaf(tcan, inp, bestT);
    assert bestT == LT.FirstLeaf(tcan, inp);
    // ... which is the RAW entry tree's first leaf (Progress is leaf-transparent)
    assert CE.LeavesAgree(tcan, t) by {
      forall gm: LG.GroupMap, xinp: LC.Input, dr: WP.Direction
        ensures LT.TreeLeaves(tcan, gm, xinp, dr) == LT.TreeLeaves(t, gm, xinp, dr)
      {
        ProgEraseLeavesEq(tcan, gm, xinp, dr);
        ProgEraseLeavesEq(t, gm, xinp, dr);
      }
    }
    CE.LAFirstLeaf(tcan, t, inp);
    assert LT.FirstLeaf(t, inp) == bestT;
  }


  /** BRICK D1 — the per-body composite sim for a matched positive lookAHEAD.
      Runs the (nested-capable) recursive composite simulation
      `L3aCompositeCloseRec` on a matched forward-lookahead's IN-CONTEXT FRESH body
      replay and projects the (E3) look-path carrier
      `LookNestOkT(body, CapIdsInLooks(body), leafgm_body, rf)` — coupling the engine
      replay `rf` to the body's SPEC first-leaf group map `leafgm_body` (the
      non-vacuous coupling of the C4d finding; a bare `GmOfLive(body, rf)` keying
      is vacuously true, MainMatchInsideCapsInit).

      Body-match framing (mirrors `M.BodyTreeAtCpNested` — the `FindMatchSimRENested`
      body precedent): `bodycode == compile_to_bytecode(body)` (which is
      `compile_to_bytecode(capture_regex(la, body))` for a lookahead, since
      `capture_regex(Lookahead, body) == body`); the shared TOP-LEVEL `crv`/`ov`
      (NOT a fresh `FFullCompilation(body)`). The replay is the actual FLookLoop
      REPLAY value `FFindMatchPlus`, from FRESH registers — `FNulledPlusIdentity` on
      the `QuantRegsFinal` match makes the plus reconstruction the identity, so
      `rf == FFindMatch`, and `LookNestOkT` (which reads only the three register
      banks) transports across that identity.

      FRAMING VERDICT (brick D1): `L3aCompositeCloseRec` / `LiftFindMatchCRec` are
      stated GENERALLY over `re/code/crv/ov` — the ONLY whole-regex-shaped
      hypothesis is `code == compile_to_bytecode(re)`, discharged here by
      `bodycode == compile_to_bytecode(body)`. So the driver applies to a body
      match DIRECTLY (mirroring how `FindMatchSimRENested` is applied to bodies),
      WITHOUT the `FFullCompilation` wrapper. The crv-keyed statics
      `GateStaticsOk`/`LookTablesOk`/`LookUnique(body)` are taken as hypotheses (the
      FLookLoop caller descends them from the top-level regex — `LookTablesOk` and
      `LookUnique` descend STRUCTURALLY through `Re_lookaround`).

      DEPTH BOUNDARY (the residual sub-brick): `GateStaticsOk(qm, body, crv, ...)`
      is the DEPTH-1-locked hypothesis — via `GateStaticAt` (LiftSim :5515) it forces
      every directly-gated look of `body` to have a LOOK-FREE body (`StaticOkRE` +
      `LookFreeRE(gatebody)`), and the gate-pass carrier preserver (:20693) derives
      `CapIdsInLooks(gatebody) == {}` from it. So it is establishable (via
      `GateStaticsFromTables`, which needs `LookBehindFragmentRE(body)`) exactly when
      `body`'s directly-gated looks are look-free. Deeper nesting needs `GateStaticAt`
      generalized to nested gate bodies (`StaticOkNestedRE`) and the gate-pass carrier
      fed the recursive per-body `LookNestOkT` — that generalization IS the remaining
      recursion, reported as the precise blocker. */
  lemma LookNestOkTFromBodyReplay(
      rer: LW.RegExpRecord, qm: AR.QMap, la: R.lookaround, body: R.regex, bodycode: RB.code,
      endl: nat, ngroups: nat, crv: CP.FCompiled, str: string, cp: nat, ov: LOr.OracleView,
      lookcdn: LCdn.cdns, plus_bc: seq<RB.code>, ncap: int, nlook: int, nquant: int)
    requires la.Lookahead?
    requires PSM.StaticOkNestedRE(qm, body, bodycode, endl)
    requires NR.NegLooksLookFreeRE(body)
    requires PSM.SizesOkRE(body, ncap, nlook, nquant)
    requires qm.ov == ov && !rer.multiline && !rer.ignoreCase
    requires cp <= |str|
    requires bodycode == CP.compile_to_bytecode(body)
    requires LL.OracleOkSuffix(rer, qm, PIV.InpOfCp(str, cp))
    requires |ov| == |str| + 1
    // crv-keyed statics (caller descends from the top-level regex)
    // (BRICK D5) NESTED per-lid package + positive-lookahead-nesting scope, so the
    // per-body composite sim `L3aCompositeCloseRec` applies at depth >= 2.
    requires GateStaticsOkNested(qm, body, crv, ncap, nlook, nquant)
    requires M.NoPosLookbehindRE(body)
    requires LTB.LookUnique(body)
    requires LTB.LookTablesOk(body, crv)
    ensures
      var inp := PIV.InpOfCp(str, cp);
      var t := LFU.ComputeTr(rer, [LS.Areg(T.Translate(body))], inp, LG.Empty, WP.Forward);
      var rf := AI.FFindMatchPlus(bodycode, body, plus_bc, str, ov, LAnc.Forward, cp,
                                  AReg.init_regs(ncap), AReg.init_regs(nlook), AReg.init_regs(nquant),
                                  0, lookcdn).0;
      rf.Some? ==>
        LT.FirstLeaf(t, inp).Some?
        && LookNestOkTTop(body, PIV.CapIdsInLooks(body), LT.FirstLeaf(t, inp).value.1, rf.value)
  {
    var inp := PIV.InpOfCp(str, cp);
    var acts := [LS.Areg(T.Translate(body))];
    var S := PIV.CapIdsInLooks(body);

    // ---- the spec tree (mirror BodyTreeAtCpNested) -----------------------
    LFU.ComputeTrIsTree(rer, acts, inp, LG.Empty, WP.Forward);
    var t := LFU.ComputeTr(rer, acts, inp, LG.Empty, WP.Forward);
    assert LS.IsTree(rer, acts, inp, LG.Empty, WP.Forward, t);
    EL.TranslateFragmentPikeLkRec(body);
    EL.BooleanCorrectLkRec(rer, T.Translate(body), inp, t);
    assert forall i :: 0 <= i < |acts| ==> !acts[i].Acheck?;
    M.BoolTreeLbIrrel(rer, acts, inp, BS.CanExit, BS.CannotExit, t);
    assert EL.BoolTreeLk(rer, acts, inp, BS.CannotExit, t);

    // PikeSubtreeLk(t) (mirror the whole-regex entry, :15798)
    TranslateNoBackref(body);
    assert NoBackrefActions(acts);
    var fuel0 := FS.ActionsFuel(acts, inp, WP.Forward) + 1;
    FS.FunctionalTerminates(rer, acts, inp, LG.Empty, WP.Forward, fuel0);
    assert FS.ComputeTree(rer, acts, inp, LG.Empty, WP.Forward, fuel0) == Some(t);
    ComputePikeSubtreeLk(rer, acts, inp, LG.Empty, WP.Forward, fuel0, t);
    assert PTL.PikeSubtreeLk(t);

    // ---- the CHECKED tree (mirror BodyTreeAtCpNested) --------------------
    WkE.WalkOkEntryNested(body);
    assert EL.PikeLkActionsRec(acts) by {
      assert acts == acts + [];
      assert EL.PikeLkActionsRec([]);
      EL.PikeLkActionsRecConsIff(LS.Areg(T.Translate(body)), []);
    }
    assert WO.WalkOk(acts, bodycode, 0, ATR.EaOf(BS.CannotExit));
    AR.CompileToBytecodeActionsRepNested(rer, qm, body);
    assert AR.ActionsRepL(rer, qm, acts, bodycode, 0);
    M.LkBodyGroupsEqCapIdsInLooks(body);
    assert S == LL.LkBodyGroups(T.Translate(body));
    LL.LkBodyGroupsConfines(T.Translate(body), S);
    assert LL.LkActsInS(acts, S) by { LL.LkActsInSCons(LS.Areg(T.Translate(body)), [], S); }
    LL.ComputeTrLkConfinedK(rer, acts, inp, LG.Empty, WP.Forward, S);
    var tstar := ATR.ActionsTreeRepRENested(rer, qm, acts, bodycode, 0, inp, BS.CannotExit, t, S);
    assert TREP.TreeRepRE(qm, tstar, bodycode, 0, inp, false);
    assert TT.TreeThreadRE(rer, qm, bodycode, inp, tstar, 0, false);

    // ---- the fresh entry VM + PikeInvFullRE (mirror FindMatchBodyAtCpNested) --
    var ctx := AI.cp_context(cp, str, LAnc.Forward);
    var capture := AReg.init_regs(ncap);
    var look := AReg.init_regs(nlook);
    var quant := AReg.init_regs(nquant);
    var vms := AI.FInitState(bodycode, cp, capture, look, quant, 0, ctx);
    assert ctx.nextchar == AI.get_char(str, cp);
    PSM.InitialPikeInvFullREAtCpNested(rer, qm, body, bodycode, endl, ngroups, str, cp, tstar,
                                       vms, ncap, nlook, nquant);
    assert PSM.PikeInvFullRE(rer, qm, body, bodycode, endl, ngroups, str,
                             PT.PikeTreeInitialState(tstar, inp), vms, ncap, nlook, nquant);
    assert PIV.ContextOkRE(str, vms.cp, vms.context);

    // code shape: every SetQuantToClock has b == false (mirror :15777)
    forall pc: nat, q: int, b: bool | NR.GetPcRE(bodycode, pc) == Some(RB.SetQuantToClock(q, b))
      ensures !b
    {
      if pc < endl {
        NI.CodeShapeAt(body, bodycode, 0, endl, pc);
      } else if pc == endl {
      } else {
        assert pc >= |bodycode|;
      }
    }

    // ---- run the composite sim on the body match -------------------------
    var result := AI.FFindMatch(bodycode, str, vms, ov, LAnc.Forward, lookcdn).0;
    L3aCompositeCloseRec(rer, qm, body, bodycode, endl, ngroups, crv, str, ov, S, tstar, t, inp,
                         vms, lookcdn, result, ncap, nlook, nquant);
    assert BestTieLkNestedTop(body, crv, str, ov, S, LT.FirstLeaf(t, inp), result, ncap, nlook, nquant);

    // ---- reconcile FFindMatchPlus (fresh) with FFindMatch ----------------
    var fmres := AI.FFindMatch(bodycode, str, vms, ov, LAnc.Forward, lookcdn);
    assert result == fmres.0;
    var rf := AI.FFindMatchPlus(bodycode, body, plus_bc, str, ov, LAnc.Forward, cp,
                                capture, look, quant, 0, lookcdn);
    assert rf.0 == (match result
                    case None => None
                    case Some(thread) =>
                      Some(AI.FReconstructPlus(thread, body, plus_bc, str, fmres.1, LAnc.Forward).0));
    if rf.0.Some? {
      assert result.Some?;
      var thread := result.value;
      // winning-thread wf + quant-final -> reconstruct identity (mirror :15896)
      CM.RegsClocksLEInit(ncap, 0);
      CM.RegsClocksLEInit(nlook, 0);
      CM.RegsClocksLEInit(nquant, 0);
      CM.FInitStateClocksLE(bodycode, cp, capture, look, quant, 0, ctx);
      CM.FInitStateRegsWf(bodycode, cp, ncap, nlook, nquant, 0, ctx);
      assert M.VmQuantFinal(vms) by {
        var th0 := AI.init_thread(capture, look, quant);
        assert M.QuantRegsFinal(th0) by {
          forall k ensures AI.get_idx(quant.a_cp, k) < 0 && AI.get_idx(quant.a_clk, k) >= -1 {
            if 0 <= k < |quant.a_cp| { assert quant.a_cp[k] == -1; }
            if 0 <= k < |quant.a_clk| { assert quant.a_clk[k] == -1; }
          }
        }
        forall t2 | t2 in vms.active ensures M.QuantRegsFinal(t2) { assert t2 == th0; }
      }
      M.FFindMatchThreadFacts(bodycode, str, vms, ov, LAnc.Forward, lookcdn, ncap, nlook, nquant);
      assert CM.ThreadRegsWf(thread, ncap, nlook, nquant) && M.QuantRegsFinal(thread);
      M.FNulledPlusIdentity(body, thread.capture_regs, thread.look_regs, thread.quant_regs,
                            plus_bc, str, fmres.1, LAnc.Forward);
      assert AI.FReconstructPlus(thread, body, plus_bc, str, fmres.1, LAnc.Forward).0 == thread;
      assert rf.0.value == thread;
      // project the (E3) carrier out of BestTieLkNestedTop and transport it
      assert LT.FirstLeaf(t, inp).Some?;
      assert LookNestOkTTop(body, S, LT.FirstLeaf(t, inp).value.1, thread);
    }
  }

  // ==========================================================================
  // BRICK D4: the RECONSTRUCTED-bank ancestor look-clock chain (feeds (i)/(ii)
  // of `M.ReconInnerGmOfLiveClose`). Two structural spine lemmas first.
  // ==========================================================================

  /** (BRICK D4 infra) Lk-LIFT for TOP-LEVEL looks: for `lid in TopLookIds(re)`
      the descent to `lid` crosses no OTHER lookaround node, so `LookPathPresentLk`
      (which records the ancestor look clocks) coincides with the lc-free
      `LookPathPresent`. The only differing branch — `Re_lookaround(lid0 != lid)`
      — is unreachable: a top-level id equals the node's own id there. */
  lemma LookPathPresentLkOfTop(re: R.regex, cc: seq<int>, lc: seq<int>, qc: seq<int>, mx: int, lid: nat)
    requires LTB.LookUnique(re)
    requires lid in NI.TopLookIds(re)
    requires lid in LTB.LookIds(re)
    requires NI.LookPathPresent(re, cc, qc, mx, lid)
    ensures NI.LookPathPresentLk(re, cc, lc, qc, mx, lid)
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if lid in LTB.LookIds(r1) {
        NI.TopLookIdsIn(r2);
        assert lid !in NI.TopLookIds(r2);
        assert lid in NI.TopLookIds(r1);
        LookPathPresentLkOfTop(r1, cc, lc, qc, mx, lid);
      } else {
        assert lid in LTB.LookIds(r2);
        NI.TopLookIdsIn(r1);
        assert lid !in NI.TopLookIds(r1);
        assert lid in NI.TopLookIds(r2);
        LookPathPresentLkOfTop(r2, cc, lc, qc, mx, lid);
      }
    case Re_con(r1, r2) =>
      if lid in LTB.LookIds(r1) {
        NI.TopLookIdsIn(r2);
        assert lid !in NI.TopLookIds(r2);
        assert lid in NI.TopLookIds(r1);
        LookPathPresentLkOfTop(r1, cc, lc, qc, mx, lid);
      } else {
        assert lid in LTB.LookIds(r2);
        NI.TopLookIdsIn(r1);
        assert lid !in NI.TopLookIds(r1);
        assert lid in NI.TopLookIds(r2);
        LookPathPresentLkOfTop(r2, cc, lc, qc, mx, lid);
      }
    case Re_quant(nul, qid, q, r1) =>
      LookPathPresentLkOfTop(r1, cc, lc, qc, AI.get_idx(qc, qid), lid);
    case Re_capture(cid, r1) =>
      LookPathPresentLkOfTop(r1, cc, lc, qc, mx, lid);
    case Re_lookaround(lid0, la, r1) =>
      assert lid0 >= 0 && (lid0 as nat) == lid;    // lid in TopLookIds == {lid0}
  }

  /** (BRICK D4 infra) COMPOSE-TO-LOOK: the `LookPathComposeNested` analogue whose
      TARGET is a nested LOOK `lid2` in `body` rather than a capture group. Stitches
      the ancestor-chain presence to `lid` + `lid`'s own look-clock clause + the
      body-side presence to `lid2` into the full presence to `lid2` in `r`. Same
      alt/con/quant/capture descent as `LookPathComposeNested`; the lookaround base
      case walks the body via the supplied body premise. */
  lemma LookPathComposeLkNested(r: R.regex, body: R.regex, cc: seq<int>, lc: seq<int>, qc: seq<int>,
                                mx: int, lid: nat, lid2: nat)
    requires NR.NestedFragmentRE(r) && LTB.LookUnique(r)
    requires lid in LTB.LookIds(r)
    requires body == NI.LookBodyOfRE(r, lid)
    requires lid2 in LTB.LookIds(body)
    requires NI.LookPathPresentLk(r, cc, lc, qc, mx, lid)
    requires AI.get_idx(lc, lid as int) >= 0
    requires AI.get_idx(lc, lid as int) >= NI.MxAtLidLk(r, qc, mx, lid)
    requires NI.LookPathPresentLk(body, cc, lc, qc, -1, lid2)
    ensures lid2 in LTB.LookIds(r)
    ensures NI.LookPathPresentLk(r, cc, lc, qc, mx, lid2)
    ensures NI.MxAtLidLk(r, qc, mx, lid2) == NI.MxAtLidLk(body, qc, -1, lid2)
    decreases r
  {
    NI.LookBodyLookIdsIn(r, lid);
    assert lid2 in LTB.LookIds(r);
    match r
    case Re_alt(r1, r2) =>
      if lid in LTB.LookIds(r1) {
        assert body == NI.LookBodyOfRE(r1, lid);
        NI.LookBodyLookIdsIn(r1, lid);
        assert lid2 in LTB.LookIds(r1);
        LookPathComposeLkNested(r1, body, cc, lc, qc, mx, lid, lid2);
      } else {
        assert lid in LTB.LookIds(r2);
        assert body == NI.LookBodyOfRE(r2, lid);
        NI.LookBodyLookIdsIn(r2, lid);
        assert lid2 in LTB.LookIds(r2);
        assert lid2 !in LTB.LookIds(r1) by {
          if lid2 in LTB.LookIds(r1) { assert lid2 in LTB.LookIds(r1) * LTB.LookIds(r2); }
        }
        LookPathComposeLkNested(r2, body, cc, lc, qc, mx, lid, lid2);
      }
    case Re_con(r1, r2) =>
      if lid in LTB.LookIds(r1) {
        assert body == NI.LookBodyOfRE(r1, lid);
        NI.LookBodyLookIdsIn(r1, lid);
        assert lid2 in LTB.LookIds(r1);
        LookPathComposeLkNested(r1, body, cc, lc, qc, mx, lid, lid2);
      } else {
        assert lid in LTB.LookIds(r2);
        assert body == NI.LookBodyOfRE(r2, lid);
        NI.LookBodyLookIdsIn(r2, lid);
        assert lid2 in LTB.LookIds(r2);
        assert lid2 !in LTB.LookIds(r1) by {
          if lid2 in LTB.LookIds(r1) { assert lid2 in LTB.LookIds(r1) * LTB.LookIds(r2); }
        }
        LookPathComposeLkNested(r2, body, cc, lc, qc, mx, lid, lid2);
      }
    case Re_quant(nul, qid, q, r1) =>
      var qv := AI.get_idx(qc, qid);
      assert qv >= mx;                               // LookPathPresentLk(r,..,lid)
      LookPathComposeLkNested(r1, body, cc, lc, qc, qv, lid, lid2);
    case Re_capture(cid, r1) =>
      NI.LookBodyLookIdsIn(r1, lid);
      assert lid2 in LTB.LookIds(r1);
      LookPathComposeLkNested(r1, body, cc, lc, qc, mx, lid, lid2);
    case Re_lookaround(lid0, la, r1) =>
      if lid0 >= 0 && (lid0 as nat) == lid {
        assert body == r1;
        assert NI.MxAtLidLk(r, qc, mx, lid) == mx;
        assert (lid0 as nat) !in LTB.LookIds(r1);    // LookUnique
        assert lid2 != lid;                          // lid2 in LookIds(r1)
        assert AI.get_idx(lc, lid0) >= 0 && AI.get_idx(lc, lid0) >= mx;
      } else {
        assert lid in LTB.LookIds(r1);
        assert body == NI.LookBodyOfRE(r1, lid);
        assert AI.get_idx(lc, lid0) >= 0 && AI.get_idx(lc, lid0) >= mx;   // LookPathPresentLk(r,..,lid)
        assert NI.LookPathPresentLk(r1, cc, lc, qc, -1, lid);
        assert NI.MxAtLidLk(r, qc, mx, lid) == NI.MxAtLidLk(r1, qc, -1, lid);
        NI.LookBodyLookIdsIn(r1, lid);
        assert lid2 in LTB.LookIds(r1);
        assert (lid0 as nat) !in LTB.LookIds(r1);    // LookUnique
        assert lid2 != lid0 as nat;
        LookPathComposeLkNested(r1, body, cc, lc, qc, -1, lid, lid2);
      }
  }

  /** (BRICK D4 infra) `LookPathPresentAgree` for a NESTED `re` restricted to a
      TOP-LEVEL `lid`. The depth-1 form needs the whole fragment look-free to kill
      the outer `Re_lookaround(lid0 != lid)` branch; under nesting that branch is
      instead unreachable because a top-level id equals the node's own id. So the
      path to `lid` still crosses only OUTSIDE-look captures/quants, and
      `LookPathPresent`/`MxAtLidLk` are congruent under outside-look agreement —
      the transport that moves the main thread's presence onto the RECONSTRUCTED
      banks (which agree with it outside the look registers). */
  lemma LookPathPresentAgreeTopNested(r: R.regex, cc1: seq<int>, qc1: seq<int>,
                                      cc2: seq<int>, qc2: seq<int>, mx: int, lid: nat)
    requires LTB.LookUnique(r)
    requires lid in NI.TopLookIds(r)
    requires lid in LTB.LookIds(r)
    requires forall c: nat :: c in PIV.CapIdsOutsideLooks(r) ==>
      AI.get_idx(cc1, CP.start_reg(c as int)) == AI.get_idx(cc2, CP.start_reg(c as int))
    requires forall q: nat :: q in PIV.QuantIdsOutsideLooks(r) ==>
      AI.get_idx(qc1, q as int) == AI.get_idx(qc2, q as int)
    ensures NI.LookPathPresent(r, cc1, qc1, mx, lid) == NI.LookPathPresent(r, cc2, qc2, mx, lid)
    ensures NI.MxAtLidLk(r, qc1, mx, lid) == NI.MxAtLidLk(r, qc2, mx, lid)
    decreases r
  {
    match r
    case Re_alt(r1, r2) =>
      assert PIV.CapIdsOutsideLooks(r1) <= PIV.CapIdsOutsideLooks(r)
          && PIV.CapIdsOutsideLooks(r2) <= PIV.CapIdsOutsideLooks(r);
      assert PIV.QuantIdsOutsideLooks(r1) <= PIV.QuantIdsOutsideLooks(r)
          && PIV.QuantIdsOutsideLooks(r2) <= PIV.QuantIdsOutsideLooks(r);
      if lid in LTB.LookIds(r1) {
        NI.TopLookIdsIn(r2);
        assert lid !in NI.TopLookIds(r2);
        assert lid in NI.TopLookIds(r1);
        LookPathPresentAgreeTopNested(r1, cc1, qc1, cc2, qc2, mx, lid);
      } else {
        assert lid in LTB.LookIds(r2);
        NI.TopLookIdsIn(r1);
        assert lid !in NI.TopLookIds(r1);
        assert lid in NI.TopLookIds(r2);
        LookPathPresentAgreeTopNested(r2, cc1, qc1, cc2, qc2, mx, lid);
      }
    case Re_con(r1, r2) =>
      assert PIV.CapIdsOutsideLooks(r1) <= PIV.CapIdsOutsideLooks(r)
          && PIV.CapIdsOutsideLooks(r2) <= PIV.CapIdsOutsideLooks(r);
      assert PIV.QuantIdsOutsideLooks(r1) <= PIV.QuantIdsOutsideLooks(r)
          && PIV.QuantIdsOutsideLooks(r2) <= PIV.QuantIdsOutsideLooks(r);
      if lid in LTB.LookIds(r1) {
        NI.TopLookIdsIn(r2);
        assert lid !in NI.TopLookIds(r2);
        assert lid in NI.TopLookIds(r1);
        LookPathPresentAgreeTopNested(r1, cc1, qc1, cc2, qc2, mx, lid);
      } else {
        assert lid in LTB.LookIds(r2);
        NI.TopLookIdsIn(r1);
        assert lid !in NI.TopLookIds(r1);
        assert lid in NI.TopLookIds(r2);
        LookPathPresentAgreeTopNested(r2, cc1, qc1, cc2, qc2, mx, lid);
      }
    case Re_quant(_, qid, _, r1) =>
      assert PIV.CapIdsOutsideLooks(r1) <= PIV.CapIdsOutsideLooks(r);
      assert PIV.QuantIdsOutsideLooks(r1) <= PIV.QuantIdsOutsideLooks(r);
      assert AI.get_idx(qc1, qid) == AI.get_idx(qc2, qid) by {
        if qid >= 0 { assert (qid as nat) in PIV.QuantIdsOutsideLooks(r); }
      }
      LookPathPresentAgreeTopNested(r1, cc1, qc1, cc2, qc2, AI.get_idx(qc1, qid), lid);
    case Re_capture(cid, r1) =>
      assert PIV.CapIdsOutsideLooks(r1) <= PIV.CapIdsOutsideLooks(r);
      assert PIV.QuantIdsOutsideLooks(r1) <= PIV.QuantIdsOutsideLooks(r);
      assert AI.get_idx(cc1, CP.start_reg(cid)) == AI.get_idx(cc2, CP.start_reg(cid)) by {
        if cid >= 0 { assert (cid as nat) in PIV.CapIdsOutsideLooks(r); }
        else { assert CP.start_reg(cid) < 0; }
      }
      LookPathPresentAgreeTopNested(r1, cc1, qc1, cc2, qc2, mx, lid);
    case Re_lookaround(lid0, _, r1) =>
      assert lid0 >= 0 && (lid0 as nat) == lid;    // lid in TopLookIds == {lid0}
  }

  /** (BRICK D4) TOP-ANCESTOR base step: turns the MAIN thread's `LookNestOkTTop`
      presence at a TOP-LEVEL `owner` into the RECONSTRUCTED-bank feeds (i)/(ii) of
      `M.ReconInnerGmOfLiveClose`. The three engine facts owed by the whole-regex
      setup are the hypotheses (matching how `ReconInnerGmOfLiveClose` isolates
      (i)/(ii)):
        - (P1)-(P3): `owner`'s main-thread presence + look-clock (from
          `LookNestOkTTop`, its guard discharged by the caller's live witness);
        - (A1)/(A2): the recon_outer capture/quant frames (`res.0`/`res.2` agree
          with the main thread OUTSIDE the look registers — `FLookLoopFullCovers
          FromTables`/`FLookLoopQuantCoversFromTables`);
        - (S): the top-look-clock stability `res.1[owner] == thread[owner]`
          (`M.FLookLoopLidLookClkStable`).
      Transports the presence via `LookPathPresentAgreeTopNested`, lifts to the
      look-clock-aware `LookPathPresentLk` via `LookPathPresentLkOfTop`, and moves
      the two clock bounds across the stability + the `MxAtLidLk` congruence. */
  lemma TopAncestorClockReconStep(re: R.regex,
                                  rcc: seq<int>, rlc: seq<int>, rqc: seq<int>,
                                  tcc: seq<int>, tlc: seq<int>, tqc: seq<int>, owner: nat)
    requires LTB.LookUnique(re)
    requires owner in NI.TopLookIds(re)
    requires owner in LTB.LookIds(re)
    // (P1)-(P3): main-thread presence at owner (from LookNestOkTTop)
    requires NI.LookPathPresent(re, tcc, tqc, -1, owner)
    requires AI.get_idx(tlc, owner as int) >= 0
    requires AI.get_idx(tlc, owner as int) >= NI.MxAtLidLk(re, tqc, -1, owner)
    // (A1)/(A2): recon_outer frames on the OUTSIDE-look slots
    requires forall c: nat :: c in PIV.CapIdsOutsideLooks(re) ==>
      AI.get_idx(rcc, CP.start_reg(c as int)) == AI.get_idx(tcc, CP.start_reg(c as int))
    requires forall q: nat :: q in PIV.QuantIdsOutsideLooks(re) ==>
      AI.get_idx(rqc, q as int) == AI.get_idx(tqc, q as int)
    // (S): top-look-clock stability
    requires AI.get_idx(rlc, owner as int) == AI.get_idx(tlc, owner as int)
    ensures NI.LookPathPresentLk(re, rcc, rlc, rqc, -1, owner)
    ensures AI.get_idx(rlc, owner as int) >= 0
    ensures AI.get_idx(rlc, owner as int) >= NI.MxAtLidLk(re, rqc, -1, owner)
  {
    // transport the presence + MxAtLidLk from the main thread to the recon banks
    LookPathPresentAgreeTopNested(re, tcc, tqc, rcc, rqc, -1, owner);
    assert NI.LookPathPresent(re, rcc, rqc, -1, owner);
    assert NI.MxAtLidLk(re, rqc, -1, owner) == NI.MxAtLidLk(re, tqc, -1, owner);
    // lift to the look-clock-aware LookPathPresentLk (owner top-level: lc unread)
    LookPathPresentLkOfTop(re, rcc, rlc, rqc, -1, owner);
    // the two clock bounds cross via stability + the MxAtLidLk equality
    assert AI.get_idx(rlc, owner as int) == AI.get_idx(tlc, owner as int);
  }

  /** (BRICK D4) ANCESTOR PEEL: one level of the nesting recursion. Given the
      reconstructed-bank feed (i)/(ii) at a TOP-LEVEL ancestor `A` (from
      `TopAncestorClockReconStep`) and the feed at `owner` WITHIN `A`'s body `bA`
      (from `A`'s replay tower — `LookNestOkTFromBodyReplay(bA)` reconciled onto the
      recon banks), `LookPathComposeLkNested` stitches them into the feed at `owner`
      in the whole `re`. `owner` may sit at ANY depth inside `bA`: supplying its
      within-`bA` feed by a recursive peel drives the chain to arbitrary nesting. */
  lemma AncestorChainPeelStep(re: R.regex, rcc: seq<int>, rlc: seq<int>, rqc: seq<int>,
                              A: nat, owner: nat)
    requires NR.NestedFragmentRE(re) && LTB.LookUnique(re)
    requires A in LTB.LookIds(re)
    requires owner in LTB.LookIds(NI.LookBodyOfRE(re, A))
    // A's feed on the reconstructed banks (base step)
    requires NI.LookPathPresentLk(re, rcc, rlc, rqc, -1, A)
    requires AI.get_idx(rlc, A as int) >= 0
    requires AI.get_idx(rlc, A as int) >= NI.MxAtLidLk(re, rqc, -1, A)
    // owner's feed WITHIN bA on the reconstructed banks (A's replay tower)
    requires NI.LookPathPresentLk(NI.LookBodyOfRE(re, A), rcc, rlc, rqc, -1, owner)
    requires AI.get_idx(rlc, owner as int) >= 0
    requires AI.get_idx(rlc, owner as int) >= NI.MxAtLidLk(NI.LookBodyOfRE(re, A), rqc, -1, owner)
    ensures owner in LTB.LookIds(re)
    ensures NI.LookPathPresentLk(re, rcc, rlc, rqc, -1, owner)
    ensures AI.get_idx(rlc, owner as int) >= 0
    ensures AI.get_idx(rlc, owner as int) >= NI.MxAtLidLk(re, rqc, -1, owner)
  {
    var bA := NI.LookBodyOfRE(re, A);
    NI.LookBodyLookIdsIn(re, A);
    assert owner in LTB.LookIds(re);
    LookPathComposeLkNested(re, bA, rcc, rlc, rqc, -1, A, owner);
    assert NI.MxAtLidLk(re, rqc, -1, owner) == NI.MxAtLidLk(bA, rqc, -1, owner);
  }

  // ---- driver plumbing: the per-body base evidence + nesting recursion ----

  /** `S <= T` with a witness `x in T \ S` ⟹ `|S| < |T|` — robust strict subset
      cardinality via the disjoint partition `T == S + (T - S)`. */
  lemma SubsetCardLt(S: set<nat>, T: set<nat>, x: nat)
    requires S <= T && x in T && x !in S
    ensures |S| < |T|
  {
    assert S + (T - S) == T;
    assert S * (T - S) == {};
    assert |S + (T - S)| == |S| + |T - S|;   // disjoint union
    assert x in T - S;                        // T - S nonempty
  }

  /** A look's own id is not among its body's look ids (LookUnique). */
  lemma LookIdNotInOwnBody(re: R.regex, lid: nat)
    requires LTB.LookUnique(re)
    requires lid in LTB.LookIds(re)
    ensures lid !in LTB.LookIds(NI.LookBodyOfRE(re, lid))
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookIdNotInOwnBody(r1, lid); } else { LookIdNotInOwnBody(r2, lid); }
    case Re_con(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookIdNotInOwnBody(r1, lid); } else { LookIdNotInOwnBody(r2, lid); }
    case Re_quant(_, _, _, r1) => LookIdNotInOwnBody(r1, lid);
    case Re_capture(_, r1) => LookIdNotInOwnBody(r1, lid);
    case Re_lookaround(lid0, _, r1) =>
      if lid0 >= 0 && (lid0 as nat) == lid {
        assert (lid0 as nat) !in LTB.LookIds(r1);   // LookUnique
      } else {
        LookIdNotInOwnBody(r1, lid);
      }
  }

  /** `LookUnique` descends into a look body. */
  lemma LookBodyLookUnique(re: R.regex, lid: nat)
    requires LTB.LookUnique(re)
    requires lid in LTB.LookIds(re)
    ensures LTB.LookUnique(NI.LookBodyOfRE(re, lid))
    decreases re
  {
    match re
    case Re_alt(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookBodyLookUnique(r1, lid); } else { LookBodyLookUnique(r2, lid); }
    case Re_con(r1, r2) =>
      if lid in LTB.LookIds(r1) { LookBodyLookUnique(r1, lid); } else { LookBodyLookUnique(r2, lid); }
    case Re_quant(_, _, _, r1) => LookBodyLookUnique(r1, lid);
    case Re_capture(_, r1) => LookBodyLookUnique(r1, lid);
    case Re_lookaround(lid0, _, r1) =>
      if lid0 >= 0 && (lid0 as nat) == lid { } else { LookBodyLookUnique(r1, lid); }
  }

  /** Every NON-top look has a TOP-LEVEL ancestor whose body contains it. The
      outermost-ancestor witness the peel recursion consumes. */
  lemma TopAncestorExists(re: R.regex, owner: nat) returns (A0: nat)
    requires LTB.LookUnique(re)
    requires owner in LTB.LookIds(re)
    requires owner !in NI.TopLookIds(re)
    ensures A0 in NI.TopLookIds(re)
    ensures A0 in LTB.LookIds(re)
    ensures owner in LTB.LookIds(NI.LookBodyOfRE(re, A0))
    decreases re
  {
    match re
    case Re_empty => assert false; A0 := 0;
    case Re_character(_) => assert false; A0 := 0;
    case Re_anchor(_) => assert false; A0 := 0;
    case Re_alt(r1, r2) =>
      if owner in LTB.LookIds(r1) {
        assert owner !in NI.TopLookIds(r1);
        A0 := TopAncestorExists(r1, owner);
        NI.TopLookIdsIn(r1);
        assert A0 in LTB.LookIds(r1);
      } else {
        assert owner in LTB.LookIds(r2);
        assert owner !in NI.TopLookIds(r2);
        A0 := TopAncestorExists(r2, owner);
        NI.TopLookIdsIn(r2);
        assert A0 in LTB.LookIds(r2);
        assert A0 !in LTB.LookIds(r1) by {
          if A0 in LTB.LookIds(r1) { assert A0 in LTB.LookIds(r1) * LTB.LookIds(r2); }
        }
      }
    case Re_con(r1, r2) =>
      if owner in LTB.LookIds(r1) {
        assert owner !in NI.TopLookIds(r1);
        A0 := TopAncestorExists(r1, owner);
        NI.TopLookIdsIn(r1);
        assert A0 in LTB.LookIds(r1);
      } else {
        assert owner in LTB.LookIds(r2);
        assert owner !in NI.TopLookIds(r2);
        A0 := TopAncestorExists(r2, owner);
        NI.TopLookIdsIn(r2);
        assert A0 in LTB.LookIds(r2);
        assert A0 !in LTB.LookIds(r1) by {
          if A0 in LTB.LookIds(r1) { assert A0 in LTB.LookIds(r1) * LTB.LookIds(r2); }
        }
      }
    case Re_quant(_, _, _, r1) => A0 := TopAncestorExists(r1, owner);
    case Re_capture(_, r1) => A0 := TopAncestorExists(r1, owner);
    case Re_lookaround(lid0, _, r1) =>
      assert lid0 >= 0;                         // LookUnique
      assert (lid0 as nat) != owner;            // owner !in TopLookIds == {lid0}
      assert owner in LTB.LookIds(r1);
      assert (lid0 as nat) in LTB.LookIds(re);
      A0 := lid0 as nat;
  }

  /** The per-body BASE EVIDENCE at one body `host`: every TOP-LEVEL look of `host`
      carries feed (i)/(ii) on the reconstructed banks. For `host == re` this is
      the main thread's `LookNestOkTTop` reconciled by `TopAncestorClockReconStep`;
      for `host` a look body it is that look's REPLAY tower (`LookNestOkTFrom
      BodyReplay`) reconciled the same way. */
  ghost predicate LocalTopFeed(host: R.regex, rcc: seq<int>, rlc: seq<int>, rqc: seq<int>) {
    forall l: nat :: l in LTB.LookIds(host) && l in NI.TopLookIds(host)
      // GUARD: some inner capture of `l`'s body is SET on the reconstructed capture
      // bank — the reconstructed-bank echo of `LookNestOkTTop`'s live-witness guard,
      // so the base evidence is demanded only at LIVE (matched) top looks.
      && (exists g2: nat :: g2 in PIV.CapIds(NI.LookBodyOfRE(host, l))
                            && AI.get_idx(rcc, CP.start_reg(g2)) >= 0)
      ==>
        NI.LookPathPresentLk(host, rcc, rlc, rqc, -1, l)
        && AI.get_idx(rlc, l as int) >= 0
        && AI.get_idx(rlc, l as int) >= NI.MxAtLidLk(host, rqc, -1, l)
  }

  /** (BRICK D4) The per-body DISCHARGE bridge: reduces one body's `LocalTopFeed`
      to that body's `LookNestOkTTop` (main thread at `re`, or the look's replay
      tower at a look body) plus the reconstruction frames — a per-top-look loop
      over `TopAncestorClockReconStep`. The remaining obligations are exactly:
        - the recon_outer capture/quant frames + top-look-clock stability
          (mechanical — the clock twins of the value-side `FLookLoopFullCovers*`);
        - the GUARD BRIDGE (the value-coupled piece): a reconstructed-bank live
          witness for `l`'s body implies a `gmt` live witness (from the value tie
          `LookNestBackTTop`/`GmtTie`) — taken here as a hypothesis. */
  lemma LocalTopFeedFromNestOkT(host: R.regex, S: set<LG.GroupId>, gmt: LG.GroupMap, th: AI.Thread,
                                rcc: seq<int>, rlc: seq<int>, rqc: seq<int>)
    requires LTB.LookUnique(host)
    requires LookNestOkTTop(host, S, gmt, th)
    // recon_outer frames (global) + top-look-clock stability (per top look)
    requires forall c: nat :: c in PIV.CapIdsOutsideLooks(host) ==>
      AI.get_idx(rcc, CP.start_reg(c as int)) == AI.get_idx(th.capture_regs.a_clk, CP.start_reg(c as int))
    requires forall q: nat :: q in PIV.QuantIdsOutsideLooks(host) ==>
      AI.get_idx(rqc, q as int) == AI.get_idx(th.quant_regs.a_clk, q as int)
    requires forall l: nat :: l in NI.TopLookIds(host) ==>
      AI.get_idx(rlc, l as int) == AI.get_idx(th.look_regs.a_clk, l as int)
    // GUARD BRIDGE (value-coupled): reconstructed-bank live witness ==> gmt witness
    requires forall l: nat :: l in LTB.LookIds(host) && l in NI.TopLookIds(host)
      && (exists g2: nat :: g2 in PIV.CapIds(NI.LookBodyOfRE(host, l)) && AI.get_idx(rcc, CP.start_reg(g2)) >= 0)
      ==> (exists g3: LG.GroupId :: g3 in S && g3 in gmt && g3 in PIV.CapIds(NI.LookBodyOfRE(host, l)))
    ensures LocalTopFeed(host, rcc, rlc, rqc)
  {
    forall l: nat | l in LTB.LookIds(host) && l in NI.TopLookIds(host)
      && (exists g2: nat :: g2 in PIV.CapIds(NI.LookBodyOfRE(host, l)) && AI.get_idx(rcc, CP.start_reg(g2)) >= 0)
      ensures NI.LookPathPresentLk(host, rcc, rlc, rqc, -1, l)
           && AI.get_idx(rlc, l as int) >= 0
           && AI.get_idx(rlc, l as int) >= NI.MxAtLidLk(host, rqc, -1, l)
    {
      // gmt live witness (guard bridge) -> LookNestOkTTop delivers th-bank presence at l
      assert exists g3: LG.GroupId :: g3 in S && g3 in gmt && g3 in PIV.CapIds(NI.LookBodyOfRE(host, l));
      assert NI.LookPathPresent(host, th.capture_regs.a_clk, th.quant_regs.a_clk, -1, l)
          && AI.get_idx(th.look_regs.a_clk, l as int) >= 0
          && AI.get_idx(th.look_regs.a_clk, l as int) >= NI.MxAtLidLk(host, th.quant_regs.a_clk, -1, l);
      // reconcile onto the reconstructed banks
      TopAncestorClockReconStep(host, rcc, rlc, rqc,
        th.capture_regs.a_clk, th.look_regs.a_clk, th.quant_regs.a_clk, l);
    }
  }

  /** The base evidence at `re` AND at every look body of `re` (any depth). The
      hereditary hypothesis the nesting recursion peels one body at a time. */
  ghost predicate AllBodyTopFeeds(re: R.regex, rcc: seq<int>, rlc: seq<int>, rqc: seq<int>) {
    LocalTopFeed(re, rcc, rlc, rqc)
    && forall a: nat :: a in LTB.LookIds(re) ==> LocalTopFeed(NI.LookBodyOfRE(re, a), rcc, rlc, rqc)
  }

  /** `AllBodyTopFeeds` descends into a look body: the body's own base evidence is
      the outer hypothesis at that body, and the body's sub-bodies coincide with
      `re`'s (`LookBodyCompose`). */
  lemma AllBodyTopFeedsDescend(re: R.regex, rcc: seq<int>, rlc: seq<int>, rqc: seq<int>, A0: nat)
    requires LTB.LookUnique(re)
    requires A0 in LTB.LookIds(re)
    requires AllBodyTopFeeds(re, rcc, rlc, rqc)
    ensures AllBodyTopFeeds(NI.LookBodyOfRE(re, A0), rcc, rlc, rqc)
  {
    var bA := NI.LookBodyOfRE(re, A0);
    assert LocalTopFeed(bA, rcc, rlc, rqc);          // AllBodyTopFeeds(re) at a := A0
    forall a2: nat | a2 in LTB.LookIds(bA)
      ensures LocalTopFeed(NI.LookBodyOfRE(bA, a2), rcc, rlc, rqc)
    {
      NI.LookBodyCompose(re, A0, a2);                // a2 in LookIds(re) & bodies coincide
      assert LocalTopFeed(NI.LookBodyOfRE(re, a2), rcc, rlc, rqc);   // AllBodyTopFeeds(re) at a := a2
    }
  }

  /** (BRICK D4 CAPSTONE) The whole-loop ancestor look-clock chain: for ANY captured
      inner look `owner` (at any nesting depth), the RECONSTRUCTED banks carry the
      ancestor chain SET+DOMINATING — feeds (i)/(ii) of `M.ReconInnerGmOfLiveClose`.
      Assembled by peeling `owner`'s outermost top-level ancestor `A0` off the chain
      (`AncestorChainPeelStep`), taking `A0`'s feed from the base evidence at `re`
      and `owner`'s within-`bA0` feed from the recursion (nesting strictly drops one
      look id). The remaining engine obligation is `AllBodyTopFeeds` — the per-body
      base evidence: `TopAncestorClockReconStep` reconciles each body's
      `LookNestOkTTop` (main thread at `re`, replay tower at each look body) onto the
      reconstructed banks. */
  lemma {:isolate_assertions} FLookLoopAncestorClockChain(re: R.regex, rcc: seq<int>, rlc: seq<int>, rqc: seq<int>,
                                    owner: nat, g: nat)
    requires NR.NestedFragmentRE(re) && NR.NegLooksLookFreeRE(re) && LTB.LookUnique(re)
    requires owner in LTB.LookIds(re)
    // the LIVE captured group whose owner this is (its owner's-body membership +
    // reconstructed-bank liveness discharge each ancestor's base-evidence guard)
    requires g in PIV.CapIds(NI.LookBodyOfRE(re, owner))
    requires AI.get_idx(rcc, CP.start_reg(g)) >= 0
    requires AllBodyTopFeeds(re, rcc, rlc, rqc)
    ensures NI.LookPathPresentLk(re, rcc, rlc, rqc, -1, owner)
    ensures AI.get_idx(rlc, owner as int) >= 0
    ensures AI.get_idx(rlc, owner as int) >= NI.MxAtLidLk(re, rqc, -1, owner)
    decreases |LTB.LookIds(re)|
  {
    assert LocalTopFeed(re, rcc, rlc, rqc);
    if owner in NI.TopLookIds(re) {
      // base: owner is top-level in re; g in owner's body + g live discharge the guard
      assert g in PIV.CapIds(NI.LookBodyOfRE(re, owner)) && AI.get_idx(rcc, CP.start_reg(g)) >= 0;
    } else {
      var A0 := TopAncestorExists(re, owner);
      NI.TopLookIdsIn(re);
      assert A0 in LTB.LookIds(re);
      var bA0 := NI.LookBodyOfRE(re, A0);
      // g sits in A0's body too: owner nests in bA0, and g is in owner's-body caps
      NI.LookBodyCompose(re, A0, owner);        // owner in LookIds(re); bodies compose
      assert NI.LookBodyOfRE(re, owner) == NI.LookBodyOfRE(bA0, owner);
      NI.LookBodyCapsIn(bA0, owner);            // CapIds(LookBodyOfRE(bA0,owner)) <= CapIds(bA0)
      assert g in PIV.CapIds(bA0);
      // A0's feed from LocalTopFeed(re): guard discharged by the g-witness in bA0
      assert g in PIV.CapIds(NI.LookBodyOfRE(re, A0)) && AI.get_idx(rcc, CP.start_reg(g)) >= 0;
      assert NI.LookPathPresentLk(re, rcc, rlc, rqc, -1, A0)
          && AI.get_idx(rlc, A0 as int) >= 0
          && AI.get_idx(rlc, A0 as int) >= NI.MxAtLidLk(re, rqc, -1, A0);
      // body facts + strict measure decrease
      NI.LookBodyOfFragmentNested(re, A0);      // NestedFragmentRE(bA0) & NegLooksLookFreeRE(bA0)
      LookBodyLookUnique(re, A0);               // LookUnique(bA0)
      NI.LookBodyLookIdsIn(re, A0);             // LookIds(bA0) <= LookIds(re)
      LookIdNotInOwnBody(re, A0);               // A0 !in LookIds(bA0)
      assert A0 in LTB.LookIds(re) && A0 !in LTB.LookIds(bA0) && LTB.LookIds(bA0) <= LTB.LookIds(re);
      SubsetCardLt(LTB.LookIds(bA0), LTB.LookIds(re), A0);
      assert |LTB.LookIds(bA0)| < |LTB.LookIds(re)|;
      // recurse for owner within bA0 (same live g: g in LookBodyOfRE(bA0,owner))
      assert g in PIV.CapIds(NI.LookBodyOfRE(bA0, owner));
      AllBodyTopFeedsDescend(re, rcc, rlc, rqc, A0);
      FLookLoopAncestorClockChain(bA0, rcc, rlc, rqc, owner, g);
      // stitch
      AncestorChainPeelStep(re, rcc, rlc, rqc, A0, owner);
    }
  }

}
