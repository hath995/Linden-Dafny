// (G5a-1 P6, row N) The run premise of the CDN guard, for real: at every position of a forward run over
// `str`, the table the engine builds from `compile_cdns(ast)` is right about every `CheckNullable` of the
// top-level code. GENERATED by probes/G5a1-P6-N1-guardsrun.py.txt; the three `GuardIds…` lemmas are
// `PIV.QuantWriteIds…RECdn` with another conclusion.
module LindenElkGuardsRun {
  import opened Std.Wrappers
  import R = RegElkRegex
  import RB = Bytecode
  import CP = Compiler
  import AI = ArrayInterp
  import LOr = Oracle
  import LAnc = Anchors
  import LCdn = Cdn
  import LW = WarblreRegExpRecord
  import T = LindenElkTranslate
  import NR = LindenElkNfaRep
  import AR = LindenElkActionsRep
  import TR = LindenElkTreeRep
  import LL = LindenElkLookLeaves
  import PIV = LindenElkPikeInv
  import PSM = LindenElkPikeSim
  import CS = LindenElkCdnSound
  import CTT = LindenElkCdnTreeTie
  import CG = LindenElkCdnGuards

  // (G5b) Sections 1-2 (`GuardIdsRE`, `QIdsAreQuantIds`, `QUniqueOfQuantUnique`, `CdnBodyFacts`) moved
  // down to mirror-world's `LindenElkCdnGuards` (`CG.`), so the oracle column chain can use them.

  // ---------------------------------------------------------------------------
  // 3. The run premise.
  // ---------------------------------------------------------------------------

  /** THE LEMMA. Every table of a forward run over `str` is guard-sound for the top-level code: at a
      `CheckNullable(qid)` the bit is true exactly where the plus body has a first empty path. */
  lemma GuardsOkRunTop(rer: LW.RegExpRecord, qm: AR.QMap, ast: R.regex, re: R.regex, code: RB.code, endl: nat,
                       str: string, ov: LOr.OracleView)
    requires re == R.lazy_prefix(ast)
    requires T.TransWf(re) && NR.NestedFragmentCdnRE(re) && PIV.QuantUnique(re)
    requires AR.QmapOk(re, qm) && AR.LmapOk(re, qm) && qm.ov == ov && !rer.multiline
    requires NR.NfaRepRE(re, code, 0, endl) && |code| == endl + 1 && NR.GetPcRE(code, endl) == Some(RB.Accept)
    requires forall cp: nat :: cp <= |str| ==> LL.OracleOkAt(rer, qm, PIV.InpOfCp(str, cp))
    ensures PSM.GuardsOkRun(qm, code, LCdn.compile_cdns(ast), ov, str)
  {
    var cdns := LCdn.compile_cdns(ast);
    var pre := R.Re_quant(R.NonNullable, 0, R.CountedQuant(0, None, false), R.Re_character(R.Dot));
    assert re == R.Re_con(pre, ast);
    assert CS.CdnQIds(pre) == {} && CS.CdnQIds(re) == CS.CdnQIds(ast);
    assert T.TransWf(ast) && PIV.QuantUnique(ast) && AR.LmapOk(ast, qm);
    CG.QUniqueOfQuantUnique(ast);
    forall cp: int ensures PSM.GuardsOkAt(qm, code, PSM.CdnAt(cdns, ov, str, cp), str, cp) {
      var table := PSM.CdnAt(cdns, ov, str, cp);
      if 0 <= cp <= |str| {
        var cpn: nat := cp as nat;
        var inp := PIV.InpOfCp(str, cpn);
        PSM.InpOfCpIsInputAt(str, cpn);
        forall pc: nat | NR.GetPcRE(code, pc).Some? && NR.GetPcRE(code, pc).value.CheckNullable?
          ensures PSM.GuardOkBit(qm, table, NR.GetPcRE(code, pc).value.cnq, inp)
        {
          var qid := NR.GetPcRE(code, pc).value.cnq;
          assert NR.GetPcRE(code, pc) == Some(RB.CheckNullable(qid));
          assert pc < endl;   // pc < |code| == endl + 1, and code[endl] is Accept
          CG.GuardIdsRE(re, code, 0, endl, pc);
          assert qid in CS.CdnQIds(ast);
          CG.CdnBodyFacts(ast, qm, qid);
          var body := CS.CdnBody(ast, qid);
          // the table of the tower: qm.bodies[qid] is the plus body
          assert (qid as nat) in PIV.QuantIds(re) && PIV.QidBody(re, qid as nat) == PIV.QidBody(ast, qid as nat);
          PIV.QmapOkBodyAtQid(re, qm, qid as nat);
          assert qid in qm.bodies && qm.bodies[qid] == body;
          assert LL.OracleOkAt(rer, qm, T.InputAt(str, cpn));
          CTT.CdnGuardSpec(rer, qm, ast, str, cpn, LAnc.Forward, qid);
          assert table == LCdn.build_cdn_v(cdns, cpn, qm.ov, AI.cp_context(cpn, str, LAnc.Forward), LAnc.Forward);
        }
      }
      PSM.GuardsOkAtIntro(qm, code, table, str, cp);
    }
  }
}
